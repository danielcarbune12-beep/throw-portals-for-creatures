<Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">CaughtPresentation</string><ProtectedString name="Source"><![CDATA[-- A compact, legible receipt for an already confirmed catch.
local RS = game:GetService("ReplicatedStorage")
local Data = require(RS.Shared.CreatureData)
local Config = require(RS.Shared.Config)
local Format = require(RS.Shared.Format)
local Timeline = require(RS.Shared.PresentationTimeline)
local K = require(script.Parent.UIKit)
local T = K.Theme
local HUD = require(script.Parent.HUD)
local Renderer = require(script.Parent.CreatureRenderer)
local Settings = require(script.Parent.ClientSettings)
return function(id)
	local def = Data.ById[id]
	if not def then
		return
	end
	if HUD.AnyPanelOpen() then
		HUD.Notify("Caught " .. def.name .. ". Added to your creatures.", "success")
		return
	end
	local color = T.Rarity(def.rarity, Config)
	local card = K.surface(HUD.Root, "CatchReceipt", UDim2.fromOffset(292, 304), UDim2.fromScale(0.5, 0.57), T.Panel)
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.ZIndex = 30
	K.label(
		"Creature caught",
		UDim2.new(1, -32, 0, 28),
		T.Gold,
		{ Position = UDim2.fromOffset(16, 12), TextSize = 19, Font = T.Bold, Parent = card }
	)
	local vp = K.viewport(Renderer.BuildPreview(id), UDim2.new(1, -24, 0, 142), false)
	vp.Position = UDim2.fromOffset(12, 44)
	vp.Parent = card
	K.label(
		def.name,
		UDim2.new(1, -24, 0, 42),
		T.Text,
		{ Position = UDim2.fromOffset(12, 190), TextSize = 21, Font = T.Bold, Parent = card }
	)
	K.label(
		def.rarity .. " · " .. Format.Money(Data.Income(id)) .. " / sec",
		UDim2.new(1, -24, 0, 24),
		color,
		{ Position = UDim2.fromOffset(12, 235), TextSize = 16, Parent = card }
	)
	K.label(
		"Added to your creatures",
		UDim2.new(1, -24, 0, 22),
		T.Muted,
		{ Position = UDim2.fromOffset(12, 270), TextSize = 14, Parent = card }
	)
	if not Settings.ReducedMotion then
		local scale = K.new("UIScale", { Scale = 0.97, Parent = card })
		K.tween(scale, 0.18, { Scale = 1 })
	end
	task.delay(Timeline.Card.enter + Timeline.Card.hold, function()
		if card.Parent then
			card:Destroy()
		end
		local pets = HUD.SideButtons.Pets
		if pets and pets.Visible then
			K.pop(pets)
		end
	end)
end
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX44"><Properties><string name="Name">CinematicLook</string><ProtectedString name="Source"><![CDATA[-- CinematicLook: premium "modern renderer" finish on top of the existing lighting.
-- Location: StarterPlayer > StarterPlayerScripts > Client > CinematicLook (LocalScript)
--
-- Ownership: Effects.lua / SanctuaryLook own Ambient, ClockTime, Fog, Brightness, ExposureCompensation,
-- the Atmosphere and the TPFC_* post effects, and tween them per zone. This script NEVER writes those.
-- It only adds:
--   * crisp-soft shadows (ShadowSoftness) and a per-zone sun latitude for longer, more graphic shadows
--   * a second filmic grade (TPFC_FilmGrade: contrast/saturation/split tint) stacked on the zone grade
--   * a high-threshold highlight bloom (TPFC_HighlightGlow) so specular glints and neon read as light
--   * an asset-free edge vignette (four gradient frames) that never takes input
-- Everything scales with the player's graphics quality and is skipped on low settings.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- per-zone finishing: split-tone tint, extra contrast/saturation, sun latitude, highlight glow
local GRADE = {
	Hub     = { tint = Color3.fromRGB(255, 248, 238), contrast = 0.06, sat = 0.06, lat = 34, glow = 0.18 },
	Forest  = { tint = Color3.fromRGB(255, 250, 236), contrast = 0.08, sat = 0.10, lat = 38, glow = 0.18 },
	Volcano = { tint = Color3.fromRGB(255, 236, 222), contrast = 0.12, sat = 0.08, lat = 24, glow = 0.30 },
	Frozen  = { tint = Color3.fromRGB(240, 248, 255), contrast = 0.07, sat = 0.04, lat = 52, glow = 0.20 },
	Crystal = { tint = Color3.fromRGB(246, 238, 255), contrast = 0.10, sat = 0.10, lat = 30, glow = 0.32 },
	Candy   = { tint = Color3.fromRGB(255, 246, 250), contrast = 0.05, sat = 0.04, lat = 40, glow = 0.16 },
	Space   = { tint = Color3.fromRGB(238, 238, 255), contrast = 0.12, sat = 0.06, lat = 20, glow = 0.34 },
	Shadow  = { tint = Color3.fromRGB(248, 236, 252), contrast = 0.11, sat = 0.06, lat = 28, glow = 0.28 },
	Heaven  = { tint = Color3.fromRGB(255, 250, 240), contrast = 0.05, sat = 0.05, lat = 46, glow = 0.20 },
}

local function quality()
	-- 1..10; Automatic reports 0 -> treat as high
	local ok, q = pcall(function() return UserSettings().GameSettings.SavedQualityLevel.Value end)
	if not ok or q == 0 then return 10 end
	return q
end

---------------------------------------------------------------- post effects (unique names, stacked)
local grade = Lighting:FindFirstChild("TPFC_FilmGrade") or Instance.new("ColorCorrectionEffect")
grade.Name = "TPFC_FilmGrade"
grade.Parent = Lighting

local glow = Lighting:FindFirstChild("TPFC_HighlightGlow") or Instance.new("BloomEffect")
glow.Name = "TPFC_HighlightGlow"
glow.Threshold = 2.4
glow.Size = 40
glow.Parent = Lighting

pcall(function() Lighting.ShadowSoftness = 0.18 end)

---------------------------------------------------------------- vignette (no image assets: four gradient edges)
local gui = Instance.new("ScreenGui")
gui.Name = "TPFC_Vignette"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = -10
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
local edges = {}
local function edge(pos, size, rotation)
	local f = Instance.new("Frame")
	f.BackgroundColor3 = Color3.fromRGB(8, 6, 16)
	f.BorderSizePixel = 0
	f.Position, f.Size = pos, size
	f.Active = false
	pcall(function() f.Interactable = false end)
	local g = Instance.new("UIGradient")
	g.Rotation = rotation
	g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(0.55, 0.92), NumberSequenceKeypoint.new(1, 1) })
	g.Parent = f
	f.Parent = gui
	table.insert(edges, g)
end
edge(UDim2.fromScale(0, 0), UDim2.fromScale(0.22, 1), 0)       -- left -> fades rightward
edge(UDim2.fromScale(0.78, 0), UDim2.fromScale(0.22, 1), 180)   -- right
edge(UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.2), 90)        -- top
edge(UDim2.fromScale(0, 0.8), UDim2.fromScale(1, 0.2), 270)     -- bottom
gui.Parent = player:WaitForChild("PlayerGui")

---------------------------------------------------------------- zone tracking (camera position, 2 Hz)
local current
local function apply(id)
	local g = GRADE[id] or GRADE.Hub
	local q = quality()
	local strength = q <= 3 and 0 or (q <= 6 and 0.6 or 1)
	local info = TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	TweenService:Create(grade, info, {
		TintColor = Color3.new(1, 1, 1):Lerp(g.tint, strength),
		Contrast = g.contrast * strength,
		Saturation = g.sat * strength,
	}):Play()
	TweenService:Create(glow, info, { Intensity = g.glow * strength }):Play()
	pcall(function() TweenService:Create(Lighting, info, { GeographicLatitude = g.lat }):Play() end)
	gui.Enabled = strength > 0
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.5 then return end
	acc = 0
	local pos = camera.CFrame.Position
	local id = (pos.Z < 0) and "Hub" or (Config.WorldAt(pos) or "Hub")
	if id ~= current then
		current = id
		apply(id)
	end
end)
apply("Hub")
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX45"><Properties><string name="Name">ClientMain</string><ProtectedString name="Source"><![CDATA[-- ClientMain: wires all client modules together.
-- Location: StarterPlayer > StarterPlayerScripts > Client > ClientMain (LocalScript)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CreatureData = require(Shared.CreatureData)
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Timeline = require(Shared.PresentationTimeline)

local Client = script.Parent
local State = require(Client.ClientState)
local Effects = require(Client.Effects)
local Sounds = require(Client.Sounds)
local Renderer = require(Client.CreatureRenderer)
local TC = require(Client.ThrowController)
local HUD = require(Client.HUD)
local Feel = require(Client.GameplayFeel)
local Panels = require(Client.Panels)

local player = Players.LocalPlayer
local Remotes = State.Remotes

Effects.SetupLighting()
Renderer.Start()
local WorldFx = require(Client.WorldFx)
WorldFx.TC = TC
task.spawn(function()
	workspace:WaitForChild("Map", 60)
	WorldFx.Start()
end)
Panels.Init()
HUD.TC = TC
TC.OnThrowResult = HUD.ThrowFeedback
HUD.Refresh()
Feel.Start(TC, HUD)

-- ask the server for a full data sync (retries until our save has loaded)
task.spawn(function()
	while not State.Loaded do
		State.Request("Sync")
		task.wait(1.5)
	end
end)

---------------------------------------------------------------- collecting wild creatures
local collecting = {}
Renderer.OnCollectRequest = function(throwId)
	if collecting[throwId] then
		return
	end
	collecting[throwId] = true
	local ok, msg = State.Request("Collect", throwId)
	collecting[throwId] = nil
	if not ok then
		HUD.Notify(msg or "Can't collect", "error")
	end
end

HUD.OnCollect = Renderer.OnCollectRequest

---------------------------------------------------------------- the limit: barrier + "throw from here"
local function barrierPulse(pos)
	local map = workspace:FindFirstChild("Map")
	local wall = map and map:FindFirstChild("Start") and map.Start:FindFirstChild("Barrier")
	if wall then
		wall.Transparency = 0.94
		Effects.Tween(wall, 0.4, { Transparency = 1 })
	end
	if pos then
		Effects.Shockwave(Vector3.new(pos.X, 1, Config.BarrierZ - 1), Color3.fromRGB(190, 140, 255), 10, 0.5)
		Effects.Burst(Vector3.new(pos.X, pos.Y, Config.BarrierZ - 1), Color3.fromRGB(200, 160, 255), 20, 10, 0.7)
	end
end
TC.OnNotInZone = function()
	HUD.ShowThrowHere("🎯 GO TO THE THROW LINE!", nil)
end
local lastBarrierFx = 0

TC.OnBusy = function(message)
	HUD.Notify(message or "Your portal is active. Wait for the catch.", "info")
end
TC.OnLaunchFailed = function(message)
	HUD.Notify(message, "error")
end

---------------------------------------------------------------- training: buy equipment + lifting animation
HUD.OnUpgradeGym = function()
	local ok, msg = State.Request("UpgradeEquipment")
	if ok then
		local st = Config.TrainingStations[math.clamp(State.Data.EquipLevel or 1, 1, #Config.TrainingStations)]
		Sounds.Play("Upgrade")
		task.delay(0.15, Sounds.Play, "Rare", 1.3)
		HUD.Notify(msg or "Gym upgraded!", "success")
		Effects.Coins(nil, 12)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			Effects.Burst(root.Position + Vector3.new(0, 2, 0), st.color, 50, 18, 1)
			Effects.Shockwave(root.Position - Vector3.new(0, 2.5, 0), st.color, 12, 0.5)
		end
		HUD._shownGym = nil -- refresh the buttons
	else
		HUD.Notify(msg or "Can't upgrade", "error")
	end
end

-- Lifting uses Roblox's built-in "cheer" animation (both arms raise the weight overhead).
-- It plays on your own character, so other players see it too.
local LIFT_ANIM =
	{ [Enum.HumanoidRigType.R15] = "rbxassetid://507770677", [Enum.HumanoidRigType.R6] = "rbxassetid://129423030" }
local liftTrack, liftHum, lastLift = nil, nil, 0
local function playLift()
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	if hum ~= liftHum then
		liftHum = hum
		liftTrack = nil
		local animator = hum:FindFirstChildOfClass("Animator") or hum
		local anim = Instance.new("Animation")
		anim.AnimationId = LIFT_ANIM[hum.RigType] or LIFT_ANIM[Enum.HumanoidRigType.R15]
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if ok and track then
			track.Priority = Enum.AnimationPriority.Action
			track.Looped = true
			liftTrack = track
		end
	end
	lastLift = os.clock()
	if liftTrack and not liftTrack.IsPlaying then
		liftTrack:Play(0.15, 1, 1.7)
	end
end
RunService.Heartbeat:Connect(function()
	if liftTrack and liftTrack.IsPlaying and os.clock() - lastLift > 0.7 then
		liftTrack:Stop(0.25)
	end
end)

local lastRep = 0
local function doRep()
	local idx = HUD.TrainStation
	if not idx or os.clock() - lastRep < Config.TrainCooldown then
		return
	end
	lastRep = os.clock()
	local st = Config.TrainingStations[idx]
	playLift()
	HUD.TrainPulse()
	task.spawn(function()
		local ok, msg = State.Request("Train", idx)
		if ok then
			Sounds.Play("Collect", 1.4 + math.random() * 0.2)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root then
				Effects.FloatingText(
					root.Position + Vector3.new(math.random(-2, 2), 4, 0),
					"+" .. Format.Short(st.gain) .. " 💪",
					Color3.fromRGB(255, 150, 120),
					0.8
				)
			end
		elseif msg then
			HUD.Notify(msg, "error")
		end
	end)
end
RunService.Heartbeat:Connect(function()
	if HUD.TrainStation and (HUD.TrainHeld or HUD.AutoTrain) then
		doRep()
	end
end)
game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.E and HUD.TrainStation then
		doRep()
	end
end)

---------------------------------------------------------------- server messages
Remotes.Notify.OnClientEvent:Connect(function(text, kind)
	if kind == "throwzone" then
		HUD.ShowThrowHere("🎯 GO TO THE THROW LINE!", nil)
		return
	end
	-- The owner's reveal caption already announces this find. Keep broadcasts for other players.
	local ownReveal = Config.Rarities[kind]
		and text:sub(1, #player.DisplayName + 9) == player.DisplayName .. " found a "
	if not ownReveal then
		HUD.Notify(text, kind)
	end
	if kind == "discover" then
		Sounds.Play("Upgrade", 1.1)
	end
end)

Remotes.MoneyFx.OnClientEvent:Connect(Feel.Money)

-- "CAUGHT!" card: pops up with the spinning creature, then flies into the Pets button
local caughtCard = require(Client.CaughtPresentation)

-- Card queue: a card is shown only for a CONFIRMED deposit, after its capture presentation
-- finished (Renderer.CaptureFinished) or a bounded fallback timeout — one card per deposit.
local cardQueue, cardBusy = {}, false
local pendingCards = {} -- deposits waiting for their capture visual: { id, deadline }
local recentCaptures = {} -- captures that finished before the deposit arrived: { id, t }
local function pumpCards()
	if cardBusy or #cardQueue == 0 then
		return
	end
	cardBusy = true
	local id = table.remove(cardQueue, 1)
	task.spawn(function()
		pcall(caughtCard, id)
		task.wait(Timeline.CardTotal())
		cardBusy = false
		pumpCards()
	end)
end
local function enqueueCard(id)
	table.insert(cardQueue, id)
	pumpCards()
end
Renderer.CaptureFinished.Event:Connect(function(_throwId, ownerId, creatureId)
	if ownerId ~= player.UserId then
		return
	end
	for i, pc in ipairs(pendingCards) do
		if pc.id == creatureId then
			table.remove(pendingCards, i)
			enqueueCard(creatureId)
			return
		end
	end
	table.insert(recentCaptures, { id = creatureId, t = os.clock() })
end)
Remotes.Deposit.OnClientEvent:Connect(function(ids)
	for _, id in ipairs(ids) do
		if CreatureData.ById[id] then
			local matched = false
			for i, rc in ipairs(recentCaptures) do
				if rc.id == id and os.clock() - rc.t < 6 then
					table.remove(recentCaptures, i)
					matched = true
					break
				end
			end
			if matched then
				enqueueCard(id)
			else
				table.insert(pendingCards, {
					id = id,
					deadline = os.clock() + Timeline.CardFallback + Timeline.CaptureFor(CreatureData.ById[id].rarity),
				})
			end
		end
	end
end)
RunService.Heartbeat:Connect(function()
	local now = os.clock()
	for i = #pendingCards, 1, -1 do
		if now > pendingCards[i].deadline then
			enqueueCard(table.remove(pendingCards, i).id)
		end
	end
end)

---------------------------------------------------------------- per-world lighting + guide beam to base
local guideBeam, guideA0, guideA1
local function ensureGuide()
	if guideBeam then
		return
	end
	guideA1 = Instance.new("Attachment")
	guideA1.Parent = workspace.Terrain
	guideBeam = Instance.new("Beam")
	guideBeam.Attachment1 = guideA1
	guideBeam.Color = ColorSequence.new(Color3.fromRGB(150, 255, 160), Color3.fromRGB(120, 200, 255))
	guideBeam.LightEmission = 1
	guideBeam.Width0, guideBeam.Width1 = 1.2, 3
	guideBeam.FaceCamera = true
	guideBeam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	guideBeam.TextureMode = Enum.TextureMode.Static
	guideBeam.TextureLength = 4
	guideBeam.TextureSpeed = 2
	guideBeam.Transparency = NumberSequence.new(0.2, 0.6)
	guideBeam.CurveSize0 = 20
	guideBeam.Parent = workspace.Terrain
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.2 then
		return
	end
	acc = 0
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	-- lighting/ambience follow the CAMERA, so the follow-cam shows each zone's mood
	Effects.UpdateWorld(workspace.CurrentCamera.CFrame.Position)
	HUD.SetInZone(Config.InThrowZone(root.Position))
	-- touching the limit: wall flashes and the "throw from here" animation plays
	if
		root.Position.Z > Config.BarrierZ - 2.6
		and root.Position.Z < Config.BarrierZ + 3
		and os.clock() - lastBarrierFx > 1.5
	then
		lastBarrierFx = os.clock()
		barrierPulse(root.Position)
		HUD.ShowThrowHere()
	end
	-- standing in YOUR OWN gym?
	local inGym = false
	local idx = player:GetAttribute("BaseIndex")
	local myBase = idx and workspace:FindFirstChild("Bases") and workspace.Bases:FindFirstChild("Base" .. idx)
	local gymPad = myBase and myBase:FindFirstChild("GymPad")
	if gymPad then
		inGym = ((root.Position - gymPad.Position) * Vector3.new(1, 0, 1)).Magnitude < Config.TrainRange
	end
	local level = inGym and math.clamp(State.Data.EquipLevel or 1, 1, #Config.TrainingStations) or nil
	local nextSt = level and Config.TrainingStations[level + 1]
	local canBuy = nextSt and (State.Data.Money or 0) >= nextSt.price
	if level ~= HUD._shownGym or canBuy ~= HUD._shownCanBuy then
		HUD._shownGym, HUD._shownCanBuy = level, canBuy
		HUD.SetGym(level)
	end
	-- creatures are caught automatically now, so the manual collect button stays hidden
	HUD.SetCollectable(nil)
	-- show a sparkly guide beam to your base while carrying creatures
	local carrying = #(State.Data.Carry or {}) > 0
	local carryBaseIndex = player:GetAttribute("BaseIndex")
	local base = carryBaseIndex
		and workspace:FindFirstChild("Bases")
		and workspace.Bases:FindFirstChild("Base" .. carryBaseIndex)
	if carrying and base then
		ensureGuide()
		if not guideA0 or guideA0.Parent ~= root then
			guideA0 = Instance.new("Attachment")
			guideA0.Position = Vector3.new(0, -2, 0)
			guideA0.Parent = root
			guideBeam.Attachment0 = guideA0
		end
		guideA1.WorldPosition = base.Center.Position + Vector3.new(0, 2, 0)
		guideBeam.Enabled = true
	elseif guideBeam then
		guideBeam.Enabled = false
	end
end)

-- Cinematic intro fly-over; first-throw guidance stays context driven by GameplayFeel (no welcome toast).
task.spawn(function()
	local ok, err = pcall(function() require(Client.Intro).Play(HUD.Gui) end)
	if not ok then
		warn("[Intro] " .. tostring(err))
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
		HUD.Gui.Enabled = true
		Effects.Letterbox(false)
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">ClientSettings</string><ProtectedString name="Source"><![CDATA[-- ClientSettings: presentation-only player settings (never affect odds, charge, rewards).
-- Location: StarterPlayer > StarterPlayerScripts > Client > ClientSettings (ModuleScript)
-- Values persist for the session via player attributes; defaults are safe for everyone.

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local Settings = {
	CameraShake = true,       -- camera shake on big reveals
	ReducedFlashes = false,   -- no full-screen colour flashes
	ReducedMotion = false,    -- calmer camera + shorter cinematic moves
	VFXQuality = "High",      -- "High" | "Low"  (Low keeps anatomy + text, drops extra trails/bursts)
	AmbientMotes = false,     -- optional local ambient motes (off by default, per earlier request)
}
Settings.Changed = Instance.new("BindableEvent")

function Settings.Set(key: string, value)
	if Settings[key] == nil or typeof(Settings[key]) ~= typeof(value) then return end
	Settings[key] = value
	player:SetAttribute("TPFC_" .. key, value)
	Settings.Changed:Fire(key, value)
end

for key, v in pairs(Settings) do
	if typeof(v) == "boolean" or typeof(v) == "string" then
		local saved = player:GetAttribute("TPFC_" .. key)
		if saved ~= nil and typeof(saved) == typeof(v) then Settings[key] = saved end
	end
end

function Settings.LowVFX(): boolean
	return Settings.VFXQuality == "Low"
end

return Settings
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">ClientState</string><ProtectedString name="Source"><![CDATA[-- ClientState: local mirror of the player's data + change signal + request helper.
-- Location: StarterPlayer > StarterPlayerScripts > Client > ClientState (ModuleScript)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local State = {
	Data = { Money = 0, Uncollected = 0, Upgrades = { ThrowPower = 1, BaseSlots = 0, Storage = 0, Training = 0 },
		OwnedPortals = { Basic = true }, EquippedPortal = "Basic", Creatures = {}, Placed = {}, Discovered = {},
		UnlockedWorlds = { Forest = true }, Decor = {}, FloorTheme = "Meadow", OwnedFloors = { Meadow = true },
		OwnedEquipment = { ["1"] = true }, Strength = 0,
		Income = 0, SlotsOpen = 4, StorageCap = 10, MaxDistance = 45, Carry = {}, BaseIndex = 0 },
	Loaded = false,
}
local changed = Instance.new("BindableEvent")
State.Changed = changed.Event

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
State.Remotes = Remotes

Remotes:WaitForChild("Sync").OnClientEvent:Connect(function(payload)
	local full = payload.Creatures ~= nil
	for k, v in pairs(payload) do State.Data[k] = v end
	if full then State.Loaded = true end
	changed:Fire(full)
end)

-- returns ok, message
function State.Request(action: string, arg)
	local ok, res, msg = pcall(function()
		return Remotes.Request:InvokeServer(action, arg)
	end)
	if not ok then return false, "Connection error" end
	return res, msg
end

function State.IsPlaced(uid)
	return table.find(State.Data.Placed, uid) ~= nil
end

return State
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">CreatureRenderer</string><ProtectedString name="Source"><![CDATA[-- CreatureRenderer: renders every creature on this client — base pets of all players,
-- creatures being carried, and freshly revealed wild creatures. Handles species entrances,
-- capture presentation, reactions, click-to-pet, distance LOD and previews.
-- Location: StarterPlayer > StarterPlayerScripts > Client > CreatureRenderer (ModuleScript)
--
-- Presentation only: rewards, rolls and catch deadlines are server-owned. A failed visual never
-- blocks a reward; every temporary object has one owner and is cleaned up on finish/interrupt.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CreatureData = require(Shared.CreatureData)
local Builder = require(Shared.CreatureBuilder)
local Animator = require(Shared.CreatureAnimator)
local Timeline = require(Shared.PresentationTimeline)
local Format = require(Shared.Format)
local Effects = require(script.Parent.Effects)
local Sounds = require(script.Parent.Sounds)
local Settings = require(script.Parent.ClientSettings)

local Renderer = {}
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local folder = Instance.new("Folder")
folder.Name = "Creatures"
folder.Parent = workspace

local active = {} -- set of entries { model, anim, kind, ... }
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
local basePets = {} -- [userId] = array of entries
local carried = {} -- [userId] = array of entries
local wild = {} -- [throwId] = entry
Renderer.Wild = wild
Renderer.OnCollectRequest = nil -- set by ClientMain
Renderer.CaptureFinished = Instance.new("BindableEvent") -- (throwId, ownerId, creatureId)

---------------------------------------------------------------- helpers
local function tag(entry, text, color, maxDist, offsetY)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(200, 50)
	bb.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	bb.MaxDistance = maxDist
	bb.LightInfluence = 0
	bb.AlwaysOnTop = false
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.RichText = true
	t.Text = text
	t.TextColor3 = color
	local st = Instance.new("UIStroke")
	st.Thickness = 1.3
	st.Color = Color3.fromRGB(25, 15, 35)
	st.Parent = t
	t.Parent = bb
	bb.Parent = entry.model.PrimaryPart
	entry.tag = bb
	return bb
end

local function heightFor(def)
	local s = Config.Rarities[def.rarity].size * def.scale
	if def.body == "golem" then
		return 5.4 * s
	end
	if def.body == "ghost" or def.body == "fish" or def.move == "fly" then
		return 5.2 * s
	end
	return 4 * s
end

local function onFx(kind, anim)
	local rig = anim.rig
	if not rig or not rig.root.Parent then
		return
	end
	local up = (rig.bodyRadius and rig.bodyRadius.Y or 1) + (anim.hover or 0)
	local pos = rig.root.Position + Vector3.new(0, up + 0.5, 0)
	pcall(Effects.Motif, kind, pos, rig.root.CFrame.LookVector, rig.pal.a, math.clamp(rig.size, 0.8, 2))
end

local function spawnEntry(creatureId, cf, kind, popTime)
	local model, rig = Builder.Build(creatureId)
	model:PivotTo(cf)
	model.Parent = folder
	local anim = Animator.new(rig, cf)
	anim.onFx = onFx
	local entry = {
		id = creatureId,
		model = model,
		rig = rig,
		anim = anim,
		kind = kind,
		acc = 0,
		reactCd = 0,
		petCd = 0,
		tier = 1,
		nextStep = 0,
	}
	if popTime and popTime > 0 then
		entry.popT, entry.popDur = 0, popTime
		anim:SetScale(0.01)
	end
	active[entry] = true
	return entry
end

local function destroyEntry(entry)
	active[entry] = nil
	for _, obj in ipairs(entry.temps or {}) do
		pcall(function()
			obj:Destroy()
		end)
	end
	entry.temps = nil
	if entry.anim then
		entry.anim:Destroy()
	end
	if entry.model then
		entry.model:Destroy()
	end
end

local function own(entry, obj)
	entry.temps = entry.temps or {}
	table.insert(entry.temps, obj)
	return obj
end

local function elastic(k)
	if k >= 1 then
		return 1
	end
	return 1 - math.exp(-6 * k) * math.cos(k * 12)
end
local function easeOut(k)
	return 1 - (1 - k) ^ 3
end
local function easeIn(k)
	return k * k * k
end
local function smooth(k)
	k = math.clamp(k, 0, 1)
	return k * k * (3 - 2 * k)
end

---------------------------------------------------------------- base pets
local function baseModel(index)
	local bases = workspace:FindFirstChild("Bases")
	return bases and bases:FindFirstChild("Base" .. index)
end

local function slotCF(base, i)
	local slot = base.Slots:FindFirstChild("Slot" .. i)
	if not slot then
		return base.Center.CFrame
	end
	local pos = slot.Position + Vector3.new(0, slot.Size.X / 2, 0) -- top of the pedestal (cylinder height runs along X)
	-- face outward from the fountain, slightly varied so pets don't all look the same way
	local center = base.Center.Position
	local out = (pos - center) * Vector3.new(1, 0, 1)
	local yaw = math.atan2(-out.X, -out.Z) + math.sin(i * 1.7) * 0.6
	return CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
end

-- base-local obstacle zones (fountain, cottage, pond, collect pad, gym) — see BaseBuilder
local OBSTACLES = {
	{ circle = Vector2.new(0, 0), r = 8 },
	{ rect = Vector2.new(-20, 24), half = Vector2.new(8.5, 6.5) },
	{ circle = Vector2.new(21, 23), r = 8.5 },
	{ circle = Vector2.new(-19, -21), r = 6.5 },
	{ rect = Vector2.new(19, -19), half = Vector2.new(8.5, 8.5) },
}
local function blocked(lx, lz)
	for _, o in ipairs(OBSTACLES) do
		if o.circle then
			if (Vector2.new(lx, lz) - o.circle).Magnitude < o.r then
				return true
			end
		elseif math.abs(lx - o.rect.X) < o.half.X and math.abs(lz - o.rect.Y) < o.half.Y then
			return true
		end
	end
	return false
end
Renderer._blocked = blocked

-- pick a free roam target inside the hedges; floaters may hover over decor, walkers avoid it
local function pickRoam(e)
	local a = e.anim
	local floater = (a.hover or 0) > 0.9
	for _ = 1, 8 do
		local lx, lz = a.rng:NextNumber(-29, 29), a.rng:NextNumber(-29, 29)
		if floater or not blocked(lx, lz) then
			return e.baseCF:PointToWorldSpace(Vector3.new(lx, 0, lz))
		end
	end
	return nil
end

local function refreshBase(plr)
	local idx = plr:GetAttribute("BaseIndex")
	local raw = plr:GetAttribute("BaseCreatures")
	local list = {}
	if raw then
		local ok, res = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok then
			list = res
		end
	end
	local base = idx and idx > 0 and baseModel(idx)
	local existing = basePets[plr.UserId] or {}
	if not base then
		for _, e in ipairs(existing) do
			destroyEntry(e)
		end
		basePets[plr.UserId] = {}
		return
	end
	-- multiset diff: keep creatures that are still placed, add new ones, remove the rest
	local pool = {}
	for _, e in ipairs(existing) do
		pool[e.id] = pool[e.id] or {}
		table.insert(pool[e.id], e)
	end
	local result = {}
	for i, cid in ipairs(list) do
		local cand = pool[cid] and table.remove(pool[cid])
		if not cand and CreatureData.ById[cid] then
			local cf = slotCF(base, i)
			cand = spawnEntry(cid, cf, "base", 0.7)
			local def = CreatureData.ById[cid]
			local rc = Config.Rarities[def.rarity].color
			tag(
				cand,
				def.name
					.. "\n<font size='18' color='#9CFFA8'>"
					.. Format.Money(CreatureData.Income(cid))
					.. "/s</font>",
				rc,
				40,
				heightFor(def)
			)
			-- click / tap to pet (presentation only; never changes income or ownership)
			cand.rig.body.CanQuery = true
			local cd = Instance.new("ClickDetector")
			cd.MaxActivationDistance = 40
			cd.Parent = cand.rig.body
			cd.MouseClick:Connect(function()
				if os.clock() < cand.petCd then
					return
				end
				cand.petCd = os.clock() + 1.5
				if cand.anim:React("pet") then
					Sounds.PlayAt("Spawn", cand.model.PrimaryPart.Position, 1.4)
					Effects.Motif(
						"heart",
						cand.model.PrimaryPart.Position + Vector3.new(0, heightFor(def), 0),
						Vector3.zAxis
					)
				end
			end)
			if plr == player then
				Effects.Burst(cf.Position + Vector3.new(0, 2, 0), rc, 18, 12, 0.7)
			end
		end
		cand.anim:SetHome(base.Center.Position, 28)
		cand.baseCF = base.Center.CFrame
		cand.slot = i
		table.insert(result, cand)
	end
	for _, arr in pairs(pool) do
		for _, e in ipairs(arr) do
			destroyEntry(e)
		end
	end
	basePets[plr.UserId] = result
end

---------------------------------------------------------------- carried followers (legacy carry path)
local function refreshCarry(plr)
	local raw = plr:GetAttribute("Carry") or ""
	local ids = {}
	for id in string.gmatch(raw, "[^,]+") do
		table.insert(ids, id)
	end
	local existing = carried[plr.UserId] or {}
	while #existing > #ids do
		destroyEntry(table.remove(existing))
	end
	for i, cid in ipairs(ids) do
		local e = existing[i]
		if e and e.id ~= cid then
			destroyEntry(e)
			e = nil
		end
		if not e then
			local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			local cf = hrp and (hrp.CFrame * CFrame.new(0, -2.5, 4 + i * 3)) or CFrame.new()
			e = spawnEntry(cid, cf, "carry", 0.45)
			local def = CreatureData.ById[cid]
			tag(e, def.name, Config.Rarities[def.rarity].color, 60, heightFor(def))
			existing[i] = e
		end
		e.follow = plr
		e.followIndex = i
	end
	carried[plr.UserId] = existing
end

---------------------------------------------------------------- wild creatures: species entrances
-- Root motion comes from the species profile (enter.kind); rarity sets duration and VFX weight.
local MOVE_ENTRANCE = { hop = "hops", walk = "walk", fly = "glide", float = "drift", slither = "slither" }
local GLITCH = ColorSequence.new(Color3.fromRGB(0, 255, 200), Color3.fromRGB(255, 0, 170))

local function rarityFinish(e, en)
	local def = CreatureData.ById[e.id]
	local order = Config.Rarities[def.rarity].order
	local col = en.color
	local to = en.to
	if Settings.LowVFX() and order < 5 then
		return
	end
	if order <= 1 then
		Effects.Burst(
			to,
			ColorSequence.new(Color3.fromRGB(235, 240, 255)),
			8,
			5,
			0.9,
			"rbxasset://textures/particles/smoke_main.dds"
		)
	elseif order == 2 then
		Effects.Shockwave(to, col, 5, 0.4)
	elseif order <= 4 then
		Effects.Shockwave(to, col, 7 + order, 0.5)
		Effects.Burst(to + Vector3.new(0, 1.5, 0), col, 12 + order * 4, 10, 0.6)
	elseif def.rarity == "Secret" then
		Effects.Burst(to + Vector3.new(0, 2, 0), GLITCH, 30, 14, 0.7)
	else
		Effects.Shockwave(to, def.rarity == "Divine" and Color3.fromRGB(255, 240, 190) or col, 14 + order * 2, 0.8)
	end
end

local function finishEntrance(e)
	local en, a = e.entrance, e.anim
	e.entrance = nil
	a:EndAccent()
	a.rootRoll = 0
	a:SetScale(1)
	a.pos = en.to
	a.groundY = en.y0
	a.yaw, a.targetYaw = en.yaw0, en.yaw0
	a:SetHome(en.to, 3)
	a.idleTimer = 99 -- hold the showcase pose; the server catch comes next
	for _, p in ipairs(e.model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.LocalTransparencyModifier = 0
		end
	end
	rarityFinish(e, en)
end

local function stepEntrance(e, dt)
	local en, a = e.entrance, e.anim
	en.t += dt
	local k = math.clamp(en.t / en.dur, 0, 1)
	local s = e.rig.size
	local reduced = Settings.ReducedMotion
	local pop = (en.kind == "emerge" or en.kind == "descend" or en.kind == "resolve") and 1
		or math.max(0.02, easeOut(math.min(1, k / 0.18)))
	local kind = en.kind
	local from, to = en.from, en.to
	if kind == "hops" then
		local n = en.hops
		local q = k * n
		local hop = math.min(math.floor(q), n - 1)
		local frac = q - hop
		a.pos = from:Lerp(to, smooth(k))
		a.groundY = en.y0 + math.sin(frac * math.pi) * (n - hop) / n * 3.2 * s
		if hop ~= en.lastHop then
			en.lastHop = hop
			if hop > 0 then
				a.landSquash = 1
			end
		end
	elseif kind == "walk" then
		local step = k + math.sin(k * math.pi * 6) * 0.03 -- cautious, slightly halting steps
		a.pos = from:Lerp(to, smooth(step))
		a.gaitPhase += dt * 1.8
	elseif kind == "leap" then
		local q = math.min(1, k / 0.8)
		a.pos = from:Lerp(to + (to - from).Unit * -1.5, q):Lerp(to, math.max(0, (k - 0.8) / 0.2))
		a.groundY = en.y0 + math.sin(q * math.pi) * 4.5 * s
		if k >= 0.8 and not en.landed then
			en.landed = true
			a.landSquash = 1
		end
	elseif kind == "glide" then
		a.pos = from:Lerp(to, easeOut(k))
		a.groundY = en.y0 + math.sin(k * math.pi) * (reduced and 2 or 5) * s
	elseif kind == "spiral" then
		local r = (1 - k) * 2.2 * s
		a.pos = from:Lerp(to, easeOut(k)) + Vector3.new(math.cos(k * math.pi * 2) * r, 0, math.sin(k * math.pi * 2) * r)
		a.groundY = en.y0 + math.sin(k * math.pi) * 1.5 * s
		a.yaw = en.yaw0 + (reduced and 0 or smooth(k) * math.pi * 2)
	elseif kind == "drift" then
		a.pos = from:Lerp(to, easeOut(k))
		a.groundY = en.y0 + math.sin(k * math.pi) * 1.2 * s
	elseif kind == "roll" then
		a.pos = from:Lerp(to, easeOut(math.min(1, k / 0.75)))
		a.rootRoll = (1 - smooth(math.min(1, k / 0.75))) * math.pi * 4
		if k > 0.75 and not en.landed then
			en.landed = true
			a.landSquash = 1
		end
	elseif kind == "peek" then
		local side = en.side
		local peeks = en.peeks
		if k < 0.6 then
			local q = (k / 0.6) * peeks
			local out = math.sin((q % 1) * math.pi)
			a.pos = from + Vector3.new(side * (3.2 + out * 1.2) * s, 0, -0.5)
			a.yaw = en.yaw0 - side * 0.5
		else
			local q = (k - 0.6) / 0.4
			a.pos = (from + Vector3.new(side * 3.2 * s, 0, -0.5)):Lerp(to, smooth(q))
			a.yaw = en.yaw0 - side * 0.5 * (1 - q)
		end
	elseif kind == "emerge" then
		if k < 0.45 then
			a.pos = from
			a:SetScale(0.35 + 0.65 * easeOut(k / 0.45))
		else
			a:SetScale(1)
			a.pos = from:Lerp(to, smooth((k - 0.45) / 0.55))
			a.gaitPhase += dt * 1.4
		end
	elseif kind == "rise" then
		if k < 0.5 then
			a.pos = from
			a.groundY = en.y0 + easeOut(k / 0.5) * 4 * s
		else
			local q = (k - 0.5) / 0.5
			a.pos = from:Lerp(to, smooth(q))
			a.groundY = en.y0 + (1 - easeIn(q)) * 4 * s
		end
	elseif kind == "descend" then
		a.pos = to
		a.groundY = en.y0 + (1 - easeOut(k)) * (reduced and 8 or 18) * s
	elseif kind == "resolve" then
		-- bounded, deterministic offsets (seeded per creature) resolving into one stable body
		local beats = 3
		local q = math.floor(k / 0.75 * beats)
		if k < 0.75 and not reduced then
			local off = a.fragOffsets[(q % 4) + 1] or Vector3.zero
			a.pos = to + Vector3.new(off.X, 0, off.Z) * 2 * (1 - k)
			if q ~= en.lastBeat then
				en.lastBeat = q
				Effects.Burst(a.pos + Vector3.new(0, 2, 0), GLITCH, 6, 6, 0.4)
			end
		else
			a.pos = to
		end
	elseif kind == "slither" then
		a.pos = from:Lerp(to, smooth(k)) + Vector3.new(math.sin(k * math.pi * 3) * (1 - k) * 1.5 * s, 0, 0)
		a.gaitPhase += dt * 2
	elseif kind == "stomp" then
		local steps = 3
		local q = k * steps
		local stepIdx = math.min(math.floor(q), steps - 1)
		local frac = q - stepIdx
		a.pos = from:Lerp(to, (stepIdx + smooth(frac)) / steps)
		if stepIdx ~= en.lastStep then
			en.lastStep = stepIdx
			a.landSquash = 1
			if e.owner == player.UserId and Config.Rarities[CreatureData.ById[e.id].rarity].order >= 5 then
				Effects.Shake(0.4, 0.12)
			end
		end
	end
	if kind ~= "emerge" then
		a:SetScale(pop)
	end
	if kind ~= "spiral" and kind ~= "peek" then
		a.yaw = en.yaw0
	end
	a.targetYaw = a.yaw
	if k >= 1 then
		finishEntrance(e)
	end
end

-- The creature appears inside the open portal (at `pos`) and comes out toward the thrower (-Z).
function Renderer.SpawnWild(throwId, creatureId, pos, ownerId, chanceText)
	if wild[throwId] then
		return wild[throwId]
	end -- duplicate event: never two models per throw
	local def = CreatureData.ById[creatureId]
	if not def then
		return nil
	end
	local cf = CFrame.lookAt(pos + Vector3.new(0, 0, 1.5), pos + Vector3.new(0, 0, -10))
	local e = spawnEntry(creatureId, cf, "wild", 0)
	local prof = e.rig.profile
	local enter = prof.enter or {}
	local kind = enter.kind or MOVE_ENTRANCE[def.move] or "walk"
	local _, yaw0 = cf:ToEulerAnglesYXZ()
	local dur = Timeline.EntranceFor(def.rarity)
	e.entrance = {
		kind = kind,
		t = 0,
		dur = dur,
		from = pos + Vector3.new(0, 0, 1.5),
		to = pos + Vector3.new(0, 0, -9),
		y0 = pos.Y,
		yaw0 = yaw0,
		color = Config.Rarities[def.rarity].color,
		hops = enter.hops or 3,
		peeks = enter.peeks or 1,
		side = (throwId % 2 == 0) and 1 or -1,
	}
	e.anim:SetScale(kind == "emerge" and 0.35 or 0.02)
	e.anim:PlayAccent("enter", dur)
	e.throwId = throwId
	e.owner = ownerId
	local rc = Config.Rarities[def.rarity].color
	local owner = Players:GetPlayerByUserId(ownerId)
	local mine = ownerId == player.UserId
	local labelText = mine and def.name
		or string.format(
			"%s\n<font size='16'>%s · %s · %s</font>",
			def.name,
			def.rarity,
			chanceText or "",
			owner and owner.DisplayName or "?"
		)
	tag(e, labelText, def.rarity == "Secret" and Color3.fromRGB(147, 217, 235) or rc, 160, heightFor(def) + 0.5)
	if mine then
		-- Corner marks frame the automatic catch without covering the creature in a filled disk.
		local center = pos + Vector3.new(0, 0.12, -9)
		for _, x in { -1, 1 } do
			for _, z in { -1, 1 } do
				own(
					e,
					Effects.Part(
						Vector3.new(1.5, 0.045, 0.12),
						CFrame.new(center + Vector3.new(x * 2.1, 0, z * 2.7)),
						rc,
						Enum.Material.SmoothPlastic,
						0.18
					)
				)
				own(
					e,
					Effects.Part(
						Vector3.new(0.12, 0.045, 1.5),
						CFrame.new(center + Vector3.new(x * 2.7, 0, z * 2.1)),
						rc,
						Enum.Material.SmoothPlastic,
						0.18
					)
				)
			end
		end
	end
	wild[throwId] = e
	return e
end

---------------------------------------------------------------- capture
-- turns = limited rotation during the lift (no 12-spin blender); text is always positive
local CATCH = {
	Common = {
		turns = 0,
		rise = 4,
		burst = 10,
		wave = 4,
		text = "Caught!",
		size = 0.85,
		ring = Color3.fromRGB(200, 225, 255),
	},
	Uncommon = { turns = 0, rise = 5, burst = 16, wave = 6, text = "Nice catch!", size = 0.95 },
	Rare = { turns = 0.5, rise = 6, burst = 26, wave = 9, text = "Great catch!", size = 1.1 },
	Epic = { turns = 0.5, rise = 7, burst = 36, wave = 12, text = "Amazing catch!", size = 1.25, shake = 0.4 },
	Legendary = {
		turns = 0.75,
		rise = 8,
		burst = 50,
		wave = 16,
		text = "LEGENDARY CATCH!",
		size = 1.45,
		shake = 0.7,
		beam = true,
	},
	Mythical = {
		turns = 1,
		rise = 9,
		burst = 60,
		wave = 20,
		text = "MYTHICAL CATCH!",
		size = 1.55,
		shake = 0.9,
		beam = true,
	},
	Secret = {
		turns = 0,
		rise = 7,
		burst = 50,
		wave = 18,
		text = "??? SECRET ???",
		size = 1.55,
		shake = 0.7,
		glitch = true,
	},
	Divine = {
		turns = 1,
		rise = 10,
		burst = 70,
		wave = 24,
		text = "DIVINE CATCH!",
		size = 1.7,
		shake = 0.8,
		beam = true,
	},
}
Renderer.CatchConfig = CATCH

function Renderer.RemoveWild(throwId, reason, collectorId)
	local e = wild[throwId]
	if not e then
		return
	end
	wild[throwId] = nil
	if reason ~= "collected" then
		e.fadeT = 0
		return
	end
	local ok = pcall(function()
		if e.entrance then
			finishEntrance(e)
		end
		local rarity = CreatureData.ById[e.id].rarity
		local cfg = CATCH[rarity] or CATCH.Common
		local col = Config.Rarities[rarity].color
		local base = e.anim.pos
		e.anim.home = nil
		e.anim.moveTarget = nil
		e.anim:LookAt(nil)
		e.catchCfg = cfg
		e.catchDur = Timeline.CaptureFor(rarity)
		e.anim:PlayAccent("capture", e.catchDur * Timeline.CaptureAccent)
		if cfg.beam and not Settings.LowVFX() then
			Effects.LightBeam(base, rarity == "Divine" and Color3.fromRGB(255, 250, 220) or col, 90, e.catchDur + 0.4)
		end
		e.collectT = 0
		e.catchBase = base
		e.catchY = e.anim.groundY
		e.catchYaw = e.anim.yaw
		local ringSize = 4.5 + Config.Rarities[rarity].order * 0.9
		local ring = Effects.Part(
			Vector3.new(0.3, 1, 1),
			CFrame.new(base + Vector3.new(0, cfg.rise, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			cfg.ring or col,
			Enum.Material.Neon,
			0.15
		)
		ring.Shape = Enum.PartType.Cylinder
		Effects.Tween(ring, 0.35, { Size = Vector3.new(0.3, ringSize, ringSize) }, Enum.EasingStyle.Back)
		e.catchRing = own(e, ring)
	end)
	if not ok then
		e.fadeT = 0
	end -- degrade to a simple fade; the server already granted the pet
end

local function stepCapture(e, dt)
	e.collectT += dt
	local cfg = e.catchCfg or CATCH.Common
	local dur = e.catchDur or 1
	local k = math.clamp(e.collectT / dur, 0, 1)
	local a = e.anim
	local rarity = CreatureData.ById[e.id].rarity
	local col = cfg.ring or Config.Rarities[rarity].color
	local top = e.catchBase + Vector3.new(0, cfg.rise, 0)
	local acc = Timeline.CaptureAccent
	if k > acc then
		-- 20% species accent (held pose) -> ~60% lift with gentle contraction -> final light
		local q = math.clamp((k - acc) / 0.6, 0, 1)
		local f = math.clamp((k - acc - 0.6) / (1 - acc - 0.6), 0, 1)
		local sway = (1 - q) * 1.2
		a.pos = e.catchBase
			+ Vector3.new(
				math.sin(q * math.pi * 2) * sway * 0.4,
				0,
				math.cos(q * math.pi * 2) * sway * 0.4 - sway * 0.4
			)
		a.groundY = e.catchY + smooth(q) * cfg.rise * 0.9 + f * cfg.rise * 0.1
		a.yaw = e.catchYaw + smooth(q) * math.pi * 2 * cfg.turns
		a.targetYaw = a.yaw
		local sc = (1 - 0.65 * smooth(q)) * (1 - f)
		if cfg.glitch and not Settings.ReducedMotion then
			local beat = math.floor(q * 4)
			if beat ~= e.lastBeat then
				e.lastBeat = beat
				if beat < 4 then
					Effects.Burst(a.pos + Vector3.new(0, a.groundY - e.catchY + 1, 0), GLITCH, 5, 6, 0.35)
				end
			end
		end
		a:SetScale(math.max(0.01, sc))
	end
	if e.catchRing and e.catchRing.Parent then
		e.catchRing.CFrame = CFrame.new(top) * CFrame.Angles(0, os.clock() * 3, math.pi / 2)
	end
	if k >= 1 then
		local mine = e.owner == player.UserId
		if not Settings.LowVFX() or Config.Rarities[rarity].order >= 5 then
			Effects.Burst(top, ColorSequence.new(col, Color3.new(1, 1, 1)), cfg.burst, 14, 0.8)
		end
		if cfg.wave > 0 then
			Effects.Shockwave(top, col, cfg.wave, 0.5)
		end
		if mine then
			Effects.FloatingText(
				top + Vector3.new(0, 2, 0),
				cfg.text,
				rarity == "Common" and Color3.fromRGB(215, 235, 255) or col,
				cfg.size
			)
			if cfg.shake then
				Effects.Shake(cfg.shake, 0.35)
			end
		end
		local r = e.catchRing
		if r then
			Effects.Tween(r, 0.3, { Size = Vector3.new(0.3, 0.1, 0.1), Transparency = 1 })
			task.delay(0.35, function()
				if r.Parent then
					r:Destroy()
				end
			end)
			e.catchRing = nil
		end
		Renderer.CaptureFinished:Fire(e.throwId, e.owner, e.id)
		return true
	end
	return false
end

---------------------------------------------------------------- per-frame update
local function myRoot()
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

-- update rate tiers with hysteresis: near every frame, mid 20 Hz, far 8 Hz, beyond: pose frozen
local TIERS = { { 70, 0 }, { 150, 1 / 20 }, { 260, 1 / 8 } }
local function tierFor(e, d)
	local cur = e.tier
	local margin = 10
	for i, t in ipairs(TIERS) do
		local limit = t[1] + ((i >= cur) and margin or -margin)
		if d < limit then
			return i
		end
	end
	return #TIERS + 1
end

RunService.RenderStepped:Connect(function(dt)
	local camPos = camera.CFrame.Position
	local root = myRoot()
	local myPos = root and root.Position
	local head = player.Character and player.Character:FindFirstChild("Head")
	local now = os.clock()
	for e in pairs(active) do
		local anim = e.anim
		if not anim or not anim.rig then
			active[e] = nil
			continue
		end
		-- pop-in
		if e.popT then
			e.popT += dt
			local k = math.clamp(e.popT / e.popDur, 0, 1)
			anim:SetScale(math.max(0.01, elastic(k)))
			if k >= 1 then
				e.popT = nil
				anim:SetScale(1)
			end
		end
		if e.entrance and not e.collectT and not e.fadeT then
			local ok = pcall(stepEntrance, e, dt)
			if not ok then
				pcall(finishEntrance, e)
			end
		end
		if e.collectT then
			local ok, done = pcall(stepCapture, e, dt)
			if not ok or done then
				if not ok then
					Renderer.CaptureFinished:Fire(e.throwId, e.owner, e.id)
				end
				destroyEntry(e)
				continue
			end
		elseif e.fadeT then
			e.fadeT += dt
			anim:SetScale(math.max(0.01, 1 - e.fadeT / 0.6))
			if e.fadeT > 0.6 then
				destroyEntry(e)
				continue
			end
		end
		-- free-roaming base pets: inside their own base, around (not through) solid decor
		if e.kind == "base" and e.baseCF then
			if not anim.moveTarget and anim.home and not anim.reactT and not anim.sigT then
				e.roamT = (e.roamT or anim.rng:NextNumber(1, 5)) - dt
				if e.roamT <= 0 then
					e.roamT = anim.rng:NextNumber(4, 9)
					local target = pickRoam(e)
					if target then
						anim:MoveTo(target)
					end
				end
			end
			anim.idleTimer = 99 -- roaming decisions come from pickRoam above
			e.groundT = (e.groundT or anim.rng:NextNumber() * 0.4) - dt
			if e.groundT <= 0 then
				e.groundT = 0.4
				groundParams.FilterDescendantsInstances = { folder, Effects.Folder, player.Character }
				local hit = workspace:Raycast(anim.pos + Vector3.new(0, 12, 0), Vector3.new(0, -30, 0), groundParams)
				if hit and hit.Position.Y < 2.5 then
					e.targetGround = hit.Position.Y
				end
			end
			if e.targetGround then
				anim.groundY += (e.targetGround - anim.groundY) * math.min(1, dt * 10)
			end
		end
		-- followers trail behind their carrier
		if e.kind == "carry" and e.follow then
			local hrp = e.follow.Character and e.follow.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local back = hrp.CFrame
					* CFrame.new((e.followIndex % 2 == 0 and 2.5 or -2.5), 0, 3.5 + e.followIndex * 2.6)
				local dist = (anim.pos - back.Position).Magnitude
				anim.groundY = hrp.Position.Y - 3
				if dist > 60 then
					anim:Teleport(back * CFrame.new(0, -3, 0))
				end
				if dist > 1.5 then
					anim:MoveTo(back.Position, math.clamp(dist * 2.2, 6, 40))
				end
			end
		end
		-- LOD tiers (with hysteresis); wild reveals and captures always update every frame
		local d = (anim.pos - camPos).Magnitude
		local tier = (e.kind == "wild") and 1 or tierFor(e, d)
		if tier ~= e.tier then
			e.tier = tier
			local emit = tier <= 2
			for _, pe in ipairs(e.rig.emitters) do
				pe.Enabled = emit
			end
		end
		e.acc += dt
		if tier <= #TIERS and now >= e.nextStep then
			e.nextStep = now + TIERS[tier][2]
			-- attention: look at the local player when close; a reaction at most every ~15 s
			if myPos and e.kind == "base" then
				local pd = (anim.pos - myPos).Magnitude
				e.reactCd -= e.acc
				if pd < 12 then
					anim:LookAt(head and head.Position or myPos)
					if pd < 7 and e.reactCd <= 0 then
						e.reactCd = anim.rng:NextNumber(14, 22)
						anim:React("pet")
					end
				else
					anim:LookAt(nil)
				end
			end
			anim:Step(e.acc)
			e.acc = 0
		end
		if e.tag and not e.tagFixed and e.model.Parent and (e.kind ~= "wild" or not e.entrance) then
			-- place the name tag above the VISIBLE geometry once it has been solved
			e.tagFixed = true
			local okB, bcf, bsize = pcall(Builder.VisualBounds, e.model)
			if okB and bsize.Magnitude > 0.5 then
				local top = bcf.Position.Y + bsize.Y / 2 - anim.groundY
				if top > 0.5 and top < 40 then
					e.tag.StudsOffsetWorldSpace = Vector3.new(0, top + 1.2, 0)
				end
			end
		end
	end
end)

---------------------------------------------------------------- wiring
local function watchPlayer(plr)
	plr:GetAttributeChangedSignal("BaseCreatures"):Connect(function()
		refreshBase(plr)
	end)
	plr:GetAttributeChangedSignal("BaseIndex"):Connect(function()
		refreshBase(plr)
	end)
	plr:GetAttributeChangedSignal("Carry"):Connect(function()
		refreshCarry(plr)
	end)
	task.spawn(function()
		workspace:WaitForChild("Bases", 30)
		refreshBase(plr)
		refreshCarry(plr)
	end)
end

function Renderer.Start()
	for _, plr in ipairs(Players:GetPlayers()) do
		watchPlayer(plr)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	Players.PlayerRemoving:Connect(function(plr)
		for _, e in ipairs(basePets[plr.UserId] or {}) do
			destroyEntry(e)
		end
		for _, e in ipairs(carried[plr.UserId] or {}) do
			destroyEntry(e)
		end
		basePets[plr.UserId], carried[plr.UserId] = nil, nil
		for id, e in pairs(wild) do
			if e.owner == plr.UserId then
				wild[id] = nil
				e.fadeT = 0
			end
		end
	end)
end

-- Builds a static (non-animated) creature for UI ViewportFrames, in its bind pose.
function Renderer.BuildPreview(creatureId)
	local model, rig = Builder.Build(creatureId)
	for _, e in ipairs(rig.emitters) do
		e.Enabled = false
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Fire") or d:IsA("PointLight") then
			d:Destroy()
		end
	end
	return model, rig
end

-- debug / test helpers
function Renderer.ActiveCount()
	local n = 0
	for _ in pairs(active) do
		n += 1
	end
	return n
end
function Renderer.Entries()
	return active
end

return Renderer
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- Effects: camera shake, flashes, shockwaves, particle bursts, light beams, floating text,
-- flying-coin money effect, rarity banners and per-world lighting.
-- Location: StarterPlayer > StarterPlayerScripts > Client > Effects (ModuleScript)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Settings = require(script.Parent.ClientSettings)

local Effects = {}
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

local fxFolder = Instance.new("Folder")
fxFolder.Name = "ClientFX"
fxFolder.Parent = workspace
Effects.Folder = fxFolder

local gui = Instance.new("ScreenGui")
gui.Name = "FX"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 20
gui.Parent = player:WaitForChild("PlayerGui")
Effects.Gui = gui

local function tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
Effects.Tween = tween

---------------------------------------------------------------- camera shake
local shakeAmt, shakeEnd = 0, 0
RunService:BindToRenderStep("TPFC_Shake", Enum.RenderPriority.Camera.Value + 1, function()
	local now = os.clock()
	if now < shakeEnd then
		local k = (shakeEnd - now)
		local a = shakeAmt * math.min(1, k * 3)
		camera.CFrame = camera.CFrame * CFrame.Angles(math.noise(now * 25, 0) * a * 0.03, math.noise(0, now * 25) * a * 0.03, 0)
	end
end)
function Effects.Shake(intensity: number, duration: number)
	if not Settings.CameraShake then return end
	if Settings.ReducedMotion then intensity *= 0.4 end
	local active = os.clock() < shakeEnd
	shakeAmt = active and math.max(shakeAmt, intensity) or intensity
	shakeEnd = math.max(shakeEnd, os.clock() + duration)
end

---------------------------------------------------------------- screen flash
function Effects.Flash(color: Color3, duration: number?, strength: number?)
	if Settings.ReducedFlashes then return end
	-- never a full-opacity frame: cap strength so the scene stays visible
	strength = math.min(strength or 0.6, 0.35)
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = 1 - strength
	f.BorderSizePixel = 0
	f.ZIndex = 50
	f.Parent = gui
	tween(f, duration or 0.5, { BackgroundTransparency = 1 }).Completed:Once(function() f:Destroy() end)
end

---------------------------------------------------------------- world-space effects
local function fxPart(size, cf, color, mat, transp, meshType)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.Neon
	p.Transparency = transp or 0
	if meshType then
		local m = Instance.new("SpecialMesh"); m.MeshType = meshType; m.Parent = p
	end
	p.Parent = fxFolder
	return p
end
Effects.Part = fxPart

function Effects.Shockwave(pos: Vector3, color: Color3, radius: number?, time: number?)
	local r = radius or 14
	local ring = fxPart(Vector3.new(0.3, 1, 1), CFrame.new(pos + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon, 0.4)
	ring.Shape = Enum.PartType.Cylinder
	tween(ring, time or 0.6, { Size = Vector3.new(0.1, r * 2, r * 2), Transparency = 1 }, Enum.EasingStyle.Quart)
	task.delay((time or 0.6) + 0.05, function() ring:Destroy() end)
	-- inner dome pulse
	local dome = fxPart(Vector3.new(1, 1, 1), CFrame.new(pos), color, Enum.Material.ForceField, 0.92, Enum.MeshType.Sphere)
	tween(dome, (time or 0.6) * 0.8, { Size = Vector3.new(r, r * 0.6, r), Transparency = 1 }, Enum.EasingStyle.Quart)
	task.delay(time or 0.6, function() dome:Destroy() end)
end

function Effects.Burst(pos: Vector3, colorSeq, count: number?, speed: number?, size: number?, tex: string?)
	local p = fxPart(Vector3.new(0.2, 0.2, 0.2), CFrame.new(pos), Color3.new(1, 1, 1), nil, 1)
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = tex or SPARKLE
	pe.Color = typeof(colorSeq) == "Color3" and ColorSequence.new(colorSeq) or colorSeq
	pe.LightEmission = 1
	pe.Rate = 0
	pe.Lifetime = NumberRange.new(0.6, 1.4)
	pe.Speed = NumberRange.new((speed or 20) * 0.4, speed or 20)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Drag = 3
	pe.Acceleration = Vector3.new(0, -8, 0)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size or 1), NumberSequenceKeypoint.new(1, 0) })
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-200, 200)
	pe.Parent = p
	pe:Emit(count or 40)
	task.delay(2, function() p:Destroy() end)
end

function Effects.LightBeam(pos: Vector3, color: Color3, height: number?, duration: number?)
	local h = height or 120
	local beam = fxPart(Vector3.new(h, 0.5, 0.5), CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon, 0.78)
	beam.Shape = Enum.PartType.Cylinder
	local l = Instance.new("PointLight"); l.Color = color; l.Range = 18; l.Brightness = 1.2; l.Parent = beam
	tween(beam, 0.25, { Size = Vector3.new(h, 1.1, 1.1) }, Enum.EasingStyle.Quart)
	task.delay(0.35, function()
		tween(beam, duration or 1.6, { Size = Vector3.new(h, 0.2, 0.2), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(l, duration or 1.6, { Brightness = 0 })
	end)
	task.delay((duration or 1.6) + 0.5, function() beam:Destroy() end)
end

function Effects.FloatingText(pos: Vector3, text: string, color: Color3?, size: number?)
	local anchor = fxPart(Vector3.new(0.1, 0.1, 0.1), CFrame.new(pos), Color3.new(1, 1, 1), nil, 1)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(240, 60)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Parent = anchor
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = color or Color3.new(1, 1, 1)
	local st = Instance.new("UIStroke"); st.Thickness = 3; st.Color = Color3.fromRGB(30, 20, 40); st.Parent = t
	local sc = Instance.new("UIScale"); sc.Scale = 0.2; sc.Parent = t
	t.Parent = bb
	tween(sc, 0.35, { Scale = size or 1 }, Enum.EasingStyle.Back)
	tween(anchor, 1.6, { CFrame = CFrame.new(pos + Vector3.new(0, 6, 0)) }, Enum.EasingStyle.Quad)
	task.delay(1.1, function()
		tween(t, 0.5, { TextTransparency = 1 })
		tween(st, 0.5, { Transparency = 1 })
	end)
	task.delay(1.7, function() anchor:Destroy() end)
end

---------------------------------------------------------------- money: coins fly to the counter
Effects.MoneyTarget = nil -- set by UI to the money counter GuiObject
function Effects.Coins(worldPos: Vector3?, count: number?)
	local target = Effects.MoneyTarget
	if not target then return end
	local start
	if worldPos then
		local sp, onScreen = camera:WorldToViewportPoint(worldPos)
		start = onScreen and Vector2.new(sp.X, sp.Y) or camera.ViewportSize / 2
	else
		start = camera.ViewportSize / 2
	end
	local goal = target.AbsolutePosition + target.AbsoluteSize / 2 + Vector2.new(0, game:GetService("GuiService"):GetGuiInset().Y)
	for i = 1, count or 12 do
		task.delay(i * 0.03, function()
			local c = Instance.new("TextLabel")
			c.Size = UDim2.fromOffset(30, 30)
			c.AnchorPoint = Vector2.new(0.5, 0.5)
			c.Position = UDim2.fromOffset(start.X, start.Y)
			c.BackgroundColor3 = Color3.fromRGB(255, 205, 50)
			c.Text = "$"
			c.Font = Enum.Font.FredokaOne
			c.TextScaled = true
			c.TextColor3 = Color3.fromRGB(160, 100, 0)
			c.ZIndex = 40
			local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(1, 0); corner.Parent = c
			local st = Instance.new("UIStroke"); st.Color = Color3.fromRGB(255, 240, 160); st.Thickness = 2; st.Parent = c
			c.Parent = gui
			local mid = start + Vector2.new(math.random(-120, 120), math.random(-120, 40))
			tween(c, 0.25, { Position = UDim2.fromOffset(mid.X, mid.Y), Rotation = math.random(-40, 40) }, Enum.EasingStyle.Quad)
			task.delay(0.25, function()
				tween(c, 0.45, { Position = UDim2.fromOffset(goal.X, goal.Y), Size = UDim2.fromOffset(18, 18) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(0.45, function()
					c:Destroy()
					if Effects.OnCoinArrive then Effects.OnCoinArrive() end
				end)
			end)
		end)
	end
end

---------------------------------------------------------------- rarity banner
local revealCaption
function Effects.RarityBanner(def, chanceText)
	if revealCaption then revealCaption:Destroy() end
	local T=require(script.Parent.UITheme)
	local holder=Instance.new("Frame") holder.Name="RevealCaption" holder.AnchorPoint=Vector2.new(.5,1)
	holder.Position=UDim2.new(.5,0,1,-24) holder.Size=UDim2.new(.88,0,0,66) holder.BackgroundColor3=T.Panel holder.BackgroundTransparency=.05 holder.BorderSizePixel=0 holder.ZIndex=45 holder.Parent=gui
	revealCaption=holder
	local limit=Instance.new("UISizeConstraint") limit.MaxSize=Vector2.new(400,66) limit.Parent=holder
	local corner=Instance.new("UICorner") corner.CornerRadius=UDim.new(0,8) corner.Parent=holder
	local border=Instance.new("UIStroke") border.Color=T.Border border.Thickness=1 border.Parent=holder
	local function label(text,y,height,size,color,bold)
		local l=Instance.new("TextLabel") l.BackgroundTransparency=1 l.Size=UDim2.new(1,-32,0,height) l.Position=UDim2.fromOffset(16,y) l.Font=bold and T.Bold or T.Font l.TextSize=size l.TextColor3=color l.TextXAlignment=Enum.TextXAlignment.Left l.TextWrapped=true l.Text=text l.ZIndex=46 l.Parent=holder return l
	end
	local title=label(def.name,8,27,20,T.Text,true)
	local detail=label(def.rarity..(chanceText and (" · "..chanceText) or ""),36,21,14,T.Rarity(def.rarity,Config),false)
	task.delay(1.9,function()
		if not holder.Parent then return end
		if Settings.ReducedMotion then holder:Destroy() return end
		tween(holder,.18,{BackgroundTransparency=1}) tween(border,.18,{Transparency=1}) tween(title,.18,{TextTransparency=1}) tween(detail,.18,{TextTransparency=1})
		task.delay(.2,function() holder:Destroy() end)
	end)
end

---------------------------------------------------------------- lighting per world
local bloom, cc, atmo, rays
function Effects.SetupLighting()
	-- (Lighting.Technology can't be set by scripts; it's set to Future in the place file)
	pcall(function()
		Lighting.GlobalShadows = true
		Lighting.Brightness = 3
		Lighting.ShadowSoftness = 0.25
		Lighting.EnvironmentDiffuseScale = 1
		Lighting.EnvironmentSpecularScale = 1
		Lighting.GeographicLatitude = 35
	end)
	bloom = Lighting:FindFirstChild("TPFC_Bloom") or Instance.new("BloomEffect")
	bloom.Name = "TPFC_Bloom"; bloom.Intensity = 0.9; bloom.Size = 32; bloom.Threshold = 1.4; bloom.Parent = Lighting
	cc = Lighting:FindFirstChild("TPFC_CC") or Instance.new("ColorCorrectionEffect")
	cc.Name = "TPFC_CC"; cc.Saturation = 0.25; cc.Contrast = 0.12; cc.Brightness = 0.02; cc.Parent = Lighting
	rays = Lighting:FindFirstChild("TPFC_Rays") or Instance.new("SunRaysEffect")
	rays.Name = "TPFC_Rays"; rays.Intensity = 0.12; rays.Spread = 0.75; rays.Parent = Lighting
	atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = 0.32; atmo.Offset = 0.15; atmo.Haze = 1.6; atmo.Glare = 0.6; atmo.Parent = Lighting
	local dof = Lighting:FindFirstChild("TPFC_DOF") or Instance.new("DepthOfFieldEffect")
	dof.Name = "TPFC_DOF"; dof.FarIntensity = 0.18; dof.FocusDistance = 50; dof.InFocusRadius = 70; dof.NearIntensity = 0; dof.Parent = Lighting
	Effects.DOF = dof
	Effects.SetupExtras()
	Effects.SetupVignette()
end

---------------------------------------------------------------- cinematic vignette + letterbox bars
function Effects.SetupVignette()
	-- soft dark edges (four gradient frames), always on, drawn BELOW the HUD
	local vgui = Instance.new("ScreenGui")
	vgui.Name = "Vignette"
	vgui.IgnoreGuiInset = true
	vgui.ResetOnSpawn = false
	vgui.DisplayOrder = -5
	vgui.Parent = gui.Parent
	local edges = {
		{ UDim2.new(1, 0, 0.22, 0), UDim2.fromScale(0, 0), 90 },
		{ UDim2.new(1, 0, 0.22, 0), UDim2.fromScale(0, 0.78), -90 },
		{ UDim2.new(0.16, 0, 1, 0), UDim2.fromScale(0, 0), 0 },
		{ UDim2.new(0.16, 0, 1, 0), UDim2.fromScale(0.84, 0), 180 },
	}
	for _, e in ipairs(edges) do
		local f = Instance.new("Frame")
		f.Size, f.Position = e[1], e[2]
		f.BackgroundColor3 = Color3.new(0, 0, 0)
		f.BorderSizePixel = 0
		f.ZIndex = 1
		local g = Instance.new("UIGradient")
		g.Rotation = e[3]
		g.Transparency = NumberSequence.new(0.55, 1)
		g.Parent = f
		f.Parent = vgui
	end
end

local bars
function Effects.Letterbox(on: boolean)
	if not bars then
		bars = {}
		for i, pos in ipairs({ UDim2.fromScale(0, -0.12), UDim2.fromScale(0, 1) }) do
			local b = Instance.new("Frame")
			b.Size = UDim2.fromScale(1, 0.12)
			b.Position = pos
			b.BackgroundColor3 = Color3.new(0, 0, 0)
			b.BorderSizePixel = 0
			b.ZIndex = 45
			b.Parent = gui
			bars[i] = b
		end
	end
	tween(bars[1], 0.45, { Position = on and UDim2.fromScale(0, 0) or UDim2.fromScale(0, -0.12) }, Enum.EasingStyle.Quad)
	tween(bars[2], 0.45, { Position = on and UDim2.fromScale(0, 0.88) or UDim2.fromScale(0, 1) }, Enum.EasingStyle.Quad)
end

-- ambient particles that follow the camera, themed per zone
local AMBIENT = {
	Hub = { col = { Color3.fromRGB(241,202,115), Color3.fromRGB(168,139,244) }, rate=6, speed=.3, size=.12, accel=Vector3.new(0,.05,0) },
	Forest  = { col = { Color3.fromRGB(220, 255, 140), Color3.fromRGB(255, 240, 160) }, rate = 18, speed = 0.6, size = 0.35, accel = Vector3.new(0, 0.3, 0) },   -- fireflies
	Volcano = { col = { Color3.fromRGB(255, 140, 40), Color3.fromRGB(255, 60, 20) },    rate = 40, speed = 1.5, size = 0.3,  accel = Vector3.new(0, 4, 0) },      -- embers
	Frozen  = { col = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 235, 255) }, rate = 70, speed = 1,   size = 0.35, accel = Vector3.new(1, -4, 0) },     -- snow
	Crystal = { col = { Color3.fromRGB(200, 120, 255), Color3.fromRGB(100, 240, 255) }, rate = 30, speed = 0.5, size = 0.4,  accel = Vector3.new(0, 0.5, 0) },
	Candy   = { col = { Color3.fromRGB(255, 130, 200), Color3.fromRGB(140, 220, 255) }, rate = 30, speed = 0.8, size = 0.45, accel = Vector3.new(0, -1, 0) },
	Space   = { col = { Color3.fromRGB(255, 255, 220), Color3.fromRGB(160, 140, 255) }, rate = 50, speed = 0.2, size = 0.3,  accel = Vector3.zero },             -- stardust
	Shadow  = { col = { Color3.fromRGB(150, 60, 255), Color3.fromRGB(60, 0, 90) },      rate = 30, speed = 0.4, size = 0.6,  accel = Vector3.new(0, 0.6, 0) },
	Heaven  = { col = { Color3.fromRGB(255, 245, 190), Color3.fromRGB(255, 255, 255) }, rate = 40, speed = 0.6, size = 0.45, accel = Vector3.new(0, 1, 0) },     -- light motes
}
local ambientPart, ambientPE, currentWorld
local function setupAmbient()
	ambientPart = Instance.new("Part")
	ambientPart.Name = "Ambient"
	ambientPart.Anchored, ambientPart.CanCollide, ambientPart.CanQuery, ambientPart.CanTouch = true, false, false, false
	ambientPart.Transparency = 1
	ambientPart.Size = Vector3.new(80, 30, 80)
	ambientPart.Parent = fxFolder
	ambientPE = Instance.new("ParticleEmitter")
	ambientPE.Texture = SPARKLE
	ambientPE.Shape = Enum.ParticleEmitterShape.Box
	ambientPE.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
	ambientPE.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	ambientPE.LightEmission = 1
	ambientPE.Lifetime = NumberRange.new(3, 6)
	ambientPE.SpreadAngle = Vector2.new(180, 180)
	ambientPE.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.1), NumberSequenceKeypoint.new(0.8, 0.2), NumberSequenceKeypoint.new(1, 1) })
	ambientPE.Parent = ambientPart
	RunService.RenderStepped:Connect(function()
		ambientPart.CFrame = CFrame.new(camera.CFrame.Position + camera.CFrame.LookVector * 25)
	end)
end
local function applyAmbient(id)
	local a = AMBIENT[id]
	if not a or not ambientPE then return end
	ambientPE.Color = ColorSequence.new(a.col[1], a.col[2])
	ambientPE.Rate = a.rate
	ambientPE.Speed = NumberRange.new(a.speed * 0.5, a.speed)
	ambientPE.Acceleration = a.accel
	ambientPE.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, a.size), NumberSequenceKeypoint.new(1, 0) })
end

Settings.Changed.Event:Connect(function(key,value)
	if key=="AmbientMotes" then
		if value and not ambientPE then setupAmbient() applyAmbient(currentWorld or "Hub") end
		if ambientPE then ambientPE.Enabled=value end
	end
end)

local clouds, sky
local function setupSky()
	pcall(function()
		clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.6
		clouds.Color = Color3.new(1, 1, 1)
		clouds.Parent = workspace.Terrain
	end)
	sky = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky")
	sky.StarCount = 3000
	sky.SunAngularSize = 14
	sky.MoonAngularSize = 9
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting
end

function Effects.SetupExtras()
	-- The camera-following ambient particle field was removed on request and stays OFF by default.
	-- It only comes back if a player explicitly enables Settings.AmbientMotes.
	setupSky()
	if Settings.AmbientMotes then setupAmbient() end
end

---------------------------------------------------------------- procedural motifs (no fake textures)
-- Small local shapes for species accents: leaves, petals, embers, snowflakes, hearts, stars,
-- bubbles, clouds, honeycomb, arcs, rings. Each is a tiny anchored model that drifts and fades.
local PI = math.pi
local function shapePart(size, cf, color, meshType, mat, tr)
	local p = fxPart(size, cf, color, mat or Enum.Material.SmoothPlastic, tr or 0, meshType or Enum.MeshType.Sphere)
	return p
end

local function wedgePair(parts, cf, thick, h, base, color, mat)
	table.insert(parts, shapePart(Vector3.new(thick, h, base / 2), cf * CFrame.new(0, 0, -base / 4), color, Enum.MeshType.Wedge, mat))
	table.insert(parts, shapePart(Vector3.new(thick, h, base / 2), cf * CFrame.new(0, 0, base / 4) * CFrame.Angles(0, PI, 0), color, Enum.MeshType.Wedge, mat))
end

-- builds a shape at cf; returns list of { part, offset }
local function buildShape(kind, cf, color, k)
	local parts = {}
	if kind == "leaf" or kind == "petal" or kind == "flame" then
		local R = cf * CFrame.Angles(0, PI / 2, 0)
		local len, w = 0.9 * k, 0.45 * k
		local mat = kind == "flame" and Enum.Material.Neon or nil
		wedgePair(parts, R * CFrame.new(0, len / 4, 0), 0.06 * k, len / 2, w, color, mat)
		wedgePair(parts, R * CFrame.new(0, -len / 4, 0) * CFrame.Angles(0, 0, PI), 0.06 * k, len / 2, w, color, mat)
	elseif kind == "snowflake" then
		for i = 0, 2 do table.insert(parts, shapePart(Vector3.new(0.08, 0.8, 0.08) * k, cf * CFrame.Angles(0, 0, i * PI / 3), color, Enum.MeshType.Brick, Enum.Material.Neon)) end
	elseif kind == "star" then
		for i = 0, 1 do
			local R = cf * CFrame.Angles(0, 0, i * PI / 2) * CFrame.Angles(0, PI / 2, 0)
			wedgePair(parts, R * CFrame.new(0, 0.18 * k, 0), 0.05 * k, 0.36 * k, 0.16 * k, color, Enum.Material.Neon)
			wedgePair(parts, R * CFrame.new(0, -0.18 * k, 0) * CFrame.Angles(0, 0, PI), 0.05 * k, 0.36 * k, 0.16 * k, color, Enum.Material.Neon)
		end
	elseif kind == "heart" then
		table.insert(parts, shapePart(Vector3.new(0.4, 0.4, 0.18) * k, cf * CFrame.new(-0.16 * k, 0.1 * k, 0), color))
		table.insert(parts, shapePart(Vector3.new(0.4, 0.4, 0.18) * k, cf * CFrame.new(0.16 * k, 0.1 * k, 0), color))
		wedgePair(parts, cf * CFrame.new(0, -0.15 * k, 0) * CFrame.Angles(0, PI / 2, PI), 0.18 * k, 0.42 * k, 0.6 * k, color)
	elseif kind == "bubble" then
		table.insert(parts, shapePart(Vector3.new(1, 1, 1) * k, cf, color, Enum.MeshType.Sphere, Enum.Material.Glass, 0.5))
	elseif kind == "cloud" then
		for i = -1, 1 do table.insert(parts, shapePart(Vector3.new(1.1, 0.8, 0.9) * k * (1 - math.abs(i) * 0.2), cf * CFrame.new(i * 0.6 * k, 0, 0), color)) end
	elseif kind == "hex" then
		table.insert(parts, shapePart(Vector3.new(0.12, 0.7, 0.7) * k, cf * CFrame.Angles(0, PI / 2, 0), color, Enum.MeshType.Cylinder, Enum.Material.Glass, 0.3))
	elseif kind == "cube" then
		table.insert(parts, shapePart(Vector3.new(0.35, 0.35, 0.35) * k, cf, color, Enum.MeshType.Brick, Enum.Material.Neon))
	else -- mote
		table.insert(parts, shapePart(Vector3.new(0.3, 0.3, 0.3) * k, cf, color, Enum.MeshType.Sphere, Enum.Material.Neon))
	end
	return parts
end

-- animate a shape from cf along `velocity` with a spin, fading out over `life`
local function driftShape(kind, cf, color, k, velocity, life, spin)
	local parts = buildShape(kind, cf, color, k)
	local offsets = {}
	for i, p in ipairs(parts) do offsets[i] = cf:ToObjectSpace(p.CFrame) end
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t >= life then
			conn:Disconnect()
			for _, p in ipairs(parts) do p:Destroy() end
			return
		end
		local u = t / life
		local base = CFrame.new(cf.Position + velocity * t + Vector3.new(0, -0.5 * t * t * (velocity.Y < 0 and 1 or 0), 0)) * cf.Rotation * CFrame.Angles(0, t * (spin or 2), math.sin(t * 3) * 0.4)
		for i, p in ipairs(parts) do
			p.CFrame = base * offsets[i]
			p.LocalTransparencyModifier = math.max(0, (u - 0.6) / 0.4)
		end
	end)
end

local MOTIF_COLORS = {
	leaf = Color3.fromRGB(120, 210, 90), petal = Color3.fromRGB(255, 150, 210), ember = Color3.fromRGB(255, 150, 50),
	snow = Color3.fromRGB(230, 248, 255), star = Color3.fromRGB(255, 240, 160), cloud = Color3.fromRGB(255, 250, 255),
	honey = Color3.fromRGB(255, 190, 40), gold = Color3.fromRGB(255, 215, 90), cyan = Color3.fromRGB(125, 249, 255),
}
local RAINBOW = { Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 170, 60), Color3.fromRGB(255, 235, 80), Color3.fromRGB(110, 230, 110),
	Color3.fromRGB(90, 200, 255), Color3.fromRGB(120, 120, 255), Color3.fromRGB(210, 110, 255) }

local function arc(origin, forward, radius, n, colorAt, kind, k, life)
	local right = forward:Cross(Vector3.yAxis).Unit
	for i = 1, n do
		local a = (i - 1) / math.max(1, n - 1) * PI
		local pos = origin + right * math.cos(a) * radius + Vector3.new(0, math.sin(a) * radius, 0)
		task.delay(i * 0.03, driftShape, kind, CFrame.lookAt(pos, pos + forward), colorAt(i), k, Vector3.new(0, 0.3, 0), life, 0.5)
	end
end

local function ring(center, radius, n, kind, color, k, life, rise)
	for i = 1, n do
		local a = i / n * PI * 2
		local pos = center + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
		driftShape(kind, CFrame.new(pos), color, k, Vector3.new(0, rise or 0.5, 0), life, 1)
	end
end

-- kind: species accent event name (SpeciesProfiles fx); pos: creature centre; forward: facing
function Effects.Motif(kind: string, pos: Vector3, forward: Vector3, accent: Color3?, size: number?)
	local k = size or 1
	local low = Settings.LowVFX()
	local C = MOTIF_COLORS
	accent = accent or C.star
	if kind == "leaf" or kind == "leaves2" then
		for i = 1, (kind == "leaves2" and 2 or 1) do
			driftShape("leaf", CFrame.new(pos + Vector3.new((i - 1.5) * 1.2, 0.5, 0)) * CFrame.Angles(0.6, i, 0.3), C.leaf, k, Vector3.new((i - 1.5) * 0.6, -0.8, 0), 1.8, 1.5)
		end
	elseif kind == "petals" then
		for i = 1, low and 3 or 5 do
			driftShape("petal", CFrame.new(pos) * CFrame.Angles(0, i * 1.25, 0.5), C.petal, k * 0.8, Vector3.new(math.cos(i * 1.25), 2.5, math.sin(i * 1.25)), 1.2, 3)
		end
	elseif kind == "ember" then
		for i = 1, 3 do driftShape("flame", CFrame.new(pos + Vector3.new((i - 2) * 0.5, 0, 0)), C.ember, k * 0.6, Vector3.new(0, 3 + i, 0), 0.9, 4) end
	elseif kind == "puff" or kind == "groundSmoke" then
		Effects.Burst(pos - Vector3.new(0, 1, 0), ColorSequence.new(Color3.fromRGB(220, 210, 200)), low and 6 or 12, 6, 1.4, "rbxasset://textures/particles/smoke_main.dds")
	elseif kind == "frost" then
		Effects.Burst(pos - Vector3.new(0, 1, 0), ColorSequence.new(Color3.fromRGB(235, 248, 255)), low and 8 or 16, 6, 1.2, "rbxasset://textures/particles/smoke_main.dds")
	elseif kind == "snowflakes" then
		for i = 1, 3 do driftShape("snowflake", CFrame.new(pos + Vector3.new((i - 2) * 1.2, 1, 0)), C.snow, k * 0.8, Vector3.new(0, -0.5, 0), 1.6, 1) end
	elseif kind == "snowflakeRing" then
		ring(pos + Vector3.new(0, 4, 0), 3.5 * k, low and 4 or 6, "snowflake", C.snow, k, 1.4, -0.5)
	elseif kind == "bubble" then
		driftShape("bubble", CFrame.new(pos + Vector3.new(0, 1, 0)), accent, k * 0.8, Vector3.new(0, 1.2, 0), 0.7, 0)
	elseif kind == "flowerBud" then
		for i = 1, 5 do driftShape("petal", CFrame.new(pos + forward * 2.5) * CFrame.Angles(0, i * 1.25, 0.9), C.petal, k * 0.5, Vector3.new(math.cos(i * 1.25) * 0.6, 0.6, math.sin(i * 1.25) * 0.6), 1.4, 0.5) end
	elseif kind == "ashSwirl" or kind == "starburst" or kind == "nebulaPuff" or kind == "cometTrail" then
		local col = kind == "ashSwirl" and ColorSequence.new(Color3.fromRGB(120, 110, 110), Color3.fromRGB(255, 140, 60)) or ColorSequence.new(accent)
		Effects.Burst(pos, col, low and 10 or 24, 8, 0.8)
	elseif kind == "glint" or kind == "branchLight" or kind == "mote" then
		driftShape("star", CFrame.new(pos + Vector3.new(0, 2, 0)), kind == "branchLight" and Color3.fromRGB(140, 255, 180) or Color3.new(1, 1, 1), k * 1.2, Vector3.new(0, 0.8, 0), 0.6, 2)
	elseif kind == "auroraArc" or kind == "prismArcs" or kind == "rainbowArc" or kind == "rainbowRibbon" then
		if not low then arc(pos - forward * 2, forward, 4 * k, 7, function(i) return RAINBOW[i] end, "cube", k * 0.7, 1.4) end
	elseif kind == "wrapper" then
		for i = -1, 1, 2 do driftShape("petal", CFrame.new(pos + Vector3.new(i * 1.2, 1.5, 0)) * CFrame.Angles(0, 0, i * 0.6), accent, k, Vector3.new(i * 1.5, 1, 0), 0.8, 2) end
	elseif kind == "cloudPuff" or kind == "cloudRibbon" then
		for i = 1, kind == "cloudRibbon" and 4 or 2 do
			driftShape("cloud", CFrame.new(pos + Vector3.new((i - 2) * 1.6, -0.5, 0)), C.cloud, k, Vector3.new((i - 2) * 0.5, 0.4, 0), 1.5, 0)
		end
	elseif kind == "honeycomb" then
		ring(pos + Vector3.new(0, 2, 0) - forward * 1.5, 1.6 * k, low and 4 or 6, "hex", C.honey, k, 1.2, 0.2)
	elseif kind == "ringRipple" or kind == "primordialRing" or kind == "creationRing" or kind == "dawnDisk" then
		Effects.Shockwave(pos, kind == "ringRipple" and accent or C.gold, 9 * k, 0.9)
	elseif kind == "constellation" or kind == "galaxySpiral" then
		for i = 1, low and 4 or 7 do
			local a = i * 0.9
			driftShape("star", CFrame.new(pos + Vector3.new(math.cos(a) * (2 + i * 0.4), 3 + math.sin(i) * 1.5, math.sin(a) * (2 + i * 0.4))), C.star, k * 0.7, Vector3.zero, 1.6, 1)
		end
	elseif kind == "rift" or kind == "eclipseDisk" then
		local disk = fxPart(Vector3.new(0.2, 0.5, 0.5), CFrame.lookAt(pos + Vector3.new(0, 3, 0), pos + Vector3.new(0, 3, 0) + forward) * CFrame.Angles(0, PI / 2, 0),
			kind == "rift" and Color3.fromRGB(20, 0, 40) or Color3.fromRGB(10, 6, 16), Enum.Material.SmoothPlastic, 0.1)
		disk.Shape = Enum.PartType.Cylinder
		tween(disk, 0.4, { Size = Vector3.new(0.2, 7 * k, 7 * k) }, Enum.EasingStyle.Back)
		if kind == "eclipseDisk" then Effects.Shockwave(pos + Vector3.new(0, 3, 0), C.gold, 5 * k, 0.8) end
		task.delay(1.2, function() tween(disk, 0.5, { Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1 }) end)
		task.delay(1.8, function() disk:Destroy() end)
	elseif kind == "shadowMotes" then
		for i = 1, 2 do driftShape("mote", CFrame.new(pos + Vector3.new(i - 1.5, 0.5, 0)), Color3.fromRGB(70, 30, 120), k, Vector3.new(i - 1.5, 0.8, 0), 1.4, 0) end
	elseif kind == "goldenArch" then
		arc(pos - forward * 2, forward, 5 * k, low and 5 or 9, function() return C.gold end, "cube", k * 0.6, 1.6)
	elseif kind == "tailStars" then
		arc(pos + Vector3.new(0, 1, 0) - forward * 2, forward, 3 * k, 9, function() return Color3.new(1, 1, 1) end, "star", k * 0.7, 1.6)
	elseif kind == "helix" then
		for i = 1, low and 6 or 12 do
			local a = i * 0.7
			task.delay(i * 0.05, driftShape, "mote", CFrame.new(pos + Vector3.new(math.cos(a) * 2, i * 0.4, math.sin(a) * 2)), C.gold, k * 0.6, Vector3.new(0, 2, 0), 1.0, 0)
		end
	elseif kind == "clockRing" then
		ring(pos + Vector3.new(0, 3, 0), 3.5 * k, 12, "cube", C.cyan, k * 0.5, 1.4, 0)
	elseif kind == "seed" then
		driftShape("mote", CFrame.new(pos + forward * 2), Color3.fromRGB(255, 250, 220), k * 1.4, Vector3.new(0, 0.3, 0), 1.6, 0)
	elseif kind == "heart" then
		driftShape("heart", CFrame.new(pos + Vector3.new(0, 1, 0)), Color3.fromRGB(255, 120, 170), k, Vector3.new(0, 2, 0), 1.0, 0)
	else
		Effects.Burst(pos, ColorSequence.new(accent), low and 6 or 14, 8, 0.6)
	end
end

local HUB_LOOK = require(ReplicatedStorage.Shared.SanctuaryLook)

local LOOK = {
	Forest  = { exposure = 0.15, sat = 0.28, contrast = 0.12, bloom = 0.8, rays = 0.16, density = 0.3,  haze = 1.6 }, -- golden afternoon
	Volcano = { exposure = 0.1,  sat = 0.35, contrast = 0.2,  bloom = 1.2, rays = 0.2,  density = 0.36, haze = 2.4 },
	Frozen  = { exposure = 0.25, sat = 0.1,  contrast = 0.1,  bloom = 0.9, rays = 0.18, density = 0.35, haze = 2.0 },
	Crystal = { exposure = 0.3,  sat = 0.45, contrast = 0.18, bloom = 1.6, rays = 0.05, density = 0.38, haze = 1.4 },
	Candy   = { exposure = 0.25, sat = 0.4,  contrast = 0.08, bloom = 1.0, rays = 0.12, density = 0.28, haze = 1.2 },
	Space   = { exposure = 0.2,  sat = 0.4,  contrast = 0.2,  bloom = 1.8, rays = 0.0,  density = 0.12, haze = 0.4 },
	Shadow  = { exposure = 0.0,  sat = 0.3,  contrast = 0.28, bloom = 1.4, rays = 0.0,  density = 0.36, haze = 2.6 },
	Heaven  = { exposure = 0.35, sat = 0.15, contrast = 0.06, bloom = 1.3, rays = 0.3,  density = 0.25, haze = 2.2 },
}

function Effects.UpdateWorld(pos: Vector3)
	local inHub = pos.Z < Config.BarrierZ
	local id = inHub and "Hub" or Config.WorldAt(pos)
	if not id or id == currentWorld then return currentWorld end
	currentWorld = id
	local W = inHub and HUB_LOOK or Config.Worlds[id]
	applyAmbient(id)
	if clouds then
		local cover = ({ Hub = 0.25, Forest = 0.55, Volcano = 0.75, Frozen = 0.8, Crystal = 0.3, Candy = 0.6, Space = 0, Shadow = 0.7, Heaven = 0.9 })[id] or 0.5
		local ccol = ({ Volcano = Color3.fromRGB(90, 60, 60), Shadow = Color3.fromRGB(70, 40, 90), Candy = Color3.fromRGB(255, 210, 235) })[id] or Color3.new(1, 1, 1)
		tween(clouds, 2, { Cover = cover, Color = ccol })
	end
	-- per-zone grade (brother's LOOK) on the map-tuned sun/fog from Config; the hub keeps SanctuaryLook
	local look = (not inHub) and (LOOK[id] or LOOK.Forest) or nil
	tween(Lighting, 1.5, { Ambient = W.ambient, OutdoorAmbient = W.ambient, ClockTime = W.clock, FogColor = W.fog, Brightness = inHub and 2.15 or 2.4, ExposureCompensation = inHub and -.05 or look.exposure })
	if cc then tween(cc, 1.5, { TintColor = W.tint, Saturation = inHub and 0.04 or look.sat, Contrast = inHub and 0.08 or look.contrast }) end
	if atmo then tween(atmo, 1.5, { Color = W.atmo, Decay = W.fog, Haze = inHub and HUB_LOOK.haze or look.haze, Glare = inHub and HUB_LOOK.glare or .3, Offset = inHub and HUB_LOOK.offset or 0, Density = inHub and HUB_LOOK.density or look.density }) end
	if bloom then tween(bloom, 1.0, { Intensity = inHub and HUB_LOOK.bloom or look.bloom }) end
	if rays then tween(rays, 1.5, { Intensity = inHub and 0.12 or look.rays }) end
	local dof = Lighting:FindFirstChild("TPFC_DOF")
	if dof then tween(dof, 1.0, { FarIntensity = inHub and 0 or 0.12 }) end
	return id
end

return Effects
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">GameplayFeel</string><ProtectedString name="Source"><![CDATA[-- Quiet, state-driven feedback around the complete play loop. No extra HUD buttons.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local Format = require(RS.Shared.Format)
local State = require(script.Parent.ClientState)
local Settings = require(script.Parent.ClientSettings)
local Sounds = require(script.Parent.Sounds)
local Effects = require(script.Parent.Effects)
local Feel = {}
local player = Players.LocalPlayer
local started = false
function Feel.Start(TC, HUD)
	if started then
		return
	end
	started = true
	local route = Instance.new("Folder")
	route.Name = "FirstThrowGuide"
	route.Parent = Effects.Folder
	local markers = {}
	for i = 1, 4 do
		local p = Instance.new("Part")
		p.Name = "ApproachMarker"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Size = Vector3.new(1.3, 0.035, 1.3)
		p.Color = Color3.fromRGB(241, 202, 115)
		p.Material = Enum.Material.SmoothPlastic
		p.CFrame = CFrame.new(0, 0.29, -55 + i * 4.6) * CFrame.Angles(0, math.pi / 4, 0)
		p.Transparency = 1
		p.Parent = route
		markers[i] = p
	end
	local lastCount, firstCatchHint, readyHint = nil, false, false
	local lastStep, lastZone = 0, nil
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.1 then
			return
		end
		acc = 0
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local active = State.Loaded
			and #State.Data.Creatures == 0
			and root
			and root.Position.Z < Config.ThrowZone.minZ
			and root.Position.Z > -125
			and not TC.Charging
			and not TC.Submitting
			and not TC.MyThrow
			and not HUD.AnyPanelOpen()
		for i, p in markers do
			p.Transparency = active
					and (Settings.ReducedMotion and 0.4 or 0.45 + 0.18 * math.sin(os.clock() * 2 - i * 0.7))
				or 1
		end
		if not State.Loaded then
			return
		end
		if HUD.InZone and not readyHint and #State.Data.Creatures == 0 and not HUD.AnyPanelOpen() then
			readyHint = true
			HUD.Notify("Hold to charge. Release in the gold zone for a perfect throw.", "info")
		end
		local count = #State.Data.Creatures
		if lastCount == 0 and count > lastCount and not firstCatchHint then
			firstCatchHint = true
			task.delay(4, function()
				if not HUD.AnyPanelOpen() then
					HUD.Notify("Your garden earns coins. Step on its green pad to collect them.", "info")
				end
			end)
		end
		lastCount = count
		-- One progress notification when training or upgrades newly unlock a zone's reach.
		local max = (State.Data.MaxDistance or 40) * 1.15
		local zone = "Forest"
		for _, id in Config.WorldOrder do
			if max >= Config.ZoneBounds[id][1] then
				zone = id
			end
		end
		if lastZone and zone ~= lastZone and max > lastStep then
			HUD.Notify(Config.Worlds[zone].name .. " is now within throw range.", "success")
		end
		lastZone, lastStep = zone, max
	end)
end
local pendingAmount, pendingPosition = 0, nil
local moneyScheduled = false
local lastMoneySound = -10
function Feel.Money(amount, position)
	pendingAmount += amount
	pendingPosition = position
	if moneyScheduled then
		return
	end
	moneyScheduled = true
	task.delay(0.12, function()
		local value, pos = pendingAmount, pendingPosition
		pendingAmount, pendingPosition, moneyScheduled = 0, nil, false
		if not pos or value <= 0 then
			return
		end
		if os.clock() - lastMoneySound > 0.65 then
			Sounds.Play("Money")
			lastMoneySound = os.clock()
		end
		Effects.Coins(pos, Settings.LowVFX() and 3 or math.clamp(math.floor(math.log10(value + 1) * 3), 4, 12))
		Effects.FloatingText(pos + Vector3.new(0, 3, 0), "+" .. Format.Money(value), Color3.fromRGB(159, 223, 180), 1)
		if not Settings.LowVFX() then
			Effects.Burst(pos + Vector3.new(0, 0.5, 0), Color3.fromRGB(241, 202, 115), 8, 5, 0.25)
		end
	end)
end
return Feel
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[-- Compact sanctuary HUD and one shared, responsive panel layer.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Input = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local Format = require(RS.Shared.Format)
local K = require(script.Parent.UIKit)
local T = K.Theme
local State = require(script.Parent.ClientState)
local Settings = require(script.Parent.ClientSettings)
local Effects = require(script.Parent.Effects)
local Sounds = require(script.Parent.Sounds)
local HUD = { Panels = {}, SideButtons = {}, InZone = false, TrainHeld = false, AutoTrain = false }
local player = Players.LocalPlayer
local gui = K.new("ScreenGui", {
	Name = "HUD",
	ResetOnSpawn = false,
	DisplayOrder = 10,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})
local root = K.new("Frame", { Name = "Root", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
local scaler = K.new("UIScale", { Parent = root })
HUD.Gui, HUD.Root = gui, root
local world =
	K.new("Frame", { Name = "Gameplay", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = root })
local top = K.new("Frame", { Name = "Resources", BackgroundTransparency = 1, Parent = world })
local stats = {}
local function stat(key, icon, caption, accent)
	local f = K.surface(top, key, UDim2.fromOffset(170, 54), nil, T.Panel)
	K.Icon(icon, f, UDim2.fromOffset(25, 25), accent, UDim2.fromOffset(12, 14))
	local value = K.text(f, "0", 48, 5, -54, 25, 21, T.Text, true)
	local sub = K.text(f, caption, 48, 31, -54, 17, 13, T.Muted)
	table.insert(stats, f)
	return value, sub, f
end
local money, income, moneyIcon = stat("Money", "Coin", "Income", T.Gold)
local shownMoney = 0
local power, distance = stat("Reach", "Arrow", "Throw range", T.Cyan)
local strength = stat("Strength", "Strength", "Strength", T.Violet)
local placed, storage = stat("Capacity", "Pet", "Garden slots", T.Success)
Effects.MoneyTarget = moneyIcon
Effects.OnCoinArrive = function()
	K.pop(moneyIcon)
end
local side = K.new(
	"Frame",
	{ Name = "Navigation", BackgroundTransparency = 1, Parent = world },
	{ K.list(Enum.FillDirection.Vertical, 5) }
)
local navOrder = {}
local menuBtn = K.button("Menu", T.Panel, nil, UDim2.fromOffset(100, 48), {
	Name = "Menu",
	Parent = world,
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 12, 1, -12),
	Visible = false,
})
menuBtn.Label.Position = UDim2.fromOffset(35, 0)
menuBtn.Label.Size = UDim2.new(1, -42, 1, 0)
K.Icon("Menu", menuBtn, UDim2.fromOffset(20, 20), T.Text, UDim2.fromOffset(10, 14))
local homeBtn = K.button("Home", T.Panel, nil, UDim2.fromOffset(84, 48), {
	Name = "QuickHome",
	Parent = world,
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 120, 1, -12),
	Visible = false,
})
function HUD.AddSideButton(name, icon, _a, _b, callback)
	if HUD.SideButtons[name] then
		return HUD.SideButtons[name]
	end
	local b = K.button(
		name,
		T.Panel,
		nil,
		UDim2.fromOffset(112, 44),
		{ Name = "Nav_" .. name, LayoutOrder = #navOrder + 1, Parent = side }
	)
	b.Label.Position = UDim2.fromOffset(41, 0)
	b.Label.Size = UDim2.new(1, -47, 1, 0)
	b.Label.TextSize = 14
	b.Label.TextXAlignment = Enum.TextXAlignment.Left
	K.Icon(icon, b, UDim2.fromOffset(22, 22), T.Violet, UDim2.fromOffset(11, 11))
	K.bind(b, callback)
	b.Visible = false
	HUD.SideButtons[name] = b
	table.insert(navOrder, { name = name, icon = icon, callback = callback })
	return b
end
local launch = K.surface(world, "LaunchGuide", UDim2.fromOffset(354, 102), UDim2.new(1, -370, 1, -126), T.Panel)
local launchTitle = K.text(launch, "Enter the Launch Hall", 16, 12, -32, 24, 17, T.Text, true)
local launchHint = K.text(launch, "Charge a portal to discover a creature.", 16, 40, -32, 22, 14, T.Muted)
local bar = K.new("Frame", {
	Name = "ChargeTrack",
	Size = UDim2.new(1, -32, 0, 8),
	Position = UDim2.fromOffset(16, 79),
	BackgroundColor3 = T.Ink,
	Parent = launch,
}, { K.corner(4) })
K.new("Frame", {
	Name = "PerfectZone",
	Position = UDim2.fromScale(0.92, 0),
	Size = UDim2.fromScale(0.08, 1),
	BackgroundColor3 = T.Gold,
	Parent = bar,
}, { K.corner(3) })
local fill = K.new(
	"Frame",
	{ Name = "ChargeFill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.Violet, Parent = bar },
	{ K.corner(3) }
)
local throwBtn = K.button(
	"Charge portal",
	T.Gold,
	nil,
	UDim2.fromOffset(164, 52),
	{ Name = "Throw", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Parent = world }
)
HUD.ThrowButton = throwBtn
throwBtn.InputBegan:Connect(function(i)
	if
		(i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1)
		and not HUD.AnyPanelOpen()
		and HUD.TC
	then
		HUD.TC.BeginCharge("Pointer")
	end
end)
Input.InputEnded:Connect(function(i)
	if
		(i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1)
		and HUD.TC
		and HUD.TC.Charging
	then
		HUD.TC.EndCharge("Pointer")
	end
end)
local train = K.surface(world, "Gym", UDim2.fromOffset(470, 114), UDim2.new(0.5, -235, 1, -144), T.Panel)
train.Visible = false
local trainTitle = K.text(train, "Personal gym", 14, 9, -28, 22, 17, T.Text, true)
local lift = K.button(
	"Lift",
	T.Gold,
	nil,
	UDim2.fromOffset(160, 44),
	{ Name = "Lift", Position = UDim2.fromOffset(12, 37), Parent = train }
)
local auto = K.button(
	"Auto: off",
	T.Raised,
	nil,
	UDim2.fromOffset(120, 44),
	{ Name = "AutoTrain", Position = UDim2.fromOffset(182, 37), Parent = train }
)
local gymUpgrade = K.button(
	"Upgrade",
	T.Raised,
	nil,
	UDim2.fromOffset(144, 44),
	{ Name = "GymUpgrade", Position = UDim2.fromOffset(312, 37), Parent = train }
)
lift.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		HUD.TrainHeld = HUD.TrainStation ~= nil
	end
end)
Input.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		HUD.TrainHeld = false
	end
end)
K.bind(auto, function()
	HUD.AutoTrain = not HUD.AutoTrain
	K.setButton(auto, HUD.AutoTrain and "Auto: on" or "Auto: off", HUD.AutoTrain and T.Success or T.Raised)
end)
K.bind(gymUpgrade, function()
	if HUD.OnUpgradeGym then
		HUD.OnUpgradeGym()
	end
end)
function HUD.SetGym(level)
	HUD.TrainStation = level
	train.Visible = level ~= nil
	if not level then
		HUD.TrainHeld = false
		return
	end
	local st = Config.TrainingStations[level]
	trainTitle.Text = st.name
	K.setButton(lift, "Lift +" .. Format.Short(st.gain), T.Gold)
	local nextSt = Config.TrainingStations[level + 1]
	gymUpgrade.Visible = nextSt ~= nil
	if nextSt then
		K.setButton(gymUpgrade, "Upgrade " .. Format.Money(nextSt.price), T.Violet)
		K.setEnabled(gymUpgrade, State.Data.Money >= nextSt.price)
	end
end
function HUD.TrainPulse()
	K.pop(lift)
end
local collect = K.button(
	"Collect creature",
	T.Success,
	nil,
	UDim2.fromOffset(300, 48),
	{ Name = "Collect", Position = UDim2.new(0.5, -150, 0, 78), Parent = world, Visible = false }
)
local collectTarget
K.bind(collect, function()
	if collectTarget and HUD.OnCollect then
		HUD.OnCollect(collectTarget)
	end
end)
function HUD.SetCollectable(id, name, color)
	collectTarget = id
	collect.Visible = id ~= nil
	if id then
		K.setButton(collect, "Collect " .. name, color or T.Success)
	end
end
local carry = K.label("", UDim2.fromOffset(450, 26), T.Success, {
	Name = "CarryHint",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 74),
	Parent = world,
	Visible = false,
	TextSize = 14,
})
function HUD.SetCarry(n)
	carry.Visible = n > 0
	carry.Text = "Bring " .. n .. " creatures home to your garden."
end

local notices = K.new("Frame", {
	Name = "Notices",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 78),
	Size = UDim2.fromOffset(420, 280),
	BackgroundTransparency = 1,
	ZIndex = 40,
	Parent = root,
}, { K.list(Enum.FillDirection.Vertical, 6) })
local lastNotice, lastNoticeTime
function HUD.Notify(text, kind)
	if text == lastNotice and os.clock() - (lastNoticeTime or 0) < 1 then
		return
	end
	lastNotice, lastNoticeTime = text, os.clock()
	local col = kind == "error" and T.Danger or kind == "success" and T.Success or T.Cyan
	if kind == "error" then
		Sounds.Play("Error")
	end
	local f = K.surface(notices, "Toast", UDim2.new(1, 0, 0, 58), nil, T.Panel)
	K.Icon(kind == "error" and "Close" or "Check", f, UDim2.fromOffset(20, 20), col, UDim2.fromOffset(14, 19))
	K.text(f, text, 47, 7, -60, 44, 15, T.Text)
	task.delay(4, function()
		if f.Parent then
			f:Destroy()
		end
	end)
	local list = {}
	for _, v in notices:GetChildren() do
		if v:IsA("Frame") then
			table.insert(list, v)
		end
	end
	if #list > 3 then
		list[1]:Destroy()
	end
end
function HUD.ShowThrowHere(_title, sub)
	HUD.Notify(
		sub
			or (
				HUD.InZone and "Hold F or the charge button, then release to throw."
				or "Enter the Launch Hall at the end of the avenue."
			),
		"info"
	)
end
function HUD.SetInZone(value)
	HUD.InZone = value
end
function HUD.ThrowFeedback(_power, isPerfect)
	if isPerfect then
		HUD._PerfectUntil = os.clock() + 0.85
	end
end

local dim = K.new("TextButton", {
	Name = "Backdrop",
	Text = "",
	AutoButtonColor = false,
	BackgroundColor3 = T.Ink,
	BackgroundTransparency = 0.22,
	Size = UDim2.fromScale(1, 1),
	Visible = false,
	ZIndex = 20,
	Parent = root,
})
local layer = K.new(
	"Frame",
	{ Name = "Panels", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 21, Parent = root }
)
local openPanel, previousFocus
local blur = K.new("BlurEffect", { Name = "SanctuaryMenuBlur", Size = 0, Parent = game:GetService("Lighting") })
local width, height = 1280, 720
function HUD.MakePanel(name, title, subtitle, icon)
	local frame = K.surface(layer, name, UDim2.fromOffset(1000, 620), UDim2.fromScale(0.5, 0.5), T.Panel)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Visible = false
	K.Icon(icon or "Portal", frame, UDim2.fromOffset(28, 28), T.Gold, UDim2.fromOffset(20, 20))
	local titleLabel = K.text(frame, title, 62, 15, -130, 35, 26, T.Text, true)
	local subtitleLabel = K.text(frame, type(subtitle) == "string" and subtitle or "", 20, 60, -92, 35, 14, T.Muted)
	local close = K.button(
		"",
		T.Raised,
		nil,
		UDim2.fromOffset(44, 44),
		{ Name = "Close", Position = UDim2.new(1, -58, 0, 14), Parent = frame }
	)
	K.Icon("Close", close, UDim2.fromOffset(18, 18), T.Text, UDim2.fromOffset(13, 13))
	local content = K.new("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.fromOffset(16, 108),
		Size = UDim2.new(1, -32, 1, -124),
		BackgroundTransparency = 1,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = T.Violet,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = frame,
	})
	local p =
		{ name = name, frame = frame, content = content, close = close, title = titleLabel, subtitle = subtitleLabel }
	HUD.Panels[name] = p
	K.bind(close, function()
		HUD.Close()
	end)
	return p
end
function HUD.AnyPanelOpen()
	return openPanel ~= nil
end
function HUD.IsOpen(name)
	return openPanel ~= nil and openPanel.name == name
end
function HUD.Open(name)
	local p = HUD.Panels[name]
	if not p then
		return
	end
	if openPanel == p then
		HUD.Close()
		return
	end
	if HUD.TC then
		HUD.TC.CancelCharge("menu opened")
		HUD.TC.StopFollow(true)
	end
	if openPanel then
		openPanel.frame.Visible = false
		if openPanel.onClose then
			openPanel.onClose()
		end
	else
		previousFocus = GuiService.SelectedObject
	end
	openPanel = p
	if HUD.TC then
		HUD.TC.InputBlocked = true
	end
	HUD.TrainHeld = false
	world.Visible = false
	dim.Visible = true
	p.frame.Visible = true
	if p.refresh then
		p.refresh()
	end
	-- Static ViewportFrames created while hidden need a camera invalidation on reveal.
	task.defer(function()
		RunService.RenderStepped:Wait()
		if not p.frame.Visible then
			return
		end
		for _, v in p.frame:GetDescendants() do
			if v:IsA("ViewportFrame") and v.CurrentCamera then
				v.CurrentCamera.CFrame = v.CurrentCamera.CFrame * CFrame.new(0.001, 0, 0)
			end
		end
	end)

	p.frame.Position = UDim2.new(0.5, 0, 0.5, Settings.ReducedMotion and 0 or 8)
	K.tween(p.frame, 0.18, { Position = UDim2.fromScale(0.5, 0.5) })
	K.tween(blur, 0.18, { Size = Settings.ReducedMotion and 0 or 4 })
	if Input.GamepadEnabled then
		GuiService.SelectedObject = p.close
	end
end
function HUD.Close()
	if not openPanel then
		return
	end
	local old = openPanel
	openPanel = nil
	if HUD.TC then
		HUD.TC.InputBlocked = false
	end
	old.frame.Visible = false
	dim.Visible = false
	world.Visible = true
	if old.onClose then
		old.onClose()
	end
	K.tween(blur, 0.15, { Size = 0 })
	if previousFocus and previousFocus.Parent and Input.GamepadEnabled then
		GuiService.SelectedObject = previousFocus
	else
		GuiService.SelectedObject = nil
	end
end
dim.Activated:Connect(HUD.Close)
Input.InputBegan:Connect(function(i, processed)
	if Input:GetFocusedTextBox() then
		return
	end
	if i.KeyCode == Enum.KeyCode.ButtonB and openPanel then
		HUD.Close()
		return
	end
	if processed then
		return
	end
	local keys = {
		[Enum.KeyCode.P] = "Portals",
		[Enum.KeyCode.U] = "Upgrades",
		[Enum.KeyCode.I] = "Creatures",
		[Enum.KeyCode.M] = "Worlds",
		[Enum.KeyCode.ButtonY] = "Menu",
	}
	if keys[i.KeyCode] then
		HUD.Open(keys[i.KeyCode])
	end
end)
local menuPanel = HUD.MakePanel("Menu", "Sanctuary menu", "Choose where to go.", "Compass")
menuPanel.refresh = function()
	menuPanel.content:ClearAllChildren()
	K.new("UIGridLayout", {
		CellSize = UDim2.new(0.5, -8, 0, 54),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = menuPanel.content,
	})
	for i, n in ipairs(navOrder) do
		local b = K.button(
			n.name,
			T.Raised,
			nil,
			nil,
			{ Name = "Menu_" .. n.name, LayoutOrder = i, Parent = menuPanel.content }
		)
		K.bind(b, function()
			HUD.Close()
			n.callback()
		end)
	end
end
K.bind(menuBtn, function()
	HUD.Open("Menu")
end)
K.bind(homeBtn, function()
	local n = HUD.SideButtons.Home
	if n then
		for _, v in navOrder do
			if v.name == "Home" then
				v.callback()
				break
			end
		end
	end
end)
function HUD.Refresh()
	local d = State.Data
	gui:SetAttribute("DataLoaded", State.Loaded)
	gui:SetAttribute("EquippedPortal", d.EquippedPortal)
	gui:SetAttribute("Money", d.Money or 0)
	-- The displayed balance settles in the existing render loop; server data stays exact.
	income.Text = "+" .. Format.Money(d.Income or 0) .. " / sec"
	power.Text = math.floor(d.MaxDistance or 0) .. " m"
	distance.Text = "Throw level " .. (d.Upgrades.ThrowPower or 1)
	strength.Text = Format.Short(d.Strength or 0)
	placed.Text = #d.Placed .. " / " .. d.SlotsOpen
	storage.Text = "Stored " .. (#d.Creatures - #d.Placed) .. " / " .. d.StorageCap
	HUD.SetCarry(d.Carry and #d.Carry or 0)
end
local function rescale()
	local v = root.Parent.AbsoluteSize
	local scale = (Input.TouchEnabled or v.X < 700) and 1 or math.clamp(math.min(v.X / 1440, v.Y / 820), 0.8, 1.1)
	scaler.Scale = scale
	root.Size = UDim2.fromScale(1 / scale, 1 / scale)
	width, height = v.X / scale, v.Y / scale
	local narrow = width < 620
	local compact = Input.TouchEnabled or width < 700 or height < 580
	HUD.Compact = compact
	local sw = narrow and (width - 32) / 2 or math.min(184, (width - 48) / 4)
	top.Size = UDim2.fromOffset(sw * 2 + 8, 50)
	top.Position = UDim2.new(0.5, -top.Size.X.Offset / 2, 0, 8)
	for i, f in ipairs(stats) do
		f.Visible = i <= 2
		f.Size = UDim2.fromOffset(sw, 50)
		f.Position = UDim2.fromOffset(
			narrow and ((i - 1) % 2) * (sw + 8) or (i - 1) * (sw + 8),
			narrow and math.floor((i - 1) / 2) * 56 or 0
		)
	end
	side.Size = UDim2.fromOffset(112, #navOrder * 49)
	side.Position = UDim2.fromOffset(12, 80)
	side.Visible = false
	menuBtn.Visible = true
	homeBtn.Visible = false
	menuBtn.AnchorPoint = Vector2.zero
	homeBtn.AnchorPoint = Vector2.zero
	menuBtn.Position = UDim2.fromOffset(12, 76)
	homeBtn.Position = UDim2.fromOffset(12, narrow and 184 or 130)
	throwBtn.Position = UDim2.new(1, -16, 1, Input.TouchEnabled and -138 or -16)
	launch.Size = UDim2.fromOffset(Input.TouchEnabled and math.min(300, width - 24) or 354, 102)
	launch.Position = Input.TouchEnabled and UDim2.new(0.5, -launch.Size.X.Offset / 2, 1, -110)
		or UDim2.new(1, -370, 1, -182)
	train.Size = UDim2.fromOffset(compact and width - 24 or 470, 114)
	train.Position = UDim2.new(0.5, -train.Size.X.Offset / 2, 1, -270)
	if compact then
		lift.Size = UDim2.new(0.5, -18, 0, 44)
		auto.Position = UDim2.new(0.5, 0, 0, 37)
		auto.Size = UDim2.new(0.5, -12, 0, 44)
		gymUpgrade.Position = UDim2.fromOffset(12, 85)
		gymUpgrade.Size = UDim2.new(1, -24, 0, 44)
		train.Size = UDim2.new(1, -24, 0, 142)
	end
	notices.Size = UDim2.fromOffset(math.min(420, width - 24), 240)
	notices.Position = UDim2.new(0.5, 0, 0, compact and 126 or 78)
	for _, p in pairs(HUD.Panels) do
		p.frame.Size = UDim2.fromOffset(math.min(1060, width - 24), math.min(680, height - 24))
		p.compact = p.frame.Size.X.Offset < 760
		p.title.TextSize = p.compact and 22 or 26
		p.frame:SetAttribute("Compact", p.compact)
		if p.layout then
			p.layout()
		end
	end
end
HUD.Rescale = rescale
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale)
Settings.Changed.Event:Connect(function(key)
	if key == "ReducedMotion" and Settings.ReducedMotion then
		blur.Size = 0
	end
end)
State.Changed:Connect(function(full)
	HUD.Refresh()
	if openPanel and openPanel.refresh then
		openPanel.refresh(full)
	end
end)
RunService.RenderStepped:Connect(function(dt)
	local targetMoney = State.Data.Money or 0
	shownMoney = math.abs(targetMoney - shownMoney) < 1 and targetMoney
		or shownMoney + (targetMoney - shownMoney) * (1 - math.exp(-18 * dt))
	money.Text = Format.Money(shownMoney)
	local tc = HUD.TC
	local p = tc and tc.Power or 0
	launch.Visible = tc ~= nil and (tc.Charging or tc.Submitting or (tc.MyThrow ~= nil and tc.Phase == "Flying"))
	throwBtn.Visible = HUD.InZone and not (tc and (tc.MyThrow or tc.Submitting)) and not train.Visible
	if tc and tc.Charging then
		local d = math.clamp((State.Data.MaxDistance or 40) * p * (p >= 0.92 and 1.15 or 1), 8, Config.LaneLength - 15)
		launchTitle.Text = string.format("%d%% charge  |  %d m", p * 100, d)
		launchHint.Text = p >= 0.92 and "Perfect zone: release now for +15% distance"
			or "Release to launch. Gold marks the perfect zone."
		fill.Size = UDim2.fromScale(p, 1)
		fill.BackgroundColor3 = p >= 0.92 and T.Gold or T.Violet
		throwBtn.Label.Text = "Release to throw"
	elseif tc and tc.Submitting then
		launchTitle.Text = "Launching portal..."
		launchHint.Text = "Waiting for the server to confirm your throw."
		fill.Size = UDim2.fromScale(0, 1)
	elseif tc and tc.MyThrow then
		launchTitle.Text = (HUD._PerfectUntil or 0) > os.clock() and "Perfect throw · +15% distance"
			or "Portal in flight"
		launchHint.Text = tc.TargetZone and ("Heading to " .. Config.Worlds[tc.TargetZone].name)
			or "Your creature will be caught automatically."
		fill.Size = UDim2.fromScale(0, 1)
		throwBtn.Label.Text = "Portal active"
	else
		launchTitle.Text = "Ready to launch"
		launchHint.Text = Input.GamepadEnabled and "Hold R2, then release."
			or Input.TouchEnabled and "Hold Charge portal, then release."
			or "Hold F or click, then release."
		fill.Size = UDim2.fromScale(0, 1)
		throwBtn.Label.Text = "Hold to throw"
	end
	throwBtn.Label.TextTransparency = HUD.InZone and 0 or 0.25
end)
task.defer(rescale)
return HUD
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX52"><Properties><string name="Name">Intro</string><ProtectedString name="Source"><![CDATA[-- Intro: cinematic fly-over when you join. The camera sweeps down the whole lane (every zone),
-- past the Portal Launch Hall, and lands at your base while the title animates in.
-- Click / tap / any key to skip.
-- Location: StarterPlayer > StarterPlayerScripts > Client > Intro (ModuleScript)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local K = require(script.Parent.UIKit)
local Effects = require(script.Parent.Effects)
local Sounds = require(script.Parent.Sounds)

local Intro = {}
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local function catmull(p0, p1, p2, p3, t)
	local t2, t3 = t * t, t * t * t
	return 0.5 * ((2 * p1) + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 + (-p0 + 3 * p1 - 3 * p2 + p3) * t3)
end
local function smooth(k) return k * k * (3 - 2 * k) end

function Intro.Play(hud)
	-- wait for the world and our base to exist
	local t0 = os.clock()
	while not workspace:FindFirstChild("Map") and os.clock() - t0 < 30 do task.wait(0.2) end
	local idx
	repeat idx = player:GetAttribute("BaseIndex"); task.wait(0.2) until (idx and idx > 0) or os.clock() - t0 > 30
	local base = workspace:FindFirstChild("Bases") and workspace.Bases:FindFirstChild("Base" .. tostring(idx))
	local char = player.Character or player.CharacterAdded:Wait()
	char:WaitForChild("HumanoidRootPart", 10)
	task.wait(0.5)

	-- camera path: positions + where it looks
	local pts, looks = {}, {}
	local function key(pos, look) table.insert(pts, pos); table.insert(looks, look) end
	key(Vector3.new(0, 170, 3050), Vector3.new(0, 20, 2500))   -- high above Heaven
	key(Vector3.new(50, 110, 2050), Vector3.new(0, 10, 1500))  -- Shadow / Space
	key(Vector3.new(-40, 70, 1150), Vector3.new(0, 5, 700))    -- Candy / Crystal
	key(Vector3.new(30, 40, 380), Vector3.new(0, 5, 60))       -- Frozen / Volcano
	key(Vector3.new(0, 22, 45), Vector3.new(0, 10, -30))       -- the Launch Hall's open front
	if base then
		local c = base.Center.CFrame
		key((c * CFrame.new(0, 26, -55)).Position, c.Position + Vector3.new(0, 4, 0)) -- swing over to your base
	end
	-- end just behind your character, where the normal camera will take over
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then
		key(hrp.Position - hrp.CFrame.LookVector * 14 + Vector3.new(0, 7, 0), hrp.Position + Vector3.new(0, 2, 0))
	end

	-- UI: black fade, title, skip hint
	local gui = K.new("ScreenGui", { Name = "Intro", IgnoreGuiInset = true, ResetOnSpawn = false, DisplayOrder = 50, Parent = player.PlayerGui })
	local black = K.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = gui })
	local title = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.fromScale(0.8, 0.22), BackgroundTransparency = 1, Parent = gui })
	local titleScale = K.new("UIScale", { Scale = 0, Parent = title })
	local line1 = K.label("THROW PORTALS", UDim2.fromScale(1, 0.55), Color3.new(1, 1, 1), { Parent = title })
	K.new("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 140, 220)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(170, 120, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(110, 220, 255)) }), Parent = line1 })
	line1:FindFirstChildOfClass("UIStroke").Thickness = 5
	local line2 = K.label("FOR CREATURES", UDim2.fromScale(1, 0.4), Color3.fromRGB(255, 230, 120), { Position = UDim2.fromScale(0, 0.58), Parent = title })
	local sub = K.label("Throw  •  Catch  •  Collect", UDim2.fromScale(0.5, 0.05), Color3.new(1, 1, 1),
		{ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.5), Parent = gui, TextTransparency = 1 })
	local skip = K.label("Click to skip ⏭", UDim2.fromOffset(240, 34), Color3.fromRGB(230, 230, 230),
		{ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -20, 1, -20), Parent = gui })

	if hud then hud.Enabled = false end
	Effects.Letterbox(true)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(pts[1], looks[1])
	K.tween(black, 1.2, { BackgroundTransparency = 1 })
	task.delay(0.6, function()
		K.tween(titleScale, 0.8, { Scale = 1 }, Enum.EasingStyle.Back)
		Sounds.Play("Rare", 0.9)
	end)
	task.delay(1.6, function() K.tween(sub, 0.6, { TextTransparency = 0 }) end)

	local skipped = false
	local conn = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.Keyboard then
			skipped = true
		end
	end)

	local DURATION = 11
	local start = os.clock()
	local segs = #pts - 1
	while not skipped do
		local k = (os.clock() - start) / DURATION
		if k >= 1 then break end
		local e = smooth(k) * segs
		local i = math.min(math.floor(e) + 1, segs)
		local f = e - (i - 1)
		local function at(list, j) return list[math.clamp(j, 1, #list)] end
		local pos = catmull(at(pts, i - 1), at(pts, i), at(pts, i + 1), at(pts, i + 2), f)
		local look = catmull(at(looks, i - 1), at(looks, i), at(looks, i + 1), at(looks, i + 2), f)
		camera.CFrame = CFrame.lookAt(pos, look)
		if k > 0.62 and titleScale.Scale > 0.99 then
			K.tween(titleScale, 0.6, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			K.tween(sub, 0.4, { TextTransparency = 1 })
		end
		RunService.RenderStepped:Wait()
	end
	conn:Disconnect()

	-- hand the camera back to the player
	Effects.Letterbox(false)
	camera.CameraType = Enum.CameraType.Custom
	if hud then hud.Enabled = true end
	K.tween(titleScale, 0.3, { Scale = 0 })
	K.tween(sub, 0.3, { TextTransparency = 1 })
	K.tween(skip, 0.3, { TextTransparency = 1 })
	Effects.Flash(Color3.new(1, 1, 1), 0.6, 0.35)
	Sounds.Play("Whoosh", 1.2)
	task.delay(0.6, function() gui:Destroy() end)
end

return Intro
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX53"><Properties><string name="Name">Panels</string><ProtectedString name="Source"><![CDATA[-- Sanctuary shops, collection, index, customization and settings.
-- All spending and ownership changes use the existing authoritative server actions.
local RS = game:GetService("ReplicatedStorage")
local Http = game:GetService("HttpService")
local Players = game:GetService("Players")
local Config = require(RS.Shared.Config)
local Data = require(RS.Shared.CreatureData)
local Portal = require(RS.Shared.PortalBuilder)
local Format = require(RS.Shared.Format)
local Odds = require(RS.Shared.Odds)
local K = require(script.Parent.UIKit)
local T = K.Theme
local HUD = require(script.Parent.HUD)
local State = require(script.Parent.ClientState)
local Settings = require(script.Parent.ClientSettings)
local Renderer = require(script.Parent.CreatureRenderer)
local Sounds = require(script.Parent.Sounds)
local Panels = {}
local function request(action, arg, message)
	if not State.Loaded then
		HUD.Notify("Your data is loading. Please wait.", "info")
		return false
	end
	local ok, msg = State.Request(action, arg)
	HUD.Notify(
		msg or (ok and (message or "Updated successfully.") or "Could not complete this action. Try again."),
		ok and "success" or "error"
	)
	if ok then
		Sounds.Play("Upgrade")
	end
	return ok
end
local function scroll(parent, name, size, pos)
	return K.new("ScrollingFrame", {
		Name = name,
		Size = size or UDim2.fromScale(1, 1),
		Position = pos or UDim2.new(),
		BackgroundTransparency = 1,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = T.Violet,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	}, { K.pad(3) })
end
local function list(parent, gap)
	K.list(Enum.FillDirection.Vertical, gap or 10).Parent = parent
end
local function heading(parent, text, order)
	local l = K.label(text, UDim2.new(1, -12, 0, 36), T.Text, {
		TextSize = 20,
		Font = T.Bold,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = order or 0,
		Parent = parent,
	})
	return l
end
local function empty(parent, title, hint)
	local f = K.surface(parent, "Empty", UDim2.new(1, -12, 0, 124))
	K.text(f, title, 16, 16, -32, 28, 19, T.Text, true)
	K.text(f, hint, 16, 49, -32, 56, 15, T.Muted)
	return f
end
local previewCache = {}
local function petView(id, size, silhouette)
	if not previewCache[id] then
		previewCache[id] = (Renderer.BuildPreview(id))
	end
	return K.viewport(previewCache[id]:Clone(), size, false, silhouette)
end
local function bindGrid(container, minWidth, cellHeight)
	local g = K.new(
		"UIGridLayout",
		{ CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = container }
	)
	local function resize()
		local w = container.AbsoluteSize.X / HUD.Root:FindFirstChildOfClass("UIScale").Scale - 12
		local cols = math.max(1, math.floor((w + 10) / (minWidth + 10)))
		g.CellSize = UDim2.new(1 / cols, -(10 * (cols - 1) + 12) / cols, 0, cellHeight)
	end
	container:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
	task.defer(resize)
	return g
end
-- On small screens the catalogue and detail are separate views, not squeezed columns.
local function split(p)
	p.content.AutomaticCanvasSize = Enum.AutomaticSize.None
	p.content.ScrollingEnabled = false
	local catalogue = scroll(p.content, "Catalogue")
	local detail = scroll(p.content, "Details", UDim2.new(0.43, -8, 1, 0), UDim2.new(0.57, 8, 0, 0))
	local back = K.button(
		"Back to all items",
		T.Raised,
		nil,
		UDim2.new(1, -8, 0, 44),
		{ Name = "BackToCatalogue", Position = UDim2.fromOffset(4, 0), Parent = p.content, Visible = false }
	)
	K.bind(back, function()
		p.showDetail = false
		p.layout()
	end)
	p.layout = function()
		if p.compact then
			catalogue.Size = UDim2.fromScale(1, 1)
			catalogue.Visible = not p.showDetail
			detail.Position = UDim2.fromOffset(0, 54)
			detail.Size = UDim2.new(1, 0, 1, -54)
			detail.Visible = p.showDetail or false
			back.Visible = p.showDetail or false
		else
			catalogue.Size = UDim2.new(0.56, -8, 1, 0)
			catalogue.Visible = true
			detail.Position = UDim2.new(0.57, 8, 0, 0)
			detail.Size = UDim2.new(0.43, -12, 1, 0)
			detail.Visible = true
			back.Visible = false
		end
	end
	p.layout()
	return catalogue, detail
end
local function showDetail(p)
	p.showDetail = true
	p.layout()
end

---------------------------------------------------------------- Portal shop
local shop = HUD.MakePanel(
	"Portals",
	"Portal forge",
	"Permanent purchases with earned coins. Select a portal to inspect it.",
	"Portal"
)
local catalogue, portalDetail = split(shop)
bindGrid(catalogue, 155, 204)
local portalRows = {}
local selectedPortal = "Basic"
local builtPortal
local portalAction, portalStatus
for i, id in ipairs(Config.PortalOrder) do
	local def = Config.Portals[id]
	local b = K.button("", T.Raised, nil, nil, { Name = "Portal_" .. id, LayoutOrder = i, Parent = catalogue })
	local vp = K.viewport(Portal.BuildGate(id, 3), UDim2.new(1, -10, 0, 114), false)
	vp.Position = UDim2.fromOffset(5, 2)
	vp.Parent = b
	K.text(b, def.name, 12, 119, -24, 25, 16, T.Text, true)
	local status = K.text(b, "", 12, 146, -24, 20, 14, T.Muted)
	local price =
		K.text(b, def.price == 0 and "Starter portal" or Format.Money(def.price), 12, 173, -24, 20, 15, T.Gold, true)
	portalRows[id] = { button = b, status = status, price = price }
	K.bind(b, function()
		selectedPortal = id
		builtPortal = nil
		shop.refresh()
		showDetail(shop)
	end)
end
local function refreshPortalDetail()
	if builtPortal == selectedPortal then
		return
	end
	builtPortal = selectedPortal
	portalDetail:ClearAllChildren()
	K.pad(4).Parent = portalDetail
	list(portalDetail, 8)
	local def = Config.Portals[selectedPortal]
	local preview = K.surface(portalDetail, "Hero", UDim2.new(1, -12, 0, 178), nil, T.Ink)
	preview.LayoutOrder = 1
	local vp = K.viewport(Portal.BuildGate(selectedPortal, 4), UDim2.fromScale(1, 1), false)
	vp.Parent = preview
	heading(portalDetail, def.name, 2)
	portalStatus =
		K.label("", UDim2.new(1, -12, 0, 30), T.Muted, { TextSize = 15, LayoutOrder = 3, Parent = portalDetail })
	portalAction = K.button(
		"",
		T.Gold,
		nil,
		UDim2.new(1, -12, 0, 48),
		{ Name = "PortalAction", LayoutOrder = 4, Parent = portalDetail }
	)
	K.bind(portalAction, function()
		local id = selectedPortal
		if State.Data.OwnedPortals[id] then
			request("EquipPortal", id, "Portal equipped.")
		else
			request("BuyPortal", id, Config.Portals[id].name .. " purchased.")
		end
	end)
	heading(portalDetail, "Base rarity weights", 5)
	local sum = 0
	for _, weight in pairs(def.weights) do
		sum += weight
	end
	for i, r in ipairs(Config.RarityOrder) do
		local weight = def.weights[r]
		if weight then
			local row = K.new("Frame", {
				Size = UDim2.new(1, -12, 0, 24),
				BackgroundTransparency = 1,
				LayoutOrder = 5 + i,
				Parent = portalDetail,
			})
			K.text(row, r, 0, 0, -80, 24, 14, T.Rarity(r, Config))
			local pct = string.format("%.2f%%", 100 * weight / sum):gsub("%.00%%", "%%")
			K.label(pct, UDim2.fromOffset(76, 24), T.Text, {
				TextSize = 14,
				TextXAlignment = Enum.TextXAlignment.Right,
				Position = UDim2.new(1, -76, 0, 0),
				Parent = row,
			})
		end
	end
	K.label(
		"These are normalized base weights. Landing zone and distance luck affect the final creature odds; see the Index for attainable odds.",
		UDim2.new(1, -12, 0, 76),
		T.Muted,
		{ TextSize = 14, LayoutOrder = 30, Parent = portalDetail }
	)
end
shop.refresh = function()
	refreshPortalDetail()
	local d = State.Data
	for id, row in pairs(portalRows) do
		local equipped = d.EquippedPortal == id
		local owned = d.OwnedPortals[id]
		row.status.Text = equipped and "Equipped" or owned and "Owned" or "View portal"
		row.status.TextColor3 = equipped and T.Success or T.Muted
		row.button:FindFirstChildOfClass("UIStroke").Color = selectedPortal == id and T.Gold or T.Border
	end
	local def = Config.Portals[selectedPortal]
	local owned = d.OwnedPortals[selectedPortal]
	local equipped = d.EquippedPortal == selectedPortal
	portalStatus.Text = equipped and "Your active portal"
		or owned and "Owned permanently"
		or "Price: " .. Format.Money(def.price) .. " coins"
	K.setButton(
		portalAction,
		equipped and "Equipped"
			or owned and "Equip portal"
			or d.Money < def.price and "Need " .. Format.Money(def.price - d.Money) .. " more"
			or "Buy portal · " .. Format.Money(def.price),
		T.Gold
	)
	K.setEnabled(portalAction, State.Loaded and not equipped and (owned or d.Money >= def.price))
end

---------------------------------------------------------------- Upgrades
local upg =
	HUD.MakePanel("Upgrades", "Sanctuary upgrades", "See the improvement and the exact cost before buying.", "Upgrade")
list(upg.content, 12)
local upgradeRefs = {}
local upgradeIcons = { ThrowPower = "Arrow", BaseSlots = "Home", Storage = "Bag", Training = "Strength" }
local function effect(kind, lvl)
	if kind == "ThrowPower" then
		return math.floor(Config.ThrowDistance(lvl, State.Data.Strength or 0)) .. " m range"
	end
	if kind == "BaseSlots" then
		return Config.StartSlots + lvl .. " garden slots"
	end
	if kind == "Storage" then
		return Config.StartStorage + lvl * Config.StoragePerLevel .. " storage"
	end
	return "+" .. math.floor(lvl * Config.TrainingBonus * 100) .. "% income"
end
for i, kind in ipairs({ "ThrowPower", "BaseSlots", "Storage", "Training" }) do
	local def = Config.Upgrades[kind]
	local row = K.surface(upg.content, "Upgrade_" .. kind, UDim2.new(1, -12, 0, 142))
	row.LayoutOrder = i
	K.Icon(upgradeIcons[kind], row, UDim2.fromOffset(26, 26), T.Gold, UDim2.fromOffset(16, 18))
	local title = K.text(row, def.name, 54, 10, -72, 28, 19, T.Text, true)
	K.text(row, def.desc, 16, 45, -32, 35, 14, T.Muted)
	local value = K.text(row, "", 16, 91, -196, 39, 15, T.Cyan)
	local b = K.button(
		"",
		T.Gold,
		nil,
		UDim2.fromOffset(164, 44),
		{ Name = "Buy_" .. kind, Position = UDim2.new(1, -180, 1, -56), Parent = row }
	)
	K.bind(b, function()
		request("Upgrade", kind, def.name .. " improved.")
	end)
	upgradeRefs[kind] = { title = title, value = value, button = b }
end
upg.refresh = function()
	for kind, ref in pairs(upgradeRefs) do
		local def = Config.Upgrades[kind]
		local lvl = State.Data.Upgrades[kind]
		local idx = kind == "ThrowPower" and lvl - 1 or lvl
		local maxed = idx >= def.max
		local cost = Config.UpgradeCost(kind, idx)
		ref.title.Text = def.name .. " · " .. idx .. "/" .. def.max
		ref.value.Text = effect(kind, lvl) .. (maxed and "" or " → " .. effect(kind, lvl + 1))
		K.setButton(
			ref.button,
			maxed and "Maximum level"
				or State.Data.Money < cost and "Need " .. Format.Money(cost - State.Data.Money)
				or "Buy · " .. Format.Money(cost),
			T.Gold
		)
		K.setEnabled(ref.button, State.Loaded and not maxed and State.Data.Money >= cost)
	end
end

---------------------------------------------------------------- Inventory
local inv = HUD.MakePanel(
	"Creatures",
	"Your creatures",
	"Select a creature to place it, remove it or review its sell value.",
	"Pet"
)
local invCatalogue, invDetail = split(inv)
local invSearch = K.search(invCatalogue, "Search creatures", UDim2.new(1, -12, 0, 46), UDim2.fromOffset(4, 4))
invCatalogue.AutomaticCanvasSize = Enum.AutomaticSize.None
invCatalogue.ScrollingEnabled = false
local best = K.button(
	"Place best",
	T.Gold,
	nil,
	UDim2.new(1, -12, 0, 44),
	{ Name = "EquipBest", Position = UDim2.fromOffset(4, 58), Parent = invCatalogue }
)
K.bind(best, function()
	request("EquipBest", nil, "Best earners placed in your garden.")
end)
local invGrid = scroll(invCatalogue, "Creatures", UDim2.new(1, 0, 1, -116), UDim2.fromOffset(0, 112))
local selectedUid, inventoryKey, detailKey, armedUid, armToken = nil, nil, nil, nil, 0
local inventoryButtons = {}
local function clearArm()
	armedUid = nil
	armToken += 1
end
local function renderCreatureDetail()
	local d = State.Data
	local entry
	for _, e in ipairs(d.Creatures) do
		if e.u == selectedUid then
			entry = e
			break
		end
	end
	local key = entry and entry.u .. ":" .. tostring(State.IsPlaced(entry.u)) .. ":" .. tostring(armedUid) or "empty"
	if detailKey == key then
		return
	end
	detailKey = key
	invDetail:ClearAllChildren()
	K.pad(4).Parent = invDetail
	list(invDetail, 10)
	if not entry then
		empty(invDetail, "Choose a creature", "Throw a portal in the Launch Hall to start your collection.")
		return
	end
	local def = Data.ById[entry.c]
	local color = T.Rarity(def.rarity, Config)
	local hero = K.surface(invDetail, "CreaturePreview", UDim2.new(1, -12, 0, 180), nil, T.Ink)
	hero.LayoutOrder = 1
	petView(entry.c, UDim2.fromScale(1, 1)).Parent = hero
	heading(invDetail, def.name, 2)
	K.label(
		def.rarity .. " · " .. Format.Money(Data.Income(entry.c)) .. " / sec",
		UDim2.new(1, -12, 0, 28),
		color,
		{ TextSize = 16, LayoutOrder = 3, Parent = invDetail }
	)
	K.label(def.desc or "", UDim2.new(1, -12, 0, 56), T.Muted, { TextSize = 14, LayoutOrder = 4, Parent = invDetail })
	local isPlaced = State.IsPlaced(entry.u)
	local place = K.button(
		isPlaced and "Remove from garden" or "Place in garden",
		T.Gold,
		nil,
		UDim2.new(1, -12, 0, 46),
		{ Name = "PlaceCreature", LayoutOrder = 5, Parent = invDetail }
	)
	K.bind(place, function()
		clearArm()
		request(State.IsPlaced(entry.u) and "Unplace" or "Place", entry.u, "Garden updated.")
	end)
	local cap = isPlaced and (#d.Creatures - #d.Placed >= d.StorageCap) or (not isPlaced and #d.Placed >= d.SlotsOpen)
	if cap then
		K.setButton(place, isPlaced and "Storage is full" or "Garden is full")
	end
	K.setEnabled(place, not cap)
	local sellValue = math.floor(Data.Income(entry.c) * Config.SellMultiplier)
	local sell = K.button(
		armedUid == entry.u and "Confirm sale · " .. Format.Money(sellValue)
			or "Sell creature · " .. Format.Money(sellValue),
		armedUid == entry.u and T.Danger or T.Raised,
		nil,
		UDim2.new(1, -12, 0, 46),
		{ Name = "SellCreature", LayoutOrder = 6, Parent = invDetail }
	)
	K.bind(sell, function()
		if selectedUid ~= entry.u then
			clearArm()
			return
		end
		if armedUid ~= entry.u then
			armedUid = entry.u
			armToken += 1
			local token = armToken
			detailKey = nil
			renderCreatureDetail()
			task.delay(4, function()
				if armToken == token then
					clearArm()
					detailKey = nil
					if HUD.IsOpen("Creatures") then
						renderCreatureDetail()
					end
				end
			end)
		else
			clearArm()
			if request("Sell", entry.u, "Creature sold.") then
				selectedUid = nil
				detailKey = nil
				inv.refresh()
			end
		end
	end)
	K.label(
		armedUid == entry.u and "This permanently removes " .. def.name .. ". Select Confirm sale within 4 seconds."
			or "Selling permanently removes this creature. A second confirmation is required.",
		UDim2.new(1, -12, 0, 60),
		armedUid == entry.u and T.Danger or T.Muted,
		{ TextSize = 14, LayoutOrder = 7, Parent = invDetail }
	)
end
inv.refresh = function()
	local d = State.Data
	inv.subtitle.Text = string.format(
		"Garden %d/%d · Stored %d/%d · Income %s / sec",
		#d.Placed,
		d.SlotsOpen,
		#d.Creatures - #d.Placed,
		d.StorageCap,
		Format.Money(d.Income)
	)
	local ids = {}
	for _, e in ipairs(d.Creatures) do
		table.insert(ids, e.u .. ":" .. tostring(State.IsPlaced(e.u)))
	end
	local key = table.concat(ids, ",") .. invSearch.Text:lower()
	if inventoryKey ~= key then
		inventoryKey = key
		invGrid:ClearAllChildren()
		inventoryButtons = {}
		bindGrid(invGrid, 140, 192)
		local items = table.clone(d.Creatures)
		table.sort(items, function(a, b)
			return Data.Income(a.c) > Data.Income(b.c)
		end)
		local count = 0
		for i, entry in ipairs(items) do
			local def = Data.ById[entry.c]
			if def and def.name:lower():find(invSearch.Text:lower(), 1, true) then
				count += 1
				local b = K.button(
					"",
					T.Raised,
					nil,
					nil,
					{ Name = "Creature_" .. entry.u, LayoutOrder = i, Parent = invGrid }
				)
				petView(entry.c, UDim2.new(1, -8, 0, 108)).Parent = b
				K.text(b, def.name, 10, 110, -20, 38, 15, T.Text, true)
				K.text(b, def.rarity, 10, 151, -20, 18, 13, T.Rarity(def.rarity, Config))
				K.text(
					b,
					State.IsPlaced(entry.u) and "In garden" or "In storage",
					10,
					171,
					-20,
					18,
					13,
					State.IsPlaced(entry.u) and T.Success or T.Muted
				)
				inventoryButtons[entry.u] = b
				K.bind(b, function()
					clearArm()
					selectedUid = entry.u
					detailKey = nil
					inv.refresh()
					showDetail(inv)
				end)
			end
		end
		if count == 0 then
			invGrid:ClearAllChildren()
			empty(
				invGrid,
				#items == 0 and "Your collection starts here" or "No matching creatures",
				#items == 0
						and "Enter the Launch Hall and throw your first portal. Caught creatures appear here automatically."
					or "Try a different name or clear your search."
			)
		end
	end
	for uid, b in pairs(inventoryButtons) do
		b:FindFirstChildOfClass("UIStroke").Color = uid == selectedUid and T.Gold or T.Border
	end
	if selectedUid then
		local found = false
		for _, e in d.Creatures do
			if e.u == selectedUid then
				found = true
			end
		end
		if not found then
			selectedUid = nil
			clearArm()
			detailKey = nil
		end
	end
	renderCreatureDetail()
end
inv.onClose = function()
	clearArm()
	detailKey = nil
end
invSearch:GetPropertyChangedSignal("Text"):Connect(function()
	inv.refresh()
end)

---------------------------------------------------------------- Discovery index
local idx = HUD.MakePanel(
	"Index",
	"Creature index",
	"Discover every species. Odds reflect your equipped portal and best perfect throw.",
	"Book"
)
idx.content.ScrollingEnabled = false
idx.content.AutomaticCanvasSize = Enum.AutomaticSize.None
local tabs = K.new("ScrollingFrame", {
	Name = "Filters",
	Size = UDim2.new(1, -4, 0, 48),
	BackgroundTransparency = 1,
	AutomaticCanvasSize = Enum.AutomaticSize.X,
	CanvasSize = UDim2.new(),
	ScrollingDirection = Enum.ScrollingDirection.X,
	ScrollBarThickness = 3,
	ScrollBarImageColor3 = T.Violet,
	Parent = idx.content,
}, { K.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left) })
local idxGrid = scroll(idx.content, "Species", UDim2.new(1, 0, 1, -62), UDim2.fromOffset(0, 60))
local idxFilter = "Forest"
local idxKey
local idxTabs = {}
local filters = table.clone(Config.WorldOrder)
table.insert(filters, "Any")
for i, id in ipairs(filters) do
	local name = id == "Any" and "Special" or id
	local b = K.button(
		name,
		T.Raised,
		nil,
		UDim2.fromOffset(100, 44),
		{ Name = "Filter_" .. id, LayoutOrder = i, Parent = tabs }
	)
	idxTabs[id] = b
	K.bind(b, function()
		idxFilter = id
		idxKey = nil
		idxGrid.CanvasPosition = Vector2.zero
		idx.refresh()
	end)
end
idx.refresh = function()
	local d = State.Data
	local found = 0
	for _ in pairs(d.Discovered) do
		found += 1
	end
	idx.title.Text = "Creature index · " .. found .. "/" .. #Data.List
	local key = idxFilter .. ":" .. found .. ":" .. d.EquippedPortal .. ":" .. math.floor(d.MaxDistance or 0)
	for id, b in pairs(idxTabs) do
		K.setButton(b, nil, id == idxFilter and T.Violet or T.Raised)
	end
	if idxKey == key then
		return
	end
	idxKey = key
	idxGrid:ClearAllChildren()
	bindGrid(idxGrid, 146, 222)
	for i, def in ipairs(Data.ByWorld[idxFilter] or {}) do
		local known = d.Discovered[def.id]
		local b = K.button("", T.Raised, nil, nil, { Name = "Species_" .. def.id, LayoutOrder = i, Parent = idxGrid })
		petView(def.id, UDim2.new(1, -8, 0, 112), not known).Parent = b
		K.text(b, known and def.name or "Undiscovered", 10, 116, -20, 36, 15, T.Text, true)
		K.text(b, def.rarity, 10, 154, -20, 20, 14, T.Rarity(def.rarity, Config))
		local status, p = Odds.Attainable(def.id, d.EquippedPortal, (d.MaxDistance or 45) * 1.15)
		local odds = status == "ok" and Odds.OneIn(p)
			or status == "out_of_range" and "Out of throw range"
			or "Different portal needed"
		K.text(b, odds, 10, 178, -20, 36, 13, T.Muted)
		K.bind(b, function()
			HUD.Notify(
				known and def.name .. ": " .. def.desc or "Land in the correct zone to discover this species.",
				"info"
			)
		end)
	end
end

---------------------------------------------------------------- Zones
local worlds = HUD.MakePanel(
	"Worlds",
	"Explore the zones",
	"Throw distance determines the landing zone. Training and upgrades extend your reach.",
	"Compass"
)
list(worlds.content, 10)
local worldRefs = {}
for i, id in ipairs(Config.WorldOrder) do
	local W = Config.Worlds[id]
	local bounds = Config.ZoneBounds[id]
	local row = K.surface(worlds.content, "Zone_" .. id, UDim2.new(1, -12, 0, 122))
	row.LayoutOrder = i
	K.Icon("Compass", row, UDim2.fromOffset(28, 28), W.atmo:Lerp(T.Text, 0.2), UDim2.fromOffset(16, 16))
	K.text(row, W.name, 56, 12, -72, 30, 19, T.Text, true)
	K.text(
		row,
		bounds[1] .. "–" .. bounds[2] .. " m · " .. Format.Short(W.incomeMult) .. "× income",
		16,
		49,
		-32,
		24,
		15,
		T.Cyan
	)
	worldRefs[id] = K.text(row, "", 16, 82, -32, 26, 15, T.Muted)
end
worlds.refresh = function()
	local max = (State.Data.MaxDistance or 45) * 1.15
	worlds.subtitle.Text = "Your best perfect throw: "
		.. math.floor(max)
		.. " m. Train or buy Throw Power to reach the next zone."
	for id, label in pairs(worldRefs) do
		local found, total = 0, 0
		for _, def in ipairs(Data.ByWorld[id] or {}) do
			total += 1
			if State.Data.Discovered[def.id] then
				found += 1
			end
		end
		label.Text = (
			max >= Config.ZoneBounds[id][1] and "In range"
			or "Need " .. math.ceil(Config.ZoneBounds[id][1] - max) .. " m more range"
		)
			.. " · Discovered "
			.. found
			.. "/"
			.. total
	end
end

---------------------------------------------------------------- Garden shop
local base = HUD.MakePanel(
	"Base",
	"Garden workshop",
	"Decorations appear in your garden. Floor purchases are applied immediately.",
	"Decor"
)
list(base.content, 10)
local baseRefs = {}
local floorRefs = {}
heading(base.content, "Decorations", 0)
local decorCopy = {
	FlowerBed = "Color for the edge of your garden.",
	Lanterns = "Warm lights around your plot.",
	MushroomRing = "A small magical garden feature.",
	Fountain = "Add a decorative portal fountain.",
	CrystalTree = "A faceted crystal centerpiece.",
	Statue = "A golden garden monument.",
	Rainbow = "Frame your garden with a rainbow arch.",
	FloatingIsland = "A floating display above your plot.",
}
local function shopRow(parent, id, title, desc, icon, order)
	local row = K.surface(parent, id, UDim2.new(1, -12, 0, 130))
	row.LayoutOrder = order
	K.Icon(icon, row, UDim2.fromOffset(26, 26), T.Violet, UDim2.fromOffset(16, 14))
	K.text(row, title, 54, 10, -70, 28, 18, T.Text, true)
	K.text(row, desc, 16, 43, -32, 28, 14, T.Muted)
	local b = K.button(
		"",
		T.Gold,
		nil,
		UDim2.fromOffset(190, 44),
		{ Name = "Buy_" .. id, Position = UDim2.new(1, -206, 1, -55), Parent = row }
	)
	return b, row
end
for i, id in ipairs(Config.DecorOrder) do
	local def = Config.Decor[id]
	local b = shopRow(base.content, id, def.name, decorCopy[id] or "Garden decoration.", "Decor", i)
	baseRefs[id] = b
	K.bind(b, function()
		request("BuyDecor", id, def.name .. " added to your garden.")
	end)
end
heading(base.content, "Floor finishes", 30)
for i, def in ipairs(Config.FloorThemes) do
	local b, row = shopRow(base.content, def.id, def.name, "Choose the surface beneath your creatures.", "Home", 30 + i)
	K.new("Frame", {
		Position = UDim2.fromOffset(16, 82),
		Size = UDim2.fromOffset(70, 32),
		BackgroundColor3 = def.color,
		Parent = row,
	}, { K.corner(4), K.stroke(1) })
	floorRefs[def.id] = b
	K.bind(b, function()
		request("Floor", def.id, "Floor applied.")
	end)
end
base.refresh = function()
	local d = State.Data
	for id, b in pairs(baseRefs) do
		local price = Config.Decor[id].price
		local owned = d.Decor[id]
		K.setButton(
			b,
			owned and "Owned"
				or d.Money < price and "Need " .. Format.Money(price - d.Money)
				or "Buy · " .. Format.Money(price),
			T.Gold
		)
		K.setEnabled(b, State.Loaded and not owned and d.Money >= price)
	end
	for id, b in pairs(floorRefs) do
		local def
		for _, f in Config.FloorThemes do
			if f.id == id then
				def = f
				break
			end
		end
		local active = d.FloorTheme == id
		local owned = d.OwnedFloors[id]
		K.setButton(
			b,
			active and "Applied"
				or owned and "Apply floor"
				or d.Money < def.price and "Need " .. Format.Money(def.price - d.Money)
				or "Buy & apply · " .. Format.Money(def.price),
			T.Gold
		)
		K.setEnabled(b, State.Loaded and not active and (owned or d.Money >= def.price))
	end
end

---------------------------------------------------------------- Accessible presentation settings
local settings = HUD.MakePanel(
	"Settings",
	"Presentation settings",
	"Changes last for this session and do not affect rewards or creature odds.",
	"Settings"
)
list(settings.content, 10)
local settingRefs = {}
for i, def in ipairs({
	{ "ReducedMotion", "Reduced motion", "Shorter camera movements and instant interface transitions." },
	{ "ReducedFlashes", "Reduced flashes", "Suppress full-screen flashes during reveals." },
	{ "CameraShake", "Camera shake", "Allow impact shake during large reveals." },
	{ "VFXQuality", "Visual effects", "Low reduces extra particles and trails." },
	{ "AmbientMotes", "Ambient motes", "Optional floating motes in the world." },
}) do
	local b = shopRow(settings.content, def[1], def[2], def[3], "Settings", i)
	settingRefs[def[1]] = b
	K.bind(b, function()
		local value = Settings[def[1]]
		if typeof(value) == "boolean" then
			Settings.Set(def[1], not value)
		else
			Settings.Set(def[1], value == "High" and "Low" or "High")
		end
		settings.refresh()
	end)
end
settings.refresh = function()
	for key, b in pairs(settingRefs) do
		local value = Settings[key]
		K.setButton(
			b,
			typeof(value) == "boolean" and (value and "On" or "Off") or value,
			((value == true) or value == "High") and T.Violet or T.Raised
		)
	end
end

---------------------------------------------------------------- Admin: existing authorized server commands retained
local admin = HUD.MakePanel(
	"Admin",
	"Studio administration",
	"Server permissions still apply. Use the explicit confirmation to reset your data.",
	"Settings"
)
list(admin.content, 10)
local adminBox, adminSearch = K.search(admin.content, "Amount or creature ID", UDim2.new(1, -12, 0, 48), UDim2.new())
adminBox.Text = "1000000"
adminSearch.LayoutOrder = 1
local adminGrid = K.new("Frame", {
	Size = UDim2.new(1, -12, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundTransparency = 1,
	LayoutOrder = 2,
	Parent = admin.content,
})
bindGrid(adminGrid, 190, 46)
local function cmd(name, value)
	return request("Admin", Http:JSONEncode({ cmd = name, value = value }))
end
local adminCommands = {
	{ "Add money", "money" },
	{ "Add strength", "strength" },
	{ "Set throw level", "throwlevel" },
	{ "Max upgrades", "maxupgrades" },
	{ "Unlock portals", "allportals" },
	{ "Complete index", "discoverall" },
	{ "Set walk speed", "speed" },
	{ "Give creature", "give" },
	{ "Force next creature", "forcenext" },
}
for i, def in ipairs(adminCommands) do
	local b = K.button(def[1], T.Raised, nil, nil, { Name = "Admin_" .. def[2], LayoutOrder = i, Parent = adminGrid })
	K.bind(b, function()
		cmd(def[2], tonumber(adminBox.Text) or adminBox.Text)
	end)
end
local reset = K.button(
	"Reset my data",
	T.Raised,
	nil,
	UDim2.new(1, -12, 0, 46),
	{ Name = "ResetMyData", LayoutOrder = 3, Parent = admin.content }
)
local resetArmed = false
local resetToken = 0
K.bind(reset, function()
	if not resetArmed then
		resetArmed = true
		resetToken += 1
		local token = resetToken
		K.setButton(reset, "Confirm reset: deletes all progress", T.Danger)
		task.delay(4, function()
			if resetToken == token then
				resetArmed = false
				K.setButton(reset, "Reset my data", T.Raised)
			end
		end)
	else
		resetArmed = false
		resetToken += 1
		cmd("reset")
		K.setButton(reset, "Reset my data", T.Raised)
	end
end)
admin.onClose = function()
	resetArmed = false
	resetToken += 1
	K.setButton(reset, "Reset my data", T.Raised)
end
heading(admin.content, "Teleport to zone", 4)
local zones = K.new("Frame", {
	Size = UDim2.new(1, -12, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundTransparency = 1,
	LayoutOrder = 5,
	Parent = admin.content,
})
bindGrid(zones, 180, 44)
local zonesOrder = { "Start" }
for _, id in Config.WorldOrder do
	table.insert(zonesOrder, id)
end
for i, id in zonesOrder do
	local b = K.button(id, T.Raised, nil, nil, { Name = "AdminZone_" .. id, LayoutOrder = i, Parent = zones })
	K.bind(b, function()
		if cmd("zone", id) then
			HUD.Close()
		end
	end)
end
admin.refresh = function() end

function Panels.Init()
	local nav = {
		{ "Shop", "Portal", "Portals" },
		{ "Upgrades", "Upgrade", "Upgrades" },
		{ "Pets", "Pet", "Creatures" },
		{ "Index", "Book", "Index" },
		{ "Zones", "Compass", "Worlds" },
		{ "Garden", "Decor", "Base" },
		{ "Settings", "Settings", "Settings" },
	}
	for _, def in nav do
		HUD.AddSideButton(def[1], def[2], nil, nil, function()
			HUD.Open(def[3])
		end)
	end
	HUD.AddSideButton("Home", "Home", nil, nil, function()
		request("Teleport", "Home", "Returned home.")
	end)
	local p = Players.LocalPlayer
	local function adminNav()
		if p:GetAttribute("IsAdmin") and not HUD.SideButtons.Admin then
			HUD.AddSideButton("Admin", "Settings", nil, nil, function()
				HUD.Open("Admin")
			end)
			HUD.Rescale()
		end
	end
	p:GetAttributeChangedSignal("IsAdmin"):Connect(adminNav)
	adminNav()
	HUD.Rescale()
end
return Panels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX54"><Properties><string name="Name">Sounds</string><ProtectedString name="Source"><![CDATA[-- Restrained event audio. Built-in assets keep the game independent of uploaded audio.
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Sounds = {}
local DEF = {
	Charge = { id = "rbxasset://sounds/electronicpingshort.wav", vol = 0.16, speed = 0.65, looped = true },
	Perfect = { id = "rbxasset://sounds/electronicpingshort.wav", vol = 0.13, speed = 1.9 },
	Throw = { id = "rbxasset://sounds/swordlunge.wav", vol = 0.38, speed = 1 },
	Land = { id = "rbxasset://sounds/collide.wav", vol = 0.32, speed = 0.75 },
	Open = { id = "rbxasset://sounds/electronicpingshort.wav", vol = 0.30, speed = 0.5 },
	Spawn = { id = "rbxasset://sounds/action_jump.mp3", vol = 0.25, speed = 1.15 },
	Rare = { id = "rbxasset://sounds/victory.wav", vol = 0.42, speed = 1 },
	Money = { id = "rbxasset://sounds/electronicpingshort.wav", vol = 0.20, speed = 1.65 },
	Upgrade = { id = "rbxasset://sounds/electronicpingshort.wav", vol = 0.27, speed = 1.25 },
	Click = { id = "rbxasset://sounds/button.wav", vol = 0.12, speed = 1.1 },
	Error = { id = "rbxasset://sounds/button.wav", vol = 0.18, speed = 0.7 },
	Collect = { id = "rbxasset://sounds/electronicpingshort.wav", vol = 0.24, speed = 1.5 },
	Whoosh = { id = "rbxasset://sounds/swordlunge.wav", vol = 0.22, speed = 0.8 },
}
local group = SoundService:FindFirstChild("SFX") or Instance.new("SoundGroup")
group.Name = "SFX"
group.Volume = 0.8
group.Parent = SoundService
local cache, fades = {}, {}
local function get(name)
	if cache[name] then
		return cache[name]
	end
	local d = DEF[name]
	if not d then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = d.id
	s.Volume = d.vol
	s.PlaybackSpeed = d.speed
	s.Looped = d.looped or false
	s.SoundGroup = group
	s.Parent = SoundService
	cache[name] = s
	return s
end
function Sounds.StopLoop(name, duration)
	local s = cache[name]
	if not s then
		return
	end
	if fades[name] then
		fades[name]:Cancel()
	end
	local tw = TweenService:Create(s, TweenInfo.new(duration or 0.08), { Volume = 0 })
	fades[name] = tw
	tw:Play()
	tw.Completed:Once(function(state)
		if state == Enum.PlaybackState.Completed and fades[name] == tw then
			s:Stop()
			fades[name] = nil
		end
	end)
end
function Sounds.Play(name, pitch)
	local base = get(name)
	if not base then
		return nil
	end
	if base.Looped then
		if fades[name] then
			fades[name]:Cancel()
			fades[name] = nil
		end
		base.Volume = 0
		base:Play()
		local tw = TweenService:Create(base, TweenInfo.new(0.10), { Volume = DEF[name].vol })
		fades[name] = tw
		tw:Play()
		return base
	end
	local s = base:Clone()
	s.PlaybackSpeed = base.PlaybackSpeed * (pitch or 1) * (0.98 + math.random() * 0.04)
	s.Parent = SoundService
	s:Play()
	s.Ended:Once(function()
		s:Destroy()
	end)
	task.delay(6, function()
		if s.Parent then
			s:Destroy()
		end
	end)
	return s
end
function Sounds.PlayAt(name, position, pitch)
	local d = DEF[name]
	if not d then
		return
	end
	local att = Instance.new("Attachment")
	att.WorldPosition = position
	att.Parent = workspace.Terrain
	local s = Instance.new("Sound")
	s.SoundId = d.id
	s.Volume = d.vol
	s.PlaybackSpeed = d.speed * (pitch or 1)
	s.RollOffMinDistance = 12
	s.RollOffMaxDistance = 120
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.SoundGroup = group
	s.Parent = att
	s:Play()
	task.delay(6, function()
		att:Destroy()
	end)
end
function Sounds.Get(name)
	return get(name)
end
return Sounds
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX55"><Properties><string name="Name">ThrowController</string><ProtectedString name="Source"><![CDATA[-- ThrowController: charge meter input, held-portal + arm wind-up, the portal flight arc,
-- landing bounce, portal gate opening and creature reveal choreography (for ALL players' throws).
-- Location: StarterPlayer > StarterPlayerScripts > Client > ThrowController (ModuleScript)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CreatureData = require(Shared.CreatureData)
local PortalBuilder = require(Shared.PortalBuilder)
local Odds = require(Shared.Odds)
local State = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)
local Sounds = require(script.Parent.Sounds)
local Renderer = require(script.Parent.CreatureRenderer)
local Settings = require(script.Parent.ClientSettings)
local Builder = require(Shared.CreatureBuilder)
local Timeline = require(Shared.PresentationTimeline)

local TC = {}
TC.Charging = false
TC.Power = 0
TC.OnThrowResult = nil -- callback(power, perfect) for UI feedback
TC.MyThrow, TC.MyThrowT = nil, 0 -- your portal currently in play (one at a time)
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local Remotes = State.Remotes

local chargeStart = 0
local lastThrow = 0
local heldOrb, heldRefs
local chargeSound
local throws = {} -- [id] = { gate, gateRefs, pos, portal }
local finishedThrows = {} -- terminal events can arrive before a paused client finishes its arc

---------------------------------------------------------------- arm pose (local)
local shoulder, shoulderC0, armBlend, armTarget = nil, nil, 0, 0
local armDisabled = false
local function findShoulder()
	local char = player.Character
	if not char then
		return
	end
	local m = (char:FindFirstChild("RightUpperArm") and char.RightUpperArm:FindFirstChild("RightShoulder"))
		or (char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Right Shoulder"))
	if m and not m:IsA("Motor6D") then
		m = nil
	end
	if m ~= shoulder then
		shoulder = m
		shoulderC0 = m and m.C0
	end
end

local function handCFrame()
	local char = player.Character
	if not char then
		return nil
	end
	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	return hand and hand.CFrame
end

---------------------------------------------------------------- charging and input ownership
TC.Submitting = false
TC.ChargeSource = nil
TC.Phase = "Ready"
TC.OnLaunchFailed = nil
local submissionSerial = 0

function TC.CancelCharge(_reason)
	local wasCharging = TC.Charging
	TC.Charging, TC.ChargeSource, TC.Power = false, nil, 0
	armTarget = 0
	if heldOrb then
		heldOrb:Destroy()
		heldOrb = nil
	end
	heldRefs = nil
	if chargeSound then
		Sounds.StopLoop("Charge", 0.08)
		chargeSound = nil
	end
	if wasCharging then
		TC.Phase = "Ready"
	end
	return wasCharging
end

function TC.BeginCharge(source)
	if TC.InputBlocked or TC.SystemMenuOpen or TC.Charging or not State.Loaded then
		return false
	end
	if TC.Submitting or TC.MyThrow then
		if TC.OnBusy then
			TC.OnBusy(
				TC.Submitting and "Confirming your launch..."
					or "Your portal is active. The creature will be caught automatically."
			)
		end
		return false
	end
	if os.clock() - lastThrow < Config.ThrowCooldown then
		return false
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		return false
	end
	if not Config.InThrowZone(hrp.Position) then
		if TC.OnNotInZone then
			TC.OnNotInZone()
		end
		return false
	end
	local d = State.Data
	if #d.Creatures >= (d.SlotsOpen or 0) + (d.StorageCap or 0) then
		if TC.OnLaunchFailed then
			TC.OnLaunchFailed("Your garden and storage are full. Open Menu > Pets to make room.")
		end
		return false
	end
	if TC.StopFollow then
		TC.StopFollow(true)
	end
	TC.Charging, TC.Power, TC.ChargeSource, TC.Phase = true, 0, source or "Programmatic", "Charging"
	chargeStart = os.clock()
	findShoulder()
	armTarget = 1
	heldOrb, heldRefs = PortalBuilder.BuildOrb(d.EquippedPortal, 0.5)
	heldOrb.Parent = Effects.Folder
	chargeSound = Sounds.Play("Charge")
	return true
end

function TC.EndCharge(source)
	if not TC.Charging or (source and source ~= TC.ChargeSource) then
		return false
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 or not Config.InThrowZone(hrp.Position) or TC.InputBlocked then
		TC.CancelCharge("invalid release")
		return false
	end
	local power = TC.Power
	TC.CancelCharge("released")
	TC.Submitting, TC.Phase = true, "Submitting"
	submissionSerial += 1
	local serial = submissionSerial
	lastThrow = os.clock()
	camera = workspace.CurrentCamera or camera
	local look = camera.CFrame.LookVector
	local dir = Vector3.new(look.X, 0, look.Z)
	if dir.Magnitude < 0.1 or dir.Z < 0.2 then
		dir = Vector3.new(math.clamp(dir.X, -0.5, 0.5), 0, 1)
	end
	dir = dir.Unit
	hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir)
	Remotes.Throw:FireServer(power, dir)
	armTarget = -0.45
	task.delay(0.16, function()
		if not TC.Charging then
			armTarget = 0
		end
	end)
	Sounds.Play("Throw", 0.95 + power * 0.18)
	local perfect = power >= 0.92
	if TC.OnThrowResult then
		TC.OnThrowResult(power, perfect)
	end
	if perfect then
		Effects.Shake(0.25, 0.12)
	end
	task.delay(4, function()
		if TC.Submitting and submissionSerial == serial then
			TC.Submitting, TC.Phase = false, "Ready"
			if TC.OnLaunchFailed then
				TC.OnLaunchFailed("The launch was not confirmed. Try again.")
			end
		end
	end)
	return true
end

Remotes.Notify.OnClientEvent:Connect(function(_text, kind)
	if TC.Submitting and (kind == "error" or kind == "throwzone") then
		TC.Submitting, TC.Phase = false, "Ready"
		submissionSerial += 1
	end
end)

-- Power ping-pongs so timing matters; the top 8% is the PERFECT zone
local PERIOD = 1.5
local perfectCueAt = -10
RunService.RenderStepped:Connect(function(dt)
	if TC.Charging then
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root or not Config.InThrowZone(root.Position) then
			TC.CancelCharge("left hall")
			return
		end
		local t = (os.clock() - chargeStart) / (PERIOD / 2)
		local k = t % 2
		local p = k <= 1 and k or 2 - k
		TC.Power = 1 - (1 - p) ^ 1.6 -- eases toward the top so the perfect zone is catchable
		if chargeSound then
			chargeSound.PlaybackSpeed = 0.65 + TC.Power * 0.65
		end
		if TC.Power >= 0.92 and os.clock() - perfectCueAt > 0.9 then
			perfectCueAt = os.clock()
			Sounds.Play("Perfect")
		end
		local hcf = handCFrame()
		if heldOrb and hcf then
			local s = 0.6 + TC.Power * 0.6
			heldOrb:PivotTo(hcf * CFrame.new(0, -1.2, 0))
			heldOrb:ScaleTo(s)
			heldRefs.light.Range = 6 + TC.Power * 10
			PortalBuilder.Spin(heldRefs, os.clock() * (1 + TC.Power * 3))
		end
	else
		TC.Power = math.max(0, TC.Power - dt * 3)
	end
	-- arm wind-up spring (skipped on avatars whose shoulder joint can't be edited)
	if shoulder and shoulder.Parent and not armDisabled then
		armBlend += (armTarget - armBlend) * (1 - math.exp(-18 * dt))
		if math.abs(armBlend) > 0.002 or math.abs(armTarget) > 0 then
			local isR15 = shoulder.Name == "RightShoulder"
			local rot = isR15 and CFrame.Angles(armBlend * 1.5, 0, armBlend * -0.15)
				or CFrame.Angles(0, 0, armBlend * 1.5)
			local ok = pcall(function()
				shoulder.C0 = shoulderC0 * rot
			end)
			if not ok then
				armDisabled = true
			end
		end
	end
end)

local function inputSource(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		return "Pointer"
	end
	if input.KeyCode == Enum.KeyCode.F then
		return "Keyboard"
	end
	if input.KeyCode == Enum.KeyCode.ButtonR2 then
		return "Gamepad"
	end
	return nil
end
UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.ButtonB then
		TC.CancelCharge("cancel")
		return
	end
	if processed or UserInputService:GetFocusedTextBox() then
		return
	end
	local source = inputSource(input)
	if source then
		TC.BeginCharge(source)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	local source = inputSource(input)
	if source then
		TC.EndCharge(source)
	end
end)
UserInputService.WindowFocusReleased:Connect(function()
	TC.CancelCharge("focus lost")
end)
UserInputService.TextBoxFocused:Connect(function()
	TC.CancelCharge("typing")
end)
game:GetService("GuiService").MenuOpened:Connect(function()
	TC.SystemMenuOpen = true
	TC.CancelCharge("Roblox menu")
	if TC.StopFollow then
		TC.StopFollow(true)
	end
end)
game:GetService("GuiService").MenuClosed:Connect(function()
	TC.SystemMenuOpen = false
end)
player.CharacterRemoving:Connect(function()
	TC.CancelCharge("respawn")
	TC.Submitting = false
	submissionSerial += 1
	if TC.StopFollow then
		TC.StopFollow(true)
	end
end)
player.CharacterAdded:Connect(function()
	TC.CancelCharge("new character")
	shoulder, shoulderC0, armDisabled, armBlend, armTarget = nil, nil, false, 0, 0
end)

-- quick arm curl used by the training stations
function TC.Curl()
	findShoulder()
	armTarget = 0.9
	task.delay(0.15, function()
		if not TC.Charging then
			armTarget = 0
		end
	end)
end

---------------------------------------------------------------- camera follows your long throws
-- One claim at a time. The previous camera state is saved and ALWAYS restored: on completion,
-- timeout, death/respawn, menu interruption or a newer claim.
local camFollow, camReturn = nil, nil
local idleFov = camera.FieldOfView
local ownsFov = false
local function restoreCamera(saved)
	if not saved then
		return
	end
	camera = workspace.CurrentCamera or camera
	camera.CameraType = saved.type == Enum.CameraType.Scriptable and Enum.CameraType.Custom or saved.type
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	camera.CameraSubject = (saved.subject and saved.subject.Parent) and saved.subject or hum
	camera.FieldOfView = saved.fov
	idleFov = saved.fov
	ownsFov = false
end
local function claimCamera(id, pos, duration)
	camera = workspace.CurrentCamera or camera
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local saved = camFollow and camFollow.saved
		or camReturn and camReturn.saved
		or {
			type = camera.CameraType,
			subject = camera.CameraSubject,
			fov = idleFov,
			offset = root and camera.CFrame.Position - root.Position or Vector3.new(0, 7, -16),
			rotation = camera.CFrame.Rotation,
		}
	camReturn = nil
	camFollow = {
		pos = pos,
		untilT = os.clock() + math.min(duration, Timeline.CameraTimeout),
		id = id,
		saved = saved,
		started = os.clock(),
	}
end
function TC.IsFollowing()
	return camFollow ~= nil or camReturn ~= nil
end
function TC.StopFollow(immediate)
	local active = camFollow or camReturn
	if not active then
		return
	end
	if camFollow and camFollow.closeup then TC.EndCloseup() end
	local saved = active.saved
	camFollow, camReturn = nil, nil
	if immediate or Settings.ReducedMotion then
		restoreCamera(saved)
		return
	end
	camReturn = { saved = saved, started = os.clock(), from = camera.CFrame, fov = camera.FieldOfView }
end
RunService:BindToRenderStep("TPFC_FollowCam", Enum.RenderPriority.Camera.Value, function(dt)
	camera = workspace.CurrentCamera or camera
	if camReturn then
		local r = camReturn
		local k = math.clamp((os.clock() - r.started) / 0.28, 0, 1)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root then
			camReturn = nil
			restoreCamera(r.saved)
			return
		end
		local target = CFrame.new(root.Position + r.saved.offset) * r.saved.rotation
		local e = 1 - (1 - k) ^ 3
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = r.from:Lerp(target, e)
		camera.FieldOfView = r.fov + (r.saved.fov - r.fov) * e
		if k >= 1 then
			camReturn = nil
			restoreCamera(r.saved)
		end
		return
	end
	if not camFollow then
		if camera.CameraType ~= Enum.CameraType.Custom then
			return
		end
		if TC.Charging and not Settings.ReducedMotion then
			if not ownsFov then
				idleFov = camera.FieldOfView
				ownsFov = true
			end
			local target = idleFov - 3 * TC.Power
			camera.FieldOfView += (target - camera.FieldOfView) * (1 - math.exp(-10 * dt))
		elseif ownsFov then
			camera.FieldOfView += (idleFov - camera.FieldOfView) * (1 - math.exp(-12 * dt))
			if Settings.ReducedMotion or math.abs(camera.FieldOfView - idleFov) < 0.02 then
				camera.FieldOfView = idleFov
				ownsFov = false
			end
		else
			idleFov = camera.FieldOfView
		end
		return
	end
	if os.clock() > camFollow.untilT or (not camFollow.closeup and os.clock() - camFollow.started > Timeline.CameraTimeout) then
		TC.StopFollow()
		return
	end
	local target = camFollow.pos
	local wild = Renderer.Wild[camFollow.id]
	local dist, height = 34, 12
	if wild and wild.model and wild.model.Parent and wild.anim then
		local ok, cf, size = pcall(Builder.VisualBounds, wild.model)
		if ok and size.Magnitude > 0.5 and size.Magnitude < 80 then
			target = cf.Position
			dist = math.clamp(size.Magnitude * 2.2, 18, 46)
			height = math.clamp(size.Y * 0.8 + 4, 6, 16)
		end
	end
	local desired = CFrame.lookAt(target + Vector3.new(dist * 0.4, height, -dist), target)
	if camFollow.closeup then
		-- CINEMATIC CLOSE-UP (good pets): slow orbit around the creature, pushing in
		local e = Renderer.Wild[camFollow.id]
		local p
		if e and e.anim and e.model and e.model.Parent then
			p = Vector3.new(e.anim.pos.X, e.anim.groundY, e.anim.pos.Z)
			camFollow.lastP = p
		else
			p = camFollow.lastP or camFollow.pos
		end
		local t = os.clock() - camFollow.closeT
		local h = camFollow.height
		local look = p + Vector3.new(0, h * 0.55, 0)
		local a = -0.7 + t * 0.32
		local R = camFollow.radius * (1.35 - 0.35 * math.min(1, t / 1.5))
		desired = CFrame.lookAt(look + Vector3.new(math.sin(a) * R, h * 0.25 + 1.5, -math.cos(a) * R), look)
		if Effects.DOF then Effects.DOF.FocusDistance = R end
	end
	if Settings.ReducedMotion then
		camFollow.cf = camFollow.cf or desired
	else
		camFollow.cf = (camFollow.cf or camera.CFrame):Lerp(desired, 1 - math.exp(-6 * dt))
	end
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = camFollow.cf
end)
local function watchCharacter(char)
	TC.StopFollow(true)
	local hum = char:WaitForChild("Humanoid", 10)
	if hum then
		hum.Died:Connect(function()
			TC.CancelCharge("died")
			TC.StopFollow(true)
		end)
	end
end
player.CharacterAdded:Connect(watchCharacter)
if player.Character then
	task.defer(watchCharacter, player.Character)
end

-- start a cinematic zoom on a good creature you just found
function TC.StartCloseup(id, def, pos, duration)
	local rc = Config.Rarities[def.rarity]
	local size = rc.size * (def.scale or 1)
	if not camFollow then claimCamera(id, pos, duration) end
	camFollow.id = id
	camFollow.pos = pos
	camFollow.closeup = true
	camFollow.closeT = os.clock()
	camFollow.height = 4 * size
	camFollow.radius = (7 + rc.order * 0.8) * size
	camFollow.untilT = os.clock() + duration
	Effects.Letterbox(true)
	Effects.Tween(camera, 0.7, { FieldOfView = 48 }, Enum.EasingStyle.Quad)
	if Effects.DOF then
		Effects.DOF.InFocusRadius = 12
		Effects.Tween(Effects.DOF, 0.6, { FarIntensity = 0.45 })
	end
end

function TC.EndCloseup()
	Effects.Letterbox(false)
	if Effects.DOF then
		Effects.Tween(Effects.DOF, 0.6, { FarIntensity = 0.18 })
		Effects.DOF.InFocusRadius = 70
		Effects.DOF.FocusDistance = 50
	end
end

---------------------------------------------------------------- flight + landing + gate
local function bezier(a, b, c, t)
	local u = 1 - t
	return a * u * u + b * 2 * u * t + c * t * t
end

local function openGate(id, info)
	if finishedThrows[id] then
		return
	end
	local pos = info.to
	local R = 5
	local gate, refs = PortalBuilder.BuildGate(info.portal, R)
	local center = pos + Vector3.new(0, R + 0.6, 0)
	-- the portal always faces back toward the throw line, so the creature walks out toward you
	local baseCF = CFrame.lookAt(center, center + Vector3.new(0, 0, -1))
	gate:PivotTo(baseCF)
	gate:ScaleTo(0.05)
	gate.Parent = Effects.Folder
	local record = { gate = gate, refs = refs, pos = pos, portal = info.portal, t0 = os.clock() }
	throws[id] = record
	local P = Config.Portals[info.portal]
	Effects.Shockwave(pos, P.color, 10, 0.5)
	Effects.Burst(center, PortalBuilder.ColorSeq(info.portal), Settings.LowVFX() and 6 or 22, 14, 0.65)
	Sounds.PlayAt("Open", center, 1)
	local start = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not gate.Parent then
			conn:Disconnect()
			return
		end
		local t = os.clock() - start
		local k = math.clamp(t / Timeline.GateOpen, 0, 1)
		local e = 1 - (1 - k) ^ 4
		local closing = record.closeT
		if closing then
			local ck = math.clamp((os.clock() - closing) / Timeline.GateClose, 0, 1)
			e = (1 - ck * ck)
			if ck >= 1 then
				gate:Destroy()
				conn:Disconnect()
				return
			end
		end
		gate:ScaleTo(math.max(0.05, e))
		gate:PivotTo(CFrame.new(pos + Vector3.new(0, (R + 0.6) * math.max(0.05, e), 0)) * baseCF.Rotation)
		PortalBuilder.Spin(refs, t)
	end)
end

local function closeGate(id)
	local g = throws[id]
	if not g or g.closeT then
		return
	end
	g.closeT = os.clock()
	Effects.Burst(g.pos + Vector3.new(0, 3.5, 0), PortalBuilder.ColorSeq(g.portal), 20, 10, 0.6)
	task.delay(0.5, function()
		g.gate:Destroy()
		if throws[id] == g then
			throws[id] = nil
		end
	end)
end

local seenThrown, seenOpened = {}, {}
Remotes.PortalThrown.OnClientEvent:Connect(function(info)
	if seenThrown[info.id] or finishedThrows[info.id] then
		return
	end -- duplicate / late event: one flight per throw
	seenThrown[info.id] = true
	task.delay(Config.PendingLifetime + 10, function()
		seenThrown[info.id] = nil
		seenOpened[info.id] = nil
	end)
	local orb, refs = PortalBuilder.BuildOrb(info.portal, 0.75)
	local a, c = info.from, info.to + Vector3.new(0, 0.9, 0)
	local mid = (a + c) / 2 + Vector3.new(0, math.min(10 + info.dist * 0.3, 220), 0)
	orb:PivotTo(CFrame.new(a))
	orb.Parent = Effects.Folder
	refs.trail.Enabled = true
	local mine = info.owner == player.UserId
	if mine then
		TC.Submitting = false
		submissionSerial += 1
		TC.MyThrow, TC.MyThrowT, TC.Phase, TC.TargetZone = info.id, os.clock(), "Flying", info.zone
	end
	local follow = mine
		and info.dist > 70
		and not Settings.ReducedMotion
		and not TC.InputBlocked
		and not TC.SystemMenuOpen
	if follow then
		claimCamera(info.id, a, info.t + Timeline.LandBounce + 1.5)
	end
	if not mine then
		Sounds.PlayAt("Whoosh", a)
	end
	local start = os.clock()
	local landed = false
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not orb.Parent or finishedThrows[info.id] then
			orb:Destroy()
			conn:Disconnect()
			return
		end
		local t = os.clock() - start
		if t < info.t then
			local k = t / info.t
			local ek = k < 0.5 and k * 1.1 or 0.55 + (k - 0.5) * 0.9 -- slight hang time at the apex
			local p = bezier(a, mid, c, math.clamp(ek, 0, 1))
			orb:PivotTo(CFrame.new(p) * CFrame.Angles(t * 4, t * 2.6, 0))
			if follow and camFollow and camFollow.id == info.id then
				camFollow.pos = p
			end
			PortalBuilder.Spin(refs, t * 2)
		else
			if not landed then
				landed = true
				if mine then
					TC.Phase = "Landing"
				end
				Sounds.PlayAt("Land", c)
				Effects.Burst(
					c - Vector3.new(0, 0.6, 0),
					ColorSequence.new(Color3.fromRGB(230, 220, 200)),
					18,
					10,
					1.2,
					"rbxasset://textures/particles/smoke_main.dds"
				)
				Effects.Shockwave(c - Vector3.new(0, 0.8, 0), Config.Portals[info.portal].color, 6, 0.4)
				if mine then
					Effects.Shake(0.3, 0.14)
				end
				refs.trail.Enabled = false
			end
			-- two decaying bounces, then a charged-up wobble before it bursts open
			local bt = t - info.t
			local bounce = 0
			if bt < 0.22 then
				bounce = math.sin(bt / 0.22 * math.pi) * 1.6
			elseif bt < 0.36 then
				bounce = math.sin((bt - 0.22) / 0.14 * math.pi) * 0.5
			end
			local wobble = bt > 0.36 and math.sin(bt * 40) * (bt - 0.36) * 0.6 or 0
			orb:PivotTo(CFrame.new(c + Vector3.new(0, bounce, 0)) * CFrame.Angles(wobble, bt * 12, wobble * 0.5))
			refs.light.Brightness = 2 + bt * 8
			if bt > 0.5 then
				conn:Disconnect()
				orb:Destroy()
				if mine then
					TC.Phase = "Opening"
				end
				openGate(info.id, info)
			end
		end
	end)
end)

Remotes.PortalOpened.OnClientEvent:Connect(function(info)
	if seenOpened[info.id] or finishedThrows[info.id] then
		return
	end
	seenOpened[info.id] = true
	local def = CreatureData.ById[info.creature]
	if not def then
		return
	end
	local rc = Config.Rarities[def.rarity]
	local mine = info.owner == player.UserId
	local chanceText = Odds.OneIn(info.chance)
	if mine then
		TC.Phase = "Revealing"
	end
	local center = info.pos + Vector3.new(0, 3.8, 0)
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local near = myRoot and (myRoot.Position - info.pos).Magnitude < 250
	local camNear = (camera.CFrame.Position - info.pos).Magnitude < 300
	if not near and not mine and not camNear then
		return
	end

	-- rarity weight: one clear accent per tier, local to the reveal (no screen-filling effects)
	local low = Settings.LowVFX()
	if rc.order >= 5 then
		if not low then
			Effects.LightBeam(
				info.pos,
				def.rarity == "Secret" and Color3.fromRGB(0, 255, 200) or rc.color,
				rc.order >= 7 and 140 or 90,
				1.6
			)
		end
		Effects.Shockwave(info.pos, rc.color, 14 + rc.order * 2, 0.9)
		if mine then
			Effects.Shake(rc.order >= 7 and 0.9 or 0.6, 0.4)
			Sounds.Play("Rare")
			Effects.RarityBanner(def, chanceText)
		end
	elseif mine then
		Effects.RarityBanner(def, chanceText)
	end
	if not low or rc.order >= 3 then
		Effects.Burst(center, rc.color, 10 + rc.order * 5, 10 + rc.order * 2, 0.8)
	end
	Sounds.PlayAt("Spawn", center, 1.2 - rc.order * 0.05)
	Renderer.SpawnWild(info.id, info.creature, info.pos, info.owner, chanceText)
	if mine then
		-- Rarity caption and world label already show the odds; avoid a third floating label.
		if TC.InputBlocked or TC.SystemMenuOpen then
			TC.StopFollow(true)
		elseif rc.order >= 3 and not Settings.ReducedMotion then
			-- a GOOD pet: zoom in on it and keep watching through its entrance and capture
			local catchDur = (Renderer.CatchConfig[def.rarity] or Renderer.CatchConfig.Common).dur
			TC.StartCloseup(info.id, def, info.pos, (Config.CatchDelay[def.rarity] or 3) + catchDur + 0.5)
		elseif camFollow and camFollow.id == info.id then
			camFollow.pos = info.pos
			camFollow.untilT = os.clock() + Timeline.FollowHoldAfterOpen(def.rarity)
		elseif myRoot and (myRoot.Position - info.pos).Magnitude > 70 then
			claimCamera(info.id, info.pos, Timeline.FollowHoldAfterOpen(def.rarity))
		end
	end
	task.delay(Timeline.GateCloseAfterOpen(def.rarity), function()
		closeGate(info.id)
	end)
end)

Remotes.CreatureGone.OnClientEvent:Connect(function(id, reason, collectorId)
	finishedThrows[id] = true
	task.delay(Config.PendingLifetime + 10, function()
		finishedThrows[id] = nil
	end)
	if TC.MyThrow == id then
		TC.MyThrow = nil
		TC.Phase = "Ready"
	end
	Renderer.RemoveWild(id, reason, collectorId)
	if reason == "collected" and collectorId == player.UserId then
		Sounds.Play("Collect")
	end
	closeGate(id)
end)

return TC
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX56"><Properties><string name="Name">UIIcons</string><ProtectedString name="Source"><![CDATA[-- Crisp native geometry. Every navigation icon also has a visible text label.
local T = require(script.Parent.UITheme)
local Icons = {}
function Icons.Draw(name, parent, size, color, position)
	local root = Instance.new("Frame")
	root.Name = "Icon_" .. name
	root.BackgroundTransparency = 1
	root.Size = size or UDim2.fromOffset(24, 24)
	root.Position = position or UDim2.new()
	root.Parent = parent
	local col = color or T.Text
	local function box(x, y, w, h, rotation, outline, round)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = col
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(x, y)
		f.Size = UDim2.fromScale(w, h)
		f.Rotation = rotation or 0
		f.Parent = root
		if outline then
			f.BackgroundTransparency = 1
			local s = Instance.new("UIStroke")
			s.Thickness = 2
			s.Color = col
			s.Parent = f
		end
		if round then
			local r = Instance.new("UICorner")
			r.CornerRadius = UDim.new(round, 0)
			r.Parent = f
		end
		return f
	end
	local function line(x, y, x2, y2)
		local dx, dy = x2 - x, y2 - y
		return box((x + x2) / 2, (y + y2) / 2, math.sqrt(dx * dx + dy * dy), 0.075, math.deg(math.atan2(dy, dx)))
	end
	if name == "Menu" then
		for _, y in { 0.25, 0.5, 0.75 } do
			line(0.16, y, 0.84, y)
		end
	elseif name == "Portal" then
		box(0.5, 0.5, 0.62, 0.78, 0, true, 0.5)
		box(0.5, 0.5, 0.28, 0.42, 0, true, 0.5)
		box(0.5, 0.08, 0.15, 0.15, 45)
	elseif name == "Upgrade" or name == "Arrow" then
		line(0.5, 0.85, 0.5, 0.2)
		line(0.24, 0.45, 0.5, 0.2)
		line(0.76, 0.45, 0.5, 0.2)
		if name == "Upgrade" then
			line(0.18, 0.92, 0.82, 0.92)
		end
	elseif name == "Pet" then
		box(0.5, 0.63, 0.47, 0.38, 45, false, 0.2)
		box(0.18, 0.38, 0.17, 0.23, -25, false, 0.5)
		box(0.4, 0.19, 0.17, 0.23, -8, false, 0.5)
		box(0.65, 0.2, 0.17, 0.23, 8, false, 0.5)
		box(0.84, 0.4, 0.17, 0.23, 25, false, 0.5)
	elseif name == "Book" then
		box(0.28, 0.5, 0.33, 0.65, 0, true, 0.08)
		box(0.7, 0.5, 0.33, 0.65, 0, true, 0.08)
		line(0.5, 0.2, 0.5, 0.86)
	elseif name == "Compass" then
		box(0.5, 0.5, 0.75, 0.75, 0, true, 0.5)
		box(0.5, 0.5, 0.24, 0.49, 35, true)
		box(0.5, 0.5, 0.1, 0.1, 45)
	elseif name == "Home" then
		line(0.12, 0.47, 0.5, 0.13)
		line(0.5, 0.13, 0.88, 0.47)
		line(0.24, 0.43, 0.24, 0.86)
		line(0.24, 0.86, 0.77, 0.86)
		line(0.77, 0.86, 0.77, 0.43)
		box(0.5, 0.72, 0.15, 0.3)
	elseif name == "Decor" then
		box(0.5, 0.42, 0.4, 0.4, 45, true)
		line(0.5, 0.66, 0.5, 0.9)
		line(0.25, 0.9, 0.75, 0.9)
		box(0.15, 0.2, 0.11, 0.11, 45)
		box(0.85, 0.28, 0.11, 0.11, 45)
	elseif name == "Coin" then
		box(0.5, 0.5, 0.69, 0.69, 0, true, 0.5)
		box(0.5, 0.5, 0.22, 0.34, 45, true)
	elseif name == "Strength" then
		line(0.19, 0.5, 0.81, 0.5)
		box(0.15, 0.5, 0.14, 0.4)
		box(0.3, 0.5, 0.12, 0.65)
		box(0.7, 0.5, 0.12, 0.65)
		box(0.85, 0.5, 0.14, 0.4)
	elseif name == "Bag" then
		box(0.5, 0.59, 0.6, 0.64, 0, true, 0.16)
		box(0.5, 0.22, 0.27, 0.23, 0, true, 0.3)
		line(0.29, 0.6, 0.71, 0.6)
	elseif name == "Settings" then
		for i = 0, 3 do
			box(0.5, 0.5, 0.14, 0.92, i * 45)
		end
		box(0.5, 0.5, 0.62, 0.62, 0, false, 0.5)
		local hole = box(0.5, 0.5, 0.26, 0.26, 0, false, 0.5)
		hole.BackgroundColor3 = T.Panel
	elseif name == "Check" then
		line(0.16, 0.5, 0.4, 0.75)
		line(0.4, 0.75, 0.87, 0.2)
	elseif name == "Close" then
		line(0.23, 0.23, 0.77, 0.77)
		line(0.23, 0.77, 0.77, 0.23)
	elseif name == "Lock" then
		box(0.5, 0.61, 0.61, 0.47, 0, true, 0.1)
		box(0.5, 0.31, 0.35, 0.4, 0, true, 0.4)
		box(0.5, 0.61, 0.08, 0.19)
	elseif name == "Search" then
		box(0.42, 0.4, 0.48, 0.48, 0, true, 0.5)
		line(0.6, 0.6, 0.9, 0.9)
	else
		box(0.5, 0.5, 0.45, 0.45, 45, true)
	end
	return root
end
return Icons
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX57"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[-- Native sanctuary components. No uploaded icon/font dependency.
local TweenService = game:GetService("TweenService")
local Sounds = require(script.Parent.Sounds)
local Settings = require(script.Parent.ClientSettings)
local T = require(script.Parent.UITheme)
local Icons = require(script.Parent.UIIcons)
local Builder = require(game:GetService("ReplicatedStorage").Shared.CreatureBuilder)
local K = { Font = T.Font, Dark = T.Ink, Panel = T.Panel, Theme = T, Icon = Icons.Draw }
function K.new(class, props, children)
	local o = Instance.new(class)
	if o:IsA("GuiObject") then
		o.BorderSizePixel = 0
	end
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			o[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = o
	end
	if props and props.Parent then
		o.Parent = props.Parent
	end
	return o
end
function K.corner(r)
	return K.new("UICorner", { CornerRadius = UDim.new(0, r or 8) })
end
function K.round()
	return K.new("UICorner", { CornerRadius = UDim.new(1, 0) })
end
function K.stroke(t, c)
	return K.new(
		"UIStroke",
		{ Thickness = t or 1, Color = c or T.Border, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }
	)
end
function K.textStroke()
	return K.new("UIStroke", { Thickness = 0, Transparency = 1 })
end
function K.grad(a, b, rot)
	return K.new("UIGradient", { Color = ColorSequence.new(a, b), Rotation = rot or 90 })
end
function K.pad(n)
	return K.new("UIPadding", {
		PaddingTop = UDim.new(0, n),
		PaddingBottom = UDim.new(0, n),
		PaddingLeft = UDim.new(0, n),
		PaddingRight = UDim.new(0, n),
	})
end
function K.list(dir, gap, align)
	return K.new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Center,
	})
end
function K.tween(o, t, props, style, dir)
	local tw = TweenService:Create(
		o,
		TweenInfo.new(
			Settings.ReducedMotion and 0 or math.min(t, 0.25),
			style == Enum.EasingStyle.Linear and style or Enum.EasingStyle.Quart,
			dir or Enum.EasingDirection.Out
		),
		props
	)
	tw:Play()
	return tw
end
function K.label(text, size, color, props)
	local l = K.new("TextLabel", {
		Text = text,
		Font = T.Font,
		TextSize = 16,
		TextScaled = false,
		BackgroundTransparency = 1,
		TextColor3 = color or T.Text,
		Size = size or UDim2.fromScale(1, 1),
		RichText = true,
		TextWrapped = true,
	}, { K.textStroke() })
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	return l
end
function K.text(parent, text, x, y, w, h, sz, col, bold)
	return K.label(text, UDim2.new(w < 0 and 1 or 0, w, 0, h), col, {
		Position = UDim2.fromOffset(x, y),
		TextSize = sz or 16,
		Font = bold and T.Bold or T.Font,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})
end
function K.surface(parent, name, size, pos, color)
	return K.new("Frame", {
		Name = name,
		Size = size,
		Position = pos or UDim2.new(),
		BackgroundColor3 = color or T.Raised,
		Parent = parent,
	}, { K.corner(10), K.stroke(1) })
end
function K.button(text, c1, _c2, size, props)
	local b = K.new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = c1 or T.Raised,
		Size = size or UDim2.fromOffset(160, 44),
		Selectable = true,
	}, { K.corner(8), K.stroke(1) })
	b:SetAttribute("Enabled", true)
	local scale = K.new("UIScale", { Parent = b })
	K.label(
		text,
		UDim2.new(1, -16, 1, -4),
		T.Readable(c1 or T.Raised),
		{ Name = "Label", Position = UDim2.fromOffset(8, 2), Font = T.Bold, TextSize = 15, Parent = b }
	)
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	local function focus(on)
		local st = b:FindFirstChildOfClass("UIStroke")
		st.Color = on and T.Gold or T.Border
		st.Thickness = on and 2 or 1
	end
	b.MouseEnter:Connect(function()
		if b:GetAttribute("Enabled") then
			focus(true)
		end
	end)
	b.MouseLeave:Connect(function()
		focus(false)
		K.tween(scale, 0.1, { Scale = 1 })
	end)
	b.SelectionGained:Connect(function()
		focus(true)
	end)
	b.SelectionLost:Connect(function()
		focus(false)
	end)
	b.MouseButton1Down:Connect(function()
		if b:GetAttribute("Enabled") then
			K.tween(scale, 0.08, { Scale = 0.98 })
		end
	end)
	b.MouseButton1Up:Connect(function()
		K.tween(scale, 0.12, { Scale = 1 })
	end)
	b.Activated:Connect(function()
		if b:GetAttribute("Enabled") then
			Sounds.Play("Click")
		end
	end)
	return b, b.Label
end
function K.setButton(b, text, c1, _c2)
	if text then
		b.Label.Text = text
	end
	if c1 then
		b.BackgroundColor3 = c1
		b.Label.TextColor3 = T.Readable(c1)
	end
end
function K.setEnabled(b, enabled)
	b:SetAttribute("Enabled", enabled)
	b.Active = enabled
	b.Selectable = enabled
	if not enabled then
		b.BackgroundColor3 = T.Raised
		b.Label.TextColor3 = T.Muted
	end
end
function K.bind(b, fn)
	b.Activated:Connect(function()
		if not b:GetAttribute("Enabled") or b:GetAttribute("Busy") then
			return
		end
		b:SetAttribute("Busy", true)
		local text = b.Label.Text
		b.Label.Text = "Working..."
		local ok, err = pcall(fn)
		if b.Parent then
			b:SetAttribute("Busy", false)
			if b.Label.Text == "Working..." then
				b.Label.Text = text
			end
		end
		if not ok then
			warn("[Sanctuary UI] " .. tostring(err))
		end
	end)
end
function K.pop(o, amount)
	if Settings.ReducedMotion then
		return
	end
	local s = o:FindFirstChildOfClass("UIScale") or K.new("UIScale", { Parent = o })
	s.Scale = math.min(amount or 1.04, 1.04)
	K.tween(s, 0.16, { Scale = 1 })
end
function K.search(parent, placeholder, size, pos)
	local f = K.surface(parent, "Search", size, pos, T.Ink)
	K.Icon("Search", f, UDim2.fromOffset(19, 19), T.Muted, UDim2.fromOffset(12, 13))
	local box = K.new("TextBox", {
		Name = "Input",
		Size = UDim2.new(1, -52, 1, 0),
		Position = UDim2.fromOffset(42, 0),
		BackgroundTransparency = 1,
		Text = "",
		PlaceholderText = placeholder,
		PlaceholderColor3 = T.Muted,
		TextColor3 = T.Text,
		Font = T.Font,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Parent = f,
	})
	return box, f
end

-- Welds don't simulate inside ViewportFrames, so compute every welded part's CFrame
-- from its weld chain (Part1 = Part0 * C0 * C1:Inverse()) before showing it.
function K.bakeWelds(model)
	local welds = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Weld") and d.Part0 and d.Part1 then
			table.insert(welds, d)
		end
	end
	local done = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Anchored then
			done[d] = true
		end
	end
	local progress = true
	while progress do
		progress = false
		for _, w in ipairs(welds) do
			if done[w.Part0] and not done[w.Part1] then
				w.Part1.CFrame = w.Part0.CFrame * w.C0 * w.C1:Inverse()
				done[w.Part1] = true
				progress = true
			end
		end
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
end

-- ViewportFrame showing a model, auto-framed, optional slow spin
function K.viewport(model, size, spin, silhouette)
	K.bakeWelds(model)
	local vp = K.new("ViewportFrame", {
		Size = size or UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(200, 200, 210),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-1, -1, -1),
	})
	if silhouette then
		vp.ImageColor3 = Color3.new(0, 0, 0)
		vp.ImageTransparency = 0.15
	end
	local cam = K.new("Camera", { FieldOfView = 35, Parent = vp })
	vp.CurrentCamera = cam
	local world = K.new("WorldModel", { Name = "PreviewWorld", Parent = vp })
	model.Parent = world
	-- frame the VISIBLE geometry (ignores invisible pivots / effect holders)
	local cf, ext = Builder.VisualBounds(model)
	local r = math.max(ext.Magnitude * 0.55, 0.5)
	local dist = r / math.tan(math.rad(cam.FieldOfView / 2))
	local target = cf.Position
	local function place(a)
		local offset = CFrame.Angles(0, a, 0) * Vector3.new(0, r * 0.35, -dist)
		cam.CFrame = CFrame.lookAt(target + offset, target)
	end
	place(0.45)
	-- Imported meshes can arrive after a static ViewportFrame's first draw.
	-- Preload outside the UI thread, then invalidate the camera once to redraw them.
	task.spawn(function()
		local inTree = false
		for _ = 1, 30 do
			if vp:IsDescendantOf(game) then
				inTree = true
				break
			end
			task.wait(0.05)
		end
		if not inTree then
			return
		end
		local hasMesh = false
		for _, part in model:GetDescendants() do
			if part:IsA("MeshPart") then
				hasMesh = true
				break
			end
		end
		if hasMesh then
			pcall(function()
				game:GetService("ContentProvider"):PreloadAsync({ model })
			end)
		end
		if vp.Parent and cam.Parent then
			cam.CFrame = cam.CFrame * CFrame.new(0.001, 0, 0)
		end
	end)
	if spin then
		vp:SetAttribute("Spin", true)
		task.spawn(function()
			local a, seen = 0.45, false
			while true do
				task.wait(1 / 30)
				local inGame = vp:IsDescendantOf(game)
				if inGame then
					seen = true
				elseif seen or a > 60 then
					break
				end
				a += 0.03
				local showing = inGame and not Settings.ReducedMotion
				local ancestor = vp
				while showing and ancestor and ancestor:IsA("GuiObject") do
					showing = ancestor.Visible
					ancestor = ancestor.Parent
				end
				if showing then
					place(math.sin(a) * 0.6 + 0.2)
				end
			end
		end)
	end
	return vp
end

return K
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX58"><Properties><string name="Name">UITheme</string><ProtectedString name="Source"><![CDATA[-- Sanctuary UI tokens, shared by the HUD, icons and every shop.
-- Fonts: Builder Sans (Roblox's modern UI family) for text, Montserrat Black for display titles;
-- resolved with a fallback so an older client without these enums still renders.
local function font(name, fallback)
	local ok, f = pcall(function() return Enum.Font[name] end)
	return (ok and f) or fallback
end
local T = {
	Ink = Color3.fromRGB(20, 16, 32),
	Panel = Color3.fromRGB(33, 26, 52),
	Raised = Color3.fromRGB(48, 38, 68),
	Border = Color3.fromRGB(89, 77, 112),
	Text = Color3.fromRGB(246, 242, 255),
	Muted = Color3.fromRGB(196, 186, 213),
	Gold = Color3.fromRGB(241, 202, 115),
	Violet = Color3.fromRGB(168, 139, 244),
	Cyan = Color3.fromRGB(147, 217, 235),
	Success = Color3.fromRGB(159, 223, 180),
	Danger = Color3.fromRGB(255, 172, 181),
	Font = font("BuilderSansMedium", Enum.Font.Gotham),
	Bold = font("BuilderSansExtraBold", Enum.Font.GothamBold),
	Display = font("MontserratBlack", Enum.Font.GothamBlack),
}
function T.Readable(c)
	-- Relative luminance determines whether an accent needs dark or light lettering.
	local function linear(v)
		return v <= 0.04045 and v / 12.92 or ((v + 0.055) / 1.055) ^ 2.4
	end
	local l = 0.2126 * linear(c.R) + 0.7152 * linear(c.G) + 0.0722 * linear(c.B)
	return l > 0.32 and T.Ink or T.Text
end
function T.Rarity(name, config)
	if name == "Secret" then
		return T.Cyan
	end
	local c = config.Rarities[name] and config.Rarities[name].color or T.Muted
	return c:Lerp(T.Text, 0.18)
end
return T
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX59"><Properties><string name="Name">WorldFx</string><ProtectedString name="Source"><![CDATA[-- WorldFx: ONE shared, staggered scheduler for environment motion on tagged map parts
-- (no per-prop RenderStepped connections, no camera-following particles).
-- Location: StarterPlayer > StarterPlayerScripts > Client > WorldFx (ModuleScript)
--
-- Tags (set by WorldLandmarks on the server):
--   TPFC_Sway   {Amp radians, Period s}    canopies, banners, candy discs: slow wind
--   TPFC_Bob    {Amp studs, Period, Spin deg/s}  hub crystal, suspended stones
--   TPFC_Spin   {Rate deg/s}               planet / observatory rings, asteroids (yaw precession)
--   TPFC_Pulse  {Period, Base, Peak}       transparency pulse (vents, runes, crystal cores, lava)
--   TPFC_Glint  {Period}                   0.15 s brighten, 0.5 s fade on one face, never in sync
--   TPFC_ChargeChannel {Index}             Launch Hall floor channels, energised while charging
-- Only parts within RANGE of the camera are updated, at ~20 Hz; far scenery stays static.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Settings = require(script.Parent.ClientSettings)

local WorldFx = {}
local camera = workspace.CurrentCamera
local RANGE = 650
local TAGS = { "TPFC_Sway", "TPFC_Bob", "TPFC_Spin", "TPFC_Pulse", "TPFC_Glint", "TPFC_ChargeChannel", "TPFC_Rotor" }
local items = {} -- part -> { kind, base, baseTr, phase, ... }
WorldFx.TC = nil -- ThrowController (for charge channels), set by ClientMain

local function add(kind, p)
	if items[p] then
		return
	end
	local model = p:IsA("Model")
	if not p:IsA("BasePart") and not (model and (kind == "TPFC_Bob" or kind == "TPFC_Spin")) then
		return
	end
	local base = model and p:GetPivot() or p.CFrame
	local seed = (base.X * 12.9898 + base.Z * 78.233) % 1
	local rotor = kind == "TPFC_Rotor" and p:FindFirstChild("PortalRotor") or nil
	items[p] = {
		kind = kind,
		base = rotor and rotor.C0 or base,
		baseTr = not model and p.Transparency or 0,
		baseCol = not model and p.Color or Color3.new(1, 1, 1),
		phase = seed * 100,
		model = model,
		rotor = rotor,
	}
end

function WorldFx.Start()
	for _, t in ipairs(TAGS) do
		for _, p in ipairs(CollectionService:GetTagged(t)) do
			add(t, p)
		end
		CollectionService:GetInstanceAddedSignal(t):Connect(function(p)
			add(t, p)
		end)
		CollectionService:GetInstanceRemovedSignal(t):Connect(function(p)
			items[p] = nil
		end)
	end
	local emitters = {}
	local function addEmitter(pe)
		if pe:IsA("ParticleEmitter") then
			emitters[pe] = pe:GetAttribute("BaseRate") or pe.Rate
		end
	end
	for _, pe in CollectionService:GetTagged("TPFC_EnvironmentEmitter") do
		addEmitter(pe)
	end
	CollectionService:GetInstanceAddedSignal("TPFC_EnvironmentEmitter"):Connect(addEmitter)
	CollectionService:GetInstanceRemovedSignal("TPFC_EnvironmentEmitter"):Connect(function(pe)
		emitters[pe] = nil
	end)
	local envAccumulator = 0
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.05 then
			return
		end
		acc = 0
		local t = os.clock()
		camera = workspace.CurrentCamera or camera
		if not camera then
			return
		end
		local cam = camera.CFrame.Position
		envAccumulator += 0.05
		if envAccumulator > 0.5 then
			envAccumulator = 0
			for pe, rate in emitters do
				if not pe.Parent then
					emitters[pe] = nil
					continue
				end
				local pos = pe.Parent:IsA("BasePart") and pe.Parent.Position or cam
				pe.Rate = (Settings.LowVFX() or (pos - cam).Magnitude > 220) and 0 or rate
			end
		end
		local motionK = Settings.ReducedMotion and 0.4 or 1
		local tc = WorldFx.TC
		local charging = tc and tc.Charging
		local power = tc and tc.Power or 0
		for p, it in pairs(items) do
			if not p.Parent then
				items[p] = nil
				continue
			end
			local kind = it.kind
			local position = it.model and p:GetPivot().Position or p.Position
			if kind ~= "TPFC_ChargeChannel" and (position - cam).Magnitude > RANGE then
				continue
			end
			local ph = t + it.phase
			if kind == "TPFC_Sway" then
				local per, amp = p:GetAttribute("Period") or 6, (p:GetAttribute("Amp") or 0.02) * motionK
				local w = math.pi * 2 / per
				p.CFrame = it.base * CFrame.Angles(math.sin(ph * w) * amp, 0, math.cos(ph * w * 0.8) * amp * 0.7)
			elseif kind == "TPFC_Bob" then
				local per, amp, spin =
					p:GetAttribute("Period") or 4,
					(p:GetAttribute("Amp") or 0.25) * motionK,
					p:GetAttribute("Spin") or 0
				local pos = it.base.Position + Vector3.new(0, math.sin(ph * math.pi * 2 / per) * amp, 0)
				local cf = CFrame.new(pos) * CFrame.Angles(0, math.rad(spin * t * motionK), 0) * it.base.Rotation
				if it.model then
					p:PivotTo(cf)
				else
					p.CFrame = cf
				end
			elseif kind == "TPFC_Spin" then
				local rate = (p:GetAttribute("Rate") or 4) * motionK
				local cf = CFrame.new(it.base.Position) * CFrame.Angles(0, math.rad(rate * t), 0) * it.base.Rotation
				if it.model then
					p:PivotTo(cf)
				else
					p.CFrame = cf
				end
			elseif kind == "TPFC_Rotor" then
				if it.rotor then
					it.rotor.C0 = it.base
						* CFrame.Angles(
							0,
							0,
							t * (p:FindFirstChild("PortalRotor"):GetAttribute("Rate") or 0.5) * motionK
						)
				end
			elseif kind == "TPFC_Pulse" then
				local per = p:GetAttribute("Period") or 6
				local base, peak = p:GetAttribute("Base") or it.baseTr, p:GetAttribute("Peak") or 0
				-- warm-up / hold / fade / long rest inside one period
				local u = (ph % per) / per
				local k = u < 0.12 and (u / 0.12) or (u < 0.3 and 1 or (u < 0.5 and 1 - (u - 0.3) / 0.2 or 0))
				p.Transparency = base + (peak - base) * k
			elseif kind == "TPFC_Glint" then
				if not Settings.LowVFX() then
					local per = p:GetAttribute("Period") or 10
					local u = ph % per
					local k = u < 0.15 and u / 0.15 or (u < 0.65 and 1 - (u - 0.15) / 0.5 or 0)
					p.Transparency = it.baseTr + (0 - it.baseTr) * k
				end
			elseif kind == "TPFC_ChargeChannel" then
				-- energise from the player's side toward the front arch with the charge power
				local idx = p:GetAttribute("Index") or 0
				if charging then
					local wave = 0.5 + 0.5 * math.sin(t * 10 - math.abs(idx) * 0.6)
					p.Transparency = math.clamp(0.6 - power * 0.45 - wave * 0.1, 0.05, 0.9)
					p.Color = power >= 0.92 and Color3.fromRGB(255, 215, 90) or it.baseCol
				elseif p.Transparency ~= it.baseTr then
					p.Transparency = math.min(it.baseTr, p.Transparency + 0.08) -- ~0.3 s recovery
					if p.Transparency >= it.baseTr - 0.01 then
						p.Transparency = it.baseTr
						p.Color = it.baseCol
					end
				end
			end
		end
	end)
end

return WorldFx
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
