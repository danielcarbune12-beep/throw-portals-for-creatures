	c={"#000000","#FFFFFF","#FF003C"}, ears="bunny", tail="fluffy", eyes="cyclops", extra={"halo"}, mat="Neon", fx="glitch",
	desc="Exists in every portal at once. Nobody knows where it comes from." }
