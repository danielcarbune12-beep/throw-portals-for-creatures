<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Config: every tunable number in the game lives here.
-- Location: ReplicatedStorage > Shared > Config (ModuleScript)

local Config = {}

---------------------------------------------------------------------
-- RARITIES
---------------------------------------------------------------------
Config.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythical", "Secret", "Divine" }

Config.Rarities = {
	Common    = { order = 1, color = Color3.fromRGB(190, 200, 210), income = 1,     size = 1.00, glow = false },
	Uncommon  = { order = 2, color = Color3.fromRGB(95, 220, 110),  income = 3,     size = 1.05, glow = false },
	Rare      = { order = 3, color = Color3.fromRGB(70, 160, 255),  income = 10,    size = 1.12, glow = false },
	Epic      = { order = 4, color = Color3.fromRGB(180, 90, 255),  income = 35,    size = 1.20, glow = false },
	Legendary = { order = 5, color = Color3.fromRGB(255, 190, 40),  income = 150,   size = 1.32, glow = true },
	Mythical  = { order = 6, color = Color3.fromRGB(255, 70, 120),  income = 600,   size = 1.45, glow = true },
	Secret    = { order = 7, color = Color3.fromRGB(40, 40, 50),    income = 3000,  size = 1.55, glow = true },
	Divine    = { order = 8, color = Color3.fromRGB(255, 250, 200), income = 12000, size = 1.70, glow = true },
}

---------------------------------------------------------------------
-- PORTALS  (weights are relative; bigger = more likely)
---------------------------------------------------------------------
Config.PortalOrder = { "Basic", "Forest", "Lava", "Ice", "Galaxy", "Dark", "Rainbow", "Divine", "Secret" }

Config.Portals = {
	Basic   = { name = "Basic Portal",   price = 0,          color = Color3.fromRGB(120, 200, 255), color2 = Color3.fromRGB(255, 255, 255), fx = "Sparkle",
		weights = { Common = 70, Uncommon = 25, Rare = 5 } },
	Forest  = { name = "Forest Portal",  price = 400,        color = Color3.fromRGB(80, 220, 90),   color2 = Color3.fromRGB(210, 255, 120), fx = "Leaves",
		weights = { Common = 50, Uncommon = 35, Rare = 13, Epic = 2 } },
	Lava    = { name = "Lava Portal",    price = 4500,       color = Color3.fromRGB(255, 90, 20),   color2 = Color3.fromRGB(255, 220, 60),  fx = "Fire",
		weights = { Common = 30, Uncommon = 38, Rare = 24, Epic = 7, Legendary = 1 } },
	Ice     = { name = "Ice Portal",     price = 30000,      color = Color3.fromRGB(150, 230, 255), color2 = Color3.fromRGB(255, 255, 255), fx = "Snow",
		weights = { Uncommon = 35, Rare = 38, Epic = 20, Legendary = 6, Mythical = 1 } },
	Galaxy  = { name = "Galaxy Portal",  price = 200000,     color = Color3.fromRGB(110, 60, 255),  color2 = Color3.fromRGB(255, 120, 230), fx = "Stars",
		weights = { Uncommon = 20, Rare = 38, Epic = 28, Legendary = 11, Mythical = 3 } },
	Dark    = { name = "Dark Portal",    price = 1500000,    color = Color3.fromRGB(60, 0, 90),     color2 = Color3.fromRGB(190, 40, 255),  fx = "Smoke",
		weights = { Rare = 35, Epic = 35, Legendary = 20, Mythical = 8, Secret = 2 } },
	Rainbow = { name = "Rainbow Portal", price = 10000000,   color = Color3.fromRGB(255, 80, 80),   color2 = Color3.fromRGB(80, 160, 255),  fx = "Rainbow",
		weights = { Rare = 20, Epic = 35, Legendary = 28, Mythical = 13, Secret = 3.5, Divine = 0.5 } },
	Divine  = { name = "Divine Portal",  price = 75000000,   color = Color3.fromRGB(255, 235, 150), color2 = Color3.fromRGB(255, 255, 255), fx = "Holy",
		weights = { Epic = 30, Legendary = 35, Mythical = 25, Secret = 7, Divine = 3 } },
	Secret  = { name = "Secret Portal",  price = 400000000,  color = Color3.fromRGB(15, 15, 20),    color2 = Color3.fromRGB(0, 255, 200),   fx = "Glitch",
		weights = { Legendary = 30, Mythical = 40, Secret = 22, Divine = 8 } },
}

---------------------------------------------------------------------
-- THE LANE: one long map. Players stand in the start area (Z < 0) and throw
-- down the lane (+Z). Each world is a ZONE of the lane; how far you throw
-- decides which zone's creatures you can find.
---------------------------------------------------------------------
Config.WorldOrder = { "Forest", "Volcano", "Frozen", "Crystal", "Candy", "Space", "Shadow", "Heaven" }
Config.LaneHalfWidth = 30     -- creatures land within |X| <= this
Config.MapHalfWidth = 70      -- lane walls (narrow valley)
Config.StartHalfWidth = 105   -- start area walls (bases + training)
Config.StartDepth = 470       -- start area spans Z = -StartDepth .. 0
Config.HallHalfWidth = 28     -- the Portal Launch Hall (enter it to throw)
Config.HallBackZ = -36
Config.ZoneBounds = {         -- distance (studs from the launch line) where each zone starts / ends
	Forest = { 0, 150 }, Volcano = { 150, 350 }, Frozen = { 350, 600 }, Crystal = { 600, 900 },
	Candy = { 900, 1300 }, Space = { 1300, 1800 }, Shadow = { 1800, 2400 }, Heaven = { 2400, 3200 },
}
Config.LaneLength = 3200
Config.ThrowZone = { minZ = -34, maxZ = 4 }  -- inside the Launch Hall
Config.BarrierZ = 6                         -- players can't walk past this (the lane is for portals only)
-- seconds after the portal opens before the creature is caught into your inventory
-- (long enough for its entrance animation to play)
Config.CatchDelay = { Common = 2.4, Uncommon = 2.4, Rare = 2.6, Epic = 2.6, Legendary = 3.4, Mythical = 3.6, Secret = 3.0, Divine = 3.8 }

function Config.InThrowZone(pos: Vector3): boolean
	return pos.Z >= Config.ThrowZone.minZ and pos.Z <= Config.ThrowZone.maxZ and math.abs(pos.X) <= Config.HallHalfWidth
end

Config.Worlds = {
	Forest  = { index = 1, name = "Green Forest",     cost = 0,         throwLevel = 1,  incomeMult = 1,
		material = Enum.Material.Grass,     groundColor = Color3.fromRGB(105, 190, 80),
		ambient = Color3.fromRGB(140, 150, 130), fog = Color3.fromRGB(190, 230, 255), fogEnd = 900, clock = 14, tint = Color3.fromRGB(255, 255, 250), atmo = Color3.fromRGB(200, 230, 255) },
	Volcano = { index = 2, name = "Volcano World",    cost = 3000,      throwLevel = 5,  incomeMult = 3,
		material = Enum.Material.Basalt,    groundColor = Color3.fromRGB(60, 45, 45),
		ambient = Color3.fromRGB(150, 80, 60),   fog = Color3.fromRGB(120, 50, 30),   fogEnd = 650, clock = 18.2, tint = Color3.fromRGB(255, 225, 205), atmo = Color3.fromRGB(255, 120, 60) },
	Frozen  = { index = 3, name = "Frozen Kingdom",   cost = 25000,     throwLevel = 10, incomeMult = 9,
		material = Enum.Material.Snow,      groundColor = Color3.fromRGB(235, 245, 255),
		ambient = Color3.fromRGB(150, 170, 200), fog = Color3.fromRGB(210, 230, 255), fogEnd = 700, clock = 10, tint = Color3.fromRGB(235, 245, 255), atmo = Color3.fromRGB(220, 240, 255) },
	Crystal = { index = 4, name = "Crystal Caves",    cost = 150000,    throwLevel = 15, incomeMult = 27,
		material = Enum.Material.Slate,     groundColor = Color3.fromRGB(55, 50, 80),
		ambient = Color3.fromRGB(120, 90, 170),  fog = Color3.fromRGB(40, 25, 70),    fogEnd = 500, clock = 0,  tint = Color3.fromRGB(235, 220, 255), atmo = Color3.fromRGB(120, 70, 200) },
	Candy   = { index = 5, name = "Candy World",      cost = 900000,    throwLevel = 20, incomeMult = 80,
		material = Enum.Material.Sand,      groundColor = Color3.fromRGB(255, 180, 215),
		ambient = Color3.fromRGB(200, 150, 180), fog = Color3.fromRGB(255, 210, 235), fogEnd = 800, clock = 13, tint = Color3.fromRGB(255, 240, 250), atmo = Color3.fromRGB(255, 200, 230) },
	Space   = { index = 6, name = "Space Galaxy",     cost = 6000000,   throwLevel = 27, incomeMult = 250,
		material = Enum.Material.Limestone, groundColor = Color3.fromRGB(70, 75, 110),
		ambient = Color3.fromRGB(100, 100, 160), fog = Color3.fromRGB(10, 5, 30),     fogEnd = 1500, clock = 0, tint = Color3.fromRGB(225, 225, 255), atmo = Color3.fromRGB(60, 30, 140) },
	Shadow  = { index = 7, name = "Shadow Dimension", cost = 40000000,  throwLevel = 34, incomeMult = 800,
		material = Enum.Material.Ground,    groundColor = Color3.fromRGB(40, 25, 55),
		ambient = Color3.fromRGB(90, 50, 120),   fog = Color3.fromRGB(25, 10, 40),    fogEnd = 420, clock = 22, tint = Color3.fromRGB(220, 200, 240), atmo = Color3.fromRGB(70, 20, 110) },
	Heaven  = { index = 8, name = "Heaven World",     cost = 250000000, throwLevel = 42, incomeMult = 2500,
		material = Enum.Material.Salt,      groundColor = Color3.fromRGB(255, 250, 235),
		ambient = Color3.fromRGB(220, 210, 170), fog = Color3.fromRGB(255, 248, 225), fogEnd = 900, clock = 12, tint = Color3.fromRGB(255, 250, 235), atmo = Color3.fromRGB(255, 240, 200) },
}

-- middle of a zone on the lane
function Config.WorldCenter(worldId: string): Vector3
	local b = Config.ZoneBounds[worldId]
	return Vector3.new(0, 0, (b[1] + b[2]) / 2)
end

-- which zone a position is in (the start area counts as Green Forest)
function Config.WorldAt(pos: Vector3): string
	local d = pos.Z
	if d < 0 then return "Forest" end
	for _, id in ipairs(Config.WorldOrder) do
		local b = Config.ZoneBounds[id]
		if d >= b[1] and d < b[2] then return id end
	end
	return Config.WorldOrder[#Config.WorldOrder]
end

---------------------------------------------------------------------
-- TRAINING: stand at a station and lift to gain Strength. Strength = farther throws.
---------------------------------------------------------------------
Config.TrainingStations = {
	-- along the street, right next to the base entrances (staggered left/right)
	-- same stations for everyone; each player buys the equipment with money once, then lifts for free
	{ name = "Wooden Dumbbell",        price = 0,       gain = 1,   color = Color3.fromRGB(170, 120, 70),  pos = Vector3.new(-13, 0, -100) },
	{ name = "Iron Barbell",           price = 750,     gain = 5,   color = Color3.fromRGB(150, 155, 170), pos = Vector3.new(13, 0, -140) },
	{ name = "Golden Kettlebell",      price = 15000,   gain = 25,  color = Color3.fromRGB(255, 200, 60),  pos = Vector3.new(-13, 0, -180) },
	{ name = "Crystal Weights",        price = 300000,  gain = 120, color = Color3.fromRGB(150, 110, 255), pos = Vector3.new(13, 0, -220) },
	{ name = "Cosmic Gravity Machine", price = 6000000, gain = 600, color = Color3.fromRGB(80, 230, 255),  pos = Vector3.new(-13, 0, -260) },
}
-- Every base has its OWN gym. Your gym starts with the Wooden Dumbbell; pay money to upgrade
-- it to the next equipment above. GymOffset is the gym's position inside a base (local space).
Config.GymOffset = Vector3.new(19, 0, -19)
Config.TrainCooldown = 0.35
Config.TrainRange = 10

-- Total throw distance (studs) at 100% power: upgrades + strength
function Config.ThrowDistance(level: number, strength: number): number
	return 40 + (level - 1) * 10 + math.sqrt(math.max(strength, 0)) * 6
end

---------------------------------------------------------------------
-- ADMINS: the game owner (and anyone in Studio) is always admin. Add extra UserIds here.
---------------------------------------------------------------------
Config.AdminIds = {}

---------------------------------------------------------------------
-- UPGRADES
---------------------------------------------------------------------
Config.Upgrades = {
	ThrowPower = { name = "Throw Power",    max = 50, baseCost = 60,   growth = 1.33, desc = "+10 studs throw distance per level. Farther = more luck!" },
	BaseSlots  = { name = "Base Slots",     max = 20, baseCost = 250,  growth = 1.85, desc = "Place more creatures in your base." },
	Storage    = { name = "Creature Storage", max = 20, baseCost = 150, growth = 1.6, desc = "Hold more creatures in your backpack." },
	Training   = { name = "Pet Trainer",    max = 25, baseCost = 1200, growth = 1.9, desc = "Trains your creatures: +15% income per level." },
}

function Config.UpgradeCost(kind: string, level: number): number
	local u = Config.Upgrades[kind]
	return math.floor(u.baseCost * u.growth ^ level)
end

Config.StartSlots = 4          -- base slots with BaseSlots level 0
Config.StartStorage = 10       -- storage with Storage level 0
Config.StoragePerLevel = 5
Config.TrainingBonus = 0.15

function Config.MaxThrowDistance(level: number): number
	return 45 + (level - 1) * 7
end

function Config.LuckFromDistance(dist: number): number
	return 1 + (dist / 100) * 0.12
end

---------------------------------------------------------------------
-- DECORATIONS (base customization)
---------------------------------------------------------------------
Config.DecorOrder = { "FlowerBed", "Lanterns", "MushroomRing", "Fountain", "CrystalTree", "Statue", "Rainbow", "FloatingIsland" }
Config.Decor = {
	FlowerBed      = { name = "Flower Bed",      price = 300 },
	Lanterns       = { name = "Glow Lanterns",   price = 1500 },
	MushroomRing   = { name = "Mushroom Ring",   price = 6000 },
	Fountain       = { name = "Portal Fountain", price = 40000 },
	CrystalTree    = { name = "Crystal Tree",    price = 250000 },
	Statue         = { name = "Golden Statue",   price = 2000000 },
	Rainbow        = { name = "Rainbow Arch",    price = 15000000 },
	FloatingIsland = { name = "Floating Island", price = 120000000 },
}

Config.FloorThemes = {
	{ id = "Meadow",  name = "Meadow",  price = 0,       color = Color3.fromRGB(120, 200, 95),  material = Enum.Material.Grass },
	{ id = "Stone",   name = "Stone",   price = 800,     color = Color3.fromRGB(170, 170, 180), material = Enum.Material.Cobblestone },
	{ id = "Wood",    name = "Wood",    price = 5000,    color = Color3.fromRGB(170, 120, 75),  material = Enum.Material.WoodPlanks },
	{ id = "Marble",  name = "Marble",  price = 50000,   color = Color3.fromRGB(240, 240, 245), material = Enum.Material.Marble },
	{ id = "Neon",    name = "Galaxy",  price = 1000000, color = Color3.fromRGB(80, 40, 180),   material = Enum.Material.Glass },
}

---------------------------------------------------------------------
-- MISC
---------------------------------------------------------------------
Config.ThrowCooldown = 1.2
Config.MaxPendingPerPlayer = 1     -- one portal at a time
Config.PendingLifetime = 90
Config.CollectRange = 18
Config.CarryLimit = 4
Config.BaseRadius = 40
Config.MaxBases = 8
Config.OfflineCapSeconds = 2 * 3600
Config.OfflineRate = 0.25
Config.SellMultiplier = 25        -- sell price = income/sec * this
Config.DiscoveryBonus = 60        -- money bonus for a new index entry = income * this

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">CreatureAnimator</string><ProtectedString name="Source"><![CDATA[-- CreatureAnimator: procedural, physics-feel animation for rigs from CreatureBuilder.
-- Location: ReplicatedStorage > Shared > CreatureAnimator (ModuleScript)
--
-- Features: unique idle per personality, hop / walk / run / fly / float / slither
-- locomotion with squash & stretch, blinking, eye tracking, ear twitches, wing flaps,
-- tail wags with follow-through, reactions (happy hop + hearts), and a scale factor
-- used for pop-in reveals. Pure client-side; call anim:Step(dt) every frame.

local Animator = {}
Animator.__index = Animator

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local sin, cos, abs, clamp, rad = math.sin, math.cos, math.abs, math.clamp, math.rad

local function scaledCF(cf, s)
	return CFrame.new(cf.Position * s) * cf.Rotation
end

local function springTo(cur, target, k, dt)
	return cur + (target - cur) * (1 - math.exp(-k * dt))
end

function Animator.new(rig, startCFrame: CFrame?)
	local def = rig.def
	local self = setmetatable({}, Animator)
	self.rig = rig
	self.def = def
	self.t = math.random() * 10
	self.seed = math.random() * 100
	local cf = startCFrame or rig.root.CFrame
	self.pos = cf.Position
	local _, yaw = cf:ToEulerAnglesYXZ()
	self.yaw = yaw
	self.targetYaw = yaw
	self.scale = 1
	self._appliedScale = -1
	self.moveTarget = nil
	self.moveSpeed = 6
	self.moving = false
	self.hopPhase = 0
	self.jumpT = nil
	self.reactT = nil
	self.reactKind = nil
	self.spinT = nil
	self.blinkTimer = 1 + math.random() * 3
	self.blinkT = nil
	self.twitchT = 0
	self.look = nil         -- world position to look at
	self.lookAmt = 0
	self.speedNow = 0
	self.lean = 0
	self.landSquash = 0
	self.home = nil
	self.homeRadius = 10
	self.idleTimer = 1 + math.random() * 3
	self.flying = (def.move == "fly")
	self.hover = (def.move == "fly" and 2.6) or ((def.move == "float" or def.move == "slither") and 0.6) or 0
	self.groundY = self.pos.Y

	-- burst emitter for reactions
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = SPARKLE
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 120, 170), Color3.fromRGB(255, 220, 120))
	pe.LightEmission = 1
	pe.Rate = 0
	pe.Lifetime = NumberRange.new(0.6, 1.1)
	pe.Speed = NumberRange.new(4, 7)
	pe.SpreadAngle = Vector2.new(60, 60)
	pe.EmissionDirection = Enum.NormalId.Top
	pe.Acceleration = Vector3.new(0, -6, 0)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
	pe.Parent = rig.head or rig.body
	self.burst = pe
	return self
end

---------------------------------------------------------------- control API
function Animator:SetHome(center: Vector3, radius: number)
	self.home = center
	self.homeRadius = radius
	self.groundY = center.Y
end

function Animator:MoveTo(pos: Vector3, speed: number?)
	self.moveTarget = pos
	self.moveSpeed = speed or (self.def.move == "fly" and 9 or 6)
end

function Animator:Teleport(cf: CFrame)
	self.pos = cf.Position
	self.groundY = cf.Position.Y
	local _, yaw = cf:ToEulerAnglesYXZ()
	self.yaw, self.targetYaw = yaw, yaw
end

function Animator:Jump()
	if not self.jumpT then self.jumpT = 0 end
end

function Animator:React(kind: string?)
	self.reactKind = kind or "happy"
	self.reactT = 0
	if self.reactKind == "happy" then
		self.burst:Emit(8)
		self:Jump()
	elseif self.reactKind == "spin" then
		self.spinT = 0
	end
end

function Animator:LookAt(pos: Vector3?)
	self.look = pos
end

function Animator:SetScale(s: number)
	self.scale = s
end

---------------------------------------------------------------- internals
function Animator:_applyScale()
	local s = self.scale
	if abs(s - self._appliedScale) < 0.001 then return end
	self._appliedScale = s
	for _, e in ipairs(self.rig.all) do
		e.w.C0 = scaledCF(e.c0, s)
		e.w.C1 = scaledCF(e.c1, s)
		if e.mesh then e.mesh.Scale = Vector3.one * s end
	end
end

function Animator:_set(e, extra: CFrame)
	e.w.C0 = scaledCF(e.c0, self.scale) * extra
end

function Animator:_brain(dt)
	if not self.home or self.moveTarget then return end
	self.idleTimer -= dt
	if self.idleTimer <= 0 then
		self.idleTimer = 2.5 + math.random() * 4
		local a = math.random() * math.pi * 2
		local r = math.random() * self.homeRadius
		local run = math.random() < 0.2
		self:MoveTo(self.home + Vector3.new(cos(a) * r, 0, sin(a) * r), run and 11 or nil)
		if math.random() < 0.15 then self.spinT = 0 end
	end
end

function Animator:Step(dt: number)
	dt = math.min(dt, 0.1)
	self.t += dt
	local t = self.t
	local rig, def = self.rig, self.def
	self:_applyScale()
	self:_brain(dt)

	-------------------------------------------------- locomotion
	local moving = false
	if self.moveTarget then
		local delta = (self.moveTarget - self.pos) * Vector3.new(1, 0, 1)
		local dist = delta.Magnitude
		if dist < 0.6 then
			self.moveTarget = nil
		else
			moving = true
			local dir = delta.Unit
			self.targetYaw = math.atan2(-dir.X, -dir.Z)
			local step = math.min(dist, self.moveSpeed * dt)
			if def.move == "hop" then
				-- only advance while airborne -> real hopping feel
				local ph = (self.hopPhase % 1)
				step = (ph < 0.75) and step * 1.6 or 0
			end
			self.pos += dir * step
		end
	end
	local targetSpeed = moving and self.moveSpeed or 0
	self.speedNow = springTo(self.speedNow, targetSpeed, 8, dt)
	local running = self.speedNow > 8

	-- smooth turning
	local dy = (self.targetYaw - self.yaw + math.pi) % (math.pi * 2) - math.pi
	self.yaw += dy * (1 - math.exp(-8 * dt))
	self.lean = springTo(self.lean, clamp(dy * 1.5, -0.5, 0.5), 6, dt)

	-------------------------------------------------- vertical / body motion
	local y = self.hover
	local bob, tiltX, tiltZ, yawWiggle = 0, 0, 0, 0
	local sqY = 1
	local hopRate = running and 3.2 or 2.2
	local spd = self.speedNow / math.max(self.moveSpeed, 1)

	if def.move == "hop" then
		if moving or (self.hopPhase % 1) > 0.02 then
			local before = self.hopPhase % 1
			self.hopPhase += dt * hopRate
			local ph = self.hopPhase % 1
			if ph < before then self.landSquash = 1 end -- just landed
			if not moving and ph < 0.05 then self.hopPhase = math.floor(self.hopPhase) end
			if ph < 0.75 then
				local k = ph / 0.75
				bob = sin(k * math.pi) * 1.4
				sqY = 1 + sin(k * math.pi) * 0.12
				tiltX = (0.5 - k) * 0.4
			end
		end
	elseif def.move == "walk" then
		bob = abs(sin(t * 9 * (running and 1.4 or 1))) * 0.18 * spd
		tiltZ = sin(t * 9) * 0.06 * spd
		tiltX = -0.08 * spd - (running and 0.12 or 0)
	elseif def.move == "fly" then
		bob = sin(t * 2.4 + self.seed) * 0.5
		tiltX = -0.3 * spd
		tiltZ = -self.lean * 0.8
	elseif def.move == "float" then
		bob = sin(t * 1.6 + self.seed) * 0.35
		tiltX = -0.15 * spd
		tiltZ = sin(t * 1.1) * 0.06
	elseif def.move == "slither" then
		bob = sin(t * 1.8 + self.seed) * 0.25
		yawWiggle = sin(t * 6) * 0.25 * (0.3 + spd)
		tiltZ = sin(t * 6 + 1) * 0.12
	end

	-------------------------------------------------- idle personality (only when still)
	local idleW = 1 - clamp(spd, 0, 1)
	local headYaw, headPitch, headRoll = 0, 0, 0
	local armRaise = 0
	local idle = def.idle
	if idleW > 0.01 then
		if idle == "bounce" then
			local ph = (t * 0.9 + self.seed) % 3
			if ph < 0.5 then
				local k = ph / 0.5
				bob += sin(k * math.pi) * 0.7 * idleW
				sqY *= 1 + sin(k * math.pi * 2) * 0.1
			end
			sqY *= 1 + sin(t * 3) * 0.03
		elseif idle == "sway" then
			tiltZ += sin(t * 1.5) * 0.12 * idleW
			headRoll = sin(t * 1.5 + 0.6) * 0.15
		elseif idle == "wiggle" then
			yawWiggle += sin(t * 14) * 0.12 * idleW * (sin(t * 0.7) > 0.3 and 1 or 0.2)
		elseif idle == "proud" then
			tiltX += 0.08 * idleW
			headYaw = sin(t * 0.5 + self.seed) * 0.5
			headPitch = 0.12
		elseif idle == "float" then
			bob += sin(t * 1.2) * 0.25 * idleW
			tiltX += sin(t * 0.8) * 0.05
		elseif idle == "peek" then
			headRoll = sin(t * 0.9 + self.seed) * 0.3
			headYaw = sin(t * 0.45 + self.seed) * 0.35
		elseif idle == "dance" then
			bob += abs(sin(t * 4)) * 0.3 * idleW
			yawWiggle += sin(t * 2) * 0.35 * idleW
			tiltZ += sin(t * 4) * 0.08 * idleW
			armRaise = (sin(t * 4) * 0.5 + 0.5) * idleW
		elseif idle == "spin" then
			if (t + self.seed) % 6 < 0.05 and not self.spinT then self.spinT = 0 end
		end
		-- breathing for everyone
		sqY *= 1 + sin(t * 2.2 + self.seed) * 0.025
	end

	-------------------------------------------------- jumps / reactions / spins
	if self.jumpT then
		self.jumpT += dt
		local k = self.jumpT / 0.55
		if k >= 1 then self.jumpT = nil; self.landSquash = 1
		else
			bob += sin(k * math.pi) * 2.2
			sqY *= 1 + sin(k * math.pi) * 0.15
		end
	end
	local spinYaw = 0
	if self.spinT then
		self.spinT += dt
		local k = clamp(self.spinT / 0.7, 0, 1)
		local e = 1 - (1 - k) ^ 3
		spinYaw = e * math.pi * 2
		if k >= 1 then self.spinT = nil; spinYaw = 0 end
	end
	local mouthOpen = 0
	if self.reactT then
		self.reactT += dt
		armRaise = math.max(armRaise, 1 - clamp(self.reactT / 1.2, 0, 1))
		mouthOpen = 1 - clamp(self.reactT / 1, 0, 1)
		if self.reactT > 1.2 then self.reactT = nil end
	end
	-- landing squash spring
	if self.landSquash > 0.001 then
		sqY *= 1 - self.landSquash * 0.22
		self.landSquash = springTo(self.landSquash, 0, 10, dt)
	end
	local sqXZ = 1 / math.sqrt(math.max(sqY, 0.5))

	-------------------------------------------------- apply root + body
	local rootCF = CFrame.new(self.pos.X, self.groundY, self.pos.Z) * CFrame.Angles(0, self.yaw + spinYaw, 0)
	rig.root.CFrame = rootCF
	local be = rig.bodyEntry
	if be then
		self:_set(be, CFrame.new(0, (y + bob) * self.scale, 0) * CFrame.Angles(tiltX, yawWiggle, tiltZ))
		be.mesh.Scale = Vector3.new(sqXZ, sqY, sqXZ) * self.scale
	end

	-------------------------------------------------- head look
	if self.look then
		local localLook = rootCF:PointToObjectSpace(self.look)
		local wantYaw = math.atan2(-localLook.X, -localLook.Z)
		if abs(wantYaw) < 2 then
			headYaw = clamp(wantYaw, -0.7, 0.7)
			self.lookAmt = springTo(self.lookAmt, 1, 6, dt)
		end
	else
		self.lookAmt = springTo(self.lookAmt, 0, 3, dt)
	end
	if rig.headEntry then
		self:_set(rig.headEntry, CFrame.Angles(headPitch + sin(t * 2.2) * 0.03, headYaw, headRoll))
	elseif headYaw ~= 0 or headRoll ~= 0 then
		-- head == body: turn the whole body a bit instead
		self:_set(be, CFrame.new(0, (y + bob) * self.scale, 0) * CFrame.Angles(tiltX, yawWiggle + headYaw * 0.4, tiltZ + headRoll * 0.4))
	end

	-------------------------------------------------- eyes: blink + pupils
	self.blinkTimer -= dt
	if self.blinkTimer <= 0 then
		self.blinkT = 0
		self.blinkTimer = 2 + math.random() * 3.5
		if math.random() < 0.2 then self.blinkTimer = 0.25 end -- double blink
	end
	local lid = 1
	if self.blinkT then
		self.blinkT += dt
		local k = self.blinkT / 0.14
		lid = (k < 0.5) and (1 - k * 1.8) or (0.1 + (k - 0.5) * 1.8)
		if k >= 1 then self.blinkT = nil; lid = 1 end
	end
	if mouthOpen > 0.5 then lid = math.min(lid, 0.35 + (1 - mouthOpen)) end -- happy squint
	for _, e in ipairs(rig.eyes) do
		e.mesh.Scale = Vector3.new(1, clamp(lid, 0.08, 1), 1) * self.scale
	end
	local px, py = sin(t * 0.37 + self.seed) * 0.06, sin(t * 0.23) * 0.04
	if self.look then px = clamp(-headYaw * 0.15, -0.1, 0.1) end
	for _, e in ipairs(rig.pupils) do
		self:_set(e, CFrame.new(px * self.scale, py * self.scale, 0))
	end
	if rig.mouth then
		rig.mouth.mesh.Scale = Vector3.new(1 + mouthOpen * 0.2, 1 + mouthOpen * 2.2, 1) * self.scale
	end

	-------------------------------------------------- ears (twitch)
	self.twitchT -= dt
	local twitch = 0
	if self.twitchT < 0 then
		if self.twitchT < -0.25 then self.twitchT = 1.5 + math.random() * 3 end
		twitch = sin((-self.twitchT) / 0.25 * math.pi) * 0.35
	end
	for i, ear in ipairs(rig.ears) do
		local a = sin(t * 2 + i) * 0.06 + (i == 1 and twitch or 0) - armRaise * 0.2
		self:_set(ear.e, CFrame.Angles(sin(t * 9) * 0.08 * spd, 0, -ear.side * a))
	end

	-------------------------------------------------- wings
	local flapSpeed = (def.move == "fly") and (14 + spd * 6) or 3
	local flapAmp = (def.move == "fly") and 0.75 or 0.12
	if def.wings == "bug" then flapSpeed *= 2.2; flapAmp *= 0.6 end
	if def.body == "fish" then flapSpeed = 5; flapAmp = 0.35 end
	for _, w in ipairs(rig.wings) do
		local f = sin(t * flapSpeed) * flapAmp
		self:_set(w.e, CFrame.Angles(0, 0, w.side * f))
	end

	-------------------------------------------------- tail with follow-through
	local wagSpeed = (idle == "wiggle" or self.reactT) and 14 or 3.5 + spd * 4
	for i, e in ipairs(rig.tail) do
		local ph = t * wagSpeed - i * 0.6
		self:_set(e, CFrame.Angles(sin(ph * 0.5) * 0.08, sin(ph) * (0.25 + i * 0.03), 0))
	end

	-------------------------------------------------- legs / feet
	local legSwing = (def.move == "walk") and (running and 0.9 or 0.6) * spd or 0
	for i, e in ipairs(rig.feet) do
		local phase = (i % 2 == 0) and 0 or math.pi
		if #rig.feet >= 4 and i > 2 then phase += math.pi end
		local tuck = (def.move == "hop" and bob > 0.3) and 0.4 or 0
		if def.move == "fly" then tuck = 0.5 end
		self:_set(e, CFrame.Angles(sin(t * 9 * (running and 1.4 or 1) + phase) * legSwing + tuck, 0, 0))
	end

	-------------------------------------------------- arms
	for _, arm in ipairs(rig.arms) do
		local wave = sin(t * 3 + arm.side) * 0.1 + sin(t * 9) * 0.25 * spd
		self:_set(arm.e, CFrame.Angles(wave, 0, -arm.side * (armRaise * 1.6)))
	end

	-------------------------------------------------- halos / orbits / bobbers
	for i, e in ipairs(rig.halos) do
		self:_set(e, CFrame.new(0, sin(t * 2 + i) * 0.12 * self.scale, 0) * CFrame.Angles(0, t * (i == 1 and 1.2 or -0.8), 0))
	end
	for _, e in ipairs(rig.bobbers) do
		self:_set(e, CFrame.Angles(sin(t * 3) * 0.2, 0, sin(t * 2.3) * 0.25))
	end
	if rig.aura then
		local pulse = 1 + sin(t * 3) * 0.05
		rig.aura.mesh.Scale = Vector3.one * pulse * self.scale
	end
end

function Animator:Destroy()
	if self.burst then self.burst:Destroy() end
	self.rig = nil
end

return Animator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">CreatureBuilder</string><ProtectedString name="Source"><![CDATA[-- CreatureBuilder: builds a detailed, rigged, cute 3D creature from CreatureData.
-- Location: ReplicatedStorage > Shared > CreatureBuilder (ModuleScript)
--
-- Every piece is a Part + SpecialMesh (smooth ellipsoids, no blocks) joined with Welds,
-- so CreatureAnimator can bend ears, flap wings, swing tails, blink eyes and squash
-- the body by changing Weld.C0 / SpecialMesh.Scale — no animation assets needed.

local Config = require(script.Parent.Config)
local CreatureData = require(script.Parent.CreatureData)

local Builder = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function hex(h) return Color3.fromHex(h) end
local function lighten(c, k) return c:Lerp(Color3.new(1, 1, 1), k) end
local function darken(c, k) return c:Lerp(Color3.new(0, 0, 0), k) end
local PINK = Color3.fromRGB(255, 140, 170)
local DARK = Color3.fromRGB(30, 22, 35)
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 205, 60)

---------------------------------------------------------------------
-- low-level part helpers
---------------------------------------------------------------------
local function newPiece(rig, name, size, color, mat, meshType, transparency)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = size.Magnitude > 1.2
	local m = Instance.new("SpecialMesh")
	m.MeshType = meshType or Enum.MeshType.Sphere
	m.Parent = p
	p.Parent = rig.model
	return p, m
end

-- attach `part` to `parent`; C0 = where the pivot sits on parent, C1 = pivot inside part
local function attach(rig, parent, part, mesh, c0, c1)
	local w = Instance.new("Weld")
	w.Part0 = parent
	w.Part1 = part
	w.C0 = c0
	w.C1 = c1 or CFrame.identity
	w.Parent = part
	local entry = { w = w, c0 = c0, c1 = w.C1, mesh = mesh, part = part }
	table.insert(rig.all, entry)
	return entry
end

local function ell(rig, parent, name, size, color, cf, mat, transp, c1)
	local p, m = newPiece(rig, name, size, color, mat, Enum.MeshType.Sphere, transp)
	return attach(rig, parent, p, m, cf, c1), p
end

local function cyl(rig, parent, name, size, color, cf, mat, transp, c1)
	local p, m = newPiece(rig, name, size, color, mat, Enum.MeshType.Cylinder, transp)
	return attach(rig, parent, p, m, cf, c1), p
end

-- cone made of shrinking ellipsoids along local +Y of `cf`
local function cone(rig, parent, name, cf, len, radius, color, mat, segments)
	segments = segments or 4
	for i = 0, segments - 1 do
		local t = i / segments
		local r = radius * (1 - t * 0.8)
		ell(rig, parent, name, Vector3.new(r * 2, len / segments * 1.6, r * 2), color,
			cf * CFrame.new(0, len * t + len / segments * 0.5, 0), mat)
	end
end

-- point on an ellipsoid surface (front = -Z) + orientation facing outwards
local function surface(r, x, y, side)
	local a, b, c = r.X, r.Y, r.Z
	local k = 1 - (x / a) ^ 2 - (y / b) ^ 2
	local z = -c * math.sqrt(math.max(0.04, k)) * (side or 1)
	local pos = Vector3.new(x, y, z)
	local n = Vector3.new(x / (a * a), y / (b * b), z / (c * c)).Unit
	return CFrame.lookAt(pos, pos + n)
end

local function matOf(name)
	if not name then return Enum.Material.SmoothPlastic end
	return Enum.Material[name] or Enum.Material.SmoothPlastic
end

---------------------------------------------------------------------
-- FACE
---------------------------------------------------------------------
local function buildEye(rig, head, r, x, y, w, h, def, accent, flip)
	local cf = surface(r, x, y)
	local style = def.eyes
	if style == "sleepy" then
		local e, ep = ell(rig, head, "Eye", Vector3.new(w, h * 0.22, 0.12), DARK, cf * CFrame.new(0, 0, -0.02))
		table.insert(rig.eyes, e)
		return
	end
	local scleraColor = WHITE
	local mat = Enum.Material.SmoothPlastic
	if style == "glow" then scleraColor = lighten(accent, 0.35); mat = Enum.Material.Neon end
	local e, eyePart = ell(rig, head, "Eye", Vector3.new(w, h, 0.18), scleraColor, cf, mat)
	table.insert(rig.eyes, e)
	if style ~= "glow" then
		local irisColor = (style == "sparkle" or style == "fierce") and accent or DARK
		local iris = ell(rig, eyePart, "Pupil", Vector3.new(w * 0.72, h * 0.74, 0.1), irisColor, CFrame.new(0, -h * 0.04, -0.06))
		table.insert(rig.pupils, iris)
		if style == "sparkle" or style == "fierce" then
			ell(rig, iris.part, "PupilCore", Vector3.new(w * 0.38, h * 0.42, 0.06), DARK, CFrame.new(0, 0, -0.03))
		end
		-- glossy highlights = the "alive" look
		ell(rig, iris.part, "Shine", Vector3.new(w * 0.28, h * 0.26, 0.04), WHITE, CFrame.new(-w * 0.14 * flip, h * 0.16, -0.06), Enum.Material.Neon)
		ell(rig, iris.part, "Shine2", Vector3.new(w * 0.13, h * 0.12, 0.04), WHITE, CFrame.new(w * 0.14 * flip, -h * 0.16, -0.06), Enum.Material.Neon)
	else
		ell(rig, eyePart, "Shine", Vector3.new(w * 0.3, h * 0.3, 0.05), WHITE, CFrame.new(-w * 0.15 * flip, h * 0.15, -0.07), Enum.Material.Neon)
	end
	if style == "fierce" then
		local brow = ell(rig, head, "Brow", Vector3.new(w * 1.1, h * 0.16, 0.12), darken(def._p, 0.55),
			surface(r, x, y + h * 0.62) * CFrame.Angles(0, 0, math.rad(-18 * flip)))
	end
end

local function buildFace(rig, head, r, def, yOff, scaleK)
	local accent = def._a
	scaleK = scaleK or 1
	local w, h = r.X * 0.42 * scaleK, r.Y * 0.5 * scaleK
	if def.eyes == "cyclops" then
		buildEye(rig, head, r, 0, yOff + r.Y * 0.05, w * 1.6, h * 1.5, def, accent, 1)
	else
		local sx = r.X * 0.36
		buildEye(rig, head, r, -sx, yOff, w, h, def, accent, 1)
		buildEye(rig, head, r, sx, yOff, w, h, def, accent, -1)
		if def.eyes ~= "fierce" then
			for _, s in ipairs({ -1, 1 }) do
				ell(rig, head, "Cheek", Vector3.new(r.X * 0.3, r.Y * 0.16, 0.08), PINK,
					surface(r, s * r.X * 0.58, yOff - r.Y * 0.32) * CFrame.new(0, 0, -0.01), nil, 0.35)
			end
		end
	end
	-- little smile ("w" mouth made of two arcs)
	local m1 = ell(rig, head, "Mouth", Vector3.new(r.X * 0.2, r.Y * 0.09, 0.07), DARK, surface(r, 0, yOff - r.Y * 0.36))
	rig.mouth = m1
	if table.find(def.extra, "eyepatch") then
		ell(rig, head, "Patch", Vector3.new(w * 1.25, h * 1.2, 0.2), DARK, surface(r, r.X * 0.36, yOff) * CFrame.new(0, 0, -0.06))
	end
end

---------------------------------------------------------------------
-- EARS / HORNS
---------------------------------------------------------------------
local function buildEars(rig, head, r, def)
	local kind = def.ears
	if kind == "none" then return end
	local p, s, a = def._p, def._s, def._a
	for _, side in ipairs({ -1, 1 }) do
		local e
		if kind == "round" then
			e = ell(rig, head, "Ear", Vector3.new(r.X * 0.55, r.X * 0.55, r.X * 0.22), p,
				CFrame.new(side * r.X * 0.62, r.Y * 0.72, 0.1) * CFrame.Angles(0, 0, -side * 0.35), nil, nil, CFrame.new(0, -r.X * 0.2, 0))
			ell(rig, e.part, "EarInner", Vector3.new(r.X * 0.34, r.X * 0.34, r.X * 0.1), PINK, CFrame.new(0, 0, -r.X * 0.07))
		elseif kind == "pointy" or kind == "cat" then
			local len = kind == "cat" and r.Y * 0.7 or r.Y * 0.95
			e = ell(rig, head, "Ear", Vector3.new(r.X * 0.42, len, r.X * 0.2), p,
				CFrame.new(side * r.X * 0.55, r.Y * 0.68, 0.05) * CFrame.Angles(0, 0, -side * 0.38), nil, nil, CFrame.new(0, -len * 0.42, 0))
			ell(rig, e.part, "EarInner", Vector3.new(r.X * 0.24, len * 0.7, r.X * 0.08), lighten(PINK, 0.2), CFrame.new(0, -len * 0.05, -r.X * 0.07))
		elseif kind == "bunny" then
			local len = r.Y * 1.5
			e = ell(rig, head, "Ear", Vector3.new(r.X * 0.36, len, r.X * 0.2), p,
				CFrame.new(side * r.X * 0.36, r.Y * 0.8, 0.1) * CFrame.Angles(-0.15, 0, -side * 0.18), nil, nil, CFrame.new(0, -len * 0.45, 0))
			ell(rig, e.part, "EarInner", Vector3.new(r.X * 0.2, len * 0.75, r.X * 0.08), PINK, CFrame.new(0, 0, -r.X * 0.08))
		elseif kind == "floppy" then
			local len = r.Y * 1.1
			e = ell(rig, head, "Ear", Vector3.new(r.X * 0.42, len, r.X * 0.2), darken(p, 0.12),
				CFrame.new(side * r.X * 0.82, r.Y * 0.25, 0) * CFrame.Angles(0, 0, side * 0.35), nil, nil, CFrame.new(0, len * 0.42, 0))
		elseif kind == "fin" then
			e = ell(rig, head, "Ear", Vector3.new(0.12 * r.X, r.Y * 0.7, r.Z * 0.8), a,
				CFrame.new(side * r.X * 0.92, 0, 0.1) * CFrame.Angles(0, 0, -side * 0.6), nil, 0.1, CFrame.new(0, -r.Y * 0.2, 0))
		end
		if e then table.insert(rig.ears, { e = e, side = side }) end
	end
end

local function buildHorns(rig, head, r, def)
	local kind = def.horns
	if kind == "none" then return end
	local a = def._a
	local hornColor = (kind == "antlers" or kind == "unicorn") and a or lighten(def._s, 0.2)
	local hmat = (kind == "antlers" or def.rarity == "Divine") and Enum.Material.Neon or Enum.Material.SmoothPlastic
	if kind == "unicorn" then
		cone(rig, head, "Horn", CFrame.new(0, r.Y * 0.8, -r.Z * 0.3) * CFrame.Angles(-0.35, 0, 0), r.Y * 1.1, r.X * 0.17, hornColor, hmat, 6)
		return
	end
	for _, side in ipairs({ -1, 1 }) do
		if kind == "small" then
			cone(rig, head, "Horn", CFrame.new(side * r.X * 0.4, r.Y * 0.78, 0) * CFrame.Angles(0, 0, -side * 0.25), r.Y * 0.5, r.X * 0.12, hornColor, hmat, 3)
		elseif kind == "dragon" then
			cone(rig, head, "Horn", CFrame.new(side * r.X * 0.42, r.Y * 0.7, r.Z * 0.2) * CFrame.Angles(0.9, 0, -side * 0.25), r.Y * 0.9, r.X * 0.15, hornColor, hmat, 5)
		elseif kind == "ram" then
			for i = 0, 5 do
				local ang = i / 5 * math.pi * 1.3
				local pos = Vector3.new(side * (r.X * 0.75 + math.sin(ang) * r.X * 0.28), r.Y * 0.5 + math.cos(ang) * r.Y * 0.3, r.Z * 0.15 + math.sin(ang * 0.5) * 0.2)
				local sz = r.X * (0.32 - i * 0.03)
				ell(rig, head, "Horn", Vector3.new(sz, sz, sz), hornColor, CFrame.new(pos))
			end
		elseif kind == "antlers" then
			local base = CFrame.new(side * r.X * 0.4, r.Y * 0.75, 0.1) * CFrame.Angles(0, 0, -side * 0.45)
			cyl(rig, head, "Antler", Vector3.new(0.18, r.Y * 1.1, 0.18), lighten(def._s, 0.1), base * CFrame.new(0, r.Y * 0.55, 0))
			for i = 1, 3 do
				local bcf = base * CFrame.new(0, r.Y * 0.3 * i, 0) * CFrame.Angles(0, 0, side * 0.9) * CFrame.new(0, r.Y * 0.22, 0)
				cyl(rig, head, "Antler", Vector3.new(0.14, r.Y * 0.45, 0.14), lighten(def._s, 0.1), bcf)
				ell(rig, head, "AntlerGlow", Vector3.new(0.28, 0.28, 0.28), a, bcf * CFrame.new(0, r.Y * 0.24, 0), Enum.Material.Neon)
			end
		end
	end
end

---------------------------------------------------------------------
-- TAIL / WINGS
---------------------------------------------------------------------
local function buildTail(rig, body, anchor, def, s)
	local kind = def.tail
	if kind == "none" then return end
	local p, sc, a = def._p, def._s, def._a
	if kind == "fluffy" then
		local e = ell(rig, body, "Tail", Vector3.new(1, 1, 1) * 0.9 * s, sc, anchor, nil, nil, CFrame.new(0, 0, -0.3 * s))
		ell(rig, e.part, "TailFluff", Vector3.new(0.6, 0.6, 0.6) * s, lighten(sc, 0.3), CFrame.new(0, 0.15 * s, 0.25 * s))
		table.insert(rig.tail, e)
		return
	end
	if kind == "fish" then
		local e = ell(rig, body, "Tail", Vector3.new(0.18 * s, 1.5 * s, 1.1 * s), a, anchor * CFrame.new(0, 0, 0.35 * s), nil, 0.05, CFrame.new(0, 0, -0.45 * s))
		table.insert(rig.tail, e)
		return
	end
	if kind == "lollipop" then
		local e = cyl(rig, body, "Tail", Vector3.new(0.18, 1.2, 0.18) * s, WHITE, anchor * CFrame.Angles(-0.7, 0, 0), nil, nil, CFrame.new(0, -0.6 * s, 0))
		local disc = cyl(rig, e.part, "Candy", Vector3.new(1.1, 0.25, 1.1) * s, a, CFrame.new(0, 0.75 * s, 0) * CFrame.Angles(math.pi / 2, 0, 0))
		cyl(rig, disc.part, "Swirl", Vector3.new(0.75, 0.27, 0.75) * s, sc, CFrame.identity)
		cyl(rig, disc.part, "Swirl2", Vector3.new(0.4, 0.29, 0.4) * s, a, CFrame.identity)
		table.insert(rig.tail, e)
		return
	end
	-- chain tails: long / flame / stinger / leaf / aurora
	local n = (kind == "flame") and 3 or 5
	local prev, prevLen = body, 0
	local auroraCols = { a, Color3.fromRGB(120, 255, 220), Color3.fromRGB(140, 160, 255), Color3.fromRGB(255, 140, 240), Color3.fromRGB(255, 255, 255) }
	for i = 1, n do
		local t = i / n
		local rad = (kind == "flame" and 0.75 or 0.5) * s * (1.1 - t * 0.6)
		local col, mat, tr = p, nil, 0
		if kind == "flame" then col = (i == n) and Color3.fromRGB(255, 240, 120) or a:Lerp(Color3.fromRGB(255, 120, 30), t); mat = Enum.Material.Neon end
		if kind == "aurora" then col = auroraCols[i]; mat = Enum.Material.Neon; tr = 0.2 end
		local c0 = (i == 1) and anchor or CFrame.new(0, rad * 0.5, rad * 1.1) * CFrame.Angles(0.28, 0, 0)
		local e, part = ell(rig, prev, "Tail", Vector3.new(rad * 2, rad * 2, rad * 2.4), col, c0, mat, tr)
		table.insert(rig.tail, e)
		prev = part
	end
	if kind == "flame" then
		local f = Instance.new("Fire"); f.Size = 3 * s; f.Heat = 6; f.Color = a; f.SecondaryColor = Color3.fromRGB(255, 230, 120); f.Parent = prev
	elseif kind == "stinger" then
		cone(rig, prev, "Stinger", CFrame.new(0, 0, 0.2 * s) * CFrame.Angles(math.pi / 2, 0, 0), 0.9 * s, 0.22 * s, DARK, nil, 3)
	elseif kind == "leaf" then
		ell(rig, prev, "Leaf", Vector3.new(0.9 * s, 0.12 * s, 1.4 * s), Color3.fromRGB(90, 210, 90), CFrame.new(0, 0, 0.8 * s))
	end
end

local function buildWings(rig, body, r, anchorY, def, s)
	local kind = def.wings
	if kind == "none" then return end
	local p, sc, a = def._p, def._s, def._a
	for _, side in ipairs({ -1, 1 }) do
		local pivot = CFrame.new(side * r.X * 0.75, anchorY, r.Z * 0.15)
		local e
		if kind == "feather" or kind == "angel" then
			local big = kind == "angel" and 1.5 or 1
			local col = kind == "angel" and WHITE or sc
			e = ell(rig, body, "Wing", Vector3.new(1.9 * big * s, 1.1 * big * s, 0.2 * s), col, pivot * CFrame.Angles(0, side * 0.25, side * 0.25), nil, nil,
				CFrame.new(-side * 0.8 * big * s, -0.1 * s, 0))
			for i = 1, 3 do
				ell(rig, e.part, "Feather", Vector3.new(1.3 * big * s * (1 - i * 0.15), 0.5 * big * s, 0.16 * s),
					i == 3 and (kind == "angel" and GOLD or a) or lighten(col, 0.1 * i),
					CFrame.new(side * 0.2 * i * s, -0.35 * i * big * s, 0.02) * CFrame.Angles(0, 0, side * 0.15 * i), i == 3 and kind == "angel" and Enum.Material.Neon or nil)
			end
		elseif kind == "bat" then
			e = ell(rig, body, "Wing", Vector3.new(2.2 * s, 1.3 * s, 0.1 * s), darken(a, 0.1), pivot * CFrame.Angles(0, side * 0.2, side * 0.3), nil, 0.05,
				CFrame.new(-side * 1.0 * s, -0.2 * s, 0))
			for i = -1, 1 do
				cyl(rig, e.part, "Finger", Vector3.new(0.12, 1.4, 0.12) * s, p, CFrame.new(side * 0.15 * s, 0.05, 0) * CFrame.Angles(0, 0, side * (1.2 + i * 0.4)))
			end
		elseif kind == "bug" then
			e = ell(rig, body, "Wing", Vector3.new(1.8 * s, 1.3 * s, 0.06 * s), lighten(a, 0.3), pivot * CFrame.Angles(0, side * 0.3, side * 0.5), Enum.Material.Glass, 0.35,
				CFrame.new(-side * 0.85 * s, -0.3 * s, 0))
			ell(rig, e.part, "WingSpot", Vector3.new(0.6, 0.6, 0.07) * s, sc, CFrame.new(side * 0.2 * s, 0.1 * s, 0), Enum.Material.Neon, 0.2)
			ell(rig, e.part, "WingLow", Vector3.new(1.2 * s, 0.9 * s, 0.06 * s), lighten(a, 0.5), CFrame.new(side * 0.1 * s, -0.8 * s, 0.05), Enum.Material.Glass, 0.4)
		end
		if e then table.insert(rig.wings, { e = e, side = side }) end
	end
end

---------------------------------------------------------------------
-- EXTRAS
---------------------------------------------------------------------
local function ringOf(rig, parent, center, radius, count, size, color, tilt)
	for i = 1, count do
		local ang = i / count * math.pi * 2
		ell(rig, parent, "Ring", Vector3.new(size, size, size), color,
			center * CFrame.Angles(tilt or 0, 0, 0) * CFrame.new(math.cos(ang) * radius, 0, math.sin(ang) * radius), Enum.Material.Neon)
	end
end

local function buildExtras(rig, head, hr, body, br, def, s)
	local p, sc, a = def._p, def._s, def._a
	for _, x in ipairs(def.extra) do
		if x == "leafsprout" then
			local stem = cyl(rig, head, "Sprout", Vector3.new(0.12, 0.5, 0.12) * s, Color3.fromRGB(70, 160, 60), CFrame.new(0, hr.Y * 0.98, 0), nil, nil, CFrame.new(0, -0.25 * s, 0))
			for _, side in ipairs({ -1, 1 }) do
				ell(rig, stem.part, "Leaf", Vector3.new(0.6, 0.1, 0.35) * s, Color3.fromRGB(110, 220, 90), CFrame.new(side * 0.3 * s, 0.25 * s, 0) * CFrame.Angles(0, 0, side * 0.4))
			end
			table.insert(rig.bobbers, stem)
		elseif x == "acorn" then
			ell(rig, head, "AcornCap", Vector3.new(hr.X * 1.3, hr.Y * 0.6, hr.Z * 1.3), Color3.fromRGB(120, 75, 40), CFrame.new(0, hr.Y * 0.78, 0), Enum.Material.Fabric)
			cyl(rig, head, "AcornStem", Vector3.new(0.15, 0.4, 0.15) * s, Color3.fromRGB(90, 55, 30), CFrame.new(0, hr.Y * 1.1, 0))
		elseif x == "flower" then
			local center = CFrame.new(hr.X * 0.55, hr.Y * 0.65, -hr.Z * 0.2) * CFrame.Angles(0, 0, -0.5)
			for i = 1, 5 do
				local ang = i / 5 * math.pi * 2
				ell(rig, head, "Petal", Vector3.new(0.38, 0.12, 0.38) * s, a, center * CFrame.new(math.cos(ang) * 0.25 * s, 0, math.sin(ang) * 0.25 * s))
			end
			ell(rig, head, "FlowerCore", Vector3.new(0.25, 0.16, 0.25) * s, Color3.fromRGB(255, 230, 90), center)
		elseif x == "crown" then
			local base = CFrame.new(0, hr.Y * 0.95, 0)
			cyl(rig, head, "Crown", Vector3.new(hr.X * 0.9, 0.3 * s, hr.X * 0.9), GOLD, base, Enum.Material.Metal)
			for i = 1, 5 do
				local ang = i / 5 * math.pi * 2
				local cf = base * CFrame.new(math.cos(ang) * hr.X * 0.4, 0.25 * s, math.sin(ang) * hr.X * 0.4)
				cone(rig, head, "CrownSpike", cf, 0.45 * s, 0.1 * s, GOLD, Enum.Material.Metal, 2)
				ell(rig, head, "Gem", Vector3.new(0.14, 0.14, 0.14) * s, a, cf * CFrame.new(0, 0.5 * s, 0), Enum.Material.Neon)
			end
		elseif x == "halo" then
			local hp, hm = newPiece(rig, "HaloCore", Vector3.new(0.1, 0.1, 0.1), GOLD, Enum.Material.Neon)
			local e = attach(rig, head, hp, hm, CFrame.new(0, hr.Y * 1.45, 0))
			ringOf(rig, hp, CFrame.identity, hr.X * 0.55, 14, 0.2 * s, Color3.fromRGB(255, 240, 150))
			table.insert(rig.halos, e)
		elseif x == "helmet" then
			ell(rig, head, "Helmet", hr * 2.5, Color3.fromRGB(200, 240, 255), CFrame.new(0, 0.1 * s, 0), Enum.Material.Glass, 0.7)
		elseif x == "crystal" then
			for i = -1, 1 do
				ell(rig, body, "Crystal", Vector3.new(0.35, 1.2 - math.abs(i) * 0.35, 0.35) * s, a,
					CFrame.new(i * br.X * 0.35, br.Y * 0.85, br.Z * 0.15) * CFrame.Angles(0.2, 0, -i * 0.35), Enum.Material.Neon, 0.1)
			end
		elseif x == "mane" then
			for i = 0, 9 do
				local ang = i / 10 * math.pi * 2
				ell(rig, head, "Mane", Vector3.new(0.75, 0.75, 0.75) * s, i % 2 == 0 and sc or a,
					CFrame.new(math.cos(ang) * hr.X * 0.95, math.sin(ang) * hr.Y * 0.95 + 0.05, hr.Z * 0.25))
			end
		elseif x == "spikes" then
			for i = 0, 3 do
				cone(rig, body, "Spike", CFrame.new(0, br.Y * 0.8 - i * 0.1, -br.Z * 0.5 + i * br.Z * 0.38) * CFrame.Angles(0.3, 0, 0), 0.7 * s, 0.2 * s, a, nil, 3)
			end
		elseif x == "antenna" then
			for _, side in ipairs({ -1, 1 }) do
				local st = cyl(rig, head, "Antenna", Vector3.new(0.09, 0.9, 0.09) * s, darken(p, 0.4),
					CFrame.new(side * hr.X * 0.3, hr.Y * 0.85, 0) * CFrame.Angles(0, 0, -side * 0.35), nil, nil, CFrame.new(0, -0.45 * s, 0))
				ell(rig, st.part, "AntennaBall", Vector3.new(0.3, 0.3, 0.3) * s, a, CFrame.new(0, 0.5 * s, 0), Enum.Material.Neon)
				table.insert(rig.ears, { e = st, side = side })
			end
		elseif x == "shell" then
			ell(rig, body, "Shell", br * 2.1, a, CFrame.new(0, br.Y * 0.25, br.Z * 0.1), Enum.Material.Glass, 0.15)
		elseif x == "candy" then
			local cols = { Color3.fromRGB(255, 90, 90), Color3.fromRGB(90, 200, 255), Color3.fromRGB(255, 230, 80), WHITE }
			for i = 1, 10 do
				local ang, h = i * 2.39, (i % 4) * 0.2
				ell(rig, body, "Sprinkle", Vector3.new(0.22, 0.08, 0.08) * s, cols[i % 4 + 1],
					CFrame.new(math.cos(ang) * br.X * 0.75, br.Y * (0.35 + h), math.sin(ang) * br.Z * 0.75) * CFrame.Angles(0, ang, 0.6), Enum.Material.Neon)
			end
		elseif x == "rings" then
			ringOf(rig, body, CFrame.new(0, 0, 0), br.X * 1.45, 22, 0.18 * s, a, 0.35)
		elseif x == "bow" then
			local c = CFrame.new(hr.X * 0.5, hr.Y * 0.75, 0) * CFrame.Angles(0, 0, -0.4)
			ell(rig, head, "Bow", Vector3.new(0.6, 0.45, 0.25) * s, a, c * CFrame.new(-0.3 * s, 0, 0))
			ell(rig, head, "Bow", Vector3.new(0.6, 0.45, 0.25) * s, a, c * CFrame.new(0.3 * s, 0, 0))
			ell(rig, head, "BowKnot", Vector3.new(0.25, 0.25, 0.25) * s, lighten(a, 0.3), c)
		elseif x == "snowcap" then
			ell(rig, head, "Snow", Vector3.new(hr.X * 1.2, hr.Y * 0.5, hr.Z * 1.2), WHITE, CFrame.new(0, hr.Y * 0.8, 0))
		elseif x == "scarf" then
			for i = 0, 11 do
				local ang = i / 12 * math.pi * 2
				ell(rig, head, "Scarf", Vector3.new(0.5, 0.4, 0.5) * s, i % 3 == 0 and WHITE or a,
					CFrame.new(math.cos(ang) * hr.X * 0.88, -hr.Y * 0.65, math.sin(ang) * hr.Z * 0.88))
			end
			ell(rig, head, "ScarfEnd", Vector3.new(0.45, 0.9, 0.2) * s, a, CFrame.new(hr.X * 0.45, -hr.Y * 0.95, -hr.Z * 0.75) * CFrame.Angles(0, 0, 0.2))
		end
	end
end

---------------------------------------------------------------------
-- RARITY EFFECTS
---------------------------------------------------------------------
local FX = {
	sparkle = { tex = SPARKLE, col = nil, rate = 6, speed = 1, size = 0.5 },
	leaves  = { tex = SPARKLE, col = Color3.fromRGB(140, 255, 120), rate = 5, speed = 1, size = 0.45 },
	embers  = { tex = SPARKLE, col = Color3.fromRGB(255, 140, 40), rate = 8, speed = 3, size = 0.35, up = true },
	fire    = { tex = FIRE, col = Color3.fromRGB(255, 130, 40), rate = 18, speed = 3, size = 1.4, up = true },
	snow    = { tex = SPARKLE, col = Color3.fromRGB(220, 245, 255), rate = 8, speed = 1, size = 0.4 },
	stars   = { tex = SPARKLE, col = Color3.fromRGB(255, 240, 160), rate = 10, speed = 1.5, size = 0.6 },
	smoke   = { tex = SMOKE, col = Color3.fromRGB(80, 30, 120), rate = 10, speed = 0.8, size = 2, up = true },
	rainbow = { tex = SPARKLE, col = "rainbow", rate = 14, speed = 1.5, size = 0.55 },
	hearts  = { tex = SPARKLE, col = Color3.fromRGB(255, 120, 170), rate = 5, speed = 1, size = 0.5, up = true },
	holy    = { tex = SPARKLE, col = Color3.fromRGB(255, 240, 170), rate = 16, speed = 2, size = 0.7, up = true },
	glitch  = { tex = SPARKLE, col = "glitch", rate = 25, speed = 4, size = 0.45 },
}

local function addEffects(rig, def, rr, s)
	local body = rig.body
	local fx = def.fx and FX[def.fx]
	local order = Config.Rarities[def.rarity].order
	if fx and order >= 3 then
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = fx.tex
		if fx.col == "rainbow" then
			pe.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 240, 80)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 220, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 100, 255)) })
		elseif fx.col == "glitch" then
			pe.Color = ColorSequence.new(Color3.fromRGB(0, 255, 200), Color3.fromRGB(255, 0, 170))
		else
			pe.Color = ColorSequence.new(fx.col or def._a)
		end
		pe.LightEmission = 1
		pe.Rate = fx.rate * (order >= 5 and 1.6 or 1)
		pe.Lifetime = NumberRange.new(0.8, 1.6)
		pe.Speed = NumberRange.new(fx.speed * 0.5, fx.speed)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Acceleration = fx.up and Vector3.new(0, 2, 0) or Vector3.new(0, -0.5, 0)
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, fx.size * s), NumberSequenceKeypoint.new(1, 0) })
		pe.Transparency = NumberSequence.new(0.1, 1)
		pe.Rotation = NumberRange.new(0, 360)
		pe.RotSpeed = NumberRange.new(-90, 90)
		pe.Shape = Enum.ParticleEmitterShape.Sphere
		pe.Parent = body
		table.insert(rig.emitters, pe)
	end
	if order >= 5 then
		local light = Instance.new("PointLight")
		light.Color = def.rarity == "Secret" and Color3.fromRGB(0, 255, 200) or lighten(def._a, 0.3)
		light.Range = 8 + order * 2
		light.Brightness = order >= 7 and 3 or 1.6
		light.Parent = body
		rig.light = light
	end
	if order >= 6 then
		-- glowing aura shell + orbiting motes for Mythical / Secret / Divine
		local auraCol = def.rarity == "Secret" and Color3.fromRGB(120, 0, 255) or lighten(def._a, 0.2)
		local aura = ell(rig, body, "Aura", rr * 2.6, auraCol, CFrame.identity, Enum.Material.ForceField, 0.2)
		rig.aura = aura
		local orbit, om = newPiece(rig, "Orbit", Vector3.new(0.1, 0.1, 0.1), auraCol, Enum.Material.Neon, nil, 1)
		local oe = attach(rig, body, orbit, om, CFrame.identity)
		ringOf(rig, orbit, CFrame.identity, rr.X * 1.6, order >= 8 and 8 or 5, 0.3 * s, order >= 8 and GOLD or auraCol)
		table.insert(rig.halos, oe)
	end
end

---------------------------------------------------------------------
-- BODY PLANS
---------------------------------------------------------------------
local function buildBody(rig, def, s)
	local p, sc, a = def._p, def._s, def._a
	local mat = matOf(def.mat)
	local tr = (mat == Enum.Material.Glass) and 0.25 or 0
	local root = rig.root
	local V = function(x, y, z) return Vector3.new(x, y, z) * s end
	local kind = def.body
	local body, head, br, hr, faceY, tailAnchor, wingY

	local function legs(parent, pts, size, col)
		for _, pt in ipairs(pts) do
			local e = ell(rig, parent, "Leg", size, col or darken(p, 0.08), CFrame.new(pt), nil, nil, CFrame.new(0, size.Y * 0.35, 0))
			table.insert(rig.feet, e)
		end
	end

	if kind == "round" then
		br = V(1.2, 1.1, 1.15)
		local e, part = ell(rig, root, "Body", br * 2, p, CFrame.new(0, br.Y + 0.25 * s, 0), mat, tr)
		rig.bodyEntry = e; body = part; head = part; hr = br; faceY = 0.12 * s
		ell(rig, body, "Belly", V(1.5, 1.4, 0.6), lighten(sc, 0.1), CFrame.new(0, -0.25 * s, -br.Z * 0.72))
		legs(body, { V(-0.5, -1.0, -0.45), V(0.5, -1.0, -0.45) }, V(0.7, 0.4, 0.85), darken(p, 0.1))
		for _, side in ipairs({ -1, 1 }) do
			local arm = ell(rig, body, "Arm", V(0.42, 0.6, 0.42), darken(p, 0.05), CFrame.new(side * br.X * 0.92, -0.15 * s, -0.25 * s) * CFrame.Angles(0, 0, side * 0.5), nil, nil, CFrame.new(0, 0.2 * s, 0))
			table.insert(rig.arms, { e = arm, side = side })
		end
		tailAnchor = CFrame.new(0, -0.3 * s, br.Z * 0.95); wingY = 0.25 * s
	elseif kind == "quad" then
		br = V(1.0, 0.85, 1.3)
		local e, part = ell(rig, root, "Body", br * 2, p, CFrame.new(0, 1.45 * s, 0), mat, tr)
		rig.bodyEntry = e; body = part
		ell(rig, body, "Belly", V(1.5, 1.0, 2.0), sc, CFrame.new(0, -0.35 * s, -0.1 * s))
		legs(body, { V(-0.55, -0.66, -0.8), V(0.55, -0.66, -0.8), V(-0.55, -0.66, 0.8), V(0.55, -0.66, 0.8) }, V(0.55, 0.95, 0.55))
		hr = V(0.98, 0.92, 0.92)
		local he, hpart = ell(rig, body, "Head", hr * 2, p, CFrame.new(0, 0.85 * s, -1.25 * s), mat, tr, CFrame.new(0, -0.3 * s, 0.3 * s))
		rig.headEntry = he; head = hpart; faceY = 0.12 * s
		ell(rig, head, "Snout", V(0.9, 0.55, 0.5), lighten(sc, 0.05), CFrame.new(0, -0.38 * s, -hr.Z * 0.82))
		ell(rig, head, "Nose", V(0.28, 0.2, 0.18), DARK, CFrame.new(0, -0.24 * s, -hr.Z * 1.05))
		tailAnchor = CFrame.new(0, 0.3 * s, br.Z * 0.95); wingY = 0.55 * s
	elseif kind == "bird" then
		br = V(1.1, 1.25, 1.05)
		local e, part = ell(rig, root, "Body", br * 2, p, CFrame.new(0, br.Y + 0.35 * s, 0), mat, tr)
		rig.bodyEntry = e; body = part; head = part; hr = br; faceY = 0.4 * s
		ell(rig, body, "Belly", V(1.5, 1.6, 0.6), sc, CFrame.new(0, -0.35 * s, -br.Z * 0.7))
		ell(rig, body, "Beak", V(0.55, 0.32, 0.6), Color3.fromRGB(255, 170, 50), CFrame.new(0, 0.05 * s, -br.Z * 1.0))
		legs(body, { V(-0.45, -1.25, -0.2), V(0.45, -1.25, -0.2) }, V(0.5, 0.35, 0.7), Color3.fromRGB(255, 160, 50))
		ell(rig, body, "Tuft", V(0.4, 0.7, 0.3), a, CFrame.new(0, br.Y * 0.98, -0.2 * s) * CFrame.Angles(-0.3, 0, 0))
		tailAnchor = CFrame.new(0, -0.35 * s, br.Z * 0.95); wingY = 0.1 * s
	elseif kind == "slime" then
		br = V(1.3, 1.0, 1.3)
		local e, part = ell(rig, root, "Body", br * 2, p, CFrame.new(0, 0.8 * s, 0), mat, tr)
		rig.bodyEntry = e; body = part; head = part; hr = br; faceY = 0.15 * s
		if mat == Enum.Material.Glass then
			ell(rig, body, "Core", V(0.9, 0.9, 0.9), a, CFrame.new(0, 0.05 * s, 0.2 * s), Enum.Material.Neon, 0.1)
		end
		ell(rig, body, "Shine", V(0.6, 0.3, 0.45), WHITE, CFrame.new(-0.45 * s, br.Y * 0.62, -0.5 * s) * CFrame.Angles(0, 0, 0.4), Enum.Material.Neon, 0.35)
		ell(rig, body, "Drip", V(0.5, 0.6, 0.5), p, CFrame.new(0.8 * s, -0.5 * s, -0.6 * s), mat, tr)
		tailAnchor = CFrame.new(0, 0, br.Z); wingY = 0.3 * s
	elseif kind == "ghost" then
		br = V(1.1, 1.3, 1.1)
		local e, part = ell(rig, root, "Body", br * 2, p, CFrame.new(0, 2.2 * s, 0), mat, mat == Enum.Material.Glass and 0.3 or 0.08)
		rig.bodyEntry = e; body = part; head = part; hr = br; faceY = 0.3 * s
		for i = -1, 1 do
			local w = ell(rig, body, "Wisp", V(0.7, 0.9, 0.7), lighten(p, 0.1), CFrame.new(i * 0.55 * s, -br.Y * 0.9, 0.1 * s), mat, 0.15, CFrame.new(0, 0.3 * s, 0))
			table.insert(rig.tail, w)
		end
		for _, side in ipairs({ -1, 1 }) do
			local arm = ell(rig, body, "Arm", V(0.4, 0.65, 0.4), p, CFrame.new(side * br.X * 0.95, -0.1 * s, -0.2 * s) * CFrame.Angles(0, 0, side * 0.7), mat, 0.08, CFrame.new(0, 0.25 * s, 0))
			table.insert(rig.arms, { e = arm, side = side })
		end
		tailAnchor = CFrame.new(0, -0.5 * s, br.Z); wingY = 0.4 * s
	elseif kind == "fish" then
		br = V(0.9, 0.95, 1.5)
		local e, part = ell(rig, root, "Body", br * 2, p, CFrame.new(0, 2.0 * s, 0), mat, tr)
		rig.bodyEntry = e; body = part; head = part; hr = br; faceY = 0.15 * s
		ell(rig, body, "Belly", V(1.4, 1.2, 2.4), sc, CFrame.new(0, -0.35 * s, 0))
		local dorsal = ell(rig, body, "Dorsal", V(0.15, 1.0, 1.1), a, CFrame.new(0, br.Y * 0.95, 0.2 * s) * CFrame.Angles(-0.4, 0, 0))
		for _, side in ipairs({ -1, 1 }) do
			local fin = ell(rig, body, "Fin", V(0.9, 0.12, 0.6), a, CFrame.new(side * br.X * 0.95, -0.3 * s, -0.2 * s), nil, 0.05, CFrame.new(-side * 0.4 * s, 0, 0))
			table.insert(rig.wings, { e = fin, side = side })
		end
		tailAnchor = CFrame.new(0, 0, br.Z * 0.95); wingY = 0.2 * s
	elseif kind == "dragon" then
		br = V(1.1, 0.95, 1.5)
		local e, part = ell(rig, root, "Body", br * 2, p, CFrame.new(0, 1.7 * s, 0), mat, tr)
		rig.bodyEntry = e; body = part
		ell(rig, body, "Belly", V(1.6, 1.2, 2.4), sc, CFrame.new(0, -0.38 * s, -0.1 * s))
		legs(body, { V(-0.65, -0.78, -0.9), V(0.65, -0.78, -0.9), V(-0.65, -0.78, 0.9), V(0.65, -0.78, 0.9) }, V(0.6, 1.1, 0.6))
		ell(rig, body, "Neck", V(0.9, 1.4, 0.9), p, CFrame.new(0, 0.85 * s, -1.25 * s) * CFrame.Angles(-0.5, 0, 0), mat, tr)
		hr = V(0.85, 0.75, 0.9)
		local he, hpart = ell(rig, body, "Head", hr * 2, p, CFrame.new(0, 1.7 * s, -1.75 * s), mat, tr, CFrame.new(0, -0.3 * s, 0.3 * s))
		rig.headEntry = he; head = hpart; faceY = 0.2 * s
		ell(rig, head, "Snout", V(1.1, 0.75, 0.95), lighten(p, 0.05), CFrame.new(0, -0.3 * s, -hr.Z * 0.8), mat, tr)
		for _, side in ipairs({ -1, 1 }) do
			ell(rig, head, "Nostril", V(0.14, 0.1, 0.1), DARK, CFrame.new(side * 0.2 * s, -0.15 * s, -hr.Z * 1.25))
		end
		tailAnchor = CFrame.new(0, 0.2 * s, br.Z * 0.95); wingY = 0.75 * s
	elseif kind == "bug" then
		br = V(0.8, 0.75, 0.75)
		local e, part = ell(rig, root, "Body", br * 2, p, CFrame.new(0, 1.3 * s, 0), mat, tr)
		rig.bodyEntry = e; body = part
		ell(rig, body, "Abdomen", V(1.8, 1.7, 2.1), sc, CFrame.new(0, 0.05 * s, 1.35 * s), mat, tr)
		for i = 0, 2 do
			ell(rig, body, "Stripe", V(1.82, 0.25, 0.3), a, CFrame.new(0, 0.05 * s, (0.75 + i * 0.5) * s) * CFrame.Angles(0.3 * (i - 1), 0, 0))
		end
		for i = -1, 1 do
			for _, side in ipairs({ -1, 1 }) do
				local leg = cyl(rig, body, "Leg", V(0.12, 0.9, 0.12), DARK, CFrame.new(side * 0.6 * s, -0.55 * s, i * 0.45 * s) * CFrame.Angles(0, 0, side * 0.6), nil, nil, CFrame.new(0, 0.4 * s, 0))
				table.insert(rig.feet, leg)
			end
		end
		hr = V(0.85, 0.8, 0.8)
		local he, hpart = ell(rig, body, "Head", hr * 2, p, CFrame.new(0, 0.45 * s, -1.05 * s), mat, tr, CFrame.new(0, -0.2 * s, 0.3 * s))
		rig.headEntry = he; head = hpart; faceY = 0.1 * s
		tailAnchor = CFrame.new(0, 0, 2.3 * s); wingY = 0.7 * s
	elseif kind == "golem" then
		br = V(1.5, 1.45, 1.25)
		local e, part = ell(rig, root, "Body", br * 2, p, CFrame.new(0, 2.3 * s, 0), mat, tr)
		rig.bodyEntry = e; body = part
		for i = 1, 4 do
			ell(rig, body, "Crack", V(0.12, 0.9, 0.05), a, surface(br, (i - 2.5) * 0.5 * s, (i % 2) * 0.4 * s - 0.4 * s) * CFrame.Angles(0, 0, i * 0.7), Enum.Material.Neon)
		end
		ell(rig, body, "Chest", V(1.6, 1.3, 0.5), lighten(sc, 0.1), CFrame.new(0, -0.3 * s, -br.Z * 0.82))
		for _, side in ipairs({ -1, 1 }) do
			local arm = ell(rig, body, "Arm", V(1.0, 1.9, 1.0), darken(p, 0.1), CFrame.new(side * br.X * 1.05, 0.2 * s, 0) * CFrame.Angles(0, 0, side * 0.15), mat, tr, CFrame.new(0, 0.75 * s, 0))
			ell(rig, arm.part, "Fist", V(1.15, 0.9, 1.15), sc, CFrame.new(0, -0.95 * s, 0))
			table.insert(rig.arms, { e = arm, side = side })
		end
		legs(body, { V(-0.7, -1.55, 0), V(0.7, -1.55, 0) }, V(1.0, 1.0, 1.0), darken(p, 0.15))
		hr = V(0.85, 0.75, 0.8)
		local he, hpart = ell(rig, body, "Head", hr * 2, p, CFrame.new(0, br.Y * 1.05, -0.25 * s), mat, tr, CFrame.new(0, -0.3 * s, 0))
		rig.headEntry = he; head = hpart; faceY = 0.05 * s
		tailAnchor = CFrame.new(0, -0.5 * s, br.Z); wingY = 0.8 * s
	end

	rig.body, rig.head, rig.bodyRadius, rig.headRadius = body, head, br, hr
	buildFace(rig, head, hr, def, faceY, def.body == "golem" and 0.85 or 1)
	buildEars(rig, head, hr, def)
	buildHorns(rig, head, hr, def)
	buildTail(rig, body, tailAnchor, def, s)
	buildWings(rig, body, br, wingY, def, s)
	buildExtras(rig, head, hr, body, br, def, s)
	addEffects(rig, def, br, s)
end

---------------------------------------------------------------------
-- PUBLIC
---------------------------------------------------------------------
-- Builds a creature model. Returns (model, rig). The model's PrimaryPart is an
-- anchored invisible "Root" at ground level, facing -Z. Move it with model:PivotTo().
function Builder.Build(creatureId: string, sizeMult: number?)
	local def = CreatureData.ById[creatureId]
	assert(def, "Unknown creature " .. tostring(creatureId))
	def._p, def._s, def._a = hex(def.c[1]), hex(def.c[2]), hex(def.c[3])
	local s = Config.Rarities[def.rarity].size * def.scale * (sizeMult or 1)

	local model = Instance.new("Model")
	model.Name = def.id
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 0.2, 1)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Parent = model
	model.PrimaryPart = root

	local rig = {
		model = model, root = root, def = def, size = s,
		all = {}, eyes = {}, pupils = {}, ears = {}, wings = {}, tail = {}, feet = {}, arms = {},
		halos = {}, bobbers = {}, emitters = {},
	}
	buildBody(rig, def, s)
	model:SetAttribute("CreatureId", def.id)
	model:SetAttribute("Rarity", def.rarity)
	return model, rig
end

return Builder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">CreatureData</string><ProtectedString name="Source"><![CDATA[-- CreatureData: all 54 creatures.
-- Location: ReplicatedStorage > Shared > CreatureData (ModuleScript)
--
-- Field reference (all used by CreatureBuilder / CreatureAnimator):
--   body  : round | quad | bird | slime | ghost | fish | dragon | bug | golem
--   move  : hop | walk | fly | float | slither
--   idle  : bounce | sway | spin | wiggle | proud | float | peek | dance
--   c     : { primary, secondary, accent } hex colours
--   ears  : none | round | pointy | bunny | floppy | cat | fin
--   horns : none | small | ram | antlers | unicorn | dragon
--   tail  : none | fluffy | flame | long | lollipop | fish | stinger | leaf | aurora
--   wings : none | feather | bat | bug | angel
--   extra : list of none | acorn | flower | leafsprout | crown | halo | helmet | crystal |
--           mane | spikes | antenna | shell | candy | rings | eyepatch | bow | snowcap | scarf
--   eyes  : big | sleepy | fierce | sparkle | cyclops | glow
--   mat   : material of the main body (default SmoothPlastic)
--   fx    : particle style for rare creatures
--   scale : extra size multiplier (on top of rarity size)
--   world : world id, or "Any" (portal-exclusive Secret/Divine creatures)

local L = {}
local function add(t) table.insert(L, t) end

---------------------------------------------------------------- GREEN FOREST
add{ id="Mossbun", name="Mossbun", rarity="Common", world="Forest", body="round", move="hop", idle="bounce",
	c={"#8BD86A","#F4FFE6","#4E9C3A"}, ears="bunny", tail="fluffy", eyes="big", extra={"leafsprout"},
	desc="A fluffy bunny that grows moss when it naps." }
add{ id="Acornip", name="Acornip", rarity="Uncommon", world="Forest", body="quad", move="walk", idle="peek",
	c={"#B9773F","#F6D9B0","#6B3F1C"}, ears="round", tail="fluffy", eyes="big", extra={"acorn"}, scale=0.9,
	desc="Wears its favourite acorn as a hat. Never takes it off." }
add{ id="Petalfly", name="Petalfly", rarity="Rare", world="Forest", body="bug", move="fly", idle="float",
	c={"#FF9AD5","#FFF3A6","#7A3BD1"}, wings="bug", eyes="sparkle", extra={"antenna"}, fx="sparkle",
	desc="Its wings are made of real flower petals." }
add{ id="Thornhog", name="Thornhog", rarity="Epic", world="Forest", body="quad", move="walk", idle="wiggle",
	c={"#C99B6D","#FFE9CF","#3FAA4A"}, ears="round", eyes="big", extra={"spikes","flower"}, fx="leaves",
	desc="Its spikes are soft leaves... mostly." }
add{ id="Elderstag", name="Elderstag Sprite", rarity="Legendary", world="Forest", body="quad", move="walk", idle="proud",
	c={"#EDE3C8","#FFFFFF","#7CFFB0"}, ears="pointy", horns="antlers", tail="fluffy", eyes="glow", fx="leaves", scale=1.1,
	desc="Ancient guardian of the forest. Its antlers glow at dusk." }
add{ id="Bloomwyrm", name="Bloomwyrm", rarity="Mythical", world="Forest", body="dragon", move="fly", idle="sway",
	c={"#5ED67A","#FFD6F0","#FF5FA8"}, horns="dragon", tail="leaf", wings="bat", eyes="fierce", extra={"flower"}, fx="sparkle",
	desc="A dragon that blooms a new flower with every breath." }

---------------------------------------------------------------- VOLCANO WORLD
add{ id="Emberpup", name="Emberpup", rarity="Common", world="Volcano", body="quad", move="walk", idle="wiggle",
	c={"#FF7A3D","#FFE0B8","#FFD13B"}, ears="pointy", tail="flame", eyes="big", fx="embers",
	desc="Wags its burning tail when happy. Keep away from curtains." }
add{ id="Magmite", name="Magmite", rarity="Uncommon", world="Volcano", body="slime", move="hop", idle="bounce",
	c={"#FF5A1F","#FFD04A","#3A1A10"}, eyes="big", mat="Neon", fx="embers",
	desc="A warm, gooey blob of living lava." }
add{ id="Cinderchick", name="Cinderchick", rarity="Rare", world="Volcano", body="bird", move="hop", idle="peek",
	c={"#FFB23B","#FFF0C2","#FF4A1A"}, wings="feather", tail="flame", eyes="big", extra={"leafsprout"}, fx="embers",
	desc="Its first chirp sparks a tiny campfire." }
add{ id="Obsidigolem", name="Obsidian Golem", rarity="Epic", world="Volcano", body="golem", move="walk", idle="proud",
	c={"#2A2230","#FF6A2A","#FFB14A"}, eyes="glow", extra={"crystal"}, mat="Slate", fx="embers", scale=1.1,
	desc="Lava flows through the cracks in its stone skin." }
add{ id="PhoenixLumen", name="Phoenix Lumen", rarity="Legendary", world="Volcano", body="bird", move="fly", idle="float",
	c={"#FF6B1A","#FFE45C","#FF2A6D"}, wings="feather", tail="flame", eyes="glow", extra={"crown"}, fx="fire", scale=1.1,
	desc="Reborn from its own ashes every sunrise." }
add{ id="Infernadrake", name="Infernadrake", rarity="Mythical", world="Volcano", body="dragon", move="fly", idle="proud",
	c={"#B3201A","#FFB347","#FFE14A"}, horns="dragon", tail="flame", wings="bat", eyes="fierce", extra={"spikes"}, fx="fire",
	desc="King of the volcano. Its roar melts rock." }

---------------------------------------------------------------- FROZEN KINGDOM
add{ id="Frostpaw", name="Frostpaw", rarity="Common", world="Frozen", body="round", move="hop", idle="wiggle",
	c={"#DDF3FF","#FFFFFF","#7EC8FF"}, ears="cat", tail="fluffy", eyes="big", extra={"scarf"},
	desc="Knits its own scarves. Very proud of them." }
add{ id="Snowpuff", name="Snowpuff", rarity="Uncommon", world="Frozen", body="round", move="hop", idle="bounce",
	c={"#FFFFFF","#E3F4FF","#9AD7FF"}, ears="round", eyes="sleepy", extra={"snowcap"}, fx="snow", scale=0.85,
	desc="A sleepy snowball that rolls everywhere." }
add{ id="IcicleOwl", name="Icicle Owl", rarity="Rare", world="Frozen", body="bird", move="fly", idle="peek",
	c={"#BFE6FF","#FFFFFF","#3B8BD6"}, ears="pointy", wings="feather", eyes="big", fx="snow",
	desc="Can turn its head all the way around. Showoff." }
add{ id="GlacierYeti", name="Glacier Yeti", rarity="Epic", world="Frozen", body="golem", move="walk", idle="dance",
	c={"#F4FBFF","#9AD9FF","#2D6FB0"}, horns="ram", eyes="big", mat="SmoothPlastic", fx="snow", scale=1.1,
	desc="Huge, fluffy, and loves to dance in blizzards." }
add{ id="AuroraFox", name="Aurora Fox", rarity="Legendary", world="Frozen", body="quad", move="walk", idle="sway",
	c={"#E8F7FF","#FFFFFF","#7CFFCB"}, ears="pointy", tail="aurora", eyes="glow", fx="sparkle",
	desc="Its tail paints the northern lights across the sky." }
add{ id="Crystalwing", name="Crystalwing Dragon", rarity="Mythical", world="Frozen", body="dragon", move="fly", idle="float",
	c={"#A6E4FF","#FFFFFF","#4AB8FF"}, horns="dragon", tail="long", wings="angel", eyes="glow", extra={"crystal"}, mat="Glass", fx="snow",
	desc="Every beat of its wings creates a snowflake." }

---------------------------------------------------------------- CRYSTAL CAVES
add{ id="Gemmy", name="Gemmy", rarity="Common", world="Crystal", body="slime", move="hop", idle="bounce",
	c={"#B07CFF","#E9D9FF","#5A2BA8"}, eyes="big", mat="Glass", extra={"crystal"},
	desc="A jelly with a tiny gem floating inside." }
add{ id="QuartzBeetle", name="Quartz Beetle", rarity="Uncommon", world="Crystal", body="bug", move="walk", idle="wiggle",
	c={"#E2E8F0","#9FE7FF","#3C4A6B"}, eyes="big", extra={"shell","antenna"}, mat="Glass",
	desc="Its shell sparkles like a disco ball." }
add{ id="GlimmerBat", name="Glimmer Bat", rarity="Rare", world="Crystal", body="round", move="fly", idle="float",
	c={"#5B3B8C","#FFC6F5","#C68BFF"}, ears="pointy", wings="bat", eyes="sparkle", fx="sparkle", scale=0.9,
	desc="Hangs upside down to watch the crystals glow." }
add{ id="AmethystEel", name="Amethyst Eel", rarity="Epic", world="Crystal", body="fish", move="slither", idle="sway",
	c={"#9B4DFF","#F2D6FF","#FF7AE6"}, ears="fin", tail="fish", eyes="glow", extra={"crystal"}, fx="sparkle",
	desc="Swims through solid rock like it's water." }
add{ id="PrismLion", name="Prism Lion", rarity="Legendary", world="Crystal", body="quad", move="walk", idle="proud",
	c={"#F6E7FF","#FFFFFF","#B66BFF"}, ears="round", tail="long", eyes="glow", extra={"mane","crystal"}, mat="SmoothPlastic", fx="rainbow", scale=1.1,
	desc="Its crystal mane splits light into rainbows." }
add{ id="GeodeLeviathan", name="Geode Leviathan", rarity="Mythical", world="Crystal", body="dragon", move="fly", idle="sway",
	c={"#3B2466","#FF8BF0","#7DF9FF"}, horns="dragon", tail="long", wings="bat", eyes="glow", extra={"crystal","spikes"}, fx="stars",
	desc="Sleeps for a thousand years inside a giant geode." }

---------------------------------------------------------------- CANDY WORLD
add{ id="Gumdrop", name="Gumdrop", rarity="Common", world="Candy", body="slime", move="hop", idle="bounce",
	c={"#FF5FA2","#FFD1E6","#FFFFFF"}, eyes="big", mat="Glass", extra={"candy"},
	desc="Covered in sugar crystals. Smells like strawberries." }
add{ id="CocoaCub", name="Cocoa Cub", rarity="Uncommon", world="Candy", body="round", move="walk", idle="dance",
	c={"#8A5232","#F2C8A0","#FF6FB1"}, ears="round", tail="none", eyes="big", extra={"bow"},
	desc="A chocolate bear who never melts... unless hugged too long." }
add{ id="Lollipup", name="Lollipup", rarity="Rare", world="Candy", body="quad", move="walk", idle="wiggle",
	c={"#FFF0F6","#FF5FA2","#5FD3FF"}, ears="floppy", tail="lollipop", eyes="big", extra={"bow"}, fx="hearts",
	desc="Its tail is a swirly lollipop. Do not lick." }
add{ id="Marshghost", name="Marshmallow Ghost", rarity="Epic", world="Candy", body="ghost", move="float", idle="float",
	c={"#FFFFFF","#FFE1F0","#FF9AC8"}, eyes="sleepy", fx="hearts",
	desc="The softest ghost in existence. Boo... please?" }
add{ id="Sugarcorn", name="Sugarcorn", rarity="Legendary", world="Candy", body="quad", move="walk", idle="proud",
	c={"#FFE3F2","#FFFFFF","#FF5FD0"}, ears="pointy", horns="unicorn", tail="aurora", eyes="sparkle", extra={"mane"}, fx="rainbow", scale=1.1,
	desc="Its horn is a candy cane that grants sweet wishes." }
add{ id="QueenBee", name="Candy Queen Bee", rarity="Mythical", world="Candy", body="bug", move="fly", idle="dance",
	c={"#FFD23B","#2A1A10","#FF6FB1"}, wings="bug", tail="stinger", eyes="sparkle", extra={"crown","antenna"}, fx="sparkle", scale=1.2,
	desc="Rules the honey-candy hives with a sticky fist." }

---------------------------------------------------------------- SPACE GALAXY
add{ id="AstroBlob", name="Astro Blob", rarity="Common", world="Space", body="slime", move="hop", idle="bounce",
	c={"#7CF2C8","#E6FFF6","#2B6B5A"}, eyes="big", extra={"helmet","antenna"},
	desc="An alien who wears a fishbowl for protection." }
add{ id="MoonMouse", name="Moon Mouse", rarity="Uncommon", world="Space", body="round", move="hop", idle="peek",
	c={"#C9CCE0","#FFFFFF","#FF9AC8"}, ears="round", tail="long", eyes="big", extra={"helmet"},
	desc="Convinced the moon is made of cheese. Still searching." }
add{ id="CometFish", name="Comet Fish", rarity="Rare", world="Space", body="fish", move="float", idle="sway",
	c={"#5BC0FF","#FFFFFF","#FFE45C"}, ears="fin", tail="flame", eyes="big", fx="stars",
	desc="Swims between stars, leaving a glittering trail." }
add{ id="NebulaJelly", name="Nebula Jelly", rarity="Epic", world="Space", body="ghost", move="float", idle="float",
	c={"#B06BFF","#FF8AE2","#5BE3FF"}, eyes="sparkle", mat="Glass", extra={"antenna"}, fx="stars",
	desc="A whole nebula swirls inside its glassy body." }
add{ id="StarWhale", name="Star Whale", rarity="Legendary", world="Space", body="fish", move="float", idle="sway",
	c={"#2B3B8C","#9FD3FF","#FFE45C"}, ears="fin", tail="fish", eyes="glow", extra={"rings"}, fx="stars", scale=1.5,
	desc="Sings songs that make new stars appear." }
add{ id="CosmicDragon", name="Cosmic Dragon", rarity="Mythical", world="Space", body="dragon", move="fly", idle="spin",
	c={"#1A1040","#7A5BFF","#FF5FD0"}, horns="dragon", tail="long", wings="bat", eyes="glow", extra={"rings"}, mat="Glass", fx="stars",
	desc="Made of stardust. Its scales are tiny galaxies." }

---------------------------------------------------------------- SHADOW DIMENSION
add{ id="Gloomling", name="Gloomling", rarity="Common", world="Shadow", body="ghost", move="float", idle="peek",
	c={"#3B2A55","#7A5BAA","#B78CFF"}, eyes="big", fx="smoke", scale=0.85,
	desc="Shy little shadow. Hides behind your legs." }
add{ id="ShadeCat", name="Shade Cat", rarity="Uncommon", world="Shadow", body="quad", move="walk", idle="sway",
	c={"#251A33","#5A3F7A","#C7FF5C"}, ears="cat", tail="long", eyes="glow",
	desc="Only its glowing eyes are visible at night." }
add{ id="NightMoth", name="Night Moth", rarity="Rare", world="Shadow", body="bug", move="fly", idle="float",
	c={"#4A3A6B","#D9C7FF","#8AF0FF"}, wings="bug", eyes="sparkle", extra={"antenna"}, fx="sparkle",
	desc="Attracted to the glow of portals." }
add{ id="VoidWisp", name="Void Wisp", rarity="Epic", world="Shadow", body="ghost", move="float", idle="spin",
	c={"#120A1E","#8A2BFF","#FF3BD4"}, eyes="cyclops", mat="Neon", fx="smoke",
	desc="A flicker of pure darkness with one curious eye." }
add{ id="UmbraWolf", name="Umbra Wolf", rarity="Legendary", world="Shadow", body="quad", move="walk", idle="proud",
	c={"#1E1630","#4B3570","#B44BFF"}, ears="pointy", tail="fluffy", eyes="fierce", extra={"spikes"}, fx="smoke", scale=1.15,
	desc="Howls at a moon that doesn't exist." }
add{ id="NightmareWyvern", name="Nightmare Wyvern", rarity="Mythical", world="Shadow", body="dragon", move="fly", idle="sway",
	c={"#0F0A18","#5A1A8C","#FF2A4D"}, horns="ram", tail="stinger", wings="bat", eyes="fierce", extra={"spikes"}, fx="smoke",
	desc="Born from the worst dream of a sleeping god." }

---------------------------------------------------------------- HEAVEN WORLD
add{ id="CloudLamb", name="Cloud Lamb", rarity="Common", world="Heaven", body="round", move="hop", idle="bounce",
	c={"#FFFFFF","#FFF4D6","#FFC8DD"}, ears="floppy", horns="ram", eyes="sleepy", extra={"mane"},
	desc="Its wool is a real cloud. It sometimes rains." }
add{ id="HaloChick", name="Halo Chick", rarity="Uncommon", world="Heaven", body="bird", move="hop", idle="peek",
	c={"#FFF6C2","#FFFFFF","#FFC94A"}, wings="angel", eyes="big", extra={"halo"}, fx="holy",
	desc="Took a halo from the lost & found. Kept it." }
add{ id="Seraphling", name="Seraphling", rarity="Rare", world="Heaven", body="round", move="fly", idle="float",
	c={"#FFEFD6","#FFFFFF","#FFD86B"}, ears="none", wings="angel", eyes="sparkle", extra={"halo"}, fx="holy",
