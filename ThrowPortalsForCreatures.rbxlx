	wingK = 1.15, tailSegs = 8, haloY = 1.5,
	sig = { dur = 3.2, keys = { { 0.35, { headPitch = 0.35, headYaw = 0.4 } }, { 0.65, { headPitch = 0.3, headYaw = 0.45, chainWave = 1 } } } },
