<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Config: every tunable number in the game lives here.
-- Location: ReplicatedStorage > Shared > Config (ModuleScript)

local Config = {}

---------------------------------------------------------------------
-- RARITIES
---------------------------------------------------------------------
Config.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythical", "Secret", "Divine" }

Config.Rarities = {
	Common    = { order = 1, color = Color3.fromRGB(190, 200, 210), income = 1,     size = 1.00, glow = false },
	Uncommon  = { order = 2, color = Color3.fromRGB(95, 220, 110),  income = 3,     size = 1.05, glow = false },
	Rare      = { order = 3, color = Color3.fromRGB(70, 160, 255),  income = 10,    size = 1.12, glow = false },
	Epic      = { order = 4, color = Color3.fromRGB(180, 90, 255),  income = 35,    size = 1.20, glow = false },
	Legendary = { order = 5, color = Color3.fromRGB(255, 190, 40),  income = 150,   size = 1.32, glow = true },
	Mythical  = { order = 6, color = Color3.fromRGB(255, 70, 120),  income = 600,   size = 1.45, glow = true },
	Secret    = { order = 7, color = Color3.fromRGB(40, 40, 50),    income = 3000,  size = 1.55, glow = true },
	Divine    = { order = 8, color = Color3.fromRGB(255, 250, 200), income = 12000, size = 1.70, glow = true },
}

---------------------------------------------------------------------
-- PORTALS  (weights are relative; bigger = more likely)
---------------------------------------------------------------------
Config.PortalOrder = { "Basic", "Forest", "Lava", "Ice", "Galaxy", "Dark", "Rainbow", "Divine", "Secret" }

Config.Portals = {
	Basic   = { name = "Basic Portal",   price = 0,          color = Color3.fromRGB(120, 200, 255), color2 = Color3.fromRGB(255, 255, 255), fx = "Sparkle",
		weights = { Common = 70, Uncommon = 25, Rare = 5 } },
	Forest  = { name = "Forest Portal",  price = 400,        color = Color3.fromRGB(80, 220, 90),   color2 = Color3.fromRGB(210, 255, 120), fx = "Leaves",
		weights = { Common = 50, Uncommon = 35, Rare = 13, Epic = 2 } },
	Lava    = { name = "Lava Portal",    price = 4500,       color = Color3.fromRGB(255, 90, 20),   color2 = Color3.fromRGB(255, 220, 60),  fx = "Fire",
		weights = { Common = 30, Uncommon = 38, Rare = 24, Epic = 7, Legendary = 1 } },
	Ice     = { name = "Ice Portal",     price = 30000,      color = Color3.fromRGB(150, 230, 255), color2 = Color3.fromRGB(255, 255, 255), fx = "Snow",
		weights = { Uncommon = 35, Rare = 38, Epic = 20, Legendary = 6, Mythical = 1 } },
	Galaxy  = { name = "Galaxy Portal",  price = 200000,     color = Color3.fromRGB(110, 60, 255),  color2 = Color3.fromRGB(255, 120, 230), fx = "Stars",
		weights = { Uncommon = 20, Rare = 38, Epic = 28, Legendary = 11, Mythical = 3 } },
	Dark    = { name = "Dark Portal",    price = 1500000,    color = Color3.fromRGB(60, 0, 90),     color2 = Color3.fromRGB(190, 40, 255),  fx = "Smoke",
		weights = { Rare = 35, Epic = 35, Legendary = 20, Mythical = 8, Secret = 2 } },
	Rainbow = { name = "Rainbow Portal", price = 10000000,   color = Color3.fromRGB(255, 80, 80),   color2 = Color3.fromRGB(80, 160, 255),  fx = "Rainbow",
		weights = { Rare = 20, Epic = 35, Legendary = 28, Mythical = 13, Secret = 3.5, Divine = 0.5 } },
	Divine  = { name = "Divine Portal",  price = 75000000,   color = Color3.fromRGB(255, 235, 150), color2 = Color3.fromRGB(255, 255, 255), fx = "Holy",
		weights = { Epic = 30, Legendary = 35, Mythical = 25, Secret = 7, Divine = 3 } },
	Secret  = { name = "Secret Portal",  price = 400000000,  color = Color3.fromRGB(15, 15, 20),    color2 = Color3.fromRGB(0, 255, 200),   fx = "Glitch",
		weights = { Legendary = 30, Mythical = 40, Secret = 22, Divine = 8 } },
}

---------------------------------------------------------------------
-- THE LANE: one long map. Players stand in the start area (Z < 0) and throw
-- down the lane (+Z). Each world is a ZONE of the lane; how far you throw
-- decides which zone's creatures you can find.
---------------------------------------------------------------------
Config.WorldOrder = { "Forest", "Volcano", "Frozen", "Crystal", "Candy", "Space", "Shadow", "Heaven" }
Config.LaneHalfWidth = 30     -- creatures land within |X| <= this
Config.MapHalfWidth = 70      -- lane walls (narrow valley)
Config.StartHalfWidth = 105   -- start area walls (bases + training)
Config.StartDepth = 470       -- start area spans Z = -StartDepth .. 0
Config.HallHalfWidth = 28     -- the Portal Launch Hall (enter it to throw)
Config.HallBackZ = -36
Config.ZoneBounds = {         -- distance (studs from the launch line) where each zone starts / ends
	Forest = { 0, 150 }, Volcano = { 150, 350 }, Frozen = { 350, 600 }, Crystal = { 600, 900 },
	Candy = { 900, 1300 }, Space = { 1300, 1800 }, Shadow = { 1800, 2400 }, Heaven = { 2400, 3200 },
}
Config.LaneLength = 3200
Config.ThrowZone = { minZ = -34, maxZ = 4 }  -- inside the Launch Hall
Config.BarrierZ = 6                         -- players can't walk past this (the lane is for portals only)
-- seconds after the portal opens before the creature is caught into your inventory
-- (long enough for its entrance animation to play)
Config.CatchDelay = { Common = 2.4, Uncommon = 2.4, Rare = 2.6, Epic = 2.6, Legendary = 3.4, Mythical = 3.6, Secret = 3.0, Divine = 3.8 }

function Config.InThrowZone(pos: Vector3): boolean
	return pos.Z >= Config.ThrowZone.minZ and pos.Z <= Config.ThrowZone.maxZ and math.abs(pos.X) <= Config.HallHalfWidth
end

Config.Worlds = {
	Forest  = { index = 1, name = "Green Forest",     cost = 0,         throwLevel = 1,  incomeMult = 1,
		material = Enum.Material.Grass,     groundColor = Color3.fromRGB(104, 168, 70),
		ambient = Color3.fromRGB(140, 150, 130), fog = Color3.fromRGB(196, 214, 226), fogEnd = 900, clock = 14, tint = Color3.fromRGB(255, 250, 240), atmo = Color3.fromRGB(214, 220, 218) },
	Volcano = { index = 2, name = "Volcano World",    cost = 3000,      throwLevel = 5,  incomeMult = 3,
		material = Enum.Material.Asphalt,   groundColor = Color3.fromRGB(54, 46, 52),
		ambient = Color3.fromRGB(135, 108, 100), fog = Color3.fromRGB(170, 120, 100), fogEnd = 700, clock = 15.2, tint = Color3.fromRGB(255, 238, 225), atmo = Color3.fromRGB(225, 160, 130) },
	Frozen  = { index = 3, name = "Frozen Kingdom",   cost = 25000,     throwLevel = 10, incomeMult = 9,
		material = Enum.Material.Snow,      groundColor = Color3.fromRGB(235, 245, 255),
		ambient = Color3.fromRGB(150, 170, 200), fog = Color3.fromRGB(210, 230, 255), fogEnd = 700, clock = 10, tint = Color3.fromRGB(235, 245, 255), atmo = Color3.fromRGB(220, 240, 255) },
	Crystal = { index = 4, name = "Crystal Caves",    cost = 150000,    throwLevel = 15, incomeMult = 27,
		material = Enum.Material.Slate,     groundColor = Color3.fromRGB(66, 58, 92),
		ambient = Color3.fromRGB(176, 150, 214), fog = Color3.fromRGB(150, 128, 196), fogEnd = 700, clock = 16.4, tint = Color3.fromRGB(242, 232, 255), atmo = Color3.fromRGB(170, 130, 230) },
	Candy   = { index = 5, name = "Candy World",      cost = 900000,    throwLevel = 20, incomeMult = 80,
		material = Enum.Material.Sand,      groundColor = Color3.fromRGB(255, 180, 215),
		ambient = Color3.fromRGB(200, 150, 180), fog = Color3.fromRGB(255, 210, 235), fogEnd = 800, clock = 13, tint = Color3.fromRGB(255, 240, 250), atmo = Color3.fromRGB(255, 200, 230) },
	Space   = { index = 6, name = "Space Galaxy",     cost = 6000000,   throwLevel = 27, incomeMult = 250,
		material = Enum.Material.Limestone, groundColor = Color3.fromRGB(150, 152, 196),
		ambient = Color3.fromRGB(156, 156, 210), fog = Color3.fromRGB(70, 60, 130),    fogEnd = 1500, clock = 0, tint = Color3.fromRGB(232, 230, 255), atmo = Color3.fromRGB(100, 80, 180) },
	Shadow  = { index = 7, name = "Shadow Dimension", cost = 40000000,  throwLevel = 34, incomeMult = 800,
		material = Enum.Material.Ground,    groundColor = Color3.fromRGB(122, 104, 150),
		ambient = Color3.fromRGB(118, 104, 140), fog = Color3.fromRGB(104, 88, 128),   fogEnd = 650, clock = 17.2, tint = Color3.fromRGB(240, 232, 250), atmo = Color3.fromRGB(132, 108, 158) },
	Heaven  = { index = 8, name = "Heaven World",     cost = 250000000, throwLevel = 42, incomeMult = 2500,
		material = Enum.Material.Salt,      groundColor = Color3.fromRGB(255, 250, 235),
		ambient = Color3.fromRGB(220, 210, 170), fog = Color3.fromRGB(255, 248, 225), fogEnd = 900, clock = 12, tint = Color3.fromRGB(255, 250, 235), atmo = Color3.fromRGB(255, 240, 200) },
}

-- middle of a zone on the lane
function Config.WorldCenter(worldId: string): Vector3
	local b = Config.ZoneBounds[worldId]
	return Vector3.new(0, 0, (b[1] + b[2]) / 2)
end

-- which zone a position is in (the start area counts as Green Forest)
function Config.WorldAt(pos: Vector3): string
	local d = pos.Z
	if d < 0 then return "Forest" end
	for _, id in ipairs(Config.WorldOrder) do
		local b = Config.ZoneBounds[id]
		if d >= b[1] and d < b[2] then return id end
	end
	return Config.WorldOrder[#Config.WorldOrder]
end

---------------------------------------------------------------------
-- TRAINING: stand at a station and lift to gain Strength. Strength = farther throws.
---------------------------------------------------------------------
Config.TrainingStations = {
	-- along the street, right next to the base entrances (staggered left/right)
	-- same stations for everyone; each player buys the equipment with money once, then lifts for free
	{ name = "Wooden Dumbbell",        price = 0,       gain = 1,   color = Color3.fromRGB(170, 120, 70),  pos = Vector3.new(-13, 0, -100) },
	{ name = "Iron Barbell",           price = 750,     gain = 5,   color = Color3.fromRGB(150, 155, 170), pos = Vector3.new(13, 0, -140) },
	{ name = "Golden Kettlebell",      price = 15000,   gain = 25,  color = Color3.fromRGB(255, 200, 60),  pos = Vector3.new(-13, 0, -180) },
	{ name = "Crystal Weights",        price = 300000,  gain = 120, color = Color3.fromRGB(150, 110, 255), pos = Vector3.new(13, 0, -220) },
	{ name = "Cosmic Gravity Machine", price = 6000000, gain = 600, color = Color3.fromRGB(80, 230, 255),  pos = Vector3.new(-13, 0, -260) },
}
-- Every base has its OWN gym. Your gym starts with the Wooden Dumbbell; pay money to upgrade
-- it to the next equipment above. GymOffset is the gym's position inside a base (local space).
Config.GymOffset = Vector3.new(19, 0, -19)
Config.TrainCooldown = 0.35
Config.TrainRange = 10

-- Total throw distance (studs) at 100% power: upgrades + strength
function Config.ThrowDistance(level: number, strength: number): number
	return 40 + (level - 1) * 10 + math.sqrt(math.max(strength, 0)) * 6
end

---------------------------------------------------------------------
-- ADMINS: the game owner (and anyone in Studio) is always admin. Add extra UserIds here.
---------------------------------------------------------------------
Config.AdminIds = {}

---------------------------------------------------------------------
-- UPGRADES
---------------------------------------------------------------------
Config.Upgrades = {
	ThrowPower = { name = "Throw Power",    max = 50, baseCost = 60,   growth = 1.33, desc = "+10 studs throw distance per level. Farther = more luck!" },
	BaseSlots  = { name = "Base Slots",     max = 20, baseCost = 250,  growth = 1.85, desc = "Place more creatures in your base." },
	Storage    = { name = "Creature Storage", max = 20, baseCost = 150, growth = 1.6, desc = "Hold more creatures in your backpack." },
	Training   = { name = "Pet Trainer",    max = 25, baseCost = 1200, growth = 1.9, desc = "Trains your creatures: +15% income per level." },
}

function Config.UpgradeCost(kind: string, level: number): number
	local u = Config.Upgrades[kind]
	return math.floor(u.baseCost * u.growth ^ level)
end

Config.StartSlots = 4          -- base slots with BaseSlots level 0
Config.StartStorage = 10       -- storage with Storage level 0
Config.StoragePerLevel = 5
Config.TrainingBonus = 0.15

function Config.MaxThrowDistance(level: number): number
	return 45 + (level - 1) * 7
end

function Config.LuckFromDistance(dist: number): number
	return 1 + (dist / 100) * 0.12
end

---------------------------------------------------------------------
-- DECORATIONS (base customization)
---------------------------------------------------------------------
Config.DecorOrder = { "FlowerBed", "Lanterns", "MushroomRing", "Fountain", "CrystalTree", "Statue", "Rainbow", "FloatingIsland" }
Config.Decor = {
	FlowerBed      = { name = "Flower Bed",      price = 300 },
	Lanterns       = { name = "Glow Lanterns",   price = 1500 },
	MushroomRing   = { name = "Mushroom Ring",   price = 6000 },
	Fountain       = { name = "Portal Fountain", price = 40000 },
	CrystalTree    = { name = "Crystal Tree",    price = 250000 },
	Statue         = { name = "Golden Statue",   price = 2000000 },
	Rainbow        = { name = "Rainbow Arch",    price = 15000000 },
	FloatingIsland = { name = "Floating Island", price = 120000000 },
}

Config.FloorThemes = {
	{ id = "Meadow",  name = "Meadow",  price = 0,       color = Color3.fromRGB(120, 200, 95),  material = Enum.Material.Grass },
	{ id = "Stone",   name = "Stone",   price = 800,     color = Color3.fromRGB(170, 170, 180), material = Enum.Material.Cobblestone },
	{ id = "Wood",    name = "Wood",    price = 5000,    color = Color3.fromRGB(170, 120, 75),  material = Enum.Material.WoodPlanks },
	{ id = "Marble",  name = "Marble",  price = 50000,   color = Color3.fromRGB(240, 240, 245), material = Enum.Material.Marble },
	{ id = "Neon",    name = "Galaxy",  price = 1000000, color = Color3.fromRGB(80, 40, 180),   material = Enum.Material.Glass },
}

---------------------------------------------------------------------
-- MISC
---------------------------------------------------------------------
Config.ThrowCooldown = 1.2
Config.MaxPendingPerPlayer = 1     -- one portal at a time
Config.PendingLifetime = 90
Config.CollectRange = 18
Config.CarryLimit = 4

-- Equipped pets: up to 3 follow you and give buffs. Each pet adds its rarity's bonus:
-- luck multiplies the odds of rarer rolls, income adds to your base income per second.
Config.EquipLimit = 3

-- Perfect streak: each consecutive perfect throw adds luck for the next roll (a missed perfect or a
-- long pause resets it). Luck multiplies the odds of the rarer tiers, same as equipped pets.
Config.Combo = { perStep = 0.05, max = 5, resetAfter = 60 }

-- Rift Storm: a server-wide event. Every player in the server gets extra luck while it lasts.
Config.RiftStorm = { first = 300, gap = { 720, 1080 }, duration = 120, luck = 1.5 }

-- Index mastery: discovering every creature of one world adds a permanent income bonus.
Config.IndexWorldBonus = 0.05

-- Progression: daily quests, rebirth, friends, monetisation and fusion (server: Progression.lua)
Config.Progression = {
	QuestPool = {
		{ id = "throw", text = "Throw %d portals", goal = { 8, 14 } },
		{ id = "perfect", text = "Land %d perfect throws", goal = { 3, 6 } },
		{ id = "catch", text = "Catch %d creatures", goal = { 5, 9 } },
		{ id = "rare", text = "Catch %d Rare-or-better creature(s)", goal = { 1, 2 } },
	},
	QuestReward = { min = 150, incomeSeconds = 240 }, -- prize = max(min, income/s * seconds)
	Rebirth = { baseCost = 5000000, growth = 4, incomePer = 0.25, luckPer = 0.1 },
	Friends = { luckPer = 0.1, max = 3 },
	-- Game pass / developer product ids. 0 = not created yet: the button stays hidden and nothing is sold.
	-- Create them on the Creator Dashboard (Monetization) and paste the ids here.
	Passes = { DoubleLuck = 0, DoubleIncome = 0, ExtraPet = 0 },
	Products = { LuckPotion = 0 },
	Potion = { luck = 2, seconds = 900 },
	Fusion = { need = 3 },
}
Config.Progression.QuestById = {}
for _, q in ipairs(Config.Progression.QuestPool) do
	Config.Progression.QuestById[q.id] = q
end
-- Throw charge: one full ping-pong of the power bar takes this long (client and server must agree)
Config.ChargePeriod = 1.5
Config.EquipBuff = {
	Common    = { luck = 0.03, income = 0.02 },
	Uncommon  = { luck = 0.05, income = 0.04 },
	Rare      = { luck = 0.08, income = 0.06 },
	Epic      = { luck = 0.12, income = 0.09 },
	Legendary = { luck = 0.18, income = 0.13 },
	Mythical  = { luck = 0.25, income = 0.18 },
	Secret    = { luck = 0.30, income = 0.22 },
	Divine    = { luck = 0.35, income = 0.25 },
}
Config.BaseRadius = 40
Config.MaxBases = 8
Config.OfflineCapSeconds = 2 * 3600
Config.OfflineRate = 0.25
Config.SellMultiplier = 25        -- sell price = income/sec * this
Config.DiscoveryBonus = 60        -- money bonus for a new index entry = income * this

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">CreatureAnimator</string><ProtectedString name="Source"><![CDATA[-- CreatureAnimator: procedural, layered animation for rigs from CreatureBuilder.
-- Location: ReplicatedStorage > Shared > CreatureAnimator (ModuleScript)
--
-- Layers (highest priority first):
--   1. lifecycle  : PlayAccent("enter" | "capture", dur) — owns pose; roaming, signatures and
--                   reactions are suppressed while it runs (renderer drives the root path).
--   2. reaction   : React(kind) — species pet/attention reaction (anticipation/action/recovery).
--   3. signature  : species signature idle every ~6-12 s (seeded per instance, never all at once).
--   4. locomotion : gait per species (hop / quad / biped / bug6 / fly / float / swim / slither / heavy / hover).
--   5. secondary  : breathing, blink, ear twitch, tail/chain follow-through, orbiting ornaments.
-- Poses are additive channels (see SpeciesProfiles header). Joints are rewritten every frame from
-- the stored bind transforms (entry.c0), so nothing accumulates drift.
--
-- TIME: Step(dt) advances the animation phase by the full elapsed dt (LOD-safe: a culled pet keeps
-- its phase), but movement is integrated in bounded substeps (<= 1/30 s, at most 0.5 s per call) so a
-- long pause never teleports or fast-forwards a pet. Timers (blink / signature) fire at most once per call.
--
-- Compatible API: new, Step, SetHome, MoveTo, Teleport, Jump, React, LookAt, SetScale, Destroy.
-- Added: PlayAccent(kind, dur), EndAccent(), onFx (callback(kind, anim) for local procedural effects).

local Profiles = require(script.Parent.SpeciesProfiles)

local Animator = {}
Animator.__index = Animator

local sin, cos, abs, clamp, exp = math.sin, math.cos, math.abs, math.clamp, math.exp
local TAU = math.pi * 2
local EMPTY = {}
local CHANNELS = { "bob", "tiltX", "tiltZ", "yaw", "roll", "spin", "crouch", "lean", "sqY", "headYaw", "headPitch", "headRoll",
	"armL", "armR", "armIn", "legFL", "legFR", "legBL", "legBR", "earL", "earR", "wingFold", "wingL", "wingR", "wingFlap",
	"tailCurl", "tailWag", "mouth", "jaw", "lid", "glow", "open", "chainCurl", "chainWave", "spread", "hide" }

local GAIT_SPEED = { hop = 6, quad = 5.5, biped = 4, bug6 = 4, fly = 8, float = 4, swim = 4, slither = 4.5, heavy = 3.5, hover = 4 }
local DEFAULT_GAIT = { hop = "hop", walk = "quad", fly = "fly", float = "float", slither = "slither" }

local instanceCounter = 0

local function scaledCF(cf, s)
	return CFrame.new(cf.Position * s) * cf.Rotation
end

local function springTo(cur, target, k, dt)
	return cur + (target - cur) * (1 - exp(-k * dt))
end

local function smooth(u)
	u = clamp(u, 0, 1)
	return u * u * (3 - 2 * u)
end

local function blendInto(pose, a, b, u, w)
	for ch, v in pairs(a) do pose[ch] = (pose[ch] or 0) + v * (1 - u) * w end
	for ch, v in pairs(b) do pose[ch] = (pose[ch] or 0) + v * u * w end
end

-- keyframes: { {t, pose}, ... } with implicit neutral start (and end unless hold)
local function evalKeys(keys, k, hold, pose, w)
	local prevT, prevP = 0, EMPTY
	for _, kf in ipairs(keys) do
		if k <= kf[1] then
			local span = kf[1] - prevT
			blendInto(pose, prevP, kf[2], span > 0 and smooth((k - prevT) / span) or 1, w)
			return
		end
		prevT, prevP = kf[1], kf[2]
	end
	if hold then
		blendInto(pose, prevP, EMPTY, 0, w)
	else
		local span = 1 - prevT
		blendInto(pose, prevP, EMPTY, span > 0 and smooth((k - prevT) / span) or 1, w)
	end
end
Animator.EvalKeys = evalKeys

function Animator.new(rig, startCFrame: CFrame?)
	local def = rig.def
	local prof = rig.profile or Profiles.Get(def.id)
	local self = setmetatable({}, Animator)
	instanceCounter += 1
	self.rig = rig
	self.def = def
	self.prof = prof
	-- stable per-instance seed: duplicates never blink / perform signatures in lockstep
	local seed = (instanceCounter * 7919 + #def.id * 104729) % 2147483647
	self.rng = Random.new(seed)
	self.seed = self.rng:NextNumber() * 100
	self.t = self.rng:NextNumber() * 10
	local cf = startCFrame or rig.root.CFrame
	self.pos = cf.Position
	local _, yaw = cf:ToEulerAnglesYXZ()
	self.yaw, self.targetYaw = yaw, yaw
	self.scale, self._appliedScale = 1, -1
	self.gait = prof.gait or DEFAULT_GAIT[def.move] or "quad"
	self.moveTarget, self.moveSpeed, self.speedNow = nil, GAIT_SPEED[self.gait] or 5, 0
	self.gaitPhase, self.hopPhase, self.hopWait = 0, 0, 0
	self.landSquash, self.lean = 0, 0
	self.blinkTimer = self.rng:NextNumber(1, 4)
	self.twitchT = self.rng:NextNumber(1, 4)
	self.sigTimer = self.rng:NextNumber(3, 12)
	self.look, self.lookAmt, self.lookYaw = nil, 0, 0
	self.home, self.homeRadius = nil, 10
	self.idleTimer = self.rng:NextNumber(1, 4)
	self.hover = prof.hover or ((def.move == "fly" and 2.6) or ((def.move == "float" or def.move == "slither") and 0.6) or 0)
	self.groundY = self.pos.Y
	self.pose = {}
	self.glowNow = 0
	self.hideNow = -1
	self.fragOffsets = {}
	for i = 1, 4 do
		self.fragOffsets[i] = Vector3.new(self.rng:NextNumber(-1, 1), self.rng:NextNumber(-0.5, 1), self.rng:NextNumber(-1, 1)) * rig.size * 0.6
	end
	self.onFx = nil
	return self
end

---------------------------------------------------------------- control API
function Animator:SetHome(center: Vector3, radius: number)
	self.home = center
	self.homeRadius = radius
	self.groundY = center.Y
end

function Animator:MoveTo(pos: Vector3, speed: number?)
	self.moveTarget = pos
	self.moveSpeed = speed or (GAIT_SPEED[self.gait] or 5)
end

function Animator:Teleport(cf: CFrame)
	self.pos = cf.Position
	self.groundY = cf.Position.Y
	local _, yaw = cf:ToEulerAnglesYXZ()
	self.yaw, self.targetYaw = yaw, yaw
end

function Animator:Jump()
	if not self.jumpT and not self.life then self.jumpT = 0 end
end

-- kind: "pet" / "happy" / nil -> species reaction; "spin" -> legacy spin
function Animator:React(kind: string?)
	if self.life then return false end
	kind = kind or "pet"
	if kind == "spin" and not self.prof.react then
		self.spinT = 0
		return true
	end
	if self.reactT then return false end
	if self.prof.react then
		self.reactT = 0
		self.reactFx = {}
		self.sigT = nil
	else
		self:Jump()
	end
	return true
end

function Animator:LookAt(pos: Vector3?)
	self.look = pos
end

function Animator:SetScale(s: number)
	self.scale = s
end

-- lifecycle accent ("enter" plays the species entrance pose, "capture" holds its capture pose)
function Animator:PlayAccent(kind: string, dur: number)
	local spec = (kind == "enter") and self.prof.enter or self.prof.capture
	self.life = { kind = kind, t = 0, dur = math.max(dur, 0.05), spec = spec or EMPTY, fired = {} }
	self.reactT, self.sigT, self.jumpT, self.spinT = nil, nil, nil, nil
	self.moveTarget = nil
end

function Animator:EndAccent()
	self.life = nil
end

---------------------------------------------------------------- internals
function Animator:_applyScale()
	local s = self.scale
	if abs(s - self._appliedScale) < 0.001 then return end
	self._appliedScale = s
	for _, e in ipairs(self.rig.all) do
		e.w.C0 = scaledCF(e.c0, s)
		e.w.C1 = scaledCF(e.c1, s)
		if e.mesh then e.mesh.Scale = Vector3.one * s end
		if e.baseSize then e.part.Size = e.baseSize * s end -- sculpted MeshParts scale by Size
	end
end

-- rotation applied in the joint's own frame
function Animator:_set(e, extra: CFrame)
	e.w.C0 = scaledCF(e.c0, self.scale) * extra
end

-- rotation applied in the parent's frame, about the joint position
function Animator:_setP(e, rot: CFrame)
	local c0 = e.c0
	e.w.C0 = CFrame.new(c0.Position * self.scale) * rot * c0.Rotation
end

function Animator:_fire(list, k, fired)
	if not list then return end
	for i, ev in ipairs(list) do
		if not fired[i] and k >= ev[1] then
			fired[i] = true
			if self.onFx then task.spawn(self.onFx, ev[2], self) end
		end
	end
end

function Animator:_brain(dt)
	if not self.home or self.moveTarget or self.life or self.reactT or self.sigT then return end
	self.idleTimer -= dt
	if self.idleTimer <= 0 then
		self.idleTimer = self.rng:NextNumber(3, 7.5)
		local a = self.rng:NextNumber() * TAU
		local r = self.rng:NextNumber() * self.homeRadius
		local run = self.rng:NextNumber() < 0.15
		self:MoveTo(self.home + Vector3.new(cos(a) * r, 0, sin(a) * r), run and (GAIT_SPEED[self.gait] or 5) * 1.7 or nil)
	end
end

function Animator:_integrate(h)
	local prof = self.prof
	local moving = false
	if self.moveTarget then
		local delta = (self.moveTarget - self.pos) * Vector3.new(1, 0, 1)
		local dist = delta.Magnitude
		if dist < 0.6 then
			self.moveTarget = nil
		else
			moving = true
			local dir = delta.Unit
			self.targetYaw = math.atan2(-dir.X, -dir.Z)
			local dy = (self.targetYaw - self.yaw + math.pi) % TAU - math.pi
			local step = math.min(dist, self.moveSpeed * h)
			-- walkers turn before / while launching instead of moonwalking
			step *= clamp(cos(dy), 0, 1) ^ 2
			if self.gait == "hop" then
				local ph = self.hopPhase % 1
				step = (ph > 0.15 and ph < 0.7 and self.hopWait <= 0) and step / 0.55 or 0
				if abs(dy) > 0.7 then step = 0 end
			end
			self.pos += dir * step
			local stride = (prof.stride or 1.2) * self.rig.size
			self.gaitPhase += step / stride
		end
	end
	self.moving = moving
	self.speedNow = springTo(self.speedNow, moving and self.moveSpeed or 0, 8, h)
	local dy = (self.targetYaw - self.yaw + math.pi) % TAU - math.pi
	local turnRate = (self.gait == "heavy") and 3 or 7
	self.yaw += dy * (1 - exp(-turnRate * h))
	self.lean = springTo(self.lean, clamp(dy * 1.5, -0.5, 0.5), 6, h)
	-- hop cycle: 15% anticipation, 10% takeoff, 45% arc, 15% land, 15% settle
	if self.gait == "hop" then
		if self.hopWait > 0 then
			self.hopWait -= h
		elseif moving or (self.hopPhase % 1) > 0.01 then
			local before = self.hopPhase % 1
			local period = 0.55 * (prof.lowGrav and 1.45 or 1) / math.max(0.6, (prof.hopK or 1) ^ 0.3)
			self.hopPhase += h / period
			local ph = self.hopPhase % 1
			if before < 0.7 and ph >= 0.7 then self.landSquash = 1 end
			if ph < before then -- cycle completed
				if not moving then self.hopPhase = math.floor(self.hopPhase) end
				if prof.hopPause then self.hopWait = prof.hopPause end
			end
		end
	end
	if self.landSquash > 0.001 then self.landSquash = springTo(self.landSquash, 0, 10, h) end
end

---------------------------------------------------------------- per-frame
function Animator:Step(dt: number)
	local rig = self.rig
	if not rig then return end
	dt = clamp(dt, 0, 5)
	self.t += dt
	local t = self.t
	local def, prof = self.def, self.prof
	self:_applyScale()

	-- timers (fire at most once per call, even after a long LOD pause)
	if not self.life then self:_brain(math.min(dt, 0.5)) end
	local remaining = math.min(dt, 0.5)
	while remaining > 1e-4 do
		local h = math.min(remaining, 1 / 30)
		self:_integrate(h)
		remaining -= h
	end

	local pose = self.pose
	for _, ch in ipairs(CHANNELS) do pose[ch] = 0 end
	local s = rig.size

	-------------------------------------------------- lifecycle / reaction / signature layers
	local life = self.life
	if life then
		life.t += dt
		local k = clamp(life.t / life.dur, 0, 1)
		local spec = life.spec
		if spec.keys then evalKeys(spec.keys, k, life.kind == "capture" or spec.hold, pose, 1) end
		self:_fire(spec.fx, k, life.fired)
	else
		if self.reactT then
			local r = prof.react
			self.reactT += dt
			local k = self.reactT / r.dur
			if k >= 1 then self.reactT = nil
			else
				evalKeys(r.keys, k, false, pose, 1)
				self:_fire(r.fx, k, self.reactFx)
			end
		end
		self.sigTimer -= dt
		if self.sigTimer <= 0 then
			if prof.sig and not self.moving and not self.reactT then
				self.sigT, self.sigFx = 0, {}
				self.sigTimer = self.rng:NextNumber(6, 12) + prof.sig.dur
			else
				self.sigTimer = self.rng:NextNumber(1.5, 3)
			end
		end
		if self.sigT then
			local sg = prof.sig
			self.sigT += dt
			local k = self.sigT / sg.dur
			if k >= 1 or self.moving then self.sigT = nil
			else
				evalKeys(sg.keys, k, false, pose, 1)
				self:_fire(sg.fx, k, self.sigFx)
			end
		end
	end

	-------------------------------------------------- locomotion
	local spd = clamp(self.speedNow / math.max(self.moveSpeed, 1), 0, 1.6)
	local gait = self.gait
	local gp = self.gaitPhase * TAU
	local legSwing = {}
	local tuck = 0
	local sqY = 1
	local hoverBob = 0
	if gait == "hop" then
		local ph = self.hopPhase % 1
		local hk = prof.hopK or 1
		if self.hopWait <= 0 and (self.moving or ph > 0.01) then
			if ph < 0.15 then
				sqY -= sin(ph / 0.15 * math.pi) * 0.1
				pose.tiltX += sin(ph / 0.15 * math.pi) * 0.12
			elseif ph < 0.7 then
				local u = (ph - 0.15) / 0.55
				-- bound height ~0.15-0.3 body heights (no giant generic happy hop)
				pose.bob += sin(u * math.pi) * 0.65 * hk * s * (prof.lowGrav and 1.4 or 1)
				sqY += sin(u * math.pi) * 0.08 - (u < 0.2 and 0 or 0)
				pose.tiltX += (0.5 - u) * -0.35
				tuck = sin(u * math.pi) * 0.6
				if prof.rollHop then pose.roll += sin(u * math.pi) * 0.45 end
			end
		end
	elseif gait == "quad" or gait == "heavy" or gait == "biped" or gait == "bug6" then
		local amp = (gait == "heavy" and 0.35 or (gait == "bug6" and 0.45 or 0.55)) * clamp(spd, 0, 1.3)
		local trot = spd > 1.1
		legSwing.amp = amp * (trot and 1.25 or 1)
		pose.bob += abs(sin(gp)) * (gait == "heavy" and 0.08 or 0.12) * s * clamp(spd, 0, 1)
		if gait == "heavy" then
			pose.tiltZ += sin(gp) * 0.05 * spd
			pose.yaw += sin(gp) * 0.06 * spd -- chest counter-rotation
		elseif gait == "biped" then
			pose.tiltZ += sin(gp) * 0.1 * spd -- waddle
		else
			pose.tiltX += 0.04 * spd
		end
	elseif gait == "fly" or gait == "hover" then
		hoverBob = sin(t * (gait == "hover" and 1.8 or 2.4) + self.seed) * 0.4 * s
		pose.tiltX += (gait == "hover" and 0.08 or 0.25) * spd
		pose.tiltZ += -self.lean * (gait == "hover" and 0.3 or 0.8)
		tuck = 0.6
	elseif gait == "float" or gait == "swim" then
		hoverBob = sin(t * TAU / 3 + self.seed) * 0.3 * s
		pose.tiltX += 0.12 * spd
		pose.tiltZ += -self.lean * 0.4
		if gait == "swim" then sqY += sin(t * 2.6 + self.seed) * 0.03 end
		if prof.airRun then legSwing.amp = 0.45 * clamp(spd, 0.2, 1); legSwing.air = true end
	elseif gait == "slither" then
		hoverBob = sin(t * 1.8 + self.seed) * 0.25 * s
		pose.tiltZ += -self.lean * 0.5
	end

	-- legacy jump / spin
	if self.jumpT then
		self.jumpT += dt
		local k = self.jumpT / 0.55
		if k >= 1 then self.jumpT = nil; self.landSquash = 1
		else pose.bob += sin(k * math.pi) * 1.6 * s; sqY += sin(k * math.pi) * 0.1 end
	end
	if self.spinT then
		self.spinT += dt
		local k = clamp(self.spinT / 0.7, 0, 1)
		pose.spin += (1 - (1 - k) ^ 3) * TAU
		if k >= 1 then self.spinT = nil end
	end

	-------------------------------------------------- secondary: breathing, landing squash
	local br = prof.breath or { 3, 0.02 }
	sqY *= 1 + sin(t * TAU / br[1] + self.seed) * br[2]
	sqY += pose.sqY
	pose.roll += self.rootRoll or 0 -- renderer-driven roll (e.g. rolling entrances)
	if self.landSquash > 0.001 then sqY *= 1 - self.landSquash * (gait == "heavy" and 0.04 or 0.18) end
	-- hard-surface style: body volumes stay constant (weight comes from joints and root motion)
	local sqk = (rig.style and rig.style.squash) or 1
	sqY = clamp(1 + (sqY - 1) * sqk, 0.6, 1.4)
	local sqXZ = 1 / math.sqrt(sqY)

	-------------------------------------------------- root + body
	local scale = self.scale
	local rootCF = CFrame.new(self.pos.X, self.groundY, self.pos.Z) * CFrame.Angles(0, self.yaw + pose.spin, 0)
	rig.root.CFrame = rootCF
	local be = rig.bodyEntry
	local headIsBody = (rig.head == rig.body) or not rig.headEntry
	local hb = 0
	if headIsBody then hb = 0.45 end
	local lookYaw, lookPitch = 0, 0
	if self.look then
		local lp = rootCF:PointToObjectSpace(self.look)
		local want = math.atan2(-lp.X, -lp.Z)
		if abs(want) < 2.2 then
			self.lookYaw = springTo(self.lookYaw, clamp(want, -0.7, 0.7), 6, dt)
			self.lookAmt = springTo(self.lookAmt, 1, 5, dt)
			lookPitch = clamp(math.atan2(lp.Y - 2 * s, math.sqrt(lp.X * lp.X + lp.Z * lp.Z)), -0.35, 0.35)
		else
			self.lookAmt = springTo(self.lookAmt, 0, 3, dt)
		end
	else
		self.lookAmt = springTo(self.lookAmt, 0, 3, dt)
	end
	if self.life then self.lookAmt = 0 end
	lookYaw = self.lookYaw * self.lookAmt
	lookPitch *= self.lookAmt
	if be then
		local y = (self.hover + hoverBob + pose.bob - pose.crouch * s) * scale
		local bodyRot = CFrame.Angles(-(pose.tiltX + pose.roll) + (headIsBody and -(pose.headPitch * hb) or 0),
			pose.yaw + (headIsBody and (pose.headYaw + lookYaw) * hb or 0),
			pose.tiltZ + (headIsBody and pose.headRoll * hb or 0))
		self:_set(be, CFrame.new(0, y, -pose.lean * s * scale) * bodyRot)
		if be.mesh then be.mesh.Scale = Vector3.new(sqXZ, sqY, sqXZ) * scale end
	end

	-------------------------------------------------- head(s)
	local headPitch = pose.headPitch - lookPitch
	if rig.headEntry and not headIsBody then
		local heads = rig.groups.heads
		if heads and #heads > 1 then
			for i, he in ipairs(heads) do
				local gaze = sin(t * 0.45 + i * 2.1 + self.seed) * 0.35 * (1 - self.lookAmt)
				self:_set(he, CFrame.Angles(-headPitch * 0.8, pose.headYaw * 0.5 + lookYaw + gaze, pose.headRoll + (i - 2) * 0.1 * pose.spread))
			end
		else
			self:_set(rig.headEntry, CFrame.Angles(-headPitch + sin(t * 2.2 + self.seed) * 0.02, pose.headYaw + lookYaw, pose.headRoll))
		end
	end
	for _, jaw in ipairs(rig.groups.jaws or EMPTY) do
		self:_set(jaw, CFrame.Angles(-(pose.jaw + pose.mouth * 0.25), 0, 0))
	end

	-------------------------------------------------- eyes: blink + pupils
	self.blinkTimer -= dt
	if self.blinkTimer <= 0 then
		self.blinkT = 0
		local bl = prof.blink or { 2.5, 6 }
		self.blinkTimer = self.rng:NextNumber(bl[1], bl[2])
		if self.rng:NextNumber() < 0.15 then self.blinkTimer = 0.3 end
	end
	local lid = pose.lid
	if self.blinkT then
		self.blinkT += dt
		local k = self.blinkT / 0.15
		if k >= 1 then self.blinkT = nil else lid = math.max(lid, sin(k * math.pi)) end
	end
	local eyeY = clamp(1 - lid * 0.94, 0.06, 1.3)
	for _, e in ipairs(rig.eyes) do
		if e.mesh then e.mesh.Scale = Vector3.new(1, eyeY, 1) * scale end
	end
	local px, py = sin(t * 0.37 + self.seed) * 0.05, sin(t * 0.23) * 0.03
	if self.lookAmt > 0.1 then px = clamp(-lookYaw * 0.15, -0.1, 0.1) end
	for _, e in ipairs(rig.pupils) do
		self:_set(e, CFrame.new(px * scale, py * scale, 0))
	end
	for _, m in ipairs(rig.mouths) do
		if m.mesh then m.mesh.Scale = Vector3.new(1 + pose.mouth * 0.2, 1 + pose.mouth * 2.2, 1) * scale end
	end

	-------------------------------------------------- ears / antennae
	self.twitchT -= dt
	local twitch = 0
	if self.twitchT < 0 then
		if self.twitchT < -0.25 then self.twitchT = self.rng:NextNumber(1.5, 4.5) end
		twitch = sin((-self.twitchT) / 0.25 * math.pi) * 0.3
	end
	for i, ear in ipairs(rig.ears) do
		local fold = ear.side < 0 and pose.earL or pose.earR
		local lag = -clamp(pose.bob, -1, 1) * 0.25 + sin(gp) * 0.1 * spd
		local a = sin(t * 2 + i) * 0.05 + (i == 1 and twitch or 0)
		self:_set(ear.e, CFrame.Angles(fold + lag, 0, -ear.side * a))
	end

	-------------------------------------------------- wings / fins
	local fl = prof.flap
	local flapRate, flapAmp = 3, 0.1
	if gait == "fly" then flapRate, flapAmp = (fl and fl[1] or 10) * (1 + spd * 0.3), fl and fl[2] or 0.6
	elseif gait == "hover" then flapRate, flapAmp = fl and fl[1] or 16, fl and fl[2] or 0.45
	elseif gait == "swim" or rig.legKind == "none" then flapRate, flapAmp = 4, 0.3 end
	-- glide: periodically hold wings out instead of flapping symmetrically forever
	if gait == "fly" and sin(t * 0.35 + self.seed) > 0.55 then flapAmp *= 0.15 end
	flapAmp *= clamp(1 + pose.wingFlap, 0, 2) * (1 - pose.wingFold)
	local x = (t * flapRate / TAU) % 1
	-- strong downstroke (40%), softer recovery (60%)
	local f = x < 0.4 and (1 - 2 * smooth(x / 0.4)) or (-1 + 2 * smooth((x - 0.4) / 0.6))
	for _, w in ipairs(rig.wings) do
		local raise = w.side < 0 and pose.wingL or pose.wingR
		local tierLag = (w.tier == 2) and 0.7 or 1
		self:_set(w.e, CFrame.Angles(0, w.side * pose.wingFold * 1.0, w.side * (f * flapAmp * tierLag + raise - pose.wingFold * 0.35)))
	end

	-------------------------------------------------- generic tail with follow-through
	local wag = (pose.tailWag > 0 or self.reactT) and 12 or (3 + spd * 4)
	local wagAmp = 0.22 + pose.tailWag * 0.35
	for i, e in ipairs(rig.tail) do
		local ph = t * wag - i * 0.6
		self:_set(e, CFrame.Angles(sin(ph * 0.5) * 0.06 - pose.tailCurl * 0.3, sin(ph) * (wagAmp + i * 0.03), 0))
	end

	-------------------------------------------------- legs / feet
	local legs = rig.feet
	local lk = rig.legKind
	local legCh = { pose.legFL, pose.legFR, pose.legBL, pose.legBR }
	for i, e in ipairs(legs) do
		local phase = 0
		if lk == "quad" then
			phase = (i == 1 or i == 4) and 0 or math.pi -- diagonal pairs
		elseif lk == "bug6" then
			phase = (i == 1 or i == 4 or i == 5) and 0 or math.pi -- alternating tripods
		else
			phase = (i % 2 == 0) and math.pi or 0
		end
		local swing = legSwing.amp and sin(gp + phase) * legSwing.amp or 0
		if legSwing.air then swing = sin(t * 4 + phase) * legSwing.amp end
		local lift = 0
		if lk == "bug6" then
			lift = (i <= 2) and (i == 1 and pose.legFL or pose.legFR) or 0
			self:_setP(e, CFrame.Angles(0, swing, 0) * CFrame.Angles(-lift * 0.6, 0, 0))
		else
			lift = (lk == "quad" and legCh[i]) or (i == 1 and pose.legFL) or (i == 2 and pose.legFR) or 0
			local hipExtra = 0
			if e.knee then
				-- two-bone leg: on a crouch the upper leg folds back by a while the knee turns forward by a,
				-- so the shin stays upright, the paw stays flat and the body drops d = upperLen(1 - cos a);
				-- the knee also flexes while the foot swings forward
				local dir = e.kneeDir or 1
				local a = math.acos(clamp(1 - math.max(pose.crouch, 0) * s / (e.upperLen or s), -1, 1))
				local flex = math.max(0, -math.cos(gp + phase)) * 0.55 * clamp(spd, 0, 1)
				hipExtra = -a * dir
				self:_set(e.knee, CFrame.Angles((a + flex) * dir, 0, 0))
			end
			self:_setP(e, CFrame.Angles(-swing - lift + hipExtra + tuck * (lk == "quad" and (i <= 2 and -0.4 or 0.4) or 0.6), 0, 0))
		end
	end

	-------------------------------------------------- arms
	for _, arm in ipairs(rig.arms) do
		local raise = arm.side < 0 and pose.armL or pose.armR
		local swing = sin(gp + (arm.side > 0 and math.pi or 0)) * 0.3 * clamp(spd, 0, 1) + sin(t * 2 + arm.side) * 0.05
		self:_set(arm.e, CFrame.Angles(swing - pose.armIn * 0.5, arm.side * pose.armIn * 0.5, -arm.side * raise * 1.4))
	end

	-------------------------------------------------- chains (tails, tentacles, necks, spines, streamers)
	local moveK = clamp(spd, 0, 1)
	for _, ch in ipairs(rig.chains) do
		local kind, n = ch.kind, ch.n
		local amp = (ch.amp or 0.2) * (1 + pose.chainWave)
		local freq, lag, ci = ch.freq or 1.5, ch.lag or 0.6, ch.i or 1
		for j, e in ipairs(ch.entries) do
			local u = j / n
			local pitch, yawA, roll = 0, 0, 0
			if kind == "fan" then
				local wv = sin(t * freq - j * lag - ci * 0.45) * amp * (0.4 + u)
				if j == 1 then yawA = (ch.baseYaw or 0) * (1 + pose.spread * 0.6) end
				yawA += wv * 0.6 + pose.chainWave * sin(t * 3 - ci * 0.6 - j * 0.4) * 0.12
				pitch = sin(t * freq * 0.7 - j * lag + ci) * amp * 0.4 - pose.tailCurl * 0.2 + self.lean * 0.1
			elseif kind == "tentacle" then
				pitch = sin(t * freq - j * lag + ci * 0.8) * amp * (0.4 + u) - pose.chainCurl * 0.35 + moveK * 0.15
				yawA = sin(t * freq * 0.6 - j * lag + ci) * amp * 0.4 + pose.open * 0.25 * ((j == 1) and 1 or 0)
			elseif kind == "neck" then
				local side = ch.side or 0
				if j == 1 then yawA = side * pose.spread * 0.35 end
				pitch = sin(t * freq + ci * 1.7 + j * 0.4) * amp * 0.5 + pose.chainCurl * 0.15
				roll = sin(t * freq * 0.8 + ci * 2.3) * amp * 0.6 * (1 + pose.chainWave)
			elseif kind == "spine" then
				local f2 = freq * (1 + moveK * 0.8)
				yawA = sin(t * f2 - j * lag) * amp * (0.3 + u) + pose.chainCurl * 0.42
				pitch = sin(t * f2 * 0.5 - j * lag) * 0.05
			elseif kind == "fluke" then
				pitch = sin(t * freq * (1 + moveK) - j * lag) * amp * (0.5 + u)
			elseif kind == "plume" then
				pitch = -(ch.curl or 0.4) + sin(t * freq - j * lag) * amp * 0.5 - pose.tailCurl * 0.2
				yawA = sin(t * freq * 0.5 - j * lag) * amp * 0.3
			elseif kind == "echo" then
				yawA = sin((t - 0.25) * freq - j * lag) * amp * (0.4 + u) + pose.open * 0.2
				pitch = -0.3 * ((j == 1) and 1 or 0) - pose.tailCurl * 0.2
			else -- trail (streamers, tendrils, ribbons)
				pitch = sin(t * freq - j * lag + ci) * amp * (0.3 + u) + moveK * 0.2 * u - pose.chainCurl * 0.4
				yawA = sin(t * freq * 0.7 - j * lag + ci * 1.3) * amp * 0.5
			end
			self:_set(e, CFrame.Angles(pitch, yawA, roll))
		end
	end

	-------------------------------------------------- groups
	local g = rig.groups
	local open = pose.open
	for _, e in ipairs(g.open or EMPTY) do
		self:_set(e, CFrame.fromAxisAngle(e.openAxis, open * e.openAmt))
	end
	for _, e in ipairs(g.flutter or EMPTY) do
		self:_set(e, CFrame.Angles(sin(t * 2.4 + e.c0.Position.X) * 0.12 + moveK * 0.25, 0, sin(t * 1.7) * 0.08))
	end
	for i, e in ipairs(g.scarfEnds or EMPTY) do
		if not (g.flutter and table.find(g.flutter, e)) then
			self:_set(e, CFrame.Angles(sin(t * 3 + i) * 0.15 + moveK * 0.3, 0, 0))
		end
	end
	for _, e in ipairs(g.motifOrbit or EMPTY) do self:_set(e, CFrame.Angles(0, t * 0.6, 0)) end
	for i, e in ipairs(g.motifs or EMPTY) do self:_set(e, CFrame.new(0, sin(t * 1.3 + i) * 0.25 * s, 0) * CFrame.Angles(0, t * 1.2, sin(t + i) * 0.3)) end
	local orbitR = 1 + pose.spread * 0.35
	for i, e in ipairs(g.ornamentOrbit or EMPTY) do
		local c0 = e.c0
		e.w.C0 = CFrame.new(c0.Position * scale) * CFrame.Angles(0, t * 0.7 + i, 0) * CFrame.new()
		for _, o in ipairs(g.ornaments or EMPTY) do
			local p0 = o.c0.Position
			o.w.C0 = CFrame.new(p0 * orbitR * scale + Vector3.new(0, sin(t * 1.5 + p0.X) * 0.2 * s, 0)) * CFrame.Angles(0, t, 0)
		end
	end
	for i, e in ipairs(g.orbit or EMPTY) do self:_set(e, CFrame.Angles(0, t * 0.5 * (i % 2 == 0 and -1 or 1), 0)) end
	for _, e in ipairs(g.rays or EMPTY) do self:_set(e, CFrame.Angles(0, 0, t * 0.25)) end
	for _, e in ipairs(g.rings or EMPTY) do self:_set(e, CFrame.Angles(0, t * 0.3, sin(t * 0.4) * 0.08)) end
	for _, e in ipairs(g.clockRings or EMPTY) do
		local stepT = math.floor(t * 1.0) + smooth((t % 1) / 0.25)
		self:_set(e, CFrame.Angles(0, stepT * (e.stepRate or 0.2), 0))
	end
	for _, e in ipairs(g.palmCrystal or EMPTY) do self:_set(e, CFrame.Angles(0, t * 1.5, 0)) end
	for _, e in ipairs(g.lag or EMPTY) do
		self.lagX = springTo(self.lagX or 0, -pose.tiltZ * 0.5, 4, dt)
		self.lagY = springTo(self.lagY or 0, -(pose.bob + hoverBob) * 0.25, 4, dt)
		self:_set(e, CFrame.new(self.lagX * s * scale, self.lagY * scale, 0) * CFrame.Angles(0, t * 0.8, 0))
	end
	for i, e in ipairs(g.fragments or EMPTY) do
		local off = self.fragOffsets[(e.fragIndex or i) % 4 + 1] * open
		self:_set(e, CFrame.new(off * scale) * CFrame.Angles(t * 0.5, t * 0.7, 0))
	end
	for _, e in ipairs(g.abdomen or EMPTY) do
		self:_set(e, CFrame.Angles(pose.tiltX * 0.4 + sin(t * 1.2 + self.seed) * 0.04, -self.lean * 0.3, 0))
	end
	for _, e in ipairs(rig.halos) do
		self:_set(e, CFrame.new(0, sin(t * 1.6) * 0.1 * scale, 0) * CFrame.Angles(0, t * 0.6, 0))
	end
	for _, e in ipairs(rig.bobbers) do
		self:_set(e, CFrame.Angles(sin(t * 3) * 0.15 - clamp(pose.bob, -1, 1) * 0.2, 0, sin(t * 2.3) * 0.2))
	end

	-------------------------------------------------- glow + reveal
	local glowT = clamp(pose.glow, -1, 1)
	if abs(glowT - self.glowNow) > 0.02 then
		self.glowNow = glowT
		local gk = clamp(glowT, 0, 1) * 0.6
		for _, gl in ipairs(rig.glows or EMPTY) do
			gl.part.Color = gl.base:Lerp(gl.bright, gk)
		end
		if rig.light then rig.light.Brightness = (rig.light:GetAttribute("Base") or rig.light.Brightness) * (1 + gk) end
	end
	if rig.reveal then
		local hide = clamp(pose.hide, 0, 1)
		if abs(hide - self.hideNow) > 0.01 then
			self.hideNow = hide
			local units = rig.reveal
			local n = #units
			for i, parts in ipairs(units) do
				-- units appear in order as hide goes 1 -> 0
				local vis = clamp((1 - hide) * n - (i - 1), 0, 1)
				for _, p in ipairs(parts) do p.LocalTransparencyModifier = 1 - vis end
			end
		end
	end
end

function Animator:Destroy()
	self.onFx = nil
	self.rig = nil
end

return Animator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">CreatureBuilder</string><ProtectedString name="Source"><![CDATA[-- CreatureBuilder: builds a rigged, procedural creature from CreatureData + SpeciesProfiles.
-- Location: ReplicatedStorage > Shared > CreatureBuilder (ModuleScript)
--
-- Every visible piece is a Part + SpecialMesh (Sphere / Cylinder / Brick / Wedge) joined with
-- Welds, so CreatureAnimator can bend joints by rewriting Weld.C0 from stored bind transforms
-- (no animation assets, no drift). Species anatomy (nine tails, hydra necks, kraken tentacles,
-- wyvern legs, ...) lives in SpeciesAnatomy and is selected by SpeciesProfiles.
--
-- PUBLIC CONTRACT (unchanged): Builder.Build(id, sizeMult) -> model, rig
--   model.PrimaryPart = hidden anchored "Root" at ground level, front = local -Z.
--
-- RIG FIELDS
--   model, root, def (original CreatureData entry, never mutated), vd (visual view: def + overrides),
--   profile (SpeciesProfiles entry), size (s), pal {p,s,a}
--   all      : every weld entry { w, c0, c1, mesh, part, scale? }       (bind transforms)
--   body, head, bodyRadius, headRadius, bodyEntry, headEntry
--   eyes, pupils, lids?, mouths (mouth = mouths[1]), ears {e, side}, wings {e, side, tier}
--   tail (generic tail entries), feet (ordered: FL, FR, BL, BR / bug: 6 / biped: L, R),
--   arms {e, side}, halos, bobbers, emitters, light?
--   chains   : array of { name, kind, entries = {...}, i, n, side, amp, freq, lag, axis, spread }
--   groups   : name -> array of entries (spines, plates, mane, rays, motifs, fragments, heads, ...)
--   core     : optional glowing core entry
--   legKind  : "quad" | "biped" | "bug6" | "none"

local Config = require(script.Parent.Config)
local CreatureData = require(script.Parent.CreatureData)
local Profiles = require(script.Parent.SpeciesProfiles)

local Builder = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function hex(h) return Color3.fromHex(h) end
local function lighten(c, k) return c:Lerp(Color3.new(1, 1, 1), k) end
local function darken(c, k) return c:Lerp(Color3.new(0, 0, 0), k) end
local PINK = Color3.fromRGB(255, 140, 170)
local DARK = Color3.fromRGB(30, 22, 35)
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 205, 60)
local PI = math.pi

-- SHARED STYLE TABLE (current art direction: hard-surface BLOCKY family)
--   blocky  : structural pieces are cuboids (Brick meshes) instead of ellipsoids; faces are flat plates
--   squash  : 0 = body volumes never squash/stretch (weight comes from joints + root motion)
--   eyeW/eyeH: narrow rectangular eye aperture (fraction of the round-style eye)
-- Set blocky = false to get the previous rounded construction back (same rigs and channels).
local STYLE = { blocky = true, squash = 0, eyeW = 0.95, eyeH = 0.4, recess = 0.06 }
Builder.Style = STYLE

---------------------------------------------------------------------
-- low-level part helpers (exported as Builder.H for SpeciesAnatomy)
---------------------------------------------------------------------
local function newPiece(rig, name, size, color, mat, meshType, transparency)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = Vector3.new(math.max(size.X, 0.02), math.max(size.Y, 0.02), math.max(size.Z, 0.02))
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = size.Magnitude > 1.2 and (transparency or 0) < 0.5
	local m = Instance.new("SpecialMesh")
	m.MeshType = meshType or Enum.MeshType.Sphere
	m.Parent = p
	p.Parent = rig.model
	return p, m
end

-- attach `part` to `parent`; C0 = pivot on parent, C1 = pivot inside part
local function attach(rig, parent, part, mesh, c0, c1)
	local w = Instance.new("Weld")
	w.Part0 = parent
	w.Part1 = part
	w.C0 = c0
	w.C1 = c1 or CFrame.identity
	w.Parent = part
	local entry = { w = w, c0 = c0, c1 = w.C1, mesh = mesh, part = part }
	table.insert(rig.all, entry)
	return entry
end

local function piece(meshType)
	return function(rig, parent, name, size, color, cf, mat, transp, c1)
		local p, m = newPiece(rig, name, size, color, mat, meshType, transp)
		return attach(rig, parent, p, m, cf, c1), p
	end
end
local ell = piece(STYLE.blocky and Enum.MeshType.Brick or Enum.MeshType.Sphere) -- structural form
local orb = piece(Enum.MeshType.Sphere) -- intentionally round pieces (cores, motes, bubbles)
local cyl = piece(Enum.MeshType.Cylinder)
local blk = piece(Enum.MeshType.Brick)
local wdg = piece(Enum.MeshType.Wedge)

-- invisible joint used to animate a cluster of welded pieces together
local function pivot(rig, parent, name, cf)
	local p, m = newPiece(rig, name, Vector3.new(0.05, 0.05, 0.05), WHITE, nil, Enum.MeshType.Sphere, 1)
	p.CastShadow = false
	return attach(rig, parent, p, m, cf), p
end

-- straight rod along local +Y of cf (SpecialMesh cylinders run along X, so wrap it in a pivot).
-- Returns the pivot entry: animate it, and parent children to entry.part in Y-up space.
local function rod(rig, parent, name, len, thick, color, cf, mat, tr)
	local pv = pivot(rig, parent, name .. "Pivot", cf)
	cyl(rig, pv.part, name, Vector3.new(len, thick, thick), color, CFrame.new(0, len / 2, 0) * CFrame.Angles(0, 0, PI / 2), mat, tr)
	return pv
end

-- triangular plate: plane YZ (thickness along X), apex +Y, base width along Z, centred on cf
local function tri(rig, parent, name, thick, h, base, color, cf, mat, tr)
	wdg(rig, parent, name, Vector3.new(thick, h, base / 2), color, cf * CFrame.new(0, 0, -base / 4), mat, tr)
	wdg(rig, parent, name, Vector3.new(thick, h, base / 2), color, cf * CFrame.new(0, 0, base / 4) * CFrame.Angles(0, PI, 0), mat, tr)
end

-- faceted rhombus: plane XY (faces -Z), long axis Y, centred on cf
local function diamond(rig, parent, name, len, width, thick, color, cf, mat, tr)
	local R = cf * CFrame.Angles(0, PI / 2, 0)
	tri(rig, parent, name, thick, len / 2, width, color, R * CFrame.new(0, len / 4, 0), mat, tr)
	tri(rig, parent, name, thick, len / 2, width, color, R * CFrame.new(0, -len / 4, 0) * CFrame.Angles(0, 0, PI), mat, tr)
end

-- faceted spike (crossed triangles), base at cf, pointing +Y
local function spike(rig, parent, name, len, base, color, cf, mat, tr)
	tri(rig, parent, name, base * 0.35, len, base, color, cf * CFrame.new(0, len / 2, 0), mat, tr)
	tri(rig, parent, name, base * 0.35, len, base, color, cf * CFrame.new(0, len / 2, 0) * CFrame.Angles(0, PI / 2, 0), mat, tr)
end

-- faceted crystal: square prism + pyramid cap, base at cf, pointing +Y
local function crystal(rig, parent, name, len, w, color, cf, mat, tr)
	local body = len * 0.62
	blk(rig, parent, name, Vector3.new(w, body, w), color, cf * CFrame.new(0, body / 2, 0) * CFrame.Angles(0, PI / 4, 0), mat, tr)
	local capCF = cf * CFrame.new(0, body + len * 0.19, 0)
	tri(rig, parent, name, w * 0.98, len * 0.38, w * 1.41, color, capCF * CFrame.Angles(0, PI / 4, 0), mat, tr)
	tri(rig, parent, name, w * 0.98, len * 0.38, w * 1.41, lighten(color, 0.15), capCF * CFrame.Angles(0, -PI / 4, 0), mat, tr)
end

-- ordered chain of segments; seg(j, n) -> size, color, mat, transparency, c0 (for j > 1)
-- first segment welds to `parent` at `c0first`. Returns the chain record (registered).
local function chain(rig, parent, name, c0first, n, seg, meta)
	local rec = { name = name, entries = {}, parts = {} }
	for k, v in pairs(meta or {}) do rec[k] = v end
	local prev = parent
	for j = 1, n do
		local size, color, mat, tr, c0, c1, meshType = seg(j, n)
		local p, m = newPiece(rig, name, size, color, mat, meshType or Enum.MeshType.Sphere, tr)
		local e = attach(rig, prev, p, m, j == 1 and c0first or c0, c1)
		table.insert(rec.entries, e)
		table.insert(rec.parts, p)
		prev = p
	end
	rec.n = n
	table.insert(rig.chains, rec)
	return rec
end

local function group(rig, name, entry)
	rig.groups[name] = rig.groups[name] or {}
	table.insert(rig.groups[name], entry)
	return entry
end

-- point on the body surface (front = -Z) + orientation facing outwards.
-- Blocky style: the flat face of the cuboid (side = -1 -> back face).
local function surface(r, x, y, side)
	local a, b, c = r.X, r.Y, r.Z
	if STYLE.blocky then
		local sd = side or 1
		local pos = Vector3.new(math.clamp(x, -a * 0.92, a * 0.92), math.clamp(y, -b * 0.92, b * 0.92), -c * sd)
		return CFrame.lookAt(pos, pos + Vector3.new(0, 0, -sd))
	end
	local k = 1 - (x / a) ^ 2 - (y / b) ^ 2
	local z = -c * math.sqrt(math.max(0.04, k)) * (side or 1)
	local pos = Vector3.new(x, y, z)
	local n = Vector3.new(x / (a * a), y / (b * b), z / (c * c)).Unit
	return CFrame.lookAt(pos, pos + n)
end

local function matOf(name)
	if not name then return Enum.Material.SmoothPlastic end
	return Enum.Material[name] or Enum.Material.SmoothPlastic
end

local H = {
	newPiece = newPiece, attach = attach, ell = ell, orb = orb, cyl = cyl, blk = blk, wdg = wdg, pivot = pivot, rod = rod, STYLE = STYLE,
	tri = tri, diamond = diamond, spike = spike, crystal = crystal, chain = chain, group = group,
	surface = surface, matOf = matOf, lighten = lighten, darken = darken,
	PINK = PINK, DARK = DARK, WHITE = WHITE, GOLD = GOLD,
}
Builder.H = H

---------------------------------------------------------------------
-- FACE
---------------------------------------------------------------------
local function buildEye(rig, head, r, x, y, w, h, def, accent, flip)
	local cf = surface(r, x, y)
	local style = def.eyes
	if STYLE.blocky then
		-- recessed narrow rectangular eye: dark socket + luminous slit (same vocabulary for every pet)
		local ew, eh = w * STYLE.eyeW, h * STYLE.eyeH * ((style == "sleepy") and 0.45 or (style == "cyclops" and 1.25 or 1))
		local glowCol = accent
		local lum = accent.R * 0.3 + accent.G * 0.59 + accent.B * 0.11
		if lum < 0.45 then glowCol = lighten(accent, 0.45) end
		if style == "glow" or style == "cyclops" then glowCol = lighten(glowCol, 0.15) end
		if accent.R + accent.G + accent.B < 0.2 then glowCol = Color3.fromRGB(255, 60, 80) end
		blk(rig, head, "EyeSocket", Vector3.new(ew * 1.25, eh * 1.6, 0.1), DARK, cf * CFrame.new(0, 0, STYLE.recess))
		local tilt = (style == "fierce") and math.rad(-14 * flip) or 0
		local e = blk(rig, head, "Eye", Vector3.new(ew, eh, 0.12), glowCol, cf * CFrame.Angles(0, 0, tilt), Enum.Material.Neon)
		if style == "sleepy" then e.sleepy = true end
		table.insert(rig.eyes, e)
		local pupil = blk(rig, e.part, "Pupil", Vector3.new(ew * 0.28, eh * 0.9, 0.06), DARK, CFrame.new(0, 0, -0.04))
		table.insert(rig.pupils, pupil)
		if style == "fierce" then
			local brow = blk(rig, head, "Brow", Vector3.new(ew * 1.4, eh * 0.55, 0.16), darken(def._p, 0.45),
				cf * CFrame.new(0, eh * 1.3, -0.02) * CFrame.Angles(0, 0, math.rad(-18 * flip)))
			group(rig, "brows", brow)
		end
		return
	end
	if style == "sleepy" then
		local e = ell(rig, head, "Eye", Vector3.new(w, h * 0.22, 0.12), DARK, cf * CFrame.new(0, 0, -0.02))
		e.sleepy = true
		table.insert(rig.eyes, e)
		return
	end
	local scleraColor = WHITE
	local mat = Enum.Material.SmoothPlastic
	if style == "glow" then scleraColor = lighten(accent, 0.35); mat = Enum.Material.Neon end
	local e, eyePart = ell(rig, head, "Eye", Vector3.new(w, h, 0.18), scleraColor, cf, mat)
	table.insert(rig.eyes, e)
	-- soft rim so dark-on-dark faces stay readable
	ell(rig, head, "EyeRim", Vector3.new(w * 1.14, h * 1.12, 0.12), darken(def._p, 0.35), cf * CFrame.new(0, 0, 0.03))
	if style ~= "glow" then
		local irisColor = (style == "sparkle" or style == "fierce" or style == "cyclops") and accent or DARK
		local iris = ell(rig, eyePart, "Pupil", Vector3.new(w * 0.72, h * 0.74, 0.1), irisColor, CFrame.new(0, -h * 0.04, -0.06))
		table.insert(rig.pupils, iris)
		if style ~= "big" then
			ell(rig, iris.part, "PupilCore", Vector3.new(w * 0.38, h * 0.42, 0.06), DARK, CFrame.new(0, 0, -0.03))
		end
		ell(rig, iris.part, "Shine", Vector3.new(w * 0.28, h * 0.26, 0.04), WHITE, CFrame.new(-w * 0.14 * flip, h * 0.16, -0.06), Enum.Material.Neon)
		ell(rig, iris.part, "Shine2", Vector3.new(w * 0.13, h * 0.12, 0.04), WHITE, CFrame.new(w * 0.14 * flip, -h * 0.16, -0.06), Enum.Material.Neon)
	else
		ell(rig, eyePart, "Shine", Vector3.new(w * 0.3, h * 0.3, 0.05), WHITE, CFrame.new(-w * 0.15 * flip, h * 0.15, -0.07), Enum.Material.Neon)
	end
	if style == "fierce" then
		local brow = ell(rig, head, "Brow", Vector3.new(w * 1.1, h * 0.16, 0.12), darken(def._p, 0.55),
			surface(r, x, y + h * 0.62) * CFrame.Angles(0, 0, math.rad(-18 * flip)))
		group(rig, "brows", brow)
	end
end

local function buildFace(rig, head, r, def, yOff, scaleK, opts)
	opts = opts or {}
	local accent = def._a
	scaleK = scaleK or 1
	local w, h = r.X * 0.42 * scaleK, r.Y * 0.5 * scaleK
	if def.eyes == "cyclops" then
		buildEye(rig, head, r, 0, yOff + r.Y * 0.05, w * 1.6, h * 1.5, def, accent, 1)
	else
		local sx = r.X * (opts.eyeSpread or 0.36)
		buildEye(rig, head, r, -sx, yOff, w, h, def, accent, 1)
		buildEye(rig, head, r, sx, yOff, w, h, def, accent, -1)
		if def.eyes ~= "fierce" and not opts.noCheeks and not STYLE.blocky then
			for _, side in ipairs({ -1, 1 }) do
				local ch = ell(rig, head, "Cheek", Vector3.new(r.X * 0.3, r.Y * 0.16, 0.08), PINK,
					surface(r, side * r.X * 0.58, yOff - r.Y * 0.32) * CFrame.new(0, 0, -0.01), nil, 0.35)
				group(rig, "cheeks", ch)
			end
		end
	end
	if STYLE.blocky and not opts.noMouth then
		-- angular face plate (muzzle) under the eyes, in the secondary colour
		blk(rig, head, "FacePlate", Vector3.new(r.X * 1.1, r.Y * 0.55, 0.14), def._s, surface(r, 0, yOff - r.Y * 0.42) * CFrame.new(0, 0, -0.02))
	end
	if not opts.noMouth then
		local m1 = ell(rig, head, "Mouth", Vector3.new(r.X * 0.24, r.Y * 0.06, 0.07), DARK, surface(r, 0, yOff - r.Y * (opts.mouthY or 0.42)) * CFrame.new(0, 0, -0.1))
		table.insert(rig.mouths, m1)
		rig.mouth = rig.mouth or m1
	end
	if table.find(def.extra, "eyepatch") then
		local patch = ell(rig, head, "Patch", Vector3.new(w * 1.25, h * 1.2, 0.2), DARK, surface(r, r.X * 0.36, yOff) * CFrame.new(0, 0, -0.08))
		ell(rig, head, "PatchStrap", Vector3.new(r.X * 0.9, r.Y * 0.08, 0.1), DARK, surface(r, -r.X * 0.2, yOff + r.Y * 0.32) * CFrame.Angles(0, 0, -0.35))
		group(rig, "patch", patch)
	end
end

---------------------------------------------------------------------
-- EARS / HORNS
---------------------------------------------------------------------
local function buildEars(rig, head, r, def, prof)
	local kind = def.ears
	if kind == "none" then return end
	local p, a = def._p, def._a
	local earK = (prof.ear and prof.ear.len) or 1
	if STYLE.blocky and not (prof.ear and prof.ear.inner) then
		prof = setmetatable({ ear = { len = earK, inner = lighten(def._s, 0.05) } }, { __index = prof })
	end
	for _, side in ipairs({ -1, 1 }) do
		local e
		if kind == "round" then
			local sz = r.X * 0.55 * earK
			e = ell(rig, head, "Ear", Vector3.new(sz, sz, r.X * 0.22), p,
				CFrame.new(side * r.X * 0.62, r.Y * 0.72, 0.1) * CFrame.Angles(0, 0, -side * 0.35), nil, nil, CFrame.new(0, -sz * 0.36, 0))
			ell(rig, e.part, "EarInner", Vector3.new(sz * 0.62, sz * 0.62, r.X * 0.1), (prof.ear and prof.ear.inner) or PINK, CFrame.new(0, 0, -r.X * 0.07))
		elseif kind == "pointy" or kind == "cat" then
			local len = (kind == "cat" and r.Y * 0.7 or r.Y * 0.95) * earK
			e = ell(rig, head, "Ear", Vector3.new(r.X * 0.42, len, r.X * 0.2), p,
				CFrame.new(side * r.X * 0.55, r.Y * 0.68, 0.05) * CFrame.Angles(0, 0, -side * 0.38), nil, nil, CFrame.new(0, -len * 0.42, 0))
			ell(rig, e.part, "EarInner", Vector3.new(r.X * 0.24, len * 0.7, r.X * 0.08), (prof.ear and prof.ear.inner) or lighten(PINK, 0.2), CFrame.new(0, -len * 0.05, -r.X * 0.07))
		elseif kind == "bunny" then
			local len = r.Y * 1.5 * earK
			e = ell(rig, head, "Ear", Vector3.new(r.X * 0.36, len, r.X * 0.2), p,
				CFrame.new(side * r.X * 0.36, r.Y * 0.8, 0.1) * CFrame.Angles(-0.15, 0, -side * 0.18), nil, nil, CFrame.new(0, -len * 0.45, 0))
			ell(rig, e.part, "EarInner", Vector3.new(r.X * 0.2, len * 0.75, r.X * 0.08), (prof.ear and prof.ear.inner) or PINK, CFrame.new(0, 0, -r.X * 0.08))
		elseif kind == "floppy" then
			local len = r.Y * 1.1 * earK
			e = ell(rig, head, "Ear", Vector3.new(r.X * 0.42, len, r.X * 0.2), darken(p, 0.12),
				CFrame.new(side * r.X * 0.82, r.Y * 0.25, 0) * CFrame.Angles(0, 0, side * 0.35), nil, nil, CFrame.new(0, len * 0.42, 0))
		elseif kind == "fin" then
			e = ell(rig, head, "Ear", Vector3.new(0.12 * r.X, r.Y * 0.7, r.Z * 0.8), a,
				CFrame.new(side * r.X * 0.92, 0, 0.1) * CFrame.Angles(0, 0, -side * 0.6), nil, 0.1, CFrame.new(0, -r.Y * 0.2, 0))
		end
		if e then table.insert(rig.ears, { e = e, side = side, kind = kind }) end
	end
end

local function buildHorns(rig, head, r, def)
	local kind = def.horns
	if kind == "none" then return end
	local a = def._a
	local hornColor = (kind == "antlers" or kind == "unicorn") and a or lighten(def._s, 0.2)
	local hmat = (def.rarity == "Divine") and Enum.Material.Neon or Enum.Material.SmoothPlastic
	if kind == "unicorn" then
		local hp = pivot(rig, head, "HornBase", CFrame.new(0, r.Y * 0.78, -r.Z * 0.32) * CFrame.Angles(-0.35, 0, 0))
		group(rig, "horn", hp)
		local len, rad = r.Y * 1.15, r.X * 0.17
		for i = 0, 5 do
			local t = i / 6
			local col = (i % 2 == 0) and hornColor or lighten(def._s, 0.15)
			cyl(rig, hp.part, "Horn", Vector3.new(len / 6 * 1.05, rad * 2 * (1 - t * 0.75), rad * 2 * (1 - t * 0.75)), col,
				CFrame.new(0, len * t + len / 12, 0) * CFrame.Angles(0, t * 2, PI / 2), hmat)
		end
		spike(rig, hp.part, "HornTip", len * 0.22, rad * 0.6, hornColor, CFrame.new(0, len, 0), hmat)
		return
	end
	for _, side in ipairs({ -1, 1 }) do
		if kind == "small" then
			spike(rig, head, "Horn", r.Y * 0.5, r.X * 0.24, hornColor, CFrame.new(side * r.X * 0.4, r.Y * 0.72, 0) * CFrame.Angles(0, 0, -side * 0.25), hmat)
		elseif kind == "dragon" then
			local base = CFrame.new(side * r.X * 0.42, r.Y * 0.62, r.Z * 0.2) * CFrame.Angles(1.0, 0, -side * 0.25)
			cyl(rig, head, "HornRoot", Vector3.new(r.Y * 0.4, r.X * 0.3, r.X * 0.3), darken(hornColor, 0.1), base * CFrame.new(0, r.Y * 0.18, 0) * CFrame.Angles(0, 0, PI / 2), hmat)
			spike(rig, head, "Horn", r.Y * 0.8, r.X * 0.28, hornColor, base * CFrame.new(0, r.Y * 0.35, 0) * CFrame.Angles(0.25, 0, 0), hmat)
		elseif kind == "ram" then
			for i = 0, 6 do
				local ang = i / 6 * PI * 1.4
				local pos = Vector3.new(side * (r.X * 0.72 + math.sin(ang) * r.X * 0.3), r.Y * 0.5 + math.cos(ang) * r.Y * 0.32, r.Z * 0.12 + math.sin(ang * 0.5) * 0.22)
				local sz = r.X * (0.34 - i * 0.03)
				ell(rig, head, "Horn", Vector3.new(sz, sz, sz * 1.15), i % 2 == 0 and hornColor or darken(hornColor, 0.12), CFrame.new(pos))
			end
		elseif kind == "antlers" then
			local base = CFrame.new(side * r.X * 0.4, r.Y * 0.75, 0.1) * CFrame.Angles(0, 0, -side * 0.45)
			local ap = pivot(rig, head, "AntlerPivot", base)
			group(rig, "antlers", ap)
			local col = lighten(def._s, 0.1)
			if def._p.R + def._p.G + def._p.B > 2.2 then col = Color3.fromRGB(150, 120, 80) end
			rod(rig, ap.part, "Antler", r.Y * 1.1, 0.18, col, CFrame.identity)
			for i = 1, 3 do
				local bcf = CFrame.new(0, r.Y * 0.3 * i, 0) * CFrame.Angles(0, 0, side * 0.9)
				rod(rig, ap.part, "Antler", r.Y * 0.45, 0.14, col, bcf)
				local tip = ell(rig, ap.part, "AntlerGlow", Vector3.new(0.26, 0.26, 0.26), a, bcf * CFrame.new(0, r.Y * 0.47, 0), Enum.Material.Neon)
				group(rig, "tips", tip)
			end
		end
	end
end

---------------------------------------------------------------------
-- TAIL / WINGS
---------------------------------------------------------------------
local AURORA = { Color3.fromRGB(120, 255, 220), Color3.fromRGB(140, 160, 255), Color3.fromRGB(255, 140, 240), Color3.fromRGB(255, 255, 255) }

local function buildTail(rig, body, anchor, def, s, prof)
	local kind = def.tail
	if kind == "none" then return end
	local p, sc, a = def._p, def._s, def._a
	local tk = prof.tailK or 1
	if kind == "fluffy" then
		local e = ell(rig, body, "Tail", Vector3.new(1, 1, 1) * 0.9 * s * tk, sc, anchor, nil, nil, CFrame.new(0, 0, -0.3 * s * tk))
		ell(rig, e.part, "TailFluff", Vector3.new(0.6, 0.6, 0.6) * s * tk, lighten(sc, 0.3), CFrame.new(0, 0.15 * s, 0.25 * s * tk))
		table.insert(rig.tail, e)
		return
	end
	if kind == "fish" then
		local e = ell(rig, body, "Tail", Vector3.new(0.18 * s, 1.5 * s, 1.1 * s) * tk, a, anchor * CFrame.new(0, 0, 0.35 * s), nil, 0.05, CFrame.new(0, 0, -0.45 * s))
		table.insert(rig.tail, e)
		return
	end
	if kind == "lollipop" then
		local e = cyl(rig, body, "Tail", Vector3.new(1.3, 0.16, 0.16) * s, WHITE, anchor * CFrame.Angles(-0.7, 0, 0) * CFrame.Angles(0, 0, PI / 2), nil, nil, CFrame.new(-0.65 * s, 0, 0))
		-- stem runs along the cylinder's X axis; the candy sits at its tip, facing sideways
		local disc = cyl(rig, e.part, "Candy", Vector3.new(0.22, 1.15, 1.15) * s, a, CFrame.new(0.75 * s, 0, 0) * CFrame.Angles(0, PI / 2, 0))
		-- spiral stripes (a real swirl, not two discs)
		for i = 0, 9 do
			local ang = i * 0.9
			local rr = 0.08 + i * 0.045
			ell(rig, disc.part, "Swirl", Vector3.new(0.24, 0.2, 0.2) * s, i % 2 == 0 and sc or WHITE,
				CFrame.new(0, math.cos(ang) * rr * s, math.sin(ang) * rr * s))
		end
		group(rig, "lolli", disc)
		table.insert(rig.tail, e)
		return
	end
	-- chain tails: long / flame / stinger / leaf / aurora
	local n = (kind == "flame") and 3 or 5
	if prof.tailSegs then n = prof.tailSegs end
	local prev = body
	for i = 1, n do
		local t = i / n
		local rad = (kind == "flame" and 0.75 or 0.5) * s * (1.1 - t * 0.6) * tk
		if kind == "aurora" then rad *= 1.25 end
		local col, mat, tr = p, nil, 0
		if kind == "flame" then col = (i == n) and Color3.fromRGB(255, 240, 120) or a:Lerp(Color3.fromRGB(255, 120, 30), t); mat = (i >= n - 1) and Enum.Material.Neon or nil end
		if kind == "aurora" then col = (i == 1) and p or AURORA[(i - 2) % 4 + 1]; mat = (i > 1) and Enum.Material.Neon or nil; tr = (i > 1) and 0.15 or 0 end
		if kind == "long" and i == n and prof.tuft then col = prof.tuft end
		local c0 = (i == 1) and anchor or CFrame.new(0, rad * 0.5, rad * 1.1) * CFrame.Angles(0.28, 0, 0)
		local e, part = ell(rig, prev, "Tail", Vector3.new(rad * 2, rad * 2, rad * 2.4), col, c0, mat, tr)
		table.insert(rig.tail, e)
		prev = part
	end
	if kind == "flame" then
		local f = Instance.new("Fire"); f.Size = 2.4 * s; f.Heat = 5; f.Color = a; f.SecondaryColor = Color3.fromRGB(255, 230, 120); f.Parent = prev
		rig.tailFire = f
	elseif kind == "stinger" then
		spike(rig, prev, "Stinger", 0.9 * s, 0.4 * s, prof.stinger or DARK, CFrame.new(0, 0, 0.25 * s) * CFrame.Angles(PI / 2, 0, 0))
	elseif kind == "leaf" then
		diamond(rig, prev, "Leaf", 1.6 * s, 0.9 * s, 0.1 * s, Color3.fromRGB(90, 210, 90), CFrame.new(0, 0, 0.9 * s) * CFrame.Angles(PI / 2, 0, 0))
	end
end

local function buildWings(rig, body, r, anchorY, def, s, prof)
	local kind = def.wings
	if kind == "none" then return end
	local p, sc, a = def._p, def._s, def._a
	local wk = prof.wingK or 1
	local wz = prof.wingZ or 0.15
	for _, side in ipairs({ -1, 1 }) do
		local pv = CFrame.new(side * r.X * 0.75, anchorY, r.Z * wz)
		local e
		if kind == "feather" or kind == "angel" then
			local big = (kind == "angel" and 1.5 or 1) * wk
			local col = prof.wingCol or (kind == "angel" and WHITE or sc)
			local tip = prof.wingTip or (kind == "angel" and GOLD or a)
			e = ell(rig, body, "Wing", Vector3.new(1.9 * big * s, 1.1 * big * s, 0.2 * s), col, pv * CFrame.Angles(0, side * 0.25, side * 0.25), nil, prof.wingTr,
				CFrame.new(-side * 0.8 * big * s, -0.1 * s, 0))
			-- layered flight feathers as faceted blades
			for i = 1, 4 do
				local fcol = i == 4 and tip or lighten(col, 0.06 * i)
				diamond(rig, e.part, "Feather", 1.25 * big * s * (1 - i * 0.12), 0.42 * big * s, 0.12 * s, fcol,
					CFrame.new(side * (0.35 + 0.22 * i) * big * s, -0.32 * i * big * s, 0.03 * i) * CFrame.Angles(0, 0, side * (0.5 + 0.12 * i)),
					(i == 4 and kind == "angel") and Enum.Material.Neon or nil, prof.wingTr)
			end
		elseif kind == "bat" then
			local mem = prof.membrane or darken(a, 0.1)
			e = ell(rig, body, "Wing", Vector3.new(2.2 * s * wk, 1.3 * s * wk, 0.1 * s), mem, pv * CFrame.Angles(0, side * 0.2, side * 0.3), nil, prof.wingTr or 0.05,
				CFrame.new(-side * 1.0 * s * wk, -0.2 * s, 0))
			for i = -1, 1 do
				cyl(rig, e.part, "Finger", Vector3.new(1.45 * wk, 0.12, 0.12) * s, darken(p, 0.1), CFrame.new(side * 0.15 * s, 0.05, 0) * CFrame.Angles(0, 0, side * (1.2 + i * 0.4) - PI / 2))
			end
			-- scalloped trailing edge
			for i = 1, 3 do
				ell(rig, e.part, "Scallop", Vector3.new(0.7, 0.5, 0.08) * s * wk, mem, CFrame.new(side * (0.1 + i * 0.5) * s * wk, -0.55 * s * wk, 0), nil, prof.wingTr or 0.05)
			end
		elseif kind == "bug" then
			e = ell(rig, body, "Wing", Vector3.new(1.8 * s * wk, 1.3 * s * wk, 0.06 * s), prof.wingCol or lighten(a, 0.3), pv * CFrame.Angles(0, side * 0.3, side * 0.5), Enum.Material.Glass, prof.wingTr or 0.35,
				CFrame.new(-side * 0.85 * s * wk, -0.3 * s, 0))
			cyl(rig, e.part, "Vein", Vector3.new(1.5 * wk, 0.05, 0.05) * s, darken(p, 0.3), CFrame.new(side * 0.1 * s, 0, 0) * CFrame.Angles(0, 0, side * 0.2))
			ell(rig, e.part, "WingSpot", Vector3.new(0.5, 0.5, 0.07) * s * wk, sc, CFrame.new(side * 0.25 * s, 0.1 * s, 0), nil, 0.1)
			local low = ell(rig, e.part, "WingLow", Vector3.new(1.2 * s, 0.9 * s, 0.06 * s) * wk, prof.wingCol2 or lighten(a, 0.5), CFrame.new(side * 0.1 * s, -0.85 * s * wk, 0.05), Enum.Material.Glass, prof.wingTr or 0.4)
			table.insert(rig.wings, { e = low, side = side, tier = 2 })
		end
		if e then table.insert(rig.wings, { e = e, side = side, tier = 1 }) end
	end
end

---------------------------------------------------------------------
-- EXTRAS (shared accessories)
---------------------------------------------------------------------
local function ringOf(rig, parent, center, radius, count, size, color, tilt)
	for i = 1, count do
		local ang = i / count * PI * 2
		ell(rig, parent, "Ring", Vector3.new(size, size, size), color,
			center * CFrame.Angles(tilt or 0, 0, 0) * CFrame.new(math.cos(ang) * radius, 0, math.sin(ang) * radius), Enum.Material.Neon)
	end
end
H.ringOf = ringOf

-- a smooth band (torus-ish) made from short cylinders; returns the pivot entry
local function band(rig, parent, name, cf, radius, thick, color, segments, mat, gap)
	local pv = pivot(rig, parent, name, cf)
	segments = segments or 16
	for i = 1, segments do
		if not (gap and i % gap == 0) then
			local ang = (i - 0.5) / segments * PI * 2
			local len = 2 * PI * radius / segments * 1.08
			cyl(rig, pv.part, name .. "Seg", Vector3.new(len, thick, thick), color,
				CFrame.new(math.cos(ang) * radius, 0, math.sin(ang) * radius) * CFrame.Angles(0, -ang + PI / 2, 0), mat or Enum.Material.Neon)
		end
	end
	return pv
end
H.band = band

local function buildExtras(rig, head, hr, body, br, def, s, prof)
	local p, sc, a = def._p, def._s, def._a
	local skip = prof.skipExtra or {}
	for _, x in ipairs(def.extra) do
		if skip[x] then continue end
		if x == "leafsprout" then
			local stem = rod(rig, head, "Sprout", 0.5 * s, 0.12 * s, Color3.fromRGB(70, 160, 60), CFrame.new(0, hr.Y * 0.95, 0))
			for _, side in ipairs({ -1, 1 }) do
				diamond(rig, stem.part, "Leaf", 0.62 * s, 0.34 * s, 0.07 * s, Color3.fromRGB(110, 220, 90),
					CFrame.new(side * 0.26 * s, 0.48 * s, 0) * CFrame.Angles(PI / 2, 0, 0) * CFrame.Angles(0, 0, side * 1.2))
			end
			table.insert(rig.bobbers, stem)
		elseif x == "acorn" then
			local capPv = pivot(rig, head, "HatPivot", CFrame.new(0, hr.Y * 0.72, 0.05 * s))
			group(rig, "hat", capPv)
			ell(rig, capPv.part, "AcornCap", Vector3.new(hr.X * 1.35, hr.Y * 0.62, hr.Z * 1.35), Color3.fromRGB(120, 75, 40), CFrame.new(0, hr.Y * 0.08, 0), Enum.Material.Fabric)
			for i = 0, 2 do -- scale rings on the cap
				cyl(rig, capPv.part, "CapRing", Vector3.new(0.06 * s, hr.X * (1.3 - i * 0.3), hr.X * (1.3 - i * 0.3)), Color3.fromRGB(95, 58, 30),
					CFrame.new(0, hr.Y * (0.02 + i * 0.14), 0) * CFrame.Angles(0, 0, PI / 2))
			end
			rod(rig, capPv.part, "AcornStem", 0.42 * s, 0.15 * s, Color3.fromRGB(90, 55, 30), CFrame.new(0, hr.Y * 0.36, 0) * CFrame.Angles(0, 0, -0.3))
		elseif x == "flower" then
			local center = CFrame.new(hr.X * 0.55, hr.Y * 0.65, -hr.Z * 0.2) * CFrame.Angles(0, 0, -0.5)
			local fp = pivot(rig, head, "Flower", center)
			group(rig, "flowers", fp)
			for i = 1, 5 do
				local ang = i / 5 * PI * 2
				diamond(rig, fp.part, "Petal", 0.42 * s, 0.26 * s, 0.06 * s, a,
					CFrame.new(math.cos(ang) * 0.2 * s, 0.03 * s, math.sin(ang) * 0.2 * s) * CFrame.Angles(0, -ang, 0) * CFrame.Angles(PI / 2 - 0.25, 0, PI / 2))
			end
			ell(rig, fp.part, "FlowerCore", Vector3.new(0.22, 0.16, 0.22) * s, Color3.fromRGB(255, 230, 90), CFrame.new(0, 0.06 * s, 0))
		elseif x == "crown" then
			local cp = pivot(rig, head, "CrownPivot", CFrame.new(0, hr.Y * (prof.crownY or 0.95), prof.crownZ or 0))
			group(rig, "crown", cp)
			cyl(rig, cp.part, "Crown", Vector3.new(0.3 * s, hr.X * 0.9, hr.X * 0.9), GOLD, CFrame.Angles(0, 0, PI / 2), Enum.Material.Metal)
			for i = 1, 5 do
				local ang = i / 5 * PI * 2
				local cf = CFrame.new(math.cos(ang) * hr.X * 0.38, 0.12 * s, math.sin(ang) * hr.X * 0.38)
				spike(rig, cp.part, "CrownSpike", 0.45 * s, 0.22 * s, GOLD, cf, Enum.Material.Metal)
				local gem = ell(rig, cp.part, "Gem", Vector3.new(0.14, 0.14, 0.14) * s, a, cf * CFrame.new(0, 0.5 * s, 0), Enum.Material.Neon)
				group(rig, "crownGems", gem)
			end
		elseif x == "halo" then
			local e = band(rig, head, "Halo", CFrame.new(0, hr.Y * (prof.haloY or 1.45), prof.haloZ or 0) * CFrame.Angles(prof.haloTilt or 0, 0, 0),
				hr.X * 0.55, 0.14 * s, Color3.fromRGB(255, 236, 150), 14, Enum.Material.Neon, prof.haloGap)
			table.insert(rig.halos, e)
		elseif x == "helmet" then
			local hk = prof.helmetK or 2.5
			ell(rig, head, "Helmet", hr * hk, Color3.fromRGB(200, 240, 255), CFrame.new(0, (prof.helmetY or 0.1) * s, 0), Enum.Material.Glass, 0.72)
			cyl(rig, head, "Collar", Vector3.new(0.3 * s, hr.X * hk * 0.82, hr.X * hk * 0.82), Color3.fromRGB(60, 70, 90),
				CFrame.new(0, -hr.Y * hk * 0.36 + (prof.helmetY or 0.1) * s, 0) * CFrame.Angles(0, 0, PI / 2), Enum.Material.Metal)
		elseif x == "crystal" then
			for i = -1, 1 do
				local c = CFrame.new(i * br.X * 0.35, br.Y * 0.8, br.Z * 0.15) * CFrame.Angles(0.2, 0, -i * 0.35)
				crystal(rig, body, "Crystal", (1.1 - math.abs(i) * 0.3) * s, 0.3 * s, a, c, Enum.Material.Glass, 0.05)
			end
		elseif x == "mane" then
			for i = 0, 9 do
				local ang = i / 10 * PI * 2
				local m = ell(rig, head, "Mane", Vector3.new(0.75, 0.75, 0.6) * s, i % 2 == 0 and sc or a,
					CFrame.new(math.cos(ang) * hr.X * 0.95, math.sin(ang) * hr.Y * 0.95 + 0.05, hr.Z * 0.25))
				group(rig, "mane", m)
			end
		elseif x == "spikes" then
			for i = 0, 3 do
				spike(rig, body, "Spike", 0.75 * s, 0.4 * s, prof.spikeCol or a,
					CFrame.new(0, br.Y * 0.78 - i * 0.08 * s, -br.Z * 0.45 + i * br.Z * 0.36) * CFrame.Angles(0.35, 0, 0))
			end
		elseif x == "antenna" then
			for _, side in ipairs({ -1, 1 }) do
				local st = rod(rig, head, "Antenna", 0.9 * s, 0.09 * s, darken(p, 0.4),
					CFrame.new(side * hr.X * 0.3, hr.Y * 0.8, 0) * CFrame.Angles(0, 0, -side * 0.35))
				local tip = ell(rig, st.part, "AntennaBall", Vector3.new(0.28, 0.28, 0.28) * s, a, CFrame.new(0, 0.92 * s, 0), Enum.Material.Neon)
				group(rig, "antennaTips", tip)
				table.insert(rig.ears, { e = st, side = side, kind = "antenna" })
			end
		elseif x == "shell" then
			ell(rig, body, "Shell", br * 2.1, a, CFrame.new(0, br.Y * 0.25, br.Z * 0.1), Enum.Material.Glass, 0.15)
		elseif x == "candy" then
			local cols = { Color3.fromRGB(255, 90, 90), Color3.fromRGB(90, 200, 255), Color3.fromRGB(255, 230, 80), WHITE }
			for i = 1, 8 do
				local ang, h = i * 2.39, (i % 4) * 0.2
				blk(rig, body, "Sprinkle", Vector3.new(0.24, 0.08, 0.08) * s, cols[i % 4 + 1],
					CFrame.new(math.cos(ang) * br.X * 0.78, br.Y * (0.35 + h), math.sin(ang) * br.Z * 0.78) * CFrame.Angles(0, ang, 0.6))
			end
		elseif x == "rings" then
			local rp = band(rig, body, "OrbitRing", CFrame.Angles(prof.ringTilt or 0.35, 0, 0.15), br.X * (prof.ringR or 1.45), 0.1 * s, a, 22)
			group(rig, "rings", rp)
		elseif x == "bow" then
			local c = prof.bowCF or (CFrame.new(hr.X * 0.5, hr.Y * 0.75, 0) * CFrame.Angles(0, 0, -0.4))
			local bp = pivot(rig, head, "BowPivot", c)
			group(rig, "bow", bp)
			tri(rig, bp.part, "Bow", 0.22 * s, 0.55 * s, 0.5 * s, a, CFrame.new(-0.28 * s, 0, 0) * CFrame.Angles(0, PI / 2, PI / 2))
			tri(rig, bp.part, "Bow", 0.22 * s, 0.55 * s, 0.5 * s, a, CFrame.new(0.28 * s, 0, 0) * CFrame.Angles(0, PI / 2, -PI / 2))
			ell(rig, bp.part, "BowKnot", Vector3.new(0.25, 0.25, 0.25) * s, lighten(a, 0.3), CFrame.identity)
		elseif x == "snowcap" then
			ell(rig, head, "Snow", Vector3.new(hr.X * 1.2, hr.Y * 0.5, hr.Z * 1.2), WHITE, CFrame.new(0, hr.Y * 0.8, 0))
		elseif x == "scarf" then
			for i = 0, 11 do
				local ang = i / 12 * PI * 2
				ell(rig, head, "Scarf", Vector3.new(0.5, 0.4, 0.5) * s, i % 3 == 0 and WHITE or a,
					CFrame.new(math.cos(ang) * hr.X * 0.88, -hr.Y * 0.65, math.sin(ang) * hr.Z * 0.88))
			end
			for _, side in ipairs({ -1, 1 }) do
				local se = ell(rig, head, "ScarfEnd", Vector3.new(0.42, 0.9, 0.18) * s, a,
					CFrame.new(side * hr.X * 0.35, -hr.Y * 0.8, -hr.Z * 0.78) * CFrame.Angles(0, 0, side * 0.2), nil, nil, CFrame.new(0, 0.4 * s, 0))
				ell(rig, se.part, "ScarfStripe", Vector3.new(0.44, 0.12, 0.2) * s, WHITE, CFrame.new(0, -0.25 * s, 0))
				group(rig, "scarfEnds", se)
			end
		end
	end
end

---------------------------------------------------------------------
-- THEMED FX: honest emitters + procedural motifs (no fake leaf/heart textures)
---------------------------------------------------------------------
local EMIT = {
	sparkle = { tex = SPARKLE, rate = 4, speed = 1, size = 0.45 },
	embers  = { tex = SPARKLE, col = Color3.fromRGB(255, 140, 40), rate = 5, speed = 2.5, size = 0.3, up = true },
	fire    = { tex = FIRE, col = Color3.fromRGB(255, 130, 40), rate = 8, speed = 2, size = 1.0, up = true },
	smoke   = { tex = SMOKE, col = Color3.fromRGB(80, 30, 120), rate = 4, speed = 0.6, size = 1.6, up = true, low = true },
	rainbow = { tex = SPARKLE, col = "rainbow", rate = 6, speed = 1.2, size = 0.45 },
	holy    = { tex = SPARKLE, col = Color3.fromRGB(255, 240, 170), rate = 6, speed = 1.2, size = 0.5, up = true },
}
local MOTIF = { leaves = "leaf", hearts = "heart", snow = "snowflake", stars = "star", glitch = "cube" }

local function motifShape(rig, parent, kind, s, col)
	if kind == "leaf" then
		diamond(rig, parent, "MotifLeaf", 0.5 * s, 0.26 * s, 0.05 * s, col, CFrame.identity)
	elseif kind == "heart" then
		ell(rig, parent, "MotifHeart", Vector3.new(0.22, 0.22, 0.1) * s, col, CFrame.new(-0.09 * s, 0.06 * s, 0))
		ell(rig, parent, "MotifHeart", Vector3.new(0.22, 0.22, 0.1) * s, col, CFrame.new(0.09 * s, 0.06 * s, 0))
		tri(rig, parent, "MotifHeart", 0.1 * s, 0.24 * s, 0.34 * s, col, CFrame.new(0, -0.08 * s, 0) * CFrame.Angles(0, PI / 2, PI))
	elseif kind == "snowflake" then
		for i = 0, 2 do
			blk(rig, parent, "MotifSnow", Vector3.new(0.05, 0.5, 0.05) * s, col, CFrame.Angles(0, 0, i * PI / 3), Enum.Material.Neon)
		end
	elseif kind == "star" then
		diamond(rig, parent, "MotifStar", 0.42 * s, 0.14 * s, 0.05 * s, col, CFrame.identity, Enum.Material.Neon)
		diamond(rig, parent, "MotifStar", 0.42 * s, 0.14 * s, 0.05 * s, col, CFrame.Angles(0, 0, PI / 2), Enum.Material.Neon)
	elseif kind == "cube" then
		blk(rig, parent, "MotifCube", Vector3.new(0.18, 0.18, 0.18) * s, col, CFrame.identity, Enum.Material.Neon)
	end
end
H.motifShape = motifShape

local function addEffects(rig, def, rr, s, prof)
	local body = rig.body
	local order = Config.Rarities[def.rarity].order
	local fxKind = prof.fx or def.fx
	local em = fxKind and EMIT[fxKind]
	if em and order >= 3 then
		local pe = Instance.new("ParticleEmitter")
		pe.Name = "RarityFx"
		pe.Texture = em.tex
		if em.col == "rainbow" then
			pe.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 240, 80)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 220, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 100, 255)) })
		else
			pe.Color = ColorSequence.new(em.col or def._a)
		end
		pe.LightEmission = em.tex == SMOKE and 0 or 1
		pe.Rate = em.rate * (order >= 6 and 1.4 or 1)
		pe.Lifetime = NumberRange.new(0.8, 1.6)
		pe.Speed = NumberRange.new(em.speed * 0.5, em.speed)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Acceleration = em.up and Vector3.new(0, 2, 0) or Vector3.new(0, -0.5, 0)
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, em.size * s), NumberSequenceKeypoint.new(1, 0) })
		pe.Transparency = NumberSequence.new(em.tex == SMOKE and 0.6 or 0.1, 1)
		pe.Rotation = NumberRange.new(0, 360)
		pe.RotSpeed = NumberRange.new(-60, 60)
		pe.Shape = Enum.ParticleEmitterShape.Sphere
		pe.Parent = body
		table.insert(rig.emitters, pe)
	end
	local motif = fxKind and MOTIF[fxKind]
	if motif and order >= 3 then
		-- a few real shapes orbiting slowly (animated by CreatureAnimator "motifs" group)
		local col = fxKind == "leaves" and Color3.fromRGB(120, 220, 100) or (fxKind == "hearts" and Color3.fromRGB(255, 120, 170))
			or (fxKind == "snow" and Color3.fromRGB(225, 245, 255)) or (fxKind == "stars" and Color3.fromRGB(255, 236, 150)) or def._a
		local orbit = pivot(rig, body, "MotifOrbit", CFrame.identity)
		group(rig, "motifOrbit", orbit)
		local n = order >= 6 and 4 or 3
		for i = 1, n do
			local ang = i / n * PI * 2
			local m = pivot(rig, orbit.part, "Motif", CFrame.new(math.cos(ang) * rr.X * 1.55, (i % 2) * 0.5 * s, math.sin(ang) * rr.X * 1.55))
			motifShape(rig, m.part, motif, s, fxKind == "glitch" and (i % 2 == 0 and Color3.fromRGB(0, 255, 200) or Color3.fromRGB(255, 0, 170)) or col)
			group(rig, "motifs", m)
		end
	end
	if order >= 5 then
		local light = Instance.new("PointLight")
		light.Color = def.rarity == "Secret" and Color3.fromRGB(0, 255, 200) or lighten(def._a, 0.3)
		light.Range = 8 + order
		light.Brightness = order >= 7 and 1.6 or 1
		light.Shadows = false
		light:SetAttribute("Base", light.Brightness)
		light.Parent = body
		rig.light = light
	end
	if order >= 7 then
		-- a slow, small orbit of motes for Secret / Divine (no full-body force-field shell)
		local orbit, om = newPiece(rig, "Orbit", Vector3.new(0.05, 0.05, 0.05), WHITE, Enum.Material.Neon, nil, 1)
		local oe = attach(rig, body, orbit, om, CFrame.identity)
		ringOf(rig, orbit, CFrame.identity, rr.X * 1.7, 5, 0.22 * s, def.rarity == "Divine" and GOLD or Color3.fromRGB(0, 255, 200))
		table.insert(rig.halos, oe)
	end
end

---------------------------------------------------------------------
-- BODY PLANS
---------------------------------------------------------------------
local Plans = {}

local function legs(rig, parent, pts, size, col, s, foot)
	for _, pt in ipairs(pts) do
		local e = ell(rig, parent, "Leg", size, col, CFrame.new(pt), nil, nil, CFrame.new(0, size.Y * 0.35, 0))
		if foot then foot(e, size) end
		table.insert(rig.feet, e)
	end
end

function Plans.round(rig, def, s, prof)
	local p, sc = def._p, def._s
	local mat = matOf(def.mat)
	local tr = (mat == Enum.Material.Glass) and 0.25 or 0
	local q = prof.q or {}
	local V = function(x, y, z) return Vector3.new(x, y, z) * s end
	local br = V(1.2, 1.1, 1.15) * (q.body or Vector3.one)
	local e, body = ell(rig, rig.root, "Body", br * 2, p, CFrame.new(0, br.Y + 0.25 * s, 0), mat, tr)
	rig.bodyEntry = e
	if not q.noBelly then ell(rig, body, "Belly", V(1.5, 1.4, 0.6) * (q.belly or 1), lighten(sc, 0.1), CFrame.new(0, -0.25 * s, -br.Z * 0.72)) end
	local fk = q.feet or 1
	if fk > 0 then
		legs(rig, body, { Vector3.new(-0.5 * s, -br.Y * 0.91, -0.45 * s), Vector3.new(0.5 * s, -br.Y * 0.91, -0.45 * s) }, V(0.7, 0.4, 0.85) * fk, q.footCol or darken(p, 0.1), s,
			q.pads and function(le, size) ell(rig, le.part, "Pad", Vector3.new(size.X * 0.6, size.Y * 0.3, size.Z * 0.5), q.pads, CFrame.new(0, -size.Y * 0.35, -size.Z * 0.15)) end)
		rig.legKind = "biped"
	end
	local ak = q.arms or 1
	if ak > 0 then
		for _, side in ipairs({ -1, 1 }) do
			local arm = ell(rig, body, "Arm", V(0.42, 0.6, 0.42) * ak, q.armCol or darken(p, 0.05), CFrame.new(side * br.X * 0.92, -0.15 * s, -0.25 * s) * CFrame.Angles(0, 0, side * 0.5), nil, nil, CFrame.new(0, 0.2 * s * ak, 0))
			table.insert(rig.arms, { e = arm, side = side })
		end
	end
	return body, body, br, br, (q.faceY or 0.12) * s, CFrame.new(0, -0.3 * s, br.Z * 0.95), 0.25 * s
end

function Plans.quad(rig, def, s, prof)
	local p, sc = def._p, def._s
	local mat = matOf(def.mat)
	local tr = (mat == Enum.Material.Glass) and 0.2 or 0
	local q = prof.q or {}
	local V = function(x, y, z) return Vector3.new(x, y, z) * s end
	local br = V(1.0, 0.85, 1.3) * (q.body or Vector3.one)
	local legLen = 0.95 * s * (q.leg or 1)
	local legW = 0.55 * s * (q.legW or 1)
	local bodyY = br.Y * 0.78 + legLen * 0.85 + (q.lift or 0) * s
	local e, body = ell(rig, rig.root, "Body", br * 2, p, CFrame.new(0, bodyY, 0), mat, tr)
	rig.bodyEntry = e
	if q.chest then ell(rig, body, "Chest", V(1.4, 1.3, 1.0) * q.chest, p, CFrame.new(0, 0.15 * s, -br.Z * 0.55), mat, tr) end
	ell(rig, body, "Belly", Vector3.new(br.X * 1.5, br.Y * 1.15, br.Z * 1.55), q.bellyCol or sc, CFrame.new(0, -br.Y * 0.4, -0.1 * s), mat, tr)
	local lx, lz = br.X * 0.55, br.Z * 0.62
	local legCol = q.legCol or darken(p, 0.08)
	local foot = function(le, size, front)
		local talons = q.talons
		if q.talonsFront and not front then talons = nil end
		if q.hooves and not talons then
			cyl(rig, le.part, "Hoof", Vector3.new(size.Y * 0.16, size.X * 1.05, size.X * 1.05), q.hooves, CFrame.new(0, -size.Y * 0.47, 0) * CFrame.Angles(0, 0, PI / 2))
		else
			local pk = q.paws or 1
			ell(rig, le.part, "Paw", Vector3.new(size.X * 1.15, size.X * 0.55, size.X * 1.35) * pk, q.pawCol or legCol, CFrame.new(0, -size.Y * 0.44, -size.X * 0.2))
			if q.pads then ell(rig, le.part, "PawPad", Vector3.new(size.X * 0.7, size.X * 0.2, size.X * 0.6) * pk, q.pads, CFrame.new(0, -size.Y * 0.5, -size.X * 0.25)) end
			if talons then
				for t = -1, 1 do spike(rig, le.part, "Talon", size.X * 0.5, size.X * 0.22, talons, CFrame.new(t * size.X * 0.3, -size.Y * 0.47, -size.X * 0.6) * CFrame.Angles(-PI / 2 + 0.4, 0, 0)) end
			end
		end
	end
	local legSize = Vector3.new(legW, legLen, legW)
	local frontSize = q.frontLeg and Vector3.new(legW * q.frontLeg, legLen, legW * q.frontLeg) or legSize
	local pts = { Vector3.new(-lx, -br.Y * 0.78, -lz), Vector3.new(lx, -br.Y * 0.78, -lz), Vector3.new(-lx, -br.Y * 0.78, lz), Vector3.new(lx, -br.Y * 0.78, lz) }
	for i, pt in ipairs(pts) do
		local sz = i <= 2 and frontSize or legSize
		local col = (q.frontCol and i <= 2) and q.frontCol or legCol
		local le = ell(rig, body, "Leg", sz, col, CFrame.new(pt), nil, nil, CFrame.new(0, sz.Y * 0.35, 0))
		foot(le, sz, i <= 2)
		table.insert(rig.feet, le)
	end
	rig.legKind = "quad"
	-- neck + head
	local hk = q.head or 1
	local hr = V(0.98, 0.92, 0.92) * hk * (q.headShape or Vector3.one)
	local neck = q.neck or 0
	local headParent = body
	local headCF = CFrame.new(0, 0.85 * s + neck * 0.6 * s, -br.Z * 0.96 - neck * 0.35 * s)
	if neck > 0 then
		local ne = ell(rig, body, "Neck", V(0.75, 1.1 + neck, 0.75) * (q.neckW or 1), p, CFrame.new(0, br.Y * 0.55, -br.Z * 0.72) * CFrame.Angles(-0.55, 0, 0), mat, tr, CFrame.new(0, -(1.1 + neck) * 0.4 * s, 0))
		rig.neckEntry = ne
		headParent = ne.part
		headCF = CFrame.new(0, (1.1 + neck) * 0.42 * s, -0.05 * s) * CFrame.Angles(0.55, 0, 0)
	end
	local he, head = ell(rig, headParent, "Head", hr * 2, q.headCol or p, headCF, mat, tr, CFrame.new(0, -0.3 * s, 0.3 * s))
	rig.headEntry = he
	local mz = q.muzzle or "snout"
	if mz == "snout" or mz == "broad" then
		local w = mz == "broad" and 1.2 or 1
		ell(rig, head, "Snout", V(0.9 * w, 0.55, 0.5) * hk, lighten(sc, 0.05), CFrame.new(0, -0.38 * s * hk, -hr.Z * 0.82))
		ell(rig, head, "Nose", V(0.28, 0.2, 0.18) * hk, DARK, CFrame.new(0, -0.24 * s * hk, -hr.Z * 1.05))
	elseif mz == "narrow" or mz == "long" then
		local len = mz == "long" and 1.25 or 0.95
		ell(rig, head, "Muzzle", V(0.62, 0.5, len) * hk, q.muzzleCol or lighten(sc, 0.05), CFrame.new(0, -0.32 * s * hk, -hr.Z * (0.75 + len * 0.3)))
		ell(rig, head, "Nose", V(0.24, 0.18, 0.16) * hk, DARK, CFrame.new(0, -0.2 * s * hk, -hr.Z * (0.75 + len * 0.75)))
	elseif mz == "beak" then
		ell(rig, head, "Beak", V(0.55, 0.42, 0.75) * hk, q.beakCol or GOLD, CFrame.new(0, -0.22 * s * hk, -hr.Z * 1.05))
		spike(rig, head, "BeakHook", 0.35 * s * hk, 0.3 * s * hk, q.beakCol or GOLD, CFrame.new(0, -0.32 * s * hk, -hr.Z * 1.35) * CFrame.Angles(PI, 0, 0))
	elseif mz == "cat" then
		for _, side in ipairs({ -1, 1 }) do
			ell(rig, head, "Whisker", V(0.42, 0.32, 0.3) * hk, lighten(sc, 0.05), CFrame.new(side * 0.17 * s * hk, -0.36 * s * hk, -hr.Z * 0.82))
		end
		tri(rig, head, "Nose", 0.12 * s, 0.14 * s * hk, 0.2 * s * hk, q.noseCol or PINK, CFrame.new(0, -0.22 * s * hk, -hr.Z * 0.98) * CFrame.Angles(0, PI / 2, PI))
	end
	local faceY = (q.faceY or 0.12) * s
	return body, head, br, hr, faceY, CFrame.new(0, (q.tailY or 0.3) * s, br.Z * 0.95), 0.55 * s
end

function Plans.bird(rig, def, s, prof)
	local p, sc, a = def._p, def._s, def._a
	local mat = matOf(def.mat)
	local tr = (mat == Enum.Material.Glass) and 0.25 or 0
	local q = prof.q or {}
	local V = function(x, y, z) return Vector3.new(x, y, z) * s end
	local br = V(1.1, 1.25, 1.05) * (q.body or Vector3.one)
	local e, body = ell(rig, rig.root, "Body", br * 2, p, CFrame.new(0, br.Y + 0.35 * s, 0), mat, tr)
	rig.bodyEntry = e
	ell(rig, body, "Belly", V(1.5, 1.6, 0.6), sc, CFrame.new(0, -0.35 * s, -br.Z * 0.7))
	if q.down then -- downy chest lobes
		for i = -1, 1 do ell(rig, body, "Down", V(0.6, 0.55, 0.4), lighten(sc, 0.1), CFrame.new(i * 0.35 * s, -0.55 * s - math.abs(i) * 0.1 * s, -br.Z * 0.86)) end
	end
	local beak = ell(rig, body, "Beak", V(0.55, 0.32, 0.6), q.beakCol or Color3.fromRGB(255, 170, 50), CFrame.new(0, 0.05 * s, -br.Z * 1.0))
	group(rig, "beak", beak)
	legs(rig, body, { V(-0.45, -1.25, -0.2), V(0.45, -1.25, -0.2) }, V(0.5, 0.35, 0.7), q.footCol or Color3.fromRGB(255, 160, 50), s)
	rig.legKind = "biped"
	if not q.noTuft then ell(rig, body, "Tuft", V(0.4, 0.7, 0.3), q.tuftCol or a, CFrame.new(0, br.Y * 0.98, -0.2 * s) * CFrame.Angles(-0.3, 0, 0), q.tuftMat) end
	return body, body, br, br, 0.4 * s, CFrame.new(0, -0.35 * s, br.Z * 0.95), 0.1 * s
end

-- birds with a real neck/head pivot (owls, phoenixes, empress)
function Plans.avian(rig, def, s, prof)
	local p, sc, a = def._p, def._s, def._a
	local mat = matOf(def.mat)
	local tr = (mat == Enum.Material.Glass) and 0.15 or 0
	local q = prof.q or {}
	local V = function(x, y, z) return Vector3.new(x, y, z) * s end
	local br = V(0.95, 1.05, 1.2) * (q.body or Vector3.one)
	local legLen = 0.6 * s * (q.leg or 1)
	local e, body = ell(rig, rig.root, "Body", br * 2, p, CFrame.new(0, br.Y * 0.85 + legLen * 0.8, 0) * CFrame.Angles(q.bodyPitch or 0.25, 0, 0), mat, tr)
	rig.bodyEntry = e
	ell(rig, body, "Breast", Vector3.new(br.X * 1.5, br.Y * 1.4, br.Z * 0.9), q.breastCol or sc, CFrame.new(0, -br.Y * 0.15, -br.Z * 0.45), mat, tr)
	legs(rig, body, { Vector3.new(-br.X * 0.4, -br.Y * 0.85, 0), Vector3.new(br.X * 0.4, -br.Y * 0.85, 0) }, Vector3.new(0.3 * s, legLen, 0.3 * s), q.footCol or Color3.fromRGB(255, 170, 60), s,
		function(le, size)
			for t = -1, 1 do spike(rig, le.part, "Talon", 0.35 * s, 0.14 * s, q.talonCol or DARK, CFrame.new(t * 0.12 * s, -size.Y * 0.45, -0.1 * s) * CFrame.Angles(-PI / 2 + 0.3, t * 0.4, 0)) end
		end)
	rig.legKind = "biped"
	local neck = q.neck or 0.3
	local hr = V(0.78, 0.74, 0.74) * (q.head or 1)
	local ne = ell(rig, body, "Neck", V(0.6, 0.6 + neck * 1.4, 0.6), p, CFrame.new(0, br.Y * 0.7, -br.Z * 0.45) * CFrame.Angles(-0.25, 0, 0), mat, tr, CFrame.new(0, -(0.6 + neck * 1.4) * 0.35 * s, 0))
	rig.neckEntry = ne
	local he, head = ell(rig, ne.part, "Head", hr * 2, q.headCol or p, CFrame.new(0, (0.6 + neck * 1.4) * 0.45 * s + hr.Y * 0.5, 0) * CFrame.Angles(-(q.bodyPitch or 0.25) + 0.25, 0, 0), mat, tr, CFrame.new(0, -hr.Y * 0.5, 0))
	rig.headEntry = he
	-- beak
	local bk = q.beak or "short"
	local beakCol = q.beakCol or Color3.fromRGB(255, 180, 60)
	local beakPv = pivot(rig, head, "BeakPivot", CFrame.new(0, -hr.Y * 0.18, -hr.Z * 0.85))
	group(rig, "beak", beakPv)
	if bk == "hook" then
		ell(rig, beakPv.part, "Beak", V(0.36, 0.32, 0.55) * (q.head or 1), beakCol, CFrame.new(0, 0, -0.18 * s))
		spike(rig, beakPv.part, "BeakHook", 0.3 * s, 0.24 * s, beakCol, CFrame.new(0, -0.05 * s, -0.42 * s) * CFrame.Angles(PI - 0.5, 0, 0))
	else
		spike(rig, beakPv.part, "Beak", (bk == "long" and 0.65 or 0.42) * s, 0.36 * s, beakCol, CFrame.new(0, 0, -0.05 * s) * CFrame.Angles(-PI / 2, 0, 0))
	end
	if q.disc then -- owl facial disc
		for _, side in ipairs({ -1, 1 }) do
			ell(rig, head, "FacialDisc", Vector3.new(hr.X * 0.95, hr.Y * 1.15, 0.12 * s), q.disc, surface(hr, side * hr.X * 0.38, 0.05 * s) * CFrame.new(0, 0, 0.04))
		end
	end
	if q.crest then
		for i = 0, 2 do
			diamond(rig, head, "Crest", (0.9 - i * 0.15) * s * q.crest, 0.28 * s, 0.07 * s, i == 1 and a or sc,
				CFrame.new(0, hr.Y * 0.85, hr.Z * (0.1 + i * 0.25)) * CFrame.Angles(-0.4 - i * 0.35, 0, 0) * CFrame.new(0, 0.35 * s, 0), q.crestMat)
		end
	end
	return body, head, br, hr, (q.faceY or 0.1) * s, CFrame.new(0, -br.Y * 0.25, br.Z * 0.9), 0.35 * s
end

function Plans.slime(rig, def, s, prof)
	local p, a = def._p, def._a
	local mat = matOf(def.mat)
	local tr = (mat == Enum.Material.Glass) and 0.3 or 0
	local q = prof.q or {}
	local V = function(x, y, z) return Vector3.new(x, y, z) * s end
	local br = V(1.3, 1.0, 1.3) * (q.body or Vector3.one)
	local e, body = ell(rig, rig.root, "Body", br * 2, p, CFrame.new(0, br.Y * 0.8, 0), mat, tr)
	rig.bodyEntry = e
	if mat == Enum.Material.Glass and not q.noCore then
		local core = ell(rig, body, "Core", V(0.8, 0.8, 0.8), a, CFrame.new(0, 0.05 * s, 0.2 * s), Enum.Material.Neon, 0.1)
		rig.core = core
	end
	if STYLE.blocky then
		-- faceted elemental construct: stepped crown tier + chamfer wedges instead of a plain crate
		ell(rig, body, "Tier", Vector3.new(br.X * 1.5, br.Y * 0.6, br.Z * 1.5), lighten(p, 0.08), CFrame.new(0, br.Y * 1.15, 0.05 * s), mat, tr)
		for _, side in ipairs({ -1, 1 }) do
			wdg(rig, body, "Chamfer", Vector3.new(br.X * 1.9, br.Y * 0.5, br.Z * 0.35), darken(p, 0.12), CFrame.new(0, br.Y * 0.88, side * br.Z * 0.85) * CFrame.Angles(0, side > 0 and 0 or PI, 0), mat, tr)
		end
	else
		ell(rig, body, "Shine", V(0.6, 0.3, 0.45), WHITE, CFrame.new(-0.45 * s, br.Y * 0.62, -0.5 * s) * CFrame.Angles(0, 0, 0.4), Enum.Material.Neon, 0.35)
	end
	if not q.noDrip then ell(rig, body, "Drip", V(0.5, 0.6, 0.5), p, CFrame.new(0.8 * s, -0.5 * s, -0.6 * s), mat, tr) end
	return body, body, br, br, (q.faceY or 0.15) * s, CFrame.new(0, 0, br.Z), 0.3 * s
end

function Plans.ghost(rig, def, s, prof)
	local p = def._p
	local mat = matOf(def.mat)
	local q = prof.q or {}
	local V = function(x, y, z) return Vector3.new(x, y, z) * s end
	local br = V(1.1, 1.3, 1.1) * (q.body or Vector3.one)
	local tr = q.tr or (mat == Enum.Material.Glass and 0.3 or 0)
	local e, body = ell(rig, rig.root, "Body", br * 2, p, CFrame.new(0, 2.2 * s * (q.height or 1), 0), mat, tr)
	rig.bodyEntry = e
	if q.rim then ell(rig, body, "Rim", br * 2.08, q.rim, CFrame.new(0, 0, 0.04 * s), Enum.Material.SmoothPlastic, 0.55) end
	if STYLE.blocky then
		-- armored spectral form: tapered hood tier + narrower lower hem block
		ell(rig, body, "Hood", Vector3.new(br.X * 1.6, br.Y * 0.55, br.Z * 1.6), darken(p, 0.1), CFrame.new(0, br.Y * 1.1, 0.08 * s), mat, tr)
		ell(rig, body, "HemBlock", Vector3.new(br.X * 1.5, br.Y * 0.5, br.Z * 1.5), lighten(p, 0.06), CFrame.new(0, -br.Y * 1.05, 0), mat, tr)
	end
	local lobes = q.lobes or 3
	for i = 1, lobes do
		local x = (i - (lobes + 1) / 2) / math.max(1, (lobes - 1) / 2) * br.X * 0.55
		local w = ell(rig, body, "Wisp", V(0.7, 0.9, 0.7) * (q.lobeK or 1), q.hemCol or lighten(p, 0.1), CFrame.new(x, -br.Y * 0.9, 0.1 * s), mat, q.hemTr or 0.1, CFrame.new(0, 0.3 * s, 0))
		table.insert(rig.tail, w)
	end
	if (q.arms or 1) > 0 then
		for _, side in ipairs({ -1, 1 }) do
			local arm = ell(rig, body, "Arm", V(0.4, 0.65, 0.4) * (q.arms or 1), q.armCol or p, CFrame.new(side * br.X * 0.95, -0.1 * s, -0.2 * s) * CFrame.Angles(0, 0, side * 0.7), mat, tr, CFrame.new(0, 0.25 * s, 0))
			table.insert(rig.arms, { e = arm, side = side })
		end
	end
	rig.legKind = "none"
	return body, body, br, br, (q.faceY or 0.3) * s, CFrame.new(0, -0.5 * s, br.Z), 0.4 * s
end

function Plans.fish(rig, def, s, prof)
	local p, sc, a = def._p, def._s, def._a
	local mat = matOf(def.mat)
	local tr = (mat == Enum.Material.Glass) and 0.25 or 0
	local q = prof.q or {}
	local V = function(x, y, z) return Vector3.new(x, y, z) * s end
	local br = V(0.9, 0.95, 1.5) * (q.body or Vector3.one)
	local e, body = ell(rig, rig.root, "Body", br * 2, p, CFrame.new(0, 2.0 * s, 0), mat, tr)
	rig.bodyEntry = e
	ell(rig, body, "Belly", Vector3.new(br.X * 1.55, br.Y * 1.25, br.Z * 1.6), sc, CFrame.new(0, -br.Y * 0.37, 0))
	tri(rig, body, "Dorsal", 0.12 * s, 0.9 * s, 1.2 * s, a, CFrame.new(0, br.Y * 1.05, 0.25 * s) * CFrame.Angles(0, 0, 0))
	for _, side in ipairs({ -1, 1 }) do
		local fin = ell(rig, body, "Fin", V(0.9, 0.12, 0.6) * (q.finK or 1), a, CFrame.new(side * br.X * 0.95, -0.3 * s, -0.2 * s) * CFrame.Angles(0, side * 0.5, 0), nil, 0.05, CFrame.new(-side * 0.4 * s, 0, 0))
		table.insert(rig.wings, { e = fin, side = side, tier = 1 })
	end
	rig.legKind = "none"
	return body, body, br, br, 0.15 * s, CFrame.new(0, 0, br.Z * 0.95), 0.2 * s
end

function Plans.dragon(rig, def, s, prof)
	local p, sc = def._p, def._s
	local mat = matOf(def.mat)
	local tr = (mat == Enum.Material.Glass) and 0.15 or 0
	local q = prof.q or {}
	local V = function(x, y, z) return Vector3.new(x, y, z) * s end
	local br = V(1.1, 0.95, 1.5) * (q.body or Vector3.one)
	local legMode = q.legs or "four"
	local bodyY = (legMode == "none") and 2.4 * s or 1.7 * s * (q.lift or 1)
	local e, body = ell(rig, rig.root, "Body", br * 2, p, CFrame.new(0, bodyY, 0), mat, tr)
	rig.bodyEntry = e
	if mat == Enum.Material.Glass then ell(rig, body, "CoreBody", br * 1.6, darken(p, 0.15), CFrame.identity) end
	ell(rig, body, "Belly", Vector3.new(br.X * 1.45, br.Y * 1.25, br.Z * 1.6), sc, CFrame.new(0, -br.Y * 0.4, -0.1 * s))
	if q.chestPlates then
		for i = 0, 3 do
			blk(rig, body, "ChestPlate", V(1.0 - i * 0.1, 0.22, 0.5), q.chestPlates, CFrame.new(0, -br.Y * 0.35 + i * 0.28 * s, -br.Z * 0.88 + i * 0.05 * s) * CFrame.Angles(-0.5, 0, 0))
		end
	end
	local claw = function(le, size)
		if q.claws then for t = -1, 1 do spike(rig, le.part, "Claw", 0.3 * s, 0.14 * s, q.claws, CFrame.new(t * 0.15 * s, -size.Y * 0.45, -0.22 * s) * CFrame.Angles(-PI / 2 + 0.4, 0, 0)) end end
	end
	if legMode == "four" then
		legs(rig, body, { Vector3.new(-br.X * 0.6, -br.Y * 0.82, -br.Z * 0.6), Vector3.new(br.X * 0.6, -br.Y * 0.82, -br.Z * 0.6),
			Vector3.new(-br.X * 0.6, -br.Y * 0.82, br.Z * 0.6), Vector3.new(br.X * 0.6, -br.Y * 0.82, br.Z * 0.6) }, V(0.6, 1.1, 0.6), darken(p, 0.08), s, claw)
		rig.legKind = "quad"
	elseif legMode == "two" then -- wyvern: two powerful hind legs only
		legs(rig, body, { Vector3.new(-br.X * 0.62, -br.Y * 0.7, br.Z * 0.35), Vector3.new(br.X * 0.62, -br.Y * 0.7, br.Z * 0.35) }, V(0.78, 1.35, 0.78), darken(p, 0.08), s, claw)
		rig.legKind = "biped"
	else
		rig.legKind = "none"
	end
	-- neck(s) + head(s)
	local nNecks = q.necks or 1
	local hr = V(0.85, 0.75, 0.9) * (q.head or 1)
	local firstHead, faceY = nil, 0.2 * s
	for ni = 1, nNecks do
		local off = nNecks == 1 and 0 or (ni - (nNecks + 1) / 2)
		local neckSegs = q.neckSegs or 2
		local segLen = (q.neckLen or 1) * 0.75 * s
		local baseCF = CFrame.new(off * br.X * 0.8, br.Y * 0.45, -br.Z * 0.72) * CFrame.Angles(-0.7, 0, off * -0.45)
		local rec = chain(rig, body, "Neck", baseCF, neckSegs, function(j, n)
			local w = (0.95 - j * 0.08) * s * (q.neckW or 1)
			return Vector3.new(w, segLen * 1.6, w), p, mat, tr, CFrame.new(0, segLen * 0.85, 0) * CFrame.Angles(0.22, 0, 0), CFrame.new(0, -segLen * 0.7, 0)
		end, { kind = "neck", i = ni, side = off, amp = 0.12, freq = 1.1, lag = 0.6, axis = "both" })
		group(rig, "neckChains", rec)
		local last = rec.parts[#rec.parts]
		local he, head = ell(rig, last, "Head", hr * 2, p, CFrame.new(0, segLen * 0.75, -0.1 * s) * CFrame.Angles(0.7 - (neckSegs - 1) * 0.22, 0, 0), mat, tr, CFrame.new(0, -0.2 * s, 0.3 * s))
		local sn = ell(rig, head, "Snout", Vector3.new(hr.X * 1.25, hr.Y * 0.95, hr.Z * 1.1), lighten(p, 0.05), CFrame.new(0, -0.28 * s, -hr.Z * 0.8), mat, tr)
		for _, side in ipairs({ -1, 1 }) do
			ell(rig, head, "Nostril", V(0.14, 0.1, 0.1), DARK, CFrame.new(side * 0.2 * s, -0.12 * s, -hr.Z * 1.32))
		end
		-- hinged jaw
		local jaw = ell(rig, head, "Jaw", Vector3.new(hr.X * 1.05, hr.Y * 0.4, hr.Z * 1.0), lighten(sc, 0.05), CFrame.new(0, -hr.Y * 0.55, -hr.Z * 0.35), mat, tr, CFrame.new(0, 0, hr.Z * 0.45))
		group(rig, "jaws", jaw)
		group(rig, "heads", he)
		if q.brow then
			for _, side in ipairs({ -1, 1 }) do blk(rig, head, "BrowRidge", Vector3.new(hr.X * 0.7, 0.16 * s, 0.3 * s), q.brow, CFrame.new(side * hr.X * 0.38, hr.Y * 0.55, -hr.Z * 0.62) * CFrame.Angles(0.3, 0, side * 0.25)) end
		end
		if ni == math.ceil(nNecks / 2) then firstHead = { he = he, head = head } end
		rec.head = he
	end
	rig.headEntry = firstHead.he
	return body, firstHead.head, br, hr, faceY, CFrame.new(0, 0.2 * s, br.Z * 0.95), 0.75 * s
end

function Plans.bug(rig, def, s, prof)
	local p, sc, a = def._p, def._s, def._a
	local mat = matOf(def.mat)
	local tr = (mat == Enum.Material.Glass) and 0.2 or 0
	local q = prof.q or {}
	local V = function(x, y, z) return Vector3.new(x, y, z) * s end
	local br = V(0.8, 0.75, 0.75) * (q.thorax or Vector3.one)
	local e, body = ell(rig, rig.root, "Body", br * 2, p, CFrame.new(0, 1.3 * s, 0), mat, tr)
	rig.bodyEntry = e
	local ab = q.abdomen or Vector3.new(1.8, 1.7, 2.1)
	local abd = ell(rig, body, "Abdomen", ab * s, q.abdomenCol or sc, CFrame.new(0, 0.05 * s, (0.3 + ab.Z * 0.5) * s) * CFrame.Angles(q.abdomenPitch or 0, 0, 0), mat, tr, CFrame.new(0, 0, -ab.Z * 0.45 * s))
	group(rig, "abdomen", abd)
	if q.stripes then
		for i = 0, 2 do
			ell(rig, abd.part, "Stripe", Vector3.new(ab.X * 1.02, 0.25, ab.Z * 0.16) * s, q.stripeCol or a, CFrame.new(0, 0, (-0.35 + i * 0.35) * ab.Z * s))
		end
	end
	local legCol = q.legCol or DARK
	for i = -1, 1 do
		for _, side in ipairs({ -1, 1 }) do
			local leg = cyl(rig, body, "Leg", Vector3.new(0.85, 0.11, 0.11) * s * (q.legK or 1), legCol,
				CFrame.new(side * 0.55 * s, -0.5 * s, i * 0.42 * s) * CFrame.Angles(0, 0, side * 0.6) * CFrame.Angles(0, 0, PI / 2), nil, nil, CFrame.new(0.4 * s * (q.legK or 1), 0, 0))
			cyl(rig, leg.part, "Shin", Vector3.new(0.6, 0.09, 0.09) * s * (q.legK or 1), legCol, CFrame.new(-0.62 * s * (q.legK or 1), side * 0.0, 0) * CFrame.Angles(0, 0, side * -0.9))
			table.insert(rig.feet, leg)
		end
	end
	rig.legKind = "bug6"
	local hr = V(0.85, 0.8, 0.8) * (q.head or 1)
	local he, head = ell(rig, body, "Head", hr * 2, q.headCol or p, CFrame.new(0, 0.45 * s, -1.05 * s), mat, tr, CFrame.new(0, -0.2 * s, 0.3 * s))
	rig.headEntry = he
	return body, head, br, hr, 0.1 * s, CFrame.new(0, 0, (0.3 + ab.Z) * s), 0.7 * s
end

function Plans.golem(rig, def, s, prof)
	local p, sc, a = def._p, def._s, def._a
	local mat = matOf(def.mat)
	local tr = (mat == Enum.Material.Glass) and 0.25 or 0
	local q = prof.q or {}
	local V = function(x, y, z) return Vector3.new(x, y, z) * s end
	local br = V(1.5, 1.45, 1.25) * (q.body or Vector3.one)
	local hover = q.hover and 1.2 * s or 0
	local e, body = ell(rig, rig.root, "Body", br * 2, p, CFrame.new(0, 2.3 * s + hover, 0), mat, tr)
	rig.bodyEntry = e
	if q.cracks ~= false then
		for i = 1, 4 do
			local c = ell(rig, body, "Crack", V(0.12, 0.9, 0.05), a, surface(br, (i - 2.5) * 0.5 * s, (i % 2) * 0.4 * s - 0.4 * s) * CFrame.Angles(0, 0, i * 0.7), Enum.Material.Neon)
			group(rig, "seams", c)
		end
	end
	if q.chest ~= false then ell(rig, body, "Chest", V(1.6, 1.3, 0.5), q.chestCol or lighten(sc, 0.1), CFrame.new(0, -0.3 * s, -br.Z * 0.82), q.chestMat) end
	local ak = q.armK or 1
	for _, side in ipairs({ -1, 1 }) do
		local arm = ell(rig, body, "Arm", V(1.0, 1.9 * ak, 1.0) * (q.armW or 1), q.armCol or darken(p, 0.1), CFrame.new(side * br.X * 1.05, 0.2 * s, 0) * CFrame.Angles(0, 0, side * 0.15), mat, tr, CFrame.new(0, 0.75 * s * ak, 0))
		local fist = ell(rig, arm.part, "Fist", V(1.15, 0.9, 1.15) * (q.fistK or 1), q.fistCol or sc, CFrame.new(0, -0.95 * s * ak, 0), q.fistMat)
		group(rig, "fists", fist)
		table.insert(rig.arms, { e = arm, side = side })
	end
	if not q.hover then
		legs(rig, body, { V(-0.7, -1.55, 0) * Vector3.new(br.X / (1.5 * s), 1, 1), V(0.7, -1.55, 0) * Vector3.new(br.X / (1.5 * s), 1, 1) }, V(1.0, 1.0, 1.0) * (q.legK or 1), q.legCol or darken(p, 0.15), s)
		rig.legKind = "biped"
	else
		rig.legKind = "none"
		for i = 0, 2 do -- tapered statue base
			ell(rig, body, "Plinth", V(1.6 - i * 0.4, 0.5, 1.4 - i * 0.35), lighten(p, 0.02), CFrame.new(0, -br.Y * 0.95 - i * 0.35 * s, 0), mat)
		end
	end
	local hr = V(0.85, 0.75, 0.8) * (q.head or 1)
	local he, head = ell(rig, body, "Head", hr * 2, q.headCol or p, CFrame.new(0, br.Y * 1.05, -0.25 * s), mat, tr, CFrame.new(0, -0.3 * s, 0))
	rig.headEntry = he
	return body, head, br, hr, 0.05 * s, CFrame.new(0, -0.5 * s, br.Z), 0.8 * s
end
Builder.Plans = Plans

---------------------------------------------------------------------
-- BUILD
---------------------------------------------------------------------
local Anatomy -- SpeciesAnatomy (required lazily: it requires this module's H)

local function buildBody(rig, vd, s, prof)
	Anatomy = Anatomy or require(script.Parent.SpeciesAnatomy)
	local planName = prof.plan or vd.body
	local plan = Plans[planName]
	if not plan and Anatomy.Plans[planName] then
		local ap = Anatomy.Plans[planName]
		plan = function(...) return ap(H, ...) end
	end
	plan = plan or Plans.round
	local body, head, br, hr, faceY, tailAnchor, wingY = plan(rig, vd, s, prof)
	rig.body, rig.head, rig.bodyRadius, rig.headRadius = body, head, br, hr
	rig.faceY = faceY
	local heads = rig.groups.heads
	if heads and #heads > 1 then
		for _, he in ipairs(heads) do
			buildFace(rig, he.part, hr, vd, faceY, 0.85, prof.face)
			buildEars(rig, he.part, hr, vd, prof)
			buildHorns(rig, he.part, hr, vd)
		end
	elseif not prof.noFace then
		buildFace(rig, head, hr, vd, faceY, (vd.body == "golem" or prof.plan == "golem") and 0.85 or (prof.faceK or 1), prof.face)
		buildEars(rig, head, hr, vd, prof)
		buildHorns(rig, head, hr, vd)
	end
	if prof.tailAnchor then tailAnchor = prof.tailAnchor(br, s) end
	buildTail(rig, body, tailAnchor, vd, s, prof)
	buildWings(rig, body, br, prof.wingY and prof.wingY * s or wingY, vd, s, prof)
	buildExtras(rig, head, hr, body, br, vd, s, prof)
	if prof.build then
		local fn = Anatomy[prof.build]
		if fn then fn(H, rig, vd, s, prof) end
	end
	addEffects(rig, vd, br, s, prof)
end

---------------------------------------------------------------------
-- SCULPTED MESH PATH (species with generated meshes in PetMeshManifest)
---------------------------------------------------------------------
local MeshManifest = require(script.Parent.PetMeshManifest)
Builder.MeshScale = 0.85 -- generated pets are ~4.2 studs tall; scale toward the procedural sizes

local function meshTemplate(id)
	if not MeshManifest[id] or typeof(game) ~= "Instance" then return nil end
	local rs = game:FindFirstChild("ReplicatedStorage")
	local f = rs and rs:FindFirstChild("PetMeshes")
	local t = f and f:FindFirstChild(id)
	if not t then return nil end
	for _, pd in ipairs(MeshManifest[id].parts) do
		if not t:FindFirstChild(pd.role) then return nil end -- incomplete: use the procedural fallback
	end
	return t
end
Builder.HasMesh = function(id) return meshTemplate(id) ~= nil end

local function buildFromMeshes(rig, tmpl, man, s)
	local k = s * Builder.MeshScale
	local entries, bodyCF = {}, nil
	local function cfOf(pd) return CFrame.new(Vector3.new(pd.pos[1], pd.pos[2], pd.pos[3]) * k) end
	for _, pd in ipairs(man.parts) do if pd.role == "body" then bodyCF = cfOf(pd) end end
	bodyCF = bodyCF or CFrame.new(0, 1.5 * k, 0)
	local function mk(pd, parent, parentCF, pivot)
		local p = tmpl[pd.role]:Clone()
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, false, true
		p.CastShadow = true
		local size = Vector3.new(pd.size[1], pd.size[2], pd.size[3]) * k
		p.Size = size
		p.Parent = rig.model
		local cf = cfOf(pd)
		local c1 = pivot and pivot(size) or CFrame.identity
		local e = attach(rig, parent, p, nil, parentCF:ToObjectSpace(cf) * c1, c1)
		e.baseSize = size
		entries[pd.role] = e
		return e, p, size
	end
	local find = function(role) for _, pd in ipairs(man.parts) do if pd.role == role then return pd end end end
	-- body on the root, head on the body, accessories on the head
	local bodyPd = find("body")
	local be, body, bsize = mk(bodyPd, rig.root, CFrame.identity, nil)
	rig.bodyEntry, rig.body = be, body
	rig.bodyRadius = bsize / 2
	local head, hsize = body, bsize
	local headPd = find("head")
	if headPd then
		local he, hp, hs = mk(headPd, body, bodyCF, function(sz) return CFrame.new(0, -sz.Y * 0.35, sz.Z * 0.25) end)
		rig.headEntry, head, hsize = he, hp, hs
	end
	rig.head, rig.headRadius, rig.faceY = head, hsize / 2, 0
	local headCF = headPd and cfOf(headPd) or bodyCF
	local HEAD_ATTACH = { "horn", "antler", "crown", "hat", "crest", "beak", "helmet", "mane", "sprout", "antenna", "tuft", "snout", "jaw", "eye" }
	local function onHead(r)
		for _, k in ipairs(HEAD_ATTACH) do if r:find(k) then return true end end
		return false
	end
	for _, pd in ipairs(man.parts) do
		local r = pd.role
		if r == "body" or r == "head" then continue end
		if r:find("head") then -- extra heads (hydra): independent necks/heads with their own gaze
			local e = mk(pd, body, bodyCF, function(sz) return CFrame.new(0, -sz.Y * 0.4, sz.Z * 0.2) end)
			rig.groups.heads = rig.groups.heads or {}
			table.insert(rig.groups.heads, e)
		elseif r:find("wing") and (r:find("left") or r:find("right")) then
			local side = r:find("left") and -1 or 1
			local e = mk(pd, body, bodyCF, function(sz) return CFrame.new(-side * sz.X * 0.42, 0, 0) end)
			table.insert(rig.wings, { e = e, side = side, tier = 1 })
		elseif r:find("arm") and (r:find("left") or r:find("right")) then
			local side = r:find("left") and -1 or 1
			local e = mk(pd, body, bodyCF, function(sz) return CFrame.new(0, sz.Y * 0.4, 0) end)
			table.insert(rig.arms, { e = e, side = side })
		elseif r:find("tentacle") or r:find("fin") or r:find("tendril") or r:find("skirt") or r:find("robe") then
			table.insert(rig.tail, (mk(pd, body, bodyCF, function(sz) return CFrame.new(0, sz.Y * 0.4, 0) end)))
		elseif r:find("ear") then
			local e = mk(pd, head, headCF, function(sz) return CFrame.new(0, -sz.Y * 0.4, 0) end)
			table.insert(rig.ears, { e = e, side = r:find("left") and -1 or 1, kind = "mesh" })
		elseif onHead(r) then
			local e = mk(pd, head, headCF, function(sz) return CFrame.new(0, -sz.Y * 0.4, 0) end)
			if r:find("sprout") or r:find("antenna") or r:find("tuft") then table.insert(rig.bobbers, e) end
		elseif r == "halo" then
			table.insert(rig.halos, (mk(pd, head, headCF, nil)))
		elseif r:find("leg") then
			local e = mk(pd, body, bodyCF, function(sz) return CFrame.new(0, sz.Y * 0.4, 0) end)
			table.insert(rig.feet, e)
		elseif r:find("tail") then
			local fan = r == "nine tails"
			local e = mk(pd, body, bodyCF, function(sz) return fan and CFrame.new(0, -sz.Y * 0.35, -sz.Z * 0.4) or CFrame.new(0, 0, -sz.Z * 0.45) end)
			table.insert(rig.tail, e)
		elseif r:find("wing") then -- a single combined wing mesh: gentle sway only
			table.insert(rig.bobbers, (mk(pd, body, bodyCF, nil)))
		else
			mk(pd, body, bodyCF, nil)
		end
	end
	rig.legKind = #rig.feet >= 2 and "biped" or "none"
	rig.meshBuilt = true
end

-- Builds a creature model. Returns (model, rig). The model's PrimaryPart is an
-- anchored invisible "Root" at ground level, facing -Z. Move it with model:PivotTo().
function Builder.Build(creatureId: string, sizeMult: number?)
	local def = CreatureData.ById[creatureId]
	assert(def, "Unknown creature " .. tostring(creatureId))
	local prof = Profiles.Get(def.id)
	-- visual view of the definition: overrides never touch the shared CreatureData table
	local vd = setmetatable({}, { __index = def })
	for k, v in pairs(prof.over or {}) do vd[k] = v end
	vd._p, vd._s, vd._a = hex(def.c[1]), hex(def.c[2]), hex(def.c[3])
	local s = Config.Rarities[def.rarity].size * def.scale * (sizeMult or 1)

	local model = Instance.new("Model")
	model.Name = def.id
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 0.2, 1)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Parent = model
	model.PrimaryPart = root

	local function newRig()
		return {
			model = model, root = root, def = def, vd = vd, profile = prof, size = s,
			pal = { p = vd._p, s = vd._s, a = vd._a },
			all = {}, eyes = {}, pupils = {}, ears = {}, wings = {}, tail = {}, feet = {}, arms = {},
			halos = {}, bobbers = {}, emitters = {}, mouths = {}, chains = {}, groups = {}, legKind = "none",
			style = STYLE,
		}
	end
	local rig = newRig()
	local Models = require(script.Parent.SpeciesModels)
	local built = false
	if Models[def.id] then
		-- hand-authored, reference-faithful model (highest priority; no particle compensation).
		-- If it ever errors, fall back to the mesh/procedural build instead of spawning a broken pet.
		local ok, err = pcall(Models[def.id], H, rig, vd, s)
		if ok then
			built = true
			rig.handBuilt = true
		else
			warn("[CreatureBuilder] SpeciesModels." .. def.id .. " failed, using fallback: " .. tostring(err))
			for _, ch in ipairs(model:GetChildren()) do
				if ch ~= root then ch:Destroy() end
			end
			rig = newRig()
		end
	end
	if not built then
		local tmpl = meshTemplate(def.id)
		if tmpl then
			buildFromMeshes(rig, tmpl, MeshManifest[def.id], s)
			addEffects(rig, vd, rig.bodyRadius, s, prof)
		else
			buildBody(rig, vd, s, prof)
		end
	end
	model:SetAttribute("CreatureId", def.id)
	model:SetAttribute("Rarity", def.rarity)
	return model, rig
end

-- Bounding box of the VISIBLE geometry only (ignores invisible pivots, root, effect holders).
function Builder.VisualBounds(model: Model)
	local minV, maxV
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 0.95 and d.Name ~= "Root" and d.Name ~= "Orbit" then
			local cf, sz = d.CFrame, d.Size
			local m = d:FindFirstChildOfClass("SpecialMesh")
			if m then sz = sz * m.Scale end
			local half = sz / 2
			-- conservative AABB of the rotated box
			local r = cf.Rotation
			local ex = Vector3.new(
				math.abs(r.XVector.X) * half.X + math.abs(r.YVector.X) * half.Y + math.abs(r.ZVector.X) * half.Z,
				math.abs(r.XVector.Y) * half.X + math.abs(r.YVector.Y) * half.Y + math.abs(r.ZVector.Y) * half.Z,
				math.abs(r.XVector.Z) * half.X + math.abs(r.YVector.Z) * half.Y + math.abs(r.ZVector.Z) * half.Z)
			local lo, hi = cf.Position - ex, cf.Position + ex
			minV = minV and minV:Min(lo) or lo
			maxV = maxV and maxV:Max(hi) or hi
		end
	end
	if not minV then local cf, size = model:GetBoundingBox(); return cf, size end
	return CFrame.new((minV + maxV) / 2), maxV - minV
end

return Builder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">CreatureData</string><ProtectedString name="Source"><![CDATA[-- CreatureData: all 74 creatures (64 biome + 5 Secret + 5 Divine).
-- Location: ReplicatedStorage > Shared > CreatureData (ModuleScript)
--
-- Field reference (all used by CreatureBuilder / CreatureAnimator):
--   body  : round | quad | bird | slime | ghost | fish | dragon | bug | golem
--   move  : hop | walk | fly | float | slither
--   idle  : bounce | sway | spin | wiggle | proud | float | peek | dance
--   c     : { primary, secondary, accent } hex colours
--   ears  : none | round | pointy | bunny | floppy | cat | fin
--   horns : none | small | ram | antlers | unicorn | dragon
--   tail  : none | fluffy | flame | long | lollipop | fish | stinger | leaf | aurora
--   wings : none | feather | bat | bug | angel
--   extra : list of none | acorn | flower | leafsprout | crown | halo | helmet | crystal |
--           mane | spikes | antenna | shell | candy | rings | eyepatch | bow | snowcap | scarf
--   eyes  : big | sleepy | fierce | sparkle | cyclops | glow
--   mat   : material of the main body (default SmoothPlastic)
--   fx    : particle style for rare creatures
--   scale : extra size multiplier (on top of rarity size)
--   world : world id, or "Any" (portal-exclusive Secret/Divine creatures)

local L = {}
local function add(t) table.insert(L, t) end

---------------------------------------------------------------- GREEN FOREST
add{ id="Mossbun", name="Mossbun", rarity="Common", world="Forest", body="round", move="hop", idle="bounce",
	c={"#8BD86A","#F4FFE6","#4E9C3A"}, ears="bunny", tail="fluffy", eyes="big", extra={"leafsprout"},
	desc="A fluffy bunny that grows moss when it naps." }
add{ id="Acornip", name="Acornip", rarity="Uncommon", world="Forest", body="quad", move="walk", idle="peek",
	c={"#B9773F","#F6D9B0","#6B3F1C"}, ears="round", tail="fluffy", eyes="big", extra={"acorn"}, scale=0.9,
	desc="Wears its favourite acorn as a hat. Never takes it off." }
add{ id="Petalfly", name="Petalfly", rarity="Rare", world="Forest", body="bug", move="fly", idle="float",
	c={"#FF9AD5","#FFF3A6","#7A3BD1"}, wings="bug", eyes="sparkle", extra={"antenna"}, fx="sparkle",
	desc="Its wings are made of real flower petals." }
add{ id="Thornhog", name="Thornhog", rarity="Epic", world="Forest", body="quad", move="walk", idle="wiggle",
	c={"#C99B6D","#FFE9CF","#3FAA4A"}, ears="round", eyes="big", extra={"spikes","flower"}, fx="leaves",
	desc="Its spikes are soft leaves... mostly." }
add{ id="Elderstag", name="Elderstag Sprite", rarity="Legendary", world="Forest", body="quad", move="walk", idle="proud",
	c={"#EDE3C8","#FFFFFF","#7CFFB0"}, ears="pointy", horns="antlers", tail="fluffy", eyes="glow", fx="leaves", scale=1.1,
	desc="Ancient guardian of the forest. Its antlers glow at dusk." }
add{ id="Bloomwyrm", name="Bloomwyrm", rarity="Mythical", world="Forest", body="dragon", move="fly", idle="sway",
	c={"#5ED67A","#FFD6F0","#FF5FA8"}, horns="dragon", tail="leaf", wings="bat", eyes="fierce", extra={"flower"}, fx="sparkle",
	desc="A dragon that blooms a new flower with every breath." }

---------------------------------------------------------------- VOLCANO WORLD
add{ id="Emberpup", name="Emberpup", rarity="Common", world="Volcano", body="quad", move="walk", idle="wiggle",
	c={"#FF7A3D","#FFE0B8","#FFD13B"}, ears="pointy", tail="flame", eyes="big", fx="embers",
	desc="Wags its burning tail when happy. Keep away from curtains." }
add{ id="Magmite", name="Magmite", rarity="Uncommon", world="Volcano", body="slime", move="hop", idle="bounce",
	c={"#FF5A1F","#FFD04A","#3A1A10"}, eyes="big", mat="Neon", fx="embers",
	desc="A warm, gooey blob of living lava." }
add{ id="Cinderchick", name="Cinderchick", rarity="Rare", world="Volcano", body="bird", move="hop", idle="peek",
	c={"#FFB23B","#FFF0C2","#FF4A1A"}, wings="feather", tail="flame", eyes="big", extra={"leafsprout"}, fx="embers",
	desc="Its first chirp sparks a tiny campfire." }
add{ id="Obsidigolem", name="Obsidian Golem", rarity="Epic", world="Volcano", body="golem", move="walk", idle="proud",
	c={"#2A2230","#FF6A2A","#FFB14A"}, eyes="glow", extra={"crystal"}, mat="Slate", fx="embers", scale=1.1,
	desc="Lava flows through the cracks in its stone skin." }
add{ id="PhoenixLumen", name="Phoenix Lumen", rarity="Legendary", world="Volcano", body="bird", move="fly", idle="float",
	c={"#FF6B1A","#FFE45C","#FF2A6D"}, wings="feather", tail="flame", eyes="glow", extra={"crown"}, fx="fire", scale=1.1,
	desc="Reborn from its own ashes every sunrise." }
add{ id="Infernadrake", name="Infernadrake", rarity="Mythical", world="Volcano", body="dragon", move="fly", idle="proud",
	c={"#B3201A","#FFB347","#FFE14A"}, horns="dragon", tail="flame", wings="bat", eyes="fierce", extra={"spikes"}, fx="fire",
	desc="King of the volcano. Its roar melts rock." }

---------------------------------------------------------------- FROZEN KINGDOM
add{ id="Frostpaw", name="Frostpaw", rarity="Common", world="Frozen", body="round", move="hop", idle="wiggle",
	c={"#DDF3FF","#FFFFFF","#7EC8FF"}, ears="cat", tail="fluffy", eyes="big", extra={"scarf"},
	desc="Knits its own scarves. Very proud of them." }
add{ id="Snowpuff", name="Snowpuff", rarity="Uncommon", world="Frozen", body="round", move="hop", idle="bounce",
	c={"#FFFFFF","#E3F4FF","#9AD7FF"}, ears="round", eyes="sleepy", extra={"snowcap"}, fx="snow", scale=0.85,
	desc="A sleepy snowball that rolls everywhere." }
add{ id="IcicleOwl", name="Icicle Owl", rarity="Rare", world="Frozen", body="bird", move="fly", idle="peek",
	c={"#BFE6FF","#FFFFFF","#3B8BD6"}, ears="pointy", wings="feather", eyes="big", fx="snow",
	desc="Can turn its head all the way around. Showoff." }
add{ id="GlacierYeti", name="Glacier Yeti", rarity="Epic", world="Frozen", body="golem", move="walk", idle="dance",
	c={"#F4FBFF","#9AD9FF","#2D6FB0"}, horns="ram", eyes="big", mat="SmoothPlastic", fx="snow", scale=1.1,
	desc="Huge, fluffy, and loves to dance in blizzards." }
add{ id="AuroraFox", name="Aurora Fox", rarity="Legendary", world="Frozen", body="quad", move="walk", idle="sway",
	c={"#E8F7FF","#FFFFFF","#7CFFCB"}, ears="pointy", tail="aurora", eyes="glow", fx="sparkle",
	desc="Its tail paints the northern lights across the sky." }
add{ id="Crystalwing", name="Crystalwing Dragon", rarity="Mythical", world="Frozen", body="dragon", move="fly", idle="float",
	c={"#A6E4FF","#FFFFFF","#4AB8FF"}, horns="dragon", tail="long", wings="angel", eyes="glow", extra={"crystal"}, mat="Glass", fx="snow",
	desc="Every beat of its wings creates a snowflake." }

---------------------------------------------------------------- CRYSTAL CAVES
add{ id="Gemmy", name="Gemmy", rarity="Common", world="Crystal", body="slime", move="hop", idle="bounce",
	c={"#B07CFF","#E9D9FF","#5A2BA8"}, eyes="big", mat="Glass", extra={"crystal"},
	desc="A jelly with a tiny gem floating inside." }
add{ id="QuartzBeetle", name="Quartz Beetle", rarity="Uncommon", world="Crystal", body="bug", move="walk", idle="wiggle",
	c={"#E2E8F0","#9FE7FF","#3C4A6B"}, eyes="big", extra={"shell","antenna"}, mat="Glass",
	desc="Its shell sparkles like a disco ball." }
add{ id="GlimmerBat", name="Glimmer Bat", rarity="Rare", world="Crystal", body="round", move="fly", idle="float",
	c={"#5B3B8C","#FFC6F5","#C68BFF"}, ears="pointy", wings="bat", eyes="sparkle", fx="sparkle", scale=0.9,
	desc="Hangs upside down to watch the crystals glow." }
add{ id="AmethystEel", name="Amethyst Eel", rarity="Epic", world="Crystal", body="fish", move="slither", idle="sway",
	c={"#9B4DFF","#F2D6FF","#FF7AE6"}, ears="fin", tail="fish", eyes="glow", extra={"crystal"}, fx="sparkle",
	desc="Swims through solid rock like it's water." }
add{ id="PrismLion", name="Prism Lion", rarity="Legendary", world="Crystal", body="quad", move="walk", idle="proud",
	c={"#F6E7FF","#FFFFFF","#B66BFF"}, ears="round", tail="long", eyes="glow", extra={"mane","crystal"}, mat="SmoothPlastic", fx="rainbow", scale=1.1,
	desc="Its crystal mane splits light into rainbows." }
add{ id="GeodeLeviathan", name="Geode Leviathan", rarity="Mythical", world="Crystal", body="dragon", move="fly", idle="sway",
	c={"#3B2466","#FF8BF0","#7DF9FF"}, horns="dragon", tail="long", wings="bat", eyes="glow", extra={"crystal","spikes"}, fx="stars",
	desc="Sleeps for a thousand years inside a giant geode." }

---------------------------------------------------------------- CANDY WORLD
add{ id="Gumdrop", name="Gumdrop", rarity="Common", world="Candy", body="slime", move="hop", idle="bounce",
	c={"#FF5FA2","#FFD1E6","#FFFFFF"}, eyes="big", mat="Glass", extra={"candy"},
	desc="Covered in sugar crystals. Smells like strawberries." }
add{ id="CocoaCub", name="Cocoa Cub", rarity="Uncommon", world="Candy", body="round", move="walk", idle="dance",
	c={"#8A5232","#F2C8A0","#FF6FB1"}, ears="round", tail="none", eyes="big", extra={"bow"},
	desc="A chocolate bear who never melts... unless hugged too long." }
add{ id="Lollipup", name="Lollipup", rarity="Rare", world="Candy", body="quad", move="walk", idle="wiggle",
	c={"#FFF0F6","#FF5FA2","#5FD3FF"}, ears="floppy", tail="lollipop", eyes="big", extra={"bow"}, fx="hearts",
	desc="Its tail is a swirly lollipop. Do not lick." }
add{ id="Marshghost", name="Marshmallow Ghost", rarity="Epic", world="Candy", body="ghost", move="float", idle="float",
	c={"#FFFFFF","#FFE1F0","#FF9AC8"}, eyes="sleepy", fx="hearts",
	desc="The softest ghost in existence. Boo... please?" }
add{ id="Sugarcorn", name="Sugarcorn", rarity="Legendary", world="Candy", body="quad", move="walk", idle="proud",
	c={"#FFE3F2","#FFFFFF","#FF5FD0"}, ears="pointy", horns="unicorn", tail="aurora", eyes="sparkle", extra={"mane"}, fx="rainbow", scale=1.1,
	desc="Its horn is a candy cane that grants sweet wishes." }
add{ id="QueenBee", name="Candy Queen Bee", rarity="Mythical", world="Candy", body="bug", move="fly", idle="dance",
	c={"#FFD23B","#2A1A10","#FF6FB1"}, wings="bug", tail="stinger", eyes="sparkle", extra={"crown","antenna"}, fx="sparkle", scale=1.2,
	desc="Rules the honey-candy hives with a sticky fist." }

---------------------------------------------------------------- SPACE GALAXY
add{ id="AstroBlob", name="Astro Blob", rarity="Common", world="Space", body="slime", move="hop", idle="bounce",
	c={"#7CF2C8","#E6FFF6","#2B6B5A"}, eyes="big", extra={"helmet","antenna"},
	desc="An alien who wears a fishbowl for protection." }
add{ id="MoonMouse", name="Moon Mouse", rarity="Uncommon", world="Space", body="round", move="hop", idle="peek",
	c={"#C9CCE0","#FFFFFF","#FF9AC8"}, ears="round", tail="long", eyes="big", extra={"helmet"},
	desc="Convinced the moon is made of cheese. Still searching." }
add{ id="CometFish", name="Comet Fish", rarity="Rare", world="Space", body="fish", move="float", idle="sway",
	c={"#5BC0FF","#FFFFFF","#FFE45C"}, ears="fin", tail="flame", eyes="big", fx="stars",
	desc="Swims between stars, leaving a glittering trail." }
add{ id="NebulaJelly", name="Nebula Jelly", rarity="Epic", world="Space", body="ghost", move="float", idle="float",
	c={"#B06BFF","#FF8AE2","#5BE3FF"}, eyes="sparkle", mat="Glass", extra={"antenna"}, fx="stars",
	desc="A whole nebula swirls inside its glassy body." }
add{ id="StarWhale", name="Star Whale", rarity="Legendary", world="Space", body="fish", move="float", idle="sway",
	c={"#2B3B8C","#9FD3FF","#FFE45C"}, ears="fin", tail="fish", eyes="glow", extra={"rings"}, fx="stars", scale=1.5,
	desc="Sings songs that make new stars appear." }
add{ id="CosmicDragon", name="Cosmic Dragon", rarity="Mythical", world="Space", body="dragon", move="fly", idle="spin",
	c={"#1A1040","#7A5BFF","#FF5FD0"}, horns="dragon", tail="long", wings="bat", eyes="glow", extra={"rings"}, mat="Glass", fx="stars",
	desc="Made of stardust. Its scales are tiny galaxies." }

---------------------------------------------------------------- SHADOW DIMENSION
add{ id="Gloomling", name="Gloomling", rarity="Common", world="Shadow", body="ghost", move="float", idle="peek",
	c={"#3B2A55","#7A5BAA","#B78CFF"}, eyes="big", fx="smoke", scale=0.85,
	desc="Shy little shadow. Hides behind your legs." }
add{ id="ShadeCat", name="Shade Cat", rarity="Uncommon", world="Shadow", body="quad", move="walk", idle="sway",
	c={"#251A33","#5A3F7A","#C7FF5C"}, ears="cat", tail="long", eyes="glow",
	desc="Only its glowing eyes are visible at night." }
add{ id="NightMoth", name="Night Moth", rarity="Rare", world="Shadow", body="bug", move="fly", idle="float",
	c={"#4A3A6B","#D9C7FF","#8AF0FF"}, wings="bug", eyes="sparkle", extra={"antenna"}, fx="sparkle",
	desc="Attracted to the glow of portals." }
add{ id="VoidWisp", name="Void Wisp", rarity="Epic", world="Shadow", body="ghost", move="float", idle="spin",
	c={"#120A1E","#8A2BFF","#FF3BD4"}, eyes="cyclops", mat="Neon", fx="smoke",
	desc="A flicker of pure darkness with one curious eye." }
add{ id="UmbraWolf", name="Umbra Wolf", rarity="Legendary", world="Shadow", body="quad", move="walk", idle="proud",
	c={"#1E1630","#4B3570","#B44BFF"}, ears="pointy", tail="fluffy", eyes="fierce", extra={"spikes"}, fx="smoke", scale=1.15,
	desc="Howls at a moon that doesn't exist." }
add{ id="NightmareWyvern", name="Nightmare Wyvern", rarity="Mythical", world="Shadow", body="dragon", move="fly", idle="sway",
	c={"#0F0A18","#5A1A8C","#FF2A4D"}, horns="ram", tail="stinger", wings="bat", eyes="fierce", extra={"spikes"}, fx="smoke",
	desc="Born from the worst dream of a sleeping god." }

---------------------------------------------------------------- HEAVEN WORLD
add{ id="CloudLamb", name="Cloud Lamb", rarity="Common", world="Heaven", body="round", move="hop", idle="bounce",
	c={"#FFFFFF","#FFF4D6","#FFC8DD"}, ears="floppy", horns="ram", eyes="sleepy", extra={"mane"},
	desc="Its wool is a real cloud. It sometimes rains." }
add{ id="HaloChick", name="Halo Chick", rarity="Uncommon", world="Heaven", body="bird", move="hop", idle="peek",
	c={"#FFF6C2","#FFFFFF","#FFC94A"}, wings="angel", eyes="big", extra={"halo"}, fx="holy",
	desc="Took a halo from the lost & found. Kept it." }
add{ id="Seraphling", name="Seraphling", rarity="Rare", world="Heaven", body="round", move="fly", idle="float",
	c={"#FFEFD6","#FFFFFF","#FFD86B"}, ears="none", wings="angel", eyes="sparkle", extra={"halo"}, fx="holy",
	desc="A tiny angel in training. Still learning to fly straight." }
add{ id="GoldGriffin", name="Golden Griffin", rarity="Epic", world="Heaven", body="bird", move="fly", idle="proud",
	c={"#FFD24A","#FFF6D6","#C9881A"}, ears="pointy", wings="feather", tail="fluffy", eyes="fierce", extra={"crown"}, mat="Metal", fx="holy", scale=1.2,
	desc="Guards the golden gates. Accepts bribes in cookies." }
add{ id="Pegasus", name="Celestial Pegasus", rarity="Legendary", world="Heaven", body="quad", move="fly", idle="proud",
	c={"#FFFFFF","#E8F4FF","#FFD86B"}, ears="pointy", tail="aurora", wings="angel", eyes="sparkle", extra={"mane","halo"}, fx="holy", scale=1.15,
	desc="Gallops across rainbows at the speed of light." }
add{ id="ArchDrake", name="Archangel Drake", rarity="Mythical", world="Heaven", body="dragon", move="fly", idle="float",
	c={"#FFF8E6","#FFFFFF","#FFC23B"}, horns="unicorn", tail="long", wings="angel", eyes="glow", extra={"halo","crown"}, fx="holy",
	desc="The guardian dragon of Heaven's highest tower." }

---------------------------------------------------------------- SECRET (portal-exclusive, any world)
add{ id="Glitchling", name="Glitchling", rarity="Secret", world="Any", body="round", move="hop", idle="spin",
	c={"#00FFC8","#FF00AA","#000000"}, ears="cat", eyes="cyclops", mat="Neon", fx="glitch",
	desc="ERR0R: creature.exe has stopped responding." }
add{ id="VoidEmperor", name="Void Emperor", rarity="Secret", world="Any", body="golem", move="walk", idle="proud",
	c={"#05040A","#3D0066","#00FFD0"}, horns="ram", eyes="glow", extra={"crown","crystal"}, fx="glitch",
	desc="Ruler of the space between portals." }
add{ id="Errorcat", name="Error Cat", rarity="Secret", world="Any", body="quad", move="walk", idle="dance",
	c={"#FF00FF","#000000","#00FF66"}, ears="cat", tail="long", eyes="big", extra={"eyepatch"}, mat="Neon", fx="glitch",
	desc="It's here. It's there. It's... everywhere?" }

---------------------------------------------------------------- DIVINE (portal-exclusive, any world)
add{ id="Solaris", name="Solaris", rarity="Divine", world="Any", body="round", move="float", idle="spin",
	c={"#FFE14A","#FFFFFF","#FF9A1A"}, eyes="glow", extra={"halo","crown"}, mat="Neon", fx="holy",
	desc="A baby sun. Very warm hugs." }
