	desc="Every morning it sings the sun awake." }

---------------------------------------------------------------- EXTRA SECRET + DIVINE
add{ id="NullBunny", name="Null Bunny", rarity="Secret", world="Any", body="round", move="hop", idle="bounce",
	c={"#000000","#FFFFFF","#FF003C"}, ears="bunny", tail="fluffy", eyes="cyclops", extra={"halo"}, mat="Neon", fx="glitch",
	desc="Exists in every portal at once. Nobody knows where it comes from." }
add{ id="TheWatcher", name="The Watcher", rarity="Secret", world="Any", body="ghost", move="float", idle="peek",
	c={"#0A0014","#00FFC8","#FF00AA"}, eyes="cyclops", extra={"rings","spikes"}, fx="glitch", scale=1.3,
	desc="It has seen you throw every single portal." }
add{ id="Genesis", name="Genesis", rarity="Divine", world="Any", body="dragon", move="fly", idle="float",
	c={"#FFFFFF","#FFD86B","#B8F3FF"}, horns="unicorn", tail="aurora", wings="angel", eyes="glow", extra={"halo","crown","rings","crystal"}, mat="Neon", fx="holy",
	desc="The creature that dreamed up all the other creatures." }
add{ id="Infinity", name="Infinity Fox", rarity="Divine", world="Any", body="quad", move="float", idle="spin",
	c={"#1A0F4A","#FF8AE2","#7DF9FF"}, ears="pointy", tail="aurora", eyes="glow", wings="angel", extra={"halo","rings","mane"}, mat="Glass", fx="stars",
	desc="It has nine tails, and each one holds a whole universe." }

---------------------------------------------------------------- index
local CreatureData = { List = L, ById = {}, ByWorld = {} }
for _, c in ipairs(L) do
	c.extra = c.extra or {}
	c.ears = c.ears or "none"; c.horns = c.horns or "none"; c.tail = c.tail or "none"; c.wings = c.wings or "none"
	c.eyes = c.eyes or "big"; c.scale = c.scale or 1
	CreatureData.ById[c.id] = c
	CreatureData.ByWorld[c.world] = CreatureData.ByWorld[c.world] or {}
	table.insert(CreatureData.ByWorld[c.world], c)
end

local Config = require(script.Parent.Config)

-- Income per second for one creature (before training multiplier)
function CreatureData.Income(id: string): number
	local c = CreatureData.ById[id]
	if not c then return 0 end
	local r = Config.Rarities[c.rarity].income
	local w = c.world == "Any" and 1 or Config.Worlds[c.world].incomeMult
	if c.world == "Any" then w = 120 end
	return r * w
end

return CreatureData
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">CursorPolicy</string><ProtectedString name="Source"><![CDATA[-- Pure pointer policy, shared with native input regression fixtures.
local Policy = {}
function Policy.Resolve(s)
	local eligible = s.focused == true
		and s.mouse == true
		and s.inside == true
		and not s.menu
		and not s.text
		and not s.locked
	if not eligible or not s.loaded then
		return "Native", eligible
	end
	if s.charging and not s.hover then
		return "Charge", true
	end
	return s.hover and "Interact" or "Pointer", true
end
return Policy
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">ExpeditionBattle</string><ProtectedString name="Source"><![CDATA[-- Deterministic expedition battles. The same saved expedition (id, world, pet) always plays the same
-- fights, so the journey map, the HUD mini-map and the server's claim message agree without syncing
-- anything extra. Purely presentational: payouts stay in ExpeditionPlanner/ExpeditionService.
local Config = require(script.Parent.Config)
local Creatures = require(script.Parent.CreatureData)
local Battle = {}

-- Route through the biome vignette (x, z), shared with ExpeditionScene and the mini-map.
Battle.Path = { { -11, -6 }, { -6, -2 }, { 0, 1 }, { 6, 4 }, { 10, 6 } }

local RGB = Color3.fromRGB
-- kinds: imp (small horned biped), brute (big biped), beast (four legs), slime (blob), flyer (wings)
Battle.Monsters = {
	Forest = {
		body = RGB(96, 128, 66), accent = RGB(139, 98, 60), eye = RGB(255, 226, 92),
		minions = { { "Thorn Goblin", "imp" }, { "Bramble Boar", "beast" }, { "Moss Troll", "brute" } },
		boss = { "Ancient Treant", "brute" },
	},
	Volcano = {
		body = RGB(120, 52, 40), accent = RGB(255, 128, 40), eye = RGB(255, 236, 120),
		minions = { { "Magma Imp", "imp" }, { "Ash Lizard", "beast" }, { "Cinder Golem", "brute" } },
		boss = { "Lava Titan", "brute" },
	},
	Frozen = {
		body = RGB(170, 210, 230), accent = RGB(240, 248, 255), eye = RGB(60, 140, 220),
		minions = { { "Frost Goblin", "imp" }, { "Snow Wolf", "beast" }, { "Ice Troll", "brute" } },
		boss = { "Glacier Yeti", "brute" },
	},
	Crystal = {
		body = RGB(120, 96, 190), accent = RGB(110, 210, 220), eye = RGB(255, 255, 255),
		minions = { { "Shard Imp", "imp" }, { "Prism Bat", "flyer" }, { "Geode Golem", "brute" } },
		boss = { "Crystal Colossus", "brute" },
	},
	Candy = {
		body = RGB(240, 120, 170), accent = RGB(255, 236, 160), eye = RGB(60, 40, 70),
		minions = { { "Gummy Goblin", "imp" }, { "Jelly Slime", "slime" }, { "Taffy Troll", "brute" } },
		boss = { "Sugar King", "brute" },
	},
	Space = {
		body = RGB(70, 66, 120), accent = RGB(150, 230, 255), eye = RGB(170, 255, 140),
		minions = { { "Moon Slime", "slime" }, { "Star Imp", "imp" }, { "Meteor Golem", "brute" } },
		boss = { "Void Overlord", "brute" },
	},
	Shadow = {
		body = RGB(58, 46, 78), accent = RGB(150, 100, 200), eye = RGB(255, 70, 90),
		minions = { { "Shade Imp", "imp" }, { "Night Wolf", "beast" }, { "Bone Knight", "brute" } },
		boss = { "Wraith Lord", "flyer" },
	},
	Heaven = {
		body = RGB(236, 230, 210), accent = RGB(230, 186, 80), eye = RGB(80, 160, 255),
		minions = { { "Rogue Cherub", "flyer" }, { "Storm Spirit", "flyer" }, { "Gilded Golem", "brute" } },
		boss = { "Fallen Seraph", "flyer" },
	},
}

local function hash(s)
	local h = 5381
	for i = 1, #s do
		h = (h * 33 + string.byte(s, i)) % 2147483647
	end
	return h
end

local function rng(seed)
	local state = seed % 2147483646 + 1
	return function()
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
end

-- Position along the route; p in [0, 1], equal share per leg (matches ExpeditionScene).
function Battle.PathPoint(p)
	local n = #Battle.Path - 1
	local t = math.clamp(p, 0, 1) * n
	local i = math.min(n, math.floor(t) + 1)
	local a, b = Battle.Path[i], Battle.Path[i + 1]
	local f = t - (i - 1)
	return a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f, b[1] - a[1], b[2] - a[2]
end

-- Route parameter `studs` back along the path from p (where the pet stands to face a monster).
function Battle.Back(p, studs)
	local n = #Battle.Path - 1
	local left = studs
	while left > 0 and p > 0 do
		local i = math.min(n, math.floor(p * n - 1e-9) + 1)
		local a, b = Battle.Path[i], Battle.Path[i + 1]
		local legLen = math.sqrt((b[1] - a[1]) ^ 2 + (b[2] - a[2]) ^ 2)
		local legStart = (i - 1) / n
		local room = (p - legStart) * n * legLen
		if room >= left then
			return p - left / (legLen * n)
		end
		left -= room
		p = legStart
	end
	return math.max(0, p)
end

local BEAT_MAX, INTRO, LOOT_BEATS, RETURN_SHARE = 1.4, 2, 3, 0.15

function Battle.Plan(active)
	local world = Battle.Monsters[active.world] and active.world or "Forest"
	local theme = Battle.Monsters[world]
	local def = Creatures.ById[active.creature]
	local rarity = def and Config.Rarities[def.rarity]
	local order = rarity and rarity.order or 1
	local tier = table.find(Config.WorldOrder, world) or 1
	local duration = math.max(1, (active.endsAt or 0) - (active.startedAt or 0))
	local rand = rng(hash(tostring(active.id) .. "|" .. world .. "|" .. tostring(active.creature)))
	local function roll(lo, hi)
		return lo + (hi - lo) * rand()
	end

	-- A stronger pet (rarity, home biome) wins in fewer hits; a weak pet in a late biome has to retreat.
	local power = 1 + 0.4 * (order - 1) + ((def and def.world == world) and 0.4 or 0)
	local ratio = math.clamp(power / (0.7 + 0.3 * tier), 0.5, 3.5)
	local pet = {
		name = def and def.name or "Your pet",
		maxHp = 100,
		hp = 100,
		atk = 10 + 9 * ratio,
		crit = math.min(0.4, 0.12 + 0.03 * order),
		dodge = math.min(0.35, 0.08 + 0.025 * order),
	}

	local count = 4 + math.min(2, math.floor((tier - 1) / 3))
	local encounters = {}
	for i = 1, count do
		local pick = theme.minions[(i - 1) % #theme.minions + 1]
		if i > 1 and rand() < 0.45 then
			pick = theme.minions[math.floor(rand() * #theme.minions) + 1]
		end
		local hp = math.floor(38 + 6 * i + roll(0, 10))
		table.insert(encounters, {
			name = pick[1], kind = pick[2], boss = false,
			p = 0.1 + 0.72 * (i - 0.5) / count + roll(-0.015, 0.015),
			maxHp = hp, atk = math.min(24, (7 + i) / ratio),
		})
	end
	table.insert(encounters, {
		name = theme.boss[1], kind = theme.boss[2], boss = true, p = 0.9,
		maxHp = math.floor(110 + 8 * tier), atk = math.min(26, 12 / ratio),
	})

	-- Simulate every fight as a list of beats.
	local summary = { defeated = 0, crits = 0, dodges = 0, rests = 0, boss = theme.boss[1] }
	local fights = {}
	for index, enc in encounters do
		local monHp, beats, turn = enc.maxHp, {}, 0
		local startHp = pet.hp
		while monHp > 0 do
			turn += 1
			local crit = rand() < pet.crit
			local dmg = math.floor(pet.atk * roll(0.8, 1.2) * (crit and 1.8 or 1) + 0.5)
			if turn > 40 then
				dmg = monHp
			end
			monHp = math.max(0, monHp - dmg)
			summary.crits += crit and 1 or 0
			table.insert(beats, { who = "pet", dmg = dmg, crit = crit, petHp = pet.hp, monHp = monHp })
			if monHp <= 0 then
				break
			end
			local special = enc.boss and turn % 3 == 0
			local dodged = not special and rand() < pet.dodge
			local hit = dodged and 0 or math.floor(enc.atk * roll(0.8, 1.2) * (special and 2 or 1) + 0.5)
			summary.dodges += dodged and 1 or 0
			if hit >= pet.hp then
				-- The pet never dies: it backs off, recovers and comes back to finish the job.
				pet.hp = 0
				table.insert(beats, { who = "mon", dmg = hit, special = special, petHp = 0, monHp = monHp })
				pet.hp = pet.maxHp
				summary.rests += 1
				table.insert(beats, { who = "rest", petHp = pet.hp, monHp = monHp, len = 3 })
			else
				pet.hp -= hit
				table.insert(beats, { who = "mon", dmg = hit, special = special, dodged = dodged, petHp = pet.hp, monHp = monHp })
			end
		end
		summary.defeated += 1
		fights[index] = { beats = beats, startHp = startHp, endHp = pet.hp }
		-- walking to the next fight heals part of the damage
		pet.hp = math.min(pet.maxHp, pet.hp + math.floor(pet.maxHp * 0.35))
	end

	local totalBeats = LOOT_BEATS
	for _, f in fights do
		for _, b in f.beats do
			totalBeats += b.len or 1
		end
	end
	local back = duration * RETURN_SHARE
	local beat = math.max(0.05, math.min(BEAT_MAX, (duration * 0.55) / totalBeats))
	local intro = math.min(INTRO, duration * 0.05)
	local walkTotal = math.max(0, duration - intro - back - totalBeats * beat)

	-- Lay the segments out on the timeline (seconds since departure).
	local segments, t, p, hp = {}, 0, 0, pet.maxHp
	local function push(seg)
		seg.t0 = t
		t += seg.len
		seg.t1 = t
		table.insert(segments, seg)
	end
	push({ kind = "depart", len = intro, p0 = 0, p1 = 0, hp0 = hp, hp1 = hp })
	local stopAt = 0.92
	for index, enc in encounters do
		local stand = math.max(p, Battle.Back(enc.p, enc.boss and 3.4 or 2.4))
		push({ kind = "walk", len = walkTotal * (stand - p) / stopAt, p0 = p, p1 = stand, hp0 = hp, hp1 = fights[index].startHp, next = index })
		local len = 0
		for _, b in fights[index].beats do
			len += (b.len or 1) * beat
		end
		push({ kind = "fight", len = len, p0 = stand, p1 = stand, enc = index, beats = fights[index].beats, beat = beat, hp0 = fights[index].startHp })
		p, hp = stand, fights[index].endHp
	end
	push({ kind = "walk", len = walkTotal * math.max(0, stopAt - p) / stopAt, p0 = p, p1 = 1, hp0 = hp, hp1 = pet.maxHp })
	push({ kind = "loot", len = LOOT_BEATS * beat, p0 = 1, p1 = 1, hp0 = pet.maxHp, hp1 = pet.maxHp })
	push({ kind = "return", len = math.max(0, duration - t), p0 = 1, p1 = 0, hp0 = pet.maxHp, hp1 = pet.maxHp })

	return {
		world = world, theme = theme, pet = pet, encounters = encounters, segments = segments,
		duration = duration, beat = beat, summary = summary,
	}
end

local function lerp(a, b, f)
	return a + (b - a) * f
end

-- State of the journey `elapsed` seconds after departure.
function Battle.At(plan, elapsed)
	local segs = plan.segments
	local seg = segs[#segs]
	for _, s in segs do
		if elapsed < s.t1 then
			seg = s
			break
		end
	end
	local f = seg.len > 0 and math.clamp((elapsed - seg.t0) / seg.len, 0, 1) or 1
	local name = plan.pet.name
	local state = {
		kind = seg.kind, p = lerp(seg.p0, seg.p1, f), dir = seg.p1 < seg.p0 and -1 or 1,
		hp = plan.pet.maxHp, maxHp = plan.pet.maxHp, cleared = 0, f = f,
	}
	for i, enc in plan.encounters do
		local done = false
		for _, s in segs do
			if s.kind == "fight" and s.enc == i and s.t1 <= elapsed then
				done = true
			end
		end
		if done then
			state.cleared = i
		end
	end
	if elapsed >= plan.duration then
		state.kind, state.p, state.dir, state.cleared = "done", 0, -1, #plan.encounters
		state.text = name .. " is back with the loot!"
		return state
	end
	if seg.kind == "fight" then
		local enc = plan.encounters[seg.enc]
		local at, beats = (elapsed - seg.t0) / seg.beat, seg.beats
		local pos, cur, phase = 0, nil, 0
		local prevPet, prevMon = seg.hp0, enc.maxHp
		for _, b in beats do
			local len = b.len or 1
			if at < pos + len then
				cur, phase = b, (at - pos) / len
				break
			end
			pos += len
			prevPet, prevMon = b.petHp, b.monHp
		end
		cur = cur or beats[#beats]
		state.enc, state.beat, state.phase = seg.enc, cur, phase
		-- damage lands halfway through the swing
		local landed = phase >= 0.45
		state.hp = landed and cur.petHp or prevPet
		state.monHp = landed and cur.monHp or prevMon
		state.monMax = enc.maxHp
		if cur.who == "pet" then
			state.text = (cur.crit and "CRITICAL! " or "") .. name .. " hits " .. enc.name .. " for " .. cur.dmg
			if cur.monHp <= 0 and landed then
				state.text = enc.name .. " defeated!"
			end
		elseif cur.who == "rest" then
			state.text = name .. " backs off to recover..."
			state.hp = math.floor(lerp(0, cur.petHp, phase))
		elseif cur.dodged then
			state.text = name .. " dodged " .. enc.name .. "!"
		else
			state.text = enc.name .. (cur.special and " uses SLAM for " or " strikes back for ") .. cur.dmg
		end
	else
		state.hp = math.floor(lerp(seg.hp0, seg.hp1 or seg.hp0, f) + 0.5)
		if seg.kind == "depart" then
			state.text = name .. " steps through the portal"
		elseif seg.kind == "walk" then
			local nxt = seg.next and plan.encounters[seg.next]
			state.text = nxt and (nxt.boss and "Boss ahead: " .. nxt.name .. "!" or "Tracking a " .. nxt.name .. "...")
				or "Heading for the relic shrine"
		elseif seg.kind == "loot" then
			state.text = "Relic recovered!"
		else
			state.text = "Heading home with the loot"
		end
	end
	return state
end

function Battle.Summary(active)
	local ok, plan = pcall(Battle.Plan, active)
	return ok and plan.summary or nil
end

return Battle
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">ExpeditionConfig</string><ProtectedString name="Source"><![CDATA[-- Shared mission descriptions and fallback values. Live pacing/reward scales
-- are read by ExpeditionService on the server, never by clients.
local Config = require(script.Parent.Config)
local Rules = {
	Order = table.clone(Config.WorldOrder),
	ById = {},
	TableRange = 12,
	IncomeFraction = 0.8,
	MatchingBiomeMultiplier = 1.25,
}

local pacing = {
	Forest = { 90, 120 },
	Volcano = { 120, 300 },
	Frozen = { 150, 600 },
	Crystal = { 180, 1200 },
	Candy = { 210, 2000 },
	Space = { 240, 4000 },
	Shadow = { 270, 8000 },
	Heaven = { 300, 16000 },
}

for _, id in Rules.Order do
	local values = pacing[id]
	Rules.ById[id] = {
		id = id,
		world = id,
		name = Config.Worlds[id].name .. " Expedition",
		duration = values[1],
		coins = values[2],
	}
end

return Rules
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">ExpeditionPlanner</string><ProtectedString name="Source"><![CDATA[-- Shared payout arithmetic and scout suggestions. Server validates every action.
local Creatures = require(script.Parent.CreatureData)
local Variants = require(script.Parent.Variants)
local Rules = require(script.Parent.ExpeditionConfig)
local Planner = { MaxReward = 1e12 }

function Planner.Quote(pet, route)
	local creature = pet and Creatures.ById[pet.c]
	if not creature or not route then
		return nil
	end
	local matched = creature.world == route.world
	local multiplier = matched and (route.matchMultiplier or Rules.MatchingBiomeMultiplier) or 1
	local income = Creatures.Income(pet.c) * Variants.Mult(pet.s, pet.v)
	local coins = (route.coins + income * route.duration * (route.incomeCoinsPerSecond or Rules.IncomeFraction))
		* multiplier
	return {
		coins = math.clamp(math.floor(coins), 0, Planner.MaxReward),
		matched = matched,
		bonusPercent = math.floor((multiplier - 1) * 100 + 0.5),
	}
end

function Planner.Commitment(data, uid)
	local placed = table.find(data.Placed or {}, uid) ~= nil
	local equipped = table.find(data.EquippedPets or {}, uid) ~= nil
	if placed and equipped then
		return 3, "Garden + follower", "Garden income pauses; follower unequips."
	elseif equipped then
		return 2, "Following pet", "Follower unequips on departure."
	elseif placed then
		return 1, "Garden pet", "Garden income pauses until you claim."
	end
	return 0, "Stored pet", "Stored pet / garden income keeps earning."
end

-- Prefer an idle stored pet so the suggestion doesn't sacrifice garden income
-- or a follower buff. Within that group, prefer a biome match, then the payout.
-- This is a starting suggestion; explicit player selections remain untouched.
function Planner.Suggest(data, route)
	local best, bestCost, bestQuote
	for _, pet in data.Creatures or {} do
		local away = data.Expeditions and data.Expeditions.active
		if not away or away.petUid ~= pet.u then
			local quote = Planner.Quote(pet, route)
			if quote then
				local cost = Planner.Commitment(data, pet.u)
				if
					not best
					or cost < bestCost
					or (cost == bestCost and quote.matched and not bestQuote.matched)
					or (cost == bestCost and quote.matched == bestQuote.matched and quote.coins > bestQuote.coins)
				then
					best, bestCost, bestQuote = pet, cost, quote
				end
			end
		end
	end
	return best and best.u
end

function Planner.DefaultRoute(routes, relics)
	local first
	for i, route in routes or {} do
		if route.unlocked then
			first = first or i
			if not (relics and relics[route.world]) then
				return i
			end
		end
	end
	return first or 1
end

return Planner
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">FarmCare</string><ProtectedString name="Source"><![CDATA[-- Pure farm rules shared by server logic and regression fixtures. No player saves or services.
local Farm = require(script.Parent.FarmConfig)
local Care = {}

-- A meal uses at most five ordinary items before rarer food. Partial meals count toward Well Fed.
-- Max-level pets can still eat to renew the courtyard buff; absent pets cannot consume food.
function Care.Feed(farm, pets, foodValue, now)
	local result = { count = 0, ups = 0, wellFed = false }
	if #pets == 0 then
		return result
	end
	local items = {}
	for key, count in pairs(farm.Pantry) do
		local food = foodValue(key)
		if food and food > 0 and type(count) == "number" and count > 0 then
			table.insert(items, { key = key, count = math.floor(count), food = food })
		end
	end
	table.sort(items, function(a, b)
		return a.food < b.food or (a.food == b.food and a.key < b.key)
	end)
	for _, item in ipairs(items) do
		for _ = 1, math.min(item.count, Farm.WellFed.min - result.count) do
			local pet
			for _, candidate in ipairs(pets) do
				if
					(candidate.l or 1) < Farm.PetMaxLevel
					and (
						not pet
						or (candidate.l or 1) < (pet.l or 1)
						or ((candidate.l or 1) == (pet.l or 1) and (candidate.e or 0) < (pet.e or 0))
					)
				then
					pet = candidate
				end
			end
			if pet then
				pet.l = pet.l or 1
				pet.e = (pet.e or 0) + item.food
				while pet.l < Farm.PetMaxLevel and pet.e >= Farm.PetXpToNext(pet.l) do
					pet.e -= Farm.PetXpToNext(pet.l)
					pet.l += 1
					result.ups += 1
					result.star = pet
				end
				if pet.l == Farm.PetMaxLevel then
					pet.e = 0
				end
			end
			farm.Pantry[item.key] -= 1
			if farm.Pantry[item.key] <= 0 then
				farm.Pantry[item.key] = nil
			end
			result.count += 1
		end
		if result.count >= Farm.WellFed.min then
			break
		end
	end
	farm.Fed = (farm.Fed or 0) + result.count
	local progress = (farm.FedProgress or 0) + result.count
	if progress >= Farm.WellFed.min then
		farm.FedUntil = now + Farm.WellFed.duration
		progress %= Farm.WellFed.min
		result.wellFed = true
	end
	farm.FedProgress = progress
	return result
end

-- Apply only the elapsed online rain interval. Ripe crops never acquire extra backdated time.
function Care.ApplyRain(plot, duration, from, now, speed)
	local start = math.max(from, plot.t)
	local remaining = plot.t + duration - start
	if speed <= 1 or remaining <= 0 or now <= start then
		return 0
	end
	local bonus = math.min((now - start) * (speed - 1), remaining * (speed - 1) / speed)
	plot.t -= bonus
	return bonus
end

function Care.WeatherApplies(plantedAt, startedAt, endsAt)
	return startedAt ~= nil and plantedAt >= startedAt and plantedAt < endsAt
end

return Care
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">FarmConfig</string><ProtectedString name="Source"><![CDATA[-- FarmConfig: the courtyard farm, Farmer Level, bounties and daily gift. Tune everything here.
-- Location: ReplicatedStorage > Shared > FarmConfig (ModuleScript)
--
-- Prices and yields are multiplied by the player's "soil quality" = the income multiplier of their
-- best unlocked world (Config.Worlds[id].incomeMult), so farming stays worth it all game long.
-- Longer crops pay more per second: planting a 12 h crop before logging off is the best move.
local C = Color3.fromRGB

local Farm = {}

Farm.Crops = {
	{ id = "Moonberry", name = "Moonberry", cost = 20, grow = 45, sell = 70, xp = 4, level = 1,
		stem = C(92, 140, 70), leaf = C(110, 170, 72), fruit = C(150, 110, 230), shape = "berries", size = 0.8 },
	{ id = "Sunwheat", name = "Sunwheat", cost = 120, grow = 180, sell = 520, xp = 12, level = 2,
		stem = C(196, 170, 92), leaf = C(214, 186, 96), fruit = C(242, 202, 90), shape = "wheat", size = 1.0 },
	{ id = "Starmelon", name = "Starmelon", cost = 900, grow = 900, sell = 4800, xp = 45, level = 4,
		stem = C(84, 140, 66), leaf = C(102, 160, 70), fruit = C(120, 200, 150), shape = "melon", size = 1.3 },
	{ id = "PortalPumpkin", name = "Portal Pumpkin", cost = 6000, grow = 3600, sell = 42000, xp = 160, level = 6,
		stem = C(70, 120, 56), leaf = C(96, 150, 64), fruit = C(150, 84, 230), shape = "pumpkin", size = 1.6 },
	{ id = "CrystalBloom", name = "Crystal Bloom", cost = 40000, grow = 14400, sell = 330000, xp = 600, level = 9,
		stem = C(120, 150, 180), leaf = C(150, 200, 220), fruit = C(110, 220, 240), shape = "crystal", size = 1.4 },
	{ id = "VoidLotus", name = "Void Lotus", cost = 250000, grow = 43200, sell = 2400000, xp = 2000, level = 12,
		stem = C(60, 40, 90), leaf = C(90, 60, 140), fruit = C(240, 120, 220), shape = "lotus", size = 1.5 },
}
Farm.ById = {}
for i, c in ipairs(Farm.Crops) do
	c.order = i
	Farm.ById[c.id] = c
end

Farm.StartPlots = 3
Farm.PlotPrices = { 800, 8000, 80000 } -- 4th, 5th and 6th beds (not soil-scaled: a one-off investment)
Farm.MaxPlots = 6

-- Sprinklers: each level makes every crop grow 8% faster
Farm.SprinklerCut = 0.08
Farm.SprinklerPrices = { 1500, 12000, 90000, 700000, 5000000 }

-- Harvest Spirit: harvests ready crops on its own (into the Treasury) and replants the same seed,
-- also while you are offline. The 24/7 farm.
Farm.SpiritPrice = 250000
Farm.SpiritLevel = 5
Farm.SpiritMaxCyclesPerTick = 24 -- catch-up cap per bed when you log back in

-- yield bonuses (sale value of produce)
Farm.LevelBonus = 0.05 -- +5% per Farmer Level above 1
Farm.PetBonus = 0.015 -- +1.5% per pet placed in your courtyard (they tend the garden)

-- Mutations: rolled when you PLANT, so you can watch a lucky one grow. Checked rarest first.
-- mult scales both the sale value and the food value. Watered gets likelier with each Sprinkler.
Farm.Mutations = {
	{ id = "Rainbow", chance = 0.003, mult = 40, color = C(255, 120, 210) },
	{ id = "Giant", chance = 0.015, mult = 10, color = C(255, 190, 80), scale = 1.55 },
	{ id = "Golden", chance = 0.08, mult = 3, color = C(255, 205, 70) },
	{ id = "Watered", chance = 0, perSprinkler = 0.05, mult = 1.5, color = C(110, 190, 240) },
}
Farm.MutationById = {}
for _, m in ipairs(Farm.Mutations) do
	Farm.MutationById[m.id] = m
end

-- Crop Almanac: every crop x mutation you harvest (6 x 5 = 30) is recorded on the board in your
-- lodge. Each discovery permanently adds AlmanacBonus to all produce value and food value.
Farm.AlmanacColumns = { "", "Watered", "Golden", "Giant", "Rainbow" } -- "" = no mutation
Farm.AlmanacBonus = 0.02
Farm.AlmanacXp = 20 -- Farmer XP per discovery, times the crop's tier

-- Harvests go to your Pantry: feed them to your pets (Feeding Trough, E) or sell them (R).
Farm.PantryCap = 300 -- past this, extra produce is sold automatically
Farm.FeedXpPerCropXp = 4 -- pet XP per food = crop.xp * this * mutation mult

-- Weather: a server-wide event every 12-18 minutes. Being online (and planting) during one pays.
-- boost multiplies a mutation's planting chance; flat adds to it; growSpeed speeds up every crop.
Farm.Weather = {
	{ id = "Rain", name = "Rain", weight = 40, duration = 240, growSpeed = 1.5, flat = { Watered = 0.35 },
		desc = "Crops grow 50% faster  ·  lots of Watered crops" },
	{ id = "GoldenHour", name = "Golden Hour", weight = 30, duration = 180, boost = { Golden = 4 },
		desc = "Golden mutations x4 when you plant" },
	{ id = "Starfall", name = "Starfall", weight = 22, duration = 180, boost = { Giant = 4 },
		desc = "Giant mutations x4 when you plant" },
	{ id = "Aurora", name = "Rainbow Aurora", weight = 8, duration = 120, boost = { Rainbow = 8 },
		desc = "Rainbow mutations x8 when you plant" },
}
Farm.WeatherById = {}
for _, w in ipairs(Farm.Weather) do
	Farm.WeatherById[w.id] = w
end
Farm.WeatherGap = { 720, 1080 } -- seconds between events
Farm.WeatherFirst = 150 -- first event this long after the server starts

-- Well Fed: feeding at least `min` food gives your whole courtyard +20% income for 30 minutes
Farm.WellFed = { min = 5, duration = 1800, income = 0.2 }

-- Market Demand: every 20 minutes one crop sells for double
Farm.DemandEvery = 1200
Farm.DemandMult = 2

-- Pet levels: each level adds income to that pet. Food always goes to your lowest-level pet first.
Farm.PetLevelIncome = 0.06 -- +6% income per pet level above 1
Farm.PetMaxLevel = 100
function Farm.PetXpToNext(level)
	return math.floor(30 * level ^ 1.6)
end
function Farm.PetMult(level)
	return 1 + Farm.PetLevelIncome * (math.clamp(level or 1, 1, Farm.PetMaxLevel) - 1)
end

-- Farmer Level: XP from harvests and catches
function Farm.XpToNext(level)
	return math.floor(40 * level ^ 1.7)
end
Farm.CatchXp = { Common = 2, Uncommon = 3, Rare = 6, Epic = 12, Legendary = 30, Mythical = 80, Secret = 250, Divine = 600 }

-- Bounties: three at a time on the courtyard board
Farm.BountySlots = 3

-- Daily gift: claim every 20 h; the streak breaks after 48 h. Day 7 is the big one, then it loops.
Farm.DailyCooldown = 20 * 3600
Farm.DailyStreakWindow = 48 * 3600
Farm.DailyMult = { 1, 1.5, 2, 2.5, 3, 4, 8 }

return Farm
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">ForgeRules</string><ProtectedString name="Source"><![CDATA[-- Shared recipes and pure transaction rules. Only the server commits real profiles.
local Creatures = require(script.Parent.CreatureData)
local Rules = {}
Rules.Chances = { [2] = 0.44, [3] = 0.66, [4] = 0.88, [5] = 1 }
Rules.Input = { Gold = "", Ruby = "Gold" }
Rules.Stations = { Gold = Vector3.new(-12, 2, -251), Ruby = Vector3.new(12, 2, -251) }
Rules.Door = Vector3.new(0, 2, -197)
Rules.Range = 30
Rules.HistoryLimit = 16

function Rules.Protected(data, pet, isAway)
	return pet.locked
		or pet.Locked
		or pet.favorite
		or pet.Favorite
		or table.find(data.EquippedPets or {}, pet.u) ~= nil
		or (isAway and isAway(pet.u))
end

function Rules.Plan(data, uids, target, isAway)
	if Rules.Input[target] == nil then
		return nil, "Choose Gold or Ruby."
	end
	if type(uids) ~= "table" or not Rules.Chances[#uids] then
		return nil, "Select 2 to 5 matching pets."
	end
	local entries, seen, keys, exemplar = {}, {}, 0, nil
	for index, uid in pairs(uids) do
		keys += 1
		if
			type(index) ~= "number"
			or index % 1 ~= 0
			or index < 1
			or index > #uids
			or type(uid) ~= "number"
			or uid ~= uid
			or uid % 1 ~= 0
			or seen[uid]
		then
			return nil, "Select each pet only once."
		end
		seen[uid] = true
		local pet
		for _, owned in ipairs(data.Creatures) do
			if owned.u == uid then
				pet = owned
				break
			end
		end
		if not pet or not Creatures.ById[pet.c] then
			return nil, "A selected pet is no longer owned."
		end
		if Rules.Protected(data, pet, isAway) then
			return nil, "Unfollow or unlock pets first. Expedition pets cannot be forged."
		end
		if (pet.v or "") ~= Rules.Input[target] then
			return nil, target == "Gold" and "Gold requires ordinary pets." or "Ruby requires Gold pets."
		end
		if exemplar and (pet.c ~= exemplar.c or (pet.s or "") ~= (exemplar.s or "")) then
			return nil, "Match the species and size of every selected pet."
		end
		exemplar = exemplar or pet
		table.insert(entries, pet)
	end
	if keys ~= #uids then
		return nil, "Invalid selection."
	end
	return {
		entries = entries,
		consumed = seen,
		target = target,
		chance = Rules.Chances[#uids],
		count = #uids,
		pet = exemplar,
	}
end

function Rules.Attempt(data, request, isAway, newUid, roll)
	if
		type(request) ~= "table"
		or type(request.id) ~= "string"
		or #request.id < 8
		or #request.id > 64
		or not request.id:match("^[%w_%-]+$")
	then
		return false, "Invalid forge request."
	end
	for _, receipt in ipairs(data.ForgeReceipts or {}) do
		if receipt.id == request.id then
			return true, receipt.message, receipt, true
		end
	end
	local plan, message = Rules.Plan(data, request.uids, request.target, isAway)
	if not plan then
		return false, message
	end
	-- No yield between validation and mutation. Chance and output are server-owned.
	local succeeded = plan.chance == 1 or roll() < plan.chance
	local level, xp = 1, 0
	for _, pet in ipairs(plan.entries) do
		if (pet.l or 1) > level or ((pet.l or 1) == level and (pet.e or 0) > xp) then
			level, xp = pet.l or 1, pet.e or 0
		end
	end
	for i = #data.Creatures, 1, -1 do
		if plan.consumed[data.Creatures[i].u] then
			table.remove(data.Creatures, i)
		end
	end
	for _, field in ipairs({ "Placed", "EquippedPets" }) do
		for i = #(data[field] or {}), 1, -1 do
			if plan.consumed[data[field][i]] then
				table.remove(data[field], i)
			end
		end
	end
	local output
	if succeeded then
		output = { u = newUid(), c = plan.pet.c, s = plan.pet.s, v = plan.target, l = level, e = xp }
		table.insert(data.Creatures, output)
	end
	local name = Creatures.ById[plan.pet.c].name
	message = succeeded and ("Forged " .. plan.target .. " " .. name .. ".")
		or ("Forge failed. " .. plan.count .. " selected pets were consumed.")
	local receipt = {
		id = request.id,
		succeeded = succeeded,
		count = plan.count,
		chance = plan.chance,
		target = plan.target,
		species = plan.pet.c,
		uid = output and output.u,
		message = message,
	}
	data.ForgeReceipts = data.ForgeReceipts or {}
	table.insert(data.ForgeReceipts, receipt)
	while #data.ForgeReceipts > Rules.HistoryLimit do
		table.remove(data.ForgeReceipts, 1)
	end
	data.LastForge = receipt
	return true, message, receipt, false
end

return Rules
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[-- Format: number formatting helpers.
-- Location: ReplicatedStorage > Shared > Format (ModuleScript)
local Format = {}
local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Format.Short(n: number): string
	n = tonumber(n) or 0
	if n < 1000 then
		return tostring(math.floor(n))
	end
	local i = math.min(math.floor(math.log10(n) / 3), #SUFFIX - 1)
	local v = n / 10 ^ (i * 3)
	local s = v >= 100 and string.format("%d", math.floor(v))
		or (
			v >= 10 and string.format("%.1f", math.floor(v * 10) / 10)
			or string.format("%.2f", math.floor(v * 100) / 100)
		)
	if s:find("%.") then
		s = s:gsub("0+$", ""):gsub("%.$", "")
	end
	return s .. SUFFIX[i + 1]
end

function Format.Money(n: number): string
	return "$" .. Format.Short(n)
end

-- Preserve small improvements in income rates; bank balances still use compact whole coins.
function Format.Rate(n: number): string
	if n >= 1000 then
		return Format.Money(n)
	end
	local amount = string.format("%.2f", n):gsub("0+$", ""):gsub("%.$", "")
	return "$" .. amount
end

return Format
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">GuideKnight</string><ProtectedString name="Source"><![CDATA[-- Original block-built knight used in the hall and in the guide's portrait.
local Knight = {}
function Knight.Build()
	local model = Instance.new("Model")
	model.Name = "SirRowan"
	local C, V, CF = Color3.fromRGB, Vector3.new, CFrame.new
	local steel, dark, brass, jade = C(170, 181, 183), C(48, 59, 63), C(190, 153, 78), C(37, 87, 73)
	local function part(name, size, cf, color, material, shape)
		local p = Instance.new(shape == "wedge" and "WedgePart" or "Part")
		p.Name, p.Size, p.CFrame, p.Color = name, size, cf, color
		p.Material = material or Enum.Material.Metal
		p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = true, false, false, false
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	local root = part("Root", V(0.2, 0.2, 0.2), CF(), dark)
	root.Transparency = 1
	model.PrimaryPart = root
	for _, side in { -1, 1 } do
		part("Boot", V(0.8, 0.6, 1.15), CF(side * 0.52, 0.3, -0.12), dark)
		part("Greave", V(0.68, 1.45, 0.72), CF(side * 0.52, 1.23, 0), steel)
		part("KneeGuard", V(0.82, 0.55, 0.22), CF(side * 0.52, 1.7, -0.46), brass)
		part("Tasset", V(0.9, 1.0, 0.24), CF(side * 0.52, 2.1, -0.5) * CFrame.Angles(-0.12, 0, side * 0.08), steel)
		part("Arm", V(0.65, 1.55, 0.74), CF(side * 1.3, 2.9, 0), dark)
		part("Gauntlet", V(0.72, 0.7, 0.82), CF(side * 1.3, 2.35, -0.02), steel)
		part("Pauldron", V(1.1, 0.72, 1.2), CF(side * 1.25, 3.8, 0), steel)
		part("ShoulderRim", V(1.18, 0.16, 1.26), CF(side * 1.25, 3.5, 0), brass)
	end
	part("Surcoat", V(1.7, 1.95, 0.92), CF(0, 2.9, 0.12), jade, Enum.Material.Fabric)
	part("Breastplate", V(1.8, 1.5, 0.42), CF(0, 3.2, -0.5), steel)
	part("BreastRidge", V(0.14, 1.4, 0.13), CF(0, 3.2, -0.76), brass)
	part("Belt", V(1.95, 0.23, 1.22), CF(0, 2.35, 0), dark)
	part("Buckle", V(0.37, 0.33, 0.13), CF(0, 2.35, -0.67), brass)
	part("Cloak", V(1.9, 2.95, 0.24), CF(0, 2.35, 0.74) * CFrame.Angles(-0.12, 0, 0), jade, Enum.Material.Fabric)
	part("Gorget", V(1.3, 0.4, 1.15), CF(0, 4.03, 0), brass)
	part("Head", V(1.35, 1.35, 1.28), CF(0, 4.85, 0), steel)
	part("HelmetCrown", V(1.42, 0.25, 1.35), CF(0, 5.5, 0), dark)
	part("VisorSlit", V(1.15, 0.18, 0.08), CF(0, 4.99, -0.68), dark)
	part("NasalGuard", V(0.16, 0.9, 0.14), CF(0, 4.8, -0.74), brass)
	for _, x in { -0.45, -0.26, 0.26, 0.45 } do
		part("VisorVent", V(0.07, 0.28, 0.06), CF(x, 4.6, -0.68), dark)
	end
	for i = 0, 3 do
		part("HelmetPlume", V(0.3, 0.7 - i * 0.08, 0.4), CF(0, 5.85 - i * 0.12, i * 0.31), jade, Enum.Material.Fabric)
	end
	part("Shield", V(1.1, 1.85, 0.23), CF(-1.45, 2.7, -0.65), brass)
	part("ShieldFace", V(0.91, 1.63, 0.1), CF(-1.45, 2.7, -0.83), jade)
	part("ShieldSigil", V(0.4, 0.4, 0.12), CF(-1.45, 2.8, -0.94) * CFrame.Angles(0, 0, math.pi / 4), brass)
	part("SwordGrip", V(0.18, 0.65, 0.2), CF(1.3, 2.5, -0.5), dark)
	part("SwordGuard", V(0.8, 0.13, 0.24), CF(1.3, 2.1, -0.5), brass)
	part("SwordBlade", V(0.26, 1.8, 0.13), CF(1.3, 1.16, -0.5), steel)
	return model
end
return Knight
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">ModelKit</string><ProtectedString name="Source"><![CDATA[-- ModelKit: shared construction helpers for the hand-authored SpeciesModels (Volcano / Candy / Crystal).
-- Location: ReplicatedStorage > Shared > ModelKit (ModuleScript)
--
-- All sizes and positions are in creature units (multiplied by the rarity size `s`). Models face -Z,
-- ground is y = 0, +X is the creature's "side = 1". Every helper fills the standard rig channels that
-- CreatureAnimator drives: bodyEntry/body, headEntry/head, feet (+knee), ears, eyes, wings, arms,
-- tail, chains, groups, glows.

local K = {}
local V3, CF, ANG = Vector3.new, CFrame.new, CFrame.Angles
local PI = math.pi
local MAT = Enum.Material
K.V3, K.CF, K.ANG, K.PI, K.MAT = V3, CF, ANG, PI, MAT

function K.C(h) return Color3.fromHex(h) end

function K.new(H, rig, s)
	local k = { H = H, rig = rig, s = s }
	rig.glows = rig.glows or {}

	function k.v(x, y, z) return V3(x, y, z) * s end
	function k.c(x, y, z) return CF(x * s, y * s, z * s) end
	-- scaled copy of a CFrame given in units
	function k.sc(cf) return cf - cf.Position + cf.Position * s end

	---------------------------------------------------------------- primitives (sizes in units, cf already scaled)
	function k.b(parent, name, x, y, z, col, cf, mat, tr, c1) return H.blk(rig, parent, name, V3(x, y, z) * s, col, cf, mat, tr, c1) end
	function k.w(parent, name, x, y, z, col, cf, mat, tr, c1) return H.wdg(rig, parent, name, V3(x, y, z) * s, col, cf, mat, tr, c1) end
	function k.tri(parent, name, thick, h, base, col, cf, mat, tr) H.tri(rig, parent, name, thick * s, h * s, base * s, col, cf, mat, tr) end
	function k.spike(parent, name, len, base, col, cf, mat, tr) H.spike(rig, parent, name, len * s, base * s, col, cf, mat, tr) end
	function k.crystal(parent, name, len, w, col, cf, mat, tr) H.crystal(rig, parent, name, len * s, w * s, col, cf, mat, tr) end
	function k.diamond(parent, name, len, w, thick, col, cf, mat, tr) H.diamond(rig, parent, name, len * s, w * s, thick * s, col, cf, mat, tr) end
	function k.pv(parent, name, cf) return H.pivot(rig, parent, name, cf) end

	-- jointed block: `center` is where the block sits, `pivot` (units, block-local) is the point it turns about
	function k.jb(parent, name, x, y, z, col, center, pivot, mat, tr)
		local c1 = CF(pivot.X * s, pivot.Y * s, pivot.Z * s)
		return H.blk(rig, parent, name, V3(x, y, z) * s, col, center * c1, mat, tr, c1)
	end

	-- straight bar between two points A, B (units, parent-local); cross-section w x (th or w).
	-- `up` must not be parallel to A->B (default +Z, right for bars lying in the XY plane).
	function k.bar(parent, name, A, B, w, col, mat, tr, up, th)
		local a, b = A * s, B * s
		local len = (b - a).Magnitude
		local cf = CFrame.lookAt((a + b) / 2, b, up or Vector3.zAxis)
		return H.blk(rig, parent, name, V3(w * s, (th or w) * s, len + math.min(w, th or w) * s * 0.5), col, cf, mat, tr)
	end

	-- flat (approximately isosceles) membrane triangle in the parent's XY plane at depth z:
	-- apex point P, base corners B1, B2 (units, Vector3 with z used as depth)
	function k.mem(parent, name, P, B1, B2, thick, col, mat, tr)
		local M = (B1 + B2) / 2
		local h = (P - M).Magnitude
		local base = (B1 - B2).Magnitude
		if h < 0.05 or base < 0.05 then return end
		local d = (P - M).Unit
		local phi = math.atan2(-d.X, d.Y)
		local cf = CF(((P + M) / 2) * s) * ANG(0, 0, phi) * ANG(0, PI / 2, 0)
		H.tri(rig, parent, name, thick * s, h * s, base * s, col, cf, mat, tr)
	end

	-- ring of blocks in the parent's XY plane (faces -Z) around `center`
	function k.ring(parent, name, center, radius, count, radial, tangent, depth, col, mat, tr)
		for i = 0, count - 1 do
			local a = i / count * PI * 2
			local cf = center * CF(math.cos(a) * radius * s, math.sin(a) * radius * s, 0) * ANG(0, 0, a)
			H.blk(rig, parent, name, V3(radial, tangent, depth) * s, col, cf, mat, tr)
		end
	end

	---------------------------------------------------------------- rig roles
	function k.body(x, y, z, col, at, mat, tr)
		local e, p = k.b(rig.root, "Body", x, y, z, col, k.c(0, at, 0), mat, tr)
		rig.bodyEntry, rig.body = e, p
		rig.bodyRadius = k.v(x / 2, y / 2, z / 2)
		return p, e
	end

	-- head block centred at `center` (scaled CFrame, parent-local) turning about `pivot` (units, head-local)
	function k.head(parent, x, y, z, col, center, pivot, mat)
		local e, p = k.jb(parent, "Head", x, y, z, col, center, pivot or V3(0, -y * 0.4, z * 0.3), mat)
		rig.headEntry, rig.head = e, p
		rig.headRadius, rig.faceY = k.v(x / 2, y / 2, z / 2), 0
		return p, e
	end

	function k.glow(part, base, bright)
		table.insert(rig.glows, { part = part, base = base, bright = bright or base:Lerp(Color3.new(1, 1, 1), 0.6) })
	end

	-- glowing slit eye (Neon); roll > 0 lifts the +X end
	function k.eye(parent, x, y, z, w, h, col, roll)
		local e, p = k.b(parent, "Eye", w, h, 0.06, col, k.c(x, y, z) * ANG(0, 0, roll or 0), MAT.Neon)
		table.insert(rig.eyes, e)
		k.glow(p, col)
		return e, p
	end

	function k.ear(parent, side, cf, kind)
		local e, p = k.pv(parent, "EarPivot", cf)
		table.insert(rig.ears, { e = e, side = side, kind = kind or "cat" })
		return p, e
	end

	function k.wing(parent, side, cf, tier)
		local e, p = k.pv(parent, "WingPivot", cf)
		table.insert(rig.wings, { e = e, side = side, tier = tier or 1 })
		return p, e
	end

	function k.arm(parent, side, cf)
		local e, p = k.pv(parent, "ArmPivot", cf)
		table.insert(rig.arms, { e = e, side = side })
		return p, e
	end

	-- pivot that opens on pose.open (rotation `amt` radians about `axis` at open = 1)
	function k.opener(parent, name, cf, axis, amt)
		local e, p = k.pv(parent, name, cf)
		e.openAxis, e.openAmt = axis, amt
		H.group(rig, "open", e)
		return p, e
	end

	-- two-bone leg. Hip pivot at (x, y, z) in body-local units; bodyY = body centre height above ground.
	-- o.up = {w, h, d} upper block; o.w2, o.d2 lower block; o.paw = {w, h, d, zOff}; o.col, o.col2,
	-- o.pawCol, o.toes (count), o.toeCol, o.band (colour), o.bandY, o.hind, o.splay (radians, outward),
	-- o.lh (fixed lower length for legs that never reach the ground)
	function k.leg(body, name, bodyY, x, y, z, o)
		local side = x >= 0 and 1 or -1
		local splay = (o.splay or 0) * side
		local e, pv = k.pv(body, name, k.c(x, y, z) * ANG(0, 0, splay))
		local uh = o.up[2]
		k.b(pv, "Upper", o.up[1], uh + 0.1, o.up[3], o.col, k.c(0, -uh / 2 + 0.05, 0))
		local ph = o.paw[2]
		local lh = o.lh or math.max(0.2, bodyY + y - uh * math.cos(splay) - ph)
		local ke, knee = k.pv(pv, name .. "Knee", k.c(0, -uh, 0) * ANG(0, 0, -splay))
		k.b(knee, "Leg", o.w2, lh + 0.1, o.d2, o.col2 or o.col, k.c(0, -lh / 2, 0))
		if o.band then k.b(knee, "Band", o.w2 + 0.06, 0.16, o.d2 + 0.06, o.band, k.c(0, -(o.bandY or lh - 0.12), 0)) end
		local pz = o.paw[4] or -0.06
		k.b(knee, "Paw", o.paw[1], ph, o.paw[3], o.pawCol or o.col, k.c(0, -lh - ph / 2, pz))
		if o.toes and o.toes > 0 then
			local n, tw = o.toes, o.paw[1] / o.toes
			for t = 1, n do
				k.b(knee, "Toe", tw * 0.78, ph * 0.92, 0.26, o.toeCol or o.pawCol or o.col,
					k.c((t - (n + 1) / 2) * tw, -lh - ph * 0.5, pz - o.paw[3] / 2 - 0.06))
			end
		end
		e.knee, e.upperLen, e.kneeDir = ke, uh * s, o.hind and -1 or 1
		table.insert(rig.feet, e)
		return e, pv, knee, lh
	end

	-- generic wagging tail: segs = { {w, h, len, pitch, col, yaw, mat}, ... }, first joint at c0.
	-- Each segment turns about its front end and extends along +Z (negative pitch curls it upward).
	function k.tail(parent, c0, segs, name)
		local prev, prevLen = parent, 0
		for i, d in ipairs(segs) do
			local cf = ((i == 1) and c0 or k.c(0, 0, prevLen * 0.45)) * ANG(d[4] or 0, d[6] or 0, 0)
			local e, p = k.jb(prev, name or "TailSeg", d[1], d[2], d[3], d[5], cf * k.c(0, 0, d[3] / 2), V3(0, 0, -d[3] / 2), d[7])
			table.insert(rig.tail, e)
			prev, prevLen = p, d[3]
		end
		return prev, prevLen
	end

	-- animated chain (CreatureAnimator chain kinds: tentacle | spine | neck | trail | fan | fluke | plume)
	-- segs = { {w, h, len, col, pitch, yaw, mat, tr}, ... }; returns the chain record (parts in rec.parts)
	function k.chain(parent, c0, segs, meta)
		local rec = { name = meta.name or "Chain", entries = {}, parts = {} }
		for kk, vv in pairs(meta) do rec[kk] = vv end
		local prev, prevLen = parent, 0
		for i, d in ipairs(segs) do
			local cf = ((i == 1) and c0 or k.c(0, 0, prevLen * 0.46)) * ANG(d[5] or 0, d[6] or 0, 0)
			local e, p = k.jb(prev, rec.name, d[1], d[2], d[3], d[4], cf * k.c(0, 0, d[3] / 2), V3(0, 0, -d[3] / 2), d[7], d[8])
			table.insert(rec.entries, e)
			table.insert(rec.parts, p)
			prev, prevLen = p, d[3]
		end
		rec.n = #rec.entries
		table.insert(rig.chains, rec)
		return rec
	end

	-- bat / dragon wing built in the wing pivot's XY plane (outward = side * X).
	-- o.wrist = Vector2 (unsigned x, y), o.tips = { Vector2, ... } outer -> inner, o.bone, o.mem,
	-- o.boneW, o.memTr, o.memMat, o.cap (colour for the leading-edge cap)
	function k.batWing(pv, side, o)
		local function P(v2, z) return V3(v2.X * side, v2.Y, z or 0) end
		local O, W = V3(0, 0, 0), P(o.wrist)
		k.bar(pv, "WingArm", O, W, o.boneW or 0.3, o.bone)
		if o.cap then k.bar(pv, "WingCap", O + V3(0, 0.12, -0.05), W + V3(0, 0.12, -0.05), (o.boneW or 0.3) * 0.7, o.cap) end
		for i, t in ipairs(o.tips) do
			k.bar(pv, "Finger", W, P(t, 0.02), (o.boneW or 0.3) * 0.65, o.bone)
			if i > 1 then k.mem(pv, "Membrane", W + V3(0, 0, 0.06), P(o.tips[i - 1], 0.06), P(t, 0.06), 0.06, o.mem, o.memMat, o.memTr) end
		end
		-- inner panel: wrist -> innermost tip -> shoulder
		k.mem(pv, "Membrane", W + V3(0, 0, 0.06), P(o.tips[#o.tips], 0.06), O + V3(0, -0.2, 0.06), 0.06, o.mem, o.memMat, o.memTr)
	end

	-- fan of feather blades from the wing pivot (outward = side * X). o.feathers = { {angle, len, width, col, tipCol}, ... }
	-- angle 0 = straight out, + = up. Each blade gets a pointed tip.
	function k.featherWing(pv, side, o)
		for i, f in ipairs(o.feathers) do
			local a, L, wdt = f[1], f[2], f[3]
			local dir = V3(math.cos(a) * side, math.sin(a), 0)
			local z = (o.z or 0.04) * i
			local base = V3(0, 0, z) + dir * (o.root or 0.1)
			local tipStart = base + dir * L * 0.78
			k.bar(pv, "Feather", base, tipStart, wdt, f[4], o.mat, o.tr, V3(0, 0, 1), o.thick or 0.12)
			-- pointed tip: triangle continuing the blade
			k.mem(pv, "FeatherTip", base + dir * L, tipStart + V3(-dir.Y, dir.X, 0) * wdt * 0.5, tipStart - V3(-dir.Y, dir.X, 0) * wdt * 0.5,
				(o.thick or 0.12), f[5] or f[4], o.mat, o.tr)
		end
	end

	return k
end

return K
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">Odds</string><ProtectedString name="Source"><![CDATA[-- Odds: the single source of truth for creature chances ("1 in X").
-- Used by the server to roll and by the client to display odds.
-- Location: ReplicatedStorage > Shared > Odds (ModuleScript)

local Config = require(script.Parent.Config)
local CreatureData = require(script.Parent.CreatureData)
local Format = require(script.Parent.Format)

local Odds = {}

-- Returns { [creatureId] = probability } for a throw with this portal into this zone at this distance.
function Odds.Table(portalId: string, worldId: string, dist: number, luckMult: number?)
	local portal = Config.Portals[portalId]
	local luck = Config.LuckFromDistance(dist) * (luckMult or 1)
	local pool = {}
	for _, c in ipairs(CreatureData.ByWorld[worldId] or {}) do table.insert(pool, c) end
	for _, c in ipairs(CreatureData.ByWorld.Any or {}) do table.insert(pool, c) end

	local byRarity = {}
	for _, c in ipairs(pool) do
		byRarity[c.rarity] = byRarity[c.rarity] or {}
		table.insert(byRarity[c.rarity], c)
	end
	local total, weights = 0, {}
	for rarity, w in pairs(portal.weights) do
		if byRarity[rarity] then
			local order = Config.Rarities[rarity].order
			local weight = w * luck ^ (math.max(0, order - 2) * 0.5)
			weights[rarity] = weight
			total += weight
		end
	end
	local result = {}
	for rarity, weight in pairs(weights) do
		local list = byRarity[rarity]
		for _, c in ipairs(list) do
			result[c.id] = (weight / total) / #list
		end
	end
	return result
end

-- Rolls one creature. Returns creatureId, probability.
function Odds.Roll(portalId: string, worldId: string, dist: number, luckMult: number?)
	local t = Odds.Table(portalId, worldId, dist, luckMult)
	local ids = {}
	for id in pairs(t) do table.insert(ids, id) end
	table.sort(ids) -- deterministic order
	local r = math.random()
	local acc, last = 0, ids[1]
	for _, id in ipairs(ids) do
		acc += t[id]
		last = id
		if r <= acc then return id, t[id] end
	end
	return last, t[last]
end

-- Best ATTAINABLE chance of this creature with the given portal and the player's current max
-- throw distance. Returns 0 when its zone is out of range (no clamping into unreachable zones).
function Odds.ChanceFor(creatureId: string, portalId: string, maxDist: number)
	local _, p = Odds.Attainable(creatureId, portalId, maxDist)
	return p
end

-- Theoretical conditional chance: "if you land in this creature's zone at its best reachable
-- depth". Never shown as an attainable chance.
function Odds.Theoretical(creatureId: string, portalId: string)
	local def = CreatureData.ById[creatureId]
	if not def or not Config.Portals[portalId] then return 0 end
	if def.world == "Any" then
		local best = 0
		for _, w in ipairs(Config.WorldOrder) do
			best = math.max(best, Odds.Table(portalId, w, Config.ZoneBounds[w][2] - 1)[creatureId] or 0)
		end
		return best
	end
	local b = Config.ZoneBounds[def.world]
	return Odds.Table(portalId, def.world, b[2] - 1)[creatureId] or 0
end

-- Returns status, probability:
--   "ok"           p > 0, attainable now
--   "out_of_range" the creature's zone starts beyond maxDist
--   "portal"       reachable, but the equipped portal never rolls this rarity
function Odds.Attainable(creatureId: string, portalId: string, maxDist: number)
	local def = CreatureData.ById[creatureId]
	local portal = Config.Portals[portalId]
	if not def or not portal then return "portal", 0 end
	maxDist = math.max(0, maxDist or 0)
	if def.world == "Any" then
		if not portal.weights[def.rarity] then return "portal", 0 end
		local best = 0
		for _, w in ipairs(Config.WorldOrder) do
			local b = Config.ZoneBounds[w]
			if b[1] <= maxDist then
				local d = math.min(maxDist, b[2] - 1)
				best = math.max(best, Odds.Table(portalId, w, d)[creatureId] or 0)
			end
		end
		return best > 0 and "ok" or "portal", best
	end
	local b = Config.ZoneBounds[def.world]
	if maxDist < b[1] then return "out_of_range", 0 end
	if not portal.weights[def.rarity] then return "portal", 0 end
	local d = math.clamp(maxDist, b[1], b[2] - 1)
	local p = Odds.Table(portalId, def.world, d)[creatureId] or 0
	return p > 0 and "ok" or "portal", p
end

function Odds.OneIn(p: number): string
	if not p or p <= 0 then return "1 in ∞" end
	local n = 1 / p
	if n < 10 then return string.format("1 in %.1f", n) end
	return "1 in " .. Format.Short(math.floor(n + 0.5))
end

return Odds
]]></ProtectedString></Properties></Item>
