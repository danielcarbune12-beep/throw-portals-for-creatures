<Item class="ServerScriptService" referent="RBX40"><Properties><string name="Name">ServerScriptService</string></Properties>
<Item class="Folder" referent="RBX19"><Properties><string name="Name">Server</string></Properties>
<Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">BaseBuilder</string><ProtectedString name="Source"><![CDATA[-- BaseBuilder: builds the 8 player bases (with a personal gym each) and their decorations.
-- Location: ServerScriptService > Server > BaseBuilder (ModuleScript)
--
-- Layout of one base (local space, -Z = entrance facing the street):
--   entrance gateway + stone path -> central fountain with a ring of glowing pet slots
--   front-left: money collect pad      front-right: personal GYM
--   back-left:  pet cottage            back-right:  pond
--   string lights between the four corner lamps; pets roam the whole plot

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local BaseBuilder = {}
BaseBuilder.Bases = {}

local DECOR_SPOTS = {
	Vector3.new(-30, 0, -4), Vector3.new(30, 0, -4), Vector3.new(-30, 0, 9), Vector3.new(30, 0, 9),
	Vector3.new(-7, 0, 29), Vector3.new(7, 0, 29), Vector3.new(0, 0, 22), Vector3.new(0, 22, 4),
}
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

---------------------------------------------------------------- helpers
local function part(parent, size, cf, color, mat, collide, shape, transp)
	local p = Instance.new("Part")
	p.Shape = shape or Enum.PartType.Block
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = collide ~= false
	p.Transparency = transp or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
local function sphereMesh(p) local m = Instance.new("SpecialMesh"); m.MeshType = Enum.MeshType.Sphere; m.Parent = p; return p end
local function ball(parent, d, cf, color, mat, collide) return sphereMesh(part(parent, Vector3.new(d, d, d), cf, color, mat, collide)) end
local function vcylCF(cf, h, d) return cf * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(h, d, d) end
local function cyl(parent, cf, h, d, color, mat, collide, transp)
	local c, s = vcylCF(cf, h, d)
	return part(parent, s, c, color, mat, collide, Enum.PartType.Cylinder, transp)
end
local function light(p, color, range, b) local l = Instance.new("PointLight"); l.Color = color; l.Range = range; l.Brightness = b or 1.4; l.Parent = p; return l end

---------------------------------------------------------------- one base
local function buildBase(index)
	return require(script.Parent.SanctuaryBase).Build(index)
end

---------------------------------------------------------------- gym equipment (by level)
local function buildGymEquipment(base, level)
	local f = base.gym
	f:ClearAllChildren()
	local st = Config.TrainingStations[level]
	local g = base.cf * CFrame.new(Config.GymOffset) * CFrame.new(0, 1.25, 3)
	local STEEL, DARKSTEEL = Color3.fromRGB(150, 155, 168), Color3.fromRGB(60, 62, 72)
	local HZ = Enum.PartType.Cylinder -- part cylinders run along X (horizontal)
	-- every tier has its own geometry (not a recolour); positions stay inside the gym pad
	if level == 1 then
		-- Wooden Dumbbell: soft mat, low wooden rack, two rounded wooden dumbbells, instruction plate
		part(f, Vector3.new(7, 0.2, 5), g * CFrame.new(0, 0.1, 0), Color3.fromRGB(110, 170, 120), Enum.Material.Fabric, false)
		part(f, Vector3.new(6, 0.5, 1.6), g * CFrame.new(0, 1.4, 2.2), Color3.fromRGB(170, 120, 70), Enum.Material.WoodPlanks)
		for _, s in ipairs({ -1, 1 }) do part(f, Vector3.new(0.5, 1.4, 1.4), g * CFrame.new(s * 2.7, 0.7, 2.2), Color3.fromRGB(140, 95, 55), Enum.Material.Wood) end
		for _, x in ipairs({ -1.4, 1.4 }) do
			part(f, Vector3.new(1.6, 0.35, 0.35), g * CFrame.new(x, 1.95, 2.2), Color3.fromRGB(150, 105, 60), Enum.Material.Wood, false, HZ)
			for _, s in ipairs({ -1, 1 }) do ball(f, 0.95, g * CFrame.new(x + s * 0.85, 1.95, 2.2), st.color, Enum.Material.Wood, false) end
		end
		part(f, Vector3.new(3, 1.4, 0.2), g * CFrame.new(0, 2.6, 3.3), Color3.fromRGB(245, 235, 210), Enum.Material.Wood, false)
	elseif level == 2 then
		-- Iron Barbell: rubber mat, bench, steel uprights with J-hooks, plates + collars
		part(f, Vector3.new(9, 0.2, 7), g * CFrame.new(0, 0.1, 0), Color3.fromRGB(40, 40, 46), Enum.Material.Rubber, false)
		part(f, Vector3.new(2.4, 0.6, 6), g * CFrame.new(0, 1.6, -2), Color3.fromRGB(200, 50, 60), Enum.Material.Fabric)
		for _, s in ipairs({ -1, 1 }) do part(f, Vector3.new(0.4, 1.6, 0.4), g * CFrame.new(0, 0.8, -2 + s * 2.4), DARKSTEEL, Enum.Material.Metal) end
		for _, s in ipairs({ -1, 1 }) do
			part(f, Vector3.new(0.5, 5, 0.5), g * CFrame.new(s * 3.4, 2.5, 1.5), DARKSTEEL, Enum.Material.Metal)
			part(f, Vector3.new(0.5, 0.3, 0.9), g * CFrame.new(s * 3.4, 4.15, 1.2), STEEL, Enum.Material.Metal, false) -- J-hook
			for k = 0, 2 do
				part(f, Vector3.new(0.28, 2.6 - k * 0.5, 2.6 - k * 0.5), g * CFrame.new(s * (2.4 + k * 0.3), 4.4, 1.5), Color3.fromRGB(50, 52, 60), Enum.Material.Metal, false, HZ)
			end
			part(f, Vector3.new(0.3, 0.8, 0.8), g * CFrame.new(s * 3.3, 4.4, 1.5), STEEL, Enum.Material.Metal, false, HZ) -- collar
		end
		part(f, Vector3.new(8.4, 0.32, 0.32), g * CFrame.new(0, 4.4, 1.5), STEEL, Enum.Material.Metal, false, HZ)
	elseif level == 3 then
		-- Golden Kettlebell: pedestal rack with three real kettlebells (body + arched handle)
		part(f, Vector3.new(8, 0.2, 6), g * CFrame.new(0, 0.1, 0), Color3.fromRGB(60, 40, 30), Enum.Material.Rubber, false)
		part(f, Vector3.new(7.5, 1.2, 2.4), g * CFrame.new(0, 0.6, 1.5), Color3.fromRGB(240, 232, 215), Enum.Material.Marble)
		part(f, Vector3.new(7.7, 0.2, 2.6), g * CFrame.new(0, 1.25, 1.5), st.color, Enum.Material.Metal, false)
		for k = -1, 1 do
			local bcf = g * CFrame.new(k * 2.3, 2.45, 1.5)
			ball(f, 2.1, bcf, st.color, Enum.Material.Metal, false)
			for seg = 0, 4 do -- handle arch
				local a = seg / 4 * math.pi
				part(f, Vector3.new(0.75, 0.3, 0.3), bcf * CFrame.new(math.cos(a) * 0.7, 1.05 + math.sin(a) * 0.65, 0) * CFrame.Angles(0, 0, a + math.pi / 2), st.color, Enum.Material.Metal, false, HZ)
			end
		end
	elseif level == 4 then
		-- Crystal Weights: reinforced grip, faceted crystal plates, mounting brackets, luminous channels
		part(f, Vector3.new(9, 0.2, 7), g * CFrame.new(0, 0.1, 0), Color3.fromRGB(35, 30, 50), Enum.Material.Rubber, false)
		for _, s in ipairs({ -1, 1 }) do
			part(f, Vector3.new(0.7, 4.6, 1.2), g * CFrame.new(s * 3.6, 2.3, 1.5), Color3.fromRGB(70, 60, 95), Enum.Material.Metal)
			part(f, Vector3.new(0.72, 3.8, 0.15), g * CFrame.new(s * 3.6, 2.3, 0.88), st.color, Enum.Material.Neon, false) -- recessed channel
			for k = 0, 1 do
				local plate = part(f, Vector3.new(0.5, 2.4 - k * 0.6, 2.4 - k * 0.6), g * CFrame.new(s * (2.5 + k * 0.5), 4.4, 1.5) * CFrame.Angles(math.rad(45), 0, 0), st.color, Enum.Material.Glass, false)
				plate.Transparency = 0.12
			end
		end
		part(f, Vector3.new(7.6, 0.4, 0.4), g * CFrame.new(0, 4.4, 1.5), Color3.fromRGB(200, 200, 215), Enum.Material.Metal, false, HZ)
		part(f, Vector3.new(2.4, 0.5, 0.5), g * CFrame.new(0, 4.4, 1.5), Color3.fromRGB(60, 50, 80), Enum.Material.Fabric, false, HZ) -- grip
	else
		-- Cosmic Gravity Machine: A-frame, three offset orbital rings, contained core, safe grips
		part(f, Vector3.new(10, 0.2, 8), g * CFrame.new(0, 0.1, 0), Color3.fromRGB(20, 25, 45), Enum.Material.Rubber, false)
		for _, s in ipairs({ -1, 1 }) do
			for _, z in ipairs({ -0.6, 0.6 }) do
				part(f, Vector3.new(0.5, 8.5, 0.5), g * CFrame.new(s * 4.2, 4, 1.5 + z) * CFrame.Angles(z * 0.25, 0, 0), Color3.fromRGB(45, 50, 75), Enum.Material.Metal)
			end
			part(f, Vector3.new(1.6, 0.4, 0.4), g * CFrame.new(s * 1.8, 3.2, -0.3), Color3.fromRGB(200, 205, 220), Enum.Material.Metal, false, HZ) -- grip
		end
		part(f, Vector3.new(8.8, 0.5, 0.5), g * CFrame.new(0, 8.2, 1.5), Color3.fromRGB(45, 50, 75), Enum.Material.Metal, false, HZ)
		for k = 1, 3 do
			local ring = part(f, Vector3.new(0.35, 5 + k * 1.2, 5 + k * 1.2), g * CFrame.new(0, 5, 1.5) * CFrame.Angles(k * 0.9, k * 0.5, 0), st.color, Enum.Material.Neon, false, Enum.PartType.Cylinder, 0.25)
			ring.Name = "GravityRing" .. k
		end
		local glass = ball(f, 3.4, g * CFrame.new(0, 5, 1.5), Color3.fromRGB(180, 230, 255), Enum.Material.Glass, false)
		glass.Transparency = 0.6
		local core = ball(f, 1.8, g * CFrame.new(0, 5, 1.5), Color3.new(1, 1, 1), Enum.Material.Neon, false)
		core.Name = "GravityCore"
		light(core, st.color, 18, 2)
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = SPARKLE; pe.Color = ColorSequence.new(st.color); pe.Rate = 6; pe.LightEmission = 1
		pe.Speed = NumberRange.new(0.5, 1.5); pe.Size = NumberSequence.new(0.4, 0); pe.Parent = core
	end
	local nextSt = Config.TrainingStations[level + 1]
	base.gymLabel.Text = string.format("💪 GYM: %s\n<font color='#9CFFA8'>+%d Strength/lift</font>%s", st.name, st.gain,
		nextSt and ("\n<font color='#FFD36B'>Next: " .. nextSt.name .. "</font>") or "\n<font color='#FFD36B'>MAXED!</font>")
end

---------------------------------------------------------------- decorations
local DecorBuild = {}
local function D(base, spot) return base.cf * CFrame.new(spot) end

function DecorBuild.FlowerBed(f, cf)
	-- stone border + soil + three distinct flower shapes (tulip, daisy, bell) with leaves
	part(f, Vector3.new(8.4, 0.8, 4.4), cf * CFrame.new(0, 1.3, 0), Color3.fromRGB(175, 170, 165), Enum.Material.Cobblestone)
	part(f, Vector3.new(7.6, 0.3, 3.6), cf * CFrame.new(0, 1.75, 0), Color3.fromRGB(95, 65, 45), Enum.Material.Ground, false)
	for i = 1, 9 do
		local x, z = -3 + (i - 1) % 5 * 1.5, i > 5 and 0.9 or -0.9
		local base = cf * CFrame.new(x, 1.9, z)
		part(f, Vector3.new(0.15, 1.1, 0.15), base * CFrame.new(0, 0.55, 0), Color3.fromRGB(70, 150, 60), nil, false)
		ball(f, 1, base * CFrame.new(0.25, 0.35, 0) * CFrame.Angles(0, 0, -0.6), Color3.fromRGB(90, 180, 70), Enum.Material.Grass, false).Size = Vector3.new(0.6, 0.2, 0.35)
		local kind = i % 3
		local col = Color3.fromHSV((i * 0.13) % 1, 0.55, 1)
		if kind == 0 then -- tulip cup
			ball(f, 1, base * CFrame.new(0, 1.25, 0), col, nil, false).Size = Vector3.new(0.55, 0.75, 0.55)
		elseif kind == 1 then -- daisy: petal disc + centre
			part(f, Vector3.new(0.12, 0.95, 0.95), base * CFrame.new(0, 1.2, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(255, 252, 245), nil, false, Enum.PartType.Cylinder)
			ball(f, 0.35, base * CFrame.new(0, 1.28, 0), Color3.fromRGB(255, 210, 60), nil, false)
		else -- bell: drooping bloom
			ball(f, 1, base * CFrame.new(0.2, 1.05, 0), col, nil, false).Size = Vector3.new(0.45, 0.55, 0.45)
		end
	end
end
function DecorBuild.Lanterns(f, cf)
	-- real post + bracket + caged lantern bodies (warm glass inserts); one light per pair
	for s = -1, 1, 2 do
		local base = cf * CFrame.new(s * 2.5, 0, 0)
		part(f, Vector3.new(1.2, 0.6, 1.2), base * CFrame.new(0, 1.3, 0), Color3.fromRGB(70, 60, 80), Enum.Material.Metal)
		part(f, Vector3.new(0.4, 7, 0.4), base * CFrame.new(0, 4.6, 0), Color3.fromRGB(60, 50, 70), Enum.Material.Metal)
		part(f, Vector3.new(1.6, 0.25, 0.25), base * CFrame.new(-s * 0.6, 8, 0), Color3.fromRGB(60, 50, 70), Enum.Material.Metal, false)
		local lcf = base * CFrame.new(-s * 1.3, 6.9, 0)
		local glass = part(f, Vector3.new(0.9, 1.3, 0.9), lcf, Color3.fromRGB(255, 190, 110), Enum.Material.Neon, false)
		for _, c in ipairs({ { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } }) do
			part(f, Vector3.new(0.12, 1.5, 0.12), lcf * CFrame.new(c[1] * 0.5, 0, c[2] * 0.5), Color3.fromRGB(45, 38, 50), Enum.Material.Metal, false)
		end
		part(f, Vector3.new(1.2, 0.3, 1.2), lcf * CFrame.new(0, 0.8, 0), Color3.fromRGB(45, 38, 50), Enum.Material.Metal, false)
		if s == 1 then light(glass, Color3.fromRGB(255, 190, 110), 16) end
	end
end
function DecorBuild.MushroomRing(f, cf)
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		local p = cf * CFrame.new(math.cos(a) * 2.6, 1, math.sin(a) * 2.6)
		part(f, Vector3.new(0.6, 1.6, 0.6), p * CFrame.new(0, 0.8, 0), Color3.fromRGB(245, 235, 220), nil, false)
		ball(f, 1, p * CFrame.new(0, 1.8, 0), Color3.fromHSV(0.8 + i * 0.03, 0.7, 1), Enum.Material.Neon, false).Size = Vector3.new(1.8, 1, 1.8)
	end
end
function DecorBuild.Fountain(f, cf)
	cyl(f, cf * CFrame.new(0, 1, 0), 1.6, 7, Color3.fromRGB(220, 220, 235), Enum.Material.Marble, true)
	cyl(f, cf * CFrame.new(0, 2.5, 0), 0.2, 6, Color3.fromRGB(90, 190, 255), Enum.Material.Glass, false, 0.3)
	local orb = ball(f, 2.4, cf * CFrame.new(0, 5.5, 0), Color3.fromRGB(150, 110, 255), Enum.Material.Neon, false)
	light(orb, Color3.fromRGB(150, 110, 255), 16)
end
function DecorBuild.CrystalTree(f, cf)
	part(f, Vector3.new(1.4, 8, 1.4), cf * CFrame.new(0, 5, 0), Color3.fromRGB(230, 230, 255), Enum.Material.Glass)
	local last
	for i = 1, 7 do
		local a = i * 0.9
		last = part(f, Vector3.new(1, 3.5, 1), cf * CFrame.new(math.cos(a) * 2, 8 + (i % 3), math.sin(a) * 2) * CFrame.Angles(math.cos(a) * 0.6, 0, math.sin(a) * 0.6),
			Color3.fromHSV(0.55 + i * 0.05, 0.6, 1), Enum.Material.Neon, false)
	end
	light(last, Color3.fromRGB(150, 200, 255), 20)
end
function DecorBuild.Statue(f, cf)
	-- an original sitting fox-like creature sculpted from masses, on a plinth with an inscription plate
	local gold = Color3.fromRGB(255, 200, 60)
	part(f, Vector3.new(4.4, 1.6, 4.4), cf * CFrame.new(0, 1.8, 0), Color3.fromRGB(230, 230, 235), Enum.Material.Marble)
	part(f, Vector3.new(3.8, 0.4, 3.8), cf * CFrame.new(0, 2.8, 0), Color3.fromRGB(210, 210, 218), Enum.Material.Marble)
	part(f, Vector3.new(2.2, 0.7, 0.15), cf * CFrame.new(0, 1.9, -2.25), gold, Enum.Material.Metal, false)
	local s = cf * CFrame.new(0, 3, 0)
	ball(f, 1, s * CFrame.new(0, 1.3, 0.3), gold, Enum.Material.Metal).Size = Vector3.new(2.2, 2.4, 2.6) -- seated body
	ball(f, 1, s * CFrame.new(0, 2.9, -0.6), gold, Enum.Material.Metal).Size = Vector3.new(1.7, 1.5, 1.6) -- head
	ball(f, 1, s * CFrame.new(0, 2.6, -1.4), gold, Enum.Material.Metal, false).Size = Vector3.new(0.8, 0.6, 0.9) -- muzzle
	for side = -1, 1, 2 do
		local ear = part(f, Vector3.new(0.5, 1.1, 0.3), s * CFrame.new(side * 0.55, 3.9, -0.5) * CFrame.Angles(0, 0, -side * 0.35), gold, Enum.Material.Metal, false)
		ear.Shape = Enum.PartType.Block
		ball(f, 1, s * CFrame.new(side * 0.6, 0.4, -0.9), gold, Enum.Material.Metal, false).Size = Vector3.new(0.7, 0.6, 1.1) -- front paws
	end
	ball(f, 1, s * CFrame.new(1.2, 0.7, 1.2) * CFrame.Angles(0, 0.6, 0), gold, Enum.Material.Metal, false).Size = Vector3.new(0.9, 0.9, 2.6) -- curled tail
end
function DecorBuild.Rainbow(f, cf)
	-- continuous seven-band arch with cloud feet and neat end caps
	local cols = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(255, 160, 50), Color3.fromRGB(255, 230, 70), Color3.fromRGB(90, 220, 110),
		Color3.fromRGB(80, 170, 255), Color3.fromRGB(110, 100, 255), Color3.fromRGB(200, 100, 255) }
	local segs = 14
	for b, col in ipairs(cols) do
		local r = 6.2 - b * 0.42
		for i = 1, segs do
			local a0, a1 = (i - 1) / segs * math.pi, i / segs * math.pi
			local p0 = Vector3.new(math.cos(a0) * r, math.sin(a0) * r, 0)
			local p1 = Vector3.new(math.cos(a1) * r, math.sin(a1) * r, 0)
			local mid = (p0 + p1) / 2
			part(f, Vector3.new(0.45, (p1 - p0).Magnitude + 0.08, 0.6), cf * CFrame.new(0, 1.2, 0) * CFrame.new(mid) * CFrame.Angles(0, 0, (a0 + a1) / 2), col, Enum.Material.Neon, false)
		end
	end
	for s = -1, 1, 2 do
		for k = 0, 2 do
			ball(f, 1, cf * CFrame.new(s * (4.6 + k * 0.5 - 0.5), 1.4 + (k % 2) * 0.3, (k - 1) * 0.7), Color3.fromRGB(255, 255, 255), nil, false).Size = Vector3.new(2, 1.4, 1.8)
		end
	end
end
function DecorBuild.FloatingIsland(f, cf)
	ball(f, 1, cf, Color3.fromRGB(120, 90, 70), Enum.Material.Slate, false).Size = Vector3.new(12, 5, 10)
	ball(f, 1, cf * CFrame.new(0, 2, 0), Color3.fromRGB(110, 210, 90), Enum.Material.Grass, false).Size = Vector3.new(12, 1.5, 10)
	part(f, Vector3.new(0.8, 4, 0.8), cf * CFrame.new(0, 4.5, 0), Color3.fromRGB(120, 80, 50), Enum.Material.Wood, false)
	ball(f, 1, cf * CFrame.new(0, 7, 0), Color3.fromRGB(255, 160, 210), Enum.Material.Grass, false).Size = Vector3.new(4.5, 4, 4.5)
end

---------------------------------------------------------------- public API
function BaseBuilder.BuildAll()
	for _, old in ipairs(workspace:GetChildren()) do
		if old.Name == "Bases" and old:IsA("Folder") and (old:GetAttribute("TPFCGenerated") or old:FindFirstChild("Base1")) then old:Destroy() end
	end
	BaseBuilder.Bases = {}
	local f = Instance.new("Folder"); f.Name = "Bases"; f.Parent = workspace
	f:SetAttribute("TPFCGenerated", true)
	for i = 1, Config.MaxBases do
		BaseBuilder.Bases[i] = buildBase(i)
		buildGymEquipment(BaseBuilder.Bases[i], 1)
		task.wait()
	end
end

function BaseBuilder.Claim(player)
	for _, b in ipairs(BaseBuilder.Bases) do
		if not b.owner then
			b.owner = player
			for _, l in ipairs(b.signLabels) do l.Text = player.DisplayName .. "'s Base" end
			b.model:SetAttribute("OwnerId", player.UserId)
			return b
		end
	end
	return nil
end

function BaseBuilder.Release(base)
	base.owner = nil
	for _, l in ipairs(base.signLabels) do l.Text = "UNCLAIMED GARDEN" end
	base.model:SetAttribute("OwnerId", nil)
	base.decor:ClearAllChildren()
	base.gym:ClearAllChildren()
	buildGymEquipment(base, 1)
	base.gymLabel.Text = "💪 GYM"
	base.crystalLabel.Text = ""
	base.collectLabel.Text = "$0"
end

-- Rebuild decorations, floor theme, gym equipment and slot colours from player data
function BaseBuilder.Refresh(base, data)
	base.decor:ClearAllChildren()
	for i, id in ipairs(Config.DecorOrder) do
		if data.Decor[id] and DecorBuild[id] then
			local holder = Instance.new("Folder"); holder.Name = id; holder.Parent = base.decor
			DecorBuild[id](holder, D(base, DECOR_SPOTS[i]))
		end
	end
	for _, theme in ipairs(Config.FloorThemes) do
		if theme.id == data.FloorTheme then
			base.floor.Color = theme.id == "Meadow" and Color3.fromRGB(108, 161, 76) or theme.color
			base.floor.Material = theme.material
		end
	end
	buildGymEquipment(base, math.clamp(data.EquipLevel or 1, 1, #Config.TrainingStations))
	local lvl = data.Upgrades.Training
	base.crystalLabel.Text = lvl > 0 and ("🐾 Pet Trainer Lv." .. lvl .. "  (+" .. math.floor(lvl * Config.TrainingBonus * 100) .. "% income)") or ""
	local slotsOpen = Config.StartSlots + data.Upgrades.BaseSlots
	for i = 1, #base.slots do
		local ring = base.slotFolder:FindFirstChild("SlotRing" .. i)
		local pad = base.slotFolder:FindFirstChild("Slot" .. i)
		local open = i <= slotsOpen
		if ring then
			ring.Color = open and Color3.fromRGB(150, 120, 255) or Color3.fromRGB(90, 90, 100)
			ring.Material = open and Enum.Material.Neon or Enum.Material.SmoothPlastic
			ring.Transparency = open and 0 or 0.5
		end
		if pad then pad.Transparency = open and 0 or 0.6 end
	end
end

return BaseBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">BiomeCandy</string><ProtectedString name="Source"><![CDATA[-- BiomeCandy: Candy World, Z [900, 1300). Reference: roblox pets/Maps/05_Candy_Biome_Final.png (1:1 inventory).
-- Authored as seen in the reference (K.mirror = true: design -X = screen-left). ONE palace, no plots/hall/houses.
--  LEFT : CaL1 faceted chocolate cliff with icing caps, three-step chocolate waterfall + gold-edged canal ·
--         CaL2 chunky pink candy trees · CaL3 swirl lollipops on striped sticks · CaL4 pink crystals ·
--         CaL5 sugar-coated orange gumdrops
--  RIGHT: CaR1 grand palace (cream facade, chocolate wedge buttresses, candy-stripe columns with gold caps,
--         glowing pink crystal gate in a gold frame, pointed pink windows, steps, whipped-cream swirl dome +
--         gold spire, gold-tipped spires) · CaR2 lollipops, pink trees, gumdrops, crystals
--  CENTRE: pink sugar lane with a wavy cream ribbon along both edges; chocolate peaks with icing far away.
-- Location: ServerScriptService > Server > BiomeCandy (ModuleScript)

local K = require(script.Parent.WorldKit)
local V3, CF, ANG, PI, M = K.V3, K.CF, K.ANG, K.PI, K.M
local C = K.C

local B = {}

local CHOC, CHOC_D, CHOC_L = C(104, 58, 36), C(72, 38, 24), C(132, 78, 48)
local CREAM, ICING = C(250, 236, 214), C(255, 250, 244)
local PINK, PINK_L, PINK_D = C(250, 150, 196), C(255, 196, 222), C(230, 104, 160)
local GOLD, ORANGE, RED = C(226, 176, 74), C(255, 170, 60), C(232, 64, 84)

-- CaL2 / CaR2: pink candy tree (chocolate trunk, faceted pink canopy)
local function candyTree(pos, s)
	local top, mid = K.limb(pos, pos + V3(0.6, 4 * s, 0), pos + V3(-0.4, 8 * s, 0.4), 1.4 * s, 0.9 * s, 4, CHOC, M.SmoothPlastic, true)
	for i = 0, 2 do
		local a = i / 3 * PI * 2 + K.r(-0.3, 0.3)
		local d = V3(math.cos(a), 0, math.sin(a))
		K.limb(mid, mid + d * 1.5 * s + V3(0, 1.5 * s, 0), mid + d * 3.5 * s + V3(0, 3 * s, 0), 0.6 * s, 0.35 * s, 2, CHOC)
	end
	for i = 1, 6 do
		local p = top + V3(K.r(-3.5, 3.5) * s, K.r(-0.5, 3.5) * s, K.r(-3.5, 3.5) * s)
		K.block(CF(p) * ANG(K.r(-0.4, 0.4), K.r(0, PI), K.r(-0.4, 0.4)), V3(K.r(3.4, 5), K.r(2.6, 3.6), K.r(3.4, 5)) * s, PINK:Lerp(i % 2 == 0 and PINK_L or PINK_D, K.r(0, 0.6)), M.SmoothPlastic)
	end
	K.block(CF(top + V3(0, 4.4 * s, 0)) * ANG(0.3, K.r(0, PI), 0.2), V3(4, 2.4, 4) * s, PINK_L, M.SmoothPlastic)
end

-- CaL3 / CaR2: swirl lollipop on a striped stick (spiral on both faces of the disc)
local function lollipop(pos, s, yaw)
	local h = 9 * s
	for i = 0, 7 do
		K.cyl(CF(pos + V3(0, (i + 0.5) * h / 8, 0)) * ANG(0, 0, PI / 2), h / 8 + 0.02, 0.7 * s, i % 2 == 0 and PINK_D or ICING, M.SmoothPlastic, i == 0)
	end
	local cf = CF(pos + V3(0, h + 3.6 * s, 0)) * ANG(0, yaw or 0, 0)
	K.cyl(cf * ANG(0, PI / 2, 0), 1.2 * s, 7.6 * s, ICING, M.SmoothPlastic)
	K.cyl(cf * ANG(0, PI / 2, 0), 1.3 * s, 7.9 * s, PINK_D, M.SmoothPlastic, false)
	K.cyl(cf * ANG(0, PI / 2, 0), 1.25 * s, 7.6 * s, ICING, M.SmoothPlastic)
	for side = -1, 1, 2 do
		local n = 26
		for i = 1, n do
			local t0, t1 = (i - 1) / n * PI * 5, i / n * PI * 5
			local r0, r1 = 0.15 + t0 / (PI * 5) * 3.4, 0.15 + t1 / (PI * 5) * 3.4
			local a = cf * V3(math.cos(t0) * r0 * s, math.sin(t0) * r0 * s, side * 0.64 * s)
			local b = cf * V3(math.cos(t1) * r1 * s, math.sin(t1) * r1 * s, side * 0.64 * s)
			K.block(CFrame.lookAt((a + b) / 2, b, cf.LookVector * side), V3(0.55 * s, 0.1, (a - b).Magnitude + 0.15), PINK, M.SmoothPlastic)
		end
	end
end

-- CaL5 / CaR2: sugar-coated gumdrop (truncated pyramid)
local function gumdrop(pos, s, col)
	K.block(CF(pos + V3(0, 0.8 * s, 0)) * ANG(0, K.r(0, PI), 0), V3(3.6, 1.6, 3.6) * s, col, M.Sand, true)
	local cf = CF(pos + V3(0, 1.6 * s, 0)) * ANG(0, K.r(0, PI), 0)
	for i = 0, 3 do K.wedge(cf * ANG(0, i * PI / 2, 0) * CF(0, 0.6 * s, -1.3 * s), V3(3.6 * s, 1.2 * s, 1 * s), col, M.Sand) end
	K.block(cf * CF(0, 1.1 * s, 0), V3(1.6, 0.2, 1.6) * s, K.light(col, 0.2), M.Sand)
end

-- icing drapes along a ledge edge (cf = edge centre, front = -Z local)
local function icing(cf, w, n)
	K.block(cf, V3(w, 0.6, 2), ICING, M.SmoothPlastic)
	for _ = 1, n do
		local d = K.r(0.8, 2.2)
		K.ellipsoid(cf * CF(K.r(-w / 2 + 0.6, w / 2 - 0.6), -d * 0.45, -0.9), V3(K.r(0.9, 1.6), d, 0.9), ICING, M.SmoothPlastic)
	end
end

-- CaL1: chocolate cliff with three-step waterfall pouring toward the lane
local function chocoCliff(c)
	K.cone(c + V3(-16, 0, 0), 30, 50, 9, CHOC, CHOC_D, M.SmoothPlastic, true)
	for i = 0, 2 do
		local x = c.X - i * 7
		local y = 6 + i * 8
		K.bevel(CF(x, y / 2, c.Z), V3(14, y, 30 - i * 4), CHOC:Lerp(CHOC_D, i * 0.2), M.SmoothPlastic)
		icing(CF(x + 7, y + 0.2, c.Z) * ANG(0, -PI / 2, 0), 30 - i * 4, 7)
		K.addSurface(x - 7, x + 7, c.Z - 15 + i * 2, c.Z + 15 - i * 2, y + 0.4)
		-- falls from this ledge to the one below
		local fall = K.block(CF(x + 7.3, y - 3.5, c.Z), V3(0.8, 7.4, 10 - i), C(120, 66, 38), M.SmoothPlastic)
		K.tag(fall, "TPFC_Pulse", { Period = 5 + i, Base = 0, Peak = 0.08 })
		K.ellipsoid(CF(x + 8.6, (i == 0) and 0.4 or (y - 7.6), c.Z), V3(3, 1.2, 11 - i), CREAM, M.SmoothPlastic)
	end
	for _ = 1, 6 do K.wedge(CF(c + V3(K.r(-24, -8), K.r(30, 48), K.r(-18, 18))) * ANG(0, K.r(0, PI), 0), V3(K.r(6, 10), K.r(4, 7), K.r(5, 8)), CHOC_L, M.SmoothPlastic) end
	K.cone(c + V3(-16, 44, 0), 9, 10, 7, ICING, CREAM, M.SmoothPlastic)
end

-- CaR1 helpers
local function stripeColumn(pos, h, w)
	K.vcyl(pos, h, w, ICING, M.SmoothPlastic, true)
	local n = math.floor(h / 1.2)
	for i = 0, n do
		local a = i * 0.9
		K.block(CF(pos + V3(0, i * 1.2 + 0.6, 0)) * ANG(0, a, 0) * CF(0, 0, -w / 2) * ANG(0, 0, 0.6), V3(w * 0.75, 1.1, 0.22), PINK_D, M.SmoothPlastic)
	end
	K.block(CF(pos + V3(0, h + 0.5, 0)), V3(w + 1, 1, w + 1), GOLD, M.Metal)
	K.cone(pos + V3(0, h + 1, 0), w * 0.5, w * 1.4, 6, GOLD, K.dark(GOLD, 0.15), M.Metal)
end
local function buttress(pos, h, d, yaw)
	local cf = CF(pos) * ANG(0, yaw, 0)
	K.wedge(cf * CF(0, h / 2, 0), V3(4, h, d), CHOC, M.SmoothPlastic, true)
	K.wedge(cf * CF(0, h / 2 + 0.3, 0.6) * CF(0, 0, -0.2), V3(1, h * 0.9, d * 0.9), CREAM, M.SmoothPlastic)
	K.block(cf * CF(0, h + 0.4, d / 2 - 1), V3(4.6, 0.8, 2.4), GOLD, M.Metal)
end
local function pointedWindow(cf, w, h)
	K.block(cf, V3(w + 0.8, h + 0.8, 0.3), GOLD, M.Metal)
	local g = K.block(cf * CF(0, 0, -0.1), V3(w, h, 0.3), PINK, M.Glass, false, 0.1)
	K.wedge(cf * CF(-w / 4, h / 2 + w / 4, 0) * ANG(0, PI / 2, 0), V3(0.3, w / 2, w / 2), GOLD, M.Metal)
	K.wedge(cf * CF(w / 4, h / 2 + w / 4, 0) * ANG(0, -PI / 2, 0), V3(0.3, w / 2, w / 2), GOLD, M.Metal)
	return g
end
local function creamSwirl(pos, r, h)
	local n = 7
	for i = 0, n - 1 do
		local k = 1 - i / n
		K.ellipsoid(CF(pos + V3(math.cos(i * 1.2) * r * 0.08, i * h / n, math.sin(i * 1.2) * r * 0.08)) * ANG(0, i * 0.7, 0.12), V3(r * 2 * k + 1, h / n * 1.6, r * 2 * k + 1), i % 2 == 0 and ICING or CREAM, M.SmoothPlastic)
	end
	K.cone(pos + V3(0, h, 0), 0.8, 4, 5, GOLD, K.dark(GOLD, 0.15), M.Metal)
	K.pyramid(CF(pos + V3(0, h + 4.2, 0)) * ANG(0, PI / 4, 0), 1.2, 1.6, GOLD, M.Neon)
end

local function palace(c)
	-- plinth + front steps (facing the lane, -X design)
	K.bevel(CF(c + V3(10, 1, 0)), V3(60, 2, 96), CREAM, M.SmoothPlastic)
	K.addSurface(c.X - 20, c.X + 40, c.Z - 48, c.Z + 48, 2)
	K.stairs(CF(c + V3(-22, 0, 0)) * ANG(0, -PI / 2, 0), 16, 5, 0.6, 1.4, ICING, M.SmoothPlastic)
	-- main hall: cream body with chocolate base and roof band
	K.bevel(CF(c + V3(14, 2 + 15, 0)), V3(30, 30, 40), CREAM, M.SmoothPlastic)
	K.block(CF(c + V3(14, 2 + 2, 0)), V3(31, 4, 41), CHOC, M.SmoothPlastic)
	K.block(CF(c + V3(14, 2 + 30.6, 0)), V3(32, 1.2, 42), CHOC, M.SmoothPlastic)
	K.block(CF(c + V3(14, 2 + 31.4, 0)), V3(32.4, 0.4, 42.4), GOLD, M.Metal)
	K.gable(CF(c + V3(14, 2 + 31.6, 0)) * ANG(0, 0, 0), 30, 12, 40, CREAM, M.SmoothPlastic)
	-- central gate: gold frame, glowing pink crystal doors, pointed top, gem
	local gx = c.X - 1.2
	local gate = K.block(CF(gx, 2 + 8, c.Z), V3(0.4, 14, 10), PINK, M.Neon, false, 0.3)
	K.lamp(gate, PINK, 30, 1.4)
	K.tag(gate, "TPFC_Pulse", { Period = 7, Base = 0.3, Peak = 0.1 })
	K.pointedArch(CF(gx - 0.4, 2, c.Z) * ANG(0, PI / 2, 0), 10, 14, 6, 1.6, GOLD, M.Metal)
	K.block(CF(gx - 0.6, 2 + 24, c.Z) * ANG(PI / 4, 0, 0), V3(0.6, 4, 4), PINK, M.Neon)
	K.block(CF(gx - 0.5, 2 + 24, c.Z) * ANG(PI / 4, 0, 0), V3(0.5, 5.4, 5.4), GOLD, M.Metal)
	-- facade windows + side wings
	for s = -1, 1, 2 do
		pointedWindow(CF(gx - 0.2, 2 + 14, c.Z + s * 11) * ANG(0, -PI / 2, 0), 3.2, 7)
		K.bevel(CF(c + V3(18, 2 + 11, s * 34)), V3(26, 22, 28), CREAM, M.SmoothPlastic)
		K.block(CF(c + V3(18, 2 + 22.5, s * 34)), V3(27, 1, 29), CHOC, M.SmoothPlastic)
		for k = -1, 1 do pointedWindow(CF(c.X + 4.8, 2 + 11, c.Z + s * 34 + k * 8) * ANG(0, -PI / 2, 0), 2.6, 6) end
		-- chocolate wedge buttresses with cream inlay
		buttress(V3(c.X + 2, 2, c.Z + s * 21), 26, 14, s > 0 and PI or 0)
		buttress(V3(c.X + 4, 2, c.Z + s * 47), 20, 12, s > 0 and PI or 0)
		-- candy-stripe columns with gold caps
		stripeColumn(V3(c.X - 3, 2, c.Z + s * 17), 30, 4)
		stripeColumn(V3(c.X + 2, 2, c.Z + s * 52), 34, 5)
		-- gold-tipped spires on the wings
		K.cone(c + V3(18, 2 + 23, s * 34), 6, 14, 6, CHOC, CHOC_D, M.SmoothPlastic)
		K.cone(c + V3(18, 2 + 37, s * 34), 1.4, 5, 5, GOLD, K.dark(GOLD, 0.15), M.Metal)
	end
	-- central tower with whipped-cream swirl dome + gold spire
	K.bevel(CF(c + V3(20, 2 + 40, 0)), V3(16, 20, 16), CREAM, M.SmoothPlastic)
	for s = -1, 1, 2 do pointedWindow(CF(c.X + 11.8, 2 + 42, c.Z + s * 3.5) * ANG(0, -PI / 2, 0), 2, 6) end
	creamSwirl(c + V3(20, 2 + 50, 0), 9, 16)
	for s = -1, 1, 2 do
		K.bevel(CF(c + V3(30, 2 + 36, s * 10)), V3(6, 10, 6), CHOC, M.SmoothPlastic)
		K.cone(c + V3(30, 2 + 41, s * 10), 3.6, 10, 6, CHOC_L, CHOC, M.SmoothPlastic)
		K.cone(c + V3(30, 2 + 50.5, s * 10), 0.8, 3, 5, GOLD, K.dark(GOLD, 0.15), M.Metal)
	end
end

local function chocoPeak(pos, w, h)
	K.cone(pos, w, h, 7, CHOC, CHOC_D, M.SmoothPlastic, true)
	K.cone(pos + V3(0, h * 0.62, 0), w * 0.42, h * 0.38, 7, ICING, CREAM, M.SmoothPlastic)
end

function B.Build(b)
	K.Seed(5005)
	K.ResetSurfaces()
	K.mirror = true
	local z1, z2 = b[1], b[2]
	-- low pink sugar terraces with cream caps and pink crystal fronts
	K.terraces(z1, z2, {
		rock = C(236, 150, 186), rockMat = M.SmoothPlastic, cap = C(255, 214, 230), capMat = M.SmoothPlastic, drip = true, tiers = 2,
		h1 = { 1.4, 3 }, h2 = { 4, 9 },
		skip = { { 1, 1010, 1190 }, { -1, 950, 1060 } },
		facade = function(s, x1, top, za, zb)
			local z = za
			while z < zb - 1 do
				local l = math.min(K.r(4, 7), zb - z)
				K.bevel(CF(s * (x1 + 1.1), top / 2 - 0.3, z + l / 2), V3(2.8, top + 0.6, l - 0.2), C(240, 160, 196):Lerp(C(250, 186, 212), K.r(0, 1)), M.SmoothPlastic)
				z += l
			end
		end,
	})
	---------------------------------------------------------------- LEFT: chocolate cliff + waterfall + canal, trees, lollipops, crystals, gumdrops
	chocoCliff(V3(-62, 0, 1000))
	-- gold-edged chocolate canal running along the lane edge from the falls
	K.block(CF(-47, 0.2, 1100), V3(6, 0.25, 200), C(110, 62, 36), M.SmoothPlastic)
	for s = -1, 1, 2 do K.block(CF(-47 + s * 3.3, 0.35, 1100), V3(0.6, 0.7, 200), GOLD, M.Metal) end
	for _ = 1, 6 do K.ellipsoid(CF(-47 + K.r(-1.5, 1.5), 0.38, K.r(1004, 1196)), V3(K.r(1, 2), 0.1, K.r(3, 6)), CHOC_L, M.SmoothPlastic) end
	for _, p in ipairs({ { -56, 960, 1.4 }, { -64, 1068, 1.6 }, { -58, 1150, 1.3 }, { -70, 1230, 1.7 }, { -60, 1280, 1.2 }, { -90, 1110, 2 }, { -96, 1200, 2.2 } }) do
		candyTree(K.at(p[1], p[2]), p[3])
	end
	lollipop(K.at(-52, 1030), 1.4, PI / 2)
	lollipop(K.at(-56, 1180), 1.1, PI / 2)
	lollipop(K.at(-54, 1260), 1.3, PI / 2)
	---------------------------------------------------------------- RIGHT: the palace + trees, lollipops
	palace(V3(78, 0, 1100))
	lollipop(K.at(56, 960), 1.5, -PI / 2)
	lollipop(K.at(58, 1228), 1.3, -PI / 2)
	for _, p in ipairs({ { 54, 990, 1.5 }, { 62, 1215, 1.6 }, { 60, 1270, 1.3 }, { 96, 960, 2 }, { 110, 1250, 2.2 } }) do
		candyTree(K.at(p[1], p[2]), p[3])
	end
	---------------------------------------------------------------- crystals + gumdrops at both lane edges (low)
	for s = -1, 1, 2 do
		for z = z1 + 10, z2 - 8, 12 do
			local p = V3(s * K.r(39, 44), 0, z + K.r(-4, 4))
			local q = K.r(0, 1)
			if q < 0.45 then gumdrop(p, K.r(0.9, 1.3), K.chance(0.65) and ORANGE or RED)
			elseif q < 0.8 then K.crystal(p, K.r(2, 3.6), K.r(0.9, 1.3), K.chance(0.5) and PINK or PINK_L, ANG(0, K.r(0, PI), s * 0.3))
			else K.crystalCluster(p, K.r(0.6, 0.9), { PINK, PINK_L, PINK_D }, nil) end
		end
	end
	for _, r in ipairs(K.surfaces) do
		local xa, xb = math.max(r[1], -90), math.min(r[2], 90)
		if xb - xa > 3 and r[5] < 9 then
			for _ = 1, math.floor((xb - xa) * (r[4] - r[3]) / 160) do
				local x, z = K.r(xa + 2, xb - 2), K.r(r[3] + 2, r[4] - 2)
				if math.abs(x) >= 48 and not (x > 45 and z > 1040 and z < 1160) then
					local p = V3(x, r[5], z)
					if K.chance(0.5) then gumdrop(p, K.r(0.9, 1.4), K.chance(0.6) and ORANGE or RED) else K.crystal(p, K.r(2.5, 4.5), 1.2, PINK, ANG(0, 0, K.r(-0.3, 0.3))) end
				end
			end
		end
	end
	---------------------------------------------------------------- CENTRE: wavy cream ribbon along both lane edges (flush)
	for s = -1, 1, 2 do
		local prev
		for z = z1 + 2, z2 - 2, 6 do
			local x = s * (33 + math.sin(z * 0.035 + s) * 2.4)
			local p = V3(x, 0.14, z)
			if prev then K.block(CF((prev + p) / 2, p), V3(2.4, 0.22, (p - prev).Magnitude + 0.6), CREAM, M.SmoothPlastic) end
			prev = p
		end
	end
	---------------------------------------------------------------- far chocolate peaks with icing + pink crystal spires
	for s = -1, 1, 2 do
		for _ = 1, 5 do chocoPeak(V3(s * K.r(130, 175), 0, K.r(z1, z2 + 60)), K.r(18, 28), K.r(40, 80)) end
		for _ = 1, 4 do K.crystal(V3(s * K.r(115, 140), 0, K.r(z1, z2)), K.r(24, 40), K.r(5, 8), PINK_L, ANG(0, 0, K.r(-0.15, 0.15))) end
	end
	---------------------------------------------------------------- transition to Space: darker chocolate strata becoming lunar rock
	for s = -1, 1, 2 do
		for _ = 1, 3 do
			local p = V3(s * K.r(44, 58), 0, K.r(1282, 1298))
			K.rockMass(p, K.r(4, 7), K.r(3, 6), K.r(4, 7), C(70, 56, 60), M.Slate, 2)
		end
	end
	K.mirror = false
end

return B
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">BiomeCrystal</string><ProtectedString name="Source"><![CDATA[-- BiomeCrystal: Crystal Caves, Z [600, 900). Reference: roblox pets/Maps/04_Crystal_Biome_Final.png (1:1 inventory).
-- Authored as seen in the reference (K.mirror = true: design -X = screen-left). NO creature landmark.
--  LEFT : CL1 giant split geode (purple shell, pale-pink quartz rim, huge cyan + violet crystal fan, stepped
--         ledges) · CL2 turquoise mineral pool with ledges · CL3 rune monolith (dark slab, gold trim, cyan
--         diamond) · CL4 tall glowing cyan mushrooms · CL5 pink crystal clusters on purple rock steps
--  RIGHT: CR1 layered pink sandstone strata mounds + pink sand · CR2 turquoise pools + small cyan fall ·
--         CR3 two rune monoliths · CR4 pink mushrooms · CR5 violet/cyan crystal clusters
--  BACK : tall canyon walls with crystal ledges, light shafts from above (beside, not over, the corridor)
--  CENTRE: quiet dark slab road.
-- Location: ServerScriptService > Server > BiomeCrystal (ModuleScript)

local K = require(script.Parent.WorldKit)
local V3, CF, ANG, PI, M = K.V3, K.CF, K.ANG, K.PI, K.M
local C = K.C

local B = {}

local ROCK, ROCK_D, ROCK_L = C(86, 66, 132), C(54, 42, 92), C(112, 90, 160)
local CYAN, VIOLET, PINK, MAGENTA = C(90, 232, 255), C(170, 100, 255), C(255, 120, 210), C(230, 70, 220)
local QUARTZ, SAND = C(250, 222, 240), C(252, 196, 214)
local GOLD, POOL = C(222, 172, 84), C(70, 224, 222)

local function rockCol() return ROCK:Lerp(ROCK_D, K.r(0, 0.8)):Lerp(ROCK_L, K.r(0, 0.3)) end

local function facade(s, x1, top, za, zb)
	local z = za
	while z < zb - 1 do
		local l = math.min(K.r(3.5, 6.5), zb - z)
		local h = top + K.r(-0.3, 0.8)
		K.bevel(CF(s * (x1 + 1.1), h / 2 - 0.4, z + l / 2) * ANG(0, K.r(-0.06, 0.06), 0), V3(2.8, h + 0.6, l - 0.2), rockCol(), M.Slate)
		if K.chance(0.22) then K.crystal(V3(s * (x1 + 0.6), h + 0.1, z + l / 2), K.r(1.6, 3), K.r(0.6, 0.9), K.chance(0.5) and PINK or CYAN, ANG(0, K.r(0, PI), s * -0.3), true) end
		z += l
	end
end

-- CL3 / CR3: rune monolith with gold trim and a glowing cyan diamond
local function monolith(pos, yaw, h)
	h = h or 16
	local cf = CF(pos) * ANG(0, yaw, 0)
	K.bevel(cf * CF(0, 1, 0), V3(6, 2, 4.4), ROCK_D, M.Slate)
	K.block(cf * CF(0, 2.15, 0), V3(5.4, 0.3, 3.8), GOLD, M.Metal)
	K.bevel(cf * CF(0, 2 + h / 2, 0), V3(4, h, 2.4), C(70, 62, 100), M.Slate)
	K.wedge(cf * CF(0, 2 + h + 1.2, 0), V3(4, 2.4, 2.4), C(70, 62, 100), M.Slate)
	for s = -1, 1, 2 do K.block(cf * CF(s * 1.75, 2 + h / 2, -1.25), V3(0.3, h - 1, 0.15), GOLD, M.Metal) end
	local gy = 2 + h * 0.55
	K.block(cf * CF(0, gy, -1.25) * ANG(0, 0, PI / 4), V3(2.6, 2.6, 0.2), GOLD, M.Metal)
	local gem = K.block(cf * CF(0, gy, -1.4) * ANG(0, 0, PI / 4), V3(1.8, 1.8, 0.3), CYAN, M.Neon)
	K.lamp(gem, CYAN, 20, 1.2)
	K.tag(gem, "TPFC_Pulse", { Period = K.r(9, 14), Base = 0, Peak = 0.4 })
end

-- CL4 / CR4: tall glowing mushroom
local function glowShroom(pos, s, col)
	K.vcyl(pos, 3.2 * s, 0.8 * s, K.light(col, 0.55), M.SmoothPlastic)
	local under = K.ellipsoid(CF(pos + V3(0, 3.2 * s, 0)), V3(3.6, 0.5, 3.6) * s, col, M.Neon)
	K.ellipsoid(CF(pos + V3(0, 3.5 * s, 0)), V3(4, 1.8, 4) * s, K.dark(col, 0.15), M.SmoothPlastic)
	for i = 0, 3 do
		local a = i / 4 * PI * 2 + 0.3
		K.ellipsoid(CF(pos + V3(math.cos(a) * 0.9 * s, 4.25 * s, math.sin(a) * 0.9 * s)), V3(0.5, 0.15, 0.5) * s, K.light(col, 0.6), M.Neon)
	end
	if s >= 1.2 then K.lamp(under, col, 12 * s, 0.7) end
end
local function shroomCluster(pos, s, col)
	glowShroom(pos, s, col)
	glowShroom(pos + V3(K.r(1.5, 2.5) * s, 0, K.r(-1.5, 1.5) * s), s * 0.6, col)
	glowShroom(pos + V3(K.r(-2.5, -1.5) * s, 0, K.r(-1, 1) * s), s * 0.45, col)
end

-- CR1: layered pink sandstone strata mound with sand skirt and crystals
local function strata(pos, s)
	local y = 0
	local yaw = K.r(0, PI)
	for i = 0, 4 do
		local w = (14 - i * 2.3) * s
		local th = K.r(1.8, 2.6) * s
		local cf = CF(pos + V3(K.r(-0.8, 0.8) * s, y + th / 2, K.r(-0.8, 0.8) * s)) * ANG(0, yaw + K.r(-0.25, 0.25), 0)
		K.bevel(cf, V3(w, th, w * 0.75), i % 2 == 0 and C(244, 150, 196) or C(250, 190, 216), M.Sandstone)
		K.block(cf * CF(0, -th * 0.15, 0), V3(w + 0.1, th * 0.18, w * 0.75 + 0.1), C(226, 112, 170), M.Sandstone)
		y += th * 0.9
	end
	K.ellipsoid(CF(pos + V3(0, 0.3, 0)), V3(18, 0.8, 15) * s, SAND, M.Sand)
	K.crystalCluster(pos + V3(K.r(-2, 2) * s, y, K.r(-2, 2) * s), s * 0.9, { PINK, MAGENTA, C(255, 170, 230) }, 0)
end

-- CL2 / CR2: turquoise mineral pool with stepped rock rim
local function pool(pos, w, d)
	local water = K.block(CF(pos + V3(0, 0.3, 0)), V3(w, 0.3, d), POOL, M.Glass, false, 0.18)
	K.tag(water, "TPFC_Pulse", { Period = K.r(7, 11), Base = 0.18, Peak = 0.05 })
	K.lamp(water, POOL, 18, 0.6)
	K.block(CF(pos + V3(0, 0.1, 0)), V3(w, 0.2, d), C(30, 100, 120), M.Slate)
	for i = 0, math.floor((w + d) / 2.4) do
		local t = i / math.floor((w + d) / 2.4) * PI * 2
		local p = pos + V3(math.cos(t) * (w / 2 + 1.2), 0, math.sin(t) * (d / 2 + 1.2))
		K.bevel(CF(p + V3(0, 0.6, 0)) * ANG(0, -t, 0), V3(2.6, K.r(1, 1.8), 2.6), rockCol(), M.Slate)
	end
	for _ = 1, 3 do K.crystal(pos + V3(K.r(-w / 2, w / 2), 0, (K.chance(0.5) and 1 or -1) * (d / 2 + 1.5)), K.r(2, 3.5), 0.9, K.chance(0.5) and PINK or CYAN, ANG(0, 0, K.r(-0.4, 0.4)), true) end
end

-- CL1: the split geode (opening faces the lane, +X design)
local function geode(c)
	-- stepped ledges in front
	for i = 0, 3 do
		K.bevel(CF(c + V3(14 - i * 5, 1 + i * 1.6, 0)), V3(10, 2 + i * 3.2, 70 - i * 8), rockCol(), M.Slate)
		K.addSurface(c.X + 9 - i * 5, c.X + 19 - i * 5, c.Z - 35 + i * 4, c.Z + 35 - i * 4, 2 + i * 3.2)
	end
	-- outer shell: a half dome of faceted rock slabs around the back
	for i = 0, 18 do
		local a = (i / 18) * PI
		local p = c + V3(-math.sin(a) * 30, 0, math.cos(a) * 42)
		local h = 30 + math.sin(a) * 32
		K.block(CF(p + V3(0, h / 2, 0)) * ANG(0, -a, -0.18), V3(12, h, 12), rockCol(), M.Slate, true)
		-- the shell crown curls toward the lane
		K.block(CF(p + V3(4, h + 3, 0)) * ANG(0, -a, -0.6), V3(12, 8, 12), rockCol(), M.Slate)
		-- glowing magenta cracks on the outer face
		if i % 3 == 0 then
			local cr = K.block(CF(p + V3(-6.1, h * 0.55, 0)) * ANG(0, -a, 0) * ANG(K.r(-0.5, 0.5), 0, 0), V3(0.2, h * 0.4, 0.5), MAGENTA, M.Neon)
			K.tag(cr, "TPFC_Pulse", { Period = K.r(9, 14), Base = 0.2, Peak = 0 })
		end
	end
	-- pale-pink quartz ring around the opening (lumpy band in the lane-facing plane)
	local rimX, H, Wd = c.X + 6, 46, 58
	for i = 0, 30 do
		local t = i / 30 * PI
		local p = V3(rimX + K.r(-0.6, 0.6), math.sin(t) * H, math.cos(t) * Wd / 2 + c.Z)
		K.block(CF(p) * ANG(t, K.r(-0.3, 0.3), K.r(-0.3, 0.3)), V3(K.r(3.5, 5), K.r(4, 6), K.r(4, 6)), QUARTZ:Lerp(SAND, K.r(0, 0.6)), M.SmoothPlastic)
		if i % 2 == 0 then K.block(CF(p + V3(1.4, 0, 0)) * ANG(t, 0.4, 0.4), V3(2.2, 2.4, 2.2), K.light(QUARTZ, 0.4), M.Glass, false, 0.2) end
	end
	-- the crystal fan bursting from the back of the geode
	local fan = c + V3(-2, 0, 0)
	for i = 0, 14 do
		local a = (i / 14 - 0.5) * 2.6
		local len = 40 - math.abs(i - 7) * 3
		local col = (i % 3 == 0) and VIOLET or ((i % 3 == 1) and CYAN or C(150, 200, 255))
		local cr = K.crystal(fan + V3(0, 0, math.sin(a) * 10), len, K.r(8, 10), col, ANG(0, 0, -0.75) * ANG(a * 0.5, 0, 0), i % 3 == 0)
		if i == 7 then K.lamp(cr, CYAN, 70, 3) end
		if i % 4 == 0 then K.tag(cr, "TPFC_Pulse", { Period = 3 + i * 0.3, Base = 0, Peak = 0.3 }) end
	end
	for _ = 1, 14 do
		K.crystal(c + V3(K.r(-12, 6), K.r(2, 8), K.r(-28, 28)), K.r(3, 8), K.r(1.2, 2.2), K.chance(0.5) and PINK or CYAN, ANG(K.r(-0.5, 0.5), 0, K.r(-0.8, 0.2)), K.chance(0.3))
	end
end

-- canyon wall segment with crystal ledges (far sides)
local function canyon(x, z, h)
	K.bevel(CF(x, h / 2, z), V3(26, h, K.r(26, 40)), rockCol(), M.Slate)
	K.block(CF(x - (x > 0 and 4 or -4), h + 2, z) * ANG(0, 0, (x > 0 and -1 or 1) * 0.3), V3(22, 6, 30), rockCol(), M.Slate)
	for _ = 1, 3 do
		K.crystalCluster(V3(x - (x > 0 and 12 or -12), K.r(8, h - 4), z + K.r(-10, 10)), K.r(0.8, 1.3), { PINK, CYAN, VIOLET }, K.ri(0, 4))
	end
end

function B.Build(b)
	K.Seed(4004)
	K.ResetSurfaces()
	K.mirror = true
	local z1, z2 = b[1], b[2]
	K.terraces(z1, z2, {
		rock = ROCK, rockMat = M.Slate, cap = ROCK_L, capMat = M.Slate, drip = false, tiers = 3,
		h1 = { 1.6, 3.4 }, h2 = { 5, 10 }, h3 = { 8, 18 },
		skip = { { -1, 690, 830 } },
		facade = facade,
	})
	---------------------------------------------------------------- LEFT: geode, pool, monolith, mushrooms, crystals
	geode(V3(-82, 0, 760))
	pool(V3(-56, 0, 664), 14, 20)
	monolith(K.at(-60, 640), PI / 2, 18)
	monolith(K.at(-58, 852), PI / 2, 14)
	shroomCluster(K.at(-50, 690), 1.4, CYAN)
	shroomCluster(K.at(-52, 842), 1.1, CYAN)
	---------------------------------------------------------------- RIGHT: strata mounds, pools + fall, monoliths, pink mushrooms
	strata(K.at(66, 650), 1.2)
	strata(K.at(74, 730), 1.5)
	strata(K.at(62, 812), 1.1)
	strata(K.at(84, 872), 1.3)
	pool(V3(54, 0, 700), 12, 16)
	pool(V3(56, 0, 860), 10, 14)
	for i = 0, 2 do
		local seg = K.block(CF(60.5, 3 + i * 1.8, 700), V3(0.7, 2, 4 - i * 0.6), i % 2 == 0 and POOL or K.light(POOL, 0.3), M.Glass, false, 0.1)
		K.tag(seg, "TPFC_Pulse", { Period = K.r(4, 6), Base = 0.1, Peak = 0.02 })
	end
	monolith(K.at(56, 760), -PI / 2, 16)
	monolith(K.at(58, 888), -PI / 2, 13)
	shroomCluster(K.at(50, 740), 1.2, PINK)
	shroomCluster(K.at(52, 620), 1, PINK)
	---------------------------------------------------------------- dressing: crystal clusters on every terrace top within view
	for _, r in ipairs(K.surfaces) do
		local xa, xb = math.max(r[1], -90), math.min(r[2], 90)
		if xb - xa > 3 then
			for _ = 1, math.floor((xb - xa) * (r[4] - r[3]) / 170) do
				local x, z = K.r(xa + 2, xb - 2), K.r(r[3] + 2, r[4] - 2)
				if math.abs(x) >= 48 then
					local q = K.r(0, 1)
					local p = V3(x, r[5], z)
					if q < 0.6 then K.crystalCluster(p, K.r(0.6, 1.2), { PINK, CYAN, VIOLET, MAGENTA }, K.chance(0.3) and 0 or nil)
					elseif q < 0.8 then glowShroom(p, K.r(0.8, 1.2), K.chance(0.5) and CYAN or PINK)
					else K.bevel(CF(p + V3(0, 0.8, 0)) * ANG(0, K.r(0, PI), 0), V3(K.r(2.4, 4), 1.8, K.r(2.4, 4)), rockCol(), M.Slate) end
				end
			end
		end
	end
	-- lane edge crystals + small rocks (low)
	for s = -1, 1, 2 do
		for z = z1 + 8, z2 - 6, 11 do
			local p = V3(s * K.r(37, 43), 0, z + K.r(-3, 3))
			if K.chance(0.5) then K.crystal(p, K.r(1.6, 3), K.r(0.6, 1), K.pick({ PINK, CYAN, VIOLET }), ANG(0, K.r(0, PI), s * 0.4), K.chance(0.3))
			else K.bevel(CF(p + V3(0, 0.5, 0)) * ANG(0, K.r(0, PI), 0), V3(K.r(2, 3.2), 1.2, K.r(2, 3.2)), rockCol(), M.Slate) end
		end
	end
	---------------------------------------------------------------- BACK: canyon walls, far crystal ledges, light shafts beside the corridor
	for s = -1, 1, 2 do
		for z = z1, z2, 34 do canyon(s * K.r(118, 132), z + K.r(-6, 6), K.r(40, 70)) end
	end
	---------------------------------------------------------------- CENTRE: quiet dark slab road
	for z = z1 + 1, z2 - 13, 14 do
		for x = -27.5, 27.5, 11 do
			K.block(CF(x + K.r(-0.15, 0.15), 0.18, z + 7), V3(10.7, 0.3, 13.7), C(70, 62, 96):Lerp(C(84, 76, 110), K.r(0, 1)), M.Slate)
		end
	end
	---------------------------------------------------------------- transition to Candy: rounded pink mineral/sugar insets
	for s = -1, 1, 2 do
		for _ = 1, 3 do
			local p = V3(s * K.r(44, 56), 0, K.r(882, 898))
			K.ellipsoid(CF(p + V3(0, 1, 0)), V3(K.r(4, 6), K.r(2, 3), K.r(4, 6)), C(255, 190, 220), M.SmoothPlastic)
			K.crystal(p + V3(0, 1.5, 0), K.r(2, 3), 0.8, PINK, ANG(0, 0, s * 0.3))
		end
	end
	K.mirror = false
end

return B
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">BiomeForest</string><ProtectedString name="Source"><![CDATA[-- BiomeForest: Green Forest, Z [0, 150). Reference: roblox pets/Maps/01_Forest_Biome.png (built 1:1 from
-- its element inventory). Authored as seen in the reference (K.mirror = true: design -X = screen-left).
--  LEFT : L1 big curved-trunk tree (near) · L2 vine-covered ruin arch with carved leaf panels ·
--         L3 turquoise pool + small fall behind the arch · L4 corner bed: lilies, spotted mushrooms, ferns,
--         clover · L5 stepping slabs · L6 chamfered mossy terrace blocks · L7 stone marker ·
--         L8 stepped terraces, bushes, trees · L9 watchtower on a rocky plateau · L10 distant aqueduct ruin
--  RIGHT: R1 giant oak with sprawling roots over stone terraces · R2 leaf-rune standing stones ·
--         R3 two-step waterfall, turquoise pool, stream toward the viewer, stepping slabs ·
--         R4 lilies + big ferns · R5 mossy foreground outcrop · R6 round trees · R7 scorched transition
--  CENTRE: calm grass with clover patches, carved leaf threshold, scorched path toward the volcano.
-- Location: ServerScriptService > Server > BiomeForest (ModuleScript)

local K = require(script.Parent.WorldKit)
local V3, CF, ANG, PI, M = K.V3, K.CF, K.ANG, K.PI, K.M
local C = K.C

local B = {}

local LEAF = { C(150, 196, 70), C(118, 176, 60), C(96, 156, 54), C(132, 188, 66) }
local BARK, BARK_D = C(134, 90, 56), C(102, 66, 40)
local STONE, STONE_D, MOSS = C(208, 196, 168), C(172, 160, 134), C(112, 166, 60)
local WATER, FOAM = C(104, 212, 196), C(220, 250, 244)
local PINK, WHITE = C(255, 168, 206), C(255, 246, 250)

local function stoneCol() return STONE:Lerp(STONE_D, K.r(0, 1)) end

-- terrace front made of chamfered mossy cut blocks (L6 / R5)
local function facade(s, x1, top, za, zb)
	local z = za
	while z < zb - 1 do
		local l = math.min(K.r(3.5, 6), zb - z)
		local h = top + K.r(-0.3, 0.6)
		K.bevel(CF(s * (x1 + 1.1), h / 2 - 0.3, z + l / 2) * ANG(0, K.r(-0.05, 0.05), 0), V3(2.8, h + 0.6, l - 0.15), stoneCol(), M.Limestone, MOSS)
		z += l
	end
end

-- R2 / L7: standing stone with carved leaf rune and moss top
local function runeStone(pos, yaw, h)
	h = h or 5
	local cf = CF(pos) * ANG(0, yaw, 0)
	K.bevel(cf * CF(0, 0.5, 0), V3(3.4, 1, 2.6), STONE_D, M.Limestone, MOSS)
	K.bevel(cf * CF(0, 1 + h / 2, 0), V3(2.4, h, 1.5), STONE, M.Limestone)
	K.wedge(cf * CF(0, 1 + h + 0.5, 0), V3(2.4, 1, 1.5), STONE, M.Limestone)
	K.leafGlyph(cf * CF(0, 1 + h * 0.55, -0.78), 1.1, K.light(STONE, 0.2))
	local glow = K.block(cf * CF(0, 1 + h * 0.55, -0.74), V3(0.5, 0.5, 0.05), C(190, 255, 140), M.Neon, false, 0.4)
	K.tag(glow, "TPFC_Pulse", { Period = K.r(10, 15), Base = 0.7, Peak = 0.2 })
	K.block(cf * CF(0.2, 1 + h + 1.05, 0), V3(1.8, 0.3, 1.2), MOSS, M.SmoothPlastic)
end

-- R1: the giant oak (trunk base at pos on the plateau)
local function giantOak(pos, S)
	local top = pos + V3(-2, 21, 0) * S
	-- folded trunk: a core plus four twisting strands
	K.limb(pos, pos + V3(0, 15, 0) * S, top, 11 * S, 7.5 * S, 6, BARK, M.Wood, true)
	for i = 0, 3 do
		local a = i / 4 * PI * 2 + 0.3
		local d = V3(math.cos(a), 0, math.sin(a))
		local twist = V3(math.cos(a + 1), 0, math.sin(a + 1))
		K.limb(pos + d * 4.5 * S, pos + twist * 5 * S + V3(0, 14, 0) * S, top + d * 2.5 * S, 4.2 * S, 3 * S, 6, i % 2 == 0 and BARK_D or BARK, M.Wood)
	end
	-- sprawling roots draping over the tiers (lane-side roots reach the lower terrace)
	for i = 0, 8 do
		local a = i / 9 * PI * 2 + 0.2
		local d = V3(math.cos(a), 0, math.sin(a))
		local reach = K.r(16, 24) * S
		local drop = (d.X < -0.3) and -7.5 or -2.5
		local _, mid = K.limb(pos + d * 4.5 * S + V3(0, 4, 0), pos + d * (reach * 0.45) + V3(0, 3.5 * S, 0), pos + d * reach + V3(0, drop, 0), 3.4 * S, 1.2 * S, 5, i % 2 == 0 and BARK or BARK_D, M.Wood)
		if K.chance(0.6) then
			local side = V3(-d.Z, 0, d.X) * (K.chance(0.5) and 1 or -1)
			K.limb(mid, mid + side * 3 * S + d * 2 * S, mid + side * 6 * S + d * 4 * S + V3(0, -2.5, 0), 1.4 * S, 0.6 * S, 3, BARK_D)
		end
	end
	-- glowing knot rune on the lane side of the trunk
	local knot = K.block(CF(pos + V3(-7.6 * S, 16 * S, 0)) * ANG(0, PI / 2, 0), V3(3, 3.4, 0.3) * S, C(255, 214, 110), M.Neon, false, 0.2)
	K.tag(knot, "TPFC_Pulse", { Period = 8, Base = 0.4, Peak = 0.05 })
	K.lamp(knot, C(255, 210, 120), 28, 0.9)
	K.leafGlyph(CF(pos + V3(-7.9 * S, 16 * S, 0)) * ANG(0, PI / 2, 0), 2 * S, C(255, 230, 150))
	-- six great limbs, each with two sub-branches and a rosette canopy
	for i = 0, 5 do
		local a = i / 6 * PI * 2 + 0.5
		local d = V3(math.cos(a), 0, math.sin(a))
		local reach = ((d.X < -0.4) and 20 or 25) * S
		local tip, mid = K.limb(top - V3(0, 3, 0) * S, top + d * 11 * S + V3(0, 6, 0) * S, top + d * reach + V3(0, 6, 0) * S, 4 * S, 1.5 * S, 6, BARK, M.Wood)
		for f = -1, 1, 2 do
			local side = V3(-d.Z, 0, d.X) * f
			local t2 = mid + (side * 10 + d * 6 + V3(0, 5, 0)) * S
			K.limb(mid, mid + (side * 4 + V3(0, 5, 0)) * S, t2, 1.8 * S, 0.7 * S, 3, BARK_D)
			K.canopy(t2 + V3(0, 2, 0) * S, 6 * S, 3 * S, 4, 1.9 * S, LEAF, true)
			K.vine(mid + side * 3 * S + V3(0, -1, 0), K.r(6, 14))
		end
		K.canopy(tip + V3(0, 3, 0) * S, 8 * S, 4 * S, 6, 2.1 * S, LEAF, true)
	end
	K.canopy(top + V3(0, 13, 0) * S, 16 * S, 5 * S, 16, 2.3 * S, LEAF, true)
end

-- L2: ruin arch (plane along the lane, angled toward the viewer) with carved panels and vines
local function ruinArch(pos, yaw)
	local cf = CF(pos) * ANG(0, yaw, 0)
	K.stairs(cf * CF(0, 0, -3.2) * ANG(0, PI, 0), 13, 2, 0.5, 1.4, STONE_D, M.Limestone)
	K.bevel(cf * CF(0, 0.4, 0), V3(14, 0.8, 4.4), STONE_D, M.Limestone, MOSS)
	K.arch(cf * CF(0, 0.8, 0), 7, 8.5, 2.6, STONE, M.Limestone, nil, nil, 7)
	for s = -1, 1, 2 do
		local px = s * 4.75
		for y = 2.5, 7.5, 2.5 do K.block(cf * CF(px, y + 0.8, 0), V3(2.75, 0.12, 2.75), STONE_D, M.Limestone) end -- stacked joints
		K.block(cf * CF(px, 5.3, -1.33), V3(1.8, 2.6, 0.1), STONE_D, M.Limestone)
		K.leafGlyph(cf * CF(px, 5.3, -1.42), 1, K.light(STONE, 0.18))
	end
	K.leafGlyph(cf * CF(0, 14.3, -1.6), 1.1, K.light(STONE, 0.2))
	-- vines over the arch and down the piers
	for _ = 1, 10 do
		local x = K.r(-6, 6)
		local y = 0.8 + 8.5 + math.sqrt(math.max(0, 22 - x * x)) * 1.05
		K.vine(cf * V3(x, y, -1.4), K.r(2, 6))
	end
	for s = -1, 1, 2 do K.vine(cf * V3(s * 6.2, 9.6, -0.6), K.r(5, 8)) end
	K.rosette(cf * V3(4.5, 14.6, 0), 0.45, LEAF[2])
	K.rosette(cf * V3(-3, 15.2, 0.2), 0.4, LEAF[1])
	-- fallen blocks
	for _ = 1, 3 do
		local p = pos + cf.RightVector * K.r(-8, 8) + cf.LookVector * K.r(3, 6) + V3(0, 0.7, 0)
		K.bevel(CF(p) * ANG(0, K.r(0, PI), K.r(-0.15, 0.15)), V3(2.2, 1.4, 2.2), STONE, M.Limestone, MOSS)
	end
end

-- L9: watchtower on a rocky plateau (two-tier roof, railing with balusters, ladder)
local function watchtower(pos)
	local wood, plank, roof = C(124, 84, 52), C(160, 116, 72), C(150, 82, 56)
	for i = 0, 2 do
		local w = 18 - i * 3
		K.bevel(CF(pos + V3(K.r(-1, 1), i * 4 + 2, K.r(-1, 1))), V3(w, 4, w), stoneCol(), M.Limestone, MOSS)
	end
	local base = pos + V3(0, 12, 0)
	K.addSurface(pos.X - 6, pos.X + 6, pos.Z - 6, pos.Z + 6, 12)
	for _, c in ipairs({ { -3.5, -3.5 }, { 3.5, -3.5 }, { -3.5, 3.5 }, { 3.5, 3.5 } }) do
		K.block(CF(base + V3(c[1], 8, c[2])), V3(1.2, 16, 1.2), wood, M.Wood, true)
		K.block(CF(base + V3(c[1], 0.5, c[2])), V3(1.8, 1, 1.8), STONE_D, M.Limestone)
	end
	for _, y in ipairs({ 5, 11 }) do
		for s = -1, 1, 2 do
			K.block(CF(base + V3(s * 3.5, y, 0)) * ANG(0.62, 0, 0), V3(0.5, 8.8, 0.5), wood, M.Wood)
			K.block(CF(base + V3(0, y, s * 3.5)) * ANG(0, 0, 0.62), V3(8.8, 0.5, 0.5), wood, M.Wood)
		end
	end
	K.block(CF(base + V3(0, 16.4, 0)), V3(10.5, 0.8, 10.5), plank, M.WoodPlanks, true)
	for s = -1, 1, 2 do
		K.block(CF(base + V3(s * 5, 18, 0)), V3(0.4, 0.4, 10.5), wood, M.Wood)
		K.block(CF(base + V3(0, 18, s * 5)), V3(10.5, 0.4, 0.4), wood, M.Wood)
		for k = -4, 4, 2 do
			K.block(CF(base + V3(s * 5, 17.4, k)), V3(0.25, 1.4, 0.25), wood, M.Wood)
			K.block(CF(base + V3(k, 17.4, s * 5)), V3(0.25, 1.4, 0.25), wood, M.Wood)
		end
	end
	for _, c in ipairs({ { -4.6, -4.6 }, { 4.6, -4.6 }, { -4.6, 4.6 }, { 4.6, 4.6 } }) do
		K.block(CF(base + V3(c[1], 20, c[2])), V3(0.6, 6, 0.6), wood, M.Wood)
	end
	K.block(CF(base + V3(0, 23.1, 0)), V3(13, 0.5, 13), K.dark(roof, 0.25), M.WoodPlanks)
	K.pyramid(CF(base + V3(0, 23.3, 0)), 13, 3.4, roof, M.WoodPlanks)
	K.block(CF(base + V3(0, 26.4, 0)), V3(5, 2.4, 5), wood, M.Wood)
	K.pyramid(CF(base + V3(0, 27.6, 0)), 7.5, 3.6, roof, M.WoodPlanks)
	K.pyramid(CF(base + V3(0, 31.1, 0)), 0.8, 1.4, C(220, 180, 90), M.Metal)
	local lamp = K.block(CF(base + V3(0, 19, 0)), V3(1, 1.2, 1), C(255, 210, 140), M.Glass, false, 0.1)
	K.lamp(lamp, C(255, 200, 130), 18, 0.8)
	for y = 1, 16, 1.6 do K.block(CF(base + V3(4.3, y, 0)), V3(0.3, 0.3, 2), wood, M.Wood) end
	for s = -1, 1, 2 do K.block(CF(base + V3(4.3, 8.5, s)), V3(0.3, 17, 0.3), wood, M.Wood) end
end

-- R3 + L3: water pieces (turquoise glass with foam lips)
local function water(cf, size)
	local w = K.water(cf, size, WATER, 0.22)
	K.tag(w, "TPFC_Glint", { Period = K.r(9, 14) })
	return w
end
local function fall(topPos, h, w, faceYaw)
	K.waterfall(topPos, h, w, faceYaw, C(150, 228, 214), FOAM)
end

-- R7: scorched dead tree with glowing cracks
local function deadTree(pos, s)
	local burnt = C(58, 42, 36)
	K.limb(pos, pos + V3(0.5, 4 * s, 0), pos + V3(-0.5, 9 * s, 0.5), 1.6 * s, 0.7 * s, 4, burnt, M.Wood, true)
	for i = 1, 4 do
		local a = i / 4 * PI * 2 + K.r(-0.4, 0.4)
		local d = V3(math.cos(a), 0, math.sin(a))
		local b0 = pos + V3(0, K.r(4, 8) * s, 0)
		K.limb(b0, b0 + d * 2 * s + V3(0, 1.5 * s, 0), b0 + d * 4.5 * s + V3(0, K.r(1, 3.5) * s, 0), 0.6 * s, 0.25 * s, 2, burnt)
	end
	for k = 0, 2 do
		local crack = K.block(CF(pos + V3(0, (1.5 + k * 2.2) * s, 0)) * ANG(0, k * 2.1, 0) * CF(0, 0, -0.82 * s), V3(0.22, 1.6 * s, 0.1), C(255, 110, 30), M.Neon)
		K.tag(crack, "TPFC_Pulse", { Period = K.r(7, 12), Base = 0.2, Peak = 0 })
	end
end

function B.Build(b)
	K.Seed(1001)
	K.ResetSurfaces()
	K.mirror = true
	local z1, z2 = b[1], b[2]
	---------------------------------------------------------------- terraces (L6/L8 left, R5 right-front)
	K.terraces(z1 - 4, z2 - 14, {
		rock = STONE_D, rockMat = M.Limestone, cap = MOSS, capMat = M.SmoothPlastic, drip = true, tiers = 3,
		h1 = { 2.6, 4 }, h2 = { 5, 9 }, h3 = { 8, 15 },
		skip = { { 1, 40, 160 }, { -1, 108, 160 } },
		facade = facade,
	})
	---------------------------------------------------------------- R1 oak plateau
	K.block(CF(84, -1, 96), V3(72, 8, 112), STONE_D, M.Limestone, true) -- tier A top 3
	K.block(CF(84, 3.3, 96), V3(72, 0.6, 112), MOSS, M.SmoothPlastic)
	K.addSurface(48, 120, 40, 152, 3.6)
	facade(1, 46.5, 3.6, 40, 152)
	K.block(CF(92, 4, 100), V3(60, 8, 90), STONE, M.Limestone, true) -- tier B top 8
	K.block(CF(92, 8.3, 100), V3(60, 0.6, 90), MOSS, M.SmoothPlastic)
	K.addSurface(62, 122, 55, 145, 8.6)
	facade(1, 60.5, 8.6, 55, 145)
	K.stairs(CF(57, 3.6, 124) * ANG(0, -PI / 2, 0), 6, 4, 1.25, 1.5, STONE, M.Limestone)
	giantOak(V3(96, 8.6, 96), 1.7)
	-- R2 rune stones around the roots
	runeStone(V3(55, 3.6, 62), PI / 2 + 0.2, 4.5)
	runeStone(V3(57, 3.6, 92), PI / 2 - 0.15, 3.6)
	runeStone(V3(68, 8.6, 74), PI / 2 + 0.3, 6.5)
	runeStone(V3(70, 8.6, 128), PI / 2 - 0.3, 4)
	-- R3 two-step waterfall -> pool on tier A -> fall over the front -> stream toward the viewer
	fall(V3(61.6, 8.4, 70), 4.8, 7, PI / 2)
	water(CF(55, 3.75, 68), V3(11, 0.3, 14))
	for i = 1, 6 do K.bevel(CF(55 + K.r(-6, 6), 3.9, (i <= 3) and 60.2 or 75.8), V3(2.4, 1, 2.2), stoneCol(), M.Limestone, MOSS) end
	fall(V3(47.6, 3.6, 64), 3.4, 5, PI / 2)
	for _, sg in ipairs({ { 44, 64, 40 }, { 42.5, 40, 22 }, { 44, 22, 4 } }) do
		local zc, len = (sg[2] + sg[3]) / 2, sg[2] - sg[3]
		water(CF(sg[1], 0.14, zc), V3(5.5, 0.22, len + 3))
		K.block(CF(sg[1], 0.05, zc), V3(7, 0.1, len + 3), C(150, 140, 116), M.Slate)
	end
	for _ = 1, 6 do K.block(CF(43.5 + K.r(-1, 1), 0.35, K.r(8, 60)) * ANG(0, K.r(0, PI), 0), V3(2, 0.4, 1.8), STONE, M.Limestone) end
	-- R4 flowers and big ferns around the pool and stream
	for _ = 1, 5 do K.lily(V3(K.r(50, 60), 3.6, K.r(46, 84)), K.r(0.9, 1.2), K.chance(0.6) and PINK or WHITE) end
	for _ = 1, 3 do K.lily(V3(K.r(37, 39.5), 0, K.r(10, 40)), K.r(0.9, 1.1), PINK) end
	K.fernBig(V3(50, 3.6, 30), 1.8)
	K.fernBig(V3(39, 0, 52), 1.3)
	K.fernBig(V3(60, 3.6, 110), 1.5)
	K.fernBig(V3(52, 3.6, 140), 1.4)
	-- R6 round trees
	K.bigTree(V3(110, 8.6, 146), 1.6, LEAF, BARK)
	K.bigTree(K.at(72, 16), 1.8, LEAF, BARK, V3(-0.2, 0, 0))
	K.bigTree(V3(114, 3.6, 46), 1.5, LEAF, BARK)

	---------------------------------------------------------------- LEFT
	-- L1 big curved tree (near-left)
	K.bigTree(K.at(-62, 18), 2.3, LEAF, BARK, V3(0.2, 0, 0.1))
	-- L2 ruin arch + L3 pool and small fall behind it
	ruinArch(K.at(-58, 38), PI / 2 - 0.3)
	local pp = K.at(-70, 46)
	water(CF(pp + V3(0, 0.15, 0)), V3(12, 0.3, 16))
	for i = 1, 7 do K.bevel(CF(pp + V3(K.r(-7, 7), 0.4, (i % 2 == 0) and -8.4 or 8.4)), V3(2.2, 1, 2.2), stoneCol(), M.Limestone, MOSS) end
	fall(pp + V3(-6.5, 5.5, 0), 5.2, 6, -PI / 2)
	-- L4 corner bed: lilies, spotted mushrooms, ferns, clover
	K.lily(V3(-45, 0, 10), 1.3, PINK)
	K.lily(V3(-41, 0, 16), 1.1, WHITE)
	K.lily(V3(-47, 0, 21), 1.2, PINK)
	K.lily(V3(-39, 0, 28), 0.9, WHITE)
	K.toadstool(V3(-46, 0, 30), 1.35)
	K.toadstool(V3(-43.5, 0, 33), 0.8)
	K.fernBig(V3(-40, 0, 6), 1.2)
	K.fernBig(V3(-44, 0, 40), 1.1)
	for _ = 1, 10 do K.clover(V3(-K.r(36, 46), 0, K.r(4, 44)), K.r(0.9, 1.3)) end
	-- L5 stepping slabs
	for i = 0, 4 do K.block(CF(-37 - (i % 2) * 2.4, 0.12, 22 + i * 3.6) * ANG(0, K.r(0, 1), 0), V3(K.r(2.4, 3.2), 0.22, K.r(2, 2.6)), C(222, 214, 192), M.Limestone) end
	-- L7 marker
	K.bevel(CF(-44.5, 1.6, 50), V3(1.6, 3.2, 1.6), STONE, M.Limestone, MOSS)
	K.leafGlyph(CF(-44.5, 1.8, 50) * ANG(0, -PI / 2, 0) * CF(0, 0, -0.85), 0.6, K.light(STONE, 0.2))
	-- L8 terrace dressing: rosette bushes, lilies, trees
	for _ = 1, 14 do
		local p = K.at(-K.r(54, 74), K.r(z1 + 4, 106))
		if K.chance(0.6) then K.rosette(p + V3(0, 1, 0), K.r(0.45, 0.7), K.pick(LEAF)) else K.lily(p, K.r(0.8, 1), K.chance(0.5) and PINK or WHITE) end
	end
	K.bigTree(K.at(-74, 72), 1.9, LEAF, BARK)
	K.bigTree(K.at(-92, 98), 2.2, LEAF, BARK)
	K.bigTree(K.at(-104, 44), 2.4, LEAF, BARK)
	K.bigTree(K.at(-96, 0), 2, LEAF, BARK)
	-- L9 watchtower on its plateau (left, back)
	watchtower(V3(-80, 0, 124))
	K.bigTree(V3(-104, 0, 128), 1.4, LEAF, BARK)
	K.bigTree(V3(-62, 0, 116), 1.0, LEAF, BARK)
	-- L10 distant aqueduct ruin (far left skyline)
	for i = 0, 2 do
		K.arch(CF(-128, 0, 150 + i * 13) * ANG(0, PI / 2, 0), 8, 16, 3, STONE_D, M.Limestone, nil, nil, 7)
	end
	K.block(CF(-128, 27.5, 163), V3(3.4, 2, 40), STONE_D, M.Limestone)

	---------------------------------------------------------------- CENTRE
	-- carved leaf threshold across the start of the lane (flush)
	K.block(CF(0, 0.07, 11), V3(60, 0.14, 3), C(214, 204, 178), M.Limestone)
	K.block(CF(0, 0.1, 11) * ANG(0, PI / 4, 0), V3(2.6, 0.14, 2.6), C(214, 204, 178), M.Limestone)
	K.block(CF(0, 0.16, 11) * ANG(0, PI / 4, 0), V3(1.4, 0.14, 1.4), MOSS, M.SmoothPlastic)
	for x = -27, 27, 9 do K.block(CF(x, 0.11, 11), V3(0.2, 0.14, 3), C(176, 164, 138), M.Limestone) end
	-- clover patches and a few pale stone breaks
	for _ = 1, 34 do
		local x = K.r(18, 34) * (K.chance(0.5) and 1 or -1)
		K.clover(V3(x, 0, K.r(14, 132)), K.r(0.9, 1.4))
	end
	-- R7 scorched path + transition (z 126..150)
	for _ = 1, 8 do
		K.block(CF(K.r(-14, 14), 0.06, K.r(130, 150)) * ANG(0, K.r(0, PI), 0), V3(K.r(6, 10), 0.12, K.r(4, 7)), C(112, 84, 60), M.Ground)
	end
	for s = -1, 1, 2 do
		deadTree(V3(s * K.r(47, 52), 0, K.r(136, 142)), 1.2)
		deadTree(V3(s * K.r(60, 70), 0, K.r(144, 150)), 1.5)
		for _ = 1, 2 do
			local p = V3(s * K.r(40, 46), 0, K.r(132, 148))
			K.rockMass(p, K.r(3, 5), K.r(2, 3.5), K.r(3, 5), C(70, 56, 50), M.Basalt, 2)
		end
		for _ = 1, 3 do
			local crack = K.block(CF(s * K.r(32, 40), 0.08, K.r(134, 150)) * ANG(0, K.r(0, PI), 0), V3(0.3, 0.1, K.r(3, 6)), C(255, 110, 30), M.Neon, false, 0.2)
			K.tag(crack, "TPFC_Pulse", { Period = K.r(9, 14), Base = 0.25, Peak = 0 })
		end
	end
	-- skyline
	-- forested green hills behind the terraces (no grey rock walls) + soft distant ridges
	local T = K.terrain
	T:SetMaterialColor(M.LeafyGrass, C(92, 146, 62))
	for s = -1, 1, 2 do
		for z = z1 - 30, z2 + 30, 18 do
			T:FillBall(V3(s * K.r(128, 150), K.r(-14, -4), z + K.r(-6, 6)), K.r(22, 32), M.LeafyGrass)
			T:FillBall(V3(s * K.r(170, 200), K.r(-10, 6), z + K.r(-8, 8)), K.r(28, 40), M.LeafyGrass)
		end
	end
	-- dense ground cover on every terrace top within view (bushes, ferns, flowers, mossy stones, saplings)
	for _, r in ipairs(K.surfaces) do
		local xa, xb = math.max(r[1], -84), math.min(r[2], 84)
		if xb - xa > 3 then
			local n = math.floor((math.min(xb, 74) - xa) * (r[4] - r[3]) / 42)
			for _ = 1, n do
				local x, z = K.r(xa + 1.5, xb - 1.5), K.r(r[3] + 1.5, r[4] - 1.5)
				if math.abs(x) >= 46 and math.abs(x) <= 74 and (V3(x, 0, z) - V3(96, 0, 96)).Magnitude > 22 then
					local p = V3(x, r[5], z)
					local q = K.r(0, 1)
					if q < 0.5 then K.rosette(p + V3(0, 1.1, 0), K.r(0.7, 1.15), K.pick(LEAF))
					elseif q < 0.65 then K.fernBig(p, K.r(1, 1.5))
					elseif q < 0.78 then K.lily(p, K.r(1, 1.4), K.chance(0.6) and PINK or WHITE)
					elseif q < 0.9 then K.bevel(CF(p + V3(0, 0.7, 0)) * ANG(0, K.r(0, PI), 0), V3(K.r(2, 3.4), 1.6, K.r(2, 3.4)), stoneCol(), M.Limestone, MOSS)
					else K.bigTree(p, K.r(0.8, 1.1), LEAF, BARK) end
				end
			end
		end
	end
	-- lane-edge beds right against the corridor (low): lilies, ferns, clover, mossy stones
	for s = -1, 1, 2 do
		for z = 16, 128, 10 do
			local p = V3(s * K.r(36, 42), 0, z + K.r(-2, 2))
			local q = K.r(0, 1)
			if q < 0.35 then K.lily(p, K.r(1.2, 1.6), K.chance(0.6) and PINK or WHITE)
			elseif q < 0.6 then K.fernBig(p, K.r(1.1, 1.5))
			elseif q < 0.8 then K.bevel(CF(p + V3(s * 2, 0.6, 0)) * ANG(0, K.r(0, PI), 0), V3(K.r(2.2, 3.4), 1.4, K.r(2.2, 3.4)), stoneCol(), M.Limestone, MOSS)
			else K.rosette(p + V3(s * 1.5, 0.8, 0), K.r(0.5, 0.7), K.pick(LEAF)) end
			K.clover(p + V3(-s * K.r(3, 6), 0, K.r(-2, 2)), K.r(1.2, 1.7))
		end
	end
	K.mirror = false
end

return B
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">BiomeFrozen</string><ProtectedString name="Source"><![CDATA[-- BiomeFrozen: Frozen Kingdom, Z [350, 600). Reference: roblox pets/Maps/03_Frozen_Biome.png (1:1 inventory).
-- Authored as seen in the reference (K.mirror = true: design -X = screen-left).
--  LEFT : FL1 two natural ice-rock arches with snow drapes, icicles, glowing ice · FL2 ice cave with glowing
--         crystals + snowman (goggles, scarf, satchel) + sled and lantern · FL3 small frozen fall + pond with
--         ice floes · FL4 snowy pines, blue crystal clusters · FL5 carved stairs
--  RIGHT: FR1 ice citadel (very tall central crystal spire, spiked turrets, glowing pointed gate, snowflake
--         emblem, snowflake banners) · FR2 grand stairs · FR3 big glowing frozen waterfall into an ice-floe
--         pool · FR4 second snowman vignette, pines, crystals
--  CENTRE: snow lane with a honeycomb of pale-blue hexagonal ice tiles; ice cliffs and aurora beyond.
-- Location: ServerScriptService > Server > BiomeFrozen (ModuleScript)

local K = require(script.Parent.WorldKit)
local V3, CF, ANG, PI, M = K.V3, K.CF, K.ANG, K.PI, K.M
local C = K.C

local B = {}

local ROCK, ROCK_D = C(132, 146, 186), C(100, 112, 156)
local SNOW = C(246, 250, 255)
local ICE, ICE_D, GLOW = C(196, 230, 252), C(126, 186, 238), C(110, 214, 255)
local BANNER, PINE = C(36, 86, 186), C(40, 100, 82)

local function rockCol() return ROCK:Lerp(ROCK_D, K.r(0, 1)) end

-- flat hexagon (three rotated slabs)
local function hex(pos, r, col, mat, transp)
	for i = 0, 2 do
		K.block(CF(pos) * ANG(0, i * PI / 3, 0), V3(r * 2, 0.12, r * 1.155), col, mat or M.SmoothPlastic, false, transp)
	end
end
local function icicles(cf, w, n, maxH)
	for _ = 1, n do
		local h = K.r(1, maxH or 3)
		K.wedge(cf * CF(K.r(-w / 2, w / 2), -h / 2, 0) * ANG(PI, K.r(0, PI), 0), V3(0.6, h, 0.6), ICE, M.Ice)
	end
end
-- thick snow cap with rounded drapes along its front edge (frontSign = side of the cap facing the lane)
local function snowCap(cf, size, frontSign)
	K.block(cf, size, SNOW, M.Snow)
	for z = -size.Z / 2 + 1, size.Z / 2 - 1, K.r(1.8, 2.8) do
		local d = K.r(0.9, 1.8)
		K.ellipsoid(cf * CF(frontSign * size.X / 2, -d * 0.3, z), V3(1.4, d, K.r(1.6, 2.6)), SNOW, M.Snow)
	end
end
local function vein(cf, h)
	local v = K.block(cf, V3(0.18, h, 0.45), GLOW, M.Neon, false, 0.15)
	K.tag(v, "TPFC_Glint", { Period = K.r(9, 16) })
end

-- terrace front: blue rock blocks with draping snow and glowing veins
local function facade(s, x1, top, za, zb)
	local z = za
	while z < zb - 1 do
		local l = math.min(K.r(3.5, 6), zb - z)
		local h = top + K.r(-0.3, 0.5)
		K.bevel(CF(s * (x1 + 1.1), h / 2 - 0.4, z + l / 2), V3(2.8, h + 0.6, l - 0.15), rockCol(), M.Slate)
		snowCap(CF(s * (x1 + 1.1), h + 0.15, z + l / 2), V3(3, 0.6, l), -s)
		if K.chance(0.3) then vein(CF(s * (x1 - 0.32), h * 0.5, z + l / 2) * ANG(K.r(-0.4, 0.4), 0, 0), h * 0.6) end
		z += l
	end
end

-- FL2 / FR4: snowman with goggles, scarf, carrot nose, stick arms, satchel
local function snowman(pos, yaw)
	local cf = CF(pos) * ANG(0, yaw, 0)
	K.ball((cf * CF(0, 2, 0)).Position, 4.2, SNOW, M.Snow)
	K.ball((cf * CF(0, 5.2, 0)).Position, 3.2, SNOW, M.Snow)
	K.ball((cf * CF(0, 7.6, 0)).Position, 2.5, SNOW, M.Snow)
	K.block(cf * CF(0, 6.5, 0), V3(2.9, 0.5, 2.9), BANNER, M.Fabric)
	K.block(cf * CF(0.9, 5.5, -1.3) * ANG(0, 0, 0.15), V3(0.6, 2, 0.3), BANNER, M.Fabric)
	K.wedge(cf * CF(0, 7.6, -1.6) * ANG(0, PI, 0), V3(0.4, 0.4, 1.4), C(255, 140, 40), M.SmoothPlastic)
	for s = -1, 1, 2 do
		K.cyl(cf * CF(s * 0.5, 8.1, -1.05) * ANG(0, PI / 2, 0), 0.25, 0.75, C(60, 50, 46), M.Metal)
		K.cyl(cf * CF(s * 0.5, 8.1, -1.12) * ANG(0, PI / 2, 0), 0.1, 0.55, C(120, 200, 240), M.Glass)
		K.block(cf * CF(s * 2.6, 5.6, 0) * ANG(0, 0, s * -0.7), V3(0.25, 3, 0.25), C(110, 76, 50), M.Wood)
	end
	K.block(cf * CF(0, 8.15, 0), V3(2.6, 0.25, 2.6), C(60, 50, 46), M.Fabric)
	K.block(cf * CF(0, 9.1, 0), V3(1.9, 0.7, 1.9), C(110, 76, 50), M.Fabric)
	for i = 0, 2 do K.ball((cf * CF(0, 4.6 + i * 0.9, -1.55)).Position, 0.35, C(50, 44, 50), M.SmoothPlastic) end
	K.block(cf * CF(-1.8, 4.6, 0.4) * ANG(0, 0, 0.2), V3(0.7, 1.6, 1.5), C(150, 100, 60), M.Fabric)
end

local function sled(pos, yaw)
	local cf = CF(pos) * ANG(0, yaw, 0)
	for s = -1, 1, 2 do
		K.block(cf * CF(0, 0.25, s * 1.2), V3(4.6, 0.3, 0.3), C(120, 82, 50), M.Wood)
		K.wedge(cf * CF(2.6, 0.6, s * 1.2) * ANG(0, -PI / 2, 0), V3(0.3, 0.8, 0.8), C(120, 82, 50), M.Wood)
	end
	K.block(cf * CF(0, 0.9, 0), V3(4, 0.4, 2.6), C(156, 108, 66), M.WoodPlanks)
	K.block(cf * CF(-0.4, 1.6, 0), V3(2.2, 1, 1.8), C(110, 70, 50), M.Fabric)
	K.lantern((cf * CF(2.8, 0, 1.6)).Position, C(60, 54, 70), C(255, 210, 150), 2.4)
end

-- FL1: natural ice-rock arch (span along Z) with snow drape, icicles and glowing ice lining
local function iceArch(pos, span, h)
	local cf = CF(pos) * ANG(0, PI / 2, 0)
	K.arch(cf, span, h, 6, rockCol(), M.Slate, GLOW, M.Neon, 9)
	local r = span / 2 + 3
	for i = 1, 9 do
		local a = (i - 0.5) / 9 * PI
		K.ellipsoid(CF(cf * V3(math.cos(a) * r, h + math.sin(a) * r + 2.2, 0)), V3(4.6, 2.2, 7.4), SNOW, M.Snow)
	end
	icicles(cf * CF(0, h + r - 3.6, -3.2), span * 0.7, 9, 3.5)
	icicles(cf * CF(0, h + r - 3.6, 3.2), span * 0.7, 7, 3)
	for s = -1, 1, 2 do
		K.crystalCluster(pos + V3(3, 0, s * (span / 2 + 5)), 0.9, { GLOW, ICE }, 0)
		K.ellipsoid(CF(pos + V3(0, 0.6, s * (span / 2 + 3))), V3(8, 2.4, 7), SNOW, M.Snow)
	end
end

-- FL2: ice cave in a rock outcrop
local function cave(pos)
	K.bevel(CF(pos + V3(-9, 9, 0)), V3(20, 18, 28), rockCol(), M.Slate)
	snowCap(CF(pos + V3(-9, 18.3, 0)), V3(21, 1, 29), 1)
	K.arch(CF(pos + V3(1.2, 0, 0)) * ANG(0, PI / 2, 0), 9, 6, 3, ROCK_D, M.Slate, GLOW, M.Neon, 7)
	K.block(CF(pos + V3(0.4, 5.5, 0)), V3(0.4, 11, 9), C(24, 40, 80), M.SmoothPlastic)
	local core = K.crystalCluster(pos + V3(-0.5, 0.4, -1), 1.5, { GLOW, C(170, 240, 255) }, 0)
	K.lamp(core, GLOW, 26, 1.6)
	K.crystalCluster(pos + V3(-0.5, 0.4, 2.5), 0.9, { GLOW, ICE }, nil)
	icicles(CF(pos + V3(2.6, 11.4, 0)) * ANG(0, PI / 2, 0), 11, 8, 2.5)
	snowman(pos + V3(9, 0, 9), PI / 2 + 0.4)
	sled(pos + V3(10, 0, -7), PI / 2 - 0.3)
	for _ = 1, 3 do K.crystal(pos + V3(K.r(4, 8), 0, K.r(-14, -10)), K.r(2.5, 4), 1, GLOW, ANG(0, 0, K.r(-0.4, 0.4))) end
end

-- FR1: crystal-tipped turret (square shaft, snow ledge, crenels, glowing window, tall glass spire)
local function turret(pos, w, h, spire)
	K.bevel(CF(pos + V3(0, h / 2, 0)), V3(w, h, w), ICE, M.Ice)
	K.block(CF(pos + V3(0, h * 0.35, 0)), V3(w + 0.6, 1, w + 0.6), ICE_D, M.Ice)
	K.block(CF(pos + V3(0, h + 0.5, 0)), V3(w + 1.6, 1, w + 1.6), SNOW, M.Snow)
	for i = 0, 3 do
		K.block(CF(pos + V3(0, h + 1.6, 0)) * ANG(0, i * PI / 2, 0) * CF(0, 0, -(w / 2 + 0.3)), V3(w * 0.3, 1.4, 0.8), ICE, M.Ice)
	end
	K.cone(pos + V3(0, h + 1, 0), w * 0.55, spire or w * 2.6, 6, C(150, 212, 252), C(116, 186, 240), M.Glass)
	local win = K.block(CF(pos + V3(-w / 2 - 0.05, h * 0.62, 0)), V3(0.2, h * 0.24, w * 0.28), GLOW, M.Neon, false, 0.15)
	K.tag(win, "TPFC_Glint", { Period = K.r(8, 14) })
	K.wedge(CF(pos + V3(-w / 2 - 0.05, h * 0.62 + h * 0.15, 0)) * ANG(0, PI / 2, 0), V3(w * 0.28, h * 0.08, 0.2), GLOW, M.Neon)
end

local function snowflake(cf, s)
	for i = 0, 2 do
		K.block(cf * ANG(0, 0, i * PI / 3), V3(0.3, 5 * s, 0.6), C(226, 248, 255), M.Neon)
		for k = -1, 1, 2 do
			K.block(cf * ANG(0, 0, i * PI / 3) * CF(0, k * 1.6 * s, 0) * ANG(0, 0, 0.8), V3(0.25, 1.4 * s, 0.5), C(226, 248, 255), M.Neon)
			K.block(cf * ANG(0, 0, i * PI / 3) * CF(0, k * 1.6 * s, 0) * ANG(0, 0, -0.8), V3(0.25, 1.4 * s, 0.5), C(226, 248, 255), M.Neon)
		end
	end
end

local function citadel(c)
	-- cliff plateau tiers with snow drapes, veins and icicles
	K.bevel(CF(c.X, -1, c.Z), V3(76, 10, 160), rockCol(), M.Slate)
	snowCap(CF(c.X, 4.3, c.Z), V3(76, 0.8, 160), -1)
	K.addSurface(c.X - 38, c.X + 38, c.Z - 80, c.Z + 80, 4.7)
	K.bevel(CF(c.X + 14, 5, c.Z), V3(48, 14, 120), rockCol(), M.Slate)
	snowCap(CF(c.X + 14, 12.4, c.Z), V3(48, 0.8, 120), -1)
	K.addSurface(c.X - 10, c.X + 38, c.Z - 60, c.Z + 60, 12.8)
	for _, z in ipairs({ -36, 36 }) do icicles(CF(c.X - 10.2, 11.9, c.Z + z) * ANG(0, PI / 2, 0), 40, 12, 3.5) end
	for _ = 1, 10 do vein(CF(c.X - 10.2, K.r(5, 10), c.Z + K.r(-55, 55)) * ANG(K.r(-0.6, 0.6), 0, 0), K.r(3, 6)) end
	-- FR2 grand stairs with ice balustrades
	K.stairs(CF(c.X - 15, 4.7, c.Z) * ANG(0, -PI / 2, 0), 14, 7, 1.15, 1.4, SNOW, M.Snow)
	for s = -1, 1, 2 do
		K.block(CF(c.X - 15, 8, c.Z + s * 7.6), V3(10, 7, 1.2), ICE, M.Ice, true)
		for k = 0, 3 do K.cone(V3(c.X - 19.5 + k * 3, 4.7 + k * 2.3 + 3.5, c.Z + s * 7.6), 0.6, 1.6, 5, GLOW, ICE, M.Glass) end
	end
	-- keep: hall, gable, pointed glowing gate, big snowflake, banners
	local kx = c.X + 18
	K.bevel(CF(kx, 12.8 + 12, c.Z), V3(24, 24, 36), ICE, M.Ice)
	K.block(CF(kx, 12.8 + 24.4, c.Z), V3(25.6, 0.8, 37.6), SNOW, M.Snow)
	K.gable(CF(kx, 12.8 + 24.8, c.Z) * ANG(0, PI / 2, 0), 24, 10, 36, C(170, 218, 250), M.Glass)
	K.pointedArch(CF(kx - 12.2, 12.8, c.Z) * ANG(0, PI / 2, 0), 9, 10, 6, 1.6, SNOW, M.Snow, GLOW)
	local door = K.block(CF(kx - 12.1, 12.8 + 7.5, c.Z), V3(0.3, 14, 8.6), C(80, 170, 240), M.Neon, false, 0.35)
	K.lamp(door, GLOW, 32, 1.5)
	K.tag(door, "TPFC_Pulse", { Period = 7, Base = 0.35, Peak = 0.15 })
	snowflake(CF(kx - 12.4, 12.8 + 20.5, c.Z) * ANG(0, PI / 2, 0), 1.2)
	for s = -1, 1, 2 do
		local b = K.block(CF(kx - 12.4, 12.8 + 13, c.Z + s * 10), V3(0.3, 11, 4), BANNER, M.Fabric)
		K.tag(b, "TPFC_Sway", { Amp = 0.02, Period = 6 })
		snowflake(CF(kx - 12.6, 12.8 + 14, c.Z + s * 10) * ANG(0, PI / 2, 0), 0.35)
		K.wedge(CF(kx - 12.4, 12.8 + 7, c.Z + s * 10 - 1) * ANG(PI, 0, 0), V3(0.3, 1, 2), BANNER, M.Fabric)
		K.wedge(CF(kx - 12.4, 12.8 + 7, c.Z + s * 10 + 1) * ANG(PI, PI, 0), V3(0.3, 1, 2), BANNER, M.Fabric)
	end
	-- turrets: very tall central crystal spire + ring of spiked turrets + crenellated walls
	turret(V3(kx + 6, 12.8, c.Z), 11, 40, 34)
	for _, t in ipairs({ { -8, -22, 7, 26 }, { -8, 22, 7, 26 }, { 14, -36, 8, 30 }, { 14, 36, 8, 30 }, { 2, -14, 5, 34 }, { 2, 14, 5, 34 }, { 24, -20, 6, 22 }, { 24, 20, 6, 22 } }) do
		turret(V3(kx + t[1], 12.8, c.Z + t[2]), t[3], t[4])
	end
	for _, z in ipairs({ -44, 44 }) do
		K.bevel(CF(kx - 9, 12.8 + 4.5, c.Z + z), V3(3, 9, 30), ICE_D, M.Ice)
		K.block(CF(kx - 9, 12.8 + 9.3, c.Z + z), V3(3.6, 0.6, 30.4), SNOW, M.Snow)
		for dz = -13.5, 13.5, 3 do K.block(CF(kx - 9, 12.8 + 10.3, c.Z + z + dz), V3(3, 1.4, 1.5), ICE_D, M.Ice) end
	end
	-- FR3 big frozen waterfall from tier B into an ice-floe pool on tier A
	local fz = c.Z + 52
	for i = 0, 3 do
		local seg = K.block(CF(c.X - 10.8, 12.4 - i * 2 - 1, fz + K.r(-0.5, 0.5)), V3(1, 2.2, 14 - i), i % 2 == 0 and C(150, 228, 250) or GLOW, M.Glass, false, 0.1)
		K.tag(seg, "TPFC_Glint", { Period = K.r(6, 10) })
	end
	icicles(CF(c.X - 11.4, 4.8, fz) * ANG(0, PI / 2, 0), 14, 6, 2)
	K.block(CF(c.X - 19, 4.6, fz), V3(16, 0.4, 22), C(90, 176, 226), M.Glass, false, 0.15)
	for _ = 1, 7 do hex(V3(c.X - 19 + K.r(-6, 6), 4.85, fz + K.r(-9, 9)), K.r(1.2, 2.4), SNOW, M.Snow) end
end

function B.Build(b)
	K.Seed(3003)
	K.ResetSurfaces()
	K.mirror = true
	local z1, z2 = b[1], b[2]
	---------------------------------------------------------------- terraces (blue rock, draping snow, veins)
	K.terraces(z1, z2, {
		rock = ROCK, rockMat = M.Slate, cap = SNOW, capMat = M.Snow, drip = true, tiers = 3,
		h1 = { 2.2, 4 }, h2 = { 6, 11 }, h3 = { 10, 20 },
		skip = { { 1, 392, 560 } },
		facade = facade,
	})
	---------------------------------------------------------------- RIGHT: citadel + stairs + frozen waterfall
	citadel(V3(86, 0, 476))
	snowman(V3(50, 0, 368), -PI / 2 + 0.5)
	for _ = 1, 4 do K.crystalCluster(V3(K.r(44, 50), 0, K.r(370, 390)), K.r(0.6, 0.9), { GLOW, ICE }, nil) end
	---------------------------------------------------------------- LEFT: ice arches, cave + vignette, frozen fall + pond, stairs
	iceArch(K.at(-62, 396), 16, 9)
	iceArch(K.at(-86, 452), 20, 12)
	cave(K.at(-62, 566))
	local pond = K.at(-58, 492)
	K.block(CF(pond + V3(0, 0.15, 0)), V3(14, 0.3, 22), C(100, 184, 228), M.Glass, false, 0.15)
	for _ = 1, 5 do hex(pond + V3(K.r(-4, 4), 0.36, K.r(-8, 8)), K.r(1, 1.8), SNOW, M.Snow) end
	for i = 0, 2 do
		local seg = K.block(CF(pond + V3(-8.2, 2 + i * 1.6, 0)), V3(0.8, 1.8, 8 - i * 1.5), i % 2 == 0 and C(160, 230, 250) or GLOW, M.Glass, false, 0.1)
		K.tag(seg, "TPFC_Glint", { Period = K.r(7, 12) })
	end
	K.stairs(CF(K.at(-52, 430)) * ANG(0, PI / 2, 0), 8, 4, 1, 1.4, SNOW, M.Snow)
	---------------------------------------------------------------- pines + crystals + snow mounds on terrace tops within view
	for _, r in ipairs(K.surfaces) do
		local xa, xb = math.max(r[1], -96), math.min(r[2], 96)
		if xb - xa > 3 then
			local n = math.floor((xb - xa) * (r[4] - r[3]) / 180)
			for _ = 1, n do
				local x, z = K.r(xa + 2, xb - 2), K.r(r[3] + 2, r[4] - 2)
				local onCitadel = x > 40 and z > 392 and z < 560 and r[5] > 4
				if math.abs(x) >= 48 and not onCitadel then
					local p = V3(x, r[5], z)
					local q = K.r(0, 1)
					if q < 0.4 then K.pine(p, K.r(1.2, 1.9), PINE, true)
					elseif q < 0.8 then K.crystalCluster(p, K.r(0.6, 1), { GLOW, ICE, C(170, 236, 255) }, nil)
					else K.ellipsoid(CF(p + V3(0, 0.6, 0)), V3(K.r(4, 7), K.r(1.6, 2.6), K.r(4, 7)), SNOW, M.Snow) end
				end
			end
		end
	end
	for _ = 1, 6 do K.pine(V3(K.r(52, 70), 4.7, K.r(400, 556)), K.r(1, 1.4), PINE, true) end
	---------------------------------------------------------------- CENTRE: honeycomb of hexagonal ice tiles + edge drifts
	local rH = 3.6
	for row = 0, math.floor((z2 - z1 - 8) / (rH * 1.5)) do
		local z = z1 + 6 + row * rH * 1.5
		local off = (row % 2) * rH * 0.866
		for x = -27 + off, 27, rH * 1.732 do
			if K.chance(0.55) then hex(V3(x, 0.08, z), rH * 0.92, ICE:Lerp(SNOW, K.r(0.2, 0.6)), M.SmoothPlastic) end
		end
	end
	for s = -1, 1, 2 do
		for z = z1 + 6, z2 - 6, 9 do
			K.ellipsoid(CF(s * K.r(36, 42), 0.4, z + K.r(-3, 3)), V3(K.r(5, 9), K.r(1.2, 2.2), K.r(6, 10)), SNOW, M.Snow)
			if K.chance(0.35) then K.crystal(V3(s * K.r(38, 43), 0, z), K.r(1.6, 2.6), 0.7, GLOW, ANG(0, K.r(0, PI), s * 0.4)) end
		end
	end
	---------------------------------------------------------------- aurora ribbons on the far skyline
	for i = 0, 2 do
		for k = 0, 9 do
			local seg = K.block(CF(-150 + k * 32, 150 + i * 14 + math.sin(k * 0.8 + i) * 10, 720 + i * 30) * ANG(0, 0, math.sin(k * 0.9 + i) * 0.25),
				V3(34, 18, 1), (i == 1) and C(120, 255, 200) or C(90, 230, 255), M.Neon, false, 0.72)
			seg.CastShadow = false
			K.tag(seg, "TPFC_Pulse", { Period = 10 + i * 3, Base = 0.78, Peak = 0.6 })
		end
	end
	---------------------------------------------------------------- transition to Crystal: blue mineral veins in deeper rock
	for s = -1, 1, 2 do
		for _ = 1, 3 do
			local p = V3(s * K.r(46, 60), 0, K.r(584, 598))
			K.rockMass(p, K.r(4, 7), K.r(4, 8), K.r(4, 7), C(70, 64, 110), M.Slate, 2)
			K.crystal(p + V3(0, 1, 0), K.r(3, 5), 1, C(150, 120, 255), ANG(0, 0, s * 0.3))
		end
	end
	K.mountains(z1, z2, M.Glacier, 170, 230, 50, 110)
	K.mirror = false
end

return B
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">BiomeHeaven</string><ProtectedString name="Source"><![CDATA[-- BiomeHeaven: Heaven World, Z [2400, 3200). Reference: roblox pets/Maps/08_Heaven_Biome.png (1:1 inventory).
-- Authored as seen in the reference (K.mirror = true: design -X = screen-left).
--  LEFT : HL1 winged angel statue (hooded robe, praying hands, feathered wings, golden halo ring + star, gold-banded
--         plinth) · HL2 cascading blue waterfalls down grassy marble tiers · HL3 green bonsai trees · HL4 cypresses ·
--         HL5 puffy clouds · HL6 arched colonnade with blue star banners · HL7 floating islands with little temples
--  RIGHT: HR1 rainbow over the gardens (beside the lane) · HR2 bell arch (marble arch, gold bell, star) ·
--         HR3 waterfall pools, colonnades, cypresses, white lilies
--  END  : HE1 monumental winged gate beyond the last landing point (glowing portal glass, gold halo arch + star,
--         giant wings, curved colonnades, stairs)
--  CENTRE: cream marble floor with gold inlay borders and diamond-star medallions.
-- Location: ServerScriptService > Server > BiomeHeaven (ModuleScript)

local K = require(script.Parent.WorldKit)
local V3, CF, ANG, PI, M = K.V3, K.CF, K.ANG, K.PI, K.M
local C = K.C

local B = {}

local MARBLE, MARBLE_D, CREAM = C(246, 242, 232), C(222, 214, 198), C(240, 230, 210)
local GOLD, BLUE, SKY = C(232, 188, 88), C(70, 120, 210), C(150, 214, 250)
local GRASS, LEAF = C(116, 172, 70), { C(96, 156, 60), C(120, 176, 70), C(80, 138, 56) }
local LILY = C(255, 252, 246)

local function marbleCol() return MARBLE:Lerp(MARBLE_D, K.r(0, 0.6)) end

local function facade(s, x1, top, za, zb)
	local z = za
	while z < zb - 1 do
		local l = math.min(K.r(4, 7), zb - z)
		K.bevel(CF(s * (x1 + 1.1), top / 2 - 0.3, z + l / 2), V3(2.8, top + 0.6, l - 0.2), marbleCol(), M.Marble)
		K.block(CF(s * (x1 - 0.3), top - 0.6, z + l / 2), V3(0.15, 0.3, l - 0.3), GOLD, M.Metal)
		z += l
	end
end

local function star(cf, r)
	for i = 0, 3 do K.block(cf * ANG(0, 0, i * PI / 4), V3(r * (i % 2 == 0 and 0.35 or 0.22), r * (i % 2 == 0 and 2.2 or 1.2), 0.3), GOLD, M.Neon) end
end
-- full ring of gold segments in the cf XY plane
local function ring(cf, r, n, thick)
	for i = 0, n - 1 do
		local a0, a1 = i / n * PI * 2, (i + 1) / n * PI * 2
		local p0, p1 = cf * V3(math.cos(a0) * r, math.sin(a0) * r, 0), cf * V3(math.cos(a1) * r, math.sin(a1) * r, 0)
		K.block(CFrame.lookAt((p0 + p1) / 2, p1, cf.LookVector), V3(thick, thick, (p1 - p0).Magnitude + 0.2), GOLD, M.Metal)
	end
end

-- HL5: puffy cloud cluster
local function cloud(pos, s)
	for i = 1, K.ri(6, 9) do
		local d = K.r(4, 7) * s
		K.ball(pos + V3(K.r(-6, 6) * s, K.r(0, 3) * s, K.r(-4, 4) * s), d, i % 3 == 0 and C(232, 240, 252) or C(255, 255, 255), M.SmoothPlastic)
	end
end
-- HL4: cypress
local function cypress(pos, s)
	K.block(CF(pos + V3(0, 0.8 * s, 0)), V3(0.8, 1.6, 0.8) * s, C(110, 80, 56), M.Wood)
	K.ellipsoid(CF(pos + V3(0, 6 * s, 0)), V3(3.2, 11, 3.2) * s, C(52, 110, 60), M.SmoothPlastic)
	K.ellipsoid(CF(pos + V3(0.3 * s, 7 * s, -0.3 * s)), V3(2.2, 8, 2.2) * s, C(66, 128, 66), M.SmoothPlastic)
end
-- grassy marble ledge with lilies
local function gardenLedge(cf, size)
	K.bevel(cf, size, marbleCol(), M.Marble)
	K.block(cf * CF(0, size.Y / 2 + 0.2, 0), V3(size.X - 0.6, 0.4, size.Z - 0.6), GRASS, M.SmoothPlastic)
	for _ = 1, math.max(1, math.floor(size.X * size.Z / 90)) do
		K.lily((cf * CF(K.r(-size.X / 2 + 1.5, size.X / 2 - 1.5), size.Y / 2 + 0.4, K.r(-size.Z / 2 + 1.5, size.Z / 2 - 1.5))).Position, K.r(0.8, 1.1), LILY, C(255, 226, 150))
	end
end

-- HL1: winged angel statue
local function angel(pos, yaw)
	local cf = CF(pos) * ANG(0, yaw, 0)
	K.bevel(cf * CF(0, 1.5, 0), V3(10, 3, 10), MARBLE_D, M.Marble)
	K.block(cf * CF(0, 3.1, 0), V3(9.4, 0.4, 9.4), GOLD, M.Metal)
	K.bevel(cf * CF(0, 4.3, 0), V3(7, 2, 7), MARBLE, M.Marble)
	-- robe (tapered stacked blocks + flowing hem wedges), hood, hands
	for i = 0, 4 do
		local w = 5.2 - i * 0.6
		K.block(cf * CF(0, 6 + i * 2.4, 0), V3(w, 2.6, w * 0.8), CREAM, M.Marble)
	end
	for i = 0, 3 do K.wedge(cf * ANG(0, i * PI / 2, 0) * CF(0, 6.4, -2.6), V3(5, 2.6, 1.4), CREAM, M.Marble) end
	K.ellipsoid(cf * CF(0, 19.2, 0), V3(3.8, 4.4, 3.6), CREAM, M.Marble)
	K.ellipsoid(cf * CF(0, 18.8, -0.7), V3(2.4, 3, 2), C(200, 190, 176), M.Marble)
	K.block(cf * CF(0, 13.6, -1.8) * ANG(0.3, 0, 0), V3(1.4, 2.4, 1), CREAM, M.Marble)
	-- wings: three tiers of feather wedges fanning up and out
	for s = -1, 1, 2 do
		for t = 0, 2 do
			for f = 0, 5 - t do
				local ang = -0.2 + f * 0.28
				local len = 9 - t * 2 - f * 0.5
				K.wedge(cf * CF(s * 2.2, 15 - t * 2.4, 1.4 + t * 0.3) * ANG(0, 0, s * (ang + 0.5)) * CF(0, len / 2, 0) * ANG(0, s > 0 and PI / 2 or -PI / 2, 0),
					V3(0.6, len, 2.2 - t * 0.3), t == 0 and MARBLE or CREAM, M.Marble)
			end
		end
	end
	-- golden halo ring + star behind the head
	local hcf = cf * CF(0, 22, 1.6)
	ring(hcf, 4.6, 18, 0.5)
	star(hcf, 1.8)
	K.lamp(K.block(hcf, V3(0.5, 0.5, 0.5), GOLD, M.Neon), C(255, 230, 160), 22, 1)
end

-- HL2 / HR3: stepped garden cascade with waterfalls and pools (facing the lane, +X design local)
local function cascade(base, steps, w)
	for i = 0, steps - 1 do
		local cf = CF(base + V3(-i * 6, i * 3.2 + 1.6, 0))
		gardenLedge(cf, V3(8, 3.2 * (i + 1), w - i * 2))
		local fall = K.block(cf * CF(4.1, i * 1.6, 0), V3(0.6, 3.2, w * 0.35), C(120, 200, 245), M.Glass, false, 0.15)
		K.tag(fall, "TPFC_Pulse", { Period = K.r(3, 5), Base = 0.15, Peak = 0.02 })
		K.addSurface(base.X - i * 6 - 4, base.X - i * 6 + 4, base.Z - (w - i * 2) / 2, base.Z + (w - i * 2) / 2, 3.2 * (i + 1) + 0.4)
	end
	K.water(CF(base + V3(7, 0.3, 0)), V3(7, 0.3, w * 0.6), SKY, 0.2)
	K.ellipsoid(CF(base + V3(5, 0.5, 0)), V3(2.4, 1, w * 0.4), C(240, 250, 255), M.SmoothPlastic)
end

-- HL6 / HR3: arched colonnade along Z with blue star banners
local function colonnade(pos, n, span, h, bannerSide)
	local cf = CF(pos) * ANG(0, PI / 2, 0)
	for i = 0, n - 1 do
		local acf = cf * CF((i - (n - 1) / 2) * (span + 2.6), 0, 0)
		K.arch(acf, span, h, 2.4, MARBLE, M.Marble, GOLD, M.Metal, 7)
		if i % 2 == 0 then
			local b = K.block(acf * CF(0, h * 0.8, bannerSide * 1.4), V3(2.4, h * 0.7, 0.2), BLUE, M.Fabric)
			K.tag(b, "TPFC_Sway", { Amp = 0.02, Period = 6 })
			star(acf * CF(0, h * 0.85, bannerSide * 1.52), 0.7)
		end
	end
	K.block(cf * CF(0, h + span / 2 + 2.4, 0), V3(n * (span + 2.6) + 2, 1.6, 3), MARBLE, M.Marble)
	K.block(cf * CF(0, h + span / 2 + 3.3, 0), V3(n * (span + 2.6) + 2.4, 0.3, 3.2), GOLD, M.Metal)
end

-- HR2: bell arch
local function bellArch(pos, yaw)
	local cf = CF(pos) * ANG(0, yaw, 0)
	K.bevel(cf * CF(0, 0.6, 0), V3(12, 1.2, 4), MARBLE_D, M.Marble)
	K.arch(cf * CF(0, 1.2, 0), 7, 9, 2.4, MARBLE, M.Marble, GOLD, M.Metal, 7)
	K.ellipsoid(cf * CF(0, 13.4, 0), V3(3.4, 4, 3.4), GOLD, M.Metal)
	K.cyl(cf * CF(0, 11.6, 0) * ANG(0, 0, PI / 2), 0.5, 4.2, GOLD, M.Metal)
	K.ball((cf * CF(0, 11, 0)).Position, 0.8, C(200, 150, 60), M.Metal)
	K.block(cf * CF(0, 15.8, 0), V3(0.3, 1.4, 0.3), GOLD, M.Metal)
	star(cf * CF(0, 21.5, 0), 1.4)
end

-- HL7: floating island with a small temple
local function floatingIsland(pos, s)
	for i = 0, 3 do -- rock underside tapering downward
		local w = (17 - i * 4) * s
		K.block(CF(pos + V3(K.r(-0.5, 0.5), -(i + 0.5) * 3.4 * s, K.r(-0.5, 0.5))) * ANG(0, K.r(0, PI), 0), V3(w, 3.6 * s, w * 0.85), C(210, 204, 196):Lerp(C(176, 168, 160), i * 0.25), M.Slate)
	end
	K.ellipsoid(CF(pos + V3(0, 0.6 * s, 0)), V3(19, 2, 17) * s, GRASS, M.SmoothPlastic)
	for i = 0, 3 do
		local a = i / 4 * PI * 2 + PI / 4
		K.column(pos + V3(math.cos(a) * 3.6 * s, 1.2 * s, math.sin(a) * 3.6 * s), 5 * s, 0.8 * s, MARBLE, M.Marble, GOLD)
	end
	K.block(CF(pos + V3(0, 7.4 * s, 0)), V3(9, 0.8, 9) * s, MARBLE, M.Marble)
	K.pyramid(CF(pos + V3(0, 7.8 * s, 0)), 9 * s, 2.4 * s, CREAM, M.Marble)
	cloud(pos + V3(0, -6 * s, 0), s * 0.8)
end

-- HE1: the monumental winged gate beyond the end of the lane
local function endGate(z)
	local base = V3(0, 0, z)
	K.stairs(CF(base + V3(0, 0, 4)), 46, 6, 0.8, 2, MARBLE, M.Marble)
	K.bevel(CF(base + V3(0, 2.4, 22)), V3(80, 4.8, 24), MARBLE_D, M.Marble)
	-- main arch with glowing portal glass and halo
	K.arch(CF(base + V3(0, 4.8, 18)), 16, 22, 5, MARBLE, M.Marble, GOLD, M.Metal, 11)
	local portal = K.block(CF(base + V3(0, 4.8 + 15, 18)), V3(15.6, 30, 0.6), C(170, 220, 255), M.Neon, false, 0.25)
	K.lamp(portal, C(200, 230, 255), 60, 2)
	K.tag(portal, "TPFC_Pulse", { Period = 8, Base = 0.3, Peak = 0.1 })
	star(CF(base + V3(0, 4.8 + 16, 17.4)), 3)
	ring(CF(base + V3(0, 4.8 + 30, 19)), 16, 30, 1.2)
	star(CF(base + V3(0, 4.8 + 50, 19)), 4)
	K.block(CF(base + V3(0, 4.8 + 42, 19)), V3(0.8, 10, 0.8), GOLD, M.Metal)
	for s = -1, 1, 2 do
		K.column(base + V3(s * 13, 4.8, 15), 26, 2.8, MARBLE, M.Marble, GOLD)
		K.column(base + V3(s * 18, 4.8, 17), 22, 2.4, MARBLE, M.Marble, GOLD)
		-- giant wings sweeping up and out from the gate
		for t = 0, 2 do
			for f = 0, 6 - t do
				local ang = 0.15 + f * 0.2
				local len = 30 - t * 6 - f * 2
				K.wedge(CF(base + V3(s * 12, 26 - t * 5, 22 + t)) * ANG(0, 0, -s * ang) * CF(0, len / 2, 0) * ANG(0, s > 0 and -PI / 2 or PI / 2, 0),
					V3(1.4, len, 7 - t), t == 0 and MARBLE or CREAM, M.Marble)
			end
		end
		-- curved colonnades left and right
		for i = 0, 6 do
			local a = i / 6 * 0.9
			local p = base + V3(s * (26 + math.sin(a) * 40), 4.8, 22 - math.cos(a) * 12 + i * 3)
			K.column(p, 16, 2, MARBLE, M.Marble, GOLD)
		end
	end
end

function B.Build(b)
	K.Seed(8008)
	K.ResetSurfaces()
	K.mirror = true
	local z1, z2 = b[1], b[2]
	K.terraces(z1, z2, {
		rock = MARBLE_D, rockMat = M.Marble, cap = GRASS, capMat = M.SmoothPlastic, drip = true, tiers = 2,
		h1 = { 1.6, 3.4 }, h2 = { 4, 9 },
		skip = { { -1, 2480, 2640 }, { 1, 2620, 2760 } },
		facade = facade,
	})
	---------------------------------------------------------------- LEFT: angel + cascades, colonnade, trees, cypresses, clouds
	angel(V3(-70, 0, 2520), PI / 2)
	cascade(V3(-58, 0, 2580), 3, 18)
	cascade(V3(-60, 0, 2850), 2, 14)
	colonnade(V3(-66, 0, 2740), 5, 7, 8, 1)
	for _, p in ipairs({ { -84, 2490, 1.3 }, { -56, 2440, 1.1 }, { -64, 2960, 1.2 }, { -88, 3060, 1.4 } }) do K.bigTree(K.at(p[1], p[2]), p[3], LEAF, C(122, 86, 56)) end
	for _, p in ipairs({ { -52, 2470 }, { -54, 2660 }, { -52, 2800 }, { -56, 3000 }, { -50, 3120 } }) do cypress(K.at(p[1], p[2]), K.r(1.1, 1.5)) end
	---------------------------------------------------------------- RIGHT: rainbow, bell arch, pools, colonnade, cypresses
	local bands = { C(255, 110, 110), C(255, 176, 90), C(255, 234, 110), C(130, 222, 130), C(110, 180, 255), C(150, 130, 255), C(214, 140, 255) }
	for bi, col in ipairs(bands) do
		local r = 30 - bi * 1.6
		for i = 1, 16 do
			local a0, a1 = (i - 1) / 16 * PI, i / 16 * PI
			local p0 = V3(82, math.sin(a0) * r, 2690 + math.cos(a0) * r)
			local p1 = V3(82, math.sin(a1) * r, 2690 + math.cos(a1) * r)
			K.block(CFrame.lookAt((p0 + p1) / 2, p1), V3(1.6, 1.6, (p1 - p0).Magnitude + 0.3), col, M.SmoothPlastic, false, 0.08)
		end
	end
	cloud(V3(82, 1, 2660), 1)
	cloud(V3(82, 1, 2720), 1)
	bellArch(V3(60, 0, 2650), -PI / 2)
	cascade(V3(64, 0, 2740), 2, 14)
	colonnade(V3(66, 0, 2900), 6, 7, 8, -1)
	for _, p in ipairs({ { 52, 2470 }, { 54, 2600 }, { 52, 2820 }, { 56, 3060 } }) do cypress(K.at(p[1], p[2]), K.r(1.1, 1.5)) end
	for _, p in ipairs({ { 78, 2470, 1.2 }, { 60, 3000, 1.1 }, { 90, 3120, 1.4 } }) do K.bigTree(K.at(p[1], p[2]), p[3], LEAF, C(122, 86, 56)) end
	---------------------------------------------------------------- lilies + clouds along both sides
	for s = -1, 1, 2 do
		for z = z1 + 10, z2 - 10, 30 do
			K.lily(V3(s * K.r(38, 42), 0, z + K.r(-4, 4)), K.r(1, 1.3), LILY, C(255, 226, 150))
		end
		for z = z1, z2, 40 do cloud(V3(s * K.r(96, 130), K.r(0, 10), z + K.r(-10, 10)), K.r(1.6, 2.6)) end
	end
	for _, r in ipairs(K.surfaces) do
		local xa, xb = math.max(r[1], -90), math.min(r[2], 90)
		if xb - xa > 3 and r[5] < 10 then
			for _ = 1, math.floor((xb - xa) * (r[4] - r[3]) / 420) do
				local x, z = K.r(xa + 2, xb - 2), K.r(r[3] + 2, r[4] - 2)
				if math.abs(x) >= 48 then
					if K.chance(0.6) then K.lily(V3(x, r[5], z), K.r(0.9, 1.2), LILY, C(255, 226, 150)) else K.rosette(V3(x, r[5] + 1, z), K.r(0.5, 0.8), K.pick(LEAF)) end
				end
			end
		end
	end
	---------------------------------------------------------------- floating islands + light rays (high, beside the corridor)
	floatingIsland(V3(-80, 70, 2600), 1)
	floatingIsland(V3(90, 84, 2900), 1.2)
	floatingIsland(V3(-110, 96, 3080), 0.9)
	for k = 0, 2 do
		local ray = K.wedge(CF(-70 + k * 9, 90, 2560 + k * 20) * ANG(0, 0, 0.3), V3(5, 120, 12), C(255, 246, 210), M.Neon, false, 0.88)
		ray.CastShadow = false
		K.tag(ray, "TPFC_Pulse", { Period = 8 + k, Base = 0.9, Peak = 0.82 })
	end
	---------------------------------------------------------------- CENTRE: marble floor with gold inlay borders + diamond-star medallions
	for z = z1 + 1, z2 - 13, 14 do
		for x = -27.5, 27.5, 11 do
			K.block(CF(x + K.r(-0.1, 0.1), 0.18, z + 7), V3(10.8, 0.3, 13.8), C(244, 238, 226):Lerp(C(234, 226, 210), K.r(0, 1)), M.Marble)
		end
	end
	for s = -1, 1, 2 do
		K.block(CF(s * 31, 0.36, (z1 + z2) / 2), V3(0.6, 0.12, z2 - z1), GOLD, M.Metal)
		K.block(CF(s * 24, 0.36, (z1 + z2) / 2), V3(0.4, 0.12, z2 - z1), GOLD, M.Metal)
		K.block(CF(s * 35, 0.3, (z1 + z2) / 2), V3(4, 0.3, z2 - z1), MARBLE_D, M.Marble)
	end
	for z = z1 + 40, z2 - 30, 80 do
		K.block(CF(0, 0.37, z) * ANG(0, PI / 4, 0), V3(5, 0.12, 5), GOLD, M.Metal)
		K.block(CF(0, 0.4, z) * ANG(0, PI / 4, 0), V3(3.6, 0.12, 3.6), C(244, 238, 226), M.Marble)
		K.block(CF(0, 0.44, z), V3(0.5, 0.12, 2.6), GOLD, M.Neon)
		K.block(CF(0, 0.44, z), V3(2.6, 0.12, 0.5), GOLD, M.Neon)
	end
	---------------------------------------------------------------- END: the winged gate beyond the last landing point
	K.mirror = false
	endGate(z2 + 8)
end

return B
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">BiomeShadow</string><ProtectedString name="Source"><![CDATA[-- BiomeShadow: Shadow Dimension, Z [1800, 2400). Reference: roblox pets/Maps/07_Shadow_Biome.png (1:1 inventory).
-- Authored as seen in the reference (K.mirror = true: design -X = screen-left).
--  LEFT : ShL1 decorative side chasm (teal glowing veins, mist) · ShL2 twisted bare trees · ShL3 crimson plants ·
--         ShL4 broken double-arch ruin · ShL5 red banner posts, small shrines
--  RIGHT: ShR1 fractured gothic cathedral (tall gable facade, huge pointed rose window with teal tracery, slim
--         spires, buttresses, broken arched walls, grand stairs, red/gold banners) · ShR2 leaning broken obelisk
--         with teal rune · ShR3 twisted trees · ShR4 crimson plants, braziers with red flame
--  BACK : floating rock shards around a swirling purple vortex (off the corridor), glowing ruined columns
--  CENTRE: pale lavender tiled road with gold inlay borders.
-- Location: ServerScriptService > Server > BiomeShadow (ModuleScript)

local K = require(script.Parent.WorldKit)
local V3, CF, ANG, PI, M = K.V3, K.CF, K.ANG, K.PI, K.M
local C = K.C

local B = {}

local STONE, STONE_D, STONE_L = C(112, 92, 128), C(78, 62, 96), C(150, 130, 166)
local PLUM, TEAL, CRIMSON, GOLD = C(64, 40, 70), C(80, 230, 210), C(196, 36, 60), C(214, 170, 90)
local TILE, TILE_L = C(176, 158, 196), C(196, 180, 214)

local function rockCol() return STONE:Lerp(STONE_D, K.r(0, 0.8)):Lerp(STONE_L, K.r(0, 0.2)) end

local function facade(s, x1, top, za, zb)
	local z = za
	while z < zb - 1 do
		local l = math.min(K.r(4, 7), zb - z)
		local h = top + K.r(-0.3, 0.8)
		K.bevel(CF(s * (x1 + 1.1), h / 2 - 0.4, z + l / 2) * ANG(0, K.r(-0.06, 0.06), 0), V3(2.8, h + 0.6, l - 0.2), rockCol(), M.Slate)
		z += l
	end
end

local function rune(cf, h)
	local r = K.block(cf, V3(0.25, h, 0.5), TEAL, M.Neon, false, 0.1)
	K.tag(r, "TPFC_Pulse", { Period = K.r(10, 16), Base = 0.55, Peak = 0.05 })
	return r
end

-- ShL2 / ShR3: twisted bare tree with angular branches
local function twistedTree(pos, s)
	local top, mid = K.limb(pos, pos + V3(2 * s, 4 * s, 0), pos + V3(-1 * s, 9 * s, 1 * s), 1.6 * s, 0.8 * s, 5, PLUM, M.Wood, true)
	for i = 1, 6 do
		local base = (i <= 3) and top or mid
		local a = i / 6 * PI * 2 + K.r(-0.4, 0.4)
		local d = V3(math.cos(a), 0, math.sin(a))
		local _, m2 = K.limb(base, base + d * 2.5 * s + V3(0, 1.5 * s, 0), base + d * 5.5 * s + V3(0, K.r(2, 4) * s, 0), 0.6 * s, 0.2 * s, 3, PLUM)
		K.limb(m2, m2 + d * 1 * s + V3(0, 1.4 * s, 0), m2 + V3(-d.Z, 0, d.X) * 2 * s + V3(0, 2.6 * s, 0), 0.3 * s, 0.12 * s, 2, PLUM)
	end
	for i = 0, 2 do
		local a = i / 3 * PI * 2
		K.limb(pos + V3(0, 1.4 * s, 0), pos + V3(math.cos(a), 0.4, math.sin(a)) * 1.6 * s, pos + V3(math.cos(a), -0.2, math.sin(a)) * 3 * s, 0.8 * s, 0.3 * s, 2, PLUM)
	end
end

-- ShL3 / ShR4: crimson spiky plant
local function crimson(pos, s)
	for i = 0, 5 do
		local a = i / 6 * PI * 2 + K.r(-0.2, 0.2)
		K.wedge(CF(pos) * ANG(0, a, 0) * CF(0, 0.7 * s, -1.2 * s) * ANG(-0.6, 0, 0), V3(1, 0.25, 2.6) * s, i % 2 == 0 and CRIMSON or C(220, 56, 80), M.SmoothPlastic)
	end
	for i = 0, 3 do
		local a = i / 4 * PI * 2 + 0.4
		K.wedge(CF(pos) * ANG(0, a, 0) * CF(0, 1.2 * s, -0.6 * s) * ANG(-1.0, 0, 0), V3(0.8, 0.2, 1.8) * s, C(236, 70, 96), M.SmoothPlastic)
	end
end

-- ShL5 / ShR1: red banner with gold emblem on a stone post
local function bannerPost(pos, yaw, h)
	h = h or 10
	local cf = CF(pos) * ANG(0, yaw, 0)
	K.bevel(cf * CF(0, 0.6, 0), V3(2.6, 1.2, 2.6), STONE_D, M.Slate)
	K.block(cf * CF(0, h / 2 + 1, 0), V3(1, h, 1), STONE, M.Slate, true)
	K.pyramid(cf * CF(0, h + 1, 0), 1.6, 1.4, STONE_L, M.Slate)
	K.block(cf * CF(0, h - 0.2, -1), V3(0.3, 0.3, 3.2), GOLD, M.Metal)
	local b = K.block(cf * CF(0, h - 3.4, -1.6), V3(0.2, 6, 2.6), CRIMSON, M.Fabric)
	K.tag(b, "TPFC_Sway", { Amp = 0.02, Period = 6 })
	K.block(cf * CF(0.13, h - 3, -1.6) * ANG(PI / 4, 0, 0), V3(0.1, 1.2, 1.2), GOLD, M.Metal)
	K.block(cf * CF(0.12, h - 0.8, -1.6), V3(0.1, 0.25, 2.6), GOLD, M.Metal)
	K.wedge(cf * CF(0, h - 6.9, -2.25) * ANG(PI, 0, 0), V3(0.2, 1, 1.3), CRIMSON, M.Fabric)
	K.wedge(cf * CF(0, h - 6.9, -0.95) * ANG(PI, PI, 0), V3(0.2, 1, 1.3), CRIMSON, M.Fabric)
end

-- ShR4: brazier (stone pedestal with teal rune, red flame)
local function brazier(pos)
	K.bevel(CF(pos + V3(0, 1, 0)), V3(3.4, 2, 3.4), STONE_D, M.Slate)
	K.bevel(CF(pos + V3(0, 2.8, 0)), V3(2.6, 1.6, 2.6), STONE, M.Slate)
	for i = 0, 3 do K.wedge(CF(pos + V3(0, 4.1, 0)) * ANG(0, i * PI / 2, 0) * CF(0, 0, -1.2), V3(3, 1, 0.6), GOLD, M.Metal) end
	rune(CF(pos + V3(-1.32, 2.8, 0)) * ANG(0, PI / 2, 0) * ANG(0, PI / 2, 0), 1)
	local core = K.block(CF(pos + V3(0, 4.4, 0)), V3(1.2, 0.6, 1.2), C(255, 90, 70), M.Neon)
	local f = Instance.new("Fire"); f.Color = C(255, 70, 60); f.SecondaryColor = C(255, 160, 80); f.Size = 4; f.Heat = 6; f.Parent = core
	K.lamp(core, C(255, 90, 80), 16, 1)
end

-- ShR2: leaning broken obelisk with a teal rune
local function brokenObelisk(pos, h, lean)
	local cf = CF(pos) * ANG(0, K.r(0, PI), 0)
	for i = 1, 4 do K.bevel(cf * CF(K.r(-3, 3), 0.7, K.r(-3, 3)) * ANG(0, K.r(0, PI), K.r(-0.2, 0.2)), V3(K.r(1.8, 3), 1.4, K.r(1.8, 3)), rockCol(), M.Slate) end
	local o = CF(pos + V3(0, h / 2, 0)) * ANG(0, 0, lean)
	K.bevel(o, V3(4.4, h, 3.2), STONE_L, M.Slate)
	K.wedge(o * CF(0, h / 2 + 1.5, 0), V3(4.4, 3, 3.2), STONE_L, M.Slate)
	rune(o * CF(-2.25, 1, 0), h * 0.45)
	K.block(o * CF(-2.25, h * 0.12, 0) * ANG(PI / 4, 0, 0), V3(0.3, 1.4, 1.4), TEAL, M.Neon)
end

-- ShL4: broken double-arch ruin
local function doubleArch(pos)
	local cf = CF(pos) * ANG(0, PI / 2, 0)
	K.arch(cf * CF(-5, 0, 0), 6, 9, 2.4, STONE, M.Slate, nil, nil, 7)
	K.arch(cf * CF(5, 0, 0), 6, 9, 2.4, STONE, M.Slate, nil, nil, 7)
	K.block(cf * CF(0, 14.6, 0), V3(22, 1.4, 3), STONE_L, M.Slate)
	for i = 1, 4 do K.bevel(CF(pos + V3(K.r(-4, 4), 0.7, K.r(-12, 12))) * ANG(0, K.r(0, PI), K.r(-0.2, 0.2)), V3(K.r(1.6, 2.6), 1.4, K.r(1.6, 2.6)), STONE, M.Slate) end
end

-- ShL1: decorative side chasm (outside the corridor): dark void floor + rock walls with teal veins + mist
local function chasm(z1, z2)
	local zc = (z1 + z2) / 2
	K.block(CF(-60, 0.06, zc), V3(20, 0.12, z2 - z1), C(18, 10, 26), M.SmoothPlastic)
	for z = z1, z2 - 4, 6 do
		for _, x in ipairs({ -50, -70 }) do
			local h = K.r(3, 7)
			K.bevel(CF(x + K.r(-1, 1), h / 2 - 0.3, z + 3), V3(K.r(4, 6), h + 0.6, 6), rockCol(), M.Slate)
			if K.chance(0.4) then rune(CF(x + (x < -60 and 2.6 or -2.6), h * 0.5, z + 3), h * 0.7) end
		end
	end
	local mist = K.block(CF(-60, 1, zc), V3(16, 1, z2 - z1 - 6), C(200, 190, 230), M.SmoothPlastic, false, 1)
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
	pe.Color = ColorSequence.new(C(220, 210, 240))
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.4, 0.75), NumberSequenceKeypoint.new(1, 1) })
	pe.Size = NumberSequence.new(4, 8)
	pe.Lifetime = NumberRange.new(6, 9)
	pe.Rate = 3
	pe.Speed = NumberRange.new(0.3, 0.8)
	pe.SpreadAngle = Vector2.new(30, 30)
	pe.Shape = Enum.ParticleEmitterShape.Box
	pe.Parent = mist
end

-- ShR1: the fractured gothic cathedral (front faces the lane, -X design)
local function cathedral(c)
	-- raised plinth + grand stairs
	K.bevel(CF(c + V3(8, 2, 0)), V3(56, 4, 90), rockCol(), M.Slate)
	K.addSurface(c.X - 20, c.X + 36, c.Z - 45, c.Z + 45, 4)
	K.stairs(CF(c + V3(-24, 0, 0)) * ANG(0, -PI / 2, 0), 18, 6, 0.7, 1.5, STONE_L, M.Slate)
	for s = -1, 1, 2 do K.bevel(CF(c + V3(-24, 2.4, s * 10)), V3(9.6, 4.8, 2), STONE, M.Slate) end
	-- central gable facade with the huge pointed rose window
	local fx = c.X - 2
	K.bevel(CF(fx + 3, 4 + 18, c.Z), V3(6, 36, 30), STONE, M.Slate)
	K.wedge(CF(fx + 3, 4 + 36 + 6, c.Z - 7.5) * ANG(0, PI, 0), V3(6, 12, 15), STONE, M.Slate)
	K.wedge(CF(fx + 3, 4 + 36 + 6, c.Z + 7.5), V3(6, 12, 15), STONE, M.Slate)
	K.pointedArch(CF(fx - 0.2, 4 + 6, c.Z) * ANG(0, PI / 2, 0), 14, 16, 9, 2, STONE_L, M.Slate, TEAL)
	local glass = K.block(CF(fx - 0.1, 4 + 18, c.Z), V3(0.3, 22, 13), C(40, 120, 130), M.Glass, false, 0.2)
	K.lamp(glass, TEAL, 34, 1.4)
	for i = 0, 5 do -- rose tracery: spokes + rings
		K.block(CF(fx - 0.4, 4 + 22, c.Z) * ANG(i * PI / 6, 0, 0), V3(0.25, 11, 0.35), TEAL, M.Neon)
	end
	for _, r in ipairs({ 5.2, 2.4 }) do
		for i = 0, 15 do
			local a0, a1 = i / 16 * PI * 2, (i + 1) / 16 * PI * 2
			local p0 = V3(fx - 0.45, 4 + 22 + math.sin(a0) * r, c.Z + math.cos(a0) * r)
			local p1 = V3(fx - 0.45, 4 + 22 + math.sin(a1) * r, c.Z + math.cos(a1) * r)
			K.block(CFrame.lookAt((p0 + p1) / 2, p1), V3(0.3, 0.3, (p1 - p0).Magnitude + 0.1), TEAL, M.Neon)
		end
	end
	for k = -1, 1 do K.block(CF(fx - 0.4, 4 + 11, c.Z + k * 3.4), V3(0.25, 12, 0.35), TEAL, M.Neon) end
	-- doorway below the window
	K.pointedArch(CF(fx - 0.6, 4, c.Z) * ANG(0, PI / 2, 0), 6, 6, 3, 1.4, STONE_L, M.Slate)
	K.block(CF(fx - 0.2, 4 + 4, c.Z), V3(0.3, 8, 5.8), C(24, 16, 34), M.SmoothPlastic)
	-- flanking towers with slim spires + buttresses
	for s = -1, 1, 2 do
		local tz = c.Z + s * 20
		K.bevel(CF(fx + 4, 4 + 22, tz), V3(10, 44, 10), rockCol(), M.Slate)
		K.cone(V3(fx + 4, 4 + 44, tz), 5.4, 22, 6, STONE_D, STONE, M.Slate)
		K.cone(V3(fx + 4, 4 + 66, tz), 0.8, 4, 5, GOLD, K.dark(GOLD, 0.2), M.Metal)
		K.pointedArch(CF(fx - 1.1, 4 + 22, tz) * ANG(0, PI / 2, 0), 3, 7, 3, 0.8, STONE_L, M.Slate, TEAL)
		K.block(CF(fx - 1, 4 + 26, tz), V3(0.2, 9, 3), C(40, 120, 130), M.Glass, false, 0.2)
		bannerPost(V3(fx - 9, 4, c.Z + s * 9), PI / 2, 12)
		for k = 0, 2 do
			local bz = c.Z + s * (30 + k * 10)
			K.wedge(CF(fx + 2, 4 + 9, bz) * ANG(0, -PI / 2, 0), V3(3, 18, 8), STONE_D, M.Slate)
			K.cone(V3(fx + 6, 4 + 18, bz), 1.6, 9, 5, STONE, STONE_D, M.Slate)
			-- broken nave wall with pointed windows
			K.bevel(CF(fx + 10, 4 + 10 - k * 2, bz), V3(4, 20 - k * 4, 9), rockCol(), M.Slate)
			K.pointedArch(CF(fx + 7.8, 4 + 6, bz) * ANG(0, PI / 2, 0), 3, 6, 2.6, 0.8, STONE_L, M.Slate)
		end
	end
	-- fractured roofline: broken chunks + slowly drifting stones
	for _ = 1, 5 do
		K.bevel(CF(c + V3(K.r(10, 30), 4 + K.r(0.5, 1.5), K.r(-40, 40))) * ANG(K.r(-0.3, 0.3), K.r(0, PI), K.r(-0.3, 0.3)), V3(K.r(2, 4), K.r(1.5, 3), K.r(2, 4)), STONE, M.Slate)
	end
	for _ = 1, 5 do
		local st = K.block(CF(c + V3(K.r(0, 30), K.r(48, 70), K.r(-30, 30))) * ANG(K.r(0, 1), K.r(0, 3), 0), V3(1, 1, 1) * K.r(3, 6), STONE_D, M.Slate)
		K.tag(st, "TPFC_Bob", { Amp = 1.2, Period = K.r(8, 12), Spin = K.r(2, 4) })
	end
end

function B.Build(b)
	K.Seed(7007)
	K.ResetSurfaces()
	K.mirror = true
	local z1, z2 = b[1], b[2]
	K.terraces(z1, z2, {
		rock = STONE, rockMat = M.Slate, cap = C(96, 74, 110), capMat = M.Slate, drip = false, tiers = 3,
		h1 = { 1.6, 3.4 }, h2 = { 5, 10 }, h3 = { 8, 18 },
		skip = { { 1, 2040, 2200 }, { -1, 1870, 1990 } },
		facade = facade,
	})
	---------------------------------------------------------------- LEFT: chasm, trees, crimson plants, double arch, banner posts
	chasm(1870, 1990)
	for _, p in ipairs({ { -54, 1850, 1.6 }, { -60, 2010, 1.8 }, { -66, 2150, 1.5 }, { -58, 2290, 1.7 }, { -84, 1940, 2 } }) do twistedTree(K.at(p[1], p[2]), p[3]) end
	doubleArch(K.at(-60, 2080))
	doubleArch(K.at(-74, 2340))
	for _, p in ipairs({ { -50, 1830 }, { -52, 2050 }, { -50, 2230 } }) do bannerPost(K.at(p[1], p[2]), PI / 2, 10) end
	---------------------------------------------------------------- RIGHT: cathedral, obelisk, trees, braziers
	cathedral(V3(80, 0, 2120))
	brokenObelisk(K.at(56, 1990), 18, 0.18)
	brokenObelisk(K.at(60, 2280), 14, -0.15)
	for _, p in ipairs({ { 56, 1860, 1.7 }, { 62, 2240, 1.6 }, { 58, 2370, 1.8 } }) do twistedTree(K.at(p[1], p[2]), p[3]) end
	for _, p in ipairs({ { 50, 2030 }, { 50, 2210 }, { 52, 1900 } }) do brazier(K.at(p[1], p[2])) end
	---------------------------------------------------------------- crimson plants on terrace tops + lane edges
	for _, r in ipairs(K.surfaces) do
		local xa, xb = math.max(r[1], -90), math.min(r[2], 90)
		if xb - xa > 3 then
			for _ = 1, math.floor((xb - xa) * (r[4] - r[3]) / 220) do
				local x, z = K.r(xa + 2, xb - 2), K.r(r[3] + 2, r[4] - 2)
				if math.abs(x) >= 48 and not (x > 55 and z > 2070 and z < 2170) then crimson(V3(x, r[5], z), K.r(0.9, 1.5)) end
			end
		end
	end
	for s = -1, 1, 2 do
		for z = z1 + 10, z2 - 8, 13 do
			local p = V3(s * K.r(38, 43), 0, z + K.r(-4, 4))
			if K.chance(0.55) then crimson(p, K.r(0.9, 1.3))
			else K.bevel(CF(p + V3(0, 0.6, 0)) * ANG(0, K.r(0, PI), 0), V3(K.r(2, 3.4), 1.4, K.r(2, 3.4)), rockCol(), M.Slate) end
		end
	end
	---------------------------------------------------------------- CENTRE: pale lavender tiled road with gold inlay borders
	for z = z1 + 1, z2 - 13, 14 do
		for x = -27.5, 27.5, 11 do
			K.block(CF(x + K.r(-0.15, 0.15), 0.18, z + 7), V3(10.7, 0.3, 13.7), TILE:Lerp(TILE_L, K.r(0, 1)), M.Slate)
		end
	end
	for s = -1, 1, 2 do
		K.block(CF(s * 33.4, 0.36, (z1 + z2) / 2), V3(0.6, 0.12, z2 - z1), GOLD, M.Metal)
		K.block(CF(s * 35.2, 0.3, (z1 + z2) / 2), V3(3, 0.3, z2 - z1), C(150, 130, 170), M.Slate)
		for z = z1 + 40, z2 - 40, 80 do
			K.block(CF(s * 29, 0.37, z) * ANG(0, s * 0.8, 0), V3(0.5, 0.12, 12), GOLD, M.Metal)
			K.block(CF(s * 29, 0.37, z + 9) * ANG(0, -s * 0.8, 0), V3(0.5, 0.12, 12), GOLD, M.Metal)
		end
	end
	---------------------------------------------------------------- BACK: vortex (off to the side) with floating shards, glowing ruined columns
	local vc = CF(-96, 46, 2380) * ANG(0, PI / 2 - 0.5, 0)
	for k = 0, 3 do
		for i = 0, 17 do
			local a0, a1 = i / 18 * PI * 2 + k * 0.5, (i + 1) / 18 * PI * 2 + k * 0.5
			local r = 30 - k * 6
			local p0, p1 = vc * V3(math.cos(a0) * r, math.sin(a0) * r, k * 2), vc * V3(math.cos(a1) * r, math.sin(a1) * r, k * 2)
			local seg = K.block(CFrame.lookAt((p0 + p1) / 2, p1), V3(3 - k * 0.4, 5 - k, (p1 - p0).Magnitude), C(170 + k * 20, 120 + k * 20, 220), M.Neon, false, 0.55 + k * 0.08)
			seg.CastShadow = false
		end
	end
	for _ = 1, 10 do
		local st = K.block(vc * CF(K.r(-40, 40), K.r(-30, 34), K.r(-10, 10)) * ANG(K.r(0, PI), K.r(0, PI), 0), V3(K.r(3, 7), K.r(5, 10), K.r(3, 6)), rockCol(), M.Slate)
		K.tag(st, "TPFC_Bob", { Amp = 1.5, Period = K.r(8, 14), Spin = K.r(1, 3) })
	end
	for s = -1, 1, 2 do
		for i = 0, 4 do
			local p = V3(s * K.r(60, 100), 0, 2300 + i * 20)
			K.column(p, K.r(14, 24), 2.4, STONE_L, M.Slate, GOLD)
			local g = K.block(CF(p + V3(0, 9, 0)), V3(0.5, 12, 0.5), C(255, 220, 160), M.Neon, false, 0.2)
			g.CastShadow = false
		end
	end
	---------------------------------------------------------------- transition to Heaven: warm light in cracks, pale stone columns
	for s = -1, 1, 2 do
		for _ = 1, 3 do
			local p = V3(s * K.r(44, 56), 0, K.r(2382, 2398))
			K.column(p, K.r(5, 9), 1.6, C(236, 228, 214), M.Marble, GOLD)
			K.block(CF(p + V3(0, 0.1, 0)), V3(4, 0.12, 0.3), C(255, 220, 150), M.Neon)
		end
	end
	K.mirror = false
end

return B
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">BiomeSpace</string><ProtectedString name="Source"><![CDATA[-- BiomeSpace: Space Galaxy, Z [1300, 1800). Reference: roblox pets/Maps/06_Space_Biome.png (1:1 inventory).
-- Authored as seen in the reference (K.mirror = true: design -X = screen-left).
--  LEFT : SL1 observatory (ribbed stone/brass dome with an open slot + brass telescope, drum with gold bands,
--         columned portico with blue emblem banners, wide stairs, segmented brass orbital arc, golden beacon star
--         with halo) · SL2 purple bonsai trees · SL3 gold-emblem obelisks · SL4 glowing blue crystals
--  RIGHT: SR1 crater ring (glowing blue bowl + half-sunk gold ring frame) · SR2 crashed satellite dish +
--         gold-banded capsule · SR3 purple trees, crystals, obelisk shards
--  BACK : jagged purple crystal rocks, giant ringed planet, asteroids, constellation lines
--  CENTRE: lavender lunar ground with shallow craters (flush rings — the terrain stays continuous).
-- Location: ServerScriptService > Server > BiomeSpace (ModuleScript)

local K = require(script.Parent.WorldKit)
local V3, CF, ANG, PI, M = K.V3, K.CF, K.ANG, K.PI, K.M
local C = K.C

local B = {}

local LUNAR, LUNAR_D, LUNAR_L = C(122, 124, 176), C(88, 88, 140), C(156, 158, 204)
local STONE, BRASS, GOLD = C(150, 152, 186), C(206, 164, 92), C(232, 190, 96)
local BLUE, VIOLET, TREE = C(110, 180, 255), C(150, 90, 255), C(176, 120, 230)
local BANNER = C(48, 52, 150)

local function rockCol() return LUNAR:Lerp(LUNAR_D, K.r(0, 0.8)):Lerp(LUNAR_L, K.r(0, 0.3)) end

local function facade(s, x1, top, za, zb)
	local z = za
	while z < zb - 1 do
		local l = math.min(K.r(4, 7), zb - z)
		local h = top + K.r(-0.3, 0.8)
		K.bevel(CF(s * (x1 + 1.1), h / 2 - 0.4, z + l / 2) * ANG(0, K.r(-0.06, 0.06), 0), V3(2.8, h + 0.6, l - 0.2), rockCol(), M.Slate)
		z += l
	end
end

-- segmented arc of brass blocks: centre cf, radius r, from angle a0 to a1 in the cf XY plane
local function arc(cf, r, a0, a1, n, thick, depth, col, mat)
	for i = 0, n - 1 do
		local t0, t1 = a0 + (a1 - a0) * i / n, a0 + (a1 - a0) * (i + 1) / n
		local p0, p1 = cf * V3(math.cos(t0) * r, math.sin(t0) * r, 0), cf * V3(math.cos(t1) * r, math.sin(t1) * r, 0)
		K.block(CFrame.lookAt((p0 + p1) / 2, p1, cf.LookVector), V3(thick, depth, (p1 - p0).Magnitude + 0.3), col, mat or M.Metal)
	end
end

local function star(cf, r, col)
	for i = 0, 3 do K.block(cf * ANG(0, 0, i * PI / 4), V3(r * 0.35, r * 2, r * 0.35), col, M.Neon) end
end

-- SL2 / SR3: purple bonsai tree (curved trunk, flat tiered canopy discs)
local function bonsai(pos, s)
	local top, mid = K.limb(pos, pos + V3(1.5 * s, 3 * s, 0), pos + V3(-0.5 * s, 6 * s, 0.6 * s), 1.2 * s, 0.7 * s, 4, C(110, 70, 60), M.Wood, true)
	local side = mid + V3(2.6 * s, 1.4 * s, 0)
	K.limb(mid, mid + V3(1.2 * s, 1 * s, 0), side, 0.6 * s, 0.4 * s, 2, C(110, 70, 60), M.Wood)
	for _, p in ipairs({ { top + V3(0, 0.8 * s, 0), 7 }, { side + V3(0, 0.4 * s, 0), 4.5 }, { top + V3(-2 * s, -1.4 * s, 1.5 * s), 4 } }) do
		K.ellipsoid(CF(p[1]), V3(p[2], 1.4, p[2] * 0.85) * s, TREE, M.SmoothPlastic)
		K.ellipsoid(CF(p[1] + V3(0, 0.5 * s, 0)), V3(p[2] * 0.8, 0.9, p[2] * 0.65) * s, K.light(TREE, 0.18), M.SmoothPlastic)
	end
end

-- SL3 / SR3: obelisk with gold emblem
local function obelisk(pos, h, yaw)
	local cf = CF(pos) * ANG(0, yaw or 0, 0)
	K.bevel(cf * CF(0, 0.8, 0), V3(4.4, 1.6, 4.4), LUNAR_D, M.Slate)
	K.bevel(cf * CF(0, 1.6 + h / 2, 0), V3(3, h, 2.2), STONE, M.Slate)
	K.pyramid(cf * CF(0, 1.6 + h, 0), 3, 2.4, STONE, M.Slate, 2.2)
	K.cyl(cf * CF(0, 1.6 + h * 0.62, -1.15) * ANG(0, PI / 2, 0), 0.2, 1.8, GOLD, M.Metal)
	star(cf * CF(0, 1.6 + h * 0.62, -1.28), 0.5, GOLD)
end

-- SL1: the observatory
local function observatory(c)
	-- rock base, terrace and wide stairs facing the lane (+X design)
	K.bevel(CF(c + V3(0, 3, 0)), V3(46, 6, 50), rockCol(), M.Slate)
	K.bevel(CF(c + V3(-2, 8, 0)), V3(36, 4, 40), STONE, M.Slate)
	K.addSurface(c.X - 23, c.X + 23, c.Z - 25, c.Z + 25, 6)
	K.addSurface(c.X - 20, c.X + 16, c.Z - 20, c.Z + 20, 10)
	K.stairs(CF(c + V3(26, 0, 0)) * ANG(0, PI / 2, 0), 14, 8, 1.25, 1.6, STONE, M.Slate)
	-- drum with gold bands
	local d = c + V3(-4, 10, 0)
	K.vcyl(d, 12, 26, STONE, M.Slate, true)
	for _, y in ipairs({ 0.4, 11.6 }) do K.vcyl(d + V3(0, y, 0), 0.8, 26.6, GOLD, M.Metal) end
	-- dome: hemisphere + brass meridian ribs + open slot with telescope
	local top = d + V3(0, 12, 0)
	K.ellipsoid(CF(top), V3(25, 24, 25), C(132, 136, 176), M.Metal)
	for i = 0, 7 do
		local cf = CF(top) * ANG(0, i * PI / 8, 0)
		arc(cf, 12.7, 0, PI, 10, 0.8, 1, BRASS)
	end
	local slotCF = CF(top) * ANG(0, 0, 0)
	K.block(slotCF * CF(6, 6, 0) * ANG(0, 0, -0.9), V3(10, 3, 5.6), C(40, 36, 60), M.SmoothPlastic)
	K.cyl(CF(top + V3(8, 9, 0)) * ANG(0, 0, 0.6), 18, 3.6, BRASS, M.Metal)
	K.cyl(CF(top + V3(16, 14.6, 0)) * ANG(0, 0, 0.6), 2, 4.4, GOLD, M.Metal)
	K.cyl(CF(top + V3(3, 6, 0)) * ANG(0, 0, 0.6), 1.4, 4.4, GOLD, M.Metal)
	-- beacon star with halo
	local beacon = CF(top + V3(0, 15, 0))
	star(beacon, 2.2, C(255, 220, 140))
	K.lamp(K.block(beacon, V3(1, 1, 1), C(255, 220, 140), M.Neon), C(255, 220, 150), 40, 1.6)
	local halo = K.cyl(beacon * ANG(0, 0, PI / 2), 0.2, 9, C(255, 230, 170), M.Neon, false, 0.5)
	K.tag(halo, "TPFC_Spin", { Rate = 6 })
	K.vcyl(top + V3(0, 11, 0), 3, 0.6, GOLD, M.Metal)
	-- segmented brass orbital arc sweeping around the dome
	local orbit = CF(top + V3(0, 2, 0)) * ANG(0.35, 0.4, 0.5)
	arc(orbit, 26, -0.4, PI * 1.25, 22, 1.6, 2.6, BRASS)
	arc(orbit, 26, -0.4, PI * 1.25, 22, 0.4, 2.8, GOLD)
	-- portico: columns, lintel, banners with emblem, glowing doorway
	local px = d.X + 13.5
	for s = -1, 1, 2 do
		for k = 0, 1 do K.column(V3(px + 1, 10, d.Z + s * (4 + k * 5)), 10, 1.6, STONE, M.Slate, GOLD) end
		local b = K.block(CF(px + 2.2, 15, d.Z + s * 6.5), V3(0.2, 7, 2.6), BANNER, M.Fabric)
		K.tag(b, "TPFC_Sway", { Amp = 0.02, Period = 6 })
		star(CF(px + 2.35, 15.5, d.Z + s * 6.5) * ANG(0, PI / 2, 0), 0.6, GOLD)
	end
	K.block(CF(px + 1, 21.6, d.Z), V3(4, 1.4, 22), STONE, M.Slate)
	K.block(CF(px + 1, 22.5, d.Z), V3(4.4, 0.4, 22.4), GOLD, M.Metal)
	local door = K.block(CF(px + 0.2, 14.5, d.Z), V3(0.3, 8, 4.6), C(255, 210, 140), M.Neon, false, 0.25)
	K.lamp(door, C(255, 210, 150), 24, 1.2)
end

-- SR1: crater ring structure (raised rim, glowing bowl, half-sunk gold ring frame)
local function craterRing(c)
	for i = 0, 17 do
		local a = i / 18 * PI * 2
		K.bevel(CF(c + V3(math.cos(a) * 14, 1.4, math.sin(a) * 14)) * ANG(0, -a, 0.25), V3(5, 2.8, 5.4), rockCol(), M.Slate)
	end
	for i = 0, 2 do
		local disc = K.cyl(CF(c + V3(0, 0.2 + i * 0.08, 0)) * ANG(0, 0, PI / 2), 0.15, 22 - i * 6, i == 2 and C(170, 230, 255) or BLUE, M.Neon, false, 0.25 + i * 0.1)
		if i == 0 then K.lamp(disc, BLUE, 40, 1.4); K.tag(disc, "TPFC_Pulse", { Period = 8, Base = 0.25, Peak = 0.05 }) end
	end
	local ringCF = CF(c + V3(-6, 6, 0)) * ANG(0, PI / 2, 0)
	arc(ringCF, 12, -0.3, PI + 0.3, 20, 2.2, 3, BRASS)
	arc(ringCF, 12.9, -0.3, PI + 0.3, 20, 0.5, 3.2, GOLD)
	for s = -1, 1, 2 do obelisk(c + V3(-6, 0, s * 17), 8, PI / 2) end
end

-- SR2: crashed satellite dish + gold-banded capsule
local function satellite(c)
	local dish = CF(c + V3(0, 5, 0)) * ANG(0.5, -0.6, 0.3)
	K.ellipsoid(dish, V3(13, 2.2, 13), C(226, 228, 236), M.SmoothPlastic)
	K.ellipsoid(dish * CF(0, 0.5, 0), V3(11, 1.6, 11), C(196, 200, 214), M.SmoothPlastic)
	K.block(dish * CF(0, 3, 0), V3(0.4, 6, 0.4), C(150, 150, 166), M.Metal)
	K.ball((dish * CF(0, 6.2, 0)).Position, 1, C(200, 204, 216), M.Metal)
	for s = -1, 1, 2 do K.block(dish * CF(s * 2.4, 2.5, 0) * ANG(0, 0, -s * 0.5), V3(0.25, 5.5, 0.25), C(150, 150, 166), M.Metal) end
	K.block(CF(c + V3(0, 2, 0)) * ANG(0.2, 0, 0.3), V3(1.4, 5, 1.4), C(130, 132, 150), M.Metal)
	local cap = CF(c + V3(6, 2.6, 7)) * ANG(0, 0.6, 0.25)
	K.cyl(cap, 10, 5.2, C(196, 196, 210), M.Metal)
	for k = -1, 1 do K.cyl(cap * CF(k * 3.6, 0, 0), 0.6, 5.6, GOLD, M.Metal) end
	K.cyl(cap * CF(5.1, 0, 0), 0.3, 3.4, C(40, 36, 60), M.SmoothPlastic)
	K.lamp(K.block(cap * CF(5, 0, 0), V3(0.4, 0.4, 0.4), C(255, 200, 120), M.Neon), C(255, 200, 120), 12, 0.8)
	for _ = 1, 6 do K.bevel(CF(c + V3(K.r(-8, 10), 0.5, K.r(-6, 12))) * ANG(0, K.r(0, PI), K.r(-0.2, 0.2)), V3(K.r(1.6, 3), 1, K.r(1.6, 3)), rockCol(), M.Slate) end
end

-- flush lunar crater (rim + darker floor)
local function crater(pos, r)
	K.cyl(CF(pos + V3(0, 0.12, 0)) * ANG(0, 0, PI / 2), 0.16, r * 2 + 1.2, LUNAR_L, M.Slate)
	K.cyl(CF(pos + V3(0, 0.16, 0)) * ANG(0, 0, PI / 2), 0.16, r * 2, C(120, 122, 168), M.Slate)
	K.cyl(CF(pos + V3(0.3, 0.2, 0.3)) * ANG(0, 0, PI / 2), 0.16, r * 1.4, C(108, 110, 156), M.Slate)
end

function B.Build(b)
	K.Seed(6006)
	K.ResetSurfaces()
	K.mirror = true
	local z1, z2 = b[1], b[2]
	K.terraces(z1, z2, {
		rock = LUNAR, rockMat = M.Slate, cap = LUNAR_L, capMat = M.Slate, drip = false, tiers = 3,
		h1 = { 1.6, 3.4 }, h2 = { 5, 10 }, h3 = { 8, 18 },
		skip = { { -1, 1400, 1520 }, { 1, 1440, 1560 }, { 1, 1640, 1700 } },
		facade = facade,
	})
	---------------------------------------------------------------- LEFT
	observatory(V3(-84, 0, 1460))
	for _, p in ipairs({ { -56, 1420, 1.3 }, { -60, 1510, 1.5 }, { -70, 1350, 1.4 }, { -66, 1600, 1.6 }, { -58, 1720, 1.2 } }) do bonsai(K.at(p[1], p[2]), p[3]) end
	for _, p in ipairs({ { -54, 1380, 9 }, { -55, 1560, 11 }, { -56, 1700, 8 } }) do obelisk(K.at(p[1], p[2]), p[3], PI / 2) end
	---------------------------------------------------------------- RIGHT
	craterRing(V3(76, 0, 1500))
	satellite(V3(62, 0, 1670))
	for _, p in ipairs({ { 54, 1420, 1.3 }, { 60, 1600, 1.5 }, { 66, 1760, 1.4 }, { 58, 1340, 1.2 } }) do bonsai(K.at(p[1], p[2]), p[3]) end
	obelisk(K.at(56, 1380), 9, -PI / 2)
	obelisk(K.at(54, 1740), 10, -PI / 2)
	---------------------------------------------------------------- crystals on terrace tops + lane edges
	for _, r in ipairs(K.surfaces) do
		local xa, xb = math.max(r[1], -90), math.min(r[2], 90)
		if xb - xa > 3 then
			for _ = 1, math.floor((xb - xa) * (r[4] - r[3]) / 260) do
				local x, z = K.r(xa + 2, xb - 2), K.r(r[3] + 2, r[4] - 2)
				if math.abs(x) >= 48 then K.crystalCluster(V3(x, r[5], z), K.r(0.6, 1.1), { BLUE, C(150, 210, 255), VIOLET }, K.chance(0.4) and 0 or nil) end
			end
		end
	end
	for s = -1, 1, 2 do
		for z = z1 + 10, z2 - 8, 14 do
			local p = V3(s * K.r(38, 43), 0, z + K.r(-4, 4))
			if K.chance(0.5) then K.crystal(p, K.r(1.6, 3), 0.8, BLUE, ANG(0, K.r(0, PI), s * 0.4), K.chance(0.4))
			else K.bevel(CF(p + V3(0, 0.5, 0)) * ANG(0, K.r(0, PI), 0), V3(K.r(2, 3.4), 1.2, K.r(2, 3.4)), rockCol(), M.Slate) end
		end
	end
	---------------------------------------------------------------- CENTRE: flush craters
	for _ = 1, 14 do crater(V3(K.r(-24, 24), 0, K.r(z1 + 15, z2 - 15)), K.r(2.5, 6)) end
	---------------------------------------------------------------- BACK: jagged purple crystal rocks, planet, asteroids, constellations
	for s = -1, 1, 2 do
		for _ = 1, 6 do
			local p = V3(s * K.r(110, 150), 0, K.r(z1, z2 + 60))
			K.cone(p, K.r(14, 22), K.r(30, 60), 6, C(90, 76, 150), C(70, 56, 120), M.Slate, true)
			K.crystal(p + V3(-s * 6, 4, 0), K.r(10, 18), K.r(3, 5), VIOLET, ANG(0, 0, s * 0.3), true)
		end
	end
	local pc = V3(190, 190, 1900)
	K.ball(pc, 120, C(170, 160, 230), M.SmoothPlastic).CastShadow = false
	for i = 0, 2 do K.ball(pc + V3(0, -10 + i * 14, 0), 121 - math.abs(i - 1) * 8, i % 2 == 0 and C(150, 140, 214) or C(196, 186, 244), M.SmoothPlastic, 0.55).CastShadow = false end
	local ring = K.cyl(CF(pc) * ANG(0.25, 0, PI / 2 + 0.3), 0.8, 220, C(210, 200, 250), M.SmoothPlastic, false, 0.3)
	ring.CastShadow = false
	K.cyl(CF(pc) * ANG(0.25, 0, PI / 2 + 0.3), 0.9, 180, C(150, 140, 214), M.SmoothPlastic, false, 0.35).CastShadow = false
	for _ = 1, 10 do
		local s = K.chance(0.5) and 1 or -1
		local a = K.block(CF(s * K.r(80, 150), K.r(60, 120), K.r(z1, z2)) * ANG(K.r(0, PI), K.r(0, PI), 0), V3(1, 1, 1) * K.r(4, 10), C(120, 116, 150), M.Slate)
		K.tag(a, "TPFC_Spin", { Rate = K.r(2, 6) })
	end
	for _, cons in ipairs({ { V3(40, 190, 1820), 7 }, { V3(-60, 210, 1840), 6 } }) do
		local prev
		for _ = 1, cons[2] do
			local p = cons[1] + V3(K.r(-30, 30), K.r(-18, 18), K.r(-6, 6))
			K.ball(p, 1.6, C(255, 250, 220), M.Neon)
			if prev then K.block(CF((prev + p) / 2, p), V3(0.18, 0.18, (p - prev).Magnitude), C(200, 210, 255), M.Neon, false, 0.5) end
			prev = p
		end
	end
	---------------------------------------------------------------- transition to Shadow: fractured side rock, muted stars
	for s = -1, 1, 2 do
		for _ = 1, 3 do
			local p = V3(s * K.r(44, 58), 0, K.r(1782, 1798))
			K.rockMass(p, K.r(4, 7), K.r(3, 7), K.r(4, 7), C(80, 66, 100), M.Slate, 2)
		end
	end
	K.mirror = false
end

return B
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">BiomeVolcano</string><ProtectedString name="Source"><![CDATA[-- BiomeVolcano: Volcano World, Z [150, 350). Reference: roblox pets/Maps/02_Volcano_Biome.png (1:1 inventory).
-- Authored as seen in the reference (K.mirror = true: design -X = screen-left).
--  LEFT : VL1 giant jagged volcano (spiky peaks, crater, smoke plume, two winding lava rivers) ·
--         VL2 cliff lavafall into a glowing pool · VL3 hexagonal basalt column clusters with molten seams ·
--         VL4 cooled-lava swirl plates · VL5 red spiky plants · VL6 gold-trimmed arch ruin glowing inside
--  RIGHT: VR1 smoking vent cones · VR2 gold-trimmed arch with red banner · VR3 basalt steps, red plants,
--         orange crystal shards · VR4 snow-capped peaks far right (transition into Frozen)
--  CENTRE: dark slab road with a raised border curb and branching glowing cracks; broken arched bridge in
--          the distance (side spans only — nothing crosses the throw corridor).
-- Location: ServerScriptService > Server > BiomeVolcano (ModuleScript)

local K = require(script.Parent.WorldKit)
local V3, CF, ANG, PI, M = K.V3, K.CF, K.ANG, K.PI, K.M
local C = K.C

local B = {}

local BASALT, DARK, ASH, HILITE = C(64, 54, 62), C(38, 32, 40), C(92, 82, 90), C(104, 90, 104)
local LAVA, LAVA_HOT, EMBER = C(236, 92, 22), C(255, 162, 52), C(206, 44, 34)
local GOLD = C(212, 162, 74)
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function rockCol() return BASALT:Lerp(DARK, K.r(0, 0.6)):Lerp(HILITE, K.r(0, 0.25)) end

local function smoke(p, rate, size, col)
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = SMOKE
	pe.Color = ColorSequence.new(col or C(110, 100, 104), C(170, 160, 164))
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.85), NumberSequenceKeypoint.new(0.25, 0.4), NumberSequenceKeypoint.new(1, 1) })
	pe.Size = NumberSequence.new(size * 0.5, size * 1.8)
	pe.Lifetime = NumberRange.new(6, 9)
	pe.Rate = rate
	pe.Speed = NumberRange.new(4, 7)
	pe.SpreadAngle = Vector2.new(10, 10)
	pe.Acceleration = V3(2.5, 1, 0)
	pe.RotSpeed = NumberRange.new(-10, 10)
	pe.LightInfluence = 0.7
	pe.Parent = p
end

-- VL3: hexagonal prism (three rotated slabs) with a lighter top
local function hexCol(pos, w, h, col, seam)
	for i = 0, 2 do
		K.block(CF(pos + V3(0, h / 2, 0)) * ANG(0, i * PI / 3, 0), V3(w, h, w * 0.577), col, M.Basalt, i == 0)
	end
	for i = 0, 2 do
		K.block(CF(pos + V3(0, h + 0.15, 0)) * ANG(0, i * PI / 3, 0), V3(w * 0.9, 0.3, w * 0.52), K.light(col, 0.12), M.Basalt)
	end
	if seam then
		local s = K.block(CF(pos + V3(0, h * 0.5, 0)) * ANG(0, PI / 6, 0) * CF(0, 0, -w * 0.29 - 0.02), V3(w * 0.2, h * 0.7, 0.1), LAVA, M.Neon)
		K.tag(s, "TPFC_Pulse", { Period = K.r(8, 14), Base = 0.15, Peak = 0 })
	end
end
local function colonnade(pos, n, r, hMin, hMax)
	for _ = 1, n do
		local a, d = K.r(0, PI * 2), K.r(0, r)
		hexCol(pos + V3(math.cos(a) * d, 0, math.sin(a) * d), K.r(2.6, 3.8), K.r(hMin, hMax), rockCol(), K.chance(0.4))
	end
end

-- branching molten crack network (flush)
local function cracks(pos, n, len, y)
	for _ = 1, n do
		local a = K.r(0, PI * 2)
		local p = pos
		for k = 0, K.ri(2, 4) do
			local l = len * K.r(0.5, 1) * (1 - k * 0.15)
			local d = V3(math.cos(a), 0, math.sin(a))
			local seg = K.block(CF(p + d * l / 2 + V3(0, y or 0.06, 0), p + d * l + V3(0, y or 0.06, 0)), V3(0.3, 0.12, l), LAVA, M.Neon, false, 0.1)
			if k == 0 then K.tag(seg, "TPFC_Pulse", { Period = K.r(10, 16), Base = 0.1, Peak = 0 }) end
			p = p + d * l
			a += K.r(-0.7, 0.7)
		end
	end
end

-- VR1: vent cone with glowing crater and smoke
local function vent(pos, s)
	for i = 0, 7 do
		local a = i / 8 * PI * 2 + K.r(-0.2, 0.2)
		K.block(CF(pos + V3(math.cos(a) * 2.6 * s, 1.3 * s, math.sin(a) * 2.6 * s)) * ANG(0, -a, 0) * ANG(0, 0, 0.45),
			V3(1.8, 3.2, 2.4) * s, rockCol(), M.Basalt, true)
	end
	K.vcyl(pos, 1.2 * s, 6.5 * s, DARK, M.Basalt, true)
	local core = K.vcyl(pos + V3(0, 1.2 * s, 0), 0.25, 3 * s, LAVA_HOT, M.Neon)
	K.tag(core, "TPFC_Pulse", { Period = K.r(9, 15), Base = 0.35, Peak = 0 })
	K.lamp(core, LAVA, 16 * s, 1.2)
	smoke(core, 1.5, 3.5 * s)
	cracks(pos, 3, 2.5 * s, 0.07)
end

-- VL5: red spiky plant
local function redPlant(pos, s)
	for i = 0, 6 do
		local a = i / 7 * PI * 2 + K.r(-0.2, 0.2)
		K.wedge(CF(pos) * ANG(0, a, 0) * CF(0, 0.9 * s, -1.1 * s) * ANG(-0.8, 0, 0), V3(0.7, 0.25, 2.6) * s, EMBER, M.SmoothPlastic)
	end
	for i = 0, 3 do
		local a = i / 4 * PI * 2 + 0.4
		K.wedge(CF(pos) * ANG(0, a, 0) * CF(0, 1.4 * s, -0.5 * s) * ANG(-1.15, 0, 0), V3(0.5, 0.2, 2) * s, C(255, 88, 52), M.SmoothPlastic)
	end
	K.block(CF(pos + V3(0, 0.7 * s, 0)), V3(0.7, 0.7, 0.7) * s, LAVA_HOT, M.Neon)
end
-- VR3: orange crystal shard cluster
local function shards(pos, s)
	K.crystalCluster(pos, s, { C(255, 120, 40), C(255, 160, 70), C(230, 70, 40) }, 0)
end

-- VL4: cooled-lava swirl plate: stacked discs with dark spiral grooves and a molten rim
local function swirl(pos, s)
	K.cyl(CF(pos + V3(0, 0.08, 0)) * ANG(0, 0, PI / 2), 0.12, 11 * s, LAVA, M.Neon)
	for i = 0, 3 do
		local d = (10 - i * 2.4) * s
		K.cyl(CF(pos + V3(i * 0.25, 0.3 + i * 0.35, i * 0.2)) * ANG(0, 0, PI / 2), 0.4, d, i % 2 == 0 and BASALT or DARK, M.Basalt, i == 0)
		K.cyl(CF(pos + V3(i * 0.25, 0.52 + i * 0.35, i * 0.2)) * ANG(0, 0, PI / 2), 0.06, d - 0.8 * s, K.dark(DARK, 0.3), M.Basalt)
	end
end

-- VL6 / VR2: gold-trimmed basalt arch; glow = molten portal light inside; banner = red cloth
local function goldArch(pos, yaw, glow, banner)
	local cf = CF(pos) * ANG(0, yaw, 0)
	K.bevel(cf * CF(0, 0.5, 0), V3(13, 1, 5), DARK, M.Basalt)
	K.arch(cf * CF(0, 1, 0), 8, 9, 3, BASALT, M.Basalt, GOLD, M.Metal, 7)
	K.block(cf * CF(0, 19.2, 0), V3(3.6, 1.6, 3.6), GOLD, M.Metal)
	K.pyramid(cf * CF(0, 20, 0), 3, 2, GOLD, M.Metal)
	for s = -1, 1, 2 do
		K.block(cf * CF(s * 5.5, 10.4, 0), V3(3.4, 0.5, 3.8), GOLD, M.Metal)
		local seam = K.block(cf * CF(s * 5.5, 5, -1.56), V3(0.5, 7, 0.1), LAVA, M.Neon)
		K.tag(seam, "TPFC_Pulse", { Period = K.r(9, 13), Base = 0.2, Peak = 0 })
		hexCol(pos + cf.RightVector * s * K.r(9, 11) + cf.LookVector * K.r(-2, 2), K.r(2.4, 3), K.r(3, 7), rockCol(), false)
	end
	if glow then
		local g = K.block(cf * CF(0, 7.5, 0.2), V3(7.6, 12, 0.3), LAVA_HOT, M.Neon, false, 0.35)
		K.tag(g, "TPFC_Pulse", { Period = 6, Base = 0.35, Peak = 0.15 })
		K.lamp(g, LAVA, 24, 1.4)
	end
	if banner then
		local b = K.block(cf * CF(0, 9.5, 0), V3(4, 7, 0.2), C(158, 30, 34), M.Fabric)
		K.tag(b, "TPFC_Sway", { Amp = 0.02, Period = 6 })
		K.block(cf * CF(0, 10, -0.13) * ANG(0, 0, PI / 4), V3(1.4, 1.4, 0.1), GOLD, M.Neon)
		K.block(cf * CF(0, 13.2, 0), V3(5.2, 0.4, 0.4), GOLD, M.Metal)
		K.wedge(cf * CF(-1, 5.5, 0) * ANG(0, PI / 2, PI), V3(0.2, 1, 2), C(158, 30, 34), M.Fabric)
		K.wedge(cf * CF(1, 5.5, 0) * ANG(0, -PI / 2, PI), V3(0.2, 1, 2), C(158, 30, 34), M.Fabric)
	end
end

-- jagged spiky peak: faceted cone + offset secondary cone + optional snow cap
local function peak(pos, w, h, col, snowy)
	K.cone(pos, w * 0.6, h, 7, col, K.dark(col, 0.18), M.Basalt, true)
	K.cone(pos + V3(K.r(-0.3, 0.3) * w, 0, K.r(-0.3, 0.3) * w), w * 0.42, h * K.r(0.6, 0.8), 6, K.light(col, 0.08), col, M.Basalt)
	if snowy then K.cone(pos + V3(0, h * 0.68, 0), w * 0.2, h * 0.32, 6, C(236, 242, 250), C(214, 224, 238), M.Snow) end
end

-- VL1: the giant volcano (centre c): faceted cone, inner jagged cone, crater rim spikes, two lava rivers
local function volcano(c)
	local R, H = 62, 104
	K.cone(c, R, H, 10, BASALT, DARK, M.Basalt, true)
	K.cone(c + V3(6, 0, -4), R * 0.7, H * 1.02, 8, HILITE, BASALT, M.Basalt)
	K.cone(c + V3(-10, 0, 12), R * 0.55, H * 0.8, 7, rockCol(), DARK, M.Basalt)
	local top = H - 9
	for i = 0, 9 do
		local a = i / 10 * PI * 2
		K.cone(c + V3(math.cos(a) * 9, top - 4, math.sin(a) * 8), K.r(3, 5), K.r(9, 16), 5, DARK, BASALT, M.Basalt)
	end
	local crater = K.block(CF(c + V3(0, top + 0.5, 0)), V3(14, 1, 12), LAVA_HOT, M.Neon)
	K.lamp(crater, LAVA, 70, 2.2)
	K.tag(crater, "TPFC_Pulse", { Period = 7, Base = 0, Peak = 0.2 })
	local plume = K.block(CF(c + V3(0, top + 6, 0)), V3(6, 1, 6), DARK, M.Basalt, false, 1)
	smoke(plume, 4, 18)
	-- two lava rivers flowing down the lane-facing facets (+X design side), crust edges beside them
	for k = 0, 1 do
		local a = (k == 0) and -0.25 or 0.3
		local dir = V3(math.cos(a), 0, math.sin(a))
		local p0 = c + V3(0, top, 0) + dir * 6
		local p1 = c + dir * (R * 0.98) + V3(0, 1, 0)
		local n = 8
		for i = 0, n - 1 do
			local a0 = p0:Lerp(p1, i / n) + V3(math.sin(i * 1.3) * 1.5, 1.4, 0)
			local a1 = p0:Lerp(p1, (i + 1) / n) + V3(math.sin((i + 1) * 1.3) * 1.5, 1.4, 0)
			local w = 2.2 + i * 0.45
			K.block(CF((a0 + a1) / 2, a1), V3(w, 0.8, (a1 - a0).Magnitude + 0.6), LAVA, M.Neon)
			K.block(CF((a0 + a1) / 2, a1) * CF(0, -0.35, 0), V3(w + 1.6, 0.8, (a1 - a0).Magnitude + 0.6), K.dark(DARK, 0.2), M.Basalt)
		end
	end
	return top
end

function B.Build(b)
	K.Seed(2002)
	K.ResetSurfaces()
	K.mirror = true
	local z1, z2 = b[1], b[2]
	---------------------------------------------------------------- terraces: layered basalt, hex-column fronts
	K.terraces(z1, z2, {
		rock = BASALT, rockMat = M.Basalt, cap = ASH, capMat = M.Basalt, drip = false, tiers = 2,
		h1 = { 1.5, 3 }, h2 = { 4, 8 },
		skip = { { -1, 196, 300 } },
		facade = function(s, x1, top, za, zb)
			local z = za
			while z < zb - 1 do
				local l = math.min(K.r(3, 5.5), zb - z)
				hexCol(V3(s * (x1 + 1.2), -0.5, z + l / 2), l * 0.95, top + 0.5 + K.r(-0.3, 0.8), rockCol(), K.chance(0.25))
				z += l
			end
		end,
	})
	---------------------------------------------------------------- VL1 volcano + VL2 lavafall cliff and pool
	volcano(V3(-142, 0, 296))
	for _ = 1, 7 do peak(V3(-K.r(150, 190), 0, K.r(170, 350)), K.r(26, 40), K.r(60, 110), rockCol(), false) end
	local cx, cz = -72, 232
	K.block(CF(cx - 6, 15, cz), V3(18, 30, 26), rockCol(), M.Basalt, true)
	for _ = 0, 4 do K.wedge(CF(cx - 6 + K.r(-6, 6), 31.5, cz + K.r(-10, 10)) * ANG(0, K.r(0, PI), 0), V3(K.r(5, 8), K.r(3, 6), K.r(4, 7)), DARK, M.Basalt) end
	local topP, botP = V3(cx + 3, 29, cz), V3(cx + 7.5, 0.6, cz)
	local sheetCF = CF((topP + botP) / 2, botP) * ANG(PI / 2, 0, 0)
	local len = (topP - botP).Magnitude
	K.block(sheetCF, V3(9, len, 1.6), LAVA, M.Neon)
	K.block(sheetCF * CF(0, 0, -0.85), V3(3, len, 0.2), LAVA_HOT, M.Neon)
	for s = -1, 1, 2 do K.block(sheetCF * CF(s * 4.9, 0, 0), V3(1.2, len, 2.2), C(120, 40, 20), M.Basalt) end
	local pool = K.block(CF(-54, 0.22, cz), V3(16, 0.44, 24), LAVA, M.Neon)
	K.lamp(pool, LAVA, 40, 1.6)
	K.tag(pool, "TPFC_Pulse", { Period = 6, Base = 0.05, Peak = 0 })
	K.block(CF(-54, 0.12, cz), V3(19, 0.24, 27), DARK, M.Basalt)
	smoke(pool, 1, 8)
	for i = 1, 5 do hexCol(V3(-54 + K.r(-7, 7), 0, cz + (i % 2 == 0 and 14 or -14)), K.r(2.4, 3.2), K.r(1.5, 3.5), rockCol(), false) end
	---------------------------------------------------------------- VL3 colonnades, VL4 swirl plates, VL5 plants, VL6 arch
	colonnade(V3(-64, 0, 178), 12, 8, 6, 20)
	colonnade(V3(-60, 0, 312), 10, 7, 5, 16)
	colonnade(V3(-88, 0, 200), 8, 6, 10, 26)
	swirl(V3(-46, 0, 194), 1.1)
	swirl(V3(-50, 0, 210), 0.8)
	swirl(V3(-44, 0, 262), 0.9)
	goldArch(V3(-56, 0, 258), PI / 2 - 0.35, true, false)
	for _ = 1, 9 do redPlant(V3(-K.r(40, 48), 0, K.r(170, 340)), K.r(0.9, 1.4)) end
	---------------------------------------------------------------- RIGHT: vents, banner arch, colonnades, plants, shards, snowy peaks
	vent(K.at(52, 198), 1.3)
	vent(K.at(56, 262), 1.6)
	vent(K.at(50, 318), 1.1)
	goldArch(K.at(58, 236), -PI / 2 + 0.35, false, true)
	colonnade(K.at(74, 180), 8, 6, 6, 16)
	colonnade(K.at(80, 290), 10, 8, 8, 22)
	for _ = 1, 9 do redPlant(V3(K.r(40, 46), 0, K.r(160, 345)), K.r(0.9, 1.4)) end
	for _ = 1, 6 do shards(K.at(K.r(50, 66), K.r(170, 340)), K.r(0.8, 1.2)) end
	for _ = 1, 8 do redPlant(K.at(K.r(50, 72), K.r(165, 345)), K.r(0.9, 1.3)) end
	for i = 1, 6 do peak(V3(K.r(140, 185), 0, K.r(300, 400)), K.r(28, 40), K.r(70, 120), C(120, 124, 140), i % 2 == 0) end
	for _ = 1, 3 do peak(V3(K.r(140, 180), 0, K.r(170, 290)), K.r(26, 36), K.r(55, 90), rockCol(), false) end
	---------------------------------------------------------------- distant broken arched bridge (side spans only)
	for s = -1, 1, 2 do
		for k = 0, 1 do K.block(CF(s * (54 + k * 16), 11, 336), V3(5, 22, 7), BASALT, M.Basalt, true) end
		K.arch(CF(s * 62, 0, 336), 11, 15, 6, BASALT, M.Basalt, nil, nil, 7)
		K.block(CF(s * 60, 24, 336), V3(26, 2.4, 8), DARK, M.Basalt)
		for k = 0, 2 do K.block(CF(s * (47.5 - k * 1.2), 24 - k * 1.6, 336) * ANG(0, 0, s * 0.3), V3(2.6, 2, 7), DARK, M.Basalt) end
	end
	---------------------------------------------------------------- CENTRE: slab road seams, curb, crack network
	for s = -1, 1, 2 do
		K.block(CF(s * 35.5, 0.3, (z1 + z2) / 2), V3(3, 0.6, z2 - z1), DARK, M.Basalt)
		K.block(CF(s * 33.8, 0.34, (z1 + z2) / 2), V3(0.4, 0.68, z2 - z1), ASH, M.Basalt)
	end
	-- dark basalt slab road (flush tiles with seams; landing still hits the terrain underneath)
	for z = z1 + 1, z2 - 13, 14 do
		for x = -27.5, 27.5, 11 do
			K.block(CF(x + K.r(-0.15, 0.15), 0.18, z + 7), V3(10.7, 0.3, 13.7), C(62, 54, 60):Lerp(C(78, 68, 74), K.r(0, 1)), M.Slate)
		end
	end
	for _ = 1, 8 do cracks(V3(K.r(-24, 24), 0, K.r(z1 + 15, z2 - 15)), K.ri(2, 3), K.r(3, 6)) end
	---------------------------------------------------------------- transition to Frozen: cooled rock + frost (z 330..350)
	for s = -1, 1, 2 do
		for _ = 1, 3 do
			local p = V3(s * K.r(40, 52), 0, K.r(334, 348))
			K.rockMass(p, K.r(4, 6), K.r(2.5, 4.5), K.r(4, 6), C(110, 116, 132), M.Slate, 2)
			K.block(CF(p + V3(0, 3.2, 0)), V3(3.6, 0.5, 3.6), C(236, 244, 252), M.Snow)
		end
	end
	K.mirror = false
end

return B
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- DataService: DataStore saving with session locking, retries, autosave and BindToClose.
-- Location: ServerScriptService > Server > DataService (ModuleScript)

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local DataService = {}
DataService.Profiles = {} -- [player] = data table

local STORE_NAME = "TPFC_PlayerData_v1"
local LOCK_TIMEOUT = 300
local store
-- Explicit Studio test sessions use temporary profiles and never acquire a live save lock.
local isolatedStudioTest = game:GetService("RunService"):IsStudio()
	and (workspace:FindFirstChild("AutoTest") ~= nil or workspace:FindFirstChild("SanctuaryTest") ~= nil or workspace:GetAttribute("SanctuaryTest") == true)
local storeOk = not isolatedStudioTest and pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)
if isolatedStudioTest then
	print("[DataService] Isolated Studio test: in-memory profiles; saving disabled.")
elseif not storeOk then
	warn("[DataService] DataStores unavailable (enable Studio API access). Using temporary data.")
end

local function defaultData()
	return {
		Money = 50,
		Strength = 0,
		OwnedEquipment = { ["1"] = true },  -- (old system, kept for save compatibility)
		EquipLevel = 1,                     -- your personal gym's equipment level (1-5)
		TotalEarned = 0,
		Upgrades = { ThrowPower = 1, BaseSlots = 0, Storage = 0, Training = 0 },
		OwnedPortals = { Basic = true },
		EquippedPortal = "Basic",
		Creatures = {},        -- array of { u = uid, c = creatureId }
		Placed = {},           -- array of uids placed in base
		Discovered = {},       -- [creatureId] = true
		UnlockedWorlds = { Forest = true },
		Decor = {},            -- [decorId] = true
		FloorTheme = "Meadow",
		OwnedFloors = { Meadow = true },
		Uncollected = 0,
		NextUid = 1,
		LastOnline = 0,
		Throws = 0,
	}
end

local function reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			data[k] = (type(v) == "table") and table.clone(v) or v
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil and #v == 0 then
			reconcile(data[k], v)
		end
	end
	return data
end

local function retry(fn, tries)
	local lastErr
	for i = 1, tries or 4 do
		local ok, res = pcall(fn)
		if ok then return true, res end
		lastErr = res
		task.wait(1.5 * i)
	end
	return false, lastErr
end

function DataService.Load(player: Player)
	local key = "u_" .. player.UserId
	local data
	if store then
		local loaded
		for attempt = 1, 4 do
			local ok, err = retry(function()
				store:UpdateAsync(key, function(old)
					old = old or {}
					local lock = old._lock
					if lock and lock.job ~= game.JobId and os.time() - lock.t < LOCK_TIMEOUT and attempt < 4 then
						loaded = "locked"
						return nil -- abort write, someone else holds the session
					end
					old._lock = { job = game.JobId, t = os.time() }
					loaded = old
					return old
				end)
			end)
			if not ok then warn("[DataService] load failed:", err); break end
			if loaded ~= "locked" then break end
			task.wait(4) -- previous server still saving; wait and retry (steals lock on last attempt)
		end
		if type(loaded) == "table" then data = loaded end
	end
	if not player.Parent then return nil end
	data = reconcile(data or {}, defaultData())
	data._lock = nil
	DataService.Profiles[player] = data
	return data
end

function DataService.Save(player: Player, release: boolean?)
	local data = DataService.Profiles[player]
	if not data or not store then return end
	data.LastOnline = os.time()
	local key = "u_" .. player.UserId
	local ok, err = retry(function()
		store:UpdateAsync(key, function(old)
			local copy = table.clone(data)
			copy._lock = (not release) and { job = game.JobId, t = os.time() } or nil
			return copy
		end)
	end, 3)
	if not ok then warn("[DataService] save failed for", player.Name, err) end
end

DataService.Default = defaultData

function DataService.Get(player: Player)
	return DataService.Profiles[player]
end

function DataService.Release(player: Player)
	DataService.Save(player, true)
	DataService.Profiles[player] = nil
end

function DataService.NewUid(data)
	local u = data.NextUid
	data.NextUid += 1
	return u
end

-- autosave loop
task.spawn(function()
	while true do
		task.wait(60)
		for _, p in ipairs(Players:GetPlayers()) do
			task.spawn(DataService.Save, p, false)
		end
	end
end)

game:BindToClose(function()
	local threads = 0
	for _, p in ipairs(Players:GetPlayers()) do
		threads += 1
		task.spawn(function()
			DataService.Save(p, true)
			threads -= 1
		end)
	end
	local start = os.clock()
	while threads > 0 and os.clock() - start < 25 do task.wait(0.2) end
end)

return DataService
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX30"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- GameServer: authoritative game logic (throwing, rolling, collecting, income, shop, upgrades).
-- Location: ServerScriptService > Server > GameServer (Script)
-- The client only sends *requests*; every price, cooldown, distance and roll is decided here.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CreatureData = require(Shared.CreatureData)
local Format = require(Shared.Format)
local Odds = require(Shared.Odds)
local DataService = require(script.Parent.DataService)
local WorldBuilder = require(script.Parent.WorldBuilder)
local BaseBuilder = require(script.Parent.BaseBuilder)

---------------------------------------------------------------- remotes
local Remotes = Instance.new("Folder")
Remotes.Name = "Remotes"
local function RE(name) local r = Instance.new("RemoteEvent"); r.Name = name; r.Parent = Remotes; return r end
local ThrowRE = RE("Throw")
local SyncRE = RE("Sync")
local PortalThrownRE = RE("PortalThrown")
local PortalOpenedRE = RE("PortalOpened")
local CreatureGoneRE = RE("CreatureGone")
local NotifyRE = RE("Notify")
local MoneyFxRE = RE("MoneyFx")
local DepositRE = RE("Deposit")
local RequestRF = Instance.new("RemoteFunction"); RequestRF.Name = "Request"; RequestRF.Parent = Remotes
Remotes.Parent = ReplicatedStorage

---------------------------------------------------------------- world
-- sculpted pet meshes load in the background; species fall back to procedural models until ready
task.spawn(function()
	local ok, err = pcall(function() require(script.Parent.PetMeshLoader).Load() end)
	if not ok then warn("[GameServer] PetMeshLoader:", err) end
end)
BaseBuilder.BuildAll()
WorldBuilder.BuildAll()

---------------------------------------------------------------- state
local State = {}      -- [player] = { base, carry = {ids}, lastThrow, tokens, lastTokenT, dirty }
local Pending = {}    -- [throwId] = { owner, creature, pos, opened, world }
local nextThrowId = 0
local Actions = {}    -- request handlers (filled in below)

local function slotsOpen(data) return Config.StartSlots + data.Upgrades.BaseSlots end
local function storageCap(data) return Config.StartStorage + data.Upgrades.Storage * Config.StoragePerLevel end
local function trainingMult(data) return 1 + data.Upgrades.Training * Config.TrainingBonus end

local function findCreature(data, uid)
	for i, c in ipairs(data.Creatures) do
		if c.u == uid then return c, i end
	end
end
local function isPlaced(data, uid) return table.find(data.Placed, uid) ~= nil end

local function incomePerSec(data)
	local total = 0
	for _, uid in ipairs(data.Placed) do
		local c = findCreature(data, uid)
		if c then total += CreatureData.Income(c.c) end
	end
	return total * trainingMult(data)
end

local function storedCount(data) return #data.Creatures - #data.Placed end

local function freeSpace(player, data)
	local st = State[player]
	return (slotsOpen(data) - #data.Placed) + (storageCap(data) - storedCount(data)) - (st and #st.carry or 0)
end

local function updateAttributes(player, data)
	local ids = {}
	for _, uid in ipairs(data.Placed) do
		local c = findCreature(data, uid)
		if c then table.insert(ids, c.c) end
	end
	player:SetAttribute("BaseCreatures", HttpService:JSONEncode(ids))
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		ls.Money.Value = Format.Money(data.Money)
		ls.Creatures.Value = #data.Creatures
	end
end

local function sync(player, partial)
	local data = DataService.Get(player)
	if not data then return end
	local maxDist = Config.ThrowDistance(data.Upgrades.ThrowPower, data.Strength)
	if partial then
		SyncRE:FireClient(player, { Money = data.Money, Uncollected = data.Uncollected, Strength = data.Strength, MaxDistance = maxDist })
		return
	end
	local st = State[player]
	SyncRE:FireClient(player, {
		Money = data.Money, Uncollected = data.Uncollected, Upgrades = data.Upgrades,
		OwnedPortals = data.OwnedPortals, EquippedPortal = data.EquippedPortal,
		Creatures = data.Creatures, Placed = data.Placed, Discovered = data.Discovered,
		UnlockedWorlds = data.UnlockedWorlds, Decor = data.Decor, FloorTheme = data.FloorTheme, OwnedFloors = data.OwnedFloors,
		Income = incomePerSec(data), SlotsOpen = slotsOpen(data), StorageCap = storageCap(data),
		MaxDistance = maxDist, Strength = data.Strength, EquipLevel = data.EquipLevel,
		Carry = st and st.carry or {}, BaseIndex = st and st.base and st.base.index or 0,
	})
	updateAttributes(player, data)
end

local function notify(player, text, kind)
	NotifyRE:FireClient(player, text, kind or "info")
end

local function setCarry(player)
	local st = State[player]
	player:SetAttribute("Carry", table.concat(st.carry, ","))
end

---------------------------------------------------------------- rolling
local function rollCreature(portalId, worldId, dist)
	local portal = Config.Portals[portalId]
	local luck = Config.LuckFromDistance(dist)
	local pool = {}
	for _, c in ipairs(CreatureData.ByWorld[worldId] or {}) do table.insert(pool, c) end
	for _, c in ipairs(CreatureData.ByWorld.Any or {}) do table.insert(pool, c) end

	local total, entries = 0, {}
	for rarity, w in pairs(portal.weights) do
		local order = Config.Rarities[rarity].order
		local has = false
		for _, c in ipairs(pool) do if c.rarity == rarity then has = true break end end
		if has then
			local weight = w * luck ^ (math.max(0, order - 2) * 0.5)
			total += weight
			table.insert(entries, { rarity = rarity, w = weight })
		end
	end
	table.sort(entries, function(a, b) return Config.Rarities[a.rarity].order < Config.Rarities[b.rarity].order end)
	local r = math.random() * total
	local chosen = entries[1].rarity
	for _, e in ipairs(entries) do
		r -= e.w
		if r <= 0 then chosen = e.rarity break end
	end
	local candidates = {}
	for _, c in ipairs(pool) do if c.rarity == chosen then table.insert(candidates, c) end end
	return candidates[math.random(1, #candidates)].id
end

---------------------------------------------------------------- throwing
-- LANDING-SURFACE CONTRACT: the lane floor is Terrain. Landing queries only ever hit Terrain, so
-- floating islands, arches, props, gates and camera scenery can never be chosen as the floor
-- (previously a ray from y=150 could land a creature on a floating island above the lane).
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.FilterDescendantsInstances = { workspace.Terrain }
rayParams.IgnoreWater = false

local function groundAt(pos)
	local hit = workspace:Raycast(pos + Vector3.new(0, 150, 0), Vector3.new(0, -300, 0), rayParams)
	return hit and hit.Position or Vector3.new(pos.X, 0, pos.Z)
end

local function pendingCount(player)
	local n = 0
	for _, p in pairs(Pending) do if p.owner == player then n += 1 end end
	return n
end

ThrowRE.OnServerEvent:Connect(function(player, power, dir)
	local data, st = DataService.Get(player), State[player]
	if not data or not st then return end
	if typeof(power) ~= "number" or power ~= power or typeof(dir) ~= "Vector3" then return end
	if dir.X ~= dir.X or dir.Z ~= dir.Z then return end
	local now = os.clock()
	if now - st.lastThrow < Config.ThrowCooldown then return end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end
	if pendingCount(player) >= Config.MaxPendingPerPlayer then
		notify(player, "One portal at a time! Wait for your creature.", "error")
		return
	end
	if freeSpace(player, data) - pendingCount(player) <= 0 then
		notify(player, "Storage full! Upgrade storage or sell creatures.", "error")
		return
	end
	local origin = hrp.Position
	-- you throw from the start area, always down the lane (+Z)
	if not Config.InThrowZone(origin) then
		notify(player, "Stand on the THROW LINE to throw!", "throwzone")
		return
	end
	st.lastThrow = now
	data.Throws += 1

	power = math.clamp(power, 0.05, 1)
	local flat = Vector3.new(dir.X, 0, dir.Z)
	local side = 0
	if flat.Magnitude > 0.1 and flat.Unit.Z > 0.2 then side = flat.Unit.X / flat.Unit.Z end
	local perfect = power >= 0.92
	local dist = Config.ThrowDistance(data.Upgrades.ThrowPower, data.Strength) * power * (perfect and 1.15 or 1)
	dist = math.clamp(dist, 8, Config.LaneLength - 15)
	local lx = math.clamp(origin.X * 0.35 + side * dist * 0.35, -Config.LaneHalfWidth, Config.LaneHalfWidth)
	local landing = groundAt(Vector3.new(lx, 0, dist))
	local realDist = dist
	local worldId = Config.WorldAt(landing)
	local flight = math.clamp(0.7 + math.sqrt(realDist) * 0.07, 0.9, 4.5)

	nextThrowId += 1
	local id = nextThrowId
	local creatureId, chance = Odds.Roll(data.EquippedPortal, worldId, realDist)
	if st.forceNext and CreatureData.ById[st.forceNext] then -- admin: force the next creature
		creatureId = st.forceNext
		chance = Odds.Table(data.EquippedPortal, worldId, realDist)[creatureId] or 0.0001
		st.forceNext = nil
	end
	Pending[id] = { owner = player, creature = creatureId, pos = landing, opened = false, world = worldId }

	PortalThrownRE:FireAllClients({
		id = id, owner = player.UserId, portal = data.EquippedPortal,
		from = origin + Vector3.new(0, 1.5, 2), to = landing, t = flight, perfect = perfect, dist = realDist, zone = worldId,
	})
	task.delay(flight + 0.9, function()
		local p = Pending[id]
		if not p then return end
		p.opened = true
		local def = CreatureData.ById[creatureId]
		PortalOpenedRE:FireAllClients({ id = id, owner = player.UserId, creature = creatureId, pos = landing, portal = data.EquippedPortal, chance = chance })
		if Config.Rarities[def.rarity].order >= 5 then
			for _, other in ipairs(Players:GetPlayers()) do
				notify(other, player.DisplayName .. " found a " .. def.rarity:upper() .. " " .. def.name .. " (" .. Odds.OneIn(chance) .. ")!", def.rarity)
			end
		end
		-- caught automatically once its entrance animation has played
		task.delay(Config.CatchDelay[def.rarity] or 3, function()
			if Pending[id] and player.Parent and State[player] then
				local ok, msg = Actions.Collect(player, DataService.Get(player), State[player], id)
				if not ok and msg then notify(player, msg, "error") end
			end
		end)
	end)
	task.delay(flight + Config.PendingLifetime, function()
		if Pending[id] then
			Pending[id] = nil
			CreatureGoneRE:FireAllClients(id, "expired")
		end
	end)
end)

---------------------------------------------------------------- deposit + income loops
local function depositCarry(player, data, st, silent)
	if #st.carry == 0 then return end
	local newOnes = {}
	for _, cid in ipairs(st.carry) do
		local uid = DataService.NewUid(data)
		table.insert(data.Creatures, { u = uid, c = cid })
		if #data.Placed < slotsOpen(data) then table.insert(data.Placed, uid) end
		if not data.Discovered[cid] then
			data.Discovered[cid] = true
			local bonus = math.floor(CreatureData.Income(cid) * Config.DiscoveryBonus)
			data.Money += bonus
			if not silent then notify(player, "NEW to your index: " .. CreatureData.ById[cid].name .. "!  +" .. Format.Money(bonus), "discover") end
		end
		table.insert(newOnes, cid)
	end
	st.carry = {}
	setCarry(player)
	if not silent then DepositRE:FireClient(player, newOnes) end
	sync(player)
end

task.spawn(function()
	while true do
		task.wait(0.25)
		for player, st in pairs(State) do
			local data = DataService.Get(player)
			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			-- put the weight away when you stop lifting
			if st.prop and os.clock() - (st.lastTrain or 0) > 1.2 then
				st.prop:Destroy()
				st.prop = nil
			end
			if data and hrp and st.base then
				local bpos = st.base.cf.Position
				local flatD = ((hrp.Position - bpos) * Vector3.new(1, 0, 1)).Magnitude
				if #st.carry > 0 and flatD < Config.BaseRadius then
					depositCarry(player, data, st)
				end
				local pad = st.base.collect.Position
				if data.Uncollected >= 1 and ((hrp.Position - pad) * Vector3.new(1, 0, 1)).Magnitude < 5.5 and math.abs(hrp.Position.Y - pad.Y) < 8 then
					local amt = math.floor(data.Uncollected)
					data.Money += amt
					data.TotalEarned += amt
					data.Uncollected -= amt
					st.base.collectLabel.Text = "$0"
					MoneyFxRE:FireClient(player, amt, pad)
					sync(player, true)
					updateAttributes(player, data)
				end
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(1)
		for player, st in pairs(State) do
			local data = DataService.Get(player)
			if data then
				data.Uncollected += incomePerSec(data)
				if st.base then
					st.base.collectLabel.Text = Format.Money(data.Uncollected)
					st.base.incomeLabel.Text = "+" .. Format.Money(incomePerSec(data)) .. "/s  •  " .. #data.Placed .. "/" .. slotsOpen(data) .. " pets"
				end
				sync(player, true)
			end
		end
	end
end)

---------------------------------------------------------------- requests
-- (Actions table is declared near the top so the throw handler can use it)

function Actions.Collect(player, data, st, throwId)
	local p = Pending[throwId]
	if not p or p.owner ~= player or not p.opened then return false, "Nothing to collect" end
	-- caught! it goes straight into your inventory (and into a free base slot, where it roams)
	if freeSpace(player, data) <= 0 then return false, "Storage full! Sell creatures or upgrade storage." end
	Pending[throwId] = nil
	CreatureGoneRE:FireAllClients(throwId, "collected", player.UserId)
	table.insert(st.carry, p.creature)
	depositCarry(player, data, st)
	return true
end

function Actions.BuyPortal(player, data, st, id)
	local P = Config.Portals[id]
	if not P then return false, "Unknown portal" end
	if data.OwnedPortals[id] then return false, "Already owned" end
	if data.Money < P.price then return false, "Not enough money" end
	data.Money -= P.price
	data.OwnedPortals[id] = true
	data.EquippedPortal = id
	return true
end

function Actions.EquipPortal(player, data, st, id)
	if not data.OwnedPortals[id] then return false, "Not owned" end
	data.EquippedPortal = id
	return true
end

function Actions.Upgrade(player, data, st, kind)
	local U = Config.Upgrades[kind]
	if not U then return false, "Unknown upgrade" end
	local lvl = data.Upgrades[kind]
	local idx = (kind == "ThrowPower") and lvl - 1 or lvl
	if idx >= U.max then return false, "Max level!" end
	local cost = Config.UpgradeCost(kind, idx)
	if data.Money < cost then return false, "Not enough money" end
	data.Money -= cost
	data.Upgrades[kind] = lvl + 1
	if (kind == "Training" or kind == "BaseSlots") and st.base then BaseBuilder.Refresh(st.base, data) end
	if kind == "BaseSlots" then
		-- auto-fill the new slot from storage
		for _, c in ipairs(data.Creatures) do
			if #data.Placed >= slotsOpen(data) then break end
			if not isPlaced(data, c.u) then table.insert(data.Placed, c.u) end
		end
	end
	return true
end

function Actions.UnlockWorld(player, data, st, id)
	local W = Config.Worlds[id]
	if not W then return false, "Unknown world" end
	if data.UnlockedWorlds[id] then return false, "Already unlocked" end
	local prev = Config.WorldOrder[W.index - 1]
	if prev and not data.UnlockedWorlds[prev] then return false, "Unlock " .. Config.Worlds[prev].name .. " first" end
	if data.Upgrades.ThrowPower < W.throwLevel then return false, "Need Throw Power Lv." .. W.throwLevel end
	if data.Money < W.cost then return false, "Not enough money" end
	data.Money -= W.cost
	data.UnlockedWorlds[id] = true
	return true
end

function Actions.Teleport(player, data, st, id)
	local char = player.Character
	if not char then return false, "No character" end
	if id == "Home" then
		if st.base then char:PivotTo(st.base.spawnCF) end
		return true
	end
	return false, "Walk down the lane to explore!"
end

---------------------------------------------------------------- training
-- the weight appears in your hand while you lift (made on the server so everyone sees it)
local function liftProp(player, st, index)
	local char = player.Character
	local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"))
	if not hand then return end
	if st.prop and st.prop.Parent and st.propIndex == index then return end
	if st.prop then st.prop:Destroy() end
	local station = Config.TrainingStations[index]
	local model = Instance.new("Model")
	model.Name = "LiftProp"
	local s = 0.8 + index * 0.18
	local function p(shape, size, color, mat)
		local part = Instance.new("Part")
		part.Shape = shape
		part.Size = size
		part.Color = color
		part.Material = mat or Enum.Material.Metal
		part.CanCollide, part.CanQuery, part.CanTouch, part.Massless = false, false, false, true
		part.Parent = model
		return part
	end
	-- the held prop matches the owned equipment (dumbbell / barbell / kettlebell / crystal / gravity core)
	local function attachTo(part0, part1, c0)
		local w = Instance.new("Weld"); w.Part0 = part0; w.Part1 = part1; w.C0 = c0; w.Parent = part1
	end
	local barCol = index == 1 and Color3.fromRGB(150, 105, 60) or Color3.fromRGB(70, 70, 80)
	local bar = p(Enum.PartType.Cylinder, Vector3.new((index == 3 and 1.2 or 2.6) * s, 0.3, 0.3), barCol, index == 1 and Enum.Material.Wood or Enum.Material.Metal)
	if index == 1 then
		for side = -1, 1, 2 do attachTo(bar, p(Enum.PartType.Ball, Vector3.new(1, 1, 1) * s, station.color, Enum.Material.Wood), CFrame.new(side * 1.1 * s, 0, 0)) end
	elseif index == 2 then
		for side = -1, 1, 2 do
			for k = 0, 1 do
				attachTo(bar, p(Enum.PartType.Cylinder, Vector3.new(0.22 * s, (1.4 - k * 0.35) * s, (1.4 - k * 0.35) * s), Color3.fromRGB(55, 58, 66)), CFrame.new(side * (0.95 + k * 0.24) * s, 0, 0))
			end
		end
	elseif index == 3 then
		local bell = p(Enum.PartType.Ball, Vector3.new(1.5, 1.5, 1.5) * s, station.color)
		attachTo(bar, bell, CFrame.new(0, -0.95 * s, 0))
		for side = -1, 1, 2 do attachTo(bar, p(Enum.PartType.Cylinder, Vector3.new(0.7 * s, 0.25, 0.25), station.color), CFrame.new(side * 0.6 * s, -0.35 * s, 0) * CFrame.Angles(0, 0, side * 1.2)) end
	elseif index == 4 then
		for side = -1, 1, 2 do
			local crystal = p(Enum.PartType.Block, Vector3.new(0.4, 1.1, 1.1) * s, station.color, Enum.Material.Glass)
			crystal.Transparency = 0.15
			attachTo(bar, crystal, CFrame.new(side * 1.1 * s, 0, 0) * CFrame.Angles(math.rad(45), 0, 0))
			attachTo(bar, p(Enum.PartType.Block, Vector3.new(0.42, 0.15, 0.9) * s, Color3.fromRGB(220, 200, 255), Enum.Material.Neon), CFrame.new(side * 1.1 * s, 0, 0) * CFrame.Angles(math.rad(45), 0, 0))
		end
	else
		local core = p(Enum.PartType.Ball, Vector3.new(1.1, 1.1, 1.1) * s, Color3.new(1, 1, 1), Enum.Material.Neon)
		attachTo(bar, core, CFrame.identity)
		for k = 1, 2 do attachTo(bar, p(Enum.PartType.Cylinder, Vector3.new(0.1, 1.9 * s, 1.9 * s), station.color, Enum.Material.Neon), CFrame.Angles(k * 0.9, k * 0.6, 0)) end
	end
	if index == 5 then
		local fx = Instance.new("ParticleEmitter")
		fx.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		fx.Color = ColorSequence.new(station.color); fx.Rate = 20; fx.LightEmission = 1
		fx.Size = NumberSequence.new(0.4, 0); fx.Speed = NumberRange.new(1, 2); fx.Parent = bar
	end
	local w = Instance.new("Weld")
	w.Part0 = hand
	w.Part1 = bar
	w.C0 = CFrame.new(0, -hand.Size.Y / 2, 0) * CFrame.Angles(0, math.rad(90), 0)
	w.Parent = bar
	model.Parent = char
	st.prop, st.propIndex = model, index
end

-- PERSONAL GYM: lift in your own base's gym
function Actions.Train(player, data, st)
	if not st.base then return false, "You don't have a base" end
	local level = math.clamp(data.EquipLevel or 1, 1, #Config.TrainingStations)
	local station = Config.TrainingStations[level]
	local gymPos = (st.base.cf * CFrame.new(Config.GymOffset)).Position
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp or ((hrp.Position - gymPos) * Vector3.new(1, 0, 1)).Magnitude > Config.TrainRange + 2 then return false, "Stand in your gym" end
	local now = os.clock()
	if now - (st.lastTrain or 0) < Config.TrainCooldown * 0.9 then return false, nil end
	st.lastTrain = now
	data.Strength += station.gain
	liftProp(player, st, level)
	return true, nil, "partial"
end

-- buy the next piece of equipment for your gym
function Actions.UpgradeEquipment(player, data, st)
	local level = data.EquipLevel or 1
	local nextStation = Config.TrainingStations[level + 1]
	if not nextStation then return false, "Your gym is maxed out!" end
	if data.Money < nextStation.price then return false, "Not enough money (" .. Format.Money(nextStation.price) .. ")" end
	data.Money -= nextStation.price
	data.EquipLevel = level + 1
	if st.base then BaseBuilder.Refresh(st.base, data) end
	return true, "Gym upgraded: " .. nextStation.name .. "! +" .. nextStation.gain .. " Strength per lift"
end

---------------------------------------------------------------- admin
local RunService = game:GetService("RunService")
local function isAdmin(player)
	if RunService:IsStudio() then return true end
	if table.find(Config.AdminIds, player.UserId) then return true end
	if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then return true end
	if game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
		if ok and rank >= 254 then return true end
	end
	return false
end

local AdminCmds = {}
function AdminCmds.money(player, data, st, v) data.Money = math.max(0, data.Money + (tonumber(v) or 0)); return true, "Money changed" end
function AdminCmds.strength(player, data, st, v) data.Strength = math.max(0, data.Strength + (tonumber(v) or 0)); return true, "Strength changed" end
function AdminCmds.throwlevel(player, data, st, v)
	data.Upgrades.ThrowPower = math.clamp(math.floor(tonumber(v) or 1), 1, Config.Upgrades.ThrowPower.max + 1)
	return true, "Throw Power set"
end
function AdminCmds.maxupgrades(player, data, st)
	data.Upgrades.ThrowPower = Config.Upgrades.ThrowPower.max + 1
	for _, k in ipairs({ "BaseSlots", "Storage", "Training" }) do data.Upgrades[k] = Config.Upgrades[k].max end
	if st.base then BaseBuilder.Refresh(st.base, data) end
	return true, "All upgrades maxed"
end
function AdminCmds.allportals(player, data, st)
	for id in pairs(Config.Portals) do data.OwnedPortals[id] = true end
	return true, "All portals unlocked"
end
function AdminCmds.give(player, data, st, id)
	if not CreatureData.ById[id] then return false, "Unknown creature" end
	local uid = DataService.NewUid(data)
	table.insert(data.Creatures, { u = uid, c = id })
	data.Discovered[id] = true
	if #data.Placed < slotsOpen(data) then table.insert(data.Placed, uid) end
	return true, "Gave " .. CreatureData.ById[id].name
end
function AdminCmds.forcenext(player, data, st, id)
	if not CreatureData.ById[id] then return false, "Unknown creature id" end
	st.forceNext = id
	return true, "Your next throw will be " .. CreatureData.ById[id].name
end
function AdminCmds.discoverall(player, data, st)
	for _, c in ipairs(CreatureData.List) do data.Discovered[c.id] = true end
	return true, "Index completed"
end
function AdminCmds.zone(player, data, st, id)
	if id ~= "Start" and not Config.ZoneBounds[id] then return false, "Unknown zone" end
	local char = player.Character
	if not char then return false, "No character" end
	local pos = id == "Start" and Vector3.new(0, 5, -60) or (Config.WorldCenter(id) + Vector3.new(0, 5, 0))
	char:PivotTo(CFrame.new(pos))
	return true, "Teleported"
end
function AdminCmds.speed(player, data, st, v)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then hum.WalkSpeed = math.clamp(tonumber(v) or 16, 8, 300) end
	return true, "WalkSpeed set"
end
function AdminCmds.reset(player, data, st)
	local keep = data.NextUid
	for k in pairs(data) do data[k] = nil end
	local fresh = DataService.Default()
	for k, v in pairs(fresh) do data[k] = v end
	data.NextUid = keep
	st.carry = {}
	setCarry(player)
	if st.base then BaseBuilder.Refresh(st.base, data) end
	return true, "Your data was reset"
end

function Actions.Admin(player, data, st, json)
	if not isAdmin(player) then return false, "Not an admin" end
	local ok, req = pcall(HttpService.JSONDecode, HttpService, tostring(json))
	if not ok or type(req) ~= "table" or type(req.cmd) ~= "string" then return false, "Bad admin request" end
	local fn = AdminCmds[req.cmd]
	if not fn then return false, "Unknown command" end
	return fn(player, data, st, req.value)
end

function Actions.Place(player, data, st, uid)
	if not findCreature(data, uid) or isPlaced(data, uid) then return false, "Can't place" end
	if #data.Placed >= slotsOpen(data) then return false, "Base is full! Buy more slots." end
	table.insert(data.Placed, uid)
	return true
end

function Actions.Unplace(player, data, st, uid)
	local i = table.find(data.Placed, uid)
	if not i then return false, "Not placed" end
	if storedCount(data) >= storageCap(data) then return false, "Storage full" end
	table.remove(data.Placed, i)
	return true
end

function Actions.Sell(player, data, st, uid)
	local c, i = findCreature(data, uid)
	if not c then return false, "Not found" end
	local price = math.floor(CreatureData.Income(c.c) * Config.SellMultiplier)
	table.remove(data.Creatures, i)
	local pi = table.find(data.Placed, uid)
	if pi then table.remove(data.Placed, pi) end
	data.Money += price
	return true, "Sold for " .. Format.Money(price)
end

function Actions.EquipBest(player, data, st)
	local list = table.clone(data.Creatures)
	table.sort(list, function(a, b) return CreatureData.Income(a.c) > CreatureData.Income(b.c) end)
	local n = math.min(#list, slotsOpen(data))
	if #list - n > storageCap(data) then return false, "Storage full" end
	data.Placed = {}
	for i = 1, n do table.insert(data.Placed, list[i].u) end
	return true
end

function Actions.BuyDecor(player, data, st, id)
	local D = Config.Decor[id]
	if not D then return false, "Unknown" end
	if data.Decor[id] then return false, "Owned" end
	if data.Money < D.price then return false, "Not enough money" end
	data.Money -= D.price
	data.Decor[id] = true
	if st.base then BaseBuilder.Refresh(st.base, data) end
	return true
end

function Actions.Floor(player, data, st, id)
	local theme
	for _, t in ipairs(Config.FloorThemes) do if t.id == id then theme = t end end
	if not theme then return false, "Unknown" end
	if not data.OwnedFloors[id] then
		if data.Money < theme.price then return false, "Not enough money" end
		data.Money -= theme.price
		data.OwnedFloors[id] = true
	end
	data.FloorTheme = id
	if st.base then BaseBuilder.Refresh(st.base, data) end
	return true
end

RequestRF.OnServerInvoke = function(player, action, arg)
	local data, st = DataService.Get(player), State[player]
	if not data or not st then return false, "Loading..." end
	-- token bucket rate limit: 8 requests / second
	local now = os.clock()
	st.tokens = math.min(8, st.tokens + (now - st.lastTokenT) * 8)
	st.lastTokenT = now
	if st.tokens < 1 then return false, "Slow down!" end
	st.tokens -= 1
	local fn = typeof(action) == "string" and Actions[action]
	if not fn then return false, "Bad request" end
	if arg ~= nil and typeof(arg) ~= "string" and typeof(arg) ~= "number" then return false, "Bad argument" end
	local ok, res, msg, mode = pcall(fn, player, data, st, arg)
	if not ok then warn("[GameServer] action error", action, res); return false, "Error" end
	if res then sync(player, mode == "partial") end
	return res, msg
end

---------------------------------------------------------------- players
local function onCharacter(player, char)
	local st = State[player]
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	if hrp and st and st.base then
		task.wait(0.1)
		char:PivotTo(st.base.spawnCF)
	end
end

local function onPlayerAdded(player)
	local ls = Instance.new("Folder"); ls.Name = "leaderstats"
	local m = Instance.new("StringValue"); m.Name = "Money"; m.Value = "$0"; m.Parent = ls
	local c = Instance.new("IntValue"); c.Name = "Creatures"; c.Parent = ls
	ls.Parent = player

	local data = DataService.Load(player)
	if not data or not player.Parent then return end
	-- carry over equipment bought under the old shared-station system
	for i = #Config.TrainingStations, 1, -1 do
		if data.OwnedEquipment and data.OwnedEquipment[tostring(i)] then
			data.EquipLevel = math.max(data.EquipLevel or 1, i)
			break
		end
	end
	local base = BaseBuilder.Claim(player)
	State[player] = { base = base, carry = {}, lastThrow = 0, tokens = 8, lastTokenT = os.clock() }
	player:SetAttribute("BaseIndex", base and base.index or 0)
	player:SetAttribute("IsAdmin", isAdmin(player))
	setCarry(player)
	if base then BaseBuilder.Refresh(base, data) end

	-- offline earnings
	if data.LastOnline > 0 then
		local away = math.clamp(os.time() - data.LastOnline, 0, Config.OfflineCapSeconds)
		local earned = math.floor(incomePerSec(data) * away * Config.OfflineRate)
		if earned > 0 then
			data.Uncollected += earned
			task.delay(4, notify, player, "Welcome back! Your creatures earned " .. Format.Money(earned) .. " while you were away. Collect it at your base!", "money")
		end
	end
	player.CharacterAdded:Connect(function(ch) onCharacter(player, ch) end)
	if player.Character then task.spawn(onCharacter, player, player.Character) end
	sync(player)
	player:SetAttribute("Loaded", true)
end
Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onPlayerAdded, p) end

Players.PlayerRemoving:Connect(function(player)
	local st = State[player]
	local data = DataService.Get(player)
	if st and data then
		depositCarry(player, data, st, true) -- never lose carried creatures
		if st.base then BaseBuilder.Release(st.base) end
	end
	for id, p in pairs(Pending) do
		if p.owner == player then Pending[id] = nil; CreatureGoneRE:FireAllClients(id, "expired") end
	end
	State[player] = nil
	DataService.Release(player)
end)

-- Client asks for a full sync once its UI is ready
RequestRF:SetAttribute("Ready", true)
Actions.Sync = function(player) return true end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">PetMeshLoader</string><ProtectedString name="Source"><![CDATA[-- PetMeshLoader: builds ReplicatedStorage.PetMeshes/<CreatureId>/<role> MeshPart templates from the
-- asset ids in PetMeshManifest, so the client CreatureBuilder can use sculpted meshes.
-- Location: ServerScriptService > Server > PetMeshLoader (ModuleScript)
-- If a mesh can't be created (offline, permissions), that species simply keeps the procedural model.

local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Manifest = require(ReplicatedStorage.Shared.PetMeshManifest)

local Loader = {}

function Loader.Load()
	local folder = ReplicatedStorage:FindFirstChild("PetMeshes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "PetMeshes"
		folder.Parent = ReplicatedStorage
	end
	for id, man in pairs(Manifest) do
		local existing = folder:FindFirstChild(id)
		local complete = existing ~= nil
		if existing then
			for _, pd in ipairs(man.parts) do if not existing:FindFirstChild(pd.role) then complete = false end end
		end
		if not complete then
			-- build off-tree, publish only when every part exists (clients never see half a pet)
			local model = Instance.new("Model")
			model.Name = id
			local ok = true
			for _, pd in ipairs(man.parts) do
				local success, mp = pcall(function()
					return AssetService:CreateMeshPartAsync(Content.fromUri(pd.mesh))
				end)
				if success and mp then
					mp.Name = pd.role
					mp.TextureID = pd.tex
					mp.Anchored = true
					mp.CanCollide, mp.CanQuery, mp.CanTouch = false, false, false
					mp.Parent = model
				else
					ok = false
					warn("[PetMeshLoader] mesh failed for", id, pd.role, mp)
					break
				end
			end
			if ok then
				if existing then existing:Destroy() end
				model.Parent = folder
			else
				model:Destroy()
			end
		end
	end
end

return Loader
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">SanctuaryArchitecture</string><ProtectedString name="Source"><![CDATA[-- Original block/wedge architecture matching Maps/00_Portal_Sanctuary_Hub.png.
-- Shared by the public sanctuary and the eight gardens. All decoration is non-queryable.
local K = require(script.Parent.WorldKit)
local Art = {}
local V, CF, A, PI = Vector3.new, CFrame.new, CFrame.Angles, math.pi
local M = Enum.Material
local C = Color3.fromRGB
Art.Palette = {
	ivory = C(227, 219, 205),
	light = C(243, 235, 219),
	stone = C(172, 158, 153),
	gold = C(202, 157, 74),
	goldLight = C(234, 196, 111),
	violet = C(87, 56, 135),
	roof = C(71, 49, 112),
	lilac = C(168, 109, 231),
	mint = C(104, 190, 184),
	grass = C(108, 161, 76),
	leaf = C(80, 133, 63),
	pink = C(200, 117, 165),
	water = C(93, 182, 203),
}
local P = Art.Palette

function Art.Beam(a, b, width, depth, color, material)
	local y = (b - a).Unit
	local normal = math.abs(y.Z) > 0.98 and V(1, 0, 0) or V(0, 0, 1)
	local x = y:Cross(normal).Unit
	local z = x:Cross(y).Unit
	return K.block(CFrame.fromMatrix((a + b) / 2, x, y, z), V(width, (b - a).Magnitude, depth), color, material)
end
function Art.Gable(cf, width, rise, depth, color)
	-- Wedge high faces meet at the ridge. The older shared helper made a valley roof.
	K.wedge(cf * CF(-width / 4, rise / 2, 0) * A(0, PI / 2, 0), V(depth, rise, width / 2), color, M.SmoothPlastic)
	K.wedge(cf * CF(width / 4, rise / 2, 0) * A(0, -PI / 2, 0), V(depth, rise, width / 2), color, M.SmoothPlastic)
end
function Art.Diamond(cf, height, width, depth, color, material)
	-- Solid planar rhombus, long axis Y; four wedges, shared styling on every crest.
	for _, sign in ipairs({ -1, 1 }) do
		local c = cf * CF(0, sign * height / 4, 0) * A(0, PI / 2, sign < 0 and PI or 0)
		for _, side in ipairs({ -1, 1 }) do
			K.wedge(
				c * CF(0, 0, side * width / 4) * A(0, side > 0 and PI or 0, 0),
				V(depth, height / 2, width / 2),
				color,
				material
			)
		end
	end
end
function Art.Crest(cf, h)
	Art.Diamond(cf, h, h * 0.58, 0.22, P.gold, M.Metal)
	Art.Diamond(cf * CF(0, 0, -0.15), h * 0.69, h * 0.35, 0.10, P.lilac, M.SmoothPlastic)
end
function Art.Column(cf, h, width)
	K.block(cf * CF(0, 0.5, 0), V(width * 1.45, 1, width * 1.45), P.stone, M.Limestone, true)
	K.block(cf * CF(0, 1.15, 0), V(width * 1.25, 0.35, width * 1.25), P.gold, M.Metal)
	K.block(cf * CF(0, h / 2 + 1.3, 0), V(width, h, width), P.ivory, M.Limestone, true)
	for _, side in ipairs({ -1, 1 }) do
		K.block(
			cf * CF(side * width * 0.34, h / 2 + 1.3, -width * 0.51),
			V(width * 0.12, h * 0.84, 0.07),
			P.light,
			M.SmoothPlastic
		)
	end
	K.block(cf * CF(0, h + 1.5, 0), V(width * 1.32, 0.55, width * 1.32), P.gold, M.Metal)
	K.block(cf * CF(0, h + 2, 0), V(width * 1.48, 0.45, width * 1.48), P.light, M.Limestone)
end
function Art.Lantern(cf, scale, pointLight)
	local s = scale or 1
	K.block(cf * CF(0, 0.35 * s, 0), V(2.0, 0.7, 2.0) * s, P.ivory, M.Limestone)
	K.block(cf * CF(0, 2.4 * s, 0), V(0.52, 4, 0.52) * s, P.roof, M.Metal)
	local glow = K.block(cf * CF(0, 5 * s, 0), V(0.90, 1.75, 0.90) * s, C(255, 214, 151), M.Neon, false, 0.12)
	for _, x in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -1, 1 }) do
			K.block(cf * CF(x * 0.52 * s, 5 * s, z * 0.52 * s), V(0.14, 2.05, 0.14) * s, P.gold, M.Metal)
		end
	end
	K.block(cf * CF(0, 6.05 * s, 0), V(1.45, 0.2, 1.45) * s, P.gold, M.Metal)
	K.pyramid(cf * CF(0, 6.15 * s, 0), 1.65 * s, 0.65 * s, P.roof, M.SmoothPlastic)
	if pointLight then
		K.lamp(glow, C(255, 217, 163), 16 * s, 0.65)
	end
	return glow
end
function Art.Banner(cf, h, w)
	K.block(cf * CF(0, -h / 2, 0), V(w, h, 0.18), P.violet, M.Fabric)
	K.block(cf * CF(0, 0.2, 0), V(w + 0.55, 0.30, 0.40), P.gold, M.Metal)
	for _, side in ipairs({ -1, 1 }) do
		K.block(cf * CF(side * (w / 2 - 0.13), -h / 2, -0.12), V(0.15, h, 0.08), P.goldLight, M.SmoothPlastic)
	end
	Art.Diamond(cf * CF(0, -h, 0), h * 0.30, w, 0.18, P.violet, M.Fabric)
	Art.Diamond(cf * CF(0, -h * 0.52, -0.15), math.min(w * 1.1, h * 0.45), w * 0.62, 0.08, P.goldLight, M.Metal)
	Art.Diamond(cf * CF(0, -h * 0.52, -0.21), math.min(w * 0.73, h * 0.30), w * 0.35, 0.04, P.violet, M.SmoothPlastic)
end
function Art.Crystal(cf, w, h, color)
	local original = K.Folder()
	local model = Instance.new("Model")
	model.Name = "FacetedCrystal"
	K.SetFolder(model)
	local core = K.block(cf * CF(0, h * 0.47, 0) * A(0, PI / 4, 0), V(w, h * 0.50, w), color, M.SmoothPlastic)
	model.PrimaryPart = core
	K.pyramid(cf * CF(0, h * 0.72, 0) * A(0, PI / 4, 0), w, h * 0.35, K.light(color, 0.18), M.SmoothPlastic)
	K.pyramid(cf * CF(0, h * 0.22, 0) * A(PI, PI / 4, 0), w, h * 0.22, K.dark(color, 0.13), M.SmoothPlastic)
	K.SetFolder(original)
	model.Parent = original
	return core, model
end
function Art.Fountain(cf, scale, name)
	local s = scale or 1
	local original = K.Folder()
	local model = Instance.new("Model")
	model.Name = name or "CrystalFountain"
	K.SetFolder(model)
	local function at(x, y, z)
		return cf * CF(x * s, y * s, z * s)
	end
	local function polygon(radius, y, height, color, material, n, thickness)
		n = n or 12
		for i = 0, n - 1 do
			local a = i / n * PI * 2
			K.block(
				at(math.sin(a) * radius, y, math.cos(a) * radius) * A(0, a, 0),
				V(2 * radius * math.tan(PI / n) + 0.1, height, thickness or 0.8) * s,
				color,
				material
			)
		end
	end
	K.vcyl((at(0, 0, 0)).Position, 0.5 * s, 21 * s, P.stone, M.Limestone)
	K.vcyl((at(0, 0.5, 0)).Position, 0.5 * s, 19.6 * s, P.light, M.Limestone)
	K.vcyl((at(0, 0.9, 0)).Position, 0.18 * s, 17.8 * s, P.water, M.SmoothPlastic)
	polygon(9.25, 1.12, 0.70, P.ivory, M.Limestone)
	polygon(9.70, 0.62, 0.15, P.gold, M.Metal, 12, 0.25)
	for i = 0, 7 do
		local a = i / 8 * PI * 2
		K.block(at(math.sin(a) * 4.8, 3.0, math.cos(a) * 4.8), V(0.60, 3.6, 0.60) * s, P.light, M.Limestone)
		K.block(
			at(math.sin(a + 0.18) * 5.1, 2.8, math.cos(a + 0.18) * 5.1) * A(0, a + 0.18, 0),
			V(1.55, 3.2, 0.055) * s,
			C(136, 220, 231),
			M.Glass,
			false,
			0.42
		)
	end
	K.vcyl((at(0, 4.4, 0)).Position, 0.50 * s, 11.8 * s, P.light, M.Limestone)
	K.vcyl((at(0, 4.9, 0)).Position, 0.14 * s, 10.8 * s, P.water, M.SmoothPlastic)
	polygon(5.65, 4.9, 0.48, P.ivory, M.Limestone, 12, 0.50)
	polygon(5.80, 4.45, 0.15, P.gold, M.Metal, 12, 0.20)
	K.vcyl((at(0, 4.8, 0)).Position, 1.1 * s, 3.4 * s, P.violet, M.SmoothPlastic)
	local core, crystals = Art.Crystal(at(0, 6.2, 0), 1.8 * s, 5.2 * s, P.lilac)
	crystals.Name = "IncomeCrystalAssembly"
	K.tag(crystals, "TPFC_Bob", { Amp = 0.18 * s, Period = 4, Spin = 10 })
	for _, side in ipairs({ -1, 1 }) do
		Art.Crystal(
			at(side * 1.8, 5.6, 0.3) * A(0, 0, -side * 0.25),
			1.1 * s,
			3.3 * s,
			side < 0 and C(155, 108, 216) or C(191, 148, 239)
		)
	end
	K.SetFolder(original)
	model.Parent = original
	return core, model
end
function Art.Planter(cf, length, pink)
	K.block(cf * CF(0, 0.45, 0), V(4.8, 0.9, length), P.ivory, M.Limestone)
	K.block(cf * CF(0, 0.92, 0), V(4.4, 0.08, length - 0.4), P.gold, M.Metal)
	K.block(cf * CF(0, 1.1, 0), V(3.8, 0.30, length - 0.8), C(65, 72, 49), M.Ground)
	for z = -length / 2 + 2, length / 2 - 1, 3 do
		K.bush((cf * CF(0, 1.2, z)).Position, 0.8, P.leaf)
		for i = 0, 2 do
			K.block(
				cf * CF(-0.85 + i * 0.8, 2.4 + (i % 2) * 0.35, z + i * 0.35),
				V(0.45, 1.1, 0.45),
				pink and P.pink or P.lilac,
				M.SmoothPlastic
			)
		end
	end
end
return Art
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">SanctuaryBase</string><ProtectedString name="Source"><![CDATA[-- The eight reference gardens. Cosmetic construction with the original BaseBuilder reference contract.
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local K = require(script.Parent.WorldKit)
local Art = require(script.Parent.SanctuaryArchitecture)
local Base = {}
local V, CF, A, PI = Vector3.new, CFrame.new, CFrame.Angles, math.pi
local C, M, P = Color3.fromRGB, Enum.Material, Art.Palette

local function label(parent, text, size, offset, color, distance)
	local gui = Instance.new("BillboardGui")
	gui.Size, gui.StudsOffset, gui.MaxDistance = size, offset, distance or 45
	gui.LightInfluence, gui.AlwaysOnTop = 0, false
	local t = Instance.new("TextLabel")
	t.Name, t.Size, t.BackgroundTransparency = "Label", UDim2.fromScale(1, 1), 1
	t.Font, t.TextScaled, t.RichText, t.Text = Enum.Font.GothamMedium, true, true, text
	t.TextColor3 = color or P.light
	local stroke = Instance.new("UIStroke")
	stroke.Thickness, stroke.Transparency = 1, 0.25
	stroke.Color = P.roof
	stroke.Parent = t
	t.Parent, gui.Parent = gui, parent
	return t
end
local function ownerLabel(part, face)
	local gui = Instance.new("SurfaceGui")
	gui.Face, gui.CanvasSize, gui.LightInfluence = face, Vector2.new(600, 120), 0.5
	local t = Instance.new("TextLabel")
	t.Name, t.Size, t.BackgroundTransparency = "Owner", UDim2.fromScale(0.92, 0.80), 1
	t.Position, t.Font, t.TextScaled = UDim2.fromScale(0.04, 0.1), Enum.Font.GothamMedium, true
	t.TextColor3, t.Text = P.light, "UNCLAIMED GARDEN"
	t.Parent, gui.Parent = gui, part
	return t
end

function Base.Build(index)
	local side, row = index <= 4 and -1 or 1, (index - 1) % 4
	local pos = V(side * 63, 0, -84 - row * 76)
	local cf = CFrame.lookAt(pos, V(0, 0, pos.Z))
	local function L(x, y, z)
		return cf * CF(x, y, z)
	end
	local model = Instance.new("Model")
	model.Name = "Base" .. index
	K.SetFolder(model)
	K.mirror = false
	K.Seed(7400 + index)
	local function b(name, size, at, color, mat, collide)
		local p = K.block(at, size, color, mat, collide)
		p.Name = name
		return p
	end
	b("Foundation", V(71, 1.0, 71), L(0, 0.25, 0), P.stone, M.Limestone, true)
	local floor = b("Floor", V(68, 1, 68), L(0, 0.5, 0), P.grass, M.Grass, true)
	floor.CanQuery, model.PrimaryPart = true, floor
	-- Low clipped hedges and pale retaining edges, with a full 20-stud street entrance.
	local function border(at, len)
		b("GardenCoping", V(len, 0.65, 2.7), at * CF(0, 0.9, 0), P.light, M.Limestone)
		b("GardenGoldEdge", V(len, 0.11, 0.18), at * CF(0, 1.28, -1.22), P.gold, M.Metal)
		b("ClippedHedge", V(len - 0.8, 1.55, 1.9), at * CF(0, 2.05, 0), P.leaf, M.SmoothPlastic)
		for x = -len / 2 + 2, len / 2 - 1, 7 do
			b("HedgeTop", V(3.8, 0.55, 2.0), at * CF(x, 3.0, 0), C(103, 157, 69), M.SmoothPlastic)
		end
	end
	border(L(0, 0, 34), 68)
	border(L(-34, 0, 0) * A(0, PI / 2, 0), 68)
	border(L(34, 0, 0) * A(0, PI / 2, 0), 68)
	for _, sd in ipairs({ -1, 1 }) do
		border(L(sd * 22, 0, -34), 24)
	end
	for _, sd in ipairs({ -1, 1 }) do
		Art.Column(L(sd * 8.5, 0.7, -34), 8.3, 2.0)
		Art.Lantern(L(sd * 11, 0.5, -33.8), 0.8, false)
	end
	local sign = b("Sign", V(14, 2.8, 0.65), L(0, 10.4, -34), P.violet, M.SmoothPlastic)
	b("SignGoldCap", V(14.6, 0.3, 0.86), L(0, 12.0, -34), P.gold, M.Metal)
	Art.Crest(L(0, 13.1, -34.2), 2.4)
	local sl, sl2 = ownerLabel(sign, Enum.NormalId.Front), ownerLabel(sign, Enum.NormalId.Back)
	local income = label(sign, "", UDim2.fromScale(10, 1.25), V(0, 2.4, 0), C(204, 229, 182), 48)
	b("GardenWalk", V(6.8, 0.14, 25), L(0, 1.08, -20.5), P.ivory, M.Limestone)
	for _, sd in ipairs({ -1, 1 }) do
		b("WalkInlay", V(0.14, 0.035, 24), L(sd * 3.25, 1.17, -20.5), P.gold, M.Metal)
	end
	-- Two-tier flowing basin and actual multi-facet violet crystal cluster.
	local crystal = Art.Fountain(L(0, 1.0, 0), 0.69, "GardenCrystalFountain")
	crystal.Name = "IncomeCrystal"
	local crystalLabel = label(crystal, "", UDim2.fromScale(9, 1.4), V(0, 3, 0), P.light, 45)
	local slotFolder = Instance.new("Folder")
	slotFolder.Name = "Slots"
	slotFolder.Parent = model
	local slots = {}
	K.SetFolder(slotFolder)
	for i = 1, 24 do
		local a = (i - 1) / 24 * PI * 2 + PI / 2
		local x, z = math.cos(a) * 14, math.sin(a) * 14
		local ring = K.vcyl(L(x, 1.015, z).Position, 0.055, 2.9, C(153, 142, 169), M.SmoothPlastic, false, 0.55)
		ring.Name = "SlotRing" .. i
		local pad = K.vcyl(L(x, 1.05, z).Position, 0.05, 2.5, P.light, M.SmoothPlastic, false, 0.4)
		pad.Name = "Slot" .. i
		pad:SetAttribute("Index", i)
		slots[i] = L(x, 1.1, z)
	end
	K.SetFolder(model)
	-- Square green collect pad, gold corners, restrained world text close to the player.
	local cp = V(-19, 0, -21)
	b("CollectFoundation", V(9.6, 0.45, 9.6), L(cp.X, 1.2, cp.Z), P.ivory, M.Limestone)
	local collect = b("CollectPad", V(8.1, 0.16, 8.1), L(cp.X, 1.53, cp.Z), C(87, 190, 96), M.SmoothPlastic)
	for _, sd in ipairs({ -1, 1 }) do
		for _, zz in ipairs({ -1, 1 }) do
			b("CollectCorner", V(1.3, 0.25, 1.3), L(cp.X + sd * 4.2, 1.48, cp.Z + zz * 4.2), P.gold, M.Metal)
		end
		b(
			"CollectMark",
			V(0.12, 0.035, 5),
			L(cp.X + sd * 1.77, 1.64, cp.Z) * A(0, sd * PI / 4, 0),
			C(216, 249, 185),
			M.Neon
		)
	end
	local collectLabel = label(collect, "$0", UDim2.fromScale(5, 1.25), V(0, 3.0, 0), C(222, 248, 185), 30)
	label(collect, "COLLECT", UDim2.fromScale(4, 0.7), V(0, 1.9, 0), P.light, 24)
	local g = Config.GymOffset
	b("GymFoundation", V(16.4, 0.45, 16.4), L(g.X, 1.15, g.Z), P.ivory, M.Limestone)
	b("GymPad", V(15, 0.14, 15), L(g.X, 1.48, g.Z), C(58, 45, 76), M.SmoothPlastic)
	for _, sd in ipairs({ -1, 1 }) do
		b("GymTrim", V(15.4, 0.10, 0.24), L(g.X, 1.58, g.Z + sd * 7.6), P.gold, M.Metal)
		b("GymTrim", V(0.24, 0.10, 15.4), L(g.X + sd * 7.6, 1.58, g.Z), P.gold, M.Metal)
	end
	local gymSign = b("GymSign", V(0.1, 0.1, 0.1), L(g.X, 8, g.Z + 4), P.light)
	gymSign.Transparency = 1
	local gymLabel = label(gymSign, "GYM", UDim2.fromScale(8, 1.8), V(0, 0, 0), P.goldLight, 42)
	-- Cottage: violet ridge roof, cream gable, framed warm windows and gold eaves.
	local hc = L(-20, 1.0, 24)
	b("CottageFoundation", V(14.6, 0.7, 10.6), hc * CF(0, 0.35, 0), P.stone, M.Limestone, true)
	b("CottageWalls", V(13, 7.5, 9), hc * CF(0, 4.1, 0), C(202, 177, 135), M.SmoothPlastic, true)
	Art.Gable(hc * CF(0, 7.8, 0), 15.5, 5, 11, P.roof)
	Art.Gable(hc * CF(0, 7.8, -4.55), 12.7, 4.1, 0.20, P.ivory)
	for _, sd in ipairs({ -1, 1 }) do
		Art.Beam(
			(hc * CF(0, 12.8, -5.6)).Position,
			(hc * CF(sd * 7.75, 7.8, -5.6)).Position,
			0.38,
			0.40,
			P.gold,
			M.Metal
		)
		b("CottagePillar", V(0.7, 7.6, 0.7), hc * CF(sd * 6.15, 4.1, -4.3), P.ivory, M.Limestone)
		b("WindowFrame", V(2.7, 3.2, 0.32), hc * CF(sd * 3.8, 4.4, -4.65), P.roof, M.SmoothPlastic)
		b("WindowLight", V(2.25, 2.7, 0.12), hc * CF(sd * 3.8, 4.4, -4.86), C(245, 204, 132), M.SmoothPlastic)
		b("WindowMullion", V(0.15, 2.8, 0.14), hc * CF(sd * 3.8, 4.4, -4.96), P.gold, M.Metal)
		b("WindowMullion", V(2.3, 0.15, 0.14), hc * CF(sd * 3.8, 4.4, -4.96), P.gold, M.Metal)
	end
	b("CottageDoor", V(2.5, 5.3, 0.30), hc * CF(0, 3.0, -4.7), P.roof, M.SmoothPlastic)
	Art.Crest(hc * CF(0, 9.2, -4.83), 1.65)
	-- Pond, lily pads and a stepped stone rim. No fake neon water or cloud of sparkles.
	local pc = L(21, 1.10, 23)
	K.vcyl(pc.Position, 0.25, 13.2, P.stone, M.Limestone)
	K.vcyl((pc * CF(0, 0.28, 0)).Position, 0.12, 11.7, P.water, M.SmoothPlastic)
	for i = 0, 7 do
		local a = i / 8 * PI * 2
		b(
			"PondRim",
			V(4.8, 0.38, 0.8),
			pc * CF(math.sin(a) * 6.35, 0.36, math.cos(a) * 6.35) * A(0, a, 0),
			P.light,
			M.Limestone
		)
	end
	for i = 1, 3 do
		local px, pz = 2.6 * math.cos(i * 2), 2.6 * math.sin(i * 2)
		b("LilyPad", V(1.4, 0.10, 1.4), pc * CF(px, 0.42, pz) * A(0, i, 0), P.leaf, M.SmoothPlastic)
		b("LilyFlower", V(0.60, 0.18, 0.60), pc * CF(px, 0.55, pz), P.pink, M.SmoothPlastic)
	end
	K.tree(L(27, 1, 5).Position, 0.72, P.pink, nil, true)
	for _, x in ipairs({ -29, 29 }) do
		Art.Lantern(L(x, 1, 29), 0.85, false)
	end
	local center = b("Center", V(0.1, 0.1, 0.1), L(0, 1, 0), P.ivory)
	center.Transparency = 1
	local decor, gym = Instance.new("Folder"), Instance.new("Folder")
	decor.Name, gym.Name, decor.Parent, gym.Parent = "Decor", "Gym", model, model
	model:SetAttribute("Index", index)
	model:SetAttribute("SanctuaryVersion", 2)
	model.Parent = workspace:FindFirstChild("Bases")
	return {
		index = index,
		model = model,
		cf = cf,
		floor = floor,
		slots = slots,
		slotFolder = slotFolder,
		collect = collect,
		collectLabel = collectLabel,
		incomeLabel = income,
		crystalLabel = crystalLabel,
		signLabels = { sl, sl2 },
		decor = decor,
		gym = gym,
		gymLabel = gymLabel,
		owner = nil,
		training = gym,
		spawnCF = L(0, 4, -28) * A(0, PI, 0),
	}
end
return Base
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">SanctuaryDetails</string><ProtectedString name="Source"><![CDATA[-- Deliberate close-up detail for the lobby. Decorative only; all gameplay paths stay clear.
local P = require(script.Parent.SanctuaryArchitecture).Palette
local Details = {}
local V, CF, A = Vector3.new, CFrame.new, CFrame.Angles
local M = Enum.Material
function Details.Build(start)
	local old = start:FindFirstChild("SanctuaryDetails")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "SanctuaryDetails"
	root.Parent = start
	local count = 0
	local function part(name, size, cf, color, material, transparency)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material or M.SmoothPlastic
		p.Transparency = transparency or 0
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = root
		count += 1
		return p
	end
	local function segment(name, a, b, width, height, color, material)
		local mid = (a + b) / 2
		local delta = b - a
		return part(name, V(width, height, delta.Magnitude), CFrame.lookAt(mid, b), color, material)
	end
	local function ring(name, x, z, r, y, segments, width, color)
		for i = 0, segments - 1 do
			local a = i * math.pi * 2 / segments
			local b = (i + 1) * math.pi * 2 / segments
			segment(
				name,
				V(x + math.cos(a) * r, y, z + math.sin(a) * r),
				V(x + math.cos(b) * r, y, z + math.sin(b) * r),
				width,
				0.035,
				color
			)
		end
	end
	local function flower(x, y, z, tone)
		part("Stem", V(0.12, 0.7, 0.12), CF(x, y + 0.35, z), P.leaf)
		for i = 0, 3 do
			local a = i * math.pi / 2
			part(
				"Petal",
				V(0.48, 0.16, 0.35),
				CF(x + math.cos(a) * 0.27, y + 0.78, z + math.sin(a) * 0.27) * A(0, a, 0),
				tone
			)
		end
		part("FlowerHeart", V(0.2, 0.2, 0.2), CF(x, y + 0.88, z), P.goldLight)
	end
	-- Restrained stone cutting and brass inlay: large shapes remain readable at distance.
	for i, z in ipairs({ -53, -101, -145, -189, -229, -273, -313, -357, -405 }) do
		for _, side in { -1, 1 } do
			for j = 0, 2 do
				part("CutStoneJoint", V(4.1, 0.025, 0.10), CF(side * (10 + j * 4.2), 0.232, z), P.stone)
			end
			part(
				"BrassPathStud",
				V(0.44, 0.035, 0.44),
				CF(side * 19.6, 0.26, z) * A(0, math.pi / 4, 0),
				P.gold,
				M.Metal
			)
		end
		if i % 3 == 0 then
			task.wait()
		end
	end
	for _, z in { -84, -160, -236, -312 } do
		for _, side in { -1, 1 } do
			-- Narrow drains beside the kerb, never across garden approaches.
			part("DrainBed", V(0.62, 0.03, 6), CF(side * 21.5, 0.255, z + 17), P.roof, M.Metal)
			for n = 0, 7 do
				part("DrainGrate", V(0.7, 0.04, 0.11), CF(side * 21.5, 0.28, z + 14.3 + n * 0.73), P.stone, M.Metal)
			end
			-- Small planting beds at avenue corners, outside the clear walking corridor.
			local bx, bz = side * 28.2, z - 19
			part("FlowerBedBase", V(4.4, 0.45, 6.8), CF(bx, 0.35, bz), P.stone, M.Limestone)
			part("FlowerBedSoil", V(3.7, 0.18, 6.1), CF(bx, 0.64, bz), Color3.fromRGB(76, 58, 65), M.Ground)
			for n = 0, 3 do
				flower(bx + ((n % 2) - 0.5) * 1.35, 0.75, bz - 2 + n * 1.3, n % 2 == 0 and P.pink or P.lilac)
			end
		end
		task.wait()
	end
	-- A compass mosaic at the entrance uses thin, flush geometry rather than another sign.
	ring("CompassOuter", 0, -54, 8, 0.27, 16, 0.13, P.gold)
	ring("CompassInner", 0, -54, 6.8, 0.273, 16, 0.09, P.stone)
	for i = 0, 7 do
		local a = i * math.pi / 4
		part(
			"CompassPoint",
			V(0.75, 0.05, i % 2 == 0 and 4.2 or 2.8),
			CF(math.sin(a) * 3.6, 0.30, -54 + math.cos(a) * 3.6) * A(0, a, 0),
			i % 2 == 0 and P.roof or P.gold
		)
	end
	-- Hall masonry: sill steps, foundation courses, panel joints and roof corbels.
	for _, side in { -1, 1 } do
		local x = side * 38
		for _, y in { 3.2, 6.7, 22.7 } do
			part("FacadeStoneCourse", V(19.6, 0.25, 0.24), CF(x, y, -36.78), P.stone, M.Limestone)
		end
		for i = 0, 4 do
			part("FoundationJoint", V(0.08, 2.7, 0.26), CF(x - 8 + i * 4, 4.8, -36.82), P.ivory, M.Limestone)
		end
		for _, wx in { x - 3.4, x + 3.4 } do
			part("WindowSill", V(5.9, 0.42, 1.2), CF(wx, 9.1, -37.0), P.light, M.Limestone)
			part("WindowSillGold", V(5.5, 0.10, 1.24), CF(wx, 9.37, -37.02), P.gold, M.Metal)
		end
		for i = 0, 5 do
			part("EaveCorbel", V(0.68, 1.3, 0.84), CF(x - 8.5 + i * 3.4, 23.8, -37), P.light, M.Limestone)
		end
		for _, z in { -33, -26, -19, -12, -5 } do
			part("OuterWallCourse", V(0.26, 0.24, 6.8), CF(side * 48.1, 6.7, z), P.stone, M.Limestone)
			part("RoofTileSeam", V(22.3, 0.04, 0.13), CF(x, 25.73, z), P.gold, M.Metal)
		end
		task.wait()
	end
	-- Public fountain plaza: cut paving, seating and flower borders form one composed destination.
	for _, side in { -1, 1 } do
		for i = 0, 4 do
			part("PlazaJoint", V(0.07, 0.035, 34), CF(78 - 15 + i * 7.5, 0.275, -22), P.stone)
		end
		local bx = 78 + side * 14
		part("BenchSeat", V(2.4, 0.5, 9), CF(bx, 2, -22), P.ivory, M.Limestone)
		for _, z in { -25, -19 } do
			part("BenchFoot", V(1.7, 1.5, 0.75), CF(bx, 1, z), P.stone, M.Limestone)
		end
		part("BenchTrim", V(2.5, 0.12, 9.1), CF(bx, 2.30, -22), P.gold, M.Metal)
		for n = 0, 3 do
			flower(78 + side * 11, 0.3, -35 + n * 1.7, n % 2 == 0 and P.pink or P.light)
		end
	end
	ring("FountainBrassRing", 78, -22, 12, 0.31, 24, 0.16, P.gold)
	ring("FountainOuterStone", 78, -22, 14, 0.30, 24, 0.12, P.stone)
	-- Faceted light-catching water strips on the side cascades, with stone catch-basin rims.
	for _, side in { -1, 1 } do
		for _, z in { -124, -278 } do
			for i = 0, 3 do
				part(
					"WaterRibbon",
					V(0.035, 19 - i * 0.8, 0.16),
					CF(side * 101.65, 12, z - 2.5 + i * 1.6),
					P.light,
					M.Glass,
					0.68
				)
			end
			for i = 0, 5 do
				local a = i * math.pi / 3
				part(
					"CascadeBasinRim",
					V(4, 0.24, 0.45),
					CF(side * 100 + math.sin(a) * 5.7, 0.45, z + math.cos(a) * 5.7) * A(0, a, 0),
					P.light,
					M.Limestone
				)
			end
		end
	end
	-- Localized water mist and portal glimmers, not a particle field following the camera.
	local tags = game:GetService("CollectionService")
	local function emitter(name, pos, rate, magic)
		local anchor = part(name, V(1, 1, 1), CF(pos), P.water, M.SmoothPlastic, 1)
		local pe = Instance.new("ParticleEmitter")
		pe.Name = name .. "Emitter"
		pe.Texture = magic and "rbxasset://textures/particles/sparkles_main.dds"
			or "rbxasset://textures/particles/smoke_main.dds"
		pe.Rate = rate
		pe.Lifetime = NumberRange.new(magic and 2 or 2.5, magic and 3 or 4)
		pe.Speed = NumberRange.new(0.35, magic and 1.1 or 0.8)
		pe.SpreadAngle = Vector2.new(90, 90)
		pe.Acceleration = V(magic and 0 or 0.1, magic and 0.15 or 0.04, 0)
		pe.Drag = 0.7
		pe.Color = ColorSequence.new(magic and P.goldLight or Color3.fromRGB(217, 233, 241))
		pe.LightEmission = magic and 0.6 or 0.12
		pe.LightInfluence = magic and 0.2 or 0.7
		pe.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, magic and 0.08 or 1.4),
			NumberSequenceKeypoint.new(0.55, magic and 0.18 or 3.8),
			NumberSequenceKeypoint.new(1, magic and 0.05 or 5.2),
		})
		pe.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.25, magic and 0.45 or 0.9),
			NumberSequenceKeypoint.new(0.75, magic and 0.65 or 0.94),
			NumberSequenceKeypoint.new(1, 1),
		})
		pe.Rotation = NumberRange.new(0, 360)
		pe.RotSpeed = NumberRange.new(-8, 8)
		pe.Parent = anchor
		pe:SetAttribute("BaseRate", rate)
		tags:AddTag(pe, "TPFC_EnvironmentEmitter")
	end
	for _, side in { -1, 1 } do
		for _, z in { -124, -278 } do
			emitter("CascadeMist", V(side * 100, 1.3, z), 4, false)
		end
		emitter("FountainMist", V(78 + side * 4, 1.6, -22), 2, false)
		emitter("ArchGlimmer", V(side * 23, 10, -34), 1.5, true)
	end

	root:SetAttribute("Parts", count)
	root:SetAttribute("Version", 1)
	return root
end
return Details
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">SanctuaryHub</string><ProtectedString name="Source"><![CDATA[-- Portal Sanctuary: a composed, walkable lobby, built from the supplied hub reference.
-- Plot centers, throw zone, collision barrier and lane direction retain their existing contracts.
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local Portals = require(RS.Shared.PortalBuilder)
local K = require(script.Parent.WorldKit)
local Art = require(script.Parent.SanctuaryArchitecture)
local Hub = {}
local V, CF, A, PI = Vector3.new, CFrame.new, CFrame.Angles, math.pi
local M, C = Enum.Material, Color3.fromRGB
local P = Art.Palette

local function walkable(cf, size, color, material, name)
	local p = K.block(cf, size, color, material, true)
	p.Name, p.CanQuery = name or "SanctuaryPaving", true
	p:SetAttribute("HubWalkable", true)
	return p
end
local function arch(z, width, height, depth)
	local half = width / 2
	local points = {
		V(-half, 2, z),
		V(-half, height * 0.59, z),
		V(-half * 0.83, height * 0.78, z),
		V(-half * 0.43, height * 0.94, z),
		V(0, height, z),
		V(half * 0.43, height * 0.94, z),
		V(half * 0.83, height * 0.78, z),
		V(half, height * 0.59, z),
		V(half, 2, z),
	}
	for i = 1, #points - 1 do
		Art.Beam(points[i], points[i + 1], 4.6, depth, P.ivory, M.Limestone)
		Art.Beam(
			points[i] + V(0, 0, -depth / 2 - 0.10),
			points[i + 1] + V(0, 0, -depth / 2 - 0.10),
			2.75,
			0.32,
			P.violet,
			M.SmoothPlastic
		)
		Art.Beam(
			points[i] + V(0, 0, -depth / 2 - 0.32),
			points[i + 1] + V(0, 0, -depth / 2 - 0.32),
			0.42,
			0.16,
			P.goldLight,
			M.Metal
		)
	end
	for _, side in ipairs({ -1, 1 }) do
		Art.Column(CF(side * half, 0.9, z), height * 0.56, 3.8)
		Art.Banner(CF(side * half, height * 0.56, z - depth / 2 - 0.40), height * 0.32, 2.1)
		Art.Lantern(CF(side * (half + 3.6), 0.2, z - 3), 1.15, true)
	end
	Art.Crest(CF(0, height + 0.3, z - depth / 2 - 0.55), 8)
	if height > 35 then
		Art.Crystal(CF(0, height - 3, z - depth / 2 - 0.5), 2.1, 7.5, P.lilac)
	end
end
local function window(cf, w, h)
	K.block(cf, V(w + 0.8, h + 0.8, 0.40), P.gold, M.Metal)
	K.block(cf * CF(0, 0, -0.24), V(w, h, 0.18), C(255, 208, 137), M.SmoothPlastic)
	for _, x in ipairs({ -0.24, 0.24 }) do
		K.block(cf * CF(x * w, 0, -0.37), V(0.17, h, 0.16), P.roof, M.SmoothPlastic)
	end
	K.block(cf * CF(0, 0, -0.38), V(w, 0.18, 0.12), P.roof, M.SmoothPlastic)
	Art.Gable(cf * CF(0, h / 2 + 0.35, -0.06), w + 1.1, 2.4, 0.65, P.gold)
end
local function hall(folder, label)
	local hw, back, front = Config.HallHalfWidth, Config.HallBackZ, Config.BarrierZ
	local middle, depth = (back + front) / 2, front - back
	walkable(CF(0, 0.6, middle), V(hw * 2, 1.2, depth), P.light, M.Limestone, "HallFloor")
	for x = -24, 24, 8 do
		for z = back + 4, front - 3, 8 do
			K.block(CF(x, 1.215, z), V(7.86, 0.03, 7.86), ((x + z) % 3 < 1) and P.ivory or P.light, M.SmoothPlastic)
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		K.block(CF(side * (hw - 1.3), 1.24, middle), V(0.34, 0.08, depth - 1), P.gold, M.Metal)
		-- Side bays frame a genuinely open central hall. Roofs stay off the throw/camera axis.
		local x = side * (hw + 10)
		walkable(CF(x, 0.7, middle), V(21, 1.4, depth + 2), P.stone, M.Limestone, "HallBayFoundation")
		K.block(CF(x, 12.5, middle), V(20, 24, depth), P.ivory, M.Limestone, true)
		K.block(CF(x, 4.2, back - 0.6), V(20.5, 3.6, 1.4), P.stone, M.Limestone)
		K.block(CF(x, 24.5, middle), V(22, 1.2, depth + 2), P.gold, M.Metal)
		Art.Gable(CF(x, 25.1, middle), 24, 5.6, depth + 4, P.roof)
		K.block(CF(x, 30.8, middle), V(0.6, 0.55, depth + 5), P.gold, M.Metal)
		for _, z in ipairs({ back + 2, middle, front - 2 }) do
			for _, roofSide in ipairs({ -1, 1 }) do
				Art.Beam(V(x, 30.85, z), V(x + roofSide * 12, 25.25, z), 0.22, 0.28, P.gold, M.Metal)
			end
		end
		for _, z in ipairs({ back + 2, front - 2 }) do
			for _, xx in ipairs({ x - 8, x + 8 }) do
				Art.Column(CF(xx, 0.7, z), 23, 1.8)
			end
		end
		for _, offset in ipairs({ -3.4, 3.4 }) do
			window(CF(x + offset, 13.5, back - 0.62), 4.7, 8)
			window(CF(x + offset, 13.5, front + 0.62) * A(0, PI, 0), 4.7, 8)
		end
		Art.Banner(CF(side * (hw + 0.8), 23, back - 1.25), 12, 2.8)
	end
	arch(back - 0.9, 39, 39, 4.5)
	arch(front + 1.7, 48, 31, 3.2)
	local sign = K.block(CF(0, 28, back - 3.3), V(23, 2.1, 0.3), P.roof, M.SmoothPlastic)
	label(sign, "PORTAL SANCTUARY", P.goldLight, Enum.NormalId.Front)
	-- Compass inlay: large intentional geometric motif, quiet enough for avatars and charge feedback.
	local centerZ = (Config.ThrowZone.minZ + Config.ThrowZone.maxZ) / 2
	for i = 0, 7 do
		local a = i / 8 * PI * 2
		K.block(
			CF(math.sin(a) * 9.8, 1.275, centerZ + math.cos(a) * 9.8) * A(0, a, 0),
			V(8.3, 0.05, 0.24),
			P.gold,
			M.Metal
		)
	end
	for i = -2, 2 do
		local channel = K.block(CF(i * 4.2, 1.29, centerZ), V(0.22, 0.055, 31), P.lilac, M.Neon, false, 0.74)
		channel.Name = "ChargeChannel"
		K.tag(channel, "TPFC_ChargeChannel", { Index = i })
	end
	K.block(CF(0, 1.31, front - 2), V(hw * 2 - 4, 0.06, 0.36), P.goldLight, M.Neon, false, 0.35).Name = "LaunchLine"
	local pad = K.block(
		CF(0, 1.26, centerZ),
		V(hw * 2 - 4, 0.03, Config.ThrowZone.maxZ - Config.ThrowZone.minZ - 2),
		P.lilac,
		M.SmoothPlastic,
		false,
		1
	)
	pad.Name = "ThrowZonePad"
	-- The functional barrier retains its exact plane and broad collision extents.
	local barrier = K.block(CF(0, 60, front), V(Config.StartHalfWidth * 2 + 40, 140, 2), P.lilac, M.ForceField, true, 1)
	barrier.Name, barrier.CanQuery = "Barrier", true
	K.block(CF(0, 1.4, front), V(hw * 2, 0.16, 0.25), P.lilac, M.Neon, false, 0.55).Name = "BarrierGlow"
	local gate = Portals.BuildGate("Basic", 17.5, { sanctuary = true })
	gate.Name = "SanctuaryAperture"
	local rootCF = CF(0, 19.3, front - 0.35)
	local solved = { [gate.PrimaryPart] = rootCF }
	gate.PrimaryPart.CFrame = rootCF
	local links = {}
	for _, d in ipairs(gate:GetDescendants()) do
		if d:IsA("Weld") then
			links[d.Part0] = links[d.Part0] or {}
			table.insert(links[d.Part0], d)
		end
	end
	local queue = { gate.PrimaryPart }
	local n = 1
	while queue[n] do
		local p = queue[n]
		for _, w in ipairs(links[p] or {}) do
			w.Part1.CFrame = solved[p] * w.C0 * w.C1:Inverse()
			solved[w.Part1] = w.Part1.CFrame
			table.insert(queue, w.Part1)
			if w.Name == "PortalRotor" then
				K.tag(w.Part1, "TPFC_Rotor")
			end
		end
		n += 1
	end
	gate.Parent = folder
	for _, p in ipairs(gate:GetDescendants()) do
		if p:IsA("BasePart") and p.Name == "EnergyInlay" then
			p.Transparency = 0.8
			K.tag(p, "TPFC_ChargeChannel", { Index = p.Position.Y * 0.1 })
		end
	end
end
local function avenue()
	local depth = Config.StartDepth
	walkable(CF(0, 0.02, -(depth + 36) / 2), V(45, 0.24, depth - 36), P.stone, M.Limestone)
	for row = 0, 49 do
		local z = -41 - row * 8.4
		for col = -2, 2 do
			local tone = ((row * 7 + col * 3) % 5) / 5
			K.block(CF(col * 8.5, 0.16, z), V(8.35, 0.12, 8.23), P.ivory:Lerp(P.light, tone * 0.6), M.SmoothPlastic)
		end
		if row % 10 == 9 then
			task.wait()
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		K.block(CF(side * 22.5, 0.22, -246), V(0.42, 0.12, 420), P.gold, M.Metal)
		K.block(CF(side * 23.6, 0.30, -246), V(1.2, 0.38, 420), P.light, M.Limestone)
		for _, z in ipairs({ -122, -198, -274, -350 }) do
			Art.Planter(CF(side * 26.8, 0, z), 22, z == -198)
			Art.Lantern(CF(side * 25.5, 0, z + 15), 1.2, true)
			local banner = CF(side * 26.5, 10, z - 12) * A(0, side < 0 and -PI / 2 or PI / 2, 0)
			K.block(banner * CF(0, -4.6, 0.15), V(0.35, 10, 0.35), P.roof, M.Metal)
			Art.Banner(banner, 5.2, 1.8)
		end
		for _, z in ipairs({ -84, -160, -236, -312 }) do
			walkable(CF(side * 27, 0.13, z), V(9, 0.32, 13), P.ivory, M.Limestone, "GardenApproach")
			for _, edge in ipairs({ -1, 1 }) do
				K.block(CF(side * 27, 0.33, z + edge * 6.5), V(9, 0.12, 0.30), P.gold, M.Metal)
			end
		end
	end
	for _, z in ipairs({ -62, -198, -350 }) do
		Art.Crest(CF(0, 0.35, z) * A(-PI / 2, 0, 0), 6)
	end
end
local function perimeter()
	K.Seed(46021)
	for _, side in ipairs({ -1, 1 }) do
		for i = 0, 10 do
			local z = -49 - i * 36
			local h = 25 + (i * 13 % 23)
			local x = side * 110
			K.block(CF(x, h / 2 - 2, z) * A(0.03, side * 0.13, side * -0.08), V(15, h, 39), C(105, 99, 116), M.Slate)
			K.wedge(
				CF(x - side * 4, h * 0.50, z + 5) * A(0, side * PI / 2, 0),
				V(24, h * 0.65, 13),
				C(133, 121, 137),
				M.Slate
			)
			-- Broken sloped peaks and shallow front facets avoid a flat castle-wall silhouette.
			K.corner(
				CF(x + side * 0.8, h + 0.5, z - 7) * A(0, side * PI / 2, 0),
				V(14, 9 + i % 4, 24),
				C(125, 115, 133),
				M.Slate
			)
			Art.Diamond(
				CF(x - side * 7.9, h * 0.48, z - 4) * A(0, side < 0 and -PI / 2 or PI / 2, -0.22),
				h * 0.66,
				13,
				0.18,
				C(126, 117, 134),
				M.Slate
			)
			K.block(CF(x - side * 5.5, 2.2, z), V(3.2, 3.5, 37), P.ivory, M.Limestone)
			if i % 3 == 1 then
				local cf = CF(x - side * 8.5, h - 1, z) * A(0, side < 0 and -PI / 2 or PI / 2, 0)
				Art.Banner(cf, 14, 4)
				K.block(cf * CF(0, 1.1, 0), V(5.5, 0.5, 1.0), P.gold, M.Metal)
			end
			if i % 2 == 0 then
				K.tree(V(side * 100, 1, z - 14), 1.12, i % 4 == 0 and P.pink or P.leaf, nil, true)
			end
		end
		for _, z in ipairs({ -124, -278 }) do
			K.block(CF(side * 101.8, 12, z), V(0.12, 22, 7.3), C(114, 211, 225), M.Glass, false, 0.30)
			K.block(CF(side * 102.2, 23.2, z), V(4, 1.2, 10), P.stone, M.Limestone)
			K.vcyl(V(side * 100, 0.2, z), 0.2, 11, P.water, M.SmoothPlastic)
		end
		task.wait()
	end
	-- Rear garden closes the composition with an arcade and two skyline pillars.
	for x = -90, 90, 30 do
		Art.Column(CF(x, 0, -452), 23 + (x == 0 and 4 or 0), 3)
		if x < 90 then
			Art.Beam(V(x, 22, -452), V(x + 15, 30, -452), 2.5, 2, P.ivory, M.Limestone)
			Art.Beam(V(x + 15, 30, -452), V(x + 30, 22, -452), 2.5, 2, P.ivory, M.Limestone)
		end
	end
end
local function garden()
	-- Viewer-left looking down +Z is WORLD +X. Keep the asymmetric public fountain on that side.
	walkable(CF(78, 0.12, -22), V(34, 0.28, 36), P.ivory, M.Limestone)
	Art.Fountain(CF(78, 0.3, -22), 1.15, "PublicCrystalFountain")
	K.tree(V(98, 0, -16), 1.05, P.pink, nil, true)
	for _, pos in ipairs({ V(-77, 0, -397), V(-47, 0, -426), V(-20, 0, -399), V(48, 0, -414), V(77, 0, -390) }) do
		K.tree(pos, 1.3, pos.X > 0 and P.pink or P.leaf, nil, true)
	end
	walkable(CF(-48, 0.12, -399), V(44, 0.28, 43), P.ivory, M.Limestone)
	K.vcyl(V(-48, 0.35, -399), 0.18, 20, P.water, M.SmoothPlastic)
	-- Fountain sits above paving; grass edging frames its public garden without sealing walkways.
	for _, z in ipairs({ -378, -420 }) do
		Art.Planter(CF(-48, 0.3, z) * A(0, PI / 2, 0), 32, true)
	end
	local plaza = V(0, 0.25, -389)
	for i = 0, 3 do
		local a = i / 4 * PI * 2 + PI / 4
		Art.Beam(
			plaza + V(math.sin(a) * 10, 0, math.cos(a) * 10),
			plaza + V(math.sin(a + PI / 2) * 10, 0, math.cos(a + PI / 2) * 10),
			0.28,
			0.12,
			P.gold,
			M.Metal
		)
	end
	local stone = K.block(CF(48, 1.6, -397), V(25, 3.2, 25), P.ivory, M.Limestone)
	stone.Name = "SanctuaryMonument"
	Art.Crystal(CF(48, 3.2, -397), 3.8, 12, P.lilac)
	for _, side in ipairs({ -1, 1 }) do
		Art.Crystal(CF(48 + side * 4.8, 3.2, -396) * A(0, 0, -side * 0.18), 2.3, 7, P.mint)
	end
	for _, x in ipairs({ 34, 62 }) do
		Art.Lantern(CF(x, 0, -382), 1.45, true)
	end
end

function Hub.Build(folder, textLabel)
	K.SetFolder(folder)
	K.mirror = false
	folder:SetAttribute("SanctuaryVersion", 2)
	require(RS.Shared.SanctuaryLook).Apply(game:GetService("Lighting"))
	avenue()
	task.wait()
	hall(folder, textLabel)
	task.wait()
	perimeter()
	garden()
	require(script.Parent.SanctuaryDetails).Build(folder)
end
return Hub
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[-- WorldBuilder: builds ONE long map — the hub (bases + launch hall) and the 3200-stud throwing
-- lane split into 8 biome zones. Each biome lives in its own module (Biome<Id>) built with the
-- shared WorldKit; this file only orchestrates terrain, zones, markers and boundaries.
-- Location: ServerScriptService > Server > WorldBuilder (ModuleScript)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local K = require(script.Parent.WorldKit)
local Landmarks = require(script.Parent.WorldLandmarks)

local WorldBuilder = {}
local Terrain = workspace.Terrain
local W = Config.MapHalfWidth
local V3, CF = Vector3.new, CFrame.new

local folder
local function block(cf, size, color, mat, collide, transp)
	local p = Instance.new("Part")
	p.Size, p.CFrame, p.Color, p.Material = size, cf, color, mat or Enum.Material.SmoothPlastic
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, collide == true, collide == true, false
	p.Transparency = transp or 0
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = folder
	return p
end
local function textLabel(parent, text, color, face) return K.textSurface(parent, text, color, face) end
WorldBuilder.textLabel = textLabel

---------------------------------------------------------------- biome modules
local BIOME_MODULES = {}
local function biomeModule(id)
	if BIOME_MODULES[id] == nil then
		local m = script.Parent:FindFirstChild("Biome" .. id)
		BIOME_MODULES[id] = m and require(m) or false
	end
	return BIOME_MODULES[id]
end

---------------------------------------------------------------- start area
local function isHubSpawn(instance)
	if not instance:IsA("SpawnLocation") then return false end
	if instance:GetAttribute("TPFCGenerated") then return true end
	-- Migrate only the exact invisible spawn generated by earlier versions.
	return instance.Name == "SpawnLocation" and instance.Transparency == 1
		and (instance.Position - V3(0, 0.6, -60)).Magnitude < 0.02
		and (instance.Size - V3(12, 1, 12)).Magnitude < 0.02
end
local function buildStart()
	local depth = Config.StartDepth
	local SW = Config.StartHalfWidth
	-- terrain voxels are 4 studs: a fill whose top is at y = -2 renders its surface at y ~ 0, which is
	-- where every flush detail and prop is authored (a top at 0 renders at ~2 and buries them)
	Terrain:FillBlock(CF(0, 14, -depth / 2 - 10), V3(SW * 2 + 80, 32, depth + 30), Enum.Material.Air)
	Terrain:FillBlock(CF(0, -8, -depth / 2 - 10), V3(SW * 2 + 80, 12, depth + 30), Enum.Material.Grass)
	K.SetFolder(folder)
	Landmarks.SetFolder(folder)
	Landmarks.SetTerrain(Terrain)
	local hub = script.Parent:FindFirstChild("WorldHub")
	if hub then
		require(hub).Build(folder, textLabel)
	else
		Landmarks.Hub(depth, SW, Config.HallBackZ)
	end
	-- spawn on the street, just behind the hall
	local spawn = Instance.new("SpawnLocation")
	spawn.Size = V3(12, 1, 12)
	spawn.CFrame = CF(0, 0.6, -60)
	spawn.Anchored = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Name = "SanctuarySpawn"
	spawn:SetAttribute("TPFCGenerated", true)
	spawn.Parent = workspace
end

---------------------------------------------------------------- distance markers (flush line + low stone post outside the reveal corridor)
local function distanceMarker(z)
	local line = block(CF(0, 0.08, z), V3(Config.LaneHalfWidth * 2, 0.12, 0.6), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, false, 0.7)
	line.Name = "Marker"
	if z % 100 ~= 0 then return end
	for s = -1, 1, 2 do
		local x = s * 41
		block(CF(x, 1.2, z), V3(1.6, 2.4, 1.6), Color3.fromRGB(226, 220, 210), Enum.Material.Limestone)
		local plaque = block(CF(x, 2.9, z), V3(4.2, 1.6, 0.4), Color3.fromRGB(60, 44, 92), Enum.Material.SmoothPlastic)
		block(CF(x, 3.8, z), V3(4.4, 0.2, 0.5), Color3.fromRGB(232, 190, 90), Enum.Material.Metal)
		textLabel(plaque, z .. "m", Color3.fromRGB(255, 236, 190), Enum.NormalId.Front)
		textLabel(plaque, z .. "m", Color3.fromRGB(255, 236, 190), Enum.NormalId.Back)
	end
end

---------------------------------------------------------------- one zone
local function buildZone(map, id)
	local Wd = Config.Worlds[id]
	local b = Config.ZoneBounds[id]
	local m = Config.WorldCenter(id)
	local old = map:FindFirstChild(id)
	if old then old:Destroy() end
	folder = Instance.new("Folder"); folder.Name = id; folder.Parent = map
	K.SetFolder(folder)
	Terrain:SetMaterialColor(Wd.material, Wd.groundColor)
	-- valley floor (landing surface): the lane plus the walkable sides
	Terrain:FillBlock(CF(0, 14, m.Z), V3(W * 2 + 120, 32, b[2] - b[1] + 4), Enum.Material.Air)
	Terrain:FillBlock(CF(0, -8, m.Z), V3(W * 2 + 120, 12, b[2] - b[1] + 4), Wd.material)
	local mod = biomeModule(id)
	if mod then
		local ok, err = pcall(mod.Build, b, m.Z, { Config = Config, textLabel = textLabel, World = Wd })
		K.mirror = false
		if not ok then warn("[WorldBuilder] biome failed", id, err) end
	else
		Landmarks.SetFolder(folder)
		Landmarks.SetTerrain(Terrain)
		local ok, err = pcall(Landmarks.Biome[id], b, m.Z)
		if not ok then warn("[WorldBuilder] landmarks failed", id, err) end
		pcall(Landmarks.ZoneGate, Wd.name:upper() .. "  •  " .. b[1] .. "m", b[1] + 2, Wd.atmo, textLabel)
		if b[1] > 0 then pcall(Landmarks.Transition, id, b[1]) end
	end
end

function WorldBuilder.BuildAll()
	-- Saved Studio previews contain generated geometry. Replace that exact namespace
	-- on boot, rather than stacking another full map over it on every playtest.
	for _, old in ipairs(workspace:GetChildren()) do
		local generatedMap = old.Name == "Map" and old:IsA("Folder") and old:FindFirstChild("Start") and old:FindFirstChild("Forest")
		local generatedSpawn = isHubSpawn(old)
		if generatedMap or generatedSpawn then
			old:Destroy()
		end
	end
	local map = Instance.new("Folder")
	map.Name = "Map"
	map:SetAttribute("TPFCGenerated", true)
	map.Parent = workspace
	-- stylised look: no realistic grass blades; calm water
	pcall(function() Terrain.Decoration = false end)
	Terrain.WaterColor = Color3.fromRGB(60, 200, 215)
	Terrain.WaterTransparency = 0.55
	Terrain.WaterWaveSize = 0.08
	Terrain.WaterWaveSpeed = 6
	Terrain.WaterReflectance = 0.45
	Terrain:SetMaterialColor(Enum.Material.Glacier, Color3.fromRGB(150, 220, 255))
	Terrain:SetMaterialColor(Enum.Material.CrackedLava, Color3.fromRGB(255, 110, 30))
	Terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(128, 128, 120))
	-- Terrain:SetMaterialColor is GLOBAL per material: every zone must own a distinct ground material
	local usedBy = {}
	for _, id in ipairs(Config.WorldOrder) do
		local mt = Config.Worlds[id].material
		if usedBy[mt] then warn("[WorldBuilder] terrain material shared by", usedBy[mt], "and", id, "- colours will conflict") end
		usedBy[mt] = id
	end
	folder = Instance.new("Folder"); folder.Name = "Start"; folder.Parent = map
	buildStart()
	for _, id in ipairs(Config.WorldOrder) do
		buildZone(map, id)
		task.wait()
	end
	folder = Instance.new("Folder"); folder.Name = "Markers"; folder.Parent = map
	for z = 50, Config.LaneLength - 50, 50 do distanceMarker(z) end
	-- invisible walls around the whole map
	local SW = Config.StartHalfWidth
	for s = -1, 1, 2 do
		block(CF(s * (W + 4), 80, Config.LaneLength / 2), V3(4, 200, Config.LaneLength + 20), Color3.new(1, 1, 1), nil, true, 1).Name = "Boundary"
		block(CF(s * (SW + 4), 80, -Config.StartDepth / 2), V3(4, 200, Config.StartDepth + 20), Color3.new(1, 1, 1), nil, true, 1).Name = "Boundary"
	end
	block(CF(0, 80, Config.LaneLength + 10), V3(W * 2 + 20, 200, 4), Color3.new(1, 1, 1), nil, true, 1).Name = "Boundary"
	block(CF(0, 80, -Config.StartDepth - 6), V3(SW * 2 + 20, 200, 4), Color3.new(1, 1, 1), nil, true, 1).Name = "Boundary"
end

-- Edit-time lobby iteration does not rebuild any biome or touch lane terrain.
function WorldBuilder.RebuildHub()
	local map = workspace:FindFirstChild("Map")
	assert(map and map:IsA("Folder"), "Build the map before rebuilding its lobby")
	local old = map:FindFirstChild("Start")
	if old then old:Destroy() end
	for _, spawn in ipairs(workspace:GetChildren()) do
		if isHubSpawn(spawn) then spawn:Destroy() end
	end
	folder = Instance.new("Folder"); folder.Name = "Start"; folder.Parent = map
	buildStart()
	return folder
end

-- dev/iteration: rebuild a single zone in place (Studio command bar / MCP)
function WorldBuilder.RebuildZone(id)
	local map = workspace:FindFirstChild("Map")
	if not map then return end
	BIOME_MODULES[id] = nil
	buildZone(map, id)
end

return WorldBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">WorldHub</string><ProtectedString name="Source"><![CDATA[-- Compatibility entry point for the reference-based sanctuary lobby.
return require(script.Parent.SanctuaryHub)
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">WorldKit</string><ProtectedString name="Source"><![CDATA[-- WorldKit: the shared blocky construction kit used by the hub and all eight biomes.
-- Location: ServerScriptService > Server > WorldKit (ModuleScript)
--
-- CONTRACT (map brief + GameServer landing contract):
--  * Landing rays only hit Terrain. Every part made here is CanQuery = false and CanTouch = false,
--    so decoration can never become the floor or catch a throw.
--  * Corridor rules: landing X is clamped to [-30, 30]; the reveal camera can sit up to X ~ 48 and
--    16 studs high. So anything taller than ~0.5 stays at |X| >= 44, anything taller than ~5 at
--    |X| >= 54, and nothing hangs over the lane. K.Side() enforces the minimum.
--  * Deterministic: every builder seeds K.rng, so rebuilds never drift.
--  * Motion is not done here. Parts get CollectionService tags and the client WorldFx scheduler animates them.

local CollectionService = game:GetService("CollectionService")

local K = {}
local PI = math.pi
local V3, CF, ANG = Vector3.new, CFrame.new, CFrame.Angles
local M = Enum.Material
K.PI, K.V3, K.CF, K.ANG, K.M = PI, V3, CF, ANG, M

local out -- current output folder
K.terrain = workspace.Terrain
K.rng = Random.new(1)
K.count = 0

function K.SetFolder(f) out = f end
-- walkable/placeable top surfaces registered by generators: { xa, xb, za, zb, top } (world, xa < xb)
K.surfaces = {}
function K.ResetSurfaces() K.surfaces = {} end
function K.addSurface(xa, xb, za, zb, top)
	table.insert(K.surfaces, { math.min(xa, xb), math.max(xa, xb), math.min(za, zb), math.max(za, zb), top })
end
-- highest registered surface at (x, z); 0 (valley floor) when none
function K.groundY(x, z)
	local y = 0
	for _, r in ipairs(K.surfaces) do
		if x >= r[1] and x <= r[2] and z >= r[3] and z <= r[4] and r[5] > y then y = r[5] end
	end
	return y
end
function K.at(x, z) return Vector3.new(x, K.groundY(x, z), z) end
function K.Folder() return out end
function K.Seed(n) K.rng = Random.new(n) end
function K.r(a, b) return K.rng:NextNumber(a, b) end
function K.ri(a, b) return K.rng:NextInteger(a, b) end
function K.pick(t) return t[K.rng:NextInteger(1, #t)] end
function K.chance(p) return K.rng:NextNumber() < p end
function K.C(r, g, b) return Color3.fromRGB(r, g, b) end
function K.hex(h) return Color3.fromHex(h) end
function K.dark(c, k) return c:Lerp(Color3.new(0, 0, 0), k) end
function K.light(c, k) return c:Lerp(Color3.new(1, 1, 1), k) end
local C = K.C

---------------------------------------------------------------- primitives
-- MIRROR MODE: biomes are authored as seen in the reference sheets (viewer at the hall looking
-- down +Z, where screen-right is world -X). With K.mirror = true every part is reflected across
-- X = 0: position x -> -x and rotation R -> S R S (S = diag(-1, 1, 1)), which is a proper rotation.
-- Blocks, wedges, cylinders and balls are symmetric in X, so the geometry is unchanged.
-- Surfaces / groundY stay in design coordinates. Reveal camera rule in design space when mirrored:
-- tall pieces on the design-LEFT (-X) side must stay at |X| >= 54.
K.mirror = false
local function mirrorCF(cf)
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return CFrame.new(-x, y, z, r00, -r01, -r02, -r10, r11, r12, -r20, r21, r22)
end
K.mirrorCF = mirrorCF
local function part(class, size, cf, color, mat, collide, transp)
	if K.mirror then cf = mirrorCF(cf) end
	local p = Instance.new(class)
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or M.SmoothPlastic
	p.Anchored = true
	p.CanCollide = collide == true
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = transp or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	-- shadows only from big masses (cheap and keeps small props crisp)
	p.CastShadow = (transp or 0) < 0.3 and size.X * size.Y * size.Z > 60
	local m = p.Material
	if m == M.Metal then p.Reflectance = 0.14
	elseif m == M.Glass then p.Reflectance = 0.22
	elseif m == M.Ice then p.Reflectance = 0.12
	elseif m == M.Marble then p.Reflectance = 0.05 end
	p.Parent = out
	K.count += 1
	return p
end
K.part = part
function K.block(cf, size, color, mat, collide, transp) return part("Part", size, cf, color, mat, collide, transp) end
function K.wedge(cf, size, color, mat, collide, transp) return part("WedgePart", size, cf, color, mat, collide, transp) end
function K.corner(cf, size, color, mat, collide) return part("CornerWedgePart", size, cf, color, mat, collide) end
function K.ball(pos, d, color, mat, transp)
	local p = part("Part", V3(d, d, d), CF(pos), color, mat, false, transp)
	p.Shape = Enum.PartType.Ball
	return p
end
-- cylinder whose axis is the cf's X axis
function K.cyl(cf, len, d, color, mat, collide, transp)
	local p = part("Part", V3(len, d, d), cf, color, mat, collide, transp)
	p.Shape = Enum.PartType.Cylinder
	return p
end
-- upright cylinder standing on pos
function K.vcyl(pos, h, d, color, mat, collide, transp)
	return K.cyl(CF(pos + V3(0, h / 2, 0)) * ANG(0, 0, PI / 2), h, d, color, mat, collide, transp)
end
function K.ellipsoid(cf, size, color, mat, transp)
	local p = part("Part", size, cf, color, mat, false, transp)
	local m = Instance.new("SpecialMesh"); m.MeshType = Enum.MeshType.Sphere; m.Parent = p
	return p
end
function K.lamp(p, color, range, brightness)
	local l = Instance.new("PointLight"); l.Color = color; l.Range = range; l.Brightness = brightness or 1.2; l.Shadows = range >= 40; l.Parent = p
	return l
end
function K.spot(p, color, range, brightness, angle, face)
	local l = Instance.new("SpotLight"); l.Color = color; l.Range = range; l.Brightness = brightness or 2; l.Angle = angle or 60
	l.Face = face or Enum.NormalId.Bottom; l.Shadows = false; l.Parent = p
	return l
end
function K.tag(p, name, attrs)
	CollectionService:AddTag(p, name)
	for k, v in pairs(attrs or {}) do p:SetAttribute(k, v) end
	return p
end

-- keep scenery out of the reveal corridor: returns sign * max(|x|, minAbs)
function K.Side(x, minAbs)
	local s = x < 0 and -1 or 1
	return s * math.max(math.abs(x), minAbs or 44)
end

---------------------------------------------------------------- shapes
-- pyramid cap (4 wedges), base centred on cf, apex +Y
function K.pyramid(cf, w, h, color, mat, d)
	d = d or w
	for i = 0, 3 do
		local ww = (i % 2 == 0) and w or d
		local dd = (i % 2 == 0) and d or w
		K.wedge(cf * ANG(0, i * PI / 2, 0) * CF(0, h / 2, -dd / 4), V3(ww, h, dd / 2), color, mat)
	end
end
-- gable roof along cf Z: two wedges back to back (w = span across X, h = rise, len = along Z)
function K.gable(cf, w, h, len, color, mat)
	K.wedge(cf * CF(-w / 4, h / 2, 0) * ANG(0, -PI / 2, 0), V3(len, h, w / 2), color, mat)
	K.wedge(cf * CF(w / 4, h / 2, 0) * ANG(0, PI / 2, 0), V3(len, h, w / 2), color, mat)
end
-- chunky "bevelled" stone block: body + slightly inset lighter top slab + darker foot band
function K.stone(cf, size, color, mat, collide)
	local b = K.block(cf, size, color, mat or M.Slate, collide)
	K.block(cf * CF(0, size.Y / 2 + 0.12, 0), V3(size.X - 0.5, 0.24, size.Z - 0.5), K.light(color, 0.12), mat or M.Slate)
	return b
end
-- jagged tiered rock mass; returns top height
function K.rockMass(pos, w, h, d, col, mat, tiers, collide)
	tiers = tiers or 3
	local y = 0
	for i = 0, tiers - 1 do
		local k = 1 - i / tiers
		local th = h / tiers * (1 + K.r(-0.15, 0.25))
		K.block(CF(pos + V3(K.r(-1, 1) * w * 0.08, y + th / 2, K.r(-1, 1) * d * 0.08)) * ANG(K.r(-0.05, 0.05), K.r(-0.4, 0.4), K.r(-0.06, 0.06)),
			V3(w * (0.4 + 0.6 * k), th, d * (0.4 + 0.6 * k)), K.dark(col, i * 0.05), mat or M.Slate, collide ~= false)
		y += th * 0.92
	end
	return y
end
-- small boulder cluster (2-3 rotated blocks)
function K.boulder(pos, s, col, mat, capCol)
	local n = K.ri(2, 3)
	for i = 1, n do
		local sz = V3(K.r(2.2, 3.6), K.r(1.4, 2.6), K.r(2.2, 3.6)) * s * (1 - (i - 1) * 0.22)
		local cf = CF(pos + V3(K.r(-1, 1) * s, sz.Y / 2 - 0.3 * s, K.r(-1, 1) * s)) * ANG(K.r(-0.12, 0.12), K.r(0, PI), K.r(-0.12, 0.12))
		K.block(cf, sz, K.dark(col, K.r(0, 0.15)), mat or M.Slate, i == 1)
		if capCol and i == 1 then K.block(cf * CF(0, sz.Y / 2 + 0.15, 0), V3(sz.X * 0.8, 0.3, sz.Z * 0.8), capCol, M.SmoothPlastic) end
	end
end

---------------------------------------------------------------- architecture
-- column with plinth + capital (optionally a second colour for the capital/band)
function K.column(pos, h, w, col, mat, capCol, collide)
	K.block(CF(pos + V3(0, 0.6, 0)), V3(w * 1.5, 1.2, w * 1.5), col, mat, collide ~= false)
	K.block(CF(pos + V3(0, 1.45, 0)), V3(w * 1.25, 0.5, w * 1.25), capCol or col, mat)
	K.block(CF(pos + V3(0, h / 2, 0)), V3(w, h, w), col, mat, collide ~= false)
	K.block(CF(pos + V3(0, h - 0.95, 0)), V3(w * 1.25, 0.5, w * 1.25), capCol or col, mat)
	K.block(CF(pos + V3(0, h + 0.3, 0)), V3(w * 1.55, 1.2, w * 1.55), col, mat)
end
-- round arch in the cf's XY plane: piers (plinth + capital) and voussoir ring with keystone.
-- span = inner width, h = spring height, thick = depth along Z. trim = optional neon/metal inner line colour.
function K.arch(cf, span, h, thick, col, mat, trim, trimMat, segs)
	local pw = math.max(2, thick * 0.9)
	for s = -1, 1, 2 do
		local x = s * (span / 2 + pw / 2)
		K.block(cf * CF(x, 0.8, 0), V3(pw * 1.35, 1.6, thick * 1.2), K.dark(col, 0.08), mat, true)
		K.block(cf * CF(x, h / 2, 0), V3(pw, h, thick), col, mat, true)
		K.block(cf * CF(x, h - 0.4, 0), V3(pw * 1.3, 0.8, thick * 1.15), K.light(col, 0.06), mat)
	end
	local r = span / 2 + pw / 2
	segs = segs or 9
	for i = 1, segs do
		local a0, a1 = (i - 1) / segs * PI, i / segs * PI
		local p0, p1 = V3(math.cos(a0) * r, h + math.sin(a0) * r, 0), V3(math.cos(a1) * r, h + math.sin(a1) * r, 0)
		local mid, dir = (p0 + p1) / 2, p1 - p0
		local key = i == math.ceil(segs / 2)
		K.block(cf * CF(mid) * ANG(0, 0, math.atan2(dir.Y, dir.X)), V3(dir.Magnitude + 0.35, pw * (key and 1.35 or 1), thick * (key and 1.12 or 1)),
			key and K.light(col, 0.1) or col, mat)
		if trim then
			local inner = (p0 + p1) / 2 * ((r - pw / 2 - 0.1) / r) + V3(0, h * (1 - (r - pw / 2 - 0.1) / r), 0)
			K.block(cf * CF(inner) * ANG(0, 0, math.atan2(dir.Y, dir.X)), V3(dir.Magnitude * 0.95, 0.3, thick + 0.1), trim, trimMat or M.Neon)
		end
	end
end
-- gothic pointed arch (two leaning straight halves meeting at a point)
function K.pointedArch(cf, span, h, rise, thick, col, mat, trim)
	for s = -1, 1, 2 do
		K.block(cf * CF(s * (span / 2 + 1), h / 2, 0), V3(2, h, thick), col, mat, true)
		local p0, p1 = V3(s * (span / 2 + 1), h, 0), V3(0, h + rise, 0)
		local mid, dir = (p0 + p1) / 2, p1 - p0
		K.block(cf * CF(mid) * ANG(0, 0, math.atan2(dir.Y, dir.X)), V3(dir.Magnitude + 1.6, 2, thick), col, mat)
		if trim then K.block(cf * CF(mid - V3(0, 1.1, 0)) * ANG(0, 0, math.atan2(dir.Y, dir.X)), V3(dir.Magnitude, 0.3, thick + 0.1), trim, M.Neon) end
	end
end
-- straight stairs going up along cf -Z (front), n steps
function K.stairs(cf, w, n, rise, run, col, mat)
	for i = 0, n - 1 do
		K.block(cf * CF(0, (i + 1) * rise / 2, -(i + 0.5) * run + n * run / 2), V3(w, rise * (i + 1), run), i % 2 == 0 and col or K.dark(col, 0.04), mat, true)
	end
end
-- violet/gold civilisation banner on a pole (the hub motif, used sparingly in biomes)
function K.banner(pos, h, cloth, trim, faceYaw, emblem)
	local pole = C(60, 52, 74)
	K.block(CF(pos + V3(0, h / 2, 0)), V3(0.5, h, 0.5), pole, M.Metal)
	K.pyramid(CF(pos + V3(0, h, 0)), 0.9, 1.2, trim, M.Metal)
	local cf = CF(pos + V3(0, h - 1, 0)) * ANG(0, faceYaw or 0, 0)
	K.block(cf * CF(0, 0, -1.6), V3(0.3, 0.3, 3.6), trim, M.Metal)
	local b = K.block(cf * CF(0, -3.2, -1.6), V3(0.18, 5.8, 2.8), cloth, M.Fabric)
	K.wedge(cf * CF(0, -6.6, -2.3) * ANG(PI, 0, 0), V3(0.18, 1, 1.4), cloth, M.Fabric)
	K.wedge(cf * CF(0, -6.6, -0.9) * ANG(PI, PI, 0), V3(0.18, 1, 1.4), cloth, M.Fabric)
	K.block(cf * CF(0, -0.75, -1.6), V3(0.22, 0.3, 2.9), trim, M.Metal)
	if emblem ~= false then K.block(cf * CF(0, -3.2, -1.6) * ANG(PI / 4, 0, 0), V3(0.24, 1.3, 1.3), trim, M.Neon) end
	K.tag(b, "TPFC_Sway", { Amp = 0.03, Period = K.r(5, 7) })
end
-- lantern post with warm glass lantern and one light
function K.lantern(pos, iron, glow, h)
	h = h or 8
	iron = iron or C(48, 44, 56)
	glow = glow or C(255, 205, 140)
	K.block(CF(pos + V3(0, 0.4, 0)), V3(1.4, 0.8, 1.4), iron, M.Metal, true)
	K.block(CF(pos + V3(0, h / 2, 0)), V3(0.45, h, 0.45), iron, M.Metal, true)
	K.block(CF(pos + V3(0, h + 0.1, 0)), V3(1.3, 0.25, 1.3), iron, M.Metal)
	local g = K.block(CF(pos + V3(0, h + 0.9, 0)), V3(0.95, 1.3, 0.95), glow, M.Glass, false, 0.1)
	K.pyramid(CF(pos + V3(0, h + 1.6, 0)), 1.4, 0.8, iron, M.Metal)
	K.lamp(g, glow, 16, 1)
	return g
end

---------------------------------------------------------------- nature
-- chunky stylised leaf clump (the reference's cartoon canopy: stacked rotated blocks)
local function clump(pos, s, col, sway)
	local b = K.block(CF(pos) * ANG(K.r(-0.1, 0.1), K.r(0, PI), K.r(-0.1, 0.1)), V3(K.r(5, 7), K.r(2.6, 3.6), K.r(5, 7)) * s, col, M.SmoothPlastic)
	K.block(CF(pos + V3(K.r(-0.6, 0.6) * s, 1.4 * s, K.r(-0.6, 0.6) * s)) * ANG(0, K.r(0, PI), 0), V3(K.r(3.4, 4.6), K.r(1.6, 2.2), K.r(3.4, 4.6)) * s, K.light(col, 0.12), M.SmoothPlastic)
	if sway then K.tag(b, "TPFC_Sway", { Amp = 0.008, Period = K.r(5, 8) }) end
	return b
end
K.clump = clump
-- broadleaf tree: flared trunk, 2-3 forked boughs ending in leaf clumps (variants by seed)
function K.tree(pos, s, leaf, bark, sway)
	leaf = leaf or C(98, 176, 70)
	bark = bark or C(118, 82, 52)
	local h = K.r(7, 10) * s
	K.block(CF(pos + V3(0, 0.6 * s, 0)) * ANG(0, PI / 4, 0), V3(2.6, 1.2, 2.6) * s, K.dark(bark, 0.1), M.Wood) -- root flare
	K.block(CF(pos + V3(0, h / 2, 0)), V3(1.6, h, 1.6) * s, bark, M.Wood, true)
	local n = K.ri(2, 3)
	for i = 1, n do
		local a = i / n * PI * 2 + K.r(-0.4, 0.4)
		local tilt = K.r(0.45, 0.75)
		local len = K.r(3.5, 5) * s
		local base = pos + V3(0, h * K.r(0.75, 0.95), 0)
		local dir = (CF(base) * ANG(0, a, 0) * ANG(0, 0, tilt)).UpVector
		K.block(CF(base + dir * len / 2, base + dir * len) * ANG(PI / 2, 0, 0), V3(0.9 * s, len, 0.9 * s), bark, M.Wood)
		local tip = base + dir * len
		clump(tip + V3(0, 1.2 * s, 0), s * K.r(0.85, 1.1), leaf:Lerp(i % 2 == 0 and C(70, 140, 60) or C(150, 205, 95), K.r(0, 0.25)), sway)
	end
	clump(pos + V3(0, h + 2.6 * s, 0), s * 1.15, leaf, sway)
end
-- tiered conifer; snow = add white shelf caps
function K.pine(pos, s, col, snow, trunkCol)
	col = col or C(46, 112, 74)
	K.block(CF(pos + V3(0, 1.6 * s, 0)), V3(1.2, 3.2, 1.2) * s, trunkCol or C(104, 72, 48), M.Wood, true)
	for k = 0, 3 do
		local w = (7.5 - k * 1.6) * s
		local y = (3 + k * 2.4) * s
		local yaw = k * 0.6 + K.r(0, 0.3)
		K.block(CF(pos + V3(0, y, 0)) * ANG(0, yaw, 0), V3(w, 2.2 * s, w), K.dark(col, k * 0.03), M.SmoothPlastic)
		if snow then K.block(CF(pos + V3(0, y + 1.2 * s, 0)) * ANG(0, yaw, 0), V3(w * 0.82, 0.45 * s, w * 0.82), C(246, 250, 255), M.SmoothPlastic) end
	end
	K.pyramid(CF(pos + V3(0, (3 + 4 * 2.4 - 1.1) * s, 0)), 1.6 * s, 2.4 * s, col, M.SmoothPlastic)
end
function K.bush(pos, s, col)
	col = col or C(84, 156, 66)
	for i = 1, 3 do
		K.block(CF(pos + V3((i - 2) * 1.2 * s, (0.8 + (i == 2 and 0.4 or 0)) * s, K.r(-0.5, 0.5) * s)) * ANG(0, K.r(0, PI), 0),
			V3(K.r(2, 2.8), K.r(1.6, 2.2), K.r(2, 2.8)) * s, col:Lerp(C(140, 200, 90), K.r(0, 0.3)), M.SmoothPlastic)
	end
end
-- fern: crossed angled fronds
function K.fern(pos, s, col)
	col = col or C(70, 160, 70)
	for i = 0, 4 do
		local a = i / 5 * PI * 2 + K.r(-0.2, 0.2)
		K.wedge(CF(pos) * ANG(0, a, 0) * CF(0, 0.9 * s, -1.3 * s) * ANG(-0.5, 0, 0), V3(0.9, 0.2, 2.6) * s, col, M.SmoothPlastic)
	end
end
-- five-petal flower cluster (pink/white reference flowers) on leaves
function K.flowers(pos, s, petal, centre)
	petal = petal or C(255, 150, 200)
	centre = centre or C(255, 220, 90)
	K.block(CF(pos + V3(0, 0.25 * s, 0)) * ANG(0, K.r(0, PI), 0), V3(2.2, 0.5, 2.2) * s, C(80, 160, 70), M.SmoothPlastic)
	for f = 1, K.ri(2, 3) do
		local c = pos + V3(K.r(-0.8, 0.8) * s, (0.9 + f * 0.25) * s, K.r(-0.8, 0.8) * s)
		for i = 0, 4 do
			K.block(CF(c) * ANG(0, i / 5 * PI * 2, 0) * CF(0, 0, -0.38 * s) * ANG(-0.3, 0, 0), V3(0.42, 0.12, 0.6) * s, petal, M.SmoothPlastic)
		end
		K.block(CF(c + V3(0, 0.06 * s, 0)), V3(0.3, 0.16, 0.3) * s, centre, M.SmoothPlastic)
	end
end
function K.mushroom(pos, s, cap, glow)
	cap = cap or C(196, 92, 60)
	K.block(CF(pos + V3(0, 0.9 * s, 0)), V3(0.9, 1.8, 0.9) * s, C(244, 232, 214), M.SmoothPlastic)
	local c = K.block(CF(pos + V3(0, 2, 0) * s), V3(2.8, 0.9, 2.8) * s, cap, glow and M.Neon or M.SmoothPlastic)
	K.block(CF(pos + V3(0, 2.5, 0) * s), V3(1.8, 0.5, 1.8) * s, K.light(cap, 0.08), glow and M.Neon or M.SmoothPlastic)
	if not glow then
		for i = 1, 3 do K.block(CF(pos + V3(K.r(-0.9, 0.9), 2.5, K.r(-0.9, 0.9)) * s), V3(0.35, 0.55, 0.35) * s, C(255, 244, 230), M.SmoothPlastic) end
	end
	return c
end
-- grass tuft (spiky blades) for ground cover
function K.tuft(pos, s, col)
	for i = 0, 2 do
		K.wedge(CF(pos) * ANG(0, i * 1.1, 0) * CF(0, 0.5 * s, 0), V3(0.15, 1, 0.6) * s, col, M.SmoothPlastic)
	end
end

---------------------------------------------------------------- crystals
function K.crystal(base, len, w, col, tilt, glow, transp)
	local cf = CF(base) * (tilt or CF())
	local body = K.block(cf * CF(0, len * 0.31, 0) * ANG(0, PI / 4, 0), V3(w, len * 0.62, w), col, glow and M.Neon or M.Glass, false, glow and 0 or (transp or 0.05))
	K.pyramid(cf * CF(0, len * 0.62, 0) * ANG(0, PI / 4, 0), w, len * 0.38, K.light(col, 0.2), glow and M.Neon or M.Glass)
	return body
end
function K.crystalCluster(base, s, cols, glowIndex)
	local core
	for i = 0, 4 do
		local a = i / 5 * PI * 2
		local c = K.crystal(base + V3(math.cos(a) * 1.1 * s, -0.3, math.sin(a) * 1.1 * s), K.r(3, 5) * s * (i == 0 and 1.5 or 1), K.r(1.1, 1.5) * s,
			cols[(i % #cols) + 1], ANG(math.sin(a) * 0.35, 0, -math.cos(a) * 0.35), i == glowIndex)
		if i == 0 then core = c end
	end
	return core
end

---------------------------------------------------------------- water
function K.water(cf, size, col, transp)
	local w = K.block(cf, size, col or C(90, 205, 225), M.Glass, false, transp or 0.3)
	w.CastShadow = false
	return w
end
-- stepped waterfall falling along -Y from top, facing faceDir (unit X or Z vector); foam at the base
function K.waterfall(top, h, w, faceYaw, col, foamCol)
	col = col or C(140, 220, 240)
	local cf = CF(top) * ANG(0, faceYaw or 0, 0)
	local n = math.max(2, math.floor(h / 6))
	for i = 0, n - 1 do
		local seg = K.block(cf * CF(0, -(i + 0.5) * h / n, -i * 0.15), V3(w, h / n + 0.2, 0.8), i % 2 == 0 and col or K.light(col, 0.15), M.Glass, false, 0.15)
		seg.CastShadow = false
		if i % 2 == 0 then K.tag(seg, "TPFC_Pulse", { Period = K.r(3, 5), Base = 0.15, Peak = 0.02 }) end
	end
	for i = -1, 1 do
		K.block(cf * CF(i * w * 0.32, -h + 0.4, -1.4) * ANG(0, K.r(0, 1), 0), V3(w * 0.4, 0.9, 1.8), foamCol or C(240, 250, 255), M.SmoothPlastic)
	end
end

---------------------------------------------------------------- big landscape generators
-- Stepped side terraces (the reference diorama silhouette): along both sides of z1..z2,
-- tier 1 is low (top <= 4.5) from |X| >= 46; taller tiers start at |X| >= 56.
-- P = { rock, rockMat, cap, capMat, drip (bool), skip = { {side, z1, z2}, ... }, tiers (2|3),
--       h1 = {min,max}, h2 = {min,max}, h3 = {min,max}, edge = optional fn(pos, side) for lane-edge props }
function K.terraces(z1, z2, P)
	local rock, cap = P.rock, P.cap
	local rockMat, capMat = P.rockMat or M.Slate, P.capMat or M.SmoothPlastic
	local function skipped(s, za, zb)
		for _, sk in ipairs(P.skip or {}) do
			if sk[1] == s and zb > sk[2] and za < sk[3] then return true end
		end
		return false
	end
	for s = -1, 1, 2 do
		local z = z1
		while z < z2 - 2 do
			local len = math.min(K.r(14, 24), z2 - z)
			local za, zb = z, z + len
			local zc = (za + zb) / 2
			if not skipped(s, za, zb) then
				-- tier 1: low shelf at the lane edge
				local x1 = K.r(46, 50)
				local y1 = K.r(P.h1 and P.h1[1] or 2.2, P.h1 and P.h1[2] or 4.2)
				local outer = 86
				local col1 = rock:Lerp(K.dark(rock, 0.12), K.r(0, 1))
				K.block(CF(s * (x1 + outer) / 2, (y1 - 6) / 2, zc), V3(outer - x1, y1 + 6, len + 0.4), col1, rockMat, true)
				local capJ = cap:Lerp(K.dark(cap, 0.25), K.r(0, 0.5))
				K.block(CF(s * ((x1 + outer) / 2 - 0.4), y1 + 0.35, zc), V3(outer - x1 + 0.8, 0.7, len + 0.6), capJ, capMat, true)
				K.addSurface(s * x1, s * outer, za, zb, y1 + 0.7)
				if P.drip and K.chance(0.7) then
					for _ = 1, K.ri(1, 2) do
						local dz = K.r(za + 1.5, zb - 1.5)
						local dh = K.r(1, 2.4)
						K.block(CF(s * (x1 - 0.15), y1 - dh / 2 + 0.2, dz), V3(0.5, dh, K.r(1.2, 2.6)), cap, capMat)
					end
				end
				-- tier 2: taller shelf set back (staggered ends)
				local x2 = math.max(56, x1 + K.r(8, 14))
				local y2 = y1 + K.r(P.h2 and P.h2[1] or 5, P.h2 and P.h2[2] or 10)
				local i0, i1 = K.r(0, 3), K.r(0, 3)
				local l2 = len - i0 - i1
				if l2 > 6 then
					local z2c = za + i0 + l2 / 2
					K.block(CF(s * (x2 + 104) / 2, y2 / 2 - 1, z2c), V3(104 - x2, y2 + 2, l2), rock:Lerp(K.dark(rock, 0.18), K.r(0, 1)), rockMat, true)
					K.block(CF(s * ((x2 + 104) / 2 - 0.4), y2 + 0.4, z2c), V3(104 - x2 + 0.8, 0.8, l2 + 0.3), cap:Lerp(K.light(cap, 0.2), K.r(0, 0.5)), capMat)
					K.addSurface(s * x2, s * 104, z2c - l2 / 2, z2c + l2 / 2, y2 + 0.8)
					if P.drip and K.chance(0.6) then
						local dh = K.r(1.5, 3.5)
						K.block(CF(s * (x2 - 0.15), y2 - dh / 2 + 0.2, K.r(za + i0 + 1, za + i0 + l2 - 1)), V3(0.5, dh, K.r(1.5, 3)), cap, capMat)
					end
					-- tier 3: high ridge (optional)
					if (P.tiers or 2) >= 3 and K.chance(0.65) then
						local x3 = x2 + K.r(10, 18)
						local y3 = y2 + K.r(P.h3 and P.h3[1] or 6, P.h3 and P.h3[2] or 16)
						local l3 = l2 * K.r(0.55, 0.9)
						local z3c = za + i0 + K.r(0, l2 - l3) + l3 / 2
						K.block(CF(s * (x3 + 118) / 2, y3 / 2, z3c), V3(118 - x3, y3, l3), K.dark(rock, K.r(0.05, 0.25)), rockMat, true)
						K.block(CF(s * ((x3 + 118) / 2 - 0.4), y3 + 0.4, z3c), V3(118 - x3 + 0.8, 0.8, l3 + 0.3), cap, capMat)
						K.addSurface(s * x3, s * 118, z3c - l3 / 2, z3c + l3 / 2, y3 + 0.8)
					end
				end
				if P.facade then P.facade(s, x1, y1 + 0.7, za, zb) end
				if P.edge then P.edge(V3(s * K.r(41, 44.5), 0, K.r(za + 2, zb - 2)), s) end
			end
			z += len
		end
	end
end
-- distant blocky mountains (terrain wedges) beyond the terraces, skyline only
function K.mountains(z1, z2, mat, xMin, xMax, hMin, hMax)
	local T = K.terrain
	for s = -1, 1, 2 do
		local z = z1
		while z < z2 do
			local w = K.r(50, 90)
			local h = K.r(hMin or 40, hMax or 110)
			local x = s * K.r(xMin or 130, xMax or 190)
			local cf = CF(x, h / 2 - 8, z + w / 2) * ANG(0, K.r(-0.3, 0.3), 0)
			T:FillWedge(cf, V3(w, h, w * 0.6), mat)
			T:FillWedge(cf * ANG(0, PI, 0), V3(w, h, w * 0.6), mat)
			z += w * K.r(0.55, 0.8)
		end
	end
end

---------------------------------------------------------------- signage
do
	local ok, f = pcall(function() return Enum.Font.MontserratBlack end)
	K.SIGN_FONT = ok and f or Enum.Font.GothamBlack
end
function K.textSurface(p, text, color, face, font, stroke)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face or Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(600, 120)
	sg.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = font or K.SIGN_FONT
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = color or Color3.new(1, 1, 1)
	local st = Instance.new("UIStroke"); st.Thickness = 2.5; st.Transparency = 0.15; st.Color = stroke or C(30, 20, 40); st.Parent = t
	t.Parent = sg
	sg.Parent = p
	return t
end

---------------------------------------------------------------- DETAIL KIT (reference-matching pieces)
-- bevelled cut stone: body + inset top + 4 chamfer wedges; optional moss cap with drapes
function K.bevel(cf, size, col, mat, moss, collide)
	mat = mat or M.Limestone
	local b = 0.6
	K.block(cf * CF(0, -b / 2, 0), V3(size.X, size.Y - b, size.Z), col, mat, collide ~= false)
	K.block(cf * CF(0, size.Y / 2 - b / 2, 0), V3(size.X - 2 * b, b, size.Z - 2 * b), K.light(col, 0.06), mat)
	local hx, hz, y = size.X / 2 - b / 2, size.Z / 2 - b / 2, size.Y / 2 - b / 2
	K.wedge(cf * CF(hx, y, 0) * ANG(0, -PI / 2, 0), V3(size.Z - 2 * b, b, b), col, mat)
	K.wedge(cf * CF(-hx, y, 0) * ANG(0, PI / 2, 0), V3(size.Z - 2 * b, b, b), col, mat)
	K.wedge(cf * CF(0, y, hz) * ANG(0, PI, 0), V3(size.X - 2 * b, b, b), col, mat)
	K.wedge(cf * CF(0, y, -hz), V3(size.X - 2 * b, b, b), col, mat)
	if moss then
		K.block(cf * CF(K.r(-0.3, 0.3), size.Y / 2 + 0.1, K.r(-0.3, 0.3)), V3(size.X * K.r(0.6, 0.95), 0.3, size.Z * K.r(0.6, 0.95)), moss, M.SmoothPlastic)
		for _ = 1, K.ri(0, 1) do
			local side = K.ri(1, 4)
			local dh = K.r(0.8, size.Y * 0.6)
			local off = side <= 2 and CF((side == 1 and 1 or -1) * (size.X / 2 + 0.08), size.Y / 2 - dh / 2, K.r(-size.Z / 3, size.Z / 3))
				or CF(K.r(-size.X / 3, size.X / 3), size.Y / 2 - dh / 2, (side == 3 and 1 or -1) * (size.Z / 2 + 0.08))
			K.block(cf * off, V3(side <= 2 and 0.2 or K.r(0.8, 1.8), dh, side <= 2 and K.r(0.8, 1.8) or 0.2), moss, M.SmoothPlastic)
		end
	end
end
-- chain of tapered blocks along a quadratic bezier (curved trunks, limbs, roots); returns end, middle
function K.limb(p0, p1, p2, r0, r1, n, col, mat, collide)
	local function bz(t) return p0 * (1 - t) ^ 2 + p1 * 2 * (1 - t) * t + p2 * t * t end
	for i = 0, n - 1 do
		local a, b = bz(i / n), bz((i + 1) / n)
		local r = r0 + (r1 - r0) * (i + 0.5) / n
		local len = (b - a).Magnitude
		if len > 0.05 then
			K.block(CFrame.lookAt((a + b) / 2, b) * ANG(0, 0, (i % 2) * PI / 4), V3(r, r, len + r * 0.5), col, mat or M.Wood, collide == true and i < 2)
		end
	end
	return bz(1), bz(0.5)
end
-- leaf rosette: rounded core + highlight cap + pointed leaves fanning out (the reference canopy lobe)
function K.rosette(pos, s, col, sway)
	local hi, sh = K.light(col, 0.18), K.dark(col, 0.22)
	local core = K.ellipsoid(CF(pos), V3(5, 3.8, 5) * s, sh, M.SmoothPlastic)
	K.ellipsoid(CF(pos + V3(0.3 * s, 0.9 * s, 0.2 * s)), V3(4.2, 3.2, 4.2) * s, col, M.SmoothPlastic)
	K.ellipsoid(CF(pos + V3(-0.5 * s, 1.7 * s, -0.4 * s)), V3(2.8, 2.2, 2.8) * s, hi, M.SmoothPlastic)
	local off = K.r(0, PI)
	for i = 0, 3 do
		local a = off + i / 4 * PI * 2
		local up = (i % 2 == 0) and 0.6 or -0.4
		K.wedge(CF(pos + V3(0, up * s, 0)) * ANG(0, a, 0) * CF(0, 0, -2.6 * s) * ANG(-0.35 + up * 0.3, 0, 0), V3(1.7, 0.45, 2.3) * s, i % 2 == 0 and col or sh, M.SmoothPlastic)
	end
	if sway then K.tag(core, "TPFC_Sway", { Amp = 0.006, Period = K.r(5, 8) }) end
	return core
end
-- canopy cloud: n rosettes scattered in an ellipsoid dome around centre
function K.canopy(centre, rx, ry, n, s, cols, sway)
	for i = 1, n do
		local a = K.r(0, PI * 2)
		local d = math.sqrt(K.r(0, 1))
		local y = K.r(-0.4, 1) * ry
		local k = 1 - math.max(0, y / ry) * 0.5
		K.rosette(centre + V3(math.cos(a) * d * rx * k, y, math.sin(a) * d * rx * k), s * K.r(0.85, 1.15), K.pick(cols), sway and i % 3 == 0)
	end
end
-- broadleaf tree: curved trunk with root flare, forked limbs, rosette canopy (leanDir = unit-ish lean)
function K.bigTree(pos, s, cols, bark, leanDir)
	bark = bark or C(126, 86, 54)
	local barkD = K.dark(bark, 0.2)
	leanDir = leanDir or V3(0, 0, 0)
	for i = 0, 4 do
		local a = i / 5 * PI * 2 + K.r(-0.3, 0.3)
		local d = V3(math.cos(a), 0, math.sin(a))
		K.limb(pos + V3(0, 2.2 * s, 0), pos + d * 1.8 * s + V3(0, 0.8 * s, 0), pos + d * 4.2 * s + V3(0, -0.3, 0), 1.3 * s, 0.6 * s, 2, barkD)
	end
	local top = pos + leanDir * 4 * s + V3(0, 11 * s, 0)
	K.limb(pos, pos + V3(0, 6 * s, 0) - leanDir * 1.5 * s, top, 2.6 * s, 1.7 * s, 5, bark, M.Wood, true)
	local nl = K.ri(4, 5)
	for i = 1, nl do
		local a = i / nl * PI * 2 + K.r(-0.3, 0.3)
		local d = V3(math.cos(a), 0, math.sin(a)) + leanDir * 0.4
		local tip = top + d * K.r(8, 11) * s + V3(0, K.r(3, 6) * s, 0)
		local _, mid = K.limb(top - V3(0, 1.5 * s, 0), top + d * 3 * s + V3(0, 3.5 * s, 0), tip, 1.3 * s, 0.6 * s, 3, bark)
		K.limb(mid, mid + d * 2 * s + V3(0, 2 * s, 0), mid + V3(-d.Z, 0, d.X) * 4 * s + V3(0, 4 * s, 0), 0.6 * s, 0.35 * s, 2, barkD)
		K.canopy(tip + V3(0, 1.5 * s, 0), 3.5 * s, 2 * s, 3, 0.95 * s, cols, true)
	end
	K.canopy(top + V3(0, 7 * s, 0), 6 * s, 3 * s, 6, 1.05 * s, cols, true)
end
-- big lily clump: ground leaves + 2-3 six-petal flowers on stems
function K.lily(pos, s, petal, inner)
	petal = petal or C(255, 170, 205)
	inner = inner or C(236, 90, 150)
	for i = 0, 2 do
		local a = i / 3 * PI * 2 + K.r(-0.2, 0.2)
		K.ellipsoid(CF(pos) * ANG(0, a, 0) * CF(0, 0.25 * s, -1.2 * s) * ANG(-0.15, 0, 0), V3(1.3, 0.25, 2.4) * s, C(78, 150, 64), M.SmoothPlastic)
	end
	for f = 1, K.ri(1, 2) do
		local c = pos + V3(K.r(-0.9, 0.9) * s, (1.2 + f * 0.5) * s, K.r(-0.9, 0.9) * s)
		K.block(CF((pos + c) / 2), V3(0.18 * s, (c - pos).Y, 0.18 * s), C(90, 160, 70), M.SmoothPlastic)
		local yaw = K.r(0, PI)
		for i = 0, 5 do
			local pcf = CF(c) * ANG(0, yaw + i / 6 * PI * 2, 0) * CF(0, 0.25 * s, -0.75 * s) * ANG(0.55, 0, 0)
			K.ellipsoid(pcf, V3(0.7, 0.16, 1.6) * s, petal, M.SmoothPlastic)
		end
		K.block(CF(c + V3(0, 0.3 * s, 0)), V3(0.35, 0.5, 0.35) * s, C(255, 214, 90), M.SmoothPlastic)
	end
end
-- spotted mushroom (dome cap, gills, cream spots)
function K.toadstool(pos, s, cap)
	cap = cap or C(176, 92, 58)
	K.vcyl(pos, 2.4 * s, 1.1 * s, C(246, 234, 214), M.SmoothPlastic)
	K.vcyl(pos, 0.5 * s, 1.5 * s, C(236, 222, 200), M.SmoothPlastic)
	K.ellipsoid(CF(pos + V3(0, 2.5 * s, 0)), V3(3.6, 0.5, 3.6) * s, C(236, 214, 186), M.SmoothPlastic)
	K.ellipsoid(CF(pos + V3(0, 2.9 * s, 0)), V3(4, 2.2, 4) * s, cap, M.SmoothPlastic)
	for i = 0, 4 do
		local a = i / 5 * PI * 2 + K.r(0, 1)
		local r = K.r(0.6, 1.3) * s
		K.ellipsoid(CF(pos + V3(math.cos(a) * r, 3.75 * s - r * 0.25, math.sin(a) * r)), V3(0.6, 0.2, 0.6) * s, C(252, 240, 220), M.SmoothPlastic)
	end
end
-- arching fern: seven fronds of three bending segments
function K.fernBig(pos, s, col)
	col = col or C(74, 150, 60)
	for i = 0, 6 do
		local a = i / 7 * PI * 2 + K.r(-0.2, 0.2)
		local cf = CF(pos) * ANG(0, a, 0)
		local p = CF(0, 0.2 * s, 0) * ANG(0.9, 0, 0)
		for k = 0, 2 do
			local seg = 1.3 * s * (1 - k * 0.15)
			local w = (1.2 - k * 0.3) * s
			K.wedge(cf * p * CF(0, 0, -seg / 2) * ANG(0, PI, 0), V3(w, 0.15, seg), k == 1 and K.light(col, 0.12) or col, M.SmoothPlastic)
			p = p * CF(0, 0, -seg) * ANG(-0.45, 0, 0)
		end
	end
end
-- clover patch (flush trefoil)
function K.clover(pos, s, col)
	col = col or C(110, 176, 72)
	for i = 0, 2 do
		local a = i / 3 * PI * 2
		K.ellipsoid(CF(pos + V3(math.cos(a) * 0.45 * s, 0.1, math.sin(a) * 0.45 * s)), V3(0.9, 0.12, 0.9) * s, col, M.SmoothPlastic)
	end
end
-- hanging vine with leaves
function K.vine(top, len, col)
	col = col or C(84, 156, 62)
	K.block(CF(top - V3(0, len / 2, 0)), V3(0.18, len, 0.18), K.dark(col, 0.2), M.SmoothPlastic)
	for y = 0.6, len, 1.1 do
		K.ellipsoid(CF(top - V3(0, y, 0)) * ANG(0, K.r(0, PI), 0.4) * CF(0.35, 0, 0), V3(0.8, 0.15, 0.5), col, M.SmoothPlastic)
	end
end
-- carved relief leaf glyph on a face (cf = centre on the face, glyph plane = cf XY)
function K.leafGlyph(cf, s, col)
	K.block(cf * ANG(0, 0, PI / 4), V3(1.1, 1.1, 0.12) * s, col, M.Limestone)
	K.block(cf * CF(0, -0.9 * s, 0), V3(0.18, 0.8, 0.12) * s, col, M.Limestone)
	K.block(cf * CF(0, 0.1 * s, -0.04), V3(0.12, 1.1, 0.12) * s, K.dark(col, 0.15), M.Limestone)
end

-- faceted cone (n wedge facets sloping outward from the apex) — volcanoes, jagged peaks, crystal mounds
function K.cone(pos, R, H, n, colA, colB, mat, collide)
	local off = K.r(0, PI)
	for i = 0, n - 1 do
		local a = off + i / n * PI * 2
		local dir = V3(math.cos(a), 0, math.sin(a))
		local mid = pos + dir * R * 0.5 + V3(0, H / 2, 0)
		K.wedge(CFrame.lookAt(mid, mid + dir), V3(2 * PI * R / n * 1.12, H, R), (i % 2 == 0) and colA or (colB or colA), mat or M.Slate, collide == true)
	end
	return pos + V3(0, H, 0)
end

---------------------------------------------------------------- biome gate
-- themed biome gate: two pylons at |X| = 58 with name plaques facing the hall (shared by all biomes)
function K.gate(text, z, stone, mat, glow, cap)
	for s = -1, 1, 2 do
		local x = s * 58
		K.block(CF(x, 1.2, z), V3(10, 2.4, 10), K.dark(stone, 0.1), mat, true)
		K.block(CF(x, 15, z), V3(6.5, 26, 6.5), stone, mat, true)
		K.block(CF(x, 28.6, z), V3(8, 1.4, 8), cap or stone, mat)
		K.pyramid(CF(x, 29.3, z), 6.4, 6, C(232, 190, 90), M.Metal)
		local strip = K.block(CF(x - s * 3.3, 15, z), V3(0.25, 20, 1.4), glow, M.Neon, false, 0.15)
		K.tag(strip, "TPFC_Pulse", { Period = 9, Base = 0.3, Peak = 0.05 })
		local plaque = K.block(CF(x, 19, z - 3.4), V3(9.5, 3.4, 0.5), C(58, 40, 92), M.SmoothPlastic)
		K.block(CF(x, 20.85, z - 3.4), V3(10, 0.3, 0.6), C(232, 190, 90), M.Metal)
		K.block(CF(x, 17.15, z - 3.4), V3(10, 0.3, 0.6), C(232, 190, 90), M.Metal)
		K.textSurface(plaque, text, C(255, 240, 200), Enum.NormalId.Front)
	end
end

return K
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">WorldLandmarks</string><ProtectedString name="Source"><![CDATA[-- WorldLandmarks: construction kit + the hero landmarks for the hub, launch hall and all
-- eight biomes (blocky architectural language from the map reference pack).
-- Location: ServerScriptService > Server > WorldLandmarks (ModuleScript)
--
-- RULES (from the map brief):
--  * Landing X is clamped to [-30, 30]. Everything taller than ~0.4 studs stays at |X| >= 44,
--    and nothing hangs over the corridor. Landing rays only hit Terrain (GameServer contract),
--    so decorative parts can never become the floor; all parts here are CanQuery = false.
--  * Each biome: ONE main landmark, two supporting forms, a quiet reveal foreground.
--  * Deterministic per-biome Random seeds -> rebuilding never drifts the layout.
--  * Motion is NOT done here: parts are tagged (CollectionService) and the client WorldFx
--    scheduler animates nearby tagged parts at a low rate.

local CollectionService = game:GetService("CollectionService")

local L = {}
local PI = math.pi
local V3, CF, ANG = Vector3.new, CFrame.new, CFrame.Angles
local function C(r, g, b) return Color3.fromRGB(r, g, b) end
local M = Enum.Material

local parentFolder -- current output folder (set by WorldBuilder)
local terrain
local rng = Random.new(1)

function L.SetFolder(f) parentFolder = f end
function L.SetTerrain(t) terrain = t end
function L.Seed(n) rng = Random.new(n) end

---------------------------------------------------------------- kit primitives
local function part(class, size, cf, color, mat, collide, transp)
	local p = Instance.new(class)
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or M.SmoothPlastic
	p.Anchored = true
	p.CanCollide = collide == true
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = transp or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = size.Magnitude > 6
	p.Parent = parentFolder
	return p
end
local function block(cf, size, color, mat, collide, transp) return part("Part", size, cf, color, mat, collide, transp) end
local function wedge(cf, size, color, mat, collide, transp) return part("WedgePart", size, cf, color, mat, collide, transp) end
local function corner(cf, size, color, mat) return part("CornerWedgePart", size, cf, color, mat) end
local function ballP(pos, d, color, mat, transp)
	local p = part("Part", V3(d, d, d), CF(pos), color, mat, false, transp)
	p.Shape = Enum.PartType.Ball
	return p
end
local function cylP(cf, len, d, color, mat, transp) -- axis along cf X
	local p = part("Part", V3(len, d, d), cf, color, mat, false, transp)
	p.Shape = Enum.PartType.Cylinder
	return p
end
local function vcylP(pos, h, d, color, mat, transp)
	return cylP(CF(pos + V3(0, h / 2, 0)) * ANG(0, 0, PI / 2), h, d, color, mat, transp)
end
local function light(p, color, range, brightness)
	local l = Instance.new("PointLight"); l.Color = color; l.Range = range; l.Brightness = brightness or 1.2; l.Shadows = false; l.Parent = p
	return l
end
local function tag(p, name, attrs)
	CollectionService:AddTag(p, name)
	for k, v in pairs(attrs or {}) do p:SetAttribute(k, v) end
	return p
end
L.block, L.wedge, L.ball, L.light, L.tag = block, wedge, ballP, light, tag

-- pyramid cap made of 4 wedges (base centred at cf, pointing up)
local function pyramid(cf, w, h, color, mat)
	for i = 0, 3 do
		wedge(cf * ANG(0, i * PI / 2, 0) * CF(0, h / 2, -w / 4), V3(w, h, w / 2), color, mat)
	end
end
-- simple block arch: two piers + segmented top
local function arch(cf, span, h, thick, color, mat, trim)
	for s = -1, 1, 2 do block(cf * CF(s * span / 2, h / 2, 0), V3(thick, h, thick), color, mat, true) end
	local r = span / 2
	for i = 1, 9 do
		local a0, a1 = (i - 1) / 9 * PI, i / 9 * PI
		local p0, p1 = V3(math.cos(a0) * r, h + math.sin(a0) * r * 0.6, 0), V3(math.cos(a1) * r, h + math.sin(a1) * r * 0.6, 0)
		local mid = (p0 + p1) / 2
		local dir = p1 - p0
		block(cf * CF(mid) * ANG(0, 0, math.atan2(dir.Y, dir.X)), V3(dir.Magnitude + 0.3, thick * 0.8, thick), color, mat)
		if trim then block(cf * CF(mid + V3(0, 0, -thick * 0.52)) * ANG(0, 0, math.atan2(dir.Y, dir.X)), V3(dir.Magnitude, 0.35, 0.2), trim, M.Neon) end
	end
end
-- jagged layered rock mass (blocky geology): tapered rotated tiers
local function rockMass(pos, w, h, d, col, mat, tiers)
	tiers = tiers or 4
	local y = 0
	for i = 0, tiers - 1 do
		local k = 1 - i / tiers
		local th = h / tiers * (1 + rng:NextNumber(-0.15, 0.25))
		block(CF(pos + V3(rng:NextNumber(-1, 1) * w * 0.08, y + th / 2, rng:NextNumber(-1, 1) * d * 0.08)) * ANG(rng:NextNumber(-0.06, 0.06), rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.08, 0.08)),
			V3(w * (0.35 + 0.65 * k), th, d * (0.35 + 0.65 * k)), col:Lerp(C(0, 0, 0), i * 0.04), mat or M.Slate, true)
		y += th * 0.92
	end
	return y
end
-- blocky canopy group (several overlapping slabs) — tagged for gentle wind sway
local function canopy(pos, s, cols)
	for i = 1, 5 do
		local off = V3(rng:NextNumber(-1, 1) * 4 * s, rng:NextNumber(0, 1) * 3 * s, rng:NextNumber(-1, 1) * 4 * s)
		local b = block(CF(pos + off) * ANG(0, rng:NextNumber(0, PI), 0), V3(rng:NextNumber(7, 11), rng:NextNumber(4, 6), rng:NextNumber(7, 11)) * s,
			cols[(i % #cols) + 1], M.Grass)
		tag(b, "TPFC_Sway", { Amp = 0.012, Period = rng:NextNumber(5, 8) })
	end
end
-- four blocky tree silhouettes (variant 1..4)
local function tree(pos, s, variant, cols)
	local trunk = C(110, 78, 50)
	if variant == 1 then -- round broadleaf
		block(CF(pos + V3(0, 4 * s, 0)), V3(1.6, 8, 1.6) * s, trunk, M.Wood, true)
		canopy(pos + V3(0, 10 * s, 0), s * 0.8, cols)
	elseif variant == 2 then -- tall stacked conifer-ish
		block(CF(pos + V3(0, 3 * s, 0)), V3(1.4, 6, 1.4) * s, trunk, M.Wood, true)
		for i = 0, 3 do block(CF(pos + V3(0, (6 + i * 3) * s, 0)) * ANG(0, i * 0.4, 0), V3(9 - i * 2, 3, 9 - i * 2) * s, cols[1]:Lerp(C(20, 60, 30), 0.25), M.Grass) end
	elseif variant == 3 then -- wide umbrella
		block(CF(pos + V3(0, 5 * s, 0)), V3(1.8, 10, 1.8) * s, trunk, M.Wood, true)
		for k = -1, 1, 2 do block(CF(pos + V3(k * 2 * s, 9 * s, 0)) * ANG(0, 0, k * 0.6), V3(1, 5, 1) * s, trunk, M.Wood) end
		block(CF(pos + V3(0, 12 * s, 0)), V3(16, 3, 13) * s, cols[2] or cols[1], M.Grass)
	else -- pale birch with two small crowns
		block(CF(pos + V3(0, 6 * s, 0)), V3(1.1, 12, 1.1) * s, C(225, 222, 210), M.Wood, true)
		block(CF(pos + V3(1.5 * s, 11 * s, 0)), V3(6, 4, 6) * s, cols[3] or cols[1], M.Grass)
		block(CF(pos + V3(-1.5 * s, 14 * s, 0.5 * s)), V3(5, 4, 5) * s, cols[4] or cols[1], M.Grass)
	end
end
local function crystal(base, len, w, col, tilt, glow)
	local cf = CF(base) * tilt
	local body = block(cf * CF(0, len * 0.31, 0) * ANG(0, PI / 4, 0), V3(w, len * 0.62, w), col, glow and M.Neon or M.Glass, false, glow and 0 or 0.08)
	pyramid(cf * CF(0, len * 0.62, 0) * ANG(0, PI / 4, 0), w, len * 0.38, col:Lerp(C(255, 255, 255), 0.2), M.Glass)
	return body
end
local function crystalFan(pos, s, cols, facing)
	for i = -3, 3 do
		local c = crystal(pos + V3(i * 2.2 * s, 0, 0), (10 - math.abs(i) * 2.2) * s, 2.4 * s, cols[(i + 4) % #cols + 1], ANG(0, facing or 0, 0) * ANG(-0.15, 0, -i * 0.16), i == 0)
		if i == 0 then tag(c, "TPFC_Pulse", { Period = 3, Base = 0, Peak = 0.35 }) end
	end
end
local function column(pos, h, w, col, mat, capCol)
	block(CF(pos + V3(0, 0.6, 0)), V3(w * 1.5, 1.2, w * 1.5), col, mat, true)
	block(CF(pos + V3(0, h / 2, 0)), V3(w, h, w), col, mat, true)
	block(CF(pos + V3(0, h + 0.6, 0)), V3(w * 1.5, 1.2, w * 1.5), capCol or col, mat)
end
local function rune(cf, w, h, col)
	local r = block(cf, V3(w, h, 0.25), col, M.Neon, false, 0.1)
	tag(r, "TPFC_Pulse", { Period = rng:NextNumber(9, 15), Base = 0.75, Peak = 0.1 })
	return r
end

-- side position helper: keeps scenery out of the landing corridor (|X| >= 44)
local function sideX(sign, near, far) return sign * rng:NextNumber(near or 46, far or 66) end

---------------------------------------------------------------- organic kit (curved forms for the hub)
local function ellipsoid(cf, size, color, mat, transp)
	local p = part("Part", size, cf, color, mat, false, transp)
	local m = Instance.new("SpecialMesh"); m.MeshType = Enum.MeshType.Sphere; m.Parent = p
	return p
end
L.ellipsoid = ellipsoid

-- stylized broadleaf tree: flared trunk, two limbs, layered leafy crowns
function L.Tree(pos, s, leaf)
	leaf = leaf or C(96, 170, 72)
	local bark = C(112, 82, 58)
	vcylP(pos, 1.2 * s, 2.6 * s, bark:Lerp(C(0, 0, 0), 0.1), M.Wood) -- root flare
	vcylP(pos, 9 * s, 1.5 * s, bark, M.Wood).CanCollide = true
	for k = -1, 1, 2 do
		cylP(CF(pos + V3(k * 1.6 * s, 8 * s, 0)) * ANG(0, 0, PI / 2 + k * 0.7), 4.5 * s, 0.8 * s, bark, M.Wood)
	end
	local crowns = { { 0, 12.5, 0, 9.5 }, { -3.4, 10.8, 1.2, 7 }, { 3.2, 11, -1, 7.5 }, { 0.6, 14.6, -0.4, 6.4 } }
	for i, c in ipairs(crowns) do
		local col = leaf:Lerp(i % 2 == 0 and C(70, 130, 60) or C(150, 205, 100), 0.18 * (i % 3))
		local cr = ellipsoid(CF(pos + V3(c[1], c[2], c[3]) * s), V3(c[4], c[4] * 0.78, c[4]) * s, col, M.LeafyGrass)
		tag(cr, "TPFC_Sway", { Amp = 0.01, Period = rng:NextNumber(5, 8) })
	end
end
function L.Bush(pos, s, col)
	col = col or C(84, 150, 70)
	for i = 1, 3 do
		ellipsoid(CF(pos + V3((i - 2) * 1.3 * s, 0.9 * s, rng:NextNumber(-0.5, 0.5) * s)), V3(2.6, 2, 2.4) * s * rng:NextNumber(0.85, 1.15),
			col:Lerp(C(130, 190, 90), rng:NextNumber(0, 0.3)), M.LeafyGrass)
	end
	if rng:NextNumber() < 0.6 then -- a few blossoms, not a sprinkle carpet
		for _ = 1, 3 do ballP(pos + V3(rng:NextNumber(-1.6, 1.6) * s, 1.8 * s, rng:NextNumber(-1, 1) * s), 0.45 * s, Color3.fromHSV(rng:NextNumber(0.85, 1.1) % 1, 0.45, 1), M.SmoothPlastic) end
	end
end
function L.Rock(pos, s, col)
	col = col or C(150, 150, 145)
	for i = 1, 3 do
		part("Part", V3(rng:NextNumber(2.5, 4), rng:NextNumber(1.6, 2.8), rng:NextNumber(2.5, 4)) * s * (1 - i * 0.18),
			CF(pos + V3(rng:NextNumber(-1, 1) * s, 0.6 * s, rng:NextNumber(-1, 1) * s)) * ANG(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, PI), rng:NextNumber(-0.3, 0.3)),
			col:Lerp(C(110, 112, 108), rng:NextNumber(0, 0.4)), M.Slate, i == 1)
	end
end
-- iron lamp post: base, pole, arm, warm glass lantern (not neon) + one light
function L.Lamp(pos, armDir)
	local iron = C(48, 44, 56)
	vcylP(pos, 0.8, 1.6, iron, M.Metal)
	vcylP(pos + V3(0, 0.8, 0), 9, 0.45, iron, M.Metal)
	vcylP(pos + V3(0, 9.8, 0), 0.4, 0.9, iron, M.Metal)
	local d = armDir or V3(0, 0, 0)
	local top = pos + V3(0, 10, 0) + d * 1.2
	if d.Magnitude > 0 then block(CF((pos + V3(0, 10.2, 0) + top) / 2), V3(math.abs(d.X) * 1.3 + 0.2, 0.2, math.abs(d.Z) * 1.3 + 0.2), iron, M.Metal) end
	local glass = block(CF(top - V3(0, 0.8, 0)), V3(1, 1.3, 1), C(255, 214, 150), M.Glass, false, 0.15)
	block(CF(top - V3(0, 0.05, 0)), V3(1.3, 0.25, 1.3), iron, M.Metal)
	block(CF(top - V3(0, 1.55, 0)), V3(1.15, 0.2, 1.15), iron, M.Metal)
	light(glass, C(255, 205, 150), 18, 1.1)
end
-- wooden signpost with arrow boards (clear routes from spawn)
function L.Signpost(pos, boards)
	local wood = C(140, 100, 66)
	vcylP(pos, 7, 0.6, wood:Lerp(C(0, 0, 0), 0.15), M.Wood).CanCollide = true
	for i, b in ipairs(boards) do
		local cf = CF(pos + V3(0, 6.2 - i * 1.4, 0)) * ANG(0, b.yaw, 0) * CF(0, 0, -1.7)
		local board = block(cf, V3(0.25, 1.1, 3.6), C(222, 190, 140), M.WoodPlanks)
		wedge(cf * CF(0, 0, -2.15) * ANG(0, PI, 0), V3(0.25, 1.1, 0.8), C(222, 190, 140), M.WoodPlanks)
		local sg = Instance.new("SurfaceGui"); sg.Face = Enum.NormalId.Right; sg.CanvasSize = Vector2.new(360, 110); sg.LightInfluence = 0.4
		local tl = Instance.new("TextLabel"); tl.Size = UDim2.fromScale(1, 1); tl.BackgroundTransparency = 1; tl.Font = Enum.Font.FredokaOne
		tl.TextScaled = true; tl.Text = b.text; tl.TextColor3 = C(80, 50, 30); tl.Parent = sg; sg.Parent = board
		local sg2 = sg:Clone(); sg2.Face = Enum.NormalId.Left; sg2.Parent = board
	end
end
function L.Bench(cf)
	local wood, iron = C(150, 105, 70), C(50, 46, 56)
	block(cf * CF(0, 1.5, 0), V3(5, 0.3, 1.5), wood, M.WoodPlanks, true)
	block(cf * CF(0, 2.5, 0.65) * ANG(-0.25, 0, 0), V3(5, 1.2, 0.25), wood, M.WoodPlanks)
	for k = -1, 1, 2 do block(cf * CF(k * 2.1, 0.75, 0), V3(0.3, 1.5, 1.3), iron, M.Metal) end
end

-- THE SPAWN AREA: layered terrain, curved plaza, lit street, base approaches, gardens and a gazebo
function L.Hub(depth, SW, hallBack)
	L.Seed(4242)
	local zTop, zEnd = hallBack, -depth + 24
	local len = zTop - zEnd
	local zc = (zTop + zEnd) / 2
	local BASEZ = { -84, -160, -236, -312 }
	if terrain then
		-- paved street sunk into the lawn, cobbled borders, curved plaza + gazebo circle
		terrain:FillBlock(CF(0, -0.75, zc), V3(46, 1.5, len), M.Pavement)
		for s = -1, 1, 2 do terrain:FillBlock(CF(s * 24.5, -0.75, zc), V3(3, 1.5, len), M.Cobblestone) end
		terrain:FillCylinder(CF(0, -0.75, -330), 1.5, 30, M.Cobblestone)
		terrain:FillCylinder(CF(0, -0.7, -330), 1.5, 26, M.Pavement)
		terrain:FillCylinder(CF(0, -0.75, -420), 1.5, 15, M.Cobblestone)
		-- approaches from the street to each of the eight base entrances
		for _, z in ipairs(BASEZ) do
			for s = -1, 1, 2 do terrain:FillBlock(CF(s * 28, -0.75, z), V3(8, 1.5, 10), M.Pavement) end
		end
		-- soft grassy berms + rock outcrops behind the base rows (outside every base's hedges)
		for z = -60, zEnd, -26 do
			for s = -1, 1, 2 do
				terrain:FillBall(V3(s * rng:NextNumber(101, 106), rng:NextNumber(-5, -2), z + rng:NextNumber(-6, 6)), rng:NextNumber(7, 10), M.Grass)
				if rng:NextNumber() < 0.35 then terrain:FillBall(V3(s * 104, rng:NextNumber(-1, 2), z), rng:NextNumber(2.5, 4), M.Rock) end
			end
		end
		-- rolling back garden behind the gazebo
		for i = 0, 6 do terrain:FillBall(V3(-75 + i * 25, -6, zEnd - 12 + (i % 2) * 6), rng:NextNumber(12, 16), M.Grass) end
	end
	-- low stone curbs (gaps at every base approach and the plaza)
	local stone = C(196, 190, 180)
	local function gap(z)
		for _, bz in ipairs(BASEZ) do if math.abs(z - bz) < 7 then return true end end
		return math.abs(z + 330) < 30
	end
	for z = zTop - 2, zEnd, -4 do
		if not gap(z) then for s = -1, 1, 2 do block(CF(s * 23.2, 0.18, z - 2), V3(0.6, 0.36, 3.9), stone, M.Concrete) end end
	end
	-- lamp posts in rhythm along both curbs (kept out of base approaches)
	for z = -60, -440, -38 do
		if not gap(z) then for s = -1, 1, 2 do L.Lamp(V3(s * 26.6, 0, z), V3(-s, 0, 0)) end end
	end
	-- plaza: fountain focal point, ring of benches, planter trees
	L.HubFountain(V3(0, 0, -330))
	for i = 0, 3 do
		local a = i / 4 * PI * 2 + PI / 4
		local p = V3(math.cos(a) * 21, 0, -330 + math.sin(a) * 21)
		L.Bench(CFrame.lookAt(p, V3(0, 0, -330)) * ANG(0, PI, 0))
		local pl = V3(math.cos(a + 0.35) * 23, 0, -330 + math.sin(a + 0.35) * 23)
		vcylP(pl, 1.4, 6, C(200, 192, 182), M.Brick)
		L.Tree(pl + V3(0, 1.4, 0), 0.7)
	end
	-- spawn welcome: signpost with clear routes, small gardens either side of the spawn
	L.Signpost(V3(9, 0, -66), { { text = "LAUNCH HALL", yaw = 0 }, { text = "YOUR BASE", yaw = PI / 2 }, { text = "FOUNTAIN", yaw = PI } })
	for s = -1, 1, 2 do
		L.Bush(V3(s * 21, 0, -50), 1)
		L.Rock(V3(s * 20, 0, -44), 0.6)
	end
	-- gazebo: secondary focal point at the far end of the street
	local g = V3(0, 0, -420)
	for i = 0, 7 do
		local a = i / 8 * PI * 2
		vcylP(g + V3(math.cos(a) * 9, 0, math.sin(a) * 9), 11, 1.1, C(240, 236, 228), M.Marble)
	end
	vcylP(g, 0.6, 21, C(220, 214, 204), M.Marble)
	vcylP(g + V3(0, 11, 0), 1, 21, C(240, 236, 228), M.Marble)
	local dome = ellipsoid(CF(g + V3(0, 11.5, 0)), V3(21, 10, 21), C(120, 92, 175), M.SmoothPlastic)
	ballP(g + V3(0, 17, 0), 1.6, C(232, 190, 90), M.Metal)
	light(dome, C(255, 220, 160), 24, 0.8)
	-- outer gardens: trees behind the bases and along the back, bushes around the gazebo
	for z = -70, zEnd, -22 do
		for s = -1, 1, 2 do
			if rng:NextNumber() < 0.8 then L.Tree(V3(s * rng:NextNumber(99, 104), 0, z + rng:NextNumber(-5, 5)), rng:NextNumber(0.9, 1.25)) end
		end
	end
	for _ = 1, 10 do L.Tree(V3(rng:NextNumber(-95, 95), 0, rng:NextNumber(zEnd - 14, zEnd - 2)), rng:NextNumber(1, 1.4)) end
	for i = 1, 8 do
		local s = i % 2 == 0 and 1 or -1
		L.Bush(V3(s * rng:NextNumber(14, 20), 0, -420 + rng:NextNumber(-14, 14)), rng:NextNumber(0.8, 1.1))
	end
end

---------------------------------------------------------------- HUB + HALL
function L.HubFountain(pos)
	-- layered marble basin, visible water, slowly moving portal crystal (tagged)
	local marble, gold = C(236, 234, 242), C(232, 190, 90)
	vcylP(pos, 1.4, 24, marble, M.Marble)
	vcylP(pos + V3(0, 1.4, 0), 0.4, 21, C(90, 190, 240), M.Glass, 0.25)
	vcylP(pos + V3(0, 1.4, 0), 0.5, 24.6, gold, M.Metal)
	vcylP(pos, 4, 12, marble, M.Marble)
	vcylP(pos + V3(0, 4, 0), 0.4, 10, C(90, 190, 240), M.Glass, 0.25)
	vcylP(pos, 8, 3, marble, M.Marble)
	for i = 0, 3 do block(CF(pos + V3(0, 8.5, 0)) * ANG(0, i * PI / 2, 0) * CF(0, 0, -2.2), V3(1.2, 1, 3), gold, M.Metal) end
	local cr = block(CF(pos + V3(0, 12, 0)) * ANG(0, PI / 4, 0.4), V3(3, 5, 3), C(175, 125, 255), M.Neon)
	light(cr, C(175, 125, 255), 30, 2)
	tag(cr, "TPFC_Bob", { Amp = 0.25, Period = 4, Spin = 12 })
end

function L.StreetBanners(z1, z2)
	local violet, gold = C(98, 60, 170), C(235, 195, 95)
	for z = z1, z2, -38 do
		for s = -1, 1, 2 do
			local x = s * 27.5
			block(CF(x, 7, z), V3(0.5, 14, 0.5), C(60, 50, 75), M.Metal)
			block(CF(x - s * 1.4, 13.6, z), V3(2.8, 0.4, 0.4), gold, M.Metal)
			local b = block(CF(x - s * 1.9, 10.5, z), V3(0.2, 5.6, 2.4), violet, M.Fabric)
			block(CF(x - s * 1.9, 10.5, z - 0.02) * CF(0, 0, 0), V3(0.24, 1.2, 1.2), gold, M.Neon)
			tag(b, "TPFC_Sway", { Amp = 0.03, Period = 6 })
		end
	end
end

-- hall upgrade: violet side bays, segmented front arch, floor charge channels (hall footprint unchanged)
function L.HallDressing(hw, back, front, H)
	local violet, gold, marble = C(98, 60, 170), C(235, 195, 95), C(240, 238, 246)
	-- marble floor inlays + charge channels toward the front arch (energised by the client while charging)
	for k = -2, 2 do
		local ch = block(CF(k * 5, 1.28, (back + front) / 2), V3(0.5, 0.08, front - back - 6), C(150, 110, 255), M.Neon, false, 0.6)
		ch.Name = "ChargeChannel"
		tag(ch, "TPFC_ChargeChannel", { Index = k })
	end
	block(CF(0, 1.27, front - 2.5), V3(hw * 2 - 4, 0.06, 0.8), gold, M.Neon, false, 0.3).Name = "LaunchLine"
	-- structural side bays (outside the hall walls, so the interior and checks stay identical)
	for s = -1, 1, 2 do
		for z = back + 6, front - 6, 10 do
			block(CF(s * (hw + 3.5), H / 2, z), V3(3, H, 3), marble, M.Marble, true)
			block(CF(s * (hw + 3.5), H + 1, z), V3(4, 2, 4), gold, M.Metal)
			block(CF(s * (hw + 2.05), H * 0.55, z), V3(0.3, H * 0.6, 1.2), violet, M.Neon, false, 0.35)
		end
	end
	-- commanding open front arch (replaces the rainbow bead arch); hollow centre, nothing in the lane
	arch(CF(0, 0, front + 2), hw * 2 + 6, H - 6, 3.2, marble, M.Marble, gold)
	for s = -1, 1, 2 do
		pyramid(CF(s * (hw + 3), H + 9, front + 2), 3.4, 5, gold, M.Metal)
	end
end

-- biome entry gate (more prominent than the 50-stud markers); pylons at |X| = 44
function L.ZoneGate(text, z, col, textLabel)
	local stone, gold = C(226, 222, 214), C(232, 190, 90)
	local x = 44
	for s = -1, 1, 2 do
		block(CF(s * x, 1, z), V3(9, 2, 9), stone:Lerp(C(0, 0, 0), 0.1), M.Limestone, true)
		block(CF(s * x, 18, z), V3(6, 32, 6), stone, M.Limestone, true)
		block(CF(s * (x - 3.05), 18, z), V3(0.3, 26, 1.6), col, M.Neon, false, 0.15)
		pyramid(CF(s * x, 34, z), 7, 6, gold, M.Metal)
	end
	-- lintel high above the flight/reveal corridor
	block(CF(0, 41, z), V3(x * 2 + 8, 4, 5), stone, M.Limestone)
	block(CF(0, 38.8, z - 2.55), V3(x * 2 + 6, 0.5, 0.2), col, M.Neon)
	local plate = block(CF(0, 45.5, z), V3(56, 6, 2), col:Lerp(C(20, 14, 30), 0.55), M.SmoothPlastic)
	if textLabel then
		textLabel(plate, text, C(255, 255, 255), Enum.NormalId.Front)
		textLabel(plate, text, C(255, 255, 255), Enum.NormalId.Back)
	end
end

---------------------------------------------------------------- BIOMES
-- each returns nothing; b = {z1, z2}, m = middle Z
L.Biome = {}

L.Biome.Forest = function(b, m)
	L.Seed(101)
	local leaves = { C(84, 168, 70), C(112, 196, 82), C(62, 148, 76), C(150, 208, 92) }
	-- MAIN: monumental ancient oak on the left
	local o = V3(-84, 0, b[1] + 95)
	for i = 0, 3 do block(CF(o + V3(0, 6 + i * 11, 0)) * ANG(0, i * 0.25, 0), V3(14 - i * 1.6, 12, 14 - i * 1.6), C(102 - i * 4, 72, 46), M.Wood, true) end
	for i = 0, 5 do -- layered roots
		local a = i / 6 * PI * 2
		wedge(CF(o + V3(math.cos(a) * 10, 2.5, math.sin(a) * 10)) * ANG(0, -a - PI / 2, 0), V3(4, 5, 10), C(95, 66, 42), M.Wood, true)
	end
	for i = 0, 3 do -- boughs
		local a = i / 4 * PI * 2 + 0.4
		local bp = o + V3(math.cos(a) * 9, 40, math.sin(a) * 9)
		block(CF(o + V3(math.cos(a) * 5, 38, math.sin(a) * 5)) * ANG(0, -a, 0.7), V3(4, 16, 4), C(98, 68, 44), M.Wood)
		canopy(bp + V3(math.cos(a) * 8, 8, math.sin(a) * 8), 2.2, leaves)
	end
	canopy(o + V3(0, 54, 0), 2.6, leaves)
	local knot = rune(CF(o + V3(7.05, 16, 0)) * ANG(0, PI / 2, 0), 3, 4, C(255, 226, 110))
	light(knot, C(255, 220, 120), 24, 1)
	-- SUPPORT 1: broken garden arch / ruins on the right
	local r = V3(74, 0, b[1] + 40)
	arch(CF(r) * ANG(0, PI / 2, 0), 14, 11, 2.4, C(205, 200, 185), M.Limestone)
	for i = 1, 3 do block(CF(r + V3(rng:NextNumber(-6, 6), 1, rng:NextNumber(8, 18))) * ANG(0, rng:NextNumber(0, PI), PI / 2), V3(2.2, 6, 2.2), C(200, 195, 180), M.Limestone, true) end
	-- SUPPORT 2: wooden observation platform far right
	local t = V3(96, 0, b[1] + 120)
	for _, c in ipairs({ { -3, -3 }, { 3, -3 }, { -3, 3 }, { 3, 3 } }) do block(CF(t + V3(c[1], 9, c[2])), V3(1, 18, 1), C(120, 85, 55), M.Wood, true) end
	block(CF(t + V3(0, 18.5, 0)), V3(9, 1, 9), C(140, 100, 62), M.WoodPlanks, true)
	pyramid(CF(t + V3(0, 23, 0)), 10, 5, C(170, 70, 60), M.Slate)
	-- side trees (four variants), stream-edge stones, quiet pale stone breaks in the corridor (flush)
	for i = 1, 18 do
		local sgn = (i % 2 == 0) and 1 or -1
		local pos = V3(sideX(sgn, 46, 68), 0, rng:NextNumber(b[1] + 6, b[2] - 6))
		if (pos - o).Magnitude > 26 and (pos - t).Magnitude > 10 then tree(pos, rng:NextNumber(1, 1.5), (i % 4) + 1, leaves) end
	end
	for i = 1, 8 do block(CF(sideX(i % 2 == 0 and 1 or -1, 38, 50), 0.6, rng:NextNumber(b[1], b[2])) * ANG(0, rng:NextNumber(0, PI), 0), V3(3, 1.2, 2.2), C(170, 172, 160), M.Slate) end
	for i = 1, 6 do block(CF(rng:NextNumber(-24, 24), 0.06, rng:NextNumber(b[1] + 10, b[2] - 10)) * ANG(0, rng:NextNumber(0, PI), 0), V3(rng:NextNumber(3, 6), 0.12, rng:NextNumber(2, 4)), C(206, 204, 186), M.Slate) end
end

L.Biome.Volcano = function(b, m)
	L.Seed(202)
	local basalt, dark, lava = C(52, 40, 42), C(32, 26, 30), C(255, 110, 30)
	-- MAIN: jagged geological volcano (left) with crater glow + diagonal lavafall
	local v = V3(-128, 0, m)
	local top = 0
	for i = 0, 6 do
		local w = 120 - i * 15
		block(CF(v + V3(rng:NextNumber(-3, 3), i * 13 + 6.5, rng:NextNumber(-3, 3))) * ANG(0, i * 0.35, 0), V3(w, 13, w * 0.85), basalt:Lerp(dark, i * 0.08), M.Basalt, true)
		top = i * 13 + 13
	end
	for i = 0, 5 do -- jagged crown
		local a = i / 6 * PI * 2
		wedge(CF(v + V3(math.cos(a) * 14, top + 6, math.sin(a) * 14)) * ANG(0, -a, 0), V3(10, 14, 8), dark, M.Basalt)
	end
	local crater = block(CF(v + V3(0, top + 0.5, 0)), V3(18, 1, 18), lava, M.Neon)
	light(crater, C(255, 120, 40), 60, 2.5)
	tag(crater, "TPFC_Pulse", { Period = 6, Base = 0, Peak = 0.25 })
	for i = 0, 9 do -- lavafall down the lane-facing slope, then a pool
		local p = v + V3(42 - i * 0.4 + i * 3.2, top - i * 9, -6 + i * 1.5)
		local seg = block(CF(p) * ANG(0, 0, -0.55), V3(9, 2, 6), lava, M.Neon, false, 0.05)
		if i % 3 == 0 then tag(seg, "TPFC_Pulse", { Period = 4 + i * 0.3, Base = 0.05, Peak = 0.3 }) end
	end
	-- SUPPORT 1: cooled basalt colonnade (right)
	for i = 0, 13 do
		local z = b[1] + 18 + i * 12
		local h = 8 + math.abs(math.sin(i * 1.3)) * 16
		block(CF(rng:NextNumber(62, 72), h / 2, z) * ANG(0, PI / 6, 0), V3(5, h, 5), basalt:Lerp(dark, rng:NextNumber(0, 0.5)), M.Basalt, true)
		if i % 4 == 0 then block(CF(60.4, h * 0.6, z), V3(0.3, h * 0.5, 0.5), lava, M.Neon) end
	end
	-- SUPPORT 2: broken basalt bridge (far right, beyond the corridor)
	for s = -1, 1, 2 do
		block(CF(94, 10, m + 60 + s * 16), V3(10, 20, 6), basalt, M.Basalt, true)
		block(CF(94, 21, m + 60 + s * 9), V3(10, 2.5, 9), dark, M.Basalt)
	end
	-- vents (long staggered pulse), quiet dark landing basalt with sparse flush cracks
	for i = 1, 6 do
		local p = V3(sideX(i % 2 == 0 and 1 or -1, 46, 60), 0, rng:NextNumber(b[1] + 10, b[2] - 10))
		rockMass(p, 7, 5, 7, dark, M.Basalt, 2)
		local core = block(CF(p + V3(0, 5.2, 0)), V3(2.4, 0.4, 2.4), lava, M.Neon)
		tag(core, "TPFC_Pulse", { Period = rng:NextNumber(9, 15), Base = 0.6, Peak = 0 })
	end
	for i = 1, 7 do block(CF(rng:NextNumber(-26, 26), 0.05, rng:NextNumber(b[1] + 8, b[2] - 8)) * ANG(0, rng:NextNumber(0, PI), 0), V3(rng:NextNumber(5, 10), 0.1, 0.35), lava, M.Neon, false, 0.2) end
end

L.Biome.Frozen = function(b, m)
	L.Seed(303)
	local ice, deep, snow = C(196, 230, 250), C(120, 170, 215), C(244, 250, 255)
	-- MAIN: ice citadel (right)
	local c = V3(86, 0, m)
	block(CF(c + V3(0, 6, 0)), V3(46, 12, 40), deep, M.Ice, true)
	block(CF(c + V3(0, 12.6, 0)), V3(48, 1.2, 42), snow, M.Snow)
	local function tower(p, h, w)
		block(CF(p + V3(0, 12 + h / 2, 0)), V3(w, h, w), ice, M.Ice, true)
		block(CF(p + V3(0, 12 + h + 1, 0)), V3(w + 1.5, 2, w + 1.5), snow, M.Snow)
		pyramid(CF(p + V3(0, 12 + h + 2, 0)), w, w * 1.6, C(150, 205, 245), M.Glass)
		local g = block(CF(p + V3(-w / 2 - 0.05, 12 + h * 0.6, 0)), V3(0.2, h * 0.3, w * 0.25), C(170, 240, 255), M.Neon, false, 0.2)
		tag(g, "TPFC_Glint", { Period = rng:NextNumber(8, 14) })
	end
	tower(c, 52, 12)
	tower(c + V3(-4, 0, -16), 32, 8)
	tower(c + V3(-4, 0, 16), 32, 8)
	arch(CF(c + V3(-23.5, 0, 0)) * ANG(0, PI / 2, 0), 10, 10, 2.5, C(225, 242, 252), M.Ice, C(150, 230, 255))
	-- SUPPORT 1: off-lane ice arch (left)
	arch(CF(-70, 0, b[1] + 60) * ANG(0, PI / 2, 0), 16, 14, 3, ice, M.Ice)
	-- SUPPORT 2: frozen waterfall shelves (left)
	for i = 0, 5 do
		block(CF(-98, 4 + i * 6, b[2] - 60 + i * 2), V3(26 - i * 2, 8, 12), i % 2 == 0 and ice or deep, M.Glacier, true)
		block(CF(-85 + i * 0.5, 2 + i * 6, b[2] - 60 + i * 2), V3(0.6, 10, 9), C(220, 245, 255), M.Ice, false, 0.2)
	end
	-- sparse blocky pines, two snowman vignettes, pale-blue compressed snow patches in the corridor
	for i = 1, 16 do
		local p = V3(sideX(i % 2 == 0 and 1 or -1, 46, 70), 0, rng:NextNumber(b[1] + 6, b[2] - 6))
		if (p - c).Magnitude > 34 then
			block(CF(p + V3(0, 2, 0)), V3(1.2, 4, 1.2), C(100, 70, 45), M.Wood, true)
			for k = 0, 3 do
				block(CF(p + V3(0, 4 + k * 2.6, 0)) * ANG(0, k * 0.5, 0), V3(8 - k * 1.8, 2.4, 8 - k * 1.8), C(40, 105, 72), M.Grass)
				block(CF(p + V3(0, 5.1 + k * 2.6, 0)) * ANG(0, k * 0.5, 0), V3(7 - k * 1.8, 0.4, 7 - k * 1.8), snow, M.Snow)
			end
		end
	end
	for k = 1, 2 do
		local p = V3(-48 + k * 2, 0, b[1] + 40 + k * 120)
		block(CF(p + V3(0, 2, 0)), V3(4, 4, 4), snow, M.Snow, true)
		block(CF(p + V3(0, 5, 0)), V3(3, 3, 3), snow, M.Snow)
		block(CF(p + V3(0, 7.3, 0)), V3(2.2, 2, 2.2), snow, M.Snow)
		block(CF(p + V3(0, 6.3, -1.4)), V3(2.6, 0.5, 0.6), C(90, 140, 220), M.Fabric)
	end
	for i = 1, 6 do block(CF(rng:NextNumber(-24, 24), 0.05, rng:NextNumber(b[1] + 8, b[2] - 8)) * ANG(0, rng:NextNumber(0, PI), 0), V3(rng:NextNumber(5, 9), 0.1, rng:NextNumber(3, 5)), C(205, 228, 248), M.Ice) end
end

L.Biome.Crystal = function(b, m)
	L.Seed(404)
	local rock, dark = C(70, 56, 104), C(44, 36, 70)
	local cols = { C(80, 230, 255), C(240, 100, 220), C(170, 110, 255) }
	-- MAIN: huge open split geode (left), rough outer rock + crystal fans + core
	local g = V3(-94, 0, m)
	for i = 0, 15 do
		local a = i / 15 * PI -- half ring facing the lane
		local p = g + V3(-math.sin(a) * 30, 0, math.cos(a) * 40) -- shell behind, opening faces the lane
		block(CF(p + V3(0, 18 + math.sin(a) * 18, 0)) * ANG(0, -a, -0.15), V3(10, 36 + math.sin(a) * 30, 12), rock:Lerp(dark, (i % 3) * 0.2), M.Slate, true)
	end
	block(CF(g + V3(-8, 1, 0)), V3(40, 2, 70), dark, M.Slate, true)
	crystalFan(g + V3(-12, 2, -18), 3.2, cols, PI / 2)
	crystalFan(g + V3(-12, 2, 18), 3.2, cols, PI / 2)
	local core = block(CF(g + V3(-8, 24, 0)) * ANG(0.4, 0.6, 0.2), V3(8, 12, 8), cols[1], M.Neon)
	light(core, cols[1], 50, 2)
	tag(core, "TPFC_Pulse", { Period = 3, Base = 0, Peak = 0.3 })
	-- SUPPORT 1: rune monoliths (right)
	for i = 0, 2 do
		local p = V3(70 + i * 6, 0, b[1] + 60 + i * 26)
		block(CF(p + V3(0, 9, 0)) * ANG(0, 0.3 * i, 0), V3(5, 18, 3), rock, M.Slate, true)
		rune(CF(p + V3(0, 10, -1.6)) * ANG(0, 0.3 * i, 0), 1.2, 9, cols[i + 1])
	end
	-- SUPPORT 2: mineral pools (right)
	for i = 0, 2 do
		local p = V3(84, 0.2, b[2] - 70 + i * 22)
		block(CF(p), V3(18, 0.6, 14), dark, M.Slate)
		local w = block(CF(p + V3(0, 0.35, 0)), V3(15, 0.2, 11), cols[(i % 3) + 1], M.Glass, false, 0.35)
		tag(w, "TPFC_Pulse", { Period = 6 + i, Base = 0.35, Peak = 0.15 })
	end
	-- cavern illusion from side buttresses + distant high silhouettes (never over the lane)
	for z = b[1] + 20, b[2] - 10, 42 do
		for s = -1, 1, 2 do
			if s < 0 and math.abs(z - m) < 70 then continue end -- keep the geode opening visible
			wedge(CF(s * 74, 22, z) * ANG(0, s > 0 and -PI / 2 or PI / 2, 0), V3(14, 44, 18), rock:Lerp(dark, 0.4), M.Slate, true)
		end
	end
	for i = 1, 10 do
		local sgn = i % 2 == 0 and 1 or -1
		crystal(V3(sideX(sgn, 46, 64), 0, rng:NextNumber(b[1] + 8, b[2] - 8)), rng:NextNumber(5, 11), rng:NextNumber(1.6, 2.6), cols[(i % 3) + 1], ANG(rng:NextNumber(-0.3, 0.3), 0, rng:NextNumber(-0.3, 0.3)))
	end
end

L.Biome.Candy = function(b, m)
	L.Seed(505)
	local choco, cream, pink, mint = C(110, 62, 36), C(255, 240, 222), C(255, 160, 205), C(150, 235, 210)
	-- MAIN: ONE grand chocolate/cream palace (right)
	local p = V3(90, 0, m)
	block(CF(p + V3(0, 7, 0)), V3(52, 14, 56), choco, M.SmoothPlastic, true)
	block(CF(p + V3(0, 14.6, 0)), V3(54, 1.4, 58), cream, M.SmoothPlastic)
	for i = 0, 10 do block(CF(p + V3(-27.2, 12.6 - (i % 3) * 1.1, -26 + i * 5.2)), V3(0.8, 3 + (i % 3) * 2, 2), cream, M.SmoothPlastic) end -- icing drips
	local function caketower(q, h, w)
		block(CF(q + V3(0, 14 + h / 2, 0)), V3(w, h, w), pink, M.SmoothPlastic, true)
		block(CF(q + V3(0, 14 + h + 0.5, 0)), V3(w + 1.4, 1.2, w + 1.4), cream, M.SmoothPlastic)
		pyramid(CF(q + V3(0, 14 + h + 1, 0)), w, w * 1.1, C(255, 120, 175), M.SmoothPlastic)
		ballP(q + V3(0, 14 + h + 1 + w * 1.1 + 1, 0), 2.4, C(230, 30, 50), M.SmoothPlastic)
	end
	caketower(p + V3(0, 0, 0), 30, 14)
	caketower(p + V3(-8, 0, -20), 18, 9)
	caketower(p + V3(-8, 0, 20), 18, 9)
	arch(CF(p + V3(-26.5, 0, 0)) * ANG(0, PI / 2, 0), 10, 8, 2.4, cream, M.SmoothPlastic, C(255, 120, 175))
	-- SUPPORT 1: molded chocolate waterfall + canal (left)
	for i = 0, 5 do block(CF(-92, 5 + i * 7, m - 40 + i * 3), V3(26 - i * 2, 10, 14), choco:Lerp(C(70, 38, 22), i * 0.08), M.SmoothPlastic, true) end
	local fall = block(CF(-78, 18, m - 30), V3(1, 36, 10), C(120, 70, 40), M.SmoothPlastic, false, 0)
	tag(fall, "TPFC_Pulse", { Period = 5, Base = 0, Peak = 0.12 })
	-- SUPPORT 2: candy groves — lollipop trees + blocky candy canes + angular sugar rocks
	for i = 1, 14 do
		local q = V3(sideX(i % 2 == 0 and 1 or -1, 46, 66), 0, rng:NextNumber(b[1] + 8, b[2] - 8))
		if (q - p).Magnitude > 40 then
			if i % 3 == 0 then
				for k = 0, 5 do block(CF(q + V3(0, 0.75 + k * 1.5, 0)), V3(1.2, 1.5, 1.2), k % 2 == 0 and C(230, 40, 50) or cream, M.SmoothPlastic, true) end
				block(CF(q + V3(1.4, 9.4, 0)), V3(4, 1.2, 1.2), C(230, 40, 50), M.SmoothPlastic)
			elseif i % 3 == 1 then
				block(CF(q + V3(0, 5, 0)), V3(0.8, 10, 0.8), cream, M.SmoothPlastic, true)
				local disc = cylP(CF(q + V3(0, 12, 0)) * ANG(0, PI / 2, 0), 1, 8, Color3.fromHSV(rng:NextNumber(), 0.55, 1), M.SmoothPlastic)
				cylP(CF(q + V3(0, 12, 0)) * ANG(0, PI / 2, 0), 1.1, 4.5, cream, M.SmoothPlastic)
				tag(disc, "TPFC_Sway", { Amp = 0.02, Period = 7 })
			else
				crystal(q, rng:NextNumber(4, 7), rng:NextNumber(2, 3), Color3.fromHSV(rng:NextNumber(0.8, 1), 0.3, 1), ANG(0, rng:NextNumber(0, PI), rng:NextNumber(-0.3, 0.3)))
			end
		end
	end
	-- quiet cream path breaks in the corridor (flush)
	for i = 1, 8 do block(CF(rng:NextNumber(-22, 22), 0.05, b[1] + 25 + i * 45), V3(rng:NextNumber(6, 10), 0.1, 4), cream, M.SmoothPlastic) end
	for i = 1, 4 do block(CF(sideX(i % 2 == 0 and 1 or -1, 44, 50), 0.6, rng:NextNumber(b[1], b[2])), V3(4, 1.2, 4), mint, M.SmoothPlastic) end
end

L.Biome.Space = function(b, m)
	L.Seed(606)
	local lunar, dark, metal, cyan = C(150, 152, 175), C(70, 72, 100), C(170, 176, 196), C(110, 230, 255)
	-- MAIN: orbital observatory (left)
	local o = V3(-86, 0, m + 30)
	block(CF(o + V3(0, 6, 0)), V3(34, 12, 34), dark, M.Concrete, true)
	vcylP(o + V3(0, 12, 0), 14, 26, metal, M.Metal)
	local dome = ballP(o + V3(0, 26, 0), 26, C(190, 196, 215), M.Metal)
	dome.CanCollide = false
	cylP(CF(o + V3(10, 34, 0)) * ANG(0, 0, 0.9), 26, 4.5, C(120, 126, 150), M.Metal) -- telescope tube
	for k = 1, 2 do
		local ring = cylP(CF(o + V3(0, 26, 0)) * ANG(k * 0.7, 0, PI / 2 + k * 0.3), 0.6, 40 + k * 6, cyan, M.Neon, 0.4)
		tag(ring, "TPFC_Spin", { Rate = 4 + k })
	end
	-- SUPPORT 1: crashed satellite (right)
	local s = V3(82, 0, b[1] + 80)
	block(CF(s + V3(0, 3, 0)) * ANG(0.3, 0.6, 0.2), V3(8, 6, 8), metal, M.Metal, true)
	for k = -1, 1, 2 do block(CF(s + V3(k * 9, 4, 2)) * ANG(0.3, 0.6, 0.5 * k), V3(10, 0.4, 5), C(40, 70, 160), M.Glass) end
	cylP(CF(s + V3(-2, 9, 0)) * ANG(0, 0, 1.2), 0.8, 8, metal, M.Metal)
	-- SUPPORT 2: crater-ring structure (right, far)
	local c = V3(90, 0, b[2] - 90)
	for i = 0, 11 do
		local a = i / 12 * PI * 2
		block(CF(c + V3(math.cos(a) * 16, 3, math.sin(a) * 16)) * ANG(0, -a, 0), V3(3, 6, 8), dark, M.Slate, true)
		if i % 3 == 0 then tag(block(CF(c + V3(math.cos(a) * 14.4, 3, math.sin(a) * 14.4)) * ANG(0, -a, 0), V3(0.3, 2, 4), cyan, M.Neon), "TPFC_Pulse", { Period = 8 + i, Base = 0.6, Peak = 0 }) end
	end
	-- distant ringed planet on the skyline (beyond the right wall) + sparse asteroid belt (sides only)
	local planet = ballP(V3(230, 150, m + 120), 90, C(200, 130, 220), M.SmoothPlastic)
	planet.CastShadow = false
	local pr = cylP(CF(V3(230, 150, m + 120)) * ANG(0.35, 0, PI / 2 + 0.25), 0.8, 170, C(240, 210, 255), M.SmoothPlastic, 0.35)
	tag(pr, "TPFC_Spin", { Rate = 3 })
	for i = 1, 10 do
		local sg = i % 2 == 0 and 1 or -1
		local a = block(CF(sg * rng:NextNumber(75, 130), rng:NextNumber(40, 90), rng:NextNumber(b[1], b[2])) * ANG(rng:NextNumber(0, PI), rng:NextNumber(0, PI), 0),
			V3(1, 1, 1) * rng:NextNumber(3, 8), dark, M.Slate)
		tag(a, "TPFC_Spin", { Rate = rng:NextNumber(2, 6) })
	end
	-- low flush craters in the corridor (never a hole: terrain stays continuous)
	for i = 1, 7 do
		local p = V3(rng:NextNumber(-24, 24), 0.04, rng:NextNumber(b[1] + 10, b[2] - 10))
		vcylP(p, 0.08, rng:NextNumber(6, 12), lunar:Lerp(dark, 0.35), M.Slate)
	end
end

L.Biome.Shadow = function(b, m)
	L.Seed(707)
	local stone, plum, teal, red = C(70, 56, 92), C(44, 32, 60), C(80, 220, 210), C(200, 50, 80)
	-- MAIN: fractured cathedral (left)
	local c = V3(-90, 0, m)
	for s = -1, 1, 2 do -- nave walls with tall pointed windows
		for k = 0, 5 do
			local z = c.Z - 40 + k * 16
			block(CF(c.X + s * 14, 18, z), V3(4, 36 - (k == 4 and 18 or 0), 4), stone, M.Slate, true)
			if k < 5 then
				block(CF(c.X + s * 14, 30, z + 8), V3(2.4, 4, 12), plum, M.Slate)
				if s > 0 then rune(CF(c.X + s * 12.7, 16, z + 8) * ANG(0, PI / 2, 0), 5, 14, teal) end
			end
		end
	end
	for i = 0, 2 do -- broken facade + spire facing the lane
		block(CF(c.X + 16, 24 + i * 12, c.Z - 44), V3(10 - i * 2, 12, 10 - i * 2), stone:Lerp(plum, i * 0.2), M.Slate, true)
	end
	pyramid(CF(c.X + 16, 60, c.Z - 44), 6, 14, plum, M.Slate)
	arch(CF(c.X + 16.5, 0, c.Z - 30) * ANG(0, PI / 2, 0), 12, 16, 3, stone, M.Slate, teal)
	-- SUPPORT 1: broken obelisks (right)
	for i = 0, 4 do
		local p = V3(66 + rng:NextNumber(0, 10), 0, b[1] + 50 + i * 110)
		local h = rng:NextNumber(14, 26)
		block(CF(p + V3(0, h / 2, 0)) * ANG(0, 0, rng:NextNumber(-0.15, 0.15)), V3(4, h, 4), stone, M.Slate, true)
		rune(CF(p + V3(-2.1, h * 0.55, 0)) * ANG(0, PI / 2, 0), 1, h * 0.4, i % 2 == 0 and teal or red)
	end
	-- SUPPORT 2: decorative side chasm (right, outside the lane — terrain carved beyond X=80)
	if terrain then
		terrain:FillBlock(CF(110, -10, m), V3(40, 24, 180), M.Air)
		terrain:FillBlock(CF(110, -24, m), V3(40, 4, 180), M.Slate)
	end
	-- twisted angular trees + slowly precessing suspended stones near the cathedral
	for i = 1, 12 do
		local p = V3(sideX(i % 2 == 0 and 1 or -1, 46, 64), 0, rng:NextNumber(b[1] + 8, b[2] - 8))
		if (p - c).Magnitude > 50 then
			local y, cf = 0, CF(p)
			for k = 0, 3 do
				local seg = 5 - k * 0.6
				block(cf * CF(0, seg / 2, 0), V3(1.4 - k * 0.25, seg, 1.4 - k * 0.25), C(40, 28, 52), M.Wood, k == 0)
				cf = cf * CF(0, seg, 0) * ANG(rng:NextNumber(-0.5, 0.5), 0, rng:NextNumber(-0.6, 0.6))
				y += seg
			end
		end
	end
	for i = 1, 6 do
		local st = block(CF(c + V3(rng:NextNumber(20, 40), rng:NextNumber(30, 55), rng:NextNumber(-40, 40))) * ANG(rng:NextNumber(0, 1), rng:NextNumber(0, 3), 0),
			V3(1, 1, 1) * rng:NextNumber(3, 6), plum, M.Slate)
		tag(st, "TPFC_Bob", { Amp = 1.2, Period = rng:NextNumber(8, 12), Spin = rng:NextNumber(2, 4) })
	end
	-- quiet lavender centre stone breaks (flush)
	for i = 1, 8 do block(CF(rng:NextNumber(-24, 24), 0.05, rng:NextNumber(b[1] + 10, b[2] - 10)) * ANG(0, rng:NextNumber(0, PI), 0), V3(rng:NextNumber(5, 9), 0.1, rng:NextNumber(3, 5)), C(120, 104, 150), M.Slate) end
end

L.Biome.Heaven = function(b, m)
	L.Seed(808)
	local marble, cream, gold, sky = C(246, 242, 232), C(236, 228, 210), C(232, 190, 90), C(170, 215, 245)
	-- MAIN: celestial sanctuary (left): stepped platform, colonnade, winged gateway, dome
	local s = V3(-94, 0, m + 60)
	for i = 0, 3 do block(CF(s + V3(0, 1 + i * 2, 0)), V3(60 - i * 6, 2, 80 - i * 6), i % 2 == 0 and marble or cream, M.Marble, true) end
	for k = 0, 7 do
		for sd = -1, 1, 2 do column(s + V3(sd * 18, 8, -28 + k * 8), 18, 2.4, marble, M.Marble, gold) end
	end
	block(CF(s + V3(0, 27.5, 0)), V3(42, 2, 66), cream, M.Marble)
	block(CF(s + V3(0, 28.7, 0)), V3(43, 0.4, 67), gold, M.Metal)
	local dome = ballP(s + V3(0, 30, 0), 30, marble, M.Marble)
	dome.CanCollide = false
	arch(CF(s + V3(30, 8, 0)) * ANG(0, PI / 2, 0), 18, 22, 3.2, marble, M.Marble, gold)
	for sd = -1, 1, 2 do -- architectonic wing details on the gateway
		for f = 0, 3 do
			wedge(CF(s + V3(31, 26 + f * 3, sd * (14 + f * 4))) * ANG(0, sd > 0 and 0 or PI, 0) * ANG(-0.5 - f * 0.15, 0, 0), V3(1.2, 10 - f * 1.5, 4), f == 0 and gold or marble, M.Marble)
		end
	end
	local ray = block(CF(s + V3(0, 60, 0)), V3(6, 60, 6), C(255, 245, 210), M.Neon, false, 0.85)
	tag(ray, "TPFC_Pulse", { Period = 8, Base = 0.85, Peak = 0.7 })
	-- SUPPORT 1: rhythmic colonnade along the right side
	for z = b[1] + 30, b[2] - 30, 36 do column(V3(64, 0, z), 20, 2.6, marble, M.Marble, gold) end
	-- SUPPORT 2: cloud gardens + side waterfalls (right)
	for i = 0, 2 do
		local p = V3(92, 0, b[1] + 160 + i * 220)
		block(CF(p + V3(0, 5, 0)), V3(22, 10, 22), cream, M.Marble, true)
		for k = 1, 4 do block(CF(p + V3(rng:NextNumber(-8, 8), 11 + rng:NextNumber(0, 2), rng:NextNumber(-8, 8))), V3(6, 3, 6), C(250, 250, 255), M.SmoothPlastic) end
		block(CF(p + V3(-11.2, 5, 0)), V3(0.4, 10, 6), sky, M.Glass, false, 0.3)
		block(CF(p + V3(0, 11.5, 0)), V3(3, 3, 3), C(120, 200, 110), M.Grass)
	end
	-- coherent banded rainbow arch on the skyline beyond the lane end (never over the corridor)
	local bands = { C(255, 90, 90), C(255, 165, 60), C(255, 230, 80), C(100, 220, 120), C(90, 170, 255), C(120, 110, 255), C(205, 110, 255) }
	for bi, col in ipairs(bands) do
		local r = 120 - bi * 4
		for i = 1, 24 do
			local a0, a1 = (i - 1) / 24 * PI, i / 24 * PI
			local p0, p1 = V3(math.cos(a0) * r, math.sin(a0) * r * 0.75, 0), V3(math.cos(a1) * r, math.sin(a1) * r * 0.75, 0)
			local d = p1 - p0
			block(CF(V3(0, 0, b[2] + 90) + (p0 + p1) / 2) * ANG(0, 0, math.atan2(d.Y, d.X)), V3(d.Magnitude + 0.5, 3.6, 2), col, M.SmoothPlastic)
		end
	end
	-- clean scenic end: marble balustrade just past the last landing point
	for x = -66, 66, 6 do column(V3(x, 0, b[2] + 6), 4, 1, marble, M.Marble, gold) end
	block(CF(0, 4.8, b[2] + 6), V3(136, 0.8, 2), cream, M.Marble)
	-- quiet cream stone floor slabs with pale-blue shadow tone (flush)
	for i = 1, 10 do block(CF(rng:NextNumber(-24, 24), 0.05, rng:NextNumber(b[1] + 10, b[2] - 10)), V3(rng:NextNumber(6, 10), 0.1, rng:NextNumber(4, 6)), C(228, 232, 240), M.Marble) end
end

---------------------------------------------------------------- transitions (side dressing only; boundaries unchanged)
local TRANS = {
	Volcano = { C(60, 45, 40), M.Basalt }, Frozen = { C(150, 170, 190), M.Slate }, Crystal = { C(90, 80, 150), M.Slate },
	Candy = { C(240, 170, 205), M.SmoothPlastic }, Space = { C(90, 70, 70), M.Slate }, Shadow = { C(80, 75, 105), M.Slate },
	Heaven = { C(236, 228, 210), M.Marble },
}
function L.Transition(toId, z)
	local t = TRANS[toId]
	if not t then return end
	L.Seed(900 + math.floor(z))
	for i = 1, 6 do
		local sg = i % 2 == 0 and 1 or -1
		rockMass(V3(sideX(sg, 46, 62), 0, z + rng:NextNumber(-14, 14)), rng:NextNumber(4, 7), rng:NextNumber(3, 8), rng:NextNumber(4, 7), t[1], t[2], 2)
	end
end

return L
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX60"><Properties><string name="Name">StarterPlayer</string></Properties>
