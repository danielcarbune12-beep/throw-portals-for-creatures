<Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">PortalBuilder</string><ProtectedString name="Source"><![CDATA[-- PortalBuilder: builds the throwable portal orb and the opened portal gate.
-- Location: ReplicatedStorage > Shared > PortalBuilder (ModuleScript)

local Config = require(script.Parent.Config)

local PortalBuilder = {}
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 170, 40)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 240, 70)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(70, 230, 110)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(70, 150, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 90, 255)),
})

local THEME = {
	Basic = { frameMat = Enum.Material.Glass, frameCol = Color3.fromRGB(225, 240, 255) },
	Forest = { frameMat = Enum.Material.Wood, frameCol = Color3.fromRGB(120, 85, 50) },
	Lava = { frameMat = Enum.Material.Basalt, frameCol = Color3.fromRGB(45, 32, 34) },
	Ice = { frameMat = Enum.Material.Ice, frameCol = Color3.fromRGB(200, 235, 255) },
	Galaxy = { frameMat = Enum.Material.SmoothPlastic, frameCol = Color3.fromRGB(30, 20, 60) },
	Dark = { frameMat = Enum.Material.Slate, frameCol = Color3.fromRGB(45, 25, 60) },
	Rainbow = { frameMat = Enum.Material.SmoothPlastic, frameCol = Color3.fromRGB(245, 242, 250) },
	Divine = { frameMat = Enum.Material.Marble, frameCol = Color3.fromRGB(248, 245, 235) },
	Secret = { frameMat = Enum.Material.SmoothPlastic, frameCol = Color3.fromRGB(28, 28, 34) },
}

PortalBuilder.Theme = THEME

function PortalBuilder.ColorSeq(portalId)
	local P = Config.Portals[portalId]
	if P.fx == "Rainbow" then
		return RAINBOW
	end
	return ColorSequence.new(P.color, P.color2)
end

function PortalBuilder.Emitter(parent, portalId, rate, size, speed)
	local P = Config.Portals[portalId]
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = (P.fx == "Smoke" or P.fx == "Glitch") and SMOKE or (P.fx == "Fire" and FIRE or SPARKLE)
	pe.Color = PortalBuilder.ColorSeq(portalId)
	pe.LightEmission = (P.fx == "Smoke") and 0.3 or 1
	pe.Rate = rate
	pe.Lifetime = NumberRange.new(0.5, 1.2)
	pe.Speed = NumberRange.new(speed * 0.5, speed)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new(0, 1)
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-180, 180)
	pe.Parent = parent
	return pe
end

return require(script.Parent.PortalDesign)(PortalBuilder, Config)
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">PortalDesign</string><ProtectedString name="Source"><![CDATA[-- Architectural portals and faceted throw orbs. No uploaded meshes or textures required.
-- API refs deliberately match ThrowController/UIKit. Structural frames do not spin.
local V, CF, A = Vector3.new, CFrame.new, CFrame.Angles
local PI, M = math.pi, Enum.Material
local GOLD = Color3.fromRGB(218, 174, 85)
local IVORY = Color3.fromRGB(235, 228, 218)
local INK = Color3.fromRGB(31, 24, 48)
local function make(model, name, size, color, mat, transparency, class)
	local p = Instance.new(class or "Part")
	p.Name, p.Size, p.Color, p.Material = name, size, color, mat or M.SmoothPlastic
	p.Transparency = transparency or 0
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, false, true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.CastShadow = false
	p.Parent = model
	return p
end
local function weld(parent, p, cf, name)
	local w = Instance.new("Weld")
	w.Name, w.Part0, w.Part1, w.C0 = name or "Bind", parent, p, cf
	w.Parent = p
	return w
end
local function block(model, hub, name, size, cf, color, mat, tr)
	local p = make(model, name, size, color, mat, tr)
	weld(hub, p, cf)
	return p
end
local function beam(model, hub, name, p0, p1, width, depth, color, mat)
	local d = p1 - p0
	return block(
		model,
		hub,
		name,
		V(width, d.Magnitude + width * 0.12, depth),
		CF((p0 + p1) / 2, p1) * A(PI / 2, 0, 0),
		color,
		mat
	)
end
local function triangle(model, hub, name, a, b, c, color, mat, thickness, transparency)
	-- Two native solid wedges fill a triangle. The longest edge is the base, ensuring
	-- the perpendicular projection stays within it, with no negative or sliver dimensions.
	local ab, ac, bc = (b - a).Magnitude, (c - a).Magnitude, (c - b).Magnitude
	if ac > ab and ac > bc then
		b, c = c, b
	elseif bc > ab then
		a, c = c, a
	end
	local z = (b - a).Unit
	local foot = a + z * (c - a):Dot(z)
	local y = (c - foot).Unit
	local h = (c - foot).Magnitude
	for _, point in ipairs({ a, b }) do
		local width = (foot - point).Magnitude
		if width > 0.0001 then
			local zz = (foot - point).Unit
			local x = y:Cross(zz)
			local cf = CFrame.fromMatrix((point + foot) / 2 + y * h / 2, x, y, zz)
			local p = make(model, name, V(thickness or 0.04, h, width), color, mat, transparency, "WedgePart")
			weld(hub, p, cf)
		end
	end
end
local function diamond(model, hub, name, cf, length, width, depth, color, mat)
	local top, bottom = cf * V(0, length / 2, 0), cf * V(0, -length / 2, 0)
	triangle(model, hub, name, cf * V(-width / 2, 0, 0), bottom, top, color, mat, depth)
	triangle(model, hub, name, cf * V(width / 2, 0, 0), top, bottom, color, mat, depth)
end
local function ring(model, hub, name, radius, radialWidth, depth, z, color, mat, n, tr)
	n = n or 24
	local length = 2 * radius * math.tan(PI / n) * 1.015
	for i = 0, n - 1 do
		local angle = (i + 0.5) / n * PI * 2
		local col = type(color) == "function" and color(i, n) or color
		block(
			model,
			hub,
			name,
			V(length, radialWidth, depth),
			CF(math.cos(angle) * radius, math.sin(angle) * radius, z) * A(0, 0, angle + PI / 2),
			col,
			mat,
			tr
		)
	end
end
local function disk(model, hub, name, radius, z, color, mat, tr)
	local p = make(model, name, V(0.055, radius * 2, radius * 2), color, mat, tr)
	p.Shape = Enum.PartType.Cylinder -- native cylinder axis X, rotated onto portal normal Z
	weld(hub, p, CF(0, 0, z) * A(0, PI / 2, 0))
	return p
end
local function rotor(model, root, name, base, speed, direction)
	local p = make(model, name, V(0.05, 0.05, 0.05), INK, M.SmoothPlastic, 1)
	local w = weld(root, p, base, "PortalRotor")
	w:SetAttribute("Rate", speed * direction)
	w:SetAttribute("Axis", "Z")
	return p, { w = w, base = base, speed = speed, dir = direction, axis = "Z" }
end

-- A regular icosahedron provides real planar orb faces, rather than a round glass ball.
local phi = (1 + math.sqrt(5)) / 2
local ico = {
	V(-1, phi, 0),
	V(1, phi, 0),
	V(-1, -phi, 0),
	V(1, -phi, 0),
	V(0, -1, phi),
	V(0, 1, phi),
	V(0, -1, -phi),
	V(0, 1, -phi),
	V(phi, 0, -1),
	V(phi, 0, 1),
	V(-phi, 0, -1),
	V(-phi, 0, 1),
}
for i, p in ipairs(ico) do
	ico[i] = p.Unit
end
local faces, edges = {}, {}
for a = 1, 10 do
	for b = a + 1, 11 do
		for c = b + 1, 12 do
			local normal = (ico[b] - ico[a]):Cross(ico[c] - ico[a])
			local positive, negative = false, false
			for j, p in ipairs(ico) do
				if j ~= a and j ~= b and j ~= c then
					local d = normal:Dot(p - ico[a])
					positive = positive or d > 0.0001
					negative = negative or d < -0.0001
				end
			end
			if not (positive and negative) then
				table.insert(faces, { a, b, c })
				for _, pair in ipairs({ { a, b }, { b, c }, { a, c } }) do
					local x, y = math.min(pair[1], pair[2]), math.max(pair[1], pair[2])
					edges[x .. ":" .. y] = { x, y }
				end
			end
		end
	end
end

return function(API, Config)
	local function themeDetails(model, hub, id, r, p)
		if id == "Forest" then
			for side = -1, 1, 2 do
				for j = 0, 3 do
					local angle = side * (0.5 + j * 0.48)
					diamond(
						model,
						hub,
						"CarvedLeaf",
						CF(math.sin(angle) * r * 1.12, math.cos(angle) * r * 1.1, -r * 0.09) * A(0.22, 0, -angle),
						r * 0.62,
						r * 0.24,
						r * 0.07,
						j % 2 == 0 and p.color or p.color2,
						M.SmoothPlastic
					)
				end
				beam(
					model,
					hub,
					"BranchRoot",
					V(side * r * 0.55, -r * 0.95, 0),
					V(side * r * 1.35, -r * 1.17, -0.15),
					r * 0.18,
					r * 0.18,
					Color3.fromRGB(101, 70, 43),
					M.Wood
				)
			end
		elseif id == "Lava" or id == "Dark" or id == "Ice" then
			for i = 0, 7 do
				local a = i / 8 * PI * 2
				local ice = id == "Ice"
				local col = ice and Color3.fromRGB(190, 230, 245)
					or (id == "Lava" and Color3.fromRGB(46, 37, 42) or INK)
				diamond(
					model,
					hub,
					ice and "FrostCrystal" or "ArmoredSpine",
					CF(math.sin(a) * r * 1.14, math.cos(a) * r * 1.14, 0) * A(0, 0, -a),
					r * (ice and 0.70 or (id == "Dark" and (i % 2 == 0 and 0.95 or 0.35) or 0.54)),
					r * 0.26,
					r * 0.19,
					col,
					ice and M.Ice or API.Theme[id].frameMat
				)
				block(
					model,
					hub,
					"InsetEnergySeam",
					V(r * 0.055, r * 0.22, r * 0.035),
					CF(math.sin(a) * r, math.cos(a) * r, -r * 0.20) * A(0, 0, -a),
					p.color2,
					M.Neon
				)
			end
		elseif id == "Galaxy" then
			ring(model, hub, "Astrolabe", r * 1.32, r * 0.035, r * 0.035, 0.16, GOLD, M.Metal, 32)
			for i = 0, 5 do
				local a = i / 6 * PI * 2
				diamond(
					model,
					hub,
					"StarMarker",
					CF(math.sin(a) * r * 1.32, math.cos(a) * r * 1.32, -0.06) * A(0, 0, -a),
					r * 0.24,
					r * 0.12,
					0.04,
					p.color2,
					M.Neon
				)
			end
		elseif id == "Divine" then
			for side = -1, 1, 2 do
				for j = 0, 3 do
					local bladeCF = CF(side * r * (1.08 + j * 0.13), r * (0.10 + j * 0.23), 0.02)
						* A(0, 0, -side * (0.8 - j * 0.12))
					diamond(
						model,
						hub,
						"ArchitecturalWingBlade",
						bladeCF,
						r * (0.9 - j * 0.10),
						r * 0.21,
						r * 0.07,
						j == 0 and GOLD or IVORY,
						M.SmoothPlastic
					)
					beam(
						model,
						hub,
						"FeatherGoldVein",
						bladeCF * V(0, -r * (0.40 - j * 0.04), -r * 0.05),
						bladeCF * V(0, r * (0.40 - j * 0.04), -r * 0.05),
						r * 0.027,
						r * 0.027,
						GOLD,
						M.Metal
					)
				end
			end
			local halo = block(model, hub, "HaloMount", V(0.05, 0.05, 0.05), CF(0, r * 1.48, 0), GOLD, M.Metal, 1)
			ring(model, halo, "DivineHalo", r * 0.30, r * 0.035, r * 0.055, 0, GOLD, M.Metal, 16)
		elseif id == "Secret" then
			for i = 0, 11 do
				local a = i / 12 * PI * 2
				block(
					model,
					hub,
					"BrokenCircuitPlate",
					V(r * 0.33, r * 0.15, r * 0.22),
					CF(math.sin(a) * r * 1.18, math.cos(a) * r * 1.18, i % 2 == 0 and 0.15 or -0.10) * A(0, 0, -a),
					INK,
					M.Metal
				)
				block(
					model,
					hub,
					"CircuitInset",
					V(r * 0.23, r * 0.025, 0.025),
					CF(math.sin(a) * r * 1.18, math.cos(a) * r * 1.18, -r * 0.14) * A(0, 0, -a),
					i % 2 == 0 and p.color or p.color2,
					M.Neon
				)
			end
		end
	end
	function API.BuildOrb(id: string, scale: number?)
		local p = assert(Config.Portals[id], "Unknown portal " .. tostring(id))
		local s = scale or 1
		local model = Instance.new("Model")
		model.Name = "PortalOrb"
		local root = make(model, "Core", V(0.12, 0.12, 0.12), p.color, M.SmoothPlastic, 1)
		root.Anchored = true
		model.PrimaryPart = root
		for i, face in ipairs(faces) do
			local col = p.fx == "Rainbow" and Color3.fromHSV(i / #faces, 0.55, 0.85)
				or p.color:Lerp(p.color2, (i % 4) * 0.12)
			triangle(
				model,
				root,
				"CrystalFacet",
				ico[face[1]] * s,
				ico[face[2]] * s,
				ico[face[3]] * s,
				col,
				M.SmoothPlastic,
				0.035 * s
			)
		end
		local trim = (id == "Lava" or id == "Dark" or id == "Secret") and p.color2 or GOLD
		for _, edge in pairs(edges) do
			beam(
				model,
				root,
				"InlaidCage",
				ico[edge[1]] * s * 1.025,
				ico[edge[2]] * s * 1.025,
				0.065 * s,
				0.065 * s,
				trim,
				M.Metal
			)
		end
		local hub, ringRef = rotor(model, root, "OrbitRuneAssembly", CF(), 0.7, 1)
		for j = 0, 2 do
			local a = j / 3 * PI * 2
			diamond(
				model,
				hub,
				"OrbitRune",
				CF(math.cos(a) * 1.26 * s, math.sin(a) * 1.26 * s, 0) * A(0, 0, a),
				0.30 * s,
				0.13 * s,
				0.04 * s,
				p.color2,
				M.Neon
			)
		end
		local light = Instance.new("PointLight")
		light.Color, light.Range, light.Brightness = p.color, 9 * s, 0.7
		light.Parent = root
		local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
		a0.Position, a1.Position, a0.Parent, a1.Parent = V(0, 0.5, 0) * s, V(0, -0.5, 0) * s, root, root
		local trail = Instance.new("Trail")
		trail.Attachment0, trail.Attachment1, trail.Color = a0, a1, API.ColorSeq(id)
		trail.Lifetime, trail.LightEmission, trail.FaceCamera, trail.Enabled = 0.28, 0.8, true, false
		trail.Transparency, trail.WidthScale = NumberSequence.new(0.3, 1), NumberSequence.new(0.65, 0)
		trail.Parent = root
		local pe = API.Emitter(root, id, 4, 0.15 * s, 0.8)
		model:SetAttribute("PortalId", id)
		model:SetAttribute("DesignVersion", 2)
		return model, { core = root, rings = { ringRef }, trail = trail, emitter = pe, light = light }
	end
	function API.BuildGate(id: string, radius: number?, options)
		local p = assert(Config.Portals[id], "Unknown portal " .. tostring(id))
		local r = radius or 4
		assert(r > 0 and r < 100, "Portal radius out of bounds")
		local sanctuary = options and options.sanctuary
		if sanctuary then
			p = { color = Color3.fromRGB(143, 84, 217), color2 = Color3.fromRGB(214, 177, 255), fx = "Stars" }
		end
		local th = API.Theme[id]
		local model = Instance.new("Model")
		model.Name = sanctuary and "SanctuaryPortal" or "PortalGate"
		local root = make(model, "Root", V(0.05, 0.05, 0.05), INK, M.SmoothPlastic, 1)
		root.Anchored = true
		model.PrimaryPart = root
		local frameHub = make(model, "FrameHub", V(0.05, 0.05, 0.05), INK, M.SmoothPlastic, 1)
		local fw = weld(root, frameHub, CF())
		local frameColor = sanctuary and Color3.fromRGB(83, 50, 129) or th.frameCol
		local function frameRing(modelArg, hub, name, rr, width, depth, z, color, mat, n, tr)
			if not sanctuary then
				ring(modelArg, hub, name, rr, width, depth, z, color, mat, n, tr)
				return
			end
			local pieces = 16
			for i = 0, pieces - 1 do
				local angle = (i + 0.5) / pieces * PI
				block(
					modelArg,
					hub,
					name,
					V(2 * rr * math.tan(PI / (pieces * 2)) * 1.015, width, depth),
					CF(math.cos(angle) * rr, math.sin(angle) * rr, z) * A(0, 0, angle + PI / 2),
					color,
					mat,
					tr
				)
			end
			for side = -1, 1, 2 do
				block(modelArg, hub, name, V(width, rr, depth), CF(side * rr, -rr / 2, z), color, mat, tr)
			end
		end
		local framePaint = id == "Rainbow" and function(i, n)
			return Color3.fromHSV(i / n, 0.45, 0.94)
		end or frameColor
		frameRing(
			model,
			frameHub,
			"Frame",
			r,
			r * 0.20,
			r * 0.23,
			0,
			framePaint,
			sanctuary and M.SmoothPlastic or th.frameMat,
			24
		)
		frameRing(model, frameHub, "OuterMolding", r * 1.105, r * 0.055, r * 0.29, 0, GOLD, M.Metal, 24)
		frameRing(model, frameHub, "InnerMolding", r * 0.89, r * 0.035, r * 0.12, -r * 0.15, GOLD, M.Metal, 24)
		frameRing(
			model,
			frameHub,
			"EnergyInlay",
			r * 0.855,
			r * 0.025,
			r * 0.035,
			-r * 0.17,
			id == "Rainbow" and function(i, n)
				return Color3.fromHSV(i / n, 0.6, 1)
			end or p.color,
			M.Neon,
			24,
			0.2
		)
		for i = 0, 7 do
			local a = sanctuary and (i / 7 - 0.5) * PI or i / 8 * PI * 2
			block(
				model,
				frameHub,
				"RadialClasp",
				V(r * 0.16, r * 0.29, r * 0.29),
				CF(math.sin(a) * r, math.cos(a) * r, -r * 0.02) * A(0, 0, -a),
				GOLD,
				M.Metal
			)
		end
		for side = -1, 1, 2 do
			block(
				model,
				frameHub,
				"Footing",
				V(r * 0.42, r * 0.30, r * 0.48),
				CF(side * r * (sanctuary and 1 or 0.78), -r * 0.94, 0),
				sanctuary and IVORY or frameColor,
				M.SmoothPlastic
			)
		end
		diamond(
			model,
			frameHub,
			"CrownSetting",
			CF(0, r * 1.16, -r * 0.12),
			r * 0.64,
			r * 0.36,
			r * 0.12,
			GOLD,
			M.Metal
		)
		diamond(
			model,
			frameHub,
			"CrownCrystal",
			CF(0, r * 1.16, -r * 0.20),
			r * 0.43,
			r * 0.21,
			r * 0.055,
			p.color,
			M.SmoothPlastic
		)
		if not sanctuary then
			themeDetails(model, frameHub, id, r, p)
		end
		disk(
			model,
			root,
			"ApertureDepth",
			r * 0.86,
			0.06,
			p.color:Lerp(INK, id == "Rainbow" and 0.93 or 0.80),
			M.SmoothPlastic,
			sanctuary and 1 or 0.08
		)
		disk(model, root, "EnergyVeil", r * 0.85, -r * 0.07, p.color, M.Neon, sanctuary and 1 or 0.93)
		local discs = {}
		for arm = 0, 3 do
			local hub, ref = rotor(model, root, "VortexArm" .. arm, CF(0, 0, -r * (0.09 + arm * 0.005)), 0.65, 1)
			table.insert(discs, ref)
			for j = 1, 9 do
				local t0, t1 = (j - 1) / 9, j / 9
				local function point(t)
					local a = arm / 4 * PI * 2 + t * 2.85
					local rr = r * (0.02 + t * 0.77)
					return V(math.cos(a) * rr, math.sin(a) * rr, 0)
				end
				local d = point(t1) - point(t0)
				block(
					model,
					hub,
					"VortexRibbon",
					V(d.Magnitude * 1.20, r * (0.06 + 0.14 * math.sin((t0 + t1) / 2 * PI)), r * 0.008),
					CF((point(t0) + point(t1)) / 2) * A(0, 0, math.atan2(d.Y, d.X)),
					id == "Rainbow" and Color3.fromHSV((arm / 4 + t0 * 0.30) % 1, 0.5, 1)
						or p.color2:Lerp(Color3.new(1, 1, 1), 0.55 - t0 * 0.30),
					M.Neon,
					sanctuary and 1 or 0.12 + j * 0.042
				)
			end
		end
		local light = Instance.new("PointLight")
		light.Color, light.Range, light.Brightness = p.color, math.min(r * 3, 40), sanctuary and 0.5 or 1.1
		light.Parent = root
		local pe = API.Emitter(root, id, sanctuary and 0 or 8, 0.25, 1.5)
		pe.Shape, pe.ShapeStyle, pe.EmissionDirection =
			Enum.ParticleEmitterShape.Disc, Enum.ParticleEmitterShapeStyle.Surface, Enum.NormalId.Front
		model:SetAttribute("PortalId", id)
		model:SetAttribute("DesignVersion", 2)
		return model,
			{ root = root, frame = { w = fw, base = fw.C0 }, discs = discs, emitter = pe, light = light, radius = r }
	end
	function API.Spin(refs, t: number)
		-- Architecture stays planted. Only the aperture and small orbit runes move.
		local root = refs.root or refs.core
		local scale = 1
		if typeof(game) == "Instance" and root and root.Parent then
			scale = root.Parent:GetScale()
		end
		for _, d in ipairs(refs.discs or refs.rings or {}) do
			d.w.C0 = CF(d.base.Position * scale) * d.base.Rotation * A(0, 0, t * d.speed * d.dir)
		end
	end
	API.Geometry = { triangle = triangle, icoFaces = #faces, icoVertices = #ico }
	return API
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">PresentationTimeline</string><ProtectedString name="Source"><![CDATA[-- PresentationTimeline: the ONE table of reveal / capture / card timings used by every client
-- module (CreatureRenderer, ThrowController, ClientMain). Presentation only: the server still owns
-- the authoritative catch deadline (Config.CatchDelay, unchanged) and never waits for clients.
-- Location: ReplicatedStorage > Shared > PresentationTimeline (ModuleScript)
--
-- Per throw:  PortalThrown -> flight (server t) -> local landing bounces (0.5 s) -> gate opens
--             PortalOpened (server: flight + 0.9) -> creature entrance (Entrance[r])
--             -> showcase (>= ShowcaseMin) -> server catch at CatchDelay[r] -> capture (Capture[r])
--             -> caught card (Card.enter + Card.hold + Card.travel), queued per player.

local Config = require(script.Parent.Config)

local T = {}

-- Discoveries come from the saved bestiary, not a timer or session-only flag.
-- Rare and above earn a reveal on every catch; lower tiers earn it once per species.
function T.ShouldPresent(rarity: string, discovery: boolean): boolean
	local tier = Config.Rarities[rarity]
	return (tier ~= nil and tier.order >= 3) or discovery == true
end

-- species entrance must END inside this window (seconds after PortalOpened)
T.Entrance = { Common = 1.5, Uncommon = 1.5, Rare = 1.4, Epic = 1.4, Legendary = 2.2, Mythical = 2.4, Secret = 1.9, Divine = 2.6 }
-- capture presentation after the server's collect event
T.Capture = { Common = 0.9, Uncommon = 1.0, Rare = 1.2, Epic = 1.3, Legendary = 1.6, Mythical = 1.8, Secret = 1.6, Divine = 2.0 }
T.CaptureAccent = 0.2      -- fraction of Capture[r] given to the species capture accent
T.ShowcaseMin = 0.8        -- readable full-silhouette hold between entrance and capture
T.LandBounce = 0.5         -- local orb bounce before the gate opens
T.GateOpen = 0.45
T.GateClose = 0.35
T.Card = { enter = 0.16, hold = 1.2, travel = 0.16, gap = 0.15 }
T.CardFallback = 3.0       -- if the capture visual never reports, show the card anyway
T.CameraTimeout = 14       -- hard cap on any follow-camera claim
-- THROW CUTSCENE: time between PortalThrown and the ball leaving the hand (you raise the portal,
-- it powers up, you throw). The rarer the creature inside, the longer and crazier it gets.
-- The server delays the portal opening by the same amount, so the reveal stays in sync.
-- (ThrowCinematic: Common/Uncommon = 2 shots, Rare/Epic = 3 shots, Legendary+ = 4 shots)
T.Windup = { Common = 1.4, Uncommon = 1.5, Rare = 1.9, Epic = 2.3, Legendary = 2.9, Mythical = 3.3, Secret = 3.3, Divine = 3.8 }

function T.WindupFor(rarity: string?): number
	return (rarity and T.Windup[rarity]) or 1.4
end

function T.CatchDelay(rarity: string): number
	return Config.CatchDelay[rarity] or 3
end

function T.EntranceFor(rarity: string): number
	return T.Entrance[rarity] or 1.5
end

function T.CaptureFor(rarity: string): number
	return T.Capture[rarity] or 1
end

function T.Showcase(rarity: string): number
	return T.CatchDelay(rarity) - T.EntranceFor(rarity)
end

-- gate closes shortly after the creature has fully stepped out
function T.GateCloseAfterOpen(rarity: string): number
	return T.EntranceFor(rarity) + 0.35
end

-- owner's follow camera stays on the reveal until the capture has finished
function T.FollowHoldAfterOpen(rarity: string): number
	return T.CatchDelay(rarity) + T.CaptureFor(rarity) + 0.4
end

-- delay from the Deposit event (fired with the collect) to the caught card
function T.CardDelay(rarity: string): number
	return T.CaptureFor(rarity) + 0.1
end

function T.CardTotal(): number
	return T.Card.enter + T.Card.hold + T.Card.travel + T.Card.gap
end

return T
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">SanctuaryLook</string><ProtectedString name="Source"><![CDATA[-- One art-direction source for Studio, every biome and farm weather.
local Config = require(script.Parent.Config)
local C = Color3.fromRGB
local Look = {
	ambient = C(118, 131, 145),
	indoor = C(59, 66, 78),
	fog = C(186, 208, 218),
	clock = 16.35,
	tint = C(255, 250, 240),
	atmo = C(216, 226, 228),
	density = 0.265,
	haze = 1.15,
	glare = 0.11,
	offset = 0.18,
	bloom = 0.14,
	sunTop = C(34, 24, 12),
	shadeBottom = C(6, 13, 24),
}
local zones = {
	Hub = { contrast = 0.08, sat = 0.10, exposure = -0.08, cover = 0.28, lat = 32 },
	Forest = { density = 0.28, haze = 1.05, contrast = 0.075, sat = 0.10, cover = 0.38, clock = 15.55 },
	Volcano = {
		density = 0.31,
		haze = 1.45,
		contrast = 0.10,
		sat = 0.035,
		cover = 0.64,
		bloom = 0.22,
		exposure = -0.12,
	},
	Frozen = { density = 0.27, haze = 1.1, contrast = 0.055, sat = 0.025, cover = 0.50, exposure = -0.12 },
	Crystal = { density = 0.28, haze = 0.8, contrast = 0.08, sat = 0.04, cover = 0.26, bloom = 0.22 },
	Candy = { density = 0.255, haze = 0.9, contrast = 0.045, sat = 0.02, cover = 0.36, exposure = -0.13 },
	Space = {
		density = 0.17,
		haze = 0.45,
		contrast = 0.08,
		sat = 0.025,
		cover = 0,
		bloom = 0.24,
		exposure = 0.08,
		rays = 0,
	},
	Shadow = {
		density = 0.32,
		haze = 1.25,
		contrast = 0.085,
		sat = 0.015,
		cover = 0.58,
		bloom = 0.20,
		exposure = 0.04,
		rays = 0,
	},
	Heaven = { density = 0.28, haze = 1.1, contrast = 0.045, sat = 0.025, cover = 0.56, exposure = -0.13, bloom = 0.17 },
}
function Look.Targets(id, weather, low, reducedFlashes)
	local hub = id == "Hub" or Config.Worlds[id] == nil
	local world = hub and Look or Config.Worlds[id]
	local p = zones[id] or zones.Hub
	local outdoor = hub and Look.ambient or world.ambient:Lerp(C(119, 138, 155), 0.58)
	local indoor = hub and Look.indoor or outdoor:Lerp(C(41, 49, 62), 0.53)
	local lighting = {
		Ambient = indoor,
		OutdoorAmbient = outdoor,
		Brightness = 3.15,
		ClockTime = p.clock or world.clock,
		GeographicLatitude = p.lat or 32,
		ExposureCompensation = p.exposure or -0.065,
		ShadowSoftness = 0.14,
		ColorShift_Top = Look.sunTop,
		ColorShift_Bottom = Look.shadeBottom,
		EnvironmentDiffuseScale = 0.68,
		EnvironmentSpecularScale = 0.42,
		FogColor = world.fog,
		FogStart = 100,
		FogEnd = 2400,
	}
	local atmosphere = {
		Color = world.atmo,
		Decay = world.fog,
		Density = p.density or Look.density,
		Haze = p.haze or Look.haze,
		Offset = Look.offset,
		Glare = p.glare or Look.glare,
	}
	local grade = { TintColor = world.tint, Contrast = p.contrast, Saturation = p.sat, Brightness = 0 }
	local cover = p.cover
	-- Weather belongs in this grade, not a second full-screen color multiplier.
	if (hub or id == "Forest") and not reducedFlashes then
		if weather == "Rain" then
			lighting.Brightness, lighting.ClockTime = 2.25, 14.2
			lighting.ExposureCompensation = -0.02
			lighting.OutdoorAmbient = C(127, 143, 157)
			grade.TintColor, grade.Saturation, grade.Contrast = C(239, 248, 255), 0.025, 0.045
			atmosphere.Density, atmosphere.Haze, atmosphere.Glare = 0.31, 1.45, 0
			cover = 0.82
		elseif weather == "GoldenHour" then
			lighting.ClockTime, lighting.ColorShift_Top = 16.65, C(55, 28, 9)
			grade.TintColor, grade.Saturation = C(255, 247, 229), 0.10
			atmosphere.Color, atmosphere.Glare = C(237, 220, 190), 0.16
		elseif weather == "Starfall" then
			lighting.ClockTime, lighting.Brightness = 19.2, 2.1
			lighting.OutdoorAmbient, lighting.Ambient = C(107, 125, 151), C(57, 69, 91)
			grade.TintColor, grade.Saturation = C(239, 246, 255), 0.04
			atmosphere.Glare, cover = 0, 0.18
		elseif weather == "Aurora" then
			lighting.ClockTime, lighting.Brightness = 18.55, 2.5
			grade.TintColor, grade.Saturation = C(238, 252, 246), 0.065
			atmosphere.Glare, cover = 0, 0.24
		end
	end
	return {
		lighting = lighting,
		atmosphere = atmosphere,
		grade = grade,
		bloom = { Intensity = low and 0 or (p.bloom or Look.bloom), Threshold = 2.15, Size = 18 },
		rays = { Intensity = low and 0 or ((weather == "Rain") and 0 or (p.rays or 0.035)), Spread = 0.75 },
		clouds = { Cover = cover, Density = 0.48, Color = weather == "Rain" and C(185, 197, 207) or C(245, 247, 248) },
	}
end
local function apply(object, properties)
	for key, value in properties do
		object[key] = value
	end
end
function Look.Apply(lighting)
	lighting.GlobalShadows = true
	-- LightingStyle/PrioritizeLightingQuality are authored in Studio and the
	-- place build; ordinary game scripts cannot write these protected settings.
	for _, name in { "TPFC_FilmGrade", "TPFC_HighlightGlow", "FarmWeatherCC" } do
		local obsolete = lighting:FindFirstChild(name)
		if obsolete then
			obsolete:Destroy()
		end
	end
	local function effect(class, name)
		local object = lighting:FindFirstChild(name) or Instance.new(class)
		object.Name, object.Parent = name, lighting
		return object
	end
	local target = Look.Targets("Hub")
	local refs = {
		lighting = lighting,
		atmosphere = effect("Atmosphere", "SanctuaryAtmosphere"),
		grade = effect("ColorCorrectionEffect", "TPFC_CC"),
		bloom = effect("BloomEffect", "TPFC_Bloom"),
		rays = effect("SunRaysEffect", "TPFC_Rays"),
	}
	for name, object in refs do
		apply(object, target[name])
	end
	local sky = effect("Sky", "Sky")
	sky.SunAngularSize, sky.MoonAngularSize, sky.StarCount = 6.5, 7, 1800
	return refs
end
return Look
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">SpeciesAnatomy</string><ProtectedString name="Source"><![CDATA[-- SpeciesAnatomy: species-specific anatomy for every creature + extra body plans.
-- Location: ReplicatedStorage > Shared > SpeciesAnatomy (ModuleScript)
--
-- Each builder is called as A[key](H, rig, vd, s, prof) AFTER the generic body plan, face,
-- ears, horns, tail, wings and extras exist. H = CreatureBuilder.H (part helpers).
-- Builders add geometry and register rig channels:
--   rig.chains  (via H.chain)   kinds: neck | spine | tentacle | trail | fan | fluke | plume | echo
--   rig.groups  open (entries with openAxis/openAmt react to pose.open), flutter, orbit,
--               lag, fragments, rays, clockRings, seed, ...
--   rig.glows   { part, base, bright }   -> pose.glow lerps colour
--   rig.reveal  { {parts...}, ... }      -> pose.hide fades units out in order (LocalTransparencyModifier)
-- All chains extend along their pivot's local +Z unless rec.axisMode == "y".

local A = {}
local Plans = {}
A.Plans = Plans

local PI = math.pi
local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local WHITE = Color3.new(1, 1, 1)
local function C(h) return Color3.fromHex(h) end

---------------------------------------------------------------- helpers
local function openable(H, rig, e, axis, amt)
	e.openAxis, e.openAmt = axis, amt
	H.group(rig, "open", e)
	return e
end

local function glow(rig, part, bright)
	rig.glows = rig.glows or {}
	table.insert(rig.glows, { part = part, base = part.Color, bright = bright or WHITE })
end

-- run fn, return every part created during it (a "unit" for reveal)
local function unitOf(rig, fn)
	local a = #rig.all
	fn()
	local list = {}
	for i = a + 1, #rig.all do table.insert(list, rig.all[i].part) end
	return list
end

-- every part welded (directly or indirectly) below `roots`, roots included
local function subtree(rig, roots)
	local children = {}
	for _, e in ipairs(rig.all) do
		local p0 = e.w.Part0
		children[p0] = children[p0] or {}
		table.insert(children[p0], e.part)
	end
	local out, stack = {}, {}
	for _, r in ipairs(roots) do table.insert(stack, r) end
	while #stack > 0 do
		local p = table.remove(stack)
		table.insert(out, p)
		for _, c in ipairs(children[p] or {}) do table.insert(stack, c) end
	end
	return out
end

local function reveal(rig, parts)
	rig.reveal = rig.reveal or {}
	table.insert(rig.reveal, parts)
end

-- segmented chain along local +Z of c0first
local function zchain(H, rig, parent, name, c0first, n, segLen, radAt, colAt, meta, matAt, trAt)
	local rec = H.chain(rig, parent, name, c0first, n, function(j, nn)
		local t = (j - 1) / math.max(1, nn - 1)
		local r = radAt(t, j)
		return V3(r * 2, r * 2, segLen * 1.4), colAt(t, j), matAt and matAt(t, j) or nil, trAt and trAt(t, j) or 0,
			CF(0, 0, segLen * 0.55), CF(0, 0, -segLen * 0.5)
	end, meta)
	return rec
end

local function aurora(t)
	local cols = { C("#7CFFCB"), C("#8CA0FF"), C("#FF8CF0"), C("#FFFFFF") }
	local i = math.clamp(math.floor(t * 3.999) + 1, 1, 4)
	return cols[i]
end

---------------------------------------------------------------- EXTRA BODY PLANS
-- Magma Kraken: bulbous mantle + 8 articulated tentacles
function Plans.kraken(H, rig, def, s, prof)
	local p, sc, a = def._p, def._s, def._a
	local br = V3(1.15, 1.35, 1.1) * s
	local e, body = H.ell(rig, rig.root, "Body", br * 2, p, CF(0, 2.4 * s, 0) * ANG(0.25, 0, 0), Enum.Material.Neon, 0)
	rig.bodyEntry = e
	-- darker crust bands so the neon mantle keeps a readable silhouette
	for i = 0, 2 do
		H.ell(rig, body, "MantleBand", V3(br.X * 2.04, 0.28 * s, br.Z * 2.04) * (1 - i * 0.12), H.darken(p, 0.55), CF(0, br.Y * (0.15 + i * 0.3), 0.05 * s))
	end
	H.ell(rig, body, "Underside", V3(br.X * 1.7, br.Y * 0.8, br.Z * 1.7), sc, CF(0, -br.Y * 0.62, 0))
	H.ell(rig, body, "Beak", V3(0.4, 0.3, 0.4) * s, a, CF(0, -br.Y * 0.95, -0.05 * s))
	rig.legKind = "none"
	for i = 1, 8 do
		local ang = (i - 0.5) / 8 * PI * 2
		local pos = V3(math.sin(ang) * br.X * 0.7, -br.Y * 0.75, -math.cos(ang) * br.Z * 0.7)
		local dir = V3(math.sin(ang) * 0.8, -0.6, -math.cos(ang) * 0.8).Unit
		local c0 = CFrame.lookAt(pos, pos - dir) -- +Z points along dir
		local rec = zchain(H, rig, body, "Tentacle", c0, 5, 0.55 * s, function(t) return (0.34 - t * 0.24) * s end,
			function(t) return t > 0.75 and sc or p end, { kind = "tentacle", i = i, side = math.sin(ang) >= 0 and 1 or -1, amp = 0.35, freq = 1.4, lag = 0.7 },
			function() return Enum.Material.SmoothPlastic end)
		for j = 1, 2 do -- simplified suckers
			H.ell(rig, rec.parts[j], "Sucker", V3(0.18, 0.18, 0.12) * s, H.lighten(sc, 0.3), CF(0, -0.22 * s * (1 - j * 0.2), 0))
		end
		H.group(rig, "tentacles", rec)
		reveal(rig, rec.parts)
	end
	return body, body, br, br, -0.2 * s, CF(0, 0, br.Z), 0.3 * s
end

-- Amethyst Eel: head + 7-segment body chain + crystal ridge + tail fin
function Plans.eel(H, rig, def, s, prof)
	local p, sc, a = def._p, def._s, def._a
	local br = V3(0.7, 0.62, 0.85) * s
	local e, body = H.ell(rig, rig.root, "Body", br * 2, p, CF(0, 1.6 * s, -1.6 * s))
	rig.bodyEntry = e
	H.ell(rig, body, "Jaw", V3(1.2, 0.5, 1.4) * s, sc, CF(0, -0.32 * s, -0.15 * s))
	rig.legKind = "none"
	local rec = zchain(H, rig, body, "Spine", CF(0, 0, br.Z * 0.8), 7, 0.62 * s, function(t) return (0.6 - t * 0.38) * s end,
		function(t, j) return j % 2 == 0 and p or H.lighten(p, 0.08) end, { kind = "spine", i = 1, amp = 0.35, freq = 2.2, lag = 0.65 })
	for j, part in ipairs(rec.parts) do
		H.ell(rig, part, "BellyStrip", V3(0.7, 0.45, 0.9) * s * (1 - j * 0.07), sc, CF(0, -0.22 * s * (1 - j * 0.06), 0))
		if j <= 5 then H.crystal(rig, part, "Ridge", (0.55 - j * 0.05) * s, 0.18 * s, a, CF(0, 0.3 * s * (1 - j * 0.07), 0) * ANG(0.5, 0, 0), Enum.Material.Glass, 0.05) end
	end
	local last = rec.parts[#rec.parts]
	H.tri(rig, last, "TailFin", 0.08 * s, 1.3 * s, 1.1 * s, H.lighten(a, 0.2), CF(0, 0, 0.6 * s) * ANG(-PI / 2, 0, 0), Enum.Material.Glass, 0.35)
	for _, side in ipairs({ -1, 1 }) do
		local fin = H.ell(rig, body, "Fin", V3(0.7, 0.08, 0.45) * s, a, CF(side * br.X * 0.9, -0.2 * s, 0.3 * s) * ANG(0, side * 0.4, 0), nil, 0.2, CF(-side * 0.3 * s, 0, 0))
		table.insert(rig.wings, { e = fin, side = side, tier = 1 })
	end
	return body, body, br, br, 0.12 * s, CF(0, 0, br.Z), 0.2 * s
end

-- Nebula Jelly: translucent bell, opaque eye rim, nebula core, tendrils
function Plans.jelly(H, rig, def, s, prof)
	local p, sc, a = def._p, def._s, def._a
	local br = V3(1.25, 1.0, 1.25) * s
	local e, body = H.ell(rig, rig.root, "Body", br * 2, p, CF(0, 3.0 * s, 0), Enum.Material.Glass, 0.35)
	rig.bodyEntry = e
	H.band(rig, body, "BellRim", CF(0, -br.Y * 0.45, 0), br.X * 0.9, 0.3 * s, H.darken(p, 0.25), 18, Enum.Material.SmoothPlastic)
	local core = H.ell(rig, body, "Core", V3(1.0, 0.8, 1.0) * s, sc, CF(0, 0.05 * s, 0.1 * s), Enum.Material.Neon, 0.15)
	rig.core = core
	glow(rig, core.part, WHITE)
	for i = 1, 3 do
		local m = H.ell(rig, core.part, "Nebula", V3(0.45, 0.35, 0.45) * s, i == 2 and a or H.lighten(p, 0.3), CF(math.cos(i * 2.1) * 0.35 * s, (i - 2) * 0.15 * s, math.sin(i * 2.1) * 0.35 * s), Enum.Material.Neon, 0.3)
		H.group(rig, "orbit", m)
	end
	rig.legKind = "none"
	for i = 1, 7 do
		local ang = (i - 0.5) / 7 * PI * 2
		local pos = V3(math.cos(ang) * br.X * 0.6, -br.Y * 0.5, math.sin(ang) * br.Z * 0.6)
		local rec = zchain(H, rig, body, "Tendril", CF(pos) * ANG(PI / 2, 0, 0), 5, 0.5 * s, function(t) return (0.12 - t * 0.07) * s end,
			function(t) return t < 0.5 and sc or a end, { kind = "trail", i = i, amp = 0.25, freq = 1.6, lag = 0.8, hang = true },
			function() return Enum.Material.Neon end, function() return 0.2 end)
		H.group(rig, "tendrils", rec)
	end
	return body, body, br, br, -0.1 * s, CF(0, 0, br.Z), 0.3 * s
end

-- Star Whale: broad horizontal whale with flukes and pectoral fins
function Plans.whale(H, rig, def, s, prof)
	local p, sc, a = def._p, def._s, def._a
	local br = V3(1.3, 1.0, 2.3) * s
	local e, body = H.ell(rig, rig.root, "Body", br * 2, p, CF(0, 2.2 * s, 0))
	rig.bodyEntry = e
	H.ell(rig, body, "Forehead", V3(2.2, 1.8, 2.0) * s, p, CF(0, 0.15 * s, -br.Z * 0.6))
	H.ell(rig, body, "Belly", V3(2.2, 1.2, 3.8) * s, sc, CF(0, -br.Y * 0.45, -0.2 * s))
	for i = -2, 2 do -- throat grooves
		H.blk(rig, body, "Groove", V3(0.06, 0.06, 1.6) * s, H.darken(sc, 0.2), CF(i * 0.22 * s, -br.Y * 0.86, -br.Z * 0.45) * ANG(0.05, 0, 0))
	end
	for i = 1, 6 do -- star speckles
		H.ell(rig, body, "Star", V3(0.16, 0.16, 0.16) * s, a, H.surface(br, math.cos(i * 1.7) * br.X * 0.6, br.Y * 0.4 + math.sin(i) * 0.2 * s, -1), Enum.Material.Neon)
	end
	for _, side in ipairs({ -1, 1 }) do
		local fin = H.ell(rig, body, "Pectoral", V3(1.9, 0.14, 0.7) * s, H.darken(p, 0.1), CF(side * br.X * 0.85, -br.Y * 0.4, -br.Z * 0.35) * ANG(0, side * 0.35, side * -0.35), nil, nil, CF(-side * 0.85 * s, 0, 0))
		table.insert(rig.wings, { e = fin, side = side, tier = 1 })
	end
	rig.legKind = "none"
	local rec = zchain(H, rig, body, "Peduncle", CF(0, 0.1 * s, br.Z * 0.85), 3, 0.75 * s, function(t) return (0.7 - t * 0.35) * s end,
		function() return p end, { kind = "fluke", i = 1, amp = 0.22, freq = 1.1, lag = 0.6 })
	local last = rec.parts[#rec.parts]
	for _, side in ipairs({ -1, 1 }) do
		H.ell(rig, last, "Fluke", V3(1.5, 0.14, 0.8) * s, H.darken(p, 0.1), CF(side * 0.65 * s, 0, 0.5 * s) * ANG(0, side * -0.45, 0))
	end
	return body, body, br, br, 0.05 * s, CF(0, 0, br.Z), 0.3 * s
end

---------------------------------------------------------------- FOREST
function A.mossbun(H, rig, vd, s)
	-- Common: plain and clean. Big hind haunches + two small moss plates on the back; nothing ornate.
	local br = rig.bodyRadius
	for _, side in ipairs({ -1, 1 }) do
		H.ell(rig, rig.body, "Haunch", V3(0.75, 0.95, 1.05) * s, vd._p, CF(side * br.X * 0.75, -br.Y * 0.2, br.Z * 0.45))
	end
	for i, x in ipairs({ -0.35, 0.3 }) do
		H.ell(rig, rig.body, "Moss", V3(0.7 - i * 0.1, 0.16, 0.8) * s, vd._a, CF(x * br.X, br.Y * 0.98, (i - 1.5) * 0.4 * s))
	end
end

function A.acornip(H, rig, vd, s)
	local hr = rig.headRadius
	for _, side in ipairs({ -1, 1 }) do
		H.ell(rig, rig.head, "CheekPouch", V3(0.75, 0.62, 0.62) * s, H.lighten(vd._s, 0.05), CF(side * hr.X * 0.7, -hr.Y * 0.35, -hr.Z * 0.3))
	end
	-- plump segmented tail curling up over the back
	local br = rig.bodyRadius
	local rec = zchain(H, rig, rig.body, "Tail", CF(0, br.Y * 0.4, br.Z * 0.85) * ANG(-1.0, 0, 0), 4, 0.6 * s,
		function(t) return (0.55 + math.sin(t * PI) * 0.2) * s end, function(t, j) return j % 2 == 0 and vd._p or H.lighten(vd._p, 0.12) end,
		{ kind = "plume", i = 1, amp = 0.18, freq = 3, lag = 0.5, curl = 0.45 })
	for j, part in ipairs(rec.parts) do part.Size = part.Size * V3(1, 1, 0.9) end
end

function A.petalfly(H, rig, vd, s)
	for _, w in ipairs(rig.wings) do
		if w.tier == 1 then
			for k = -1, 1, 2 do
				H.diamond(rig, w.e.part, "PetalVein", 1.1 * s, 0.32 * s, 0.05 * s, vd._s, CF(w.side * k * 0.25 * s, 0.05 * s, -0.02) * ANG(0, 0, w.side * (0.8 + k * 0.4)))
			end
		end
	end
	for _, ear in ipairs(rig.ears) do
		if ear.kind == "antenna" then H.ell(rig, ear.e.part, "Curl", V3(0.22, 0.22, 0.22) * s, vd._a, CF(0.12 * s, 0.38 * s, 0)) end
	end
end

function A.thornhog(H, rig, vd, s)
	local br = rig.bodyRadius
	local leafCols = { C("#2F8A3A"), vd._a, C("#7DD86A") }
	for row = 0, 2 do
		for k = 0, 3 do
			local x = (k - 1.5) * br.X * 0.42
			local z = -br.Z * 0.45 + row * br.Z * 0.48
			local y = br.Y * (0.85 - math.abs(k - 1.5) * 0.12) - row * 0.08 * s
			local pv = H.pivot(rig, rig.body, "SpinePivot", CF(x, y, z) * ANG(-0.9 + row * 0.15, 0, -(k - 1.5) * 0.35))
			H.diamond(rig, pv.part, "LeafSpine", 1.15 * s, 0.5 * s, 0.08 * s, leafCols[(row + k) % 3 + 1], CF(0, 0.45 * s, 0) * ANG(PI / 2, 0, 0))
			openable(H, rig, pv, V3(1, 0, 0), 0.35)
			H.group(rig, "spines", pv)
		end
	end
end

function A.elderstag(H, rig, vd, s)
	local br = rig.bodyRadius
	for i = 1, 4 do
		local side = i % 2 == 0 and 1 or -1
		H.blk(rig, rig.body, "BarkMark", V3(0.08, 0.5, 0.12) * s, C("#B7A27E"), H.surface(br, side * br.X * 0.9, (i - 2.5) * 0.15 * s, 1) * CF(0, 0, 0.02) * ANG(0, 0, i * 0.4))
	end
	for _, tip in ipairs(rig.groups.tips or {}) do glow(rig, tip.part, WHITE) end
end

function A.oakTitan(H, rig, vd, s)
	local br = rig.bodyRadius
	for i = 1, 8 do -- vertical bark ridges
		local ang = i / 8 * PI * 2
		H.blk(rig, rig.body, "Bark", V3(0.22 * s, br.Y * 1.6, 0.18 * s), C("#5A3E25"), CF(math.sin(ang) * br.X * 0.92, 0, math.cos(ang) * br.Z * 0.92) * ANG(0, ang, 0), Enum.Material.Wood)
	end
	for i = 1, 3 do
		H.ell(rig, rig.body, "MossSeam", V3(0.9, 0.25, 0.3) * s, C("#6FAE4A"), H.surface(br, (i - 2) * 0.5 * s, br.Y * 0.5, 1) * CF(0, 0, 0.05), Enum.Material.Grass)
	end
	local heart = H.ell(rig, rig.body, "KnotHeart", V3(0.6, 0.7, 0.2) * s, vd._a, H.surface(br, 0, 0.2 * s) * CF(0, 0, -0.02), Enum.Material.Neon)
	rig.core = heart
	glow(rig, heart.part, WHITE)
	for _, f in ipairs(rig.feet) do -- spreading roots
		for k = 0, 3 do
			local ang = k / 4 * PI * 2 + 0.4
			H.cyl(rig, f.part, "Root", V3(0.9, 0.18, 0.18) * s, C("#5A3E25"), CF(math.cos(ang) * 0.45 * s, -0.42 * s, math.sin(ang) * 0.45 * s) * ANG(0, -ang, -0.35), Enum.Material.Wood)
		end
	end
	for _, arm in ipairs(rig.arms) do -- twig forearms
		for k = 1, 2 do
			H.cyl(rig, arm.e.part, "Twig", V3(0.7, 0.12, 0.12) * s, C("#6B4E30"), CF(arm.side * 0.45 * s, -0.2 * s * k, 0) * ANG(0, 0, arm.side * (0.6 + k * 0.3)), Enum.Material.Wood)
			H.diamond(rig, arm.e.part, "TwigLeaf", 0.45 * s, 0.25 * s, 0.05 * s, C("#9BE07A"), CF(arm.side * 0.8 * s, -0.05 * s - 0.2 * s * k, 0) * ANG(PI / 2, 0, arm.side))
		end
	end
	for _, side in ipairs({ -1, 1 }) do -- leafy canopy clumps on the shoulders
		H.ell(rig, rig.body, "Canopy", V3(1.3, 0.9, 1.1) * s, C("#7CC85A"), CF(side * br.X * 0.75, br.Y * 0.85, 0.1 * s), Enum.Material.Grass)
	end
end

function A.bloomwyrm(H, rig, vd, s)
	local br = rig.bodyRadius
	for i = 0, 4 do
		H.diamond(rig, rig.body, "Frill", (0.95 - i * 0.1) * s, 0.5 * s, 0.07 * s, i % 2 == 0 and C("#3FB45A") or C("#7DE08C"),
			CF(0, br.Y * 0.95 - i * 0.05 * s, -br.Z * 0.55 + i * br.Z * 0.32) * ANG(0, PI / 2, 0) * CF(0, 0.3 * s, 0))
	end
	-- cheek flower (opens on reaction)
	for _, side in ipairs({ -1, 1 }) do
		local hr = rig.headRadius
		local center = H.pivot(rig, rig.head, "CheekFlower", CF(side * hr.X * 0.85, -hr.Y * 0.05, -hr.Z * 0.1) * ANG(0, 0, side * -PI / 2))
		for k = 1, 5 do
			local ang = k / 5 * PI * 2
			local pv = H.pivot(rig, center.part, "CheekPetal", ANG(0, ang, 0))
			H.ell(rig, pv.part, "Petal", V3(0.24, 0.06, 0.42) * s, vd._a, CF(0, 0.08 * s, -0.18 * s) * ANG(-0.4, 0, 0))
			openable(H, rig, pv, V3(1, 0, 0), -0.8)
		end
		H.ell(rig, center.part, "FlowerCore", V3(0.2, 0.14, 0.2) * s, C("#FFE45C"), CF(0, 0.05 * s, 0))
	end
	for i = 1, 2 do
		local fp = H.pivot(rig, rig.body, "BackFlower", CF((i - 1.5) * br.X * 0.9, br.Y * 0.7, br.Z * 0.2))
		for k = 1, 5 do
			local ang = k / 5 * PI * 2
			H.ell(rig, fp.part, "Petal", V3(0.4, 0.06, 0.24) * s, vd._s, CF(math.cos(ang) * 0.18 * s, 0.02 * s, math.sin(ang) * 0.18 * s) * ANG(0, -ang, 0.25))
		end
		H.ell(rig, fp.part, "FlowerCore", V3(0.2, 0.14, 0.2) * s, vd._a, CF(0, 0.05 * s, 0))
		H.group(rig, "flowers", fp)
		openable(H, rig, fp, V3(1, 0, 0), 0.25)
	end
end

function A.sylphQueen(H, rig, vd, s)
	local abd = rig.groups.abdomen and rig.groups.abdomen[1]
	if abd then -- layered petal skirt around the hanging abdomen
		for layer = 0, 1 do
			for k = 1, 6 do
				local ang = k / 6 * PI * 2 + layer * 0.5
				local pv = H.pivot(rig, abd.part, "SkirtPivot", CF(0, 0, -0.5 * s + layer * 0.35 * s) * ANG(0, 0, ang))
				H.diamond(rig, pv.part, "SkirtPetal", (1.0 - layer * 0.2) * s, 0.5 * s, 0.06 * s, layer == 0 and vd._p or vd._a, CF(0, 0.45 * s, 0.35 * s) * ANG(0.5, 0, 0))
				openable(H, rig, pv, V3(1, 0, 0), 0.3)
			end
		end
	end
	for _, side in ipairs({ -1, 1 }) do -- delicate arms + hands
		local arm = H.ell(rig, rig.body, "Arm", V3(0.22, 0.75, 0.22) * s, H.lighten(vd._p, 0.1), CF(side * 0.55 * s, 0.05 * s, -0.25 * s) * ANG(0, 0, side * 0.5), nil, nil, CF(0, 0.3 * s, 0))
		H.ell(rig, arm.part, "Hand", V3(0.22, 0.22, 0.22) * s, WHITE, CF(0, -0.4 * s, 0))
		table.insert(rig.arms, { e = arm, side = side })
	end
	local orbit = H.pivot(rig, rig.body, "OrnamentOrbit", CF(0, 0.6 * s, 0))
	H.group(rig, "ornamentOrbit", orbit)
	for k = 1, 2 do
		local pv = H.pivot(rig, orbit.part, "Ornament", CF(math.cos(k * PI) * 1.6 * s, 0, math.sin(k * PI) * 1.6 * s))
		for m = 1, 5 do
			local ang = m / 5 * PI * 2
			H.diamond(rig, pv.part, "Petal", 0.3 * s, 0.18 * s, 0.04 * s, vd._a, CF(math.cos(ang) * 0.12 * s, 0, math.sin(ang) * 0.12 * s) * ANG(0, -ang, 0) * ANG(PI / 2, 0, PI / 2))
		end
		H.ell(rig, pv.part, "Core", V3(0.14, 0.14, 0.14) * s, C("#FFE45C"), CF(), Enum.Material.Neon)
		H.group(rig, "ornaments", pv)
	end
end

---------------------------------------------------------------- VOLCANO
function A.emberpup(H, rig, vd, s)
	local hr = rig.headRadius
	H.ell(rig, rig.head, "Blaze", V3(0.35, 0.6, 0.2) * s, vd._s, H.surface(hr, 0, hr.Y * 0.45) * CF(0, 0, 0.02))
	for _, t in ipairs(rig.tail) do glow(rig, t.part, C("#FFF2B0")) end
	if rig.tailFire then rig.tailFire.Size = 1.6 * s end
end

function A.magmite(H, rig, vd, s)
	local br = rig.bodyRadius
	local core = H.ell(rig, rig.body, "InnerCore", br * 1.2, vd._s, CF(0, 0.05 * s, 0.1 * s), Enum.Material.Neon, 0.2)
	rig.core = core
	glow(rig, core.part, WHITE)
	for k = 0, 6 do
		local ang = k / 7 * PI * 2
		local pv = H.pivot(rig, rig.body, "CrustPivot", CF(math.cos(ang) * br.X * 0.55, br.Y * 0.72, math.sin(ang) * br.Z * 0.55 + 0.15 * s) * ANG(0, -ang, 0))
		H.blk(rig, pv.part, "Crust", V3(0.75, 0.22, 0.6) * s, C("#3A1A10"), ANG(0, 0, -0.45) * CF(0.1 * s, 0, 0), Enum.Material.Basalt)
		openable(H, rig, pv, V3(0, 0, 1), -0.45)
		H.group(rig, "plates", pv)
	end
	H.ell(rig, rig.body, "BaseRim", V3(br.X * 2.05, 0.35 * s, br.Z * 2.05), C("#5A2410"), CF(0, -br.Y * 0.72, 0), Enum.Material.Basalt)
end

function A.cinderchick(H, rig, vd, s)
	local br = rig.bodyRadius
	local tuft = H.pivot(rig, rig.body, "FlameTuft", CF(0, br.Y * 0.92, -0.15 * s))
	table.insert(rig.bobbers, tuft)
	for k = -1, 1 do
		H.diamond(rig, tuft.part, "Flame", (0.7 - math.abs(k) * 0.2) * s, 0.3 * s, 0.08 * s, k == 0 and C("#FFE45C") or vd._a,
			CF(k * 0.15 * s, 0.3 * s, 0) * ANG(0, PI / 2, k * -0.35), Enum.Material.Neon)
	end
end

function A.obsidigolem(H, rig, vd, s)
	local br = rig.bodyRadius
	for _, side in ipairs({ -1, 1 }) do
		reveal(rig, unitOf(rig, function()
			local pv = H.pivot(rig, rig.body, "Pauldron", CF(side * br.X * 0.95, br.Y * 0.7, 0))
			H.wdg(rig, pv.part, "Plate", V3(1.2, 0.7, 1.3) * s, C("#1C1622"), ANG(0, side * PI / 2, 0), Enum.Material.Slate)
			H.blk(rig, pv.part, "PlateRim", V3(1.25, 0.12, 1.35) * s, C("#FF6A2A"), CF(0, -0.36 * s, 0), Enum.Material.Neon)
			H.crystal(rig, pv.part, "ObsCrystal", 0.9 * s, 0.25 * s, C("#FFB14A"), CF(side * 0.2 * s, 0.2 * s, 0.2 * s) * ANG(0.2, 0, -side * 0.4), Enum.Material.Glass, 0.1)
		end))
	end
	local core = H.ell(rig, rig.body, "Core", V3(0.6, 0.6, 0.2) * s, C("#FFB14A"), H.surface(br, 0, 0.1 * s) * CF(0, 0, -0.01), Enum.Material.Neon)
	rig.core = core
	glow(rig, core.part, WHITE)
	for _, sm in ipairs(rig.groups.seams or {}) do glow(rig, sm.part, C("#FFE0A0")) end
end

function A.phoenixLumen(H, rig, vd, s)
	local br = rig.bodyRadius
	for k = -1, 1, 2 do
		local rec = zchain(H, rig, rig.body, "Streamer", CF(k * 0.25 * s, -br.Y * 0.3, br.Z * 0.85) * ANG(0.35, k * 0.18, 0), 5, 0.75 * s,
			function(t) return (0.26 - t * 0.12) * s end, function(t) return vd._s:Lerp(vd._a, t) end,
			{ kind = "trail", i = k, amp = 0.2, freq = 2, lag = 0.6 }, function(t) return t > 0.5 and Enum.Material.Neon or nil end)
		local last = rec.parts[#rec.parts]
		H.diamond(rig, last, "StreamerTip", 1.0 * s, 0.45 * s, 0.06 * s, vd._a, CF(0, 0, 0.6 * s) * ANG(PI / 2, 0, 0), Enum.Material.Neon)
	end
	local pe = Instance.new("Fire")
	pe.Size = 2 * s; pe.Heat = 4; pe.Color = vd._p; pe.SecondaryColor = vd._s
	pe.Parent = rig.body
end

function A.kraken(H, rig, vd, s) end -- anatomy lives in Plans.kraken

function A.infernadrake(H, rig, vd, s)
	local br = rig.bodyRadius
	for i = -1, 1 do
		local seam = H.blk(rig, rig.body, "ChestSeam", V3(0.08, 0.7, 0.06) * s, C("#FFB347"), H.surface(br, i * 0.4 * s, -0.1 * s) * CF(0, 0, -0.04) * ANG(0, 0, i * 0.4), Enum.Material.Neon)
		glow(rig, seam.part, C("#FFF2B0"))
	end
	for _, t in ipairs(rig.tail) do glow(rig, t.part, C("#FFF2B0")) end
end

function A.solarSerpent(H, rig, vd, s)
	local br = rig.bodyRadius
	local rec = zchain(H, rig, rig.body, "Serpent", CF(0, 0, br.Z * 0.8), 7, 0.85 * s, function(t) return (0.66 - t * 0.42) * s end,
		function(t, j) return j % 2 == 0 and vd._p or H.lighten(vd._p, 0.15) end, { kind = "spine", i = 1, amp = 0.3, freq = 1.4, lag = 0.7 })
	for j, part in ipairs(rec.parts) do
		H.ell(rig, part, "Belly", V3(0.9, 0.5, 1.1) * s * (1 - j * 0.08), vd._s, CF(0, -0.25 * s * (1 - j * 0.08), 0))
		if j % 2 == 1 then
			local sc = H.ell(rig, part, "SunScale", V3(0.18, 0.18, 0.18) * s, C("#FFFFFF"), CF(0, 0.45 * s * (1 - j * 0.08), 0), Enum.Material.Neon)
			glow(rig, sc.part, C("#FFE45C"))
		end
	end
	local f = Instance.new("Fire"); f.Size = 2 * s; f.Heat = 4; f.Color = vd._s; f.SecondaryColor = C("#FFE45C")
	f.Parent = rec.parts[#rec.parts]
end

---------------------------------------------------------------- FROZEN
function A.frostpaw(H, rig, vd, s)
	local hr = rig.headRadius
	for _, side in ipairs({ -1, 1 }) do
		for k = 0, 1 do
			H.diamond(rig, rig.head, "CheekTuft", 0.45 * s, 0.25 * s, 0.08 * s, WHITE, CF(side * hr.X * (0.95 + k * 0.05), -0.05 * s - k * 0.22 * s, -hr.Z * 0.35) * ANG(0, side * 0.8, side * (1.2 + k * 0.4)))
		end
	end
	for _, e in ipairs(rig.groups.scarfEnds or {}) do H.group(rig, "flutter", e) end
end

function A.snowpuff(H, rig, vd, s)
	local br = rig.bodyRadius
	for i = 1, 7 do
		local ang = i * 2.1
		H.ell(rig, rig.body, "Powder", V3(0.9, 0.8, 0.9) * s * (0.7 + (i % 3) * 0.12), i % 2 == 0 and WHITE or vd._s,
			CF(math.cos(ang) * br.X * 0.72, (i % 3 - 1) * br.Y * 0.4, math.sin(ang) * br.Z * 0.72 + 0.15 * s))
	end
end

function A.icicleOwl(H, rig, vd, s)
	for _, w in ipairs(rig.wings) do
		for k = 1, 3 do
			H.diamond(rig, w.e.part, "IceEdge", 0.6 * s, 0.22 * s, 0.05 * s, C("#E6F8FF"), CF(w.side * (0.6 + k * 0.35) * s, -0.9 * s - k * 0.12 * s, 0.04) * ANG(0, 0, w.side * 0.4), Enum.Material.Glass, 0.25)
		end
	end
	local hr = rig.headRadius
	for _, side in ipairs({ -1, 1 }) do
		H.diamond(rig, rig.head, "Brow", 0.5 * s, 0.18 * s, 0.06 * s, vd._a, CF(side * hr.X * 0.35, hr.Y * 0.42, -hr.Z * 0.88) * ANG(0, 0, side * 1.1))
	end
end

function A.glacierYeti(H, rig, vd, s)
	local br, hr = rig.bodyRadius, rig.headRadius
	H.ell(rig, rig.head, "Face", V3(1.15, 0.95, 0.3) * s, C("#9AD9FF"), H.surface(hr, 0, -0.05 * s) * CF(0, 0, 0.1))
	for _, side in ipairs({ -1, 1 }) do
		H.blk(rig, rig.head, "Brow", V3(0.45, 0.13, 0.15) * s, vd._a, H.surface(hr, side * hr.X * 0.34, hr.Y * 0.38) * CF(0, 0, -0.04) * ANG(0, 0, side * 0.2))
		for k = 0, 2 do
			H.ell(rig, rig.body, "Fur", V3(0.8, 0.6, 0.8) * s, WHITE, CF(side * br.X * (0.6 + k * 0.12), br.Y * (0.75 - k * 0.3), (k - 1) * 0.3 * s))
		end
	end
	for _, arm in ipairs(rig.arms) do
		for k = 1, 2 do H.ell(rig, arm.e.part, "ArmFur", V3(1.05, 0.5, 1.05) * s, WHITE, CF(0, 0.6 * s - k * 0.55 * s, 0)) end
	end
end

function A.auroraFox(H, rig, vd, s)
	local hr = rig.headRadius
	for _, side in ipairs({ -1, 1 }) do
		for k = 0, 1 do
			H.diamond(rig, rig.head, "CheekFur", 0.55 * s, 0.28 * s, 0.08 * s, WHITE, CF(side * hr.X * 0.85, -hr.Y * (0.2 + k * 0.25), hr.Z * 0.05) * ANG(0, side * 0.6, side * (1.4 + k * 0.3)))
		end
	end
	for i, t in ipairs(rig.tail) do
		if i > 1 then
			local r = H.blk(rig, t.part, "Ribbon", V3(0.08, t.part.Size.Y * 1.05, t.part.Size.Z * 0.9), aurora(i / #rig.tail), CF(0, 0, 0), Enum.Material.Neon, 0.25)
			glow(rig, r.part, WHITE)
		end
	end
end

function A.blizzardBear(H, rig, vd, s)
	local br = rig.bodyRadius
	H.ell(rig, rig.body, "Hump", V3(1.9, 1.2, 1.4) * s, vd._p, CF(0, br.Y * 0.55, -br.Z * 0.35))
	for i = 1, 5 do
		H.ell(rig, rig.body, "Fur", V3(0.6, 0.45, 0.6) * s, vd._s, H.surface(br, math.cos(i) * br.X * 0.6, (i % 3 - 1) * 0.35 * s, (i % 2 == 0) and 1 or -1) * CF(0, 0, 0.05))
	end
	H.ell(rig, rig.head, "Snow", V3(rig.headRadius.X * 1.1, rig.headRadius.Y * 0.35, rig.headRadius.Z * 0.9), WHITE, CF(0, rig.headRadius.Y * 0.7, 0.15 * s))
end

function A.crystalwing(H, rig, vd, s)
	local br = rig.bodyRadius
	for i = 0, 3 do
		H.crystal(rig, rig.body, "Ridge", (0.85 - i * 0.12) * s, 0.22 * s, C("#E6F8FF"), CF(0, br.Y * 0.85, -br.Z * 0.45 + i * br.Z * 0.35) * ANG(0.4, 0, 0), Enum.Material.Glass, 0.1)
	end
end

function A.frostEmpress(H, rig, vd, s)
	local br = rig.bodyRadius
	for k = -1, 1 do
		local rec = zchain(H, rig, rig.body, "Streamer", CF(k * 0.3 * s, -br.Y * 0.2, br.Z * 0.85) * ANG(0.25, k * 0.25, 0), 6, 0.8 * s,
			function(t) return (0.2 - t * 0.1) * s end, function(t) return aurora(t) end,
			{ kind = "trail", i = k + 2, amp = 0.2, freq = 1.4, lag = 0.6 }, function() return Enum.Material.Neon end, function() return 0.2 end)
		H.group(rig, "streamers", rec)
	end
	for _, cp in ipairs(rig.groups.crown or {}) do
		for k = -1, 1 do
			local cr = H.blk(rig, cp.part, "CrownCrystal", V3(0.14, 0.7 - math.abs(k) * 0.2, 0.14) * s, C("#BFF6FF"), CF(k * 0.22 * s, 0.6 * s, 0) * ANG(0, PI / 4, k * -0.25), Enum.Material.Glass, 0.05)
			glow(rig, cr.part, WHITE)
		end
	end
end

---------------------------------------------------------------- CRYSTAL
function A.gemmy(H, rig, vd, s)
	local gem = H.pivot(rig, rig.body, "Gem", CF(0, 0, 0.15 * s))
	H.diamond(rig, gem.part, "InnerGem", 0.9 * s, 0.6 * s, 0.4 * s, vd._a, CF(), Enum.Material.Neon)
	H.diamond(rig, gem.part, "InnerGem", 0.9 * s, 0.6 * s, 0.4 * s, H.lighten(vd._a, 0.3), ANG(0, PI / 2, 0), Enum.Material.Neon)
	H.group(rig, "lag", gem)
	rig.core = gem
end

function A.quartzBeetle(H, rig, vd, s)
	local abd = rig.groups.abdomen and rig.groups.abdomen[1]
	if not abd then return end
	for _, side in ipairs({ -1, 1 }) do
		local pv = H.pivot(rig, abd.part, "ShellHalf", CF(side * 0.05 * s, 0.55 * s, -0.4 * s))
		H.blk(rig, pv.part, "Quartz", V3(0.85, 0.35, 1.9) * s, C("#E2E8F0"), CF(side * 0.42 * s, 0, 0.45 * s) * ANG(0, 0, side * -0.35), Enum.Material.Glass, 0.1)
		H.wdg(rig, pv.part, "QuartzFacet", V3(0.85, 0.3, 0.6) * s, C("#9FE7FF"), CF(side * 0.42 * s, 0.28 * s, 0.75 * s) * ANG(0, PI, side * -0.35), Enum.Material.Glass, 0.1)
		openable(H, rig, pv, V3(0, 0, 1), side * -0.55)
		H.group(rig, "shell", pv)
	end
end

function A.glimmerBat(H, rig, vd, s)
	local br = rig.bodyRadius
	H.ell(rig, rig.body, "Ruff", V3(1.6, 0.6, 1.2) * s, H.lighten(vd._p, 0.15), CF(0, -br.Y * 0.5, -br.Z * 0.35))
	H.ell(rig, rig.body, "Snout", V3(0.5, 0.35, 0.3) * s, vd._s, H.surface(br, 0, rig.faceY - br.Y * 0.3) * CF(0, 0, 0.05))
end

function A.eel(H, rig, vd, s) end -- anatomy lives in Plans.eel

function A.prismLion(H, rig, vd, s)
	local hr = rig.headRadius
	local cols = { C("#FFFFFF"), vd._a, C("#9FE7FF"), C("#E9D2FF") }
	for layer = 0, 1 do
		local n = layer == 0 and 12 or 9
		for k = 1, n do
			local ang = k / n * PI * 2
			local pv = H.pivot(rig, rig.head, "ManeShard", CF(math.cos(ang) * hr.X * (0.85 + layer * 0.15), math.sin(ang) * hr.Y * (0.85 + layer * 0.15), hr.Z * (0.25 + layer * 0.2)) * ANG(0, 0, ang - PI / 2))
			H.diamond(rig, pv.part, "Mane", (0.85 - layer * 0.15) * s, 0.4 * s, 0.1 * s, cols[(k + layer) % 4 + 1], CF(0, 0.3 * s, 0), layer == 1 and Enum.Material.Glass or nil, layer == 1 and 0.15 or 0)
			H.group(rig, "mane", pv)
			openable(H, rig, pv, V3(1, 0, 0), 0.25)
		end
	end
end

function A.diamondDrake(H, rig, vd, s)
	local br = rig.bodyRadius
	for i = 0, 3 do
		H.tri(rig, rig.body, "DorsalPlate", 0.1 * s, (0.8 - i * 0.1) * s, 0.7 * s, C("#BFF6FF"), CF(0, br.Y * 0.95 + 0.3 * s, -br.Z * 0.45 + i * br.Z * 0.35), Enum.Material.Glass, 0.15)
	end
	for _, w in ipairs(rig.wings) do
		for k = 1, 2 do
			H.diamond(rig, w.e.part, "WingPanel", 0.9 * s, 0.45 * s, 0.05 * s, C("#E8F4FF"), CF(w.side * (0.4 + k * 0.45) * s, -0.15 * s, -0.02) * ANG(0, 0, w.side * 0.9), Enum.Material.Glass, 0.2)
		end
		local edge = H.blk(rig, w.e.part, "WingEdge", V3(2.0, 0.06, 0.06) * s, vd._a, CF(w.side * 0.1 * s, 0.55 * s, 0) * ANG(0, 0, w.side * 0.25), Enum.Material.Neon)
		glow(rig, edge.part, WHITE)
	end
end

function A.geodeLeviathan(H, rig, vd, s)
	local br = rig.bodyRadius
	H.ell(rig, rig.body, "GeodeGlow", V3(br.X * 1.7, 0.4 * s, br.Z * 1.7), vd._s, CF(0, br.Y * 0.78, 0), Enum.Material.Neon)
	for i = 0, 5 do
		local side = i % 2 == 0 and -1 or 1
		local row = math.floor(i / 2)
		local pv = H.pivot(rig, rig.body, "ArmorPivot", CF(side * br.X * 0.15, br.Y * 0.85, -br.Z * 0.5 + row * br.Z * 0.5))
		H.blk(rig, pv.part, "RockPlate", V3(1.1, 0.35, 0.95) * s, C("#2A1A44"), CF(side * 0.5 * s, 0, 0) * ANG(0, 0, side * -0.25), Enum.Material.Slate)
		openable(H, rig, pv, V3(0, 0, 1), side * -0.6)
	end
	for i = 0, 4 do
		H.spike(rig, rig.body, "CyanSpine", (0.6 - i * 0.06) * s, 0.3 * s, vd._a, CF(0, br.Y * 0.92, -br.Z * 0.75 + i * br.Z * 0.38) * ANG(0.4, 0, 0), Enum.Material.Neon)
	end
	local gem = H.crystal(rig, rig.head, "BrowGem", 0.6 * s, 0.22 * s, vd._s, CF(0, rig.headRadius.Y * 0.8, 0) * ANG(-0.3, 0, 0), Enum.Material.Neon)
end

function A.hydra(H, rig, vd, s)
	for i, he in ipairs(rig.groups.heads or {}) do
		if i ~= 2 then
			H.crystal(rig, he.part, "HeadCrystal", 0.6 * s, 0.18 * s, vd._a, CF(0, rig.headRadius.Y * 0.85, 0.1 * s), Enum.Material.Glass, 0.1)
		end
	end
	for _, rec in ipairs(rig.groups.neckChains or {}) do reveal(rig, subtree(rig, { rec.parts[1] })) end
end

---------------------------------------------------------------- CANDY
function A.gumdrop(H, rig, vd, s)
	local br = rig.bodyRadius
	H.ell(rig, rig.body, "Base", V3(br.X * 2.05, 0.5 * s, br.Z * 2.05), H.darken(vd._p, 0.1), CF(0, -br.Y * 0.62, 0), Enum.Material.Glass, 0.2)
	H.diamond(rig, rig.body, "Topping", 0.5 * s, 0.4 * s, 0.25 * s, C("#FF2E6E"), CF(0, br.Y * 0.98, 0.1 * s) * ANG(0, 0.5, 0))
	for i = 1, 7 do
		local ang = i * 2.39
		H.blk(rig, rig.body, "Sugar", V3(0.12, 0.12, 0.12) * s, WHITE, CF(math.cos(ang) * br.X * 0.75, br.Y * (0.1 + (i % 3) * 0.22), math.sin(ang) * br.Z * 0.75 + 0.1 * s) * ANG(ang, ang, 0), Enum.Material.Glass, 0.1)
	end
end

function A.cocoaCub(H, rig, vd, s)
	local br = rig.bodyRadius
	for k = -1, 1, 2 do -- molded chocolate seams on the back
		H.blk(rig, rig.body, "Seam", V3(0.06, 0.06, 1.2) * s, H.darken(vd._p, 0.3), CF(k * 0.35 * s, br.Y * 1.0, 0))
	end
	H.blk(rig, rig.body, "Seam", V3(1.0, 0.06, 0.06) * s, H.darken(vd._p, 0.3), CF(0, br.Y * 1.0, 0.1 * s))
end

function A.lollipup(H, rig, vd, s)
	local hr = rig.headRadius
	H.ell(rig, rig.head, "Tongue", V3(0.22, 0.12, 0.25) * s, vd._s, CF(0, -0.55 * s, -hr.Z * 0.95))
	for _, side in ipairs({ -1, 1 }) do
		H.ell(rig, rig.head, "MuzzleSpot", V3(0.25, 0.2, 0.1) * s, H.lighten(vd._s, 0.4), CF(side * 0.22 * s, -0.3 * s, -hr.Z * 1.0))
	end
end

function A.marshghost(H, rig, vd, s)
	local br = rig.bodyRadius
	for k = -1, 1 do
		H.ell(rig, rig.body, "Pillow", V3(1.0, 0.7, 1.0) * s, WHITE, CF(k * 0.55 * s, br.Y * 0.75, 0.05 * s))
		H.ell(rig, rig.body, "Toast", V3(0.8, 0.3, 0.8) * s, C("#F6C8A8"), CF(k * 0.55 * s, br.Y * 0.95, 0.15 * s))
	end
	for _, arm in ipairs(rig.arms) do H.ell(rig, arm.e.part, "Mitten", V3(0.45, 0.4, 0.45) * s, vd._s, CF(0, -0.3 * s, 0)) end
	for _, ch in ipairs(rig.groups.cheeks or {}) do glow(rig, ch.part, C("#FF6FA8")) end
end

local function horseMane(H, rig, vd, s, cols)
	local neck = rig.neckEntry
	if not neck then return end
	for k = 0, 5 do
		local pv = H.pivot(rig, neck.part, "ManeLock", CF(0, -0.35 * s + k * 0.3 * s, 0.38 * s) * ANG(0.3, 0, 0))
		H.diamond(rig, pv.part, "Mane", 0.75 * s, 0.4 * s, 0.1 * s, cols[k % #cols + 1], CF(0, 0, 0.25 * s) * ANG(PI / 2, 0, 0) * ANG(0, 0, 0.3))
		H.group(rig, "flutter", pv)
	end
	local hr = rig.headRadius
	H.diamond(rig, rig.head, "Forelock", 0.6 * s, 0.35 * s, 0.08 * s, cols[1], CF(0, hr.Y * 0.75, -hr.Z * 0.35) * ANG(0.6, 0, 0))
end

function A.sugarcorn(H, rig, vd, s)
	horseMane(H, rig, vd, s, { vd._a, WHITE, C("#FFB3E6"), C("#B3E6FF") })
end

function A.kirin(H, rig, vd, s)
	local br = rig.bodyRadius
	for i = 1, 8 do
		local ang = i * 2.3
		local cl = H.ell(rig, rig.body, "CloudFur", V3(1.0, 0.8, 1.0) * s * (0.8 + (i % 3) * 0.12), i % 2 == 0 and vd._p or vd._s,
			CF(math.cos(ang) * br.X * 0.7, br.Y * (0.2 + (i % 3) * 0.25), math.sin(ang) * br.Z * 0.75))
		openable(H, rig, cl, V3(1, 0, 0), 0.15)
	end
	for _, f in ipairs(rig.feet) do H.ell(rig, f.part, "LegCloud", V3(0.9, 0.55, 0.9) * s, vd._s, CF(0, -0.15 * s, 0)) end
	horseMane(H, rig, vd, s, { vd._p, vd._s, WHITE })
end

function A.queenBee(H, rig, vd, s)
	local abd = rig.groups.abdomen and rig.groups.abdomen[1]
	if abd then
		H.ell(rig, abd.part, "HoneyTrim", V3(1.35, 1.3, 0.25) * s, C("#FFB020"), CF(0, 0, -0.75 * s), Enum.Material.Glass, 0.3)
		local st = H.pivot(rig, abd.part, "Stinger", CF(0, -0.1 * s, 0.95 * s))
		for k = 0, 2 do
			H.ell(rig, st.part, "CandyStinger", V3(0.4, 0.4, 0.4) * s * (1 - k * 0.25), k % 2 == 0 and vd._a or WHITE, CF(0, 0, k * 0.22 * s))
		end
	end
end

function A.chocoTitan(H, rig, vd, s)
	local br = rig.bodyRadius
	local cols = { C("#FF5FA2"), C("#5FD3FF"), C("#FFE45C"), C("#7CFF8A") }
	for r = 0, 2 do
		for c = 0, 1 do
			local cf = H.surface(br, (c - 0.5) * 0.7 * s, (1 - r) * 0.55 * s) * CF(0, 0, -0.05)
			reveal(rig, unitOf(rig, function()
				H.blk(rig, rig.body, "ChocoBar", V3(0.62, 0.48, 0.2) * s, C("#7A4426"), cf)
				local inlay = H.ell(rig, rig.body, "Inlay", V3(0.2, 0.2, 0.08) * s, cols[(r * 2 + c) % 4 + 1], cf * CF(0, 0, -0.1 * s), Enum.Material.Neon)
				glow(rig, inlay.part, WHITE)
			end))
		end
	end
	for _, arm in ipairs(rig.arms) do
		H.ell(rig, rig.body, "Icing", V3(0.95, 0.6, 0.95) * s, vd._s, CF(arm.side * br.X * 1.0, 0.85 * s, 0))
		H.ell(rig, arm.e.part, "IcingCuff", V3(1.1, 0.3, 1.1) * s, WHITE, CF(0, -0.55 * s, 0))
	end
end

---------------------------------------------------------------- SPACE
function A.astroBlob(H, rig, vd, s)
	local core = H.ell(rig, rig.body, "Core", V3(0.6, 0.6, 0.6) * s, C("#E6FFF6"), CF(0, -0.1 * s, 0.35 * s), Enum.Material.Neon, 0.3)
	rig.core = core
	glow(rig, core.part, WHITE)
end

function A.moonMouse(H, rig, vd, s)
	local hr = rig.headRadius
	for _, side in ipairs({ -1, 1 }) do
		for k = -1, 1, 2 do
			H.cyl(rig, rig.head, "Whisker", V3(0.8, 0.03, 0.03) * s, H.darken(vd._p, 0.4), CF(side * 0.55 * s, -0.35 * s + k * 0.06 * s, -hr.Z * 1.05) * ANG(0, 0, k * 0.15))
		end
	end
end

function A.cometFish(H, rig, vd, s)
	local br = rig.bodyRadius
	local rec = zchain(H, rig, rig.body, "CometTail", CF(0, 0, br.Z * 0.85), 5, 0.6 * s, function(t) return (0.45 - t * 0.33) * s end,
		function(t) return vd._a:Lerp(WHITE, t) end, { kind = "trail", i = 1, amp = 0.25, freq = 4, lag = 0.5 },
		function() return Enum.Material.Neon end, function(t) return t * 0.4 end)
	H.diamond(rig, rec.parts[#rec.parts], "TailStar", 0.6 * s, 0.25 * s, 0.05 * s, WHITE, CF(0, 0, 0.4 * s), Enum.Material.Neon)
	H.diamond(rig, rec.parts[#rec.parts], "TailStar", 0.6 * s, 0.25 * s, 0.05 * s, WHITE, CF(0, 0, 0.4 * s) * ANG(0, 0, PI / 2), Enum.Material.Neon)
	for _, p in ipairs(rec.parts) do glow(rig, p, WHITE) end
end

function A.jelly(H, rig, vd, s) end -- anatomy lives in Plans.jelly
function A.whale(H, rig, vd, s) end -- anatomy lives in Plans.whale

function A.novaPhoenix(H, rig, vd, s)
	local br = rig.bodyRadius
	for k = -1, 1 do
		local rec = zchain(H, rig, rig.body, "Streamer", CF(k * 0.3 * s, -br.Y * 0.2, br.Z * 0.85) * ANG(0.3, k * 0.3, 0), 6, 0.8 * s,
			function(t) return (0.22 - t * 0.1) * s end, function(t) return vd._s:Lerp(vd._a, t) end,
			{ kind = "trail", i = k + 2, amp = 0.2, freq = 1.4, lag = 0.6, fan = true }, function() return Enum.Material.Neon end, function() return 0.15 end)
		H.group(rig, "streamers", rec)
		openable(H, rig, rec.entries[1], V3(0, 1, 0), k * 0.45)
	end
	local core = H.ell(rig, rig.body, "BreastCore", V3(0.5, 0.5, 0.2) * s, vd._a, H.surface(br, 0, 0) * CF(0, 0, -0.02), Enum.Material.Neon)
	glow(rig, core.part, WHITE)
end

function A.cosmicDragon(H, rig, vd, s)
	local br = rig.bodyRadius
	for i = 1, 9 do
		local st = H.ell(rig, rig.body, "Star", V3(0.12, 0.12, 0.12) * s, i % 3 == 0 and vd._a or WHITE, H.surface(br, math.cos(i * 1.3) * br.X * 0.7, math.sin(i * 2.1) * br.Y * 0.6, i % 2 == 0 and 1 or -1), Enum.Material.Neon)
		glow(rig, st.part, WHITE)
	end
	local mote = H.pivot(rig, rig.body, "MoteOrbit", CF(0, 1.2 * s, 0))
	H.ell(rig, mote.part, "Mote", V3(0.3, 0.3, 0.3) * s, vd._a, CF(2.2 * s, 0, 0), Enum.Material.Neon)
	H.group(rig, "ornamentOrbit", mote)
end

function A.singularity(H, rig, vd, s)
	local br = rig.bodyRadius
	H.ell(rig, rig.body, "Rim", br * 2.08, vd._s, CF(0, 0, 0.03 * s), Enum.Material.SmoothPlastic, 0.55)
	H.ell(rig, rig.head, "HeadRim", rig.headRadius * 2.08, vd._s, CF(0, 0, 0.03 * s), Enum.Material.SmoothPlastic, 0.55)
	local disk = H.cyl(rig, rig.body, "Accretion", V3(0.05, 3.6, 3.6) * s, H.lighten(vd._s, 0.2), CF(0.3 * s, 0, 0) * ANG(0.6, 0, PI / 2), Enum.Material.Neon, 0.75)
	H.group(rig, "rings", disk)
end

---------------------------------------------------------------- SHADOW
function A.gloomling(H, rig, vd, s)
	local br = rig.bodyRadius
	H.spike(rig, rig.body, "HoodPeak", 0.9 * s, 0.9 * s, vd._p, CF(0, br.Y * 0.8, 0.2 * s) * ANG(0.5, 0, 0))
end

function A.shadeCat(H, rig, vd, s)
	local br = rig.bodyRadius
	for _, side in ipairs({ -1, 1 }) do
		H.blk(rig, rig.body, "EdgeStripe", V3(0.05, 0.08, br.Z * 1.6), vd._s, CF(side * br.X * 0.92, 0.1 * s, 0), Enum.Material.Neon, 0.3)
	end
	for _, e in ipairs(rig.eyes) do glow(rig, e.part, WHITE) end
end

function A.nightMoth(H, rig, vd, s)
	for k = 0, 7 do
		local ang = k / 8 * PI * 2
		H.ell(rig, rig.body, "Collar", V3(0.5, 0.45, 0.5) * s, H.lighten(vd._s, 0.2), CF(math.cos(ang) * 0.55 * s, 0.35 * s, math.sin(ang) * 0.55 * s - 0.4 * s))
	end
	for _, w in ipairs(rig.wings) do
		local spot = H.ell(rig, w.e.part, "EyeSpot", V3(0.55, 0.55, 0.08) * s, vd._a, CF(w.side * 0.35 * s, (w.tier == 1 and 0.1 or -0.1) * s, -0.04), Enum.Material.Neon)
		H.ell(rig, spot.part, "EyeSpotCore", V3(0.28, 0.28, 0.06) * s, C("#2A1A44"), CF(0, 0, -0.03))
		glow(rig, spot.part, WHITE)
	end
	for _, ear in ipairs(rig.ears) do
		if ear.kind == "antenna" then
			for k = 1, 3 do
				H.diamond(rig, ear.e.part, "Feather", 0.3 * s, 0.12 * s, 0.03 * s, vd._s, CF(0, (k - 2) * 0.2 * s, 0) * ANG(0, 0, PI / 2))
			end
		end
	end
end

function A.voidWisp(H, rig, vd, s)
	local br = rig.bodyRadius
	H.spike(rig, rig.body, "Tip", 1.4 * s, 0.9 * s, vd._p, CF(0, -br.Y * 0.8, 0.1 * s) * ANG(PI, 0, 0))
	local core = H.ell(rig, rig.body, "Core", V3(0.9, 0.9, 0.9) * s, vd._s, CF(0, -0.15 * s, 0.25 * s), Enum.Material.Neon, 0.25)
	rig.core = core
	glow(rig, core.part, vd._a)
	for k = 1, 3 do
		local ang = k / 3 * PI * 2
		local rec = zchain(H, rig, rig.body, "SmokeRibbon", CF(math.cos(ang) * br.X * 0.7, -br.Y * 0.2, math.sin(ang) * br.Z * 0.7) * ANG(0.6, ang, 0), 4, 0.6 * s,
			function(t) return (0.2 - t * 0.1) * s end, function() return H.lighten(vd._s, 0.2) end,
			{ kind = "trail", i = k, amp = 0.35, freq = 1.5, lag = 0.8 }, nil, function(t) return 0.35 + t * 0.3 end)
		H.group(rig, "ribbons", rec)
	end
end

function A.umbraWolf(H, rig, vd, s)
	local hr = rig.headRadius
	for k = 0, 6 do
		local ang = k / 7 * PI * 2
		H.diamond(rig, rig.head, "Ruff", 0.7 * s, 0.35 * s, 0.1 * s, k % 2 == 0 and vd._s or vd._p, CF(math.cos(ang) * hr.X * 0.9, math.sin(ang) * hr.Y * 0.8 - 0.25 * s, hr.Z * 0.55) * ANG(0, 0, ang - PI / 2) * CF(0, 0.2 * s, 0))
	end
	for _, f in ipairs(rig.feet) do H.blk(rig, f.part, "Seam", V3(0.05, f.part.Size.Y * 0.7, 0.05), vd._a, CF(0, 0, -f.part.Size.Z * 0.48), Enum.Material.Neon, 0.2) end
end

function A.wraithlord(H, rig, vd, s)
	local br = rig.bodyRadius
	for k = 1, 6 do
		local ang = k / 6 * PI * 2
		local pv = H.pivot(rig, rig.body, "RobePanel", CF(math.cos(ang) * br.X * 0.75, -br.Y * 0.55, math.sin(ang) * br.Z * 0.75) * ANG(0, -ang + PI / 2, 0))
		H.tri(rig, pv.part, "Robe", 0.08 * s, 1.5 * s, 0.9 * s, k % 2 == 0 and vd._s or H.darken(vd._s, 0.3), CF(0, -0.7 * s, 0) * ANG(PI, 0, 0))
		H.group(rig, "flutter", pv)
		openable(H, rig, pv, V3(0, 0, 1), 0.25)
	end
	for _, side in ipairs({ -1, 1 }) do
		H.ell(rig, rig.body, "Pauldron", V3(1.0, 0.6, 1.0) * s, H.darken(vd._s, 0.3), CF(side * br.X * 0.85, br.Y * 0.45, 0))
		H.spike(rig, rig.body, "ShoulderSpike", 0.5 * s, 0.25 * s, vd._a, CF(side * br.X * 0.95, br.Y * 0.65, 0) * ANG(0, 0, -side * 0.5))
	end
end

function A.wyvern(H, rig, vd, s)
	for _, w in ipairs(rig.wings) do
		H.spike(rig, w.e.part, "WingKnuckle", 0.45 * s, 0.2 * s, C("#5A1A8C"), CF(w.side * 0.2 * s, 0.6 * s, 0) * ANG(0, 0, -w.side * 0.5))
	end
end

function A.eclipseDragon(H, rig, vd, s)
	local br = rig.bodyRadius
	for _, side in ipairs({ -1, 1 }) do
		local rim = H.blk(rig, rig.body, "EclipseEdge", V3(0.05, 0.08, br.Z * 1.8), vd._s, CF(side * br.X * 0.96, 0.2 * s, 0), Enum.Material.Neon)
		glow(rig, rim.part, WHITE)
	end
	for _, w in ipairs(rig.wings) do
		H.blk(rig, w.e.part, "WingEdge", V3(2.0, 0.05, 0.05) * s, vd._s, CF(0, 0.6 * s, 0) * ANG(0, 0, w.side * 0.3), Enum.Material.Neon)
	end
end

---------------------------------------------------------------- HEAVEN
function A.cloudLamb(H, rig, vd, s)
	local br = rig.bodyRadius
	for i = 1, 11 do
		local ang = i * 2.4
		local y = (i % 4) / 3 - 0.4
		local wl = H.ell(rig, rig.body, "Wool", V3(0.95, 0.85, 0.95) * s * (0.8 + (i % 3) * 0.1), i % 3 == 0 and vd._s or WHITE,
			CF(math.cos(ang) * br.X * 0.75 * math.sqrt(1 - y * y * 0.5), y * br.Y * 0.9, math.sin(ang) * br.Z * 0.75 + 0.15 * s))
		openable(H, rig, wl, V3(1, 0, 0), 0.1)
	end
end

function A.haloChick(H, rig, vd, s) end -- built from bird plan + angel wings + halo

function A.seraphling(H, rig, vd, s)
	local br = rig.bodyRadius
	H.ell(rig, rig.body, "Face", V3(1.3, 1.1, 0.3) * s, C("#FFE7CF"), H.surface(br, 0, rig.faceY) * CF(0, 0, 0.09))
	local curl = H.pivot(rig, rig.body, "Curl", CF(0, br.Y * 0.95, -0.2 * s))
	H.ell(rig, curl.part, "HairCurl", V3(0.45, 0.45, 0.25) * s, C("#FFD86B"), CF(0, 0.15 * s, 0))
	table.insert(rig.bobbers, curl)
end

function A.griffin(H, rig, vd, s)
	local br, hr = rig.bodyRadius, rig.headRadius
	for k = 0, 4 do
		H.diamond(rig, rig.body, "ChestFeather", 0.7 * s, 0.4 * s, 0.08 * s, k % 2 == 0 and vd._s or WHITE, CF((k - 2) * 0.28 * s, 0.1 * s - math.abs(k - 2) * 0.1 * s, -br.Z * 0.95) * ANG(0.3, 0, 0))
	end
	for k = 0, 2 do
		H.diamond(rig, rig.head, "Crest", (0.75 - k * 0.12) * s, 0.25 * s, 0.06 * s, vd._p, CF(0, hr.Y * 0.8, hr.Z * (0.1 + k * 0.3)) * ANG(-0.6 - k * 0.3, 0, 0) * CF(0, 0.3 * s, 0))
	end
	H.ell(rig, rig.body, "LionHaunch", V3(1.9, 1.5, 1.4) * s, vd._p, CF(0, 0, br.Z * 0.5))
end

function A.pegasus(H, rig, vd, s)
	horseMane(H, rig, vd, s, { WHITE, C("#FFE9A6"), C("#E8F4FF") })
end

function A.seraphLion(H, rig, vd, s)
	local hr = rig.headRadius
	for layer = 0, 1 do
		local n = 11
		for k = 1, n do
			local ang = k / n * PI * 2
			local pv = H.pivot(rig, rig.head, "ManeFeather", CF(math.cos(ang) * hr.X * (0.85 + layer * 0.2), math.sin(ang) * hr.Y * (0.85 + layer * 0.2), hr.Z * (0.2 + layer * 0.25)) * ANG(0, 0, ang - PI / 2))
			H.diamond(rig, pv.part, "Mane", (0.95 - layer * 0.1) * s, 0.45 * s, 0.1 * s, layer == 0 and C("#FFE08A") or WHITE, CF(0, 0.32 * s, 0))
			H.group(rig, "mane", pv)
			openable(H, rig, pv, V3(1, 0, 0), 0.2)
		end
	end
end

function A.archDrake(H, rig, vd, s) end -- angel wings with gold tips + chest plates + crown/halo from shared pieces

function A.throneAngel(H, rig, vd, s)
	local br = rig.bodyRadius
	for k = -1, 1 do
		H.blk(rig, rig.body, "ArmorPanel", V3(0.6, 1.3 - math.abs(k) * 0.3, 0.18) * s, C("#F4F1EA"), H.surface(br, k * 0.6 * s, 0.1 * s) * CF(0, 0, -0.06) * ANG(0, k * 0.2, 0), Enum.Material.Marble)
	end
	local core = H.ell(rig, rig.body, "Core", V3(0.45, 0.45, 0.2) * s, vd._a, H.surface(br, 0, 0.55 * s) * CF(0, 0, -0.12), Enum.Material.Neon)
	rig.core = core
	glow(rig, core.part, WHITE)
	reveal(rig, unitOf(rig, function()
		for _, side in ipairs({ -1, 1 }) do
			H.blk(rig, rig.body, "ShoulderGuard", V3(0.9, 0.35, 1.0) * s, C("#FFF8EA"), CF(side * br.X * 0.95, br.Y * 0.75, 0) * ANG(0, 0, side * -0.3), Enum.Material.Marble)
		end
	end))
end

---------------------------------------------------------------- SECRET
function A.glitchling(H, rig, vd, s)
	local br = rig.bodyRadius
	for k = 0, 11 do
		local ang = k / 12 * PI * 2
		H.blk(rig, rig.body, "Pixel", V3(0.24, 0.24, 0.24) * s, k % 2 == 0 and vd._p or vd._s, CF(math.cos(ang) * br.X * 0.98, -br.Y * 0.35, math.sin(ang) * br.Z * 0.98) * ANG(0, -ang, 0), Enum.Material.Neon)
	end
	H.ell(rig, rig.body, "DarkBand", V3(br.X * 2.02, br.Y * 0.5, br.Z * 2.02), C("#101018"), CF(0, -br.Y * 0.55, 0))
	for k = 1, 3 do
		local pv = H.pivot(rig, rig.body, "Fragment", CF((k - 2) * 0.9 * s, br.Y * 1.25, 0.2 * s))
		H.blk(rig, pv.part, "FragmentCube", V3(0.3, 0.3, 0.3) * s, k % 2 == 0 and vd._s or vd._p, CF(), Enum.Material.Neon)
		pv.fragIndex = k
		H.group(rig, "fragments", pv)
	end
end

function A.voidEmperor(H, rig, vd, s)
	local br = rig.bodyRadius
	for _, side in ipairs({ -1, 1 }) do
		reveal(rig, unitOf(rig, function()
			H.wdg(rig, rig.body, "ArmorPlate", V3(1.3, 0.8, 1.2) * s, C("#14101C"), CF(side * br.X * 0.95, br.Y * 0.75, 0) * ANG(0, side * PI / 2, 0))
			H.blk(rig, rig.body, "PlateEdge", V3(1.3, 0.08, 1.25) * s, vd._a, CF(side * br.X * 0.95, br.Y * 0.38, 0), Enum.Material.Neon)
			H.crystal(rig, rig.body, "PurpleCrystal", 0.9 * s, 0.25 * s, C("#7A2BCC"), CF(side * br.X * 1.0, br.Y * 0.9, 0.3 * s) * ANG(0.2, 0, -side * 0.4), Enum.Material.Glass, 0.1)
		end))
	end
	local core = H.ell(rig, rig.body, "Core", V3(0.6, 0.6, 0.2) * s, vd._a, H.surface(br, 0, 0.2 * s) * CF(0, 0, -0.02), Enum.Material.Neon)
	rig.core = core
	glow(rig, core.part, WHITE)
	local orb = H.pivot(rig, rig.arms[2] and rig.arms[2].e.part or rig.body, "PalmCrystal", CF(0, -1.7 * s, -0.6 * s))
	H.crystal(rig, orb.part, "Gem", 0.5 * s, 0.2 * s, vd._a, CF(0, -0.25 * s, 0), Enum.Material.Neon)
	H.group(rig, "palmCrystal", orb)
end

function A.errorcat(H, rig, vd, s)
	local br = rig.bodyRadius
	for _, side in ipairs({ -1, 1 }) do
		H.blk(rig, rig.body, "Seam", V3(0.05, 0.06, br.Z * 1.5), vd._a, CF(side * br.X * 0.93, 0.15 * s, 0), Enum.Material.Neon)
	end
	-- tail echo: a translucent copy that lags and rejoins
	local first = rig.tail[1]
	if first then
		local rec = zchain(H, rig, rig.body, "TailEcho", CF(0, 0.3 * s, br.Z * 0.95) * ANG(-0.5, 0, 0), 5, 0.5 * s, function(t) return (0.42 - t * 0.2) * s end,
			function(t) return t > 0.5 and vd._a or vd._p end, { kind = "echo", i = 1, amp = 0.35, freq = 3.5, lag = 0.5 }, function() return Enum.Material.Neon end, function() return 0.65 end)
		H.group(rig, "echo", rec)
	end
end

function A.nullBunny(H, rig, vd, s)
	local br = rig.bodyRadius
	H.ell(rig, rig.body, "Rim", br * 2.06, WHITE, CF(0, 0, 0.04 * s), Enum.Material.SmoothPlastic, 0.7)
end

function A.watcher(H, rig, vd, s)
	local br = rig.bodyRadius
	H.spike(rig, rig.body, "Hood", 1.2 * s, 1.1 * s, vd._p, CF(0, br.Y * 0.8, 0.25 * s) * ANG(0.45, 0, 0))
	if rig.eyes[1] then
		local eye = rig.eyes[1].part
		H.band(rig, eye, "IrisRim", ANG(PI / 2, 0, 0), eye.Size.X * 0.55, 0.12 * s, vd._a, 14)
	end
	local rp = H.band(rig, rig.body, "OrbitRing2", ANG(-0.6, 0, 0.4), br.X * 1.6, 0.08 * s, vd._s, 20)
	H.group(rig, "rings", rp)
end

---------------------------------------------------------------- DIVINE
function A.solaris(H, rig, vd, s)
	local br = rig.bodyRadius
	local rays = H.pivot(rig, rig.body, "Corona", CF(0, 0, 0.25 * s))
	H.group(rig, "rays", rays)
	for k = 1, 10 do
		local ang = k / 10 * PI * 2
		local pv = H.pivot(rig, rays.part, "Ray", CF(math.cos(ang) * br.X * 0.95, math.sin(ang) * br.Y * 0.95, 0) * ANG(0, 0, ang - PI / 2))
		H.diamond(rig, pv.part, "RayBlade", 0.9 * s, 0.45 * s, 0.12 * s, k % 2 == 0 and vd._a or C("#FFD02A"), CF(0, 0.35 * s, 0), Enum.Material.Neon)
		openable(H, rig, pv, V3(1, 0, 0), 0.6)
	end
	local ring = H.band(rig, rig.body, "CoreRing", ANG(PI / 2, 0, 0) * CF(0, 0.2 * s, 0), br.X * 0.85, 0.12 * s, vd._a, 18)
	glow(rig, rig.body, WHITE)
end

function A.aetherion(H, rig, vd, s)
	local br = rig.bodyRadius
	for _, side in ipairs({ -1, 1 }) do
		H.crystal(rig, rig.body, "ShoulderCrystal", 0.9 * s, 0.25 * s, C("#BFF6FF"), CF(side * br.X * 0.75, br.Y * 0.75, -br.Z * 0.3) * ANG(0.3, 0, -side * 0.5), Enum.Material.Glass, 0.1)
	end
	local orbit = H.pivot(rig, rig.body, "CrystalOrbit", CF(0, 1.4 * s, -1.5 * s))
	H.crystal(rig, orbit.part, "OrbitCrystal", 0.5 * s, 0.2 * s, vd._a, CF(1.4 * s, 0, 0), Enum.Material.Neon)
	H.group(rig, "ornamentOrbit", orbit)
end

function A.eternityOwl(H, rig, vd, s)
	local br = rig.bodyRadius
	for k = 1, 2 do
		local ring = H.band(rig, rig.body, "ClockRing", ANG(0.4 * k, 0, -0.3 * k), br.X * (1.7 + k * 0.3), 0.07 * s, k == 1 and vd._s or vd._a, 24)
		for m = 0, 3 do
			local ang = m / 4 * PI * 2
			H.blk(rig, ring.part, "Marker", V3(0.18, 0.3, 0.18) * s, C("#FFFFFF"), CF(math.cos(ang) * br.X * (1.7 + k * 0.3), 0, math.sin(ang) * br.X * (1.7 + k * 0.3)), Enum.Material.Neon)
		end
		ring.stepRate = k == 1 and 0.25 or -0.15
		H.group(rig, "clockRings", ring)
	end
	for _, e in ipairs(rig.eyes) do glow(rig, e.part, WHITE) end
end

function A.genesis(H, rig, vd, s)
	local br = rig.bodyRadius
	local rec = zchain(H, rig, rig.body, "Spine", CF(0, 0, br.Z * 0.8), 7, 0.85 * s, function(t) return (0.7 - t * 0.45) * s end,
		function(t, j) return j % 2 == 0 and vd._p or C("#F6F2E6") end, { kind = "spine", i = 1, amp = 0.22, freq = 1.0, lag = 0.65 })
	for j, part in ipairs(rec.parts) do
		H.ell(rig, part, "GoldBelly", V3(0.9, 0.45, 1.1) * s * (1 - j * 0.08), vd._s, CF(0, -0.28 * s * (1 - j * 0.08), 0))
	end
	H.diamond(rig, rec.parts[#rec.parts], "AuroraTip", 1.2 * s, 0.6 * s, 0.06 * s, vd._a, CF(0, 0, 0.7 * s) * ANG(PI / 2, 0, 0), Enum.Material.Neon, 0.2)
	for _, w in ipairs(rig.wings) do
		H.diamond(rig, w.e.part, "Inset", 0.9 * s, 0.5 * s, 0.05 * s, vd._a, CF(w.side * 0.6 * s, 0, -0.03), Enum.Material.Neon, 0.2)
	end
	local seed = H.pivot(rig, rig.body, "Seed", CF(0, -0.2 * s, -br.Z * 1.25))
	local sp = H.ell(rig, seed.part, "LightSeed", V3(0.35, 0.35, 0.35) * s, WHITE, CF(), Enum.Material.Neon, 0.1)
	H.group(rig, "seed", seed)
	glow(rig, sp.part, C("#FFE9A6"))
end

function A.infinityFox(H, rig, vd, s)
	local br = rig.bodyRadius
	local tailCols = { vd._p, H.lighten(vd._p, 0.2), vd._s, vd._a, WHITE }
	for i = 1, 9 do
		local off = (i - 5)
		local c0 = CF(off * 0.08 * s, 0.25 * s, br.Z * 0.9) * ANG(-0.55 - math.abs(off) * 0.04, off * 0.2, 0)
		local rec = zchain(H, rig, rig.body, "Tail" .. i, c0, 5, 0.55 * s, function(t) return (0.3 + math.sin(t * PI) * 0.12 - t * 0.14) * s end,
			function(t) local c = tailCols[math.clamp(math.floor(t * 4.99) + 1, 1, 5)]; return (i % 2 == 0) and c:Lerp(vd._a, 0.3) or c end,
			{ kind = "fan", i = i, n9 = 9, baseYaw = off * 0.2, amp = 0.18, freq = 1.6, lag = 0.55 },
			function(t) return t > 0.6 and Enum.Material.Neon or Enum.Material.SmoothPlastic end, function(t) return t > 0.6 and 0.1 or 0 end)
		local star = H.pivot(rig, rec.parts[#rec.parts], "TailStar", CF(0, 0, 0.45 * s))
		H.diamond(rig, star.part, "Star", 0.45 * s, 0.22 * s, 0.05 * s, WHITE, ANG(0, 0, PI / 4), Enum.Material.Neon)
		H.group(rig, "tailChains", rec)
		H.group(rig, "tailStars", star)
		reveal(rig, subtree(rig, { rec.parts[1] }))
	end
	local hr = rig.headRadius
	for k = 0, 6 do
		local ang = k / 7 * PI * 2
		H.ell(rig, rig.head, "Mane", V3(0.3, 0.6, 0.18) * s, k % 2 == 0 and vd._s or vd._a, CF(math.cos(ang) * hr.X * 0.85, math.sin(ang) * hr.Y * 0.75 - 0.2 * s, hr.Z * 0.55) * ANG(0, 0, ang - PI / 2) * CF(0, 0.2 * s, 0))
	end
	for _, e in ipairs(rig.eyes) do glow(rig, e.part, WHITE) end
end

return A
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">SpeciesModels</string><ProtectedString name="Source"><![CDATA[-- SpeciesModels: hand-authored, reference-faithful creature models (highest priority path).
-- Location: ReplicatedStorage > Shared > SpeciesModels (ModuleScript)
--
-- Each entry is model(H, rig, vd, s) and must fill the standard rig channels used by
-- CreatureAnimator: bodyEntry/body, headEntry/head, feet (FL, FR, BL, BR — one pivot per leg),
-- legKind, tail (ordered chain entries), ears {e, side}, eyes, groups.
-- Reference: roblox pets/Pets/<World>/<NN>_<Id>.png. Construction notes live above each model.

local M = {}
local PI = math.pi
local V3, CF, ANG = Vector3.new, CFrame.new, CFrame.Angles
local function C(h) return Color3.fromHex(h) end
local MAT = Enum.Material

---------------------------------------------------------------- PRISM LION (29_PrismLion.png)
-- Low powerful stance, deep chest, four thick column legs with big three-toed boxy paws,
-- boxy skull with heavy brow + projecting angular muzzle + squared jaw, small triangular ears,
-- forehead gem, large two-layer radial crystal mane (purple, cyan tips) + chest bib,
-- white armour plates with purple chevron insets and ankle bands, 5-segment tail curling up
-- to a big crystal cluster.
-- Hierarchy: Root > Body(torso) > {Chest, Hips, ShoulderPlates, NeckPivot > Head > {Muzzle, Jaw,
-- Brow, Ears, Gem, ManePivots}, LegFL/FR/BL/BR > Leg > Paw > Toes, TailRoot > Seg1..5 > Tip}
function M.PrismLion(H, rig, vd, s)
	local white, shade, deep = C("#FBF6FF"), C("#E6DAF2"), C("#CDBDE0")
	local purple, lav, cyan, nose = C("#9D52F2"), C("#C49BFF"), C("#86E4FF"), C("#B4A0D2")
	local SP, GL = MAT.SmoothPlastic, MAT.Glass
	local function v(x, y, z) return V3(x, y, z) * s end
	local function c(x, y, z) return CF(x * s, y * s, z * s) end

	-- faceted gem: flattened prism body + crossed pyramid tip (pointed and solid from every view),
	-- base at cf, tip at +Y; colB tints one tip facet (the cyan glint in the reference)
	local function gem(parent, cf, len, w, colA, colB)
		local L, W = len * s, w * s
		local bodyL = L * 0.58
		H.blk(rig, parent, "Gem", V3(W, bodyL, W * 0.75), colA, cf * CF(0, bodyL / 2, 0), GL, 0.04)
		local tip = cf * CF(0, bodyL + L * 0.21, 0)
		H.tri(rig, parent, "GemTip", W * 0.75, L * 0.42, W, colA, tip * ANG(0, PI / 2, 0), GL, 0.04)
		H.tri(rig, parent, "GemFacet", W * 0.98, L * 0.42, W * 0.75, colB, tip, GL, 0.04)
	end

	---------------------------------------------------------------- torso: long, low, chunky
	local be, body = H.blk(rig, rig.root, "Body", v(2.0, 1.6, 2.9), white, c(0, 2.05, 0.1), SP)
	rig.bodyEntry, rig.body = be, body
	rig.bodyRadius = v(1.0, 0.7, 1.45)
	H.blk(rig, body, "Chest", v(2.2, 2.0, 1.2), white, c(0, 0.05, -1.35), SP)
	H.blk(rig, body, "Belly", v(1.7, 0.3, 2.2), shade, c(0, -0.84, 0.1), SP)
	H.blk(rig, body, "Hips", v(2.0, 1.5, 1.1), white, c(0, 0.0, 1.35), SP)
	H.wdg(rig, body, "Rump", v(1.98, 0.5, 0.6), white, c(0, 0.92, 1.55) * ANG(0, PI, 0), SP)
	H.blk(rig, body, "BackPlate", v(1.2, 0.16, 2.0), shade, c(0, 0.78, 0.2), SP)
	for _, sd in ipairs({ -1, 1 }) do
		-- shoulder armour plate + one slanted purple panel stripe on shoulder and haunch
		H.blk(rig, body, "ShoulderPlate", v(0.2, 1.35, 1.25), shade, c(sd * 1.13, 0.1, -1.15), SP)
		for _, ch in ipairs({ { -1.15, 1 }, { 1.3, -1 } }) do
			H.blk(rig, body, "Stripe", v(0.06, 0.24, 1.15), purple, c(sd * 1.235, 0.12, ch[1]) * ANG(0.75 * ch[2], 0, 0), SP)
		end
	end

	---------------------------------------------------------------- legs: hip pivot -> upper -> knee pivot -> lower + paw
	-- hip is 1.45 above ground; the knee lets crouch/stride bend instead of sinking the paws
	local function leg(name, x, z, hind)
		local pv = H.pivot(rig, body, name, c(x, -0.6, z))
		if hind then
			H.blk(rig, pv.part, "Thigh", v(1.0, 0.95, 1.15), white, c(0, -0.25, 0.05), SP)
		else
			H.blk(rig, pv.part, "Upper", v(0.9, 0.8, 0.95), white, c(0, -0.32, 0), SP)
			H.blk(rig, pv.part, "LegPlate", v(0.66, 0.6, 0.08), shade, c(0, -0.32, -0.5), SP)
		end
		local knee = H.pivot(rig, pv.part, name .. "Knee", c(0, -0.7, 0))
		H.blk(rig, knee.part, "Leg", v(0.8, 0.45, 0.86), white, c(0, -0.18, 0), SP)
		H.blk(rig, knee.part, "AnkleBand", v(0.86, 0.12, 0.92), purple, c(0, -0.38, 0), SP)
		H.blk(rig, knee.part, "Paw", v(1.15, 0.36, 1.3), white, c(0, -0.57, -0.12), SP)
		for t = -1, 1 do
			H.blk(rig, knee.part, "Toe", v(0.32, 0.32, 0.36), shade, c(t * 0.37, -0.59, -0.8), SP)
		end
		pv.knee, pv.upperLen, pv.kneeDir = knee, 0.7 * s, hind and -1 or 1
		table.insert(rig.feet, pv)
	end
	leg("LegFL", -0.82, -1.25, false)
	leg("LegFR", 0.82, -1.25, false)
	leg("LegBL", -0.8, 1.35, true)
	leg("LegBR", 0.8, 1.35, true)
	rig.legKind = "quad"

	---------------------------------------------------------------- neck + big broad head
	local neck = H.pivot(rig, body, "NeckPivot", c(0, 0.55, -1.75))
	H.blk(rig, neck.part, "Neck", v(1.4, 1.2, 0.9), white, c(0, 0.3, -0.1) * ANG(-0.3, 0, 0), SP)
	local he, head = H.blk(rig, neck.part, "Head", v(1.85, 1.55, 1.5), white, c(0, 0.95, -0.75), SP, nil, c(0, -0.5, 0.25))
	rig.headEntry, rig.head = he, head
	rig.headRadius, rig.faceY = v(0.92, 0.78, 0.75), 0
	local fz = -0.75 -- face plane (head local)
	H.wdg(rig, head, "Crest", v(1.3, 0.28, 1.0), shade, c(0, 0.9, 0.15), SP) -- high at the back, slopes to the brow
	H.blk(rig, head, "Forehead", v(0.9, 0.5, 0.2), white, c(0, 0.5, fz + 0.05), SP)
	H.blk(rig, head, "Muzzle", v(1.1, 0.62, 0.8), white, c(0, -0.42, fz - 0.32), SP)
	H.wdg(rig, head, "MuzzleBridge", v(0.6, 0.26, 0.5), white, c(0, -0.04, fz - 0.24) * ANG(0, PI, 0), SP)
	H.wdg(rig, head, "Nose", v(0.42, 0.2, 0.24), nose, c(0, -0.08, fz - 0.62) * ANG(0, PI, 0), SP)
	H.blk(rig, head, "NoseFront", v(0.42, 0.14, 0.08), nose, c(0, -0.18, fz - 0.7), SP)
	H.blk(rig, head, "MouthLine", v(0.62, 0.05, 0.05), deep, c(0, -0.55, fz - 0.71), SP)
	local jaw = H.blk(rig, head, "Jaw", v(0.9, 0.28, 0.65), shade, c(0, -0.76, fz - 0.22), SP, nil, c(0, 0, 0.3))
	H.group(rig, "jaws", jaw)
	for _, sd in ipairs({ -1, 1 }) do
		-- angled brow (inner end lower) gives the stern lion look over the eyes
		H.blk(rig, head, "Brow", v(0.98, 0.26, 0.45), shade, c(sd * 0.46, 0.34, fz - 0.08) * ANG(0.3, 0, sd * 0.2), SP)
		H.wdg(rig, head, "Cheek", v(0.32, 0.85, 0.75), shade, c(sd * 0.95, -0.28, fz + 0.22), SP)
		H.blk(rig, head, "EyeSocket", v(0.48, 0.24, 0.06), deep, c(sd * 0.42, 0.1, fz - 0.02) * ANG(0, 0, sd * 0.22), SP)
		local eye = H.blk(rig, head, "Eye", v(0.4, 0.16, 0.06), purple, c(sd * 0.42, 0.1, fz - 0.05) * ANG(0, 0, sd * 0.22), MAT.Neon)
		table.insert(rig.eyes, eye)
		local ear = H.pivot(rig, head, "EarPivot", c(sd * 0.62, 0.75, 0.15) * ANG(0, 0, -sd * 0.3))
		H.tri(rig, ear.part, "Ear", 0.18 * s, 0.5 * s, 0.5 * s, white, c(0, 0.25, 0), SP)
		H.tri(rig, ear.part, "EarInner", 0.06 * s, 0.32 * s, 0.28 * s, purple, c(0, 0.18, -0.1), SP)
		table.insert(rig.ears, { e = ear, side = sd, kind = "cat" })
	end
	H.diamond(rig, head, "ForeheadGem", 0.5 * s, 0.3 * s, 0.1 * s, purple, c(0, 0.6, fz - 0.06), GL)

	---------------------------------------------------------------- mane: collar of gems round the face + long blades swept back
	-- centred on the back of the head so the front view reads as a sunburst around the face
	local manePivot = H.pivot(rig, neck.part, "ManePivot", c(0, 0.95, -0.05))
	-- collar: gems fanning out round the face (welded straight to the mane pivot)
	for i, deg in ipairs({ -160, -120, -80, -40, 0, 40, 80, 120, 160 }) do
		local a = math.rad(deg)
		gem(manePivot.part, CF(math.sin(a) * 0.88 * s, math.cos(a) * 0.78 * s, 0) * ANG(0.5, 0, -a), 1.9 - math.abs(deg) / 180 * 0.6, 0.95,
			(i % 3 == 0) and lav or purple, (i % 2 == 0) and cyan or lav)
	end
	-- mid ring: fills the neck sides between collar and back sweep
	for i, deg in ipairs({ -130, -75, 75, 130 }) do
		local a = math.rad(deg)
		gem(manePivot.part, CF(math.sin(a) * 0.85 * s, math.cos(a) * 0.8 * s, 0.3 * s) * ANG(0.85, 0, -a), 2.2, 1.0, purple, (i % 2 == 0) and cyan or lav)
	end
	-- back sweep: long blades streaming back over the shoulders, longest on top (each flares on the pounce)
	for i, deg in ipairs({ -120, -80, -40, 0, 40, 80, 120 }) do
		local a = math.rad(deg)
		local pv = H.pivot(rig, manePivot.part, "ManeRoot", CF(math.sin(a) * 0.7 * s, math.cos(a) * 0.7 * s, 0.55 * s) * ANG(1.15, 0, -a))
		gem(pv.part, CF(), 3.0 - math.abs(deg) / 180 * 1.1, 1.05, (i % 3 == 0) and lav or purple, (i % 2 == 1) and cyan or lav)
		pv.openAxis, pv.openAmt = V3(1, 0, 0), -0.2
		H.group(rig, "open", pv)
		H.group(rig, "mane", pv)
	end
	-- chest bib: downward gems under the chin
	for i, x in ipairs({ -0.4, 0, 0.4 }) do
		gem(neck.part, c(x, 0.55, -1.05) * ANG(0, 0, PI) * ANG(-0.15, 0, -x * 0.5), i == 2 and 1.35 or 1.0, 0.7, purple, i == 2 and cyan or lav)
	end

	---------------------------------------------------------------- tail: 5 thick segments curling up + one big crystal
	local prev = body
	local seg = { { 0.6, 0.62, 0 }, { 0.56, 0.6, -0.5 }, { 0.52, 0.56, -0.6 }, { 0.48, 0.54, -0.6 }, { 0.46, 0.5, -0.5 } }
	for i, d in ipairs(seg) do
		local w = d[1] * s
		local c0 = (i == 1) and c(0, 0.45, 1.9) * ANG(0.3, 0, 0) or CF(0, 0, d[2] * s) * ANG(d[3], 0, 0)
		local e, p = H.blk(rig, prev, "TailSeg", V3(w, w, d[2] * s * 1.15), i % 2 == 0 and shade or white, c0, SP, nil, CF(0, 0, -d[2] * s * 0.5))
		table.insert(rig.tail, e)
		prev = p
	end
	local tipPv = H.pivot(rig, prev, "TailTip", CF(0, 0, 0.25 * s) * ANG(PI / 2, 0, 0))
	gem(tipPv.part, CF(), 2.1, 1.1, purple, cyan)
end

-- world packs built from the owner's character sheets (see each file for construction notes)
-- (a pack that fails to load only costs its species their hand-built look, never the whole roster)
for _, pack in ipairs({ "SpeciesModelsVolcano", "SpeciesModelsCandy", "SpeciesModelsCrystal",
	"SpeciesModelsForest", "SpeciesModelsFrozen", "SpeciesModelsDivine",
	"SpeciesModelsHeaven", "SpeciesModelsSecret", "SpeciesModelsShadow", "SpeciesModelsSpace" }) do
	local ok, models = pcall(require, script.Parent[pack])
	if ok and type(models) == "table" then
		for id, fn in pairs(models) do
			M[id] = fn
		end
	else
		warn("[SpeciesModels] " .. pack .. " failed to load: " .. tostring(models))
	end
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">SpeciesModelsCandy</string><ProtectedString name="Source"><![CDATA[-- SpeciesModelsCandy: hand-authored, reference-faithful models for the Candy world
-- (Gumdrop, Cocoa Cub, Lollipup, Marshmallow Ghost, Sugarcorn, Cotton Candy Kirin, Candy Queen Bee,
-- Chocolate Colossus).
-- Location: ReplicatedStorage > Shared > SpeciesModelsCandy (ModuleScript), merged into SpeciesModels.

local K = require(script.Parent.ModelKit)
local V3, CF, ANG, PI, MAT, C = K.V3, K.CF, K.ANG, K.PI, K.MAT, K.C
local FACE, DOWN = ANG(0, PI / 2, 0), ANG(0, 0, PI)
local SIDES = { -1, 1 }

local M = {}

---------------------------------------------------------------- GUMDROP (Common)
-- Pink candy crawler: big boxy body with a sloped hood, white side panels, glowing white slit eyes,
-- white chin, a striped candy lid on top that pops up on the power move, four splayed legs with
-- light-pink shins and white feet.
function M.Gumdrop(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local P, PD, PL, W, EY = C("#F0559A"), C("#D9407F"), C("#F7B5D0"), C("#FFFFFF"), C("#FFF4FA")
	local BY = 1.45
	local body = k.body(2.1, 1.3, 2.3, P, BY)
	k.w(body, "Hood", 2.1, 0.55, 0.9, P, c(0, 0.92, -0.6))
	k.b(body, "Top", 2.1, 0.55, 1.4, P, c(0, 0.92, 0.45))
	k.b(body, "Face", 1.7, 0.8, 0.2, P, c(0, 0.0, -1.2))
	k.b(body, "Chin", 1.1, 0.4, 0.6, W, c(0, -0.6, -0.95))
	for _, sd in ipairs(SIDES) do
		k.eye(body, sd * 0.42, 0.05, -1.31, 0.4, 0.14, EY, 0)
		k.b(body, "SidePanel", 0.14, 0.95, 1.3, W, c(sd * 1.08, 0.35, 0.05) * ANG(0, 0, -sd * 0.2))
		k.b(body, "Cheek", 0.12, 0.6, 0.8, PL, c(sd * 1.07, -0.25, -0.6))
	end
	local lid = k.opener(body, "CandyHinge", c(0, 1.2, 0.75), V3(1, 0, 0), 0.55)
	local _, candy = k.b(lid, "Candy", 1.2, 0.32, 1.0, W, c(0, 0.16, -0.5))
	for i = -1, 1, 2 do
		k.b(candy, "CandyStripe", 0.26, 0.34, 0.9, P, c(i * 0.3, 0, 0) * ANG(0, 0.6, 0))
	end
	k.b(lid, "Latch", 0.3, 0.2, 0.25, PD, c(0, 0.05, -1.05))

	local lg = { up = { 0.7, 0.5, 0.75 }, col = P, w2 = 0.6, d2 = 0.65, col2 = PL, paw = { 0.8, 0.3, 0.85 }, pawCol = W, splay = 0.3 }
	k.leg(body, "LegFL", BY, -0.95, -0.35, -0.75, lg)
	k.leg(body, "LegFR", BY, 0.95, -0.35, -0.75, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.95, -0.35, 0.8, lg)
	k.leg(body, "LegBR", BY, 0.95, -0.35, 0.8, lg)
	rig.legKind = "quad"
end

---------------------------------------------------------------- COCOA CUB (Uncommon)
-- Stocky chocolate bear: tan V bib, dark collar with a pink shield tag, pink chevrons on the
-- shoulder plates, big square head with tan muzzle, dark nose, angry brows over glowing pink eyes,
-- square ears with tan insides, tan paws with claw lines, stub tail.
function M.CocoaCub(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local B, BD, T, TD = C("#8B4A2B"), C("#6E3820"), C("#E8B98A"), C("#D4A274")
	local P, DK, EY = C("#F2668B"), C("#3E2216"), C("#FF7AA0")
	local BY = 1.85
	local body = k.body(1.8, 1.5, 2.2, B, BY)
	k.b(body, "Chest", 1.85, 1.55, 0.9, B, c(0, 0.1, -0.95))
	k.b(body, "Bib", 1.0, 0.9, 0.12, T, c(0, -0.05, -1.45))
	k.tri(body, "BibTip", 0.12, 0.45, 1.0, T, c(0, -0.72, -1.45) * DOWN * FACE)
	k.b(body, "Collar", 1.5, 0.2, 0.2, DK, c(0, 0.6, -1.44))
	k.diamond(body, "Tag", 0.65, 0.5, 0.1, DK, c(0, 0.22, -1.5))
	k.diamond(body, "TagInner", 0.48, 0.34, 0.12, P, c(0, 0.22, -1.52))
	for _, sd in ipairs(SIDES) do
		k.b(body, "ShoulderPlate", 0.14, 1.0, 1.0, BD, c(sd * 0.95, 0.15, -0.95))
		k.b(body, "Chevron", 0.06, 0.18, 0.6, P, c(sd * 1.03, 0.4, -0.7) * ANG(0.55, 0, 0))
		k.b(body, "Chevron", 0.06, 0.18, 0.6, P, c(sd * 1.03, 0.4, -1.2) * ANG(-0.55, 0, 0))
	end

	local lf = { up = { 0.85, 0.65, 0.9 }, col = B, w2 = 0.75, d2 = 0.8, paw = { 0.95, 0.35, 1.05 }, pawCol = T, toes = 3, toeCol = TD }
	k.leg(body, "LegFL", BY, -0.6, -0.5, -0.85, lf)
	k.leg(body, "LegFR", BY, 0.6, -0.5, -0.85, lf)
	lf.hind = true
	k.leg(body, "LegBL", BY, -0.6, -0.5, 0.8, lf)
	k.leg(body, "LegBR", BY, 0.6, -0.5, 0.8, lf)
	rig.legKind = "quad"

	local head = k.head(body, 1.5, 1.3, 1.3, B, c(0, 1.15, -1.45), V3(0, -0.5, 0.4))
	local fz = -0.65
	k.b(head, "Muzzle", 0.85, 0.55, 0.5, T, c(0, -0.3, fz - 0.22))
	k.b(head, "Nose", 0.36, 0.18, 0.14, DK, c(0, -0.12, fz - 0.5))
	k.b(head, "Mouth", 0.4, 0.05, 0.05, DK, c(0, -0.45, fz - 0.48))
	k.b(head, "Crown", 1.3, 0.25, 0.9, BD, c(0, 0.62, 0.1))
	for _, sd in ipairs(SIDES) do
		k.b(head, "Brow", 0.6, 0.22, 0.3, BD, c(sd * 0.36, 0.22, fz - 0.04) * ANG(0, 0, sd * 0.3))
		k.eye(head, sd * 0.36, 0.04, fz - 0.03, 0.34, 0.13, EY, sd * 0.3)
		k.b(head, "Cheek", 0.3, 0.6, 0.6, BD, c(sd * 0.72, -0.2, -0.2))
		local ear = k.ear(head, sd, c(sd * 0.55, 0.65, 0.1), "round")
		k.b(ear, "Ear", 0.52, 0.5, 0.28, B, c(0, 0.22, 0))
		k.b(ear, "EarInner", 0.3, 0.28, 0.08, T, c(0, 0.2, -0.15))
	end
	k.tail(body, c(0, 0.35, 1.1), { { 0.5, 0.5, 0.45, -0.5, B } })
end

---------------------------------------------------------------- LOLLIPUP (Rare)
-- Light-pink candy dog: hot-pink shoulder/hip patches, blue zigzag stripes, blue collar with a swirl
-- tag, pink blaze over the head, glowing cyan eyes, big floppy pink ears with blue stripes, blue leg
-- bands and pink paws, a curling tail carrying a big swirl lollipop.
function M.Lollipup(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PL, PLD, P, B, EY = C("#F8CDDC"), C("#EDB4C8"), C("#EC5B97"), C("#5BB8E8"), C("#66E6FF")
	local BY = 1.8
	local body = k.body(1.55, 1.3, 2.4, PL, BY)
	k.b(body, "Chest", 1.6, 1.4, 0.8, PL, c(0, 0.08, -1.05))
	for _, sd in ipairs(SIDES) do
		k.b(body, "ShoulderPatch", 0.12, 0.85, 0.9, P, c(sd * 0.81, 0.05, -0.95))
		k.b(body, "HipPatch", 0.12, 0.8, 0.8, P, c(sd * 0.79, 0.1, 0.8))
		k.b(body, "Stripe", 0.06, 0.1, 1.0, B, c(sd * 0.81, -0.25, -0.1))
		k.b(body, "Stripe", 0.06, 0.1, 0.6, B, c(sd * 0.81, -0.05, 0.55) * ANG(-0.6, 0, 0))
	end
	k.b(body, "Collar", 1.3, 0.22, 0.22, B, c(0, 0.55, -1.47))
	k.b(body, "Tag", 0.4, 0.4, 0.1, PL, c(0, 0.25, -1.52))
	k.b(body, "TagSwirl", 0.22, 0.22, 0.11, P, c(0, 0.25, -1.53) * ANG(0, 0, PI / 4))

	local lf = { up = { 0.7, 0.6, 0.8 }, col = PL, w2 = 0.58, d2 = 0.65, band = B, paw = { 0.75, 0.3, 0.85 }, pawCol = P, toes = 3, toeCol = P }
	k.leg(body, "LegFL", BY, -0.52, -0.45, -0.95, lf)
	k.leg(body, "LegFR", BY, 0.52, -0.45, -0.95, lf)
	lf.hind = true
	k.leg(body, "LegBL", BY, -0.52, -0.45, 0.9, lf)
	k.leg(body, "LegBR", BY, 0.52, -0.45, 0.9, lf)
	rig.legKind = "quad"

	local head = k.head(body, 1.4, 1.2, 1.3, PL, c(0, 1.2, -1.5), V3(0, -0.45, 0.4))
	local fz = -0.65
	k.b(head, "Blaze", 0.34, 1.22, 1.32, P, c(0, 0.01, 0))
	k.b(head, "Muzzle", 0.8, 0.5, 0.6, PL, c(0, -0.3, fz - 0.25))
	k.b(head, "Nose", 0.36, 0.22, 0.2, P, c(0, -0.12, fz - 0.6))
	for _, sd in ipairs(SIDES) do
		k.b(head, "Brow", 0.5, 0.18, 0.25, PLD, c(sd * 0.4, 0.2, fz - 0.03) * ANG(0, 0, sd * 0.25))
		k.eye(head, sd * 0.38, 0.04, fz - 0.03, 0.32, 0.14, EY, sd * 0.25)
		k.b(head, "CheekStripe", 0.06, 0.1, 0.5, B, c(sd * 0.71, -0.25, -0.2))
		local ear = k.ear(head, sd, c(sd * 0.62, 0.45, 0.05), "floppy")
		local _, flap = k.b(ear, "Ear", 0.22, 1.35, 0.95, P, c(sd * 0.12, -0.45, 0) * ANG(0, 0, sd * 0.18))
		k.b(flap, "EarRim", 0.24, 1.2, 0.2, PL, c(0, 0, -0.42))
		k.b(flap, "EarStripe", 0.25, 0.08, 0.6, B, c(0, -0.35, 0.1))
	end

	local tip = k.tail(body, c(0, 0.4, 1.15), {
		{ 0.32, 0.32, 0.6, -0.55, PL }, { 0.3, 0.3, 0.55, -0.35, P }, { 0.28, 0.28, 0.5, -0.4, PL } })
	local dc = c(0, 0, 1.05)
	for i, r in ipairs({ 1.7, 1.25, 0.85, 0.45 }) do
		local col = (i % 2 == 1) and P or PL
		k.b(tip, "Lollipop", 0.2 + i * 0.02, r, r, col, dc)
		k.b(tip, "Lollipop", 0.2 + i * 0.02, r, r, col, dc * ANG(PI / 4, 0, 0))
	end
end

---------------------------------------------------------------- MARSHMALLOW GHOST (Epic)
-- Floating hooded marshmallow spirit: white hood with a pink centre stripe and a dark face showing
-- glowing pink eyes, layered collar plates that flare like wings, a pink emblem, a hem of hanging
-- white/pink spikes, two floating fists with glowing pink bands.
function M.Marshghost(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local W, WD, PL, P = C("#FAF6F8"), C("#ECE3E8"), C("#F6C3D8"), C("#F06FA8")
	local DK, EY = C("#2A1626"), C("#FF6FC0")
	local BY = 2.5
	local body = k.body(1.5, 1.7, 1.25, W, BY)
	rig.legKind = "none"
	k.b(body, "Mantle", 1.9, 0.5, 1.4, W, c(0, 0.75, 0.05))
	k.b(body, "Emblem", 0.5, 0.14, 0.1, P, c(0, 0.25, -0.66))
	k.b(body, "EmblemStem", 0.18, 0.5, 0.1, P, c(0, 0.0, -0.66))

	local head = k.head(body, 1.35, 1.2, 1.35, W, c(0, 1.55, -0.05), V3(0, -0.5, 0.2))
	k.b(head, "HoodStripe", 0.26, 1.24, 1.39, P, c(0, 0.02, 0))
	k.w(head, "HoodPeak", 1.35, 0.6, 0.9, W, c(0, 0.85, 0.1))
	k.b(head, "Face", 0.95, 0.55, 0.12, DK, c(0, -0.1, -0.66))
	k.b(head, "Brim", 1.1, 0.12, 0.12, WD, c(0, 0.24, -0.7))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.22, -0.08, -0.73, 0.24, 0.1, EY, sd * 0.2)
		k.b(head, "BrimSide", 0.12, 0.6, 0.12, WD, c(sd * 0.53, -0.08, -0.7))
	end

	local robe = { { -0.5, -0.45, 1.8, W }, { 0, -0.5, 2.0, PL }, { 0.5, -0.45, 1.8, W }, { -0.35, 0.35, 1.6, PL },
		{ 0.35, 0.35, 1.6, W }, { -0.75, 0, 1.4, PL }, { 0.75, 0, 1.4, PL } }
	for _, d in ipairs(robe) do
		local te, tp = k.pv(body, "RobePivot", c(d[1], -0.7, d[2]))
		table.insert(rig.tail, te)
		k.tri(tp, "Robe", 0.18, d[3], 0.75, d[4], c(0, -d[3] / 2, 0) * DOWN * FACE)
	end

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.85, 0.75, 0.15))
		k.featherWing(w, sd, { root = 0.1, z = 0.06, thick = 0.18, feathers = {
			{ 0.9, 1.3, 0.5, W, PL }, { 0.5, 1.6, 0.55, PL, PL }, { 0.15, 1.5, 0.55, W, W }, { -0.25, 1.3, 0.5, PL, PL } } })
		local a = k.arm(body, sd, c(sd * 0.9, 0.1, -0.2))
		local _, fist = k.b(a, "Fist", 0.62, 0.62, 0.62, W, c(sd * 0.45, -0.75, -0.25))
		local _, band = k.b(fist, "FistBand", 0.66, 0.14, 0.66, P, c(0, 0.18, 0), MAT.Neon)
		k.glow(band, P)
		for f = 1, 3 do k.b(fist, "Finger", 0.18, 0.2, 0.12, WD, c((f - 2) * 0.2, -0.05, -0.34)) end
	end
end

---------------------------------------------------------------- SUGARCORN (Legendary)
-- Armoured candy unicorn: white body with light-pink chest/hip/shoulder plates and pink chevrons,
-- a pink chest gem, long legs with pink knee bands and split pink hooves, long neck, horse head with
-- a white/pink striped horn, flowing pink/white mane and a big swept tail of pink and white blades.
function M.Sugarcorn(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local W, PL, P, PD, EY = C("#FFF4F8"), C("#F9C5DA"), C("#EF5A9A"), C("#D6407E"), C("#FF5AA8")
	local BY = 2.95
	local body = k.body(1.45, 1.35, 2.8, W, BY)
	k.b(body, "ChestPlate", 1.55, 1.3, 0.7, PL, c(0, 0.05, -1.25))
	k.b(body, "GemFrame", 0.7, 0.7, 0.1, W, c(0, 0.05, -1.6) * ANG(0, 0, PI / 4))
	k.diamond(body, "ChestGem", 0.85, 0.55, 0.16, P, c(0, 0.05, -1.64), MAT.Glass)
	k.b(body, "HipPlate", 1.55, 1.1, 0.9, PL, c(0, 0.15, 1.05))
	for _, sd in ipairs(SIDES) do
		k.b(body, "ShoulderPad", 0.18, 0.9, 1.0, PL, c(sd * 0.8, 0.2, -1.0))
		k.b(body, "PadChevron", 0.06, 0.14, 0.7, P, c(sd * 0.9, 0.35, -0.8) * ANG(0.5, 0, 0))
		k.b(body, "HipChevron", 0.06, 0.14, 0.7, P, c(sd * 0.79, 0.3, 1.15) * ANG(-0.5, 0, 0))
	end

	local lf = { up = { 0.62, 1.0, 0.75 }, col = W, w2 = 0.48, d2 = 0.58, band = P, bandY = 0.25, paw = { 0.6, 0.42, 0.72 }, pawCol = P, toes = 2, toeCol = PD }
	k.leg(body, "LegFL", BY, -0.45, -0.5, -1.0, lf)
	k.leg(body, "LegFR", BY, 0.45, -0.5, -1.0, lf)
	local lh = { up = { 0.7, 1.05, 0.85 }, col = W, w2 = 0.5, d2 = 0.6, band = P, bandY = 0.25, paw = { 0.62, 0.42, 0.74 }, pawCol = P, toes = 2, toeCol = PD, hind = true }
	k.leg(body, "LegBL", BY, -0.45, -0.45, 1.0, lh)
	k.leg(body, "LegBR", BY, 0.45, -0.45, 1.0, lh)
	rig.legKind = "quad"

	k.b(body, "Neck", 0.75, 1.5, 0.8, W, c(0, 1.05, -1.45) * ANG(-0.45, 0, 0))
	local head = k.head(body, 0.75, 0.75, 1.35, W, c(0, 1.95, -2.05), V3(0, -0.2, 0.5))
	k.w(head, "Snout", 0.62, 0.45, 0.6, W, c(0, -0.1, -0.85))
	k.b(head, "Nostril", 0.5, 0.08, 0.06, PL, c(0, -0.25, -1.13))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.3, 0.12, -0.68, 0.18, 0.1, EY, sd * 0.3)
		local ear = k.ear(head, sd, c(sd * 0.25, 0.38, 0.2))
		k.tri(ear, "Ear", 0.14, 0.45, 0.3, W, c(0, 0.22, 0) * FACE)
		k.tri(ear, "EarInner", 0.05, 0.3, 0.16, P, c(0, 0.18, -0.08) * FACE)
	end
	local hb = c(0, 0.38, -0.35) * ANG(-0.35, 0, 0)
	for i = 0, 3 do
		k.b(head, "Horn", 0.26 - i * 0.05, 0.28, 0.26 - i * 0.05, (i % 2 == 0) and W or P, hb * c(0, 0.14 + i * 0.27, 0))
	end
	k.spike(head, "HornTip", 0.5, 0.12, W, hb * c(0, 1.2, 0))

	local maneCols = { P, W, PL, P, W, PL }
	for i = 1, 6 do
		local me, mp = k.pv(body, "ManeRoot", c(0, 1.8 - (i - 1) * 0.21, -1.55 + (i - 1) * 0.12) * ANG(0.9 + i * 0.08, 0, 0))
		if i % 2 == 0 then H.group(rig, "flutter", me) end
		k.tri(mp, "Mane", 0.25, 1.3 - i * 0.05, 0.6, maneCols[i], c(0, 0.6, 0))
		k.tri(mp, "Mane", 0.22, 1.0, 0.45, P, c((i % 2 == 0) and -0.15 or 0.15, 0.45, 0.1) * ANG(0, 0, (i % 2 == 0) and 0.4 or -0.4))
	end

	local te, tp = k.pv(body, "TailRoot", c(0, 0.45, 1.45) * ANG(1.0, 0, 0))
	table.insert(rig.tail, te)
	for i, d in ipairs({ { -0.5, 2.0, P }, { -0.2, 2.4, W }, { 0.1, 2.3, PL }, { 0.4, 2.0, P }, { 0.7, 1.6, W }, { -0.8, 1.6, PL } }) do
		k.tri(tp, "TailBlade", 0.3, d[2], 0.75, d[3], ANG(d[1], 0, 0) * c((i % 2 == 0) and 0.12 or -0.12, d[2] * 0.45, 0))
	end
end

---------------------------------------------------------------- COTTON CANDY KIRIN (Legendary)
-- Slender floating kirin in pink, sky blue and white: framed blue gems on the chest and hips, slim
-- legs with white cuffs and blue hooves, long neck, white horn, layered pink/blue/white mane and a
-- huge peacock fan tail whose blades spread wider on the power move.
function M.CottonCandyCloud(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PK, PKD, BL, W = C("#F7B9D3"), C("#EBA0C0"), C("#A9D8F2"), C("#FFFFFF")
	local GEM, EY = C("#BDE6FF"), C("#C9A8FF")
	local BY = 2.8
	local body = k.body(1.25, 1.2, 2.6, PK, BY)
	k.b(body, "Chest", 1.3, 1.2, 0.6, PK, c(0, 0.05, -1.2))
	k.b(body, "ChestFrame", 0.75, 0.75, 0.12, W, c(0, 0.05, -1.52) * ANG(0, 0, PI / 4))
	k.diamond(body, "ChestGem", 0.8, 0.55, 0.16, GEM, c(0, 0.05, -1.58), MAT.Glass)
	for _, sd in ipairs(SIDES) do
		k.b(body, "ShoulderPlate", 0.14, 0.8, 0.9, W, c(sd * 0.67, 0.15, -0.9))
		k.b(body, "HipFrame", 0.12, 0.85, 0.85, W, c(sd * 0.66, 0.15, 0.95) * ANG(PI / 4, 0, 0))
		k.diamond(body, "HipGem", 0.7, 0.5, 0.14, GEM, c(sd * 0.74, 0.15, 0.95) * ANG(0, -sd * PI / 2, 0), MAT.Glass)
	end

	local lf = { up = { 0.5, 0.95, 0.6 }, col = PK, w2 = 0.36, d2 = 0.42, band = W, paw = { 0.48, 0.38, 0.55 }, pawCol = BL }
	k.leg(body, "LegFL", BY, -0.38, -0.45, -0.95, lf)
	k.leg(body, "LegFR", BY, 0.38, -0.45, -0.95, lf)
	lf.hind = true
	k.leg(body, "LegBL", BY, -0.38, -0.45, 0.95, lf)
	k.leg(body, "LegBR", BY, 0.38, -0.45, 0.95, lf)
	rig.legKind = "quad"

	k.b(body, "Neck", 0.62, 1.4, 0.7, PK, c(0, 1.0, -1.35) * ANG(-0.5, 0, 0))
	local head = k.head(body, 0.65, 0.65, 1.25, PK, c(0, 1.85, -1.95), V3(0, -0.2, 0.45))
	k.w(head, "Snout", 0.55, 0.4, 0.55, PK, c(0, -0.08, -0.8))
	k.b(head, "Brow", 0.68, 0.12, 0.6, W, c(0, 0.32, -0.25))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.26, 0.1, -0.63, 0.16, 0.09, EY, sd * 0.3)
		local ear = k.ear(head, sd, c(sd * 0.24, 0.32, 0.25))
		k.tri(ear, "Ear", 0.12, 0.42, 0.28, W, c(0, 0.2, 0) * FACE)
		k.tri(ear, "EarInner", 0.05, 0.28, 0.15, BL, c(0, 0.17, -0.07) * FACE)
	end
	k.spike(head, "Horn", 1.5, 0.3, W, c(0, 0.33, -0.2) * ANG(-0.25, 0, 0))

	local maneCols = { PK, BL, W, PK, BL, W, PK }
	for i = 1, 7 do
		local me, mp = k.pv(body, "ManeRoot", c(0, 1.7 - (i - 1) * 0.18, -1.45 + (i - 1) * 0.1) * ANG(1.0 + i * 0.06, 0, 0))
		if i % 2 == 1 then H.group(rig, "flutter", me) end
		k.tri(mp, "Mane", 0.22, 1.4 - i * 0.06, 0.55, maneCols[i], c(0, 0.65, 0))
		k.tri(mp, "Mane", 0.2, 1.0, 0.4, maneCols[(i % 7) + 1], c((i % 2 == 0) and -0.14 or 0.14, 0.45, 0.05) * ANG(0, 0, (i % 2 == 0) and 0.45 or -0.45))
	end

	local te, tp = k.pv(body, "TailRoot", c(0, 0.3, 1.35) * ANG(0.25, 0, 0))
	table.insert(rig.tail, te)
	local cols = { PK, BL, W, PK, BL, W, PK }
	for i = 1, 7 do
		local a = 0.25 + (i - 1) * 0.36
		local L = 2.4 - math.abs(i - 4) * 0.15
		local fp = k.opener(tp, "TailFeather", ANG(a, 0, 0), V3(1, 0, 0), (i - 4) * 0.1)
		k.b(fp, "Fan", 0.18 + (i % 2) * 0.04, L, 0.62, cols[i], c(0, L * 0.5 + 0.3, 0))
		k.tri(fp, "FanTip", 0.16, 0.4, 0.62, cols[i], c(0, L + 0.5, 0))
	end
	k.b(tp, "FanHub", 0.5, 0.5, 0.5, W, c(0, 0.1, 0))
end

---------------------------------------------------------------- CANDY QUEEN BEE (Mythical)
-- Hovering royal bee: dark thorax with a pink ruff collar and a gold-framed brooch, big yellow/dark
-- striped abdomen with a pink stinger, dark head under a gold helmet crowned with pink crystals,
-- glowing pink eyes, segmented antennae with pink tips, six thin legs with pink feet, two pairs of
-- pink gold-framed wings.
function M.QueenBee(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local Y, DK, DKL, P, PD, EY = C("#F5C62E"), C("#4A2A1A"), C("#5E3A26"), C("#F06AA0"), C("#D84A86"), C("#FF7AB8")
	local BY = 2.3
	local body = k.body(1.05, 1.05, 1.0, DK, BY)
	for i = 0, 5 do
		local a = (i - 2.5) / 5 * 2.4
		k.b(body, "Ruff", 0.5, 0.45, 0.45, (i % 2 == 0) and P or PD, c(math.sin(a) * 0.6, 0.45, -math.cos(a) * 0.5) * ANG(0.3, a, 0))
	end
	k.b(body, "BroochFrame", 0.42, 0.42, 0.08, Y, c(0, 0.12, -0.53) * ANG(0, 0, PI / 4))
	k.diamond(body, "Brooch", 0.5, 0.36, 0.1, P, c(0, 0.12, -0.57), MAT.Glass)

	local ae, ap = k.pv(body, "AbdomenPivot", c(0, 0.0, 0.45) * ANG(0.35, 0, 0))
	H.group(rig, "abdomen", ae)
	for i, d in ipairs({ { 1.25, Y }, { 1.45, DK }, { 1.5, Y }, { 1.35, DK }, { 1.1, Y }, { 0.8, DK } }) do
		k.b(ap, "Abdomen", d[1], d[1] * 0.92, 0.5, d[2], c(0, 0, 0.3 + (i - 1) * 0.48))
	end
	k.spike(ap, "Stinger", 0.9, 0.35, P, c(0, 0, 2.95) * ANG(PI / 2, 0, 0))

	local head = k.head(body, 0.8, 0.8, 0.8, DK, c(0, 0.95, -0.25), V3(0, -0.35, 0.15))
	k.b(head, "Helmet", 0.9, 0.42, 0.9, Y, c(0, 0.25, 0.02))
	k.b(head, "HelmetCheek", 0.9, 0.5, 0.3, Y, c(0, -0.05, 0.3))
	k.b(head, "Face", 0.62, 0.38, 0.06, DKL, c(0, -0.12, -0.42))
	k.b(head, "CrownBand", 0.75, 0.14, 0.75, Y, c(0, 0.5, 0))
	for _, d in ipairs({ { 0, 0.7 }, { -0.26, 0.5 }, { 0.26, 0.5 } }) do
		k.crystal(head, "CrownGem", d[2], 0.18, P, c(d[1], 0.55, -0.15) * ANG(0, 0, -d[1] * 0.6), MAT.Glass)
	end
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.17, -0.1, -0.46, 0.2, 0.1, EY, -sd * 0.3)
		k.tri(head, "CrownSpike", 0.08, 0.35, 0.22, Y, c(sd * 0.36, 0.62, 0.15) * FACE)
		local ant = k.ear(head, sd, c(sd * 0.22, 0.45, 0.05), "antenna")
		local p1, p2, p3 = V3(0, 0, 0), V3(sd * 0.2, 0.55, -0.1), V3(sd * 0.45, 0.95, -0.25)
		k.bar(ant, "Antenna", p1, p2, 0.11, DK, nil, nil, V3(1, 0, 0))
		k.bar(ant, "Antenna", p2, p3, 0.1, Y, nil, nil, V3(1, 0, 0))
		k.b(ant, "AntennaTip", 0.2, 0.2, 0.2, P, c(p3.X, p3.Y, p3.Z))
	end

	local lg = { up = { 0.16, 0.45, 0.16 }, col = DK, w2 = 0.14, d2 = 0.14, col2 = Y, paw = { 0.2, 0.28, 0.2 }, pawCol = P, lh = 0.55, splay = 0.5 }
	for _, z in ipairs({ -0.3, 0, 0.3 }) do
		k.leg(body, "LegL", BY, -0.4, -0.45, z, lg)
		k.leg(body, "LegR", BY, 0.4, -0.45, z, lg)
	end
	rig.legKind = "bug6"

	for _, sd in ipairs(SIDES) do
		for tier, d in ipairs({ { 0.5, 2.6, 1.0, 0.0 }, { 0.12, 1.9, 0.75, 0.3 } }) do
			-- d = { angle above horizontal, length, width, z offset }
			local w = k.wing(body, sd, c(sd * 0.45, 0.45, 0.05 + d[4]) * ANG(0, -sd * 0.35, 0), tier)
			local dir = V3(math.cos(d[1]) * sd, math.sin(d[1]), 0)
			local A, B = dir * 0.2, dir * d[2]
			local nrm = V3(-dir.Y, dir.X, 0) * d[3] * 0.5
			k.bar(w, "WingPanel", A, B, d[3], P, nil, 0.05, nil, 0.06)
			k.bar(w, "WingFrame", A + nrm, B + nrm, 0.1, Y)
			k.bar(w, "WingFrame", A - nrm, B - nrm, 0.1, Y)
			k.bar(w, "WingFrame", B + nrm, B - nrm, 0.1, Y)
			k.bar(w, "WingVein", A, B * 0.9, 0.07, Y)
		end
	end
end

---------------------------------------------------------------- CHOCOLATE COLOSSUS (Mythical)
-- Chocolate golem: broad torso with pink trim, a V of pink piping and a pink heart gem, pink belt and
-- loin panel, chocolate-bar shoulder pads (grooved grid), big arms with pink bands and huge fists,
-- column legs with pink knee bands and pink soles, small horned head under a pink crown.
function M.ChocoTitan(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local CH, CHD, CHL = C("#7A4426"), C("#5E321B"), C("#8E5532")
	local PL, P, HN, EY = C("#F6B8C8"), C("#F0478A"), C("#F2E6D8"), C("#FF6FA8")
	local BY = 3.6
	local body = k.body(2.5, 2.1, 1.7, CH, BY)
	k.b(body, "Collar", 2.3, 0.22, 0.2, PL, c(0, 0.75, -0.88))
	for _, sd in ipairs(SIDES) do
		k.b(body, "Pec", 1.1, 0.9, 0.25, CHL, c(sd * 0.6, 0.35, -0.86))
		k.b(body, "TrimV", 0.2, 1.1, 0.12, PL, c(sd * 0.55, 0.15, -1.0) * ANG(0, 0, -sd * 0.5))
	end
	k.diamond(body, "HeartGem", 0.85, 0.55, 0.16, P, c(0, 0.2, -1.07), MAT.Glass)
	k.b(body, "Belt", 2.2, 0.28, 1.55, PL, c(0, -0.95, 0))
	k.b(body, "Hips", 2.0, 0.6, 1.4, CH, c(0, -1.35, 0))
	k.b(body, "Loin", 0.9, 1.0, 0.12, CHD, c(0, -1.55, -0.76))
	k.tri(body, "LoinV", 0.1, 0.7, 0.55, P, c(0, -1.5, -0.83) * DOWN * FACE)

	local lg = { up = { 1.1, 0.8, 1.1 }, col = CH, w2 = 1.0, d2 = 1.05, band = PL, bandY = 0.15, paw = { 1.4, 0.5, 1.55, -0.1 }, pawCol = CH }
	for _, sd in ipairs(SIDES) do
		local _, _, knee, lh = k.leg(body, sd < 0 and "LegL" or "LegR", BY, sd * 0.65, -1.55, 0, lg)
		k.b(knee, "Sole", 1.45, 0.14, 1.6, P, c(0, -lh - 0.43, -0.1))
	end
	rig.legKind = "biped"

	for _, sd in ipairs(SIDES) do
		local a = k.arm(body, sd, c(sd * 1.5, 0.55, 0))
		local _, pad = k.b(a, "ShoulderBar", 1.5, 0.85, 1.5, CH, c(sd * 0.2, 0.3, 0))
		k.b(pad, "Groove", 1.52, 0.04, 0.07, CHD, c(0, 0.43, 0))
		k.b(pad, "Groove", 0.07, 0.04, 1.52, CHD, c(0, 0.43, 0))
		k.b(pad, "Groove", 0.04, 0.87, 0.07, CHD, c(sd * 0.76, 0, 0))
		k.b(pad, "Groove", 0.04, 0.07, 1.52, CHD, c(sd * 0.76, 0, 0))
		k.b(pad, "Groove", 0.07, 0.87, 0.04, CHD, c(0, 0, -0.76))
		k.b(pad, "Groove", 1.52, 0.07, 0.04, CHD, c(0, 0, -0.76))
		k.b(a, "PadTrim", 1.45, 0.2, 1.45, PL, c(sd * 0.2, -0.2, 0))
		k.b(a, "UpperArm", 0.95, 0.9, 0.95, CH, c(sd * 0.3, -0.75, 0))
		k.b(a, "ArmBand", 1.05, 0.2, 1.05, PL, c(sd * 0.3, -1.25, 0))
		k.b(a, "Forearm", 1.35, 1.0, 1.35, CHL, c(sd * 0.35, -1.85, -0.05))
		k.b(a, "Cuff", 1.4, 0.2, 1.4, PL, c(sd * 0.35, -2.3, -0.05))
		local _, fist = k.b(a, "Fist", 1.6, 1.25, 1.5, CH, c(sd * 0.35, -2.95, -0.1))
		for f = 1, 4 do k.b(fist, "Finger", 0.34, 0.4, 0.2, CHD, c((f - 2.5) * 0.37, 0.2, -0.8)) end
		k.b(fist, "Knuckles", 1.62, 0.18, 1.52, PL, c(0, 0.5, 0))
	end

	local head = k.head(body, 1.05, 1.05, 1.0, CH, c(0, 1.55, -0.15), V3(0, -0.5, 0.1))
	k.b(head, "Brow", 1.1, 0.22, 0.3, CHD, c(0, 0.2, -0.45))
	k.b(head, "Mouth", 0.45, 0.06, 0.05, CHD, c(0, -0.3, -0.52))
	k.b(head, "CrownBand", 0.95, 0.22, 0.9, P, c(0, 0.6, 0.0))
	for i = -2, 2 do
		k.tri(head, "CrownSpike", 0.12, (i == 0) and 0.6 or 0.4, 0.32, P, c(i * 0.22, (i == 0) and 0.95 or 0.85, -0.45) * FACE)
	end
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.24, 0.05, -0.53, 0.26, 0.11, EY, sd * 0.2)
		k.spike(head, "Horn", 0.55, 0.22, HN, c(sd * 0.55, 0.3, -0.05) * ANG(0, 0, -sd * 1.0))
	end
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">SpeciesModelsCrystal</string><ProtectedString name="Source"><![CDATA[-- SpeciesModelsCrystal: hand-authored, reference-faithful models for the Crystal world
-- (Gemmy, Quartz Beetle, Glimmer Bat, Amethyst Eel). Prism Lion lives in SpeciesModels.
-- Location: ReplicatedStorage > Shared > SpeciesModelsCrystal (ModuleScript), merged into SpeciesModels.

local K = require(script.Parent.ModelKit)
local V3, CF, ANG, PI, MAT, C = K.V3, K.CF, K.ANG, K.PI, K.MAT, K.C
local FACE = ANG(0, PI / 2, 0)
local SIDES = { -1, 1 }

local M = {}

---------------------------------------------------------------- GEMMY (Common)
-- Little crystal shell-crab: lavender face frame around a dark visor with glowing slit eyes, a
-- lavender brow plate with a purple gem, faceted purple shell chunks (top and sides lift on the
-- jump), four stubby dark-purple feet.
function M.Gemmy(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PU, PUL, LV, DP, EY = C("#A66CF0"), C("#B987F5"), C("#DCCDF8"), C("#6A36C2"), C("#F0E8FF")
	local BY = 1.2
	local body = k.body(1.6, 1.2, 1.5, DP, BY)
	k.b(body, "FaceFrame", 1.75, 0.72, 0.3, LV, c(0, -0.22, -0.72))
	k.b(body, "FaceHole", 1.05, 0.42, 0.1, DP, c(0, -0.2, -0.88))
	k.b(body, "Brow", 0.95, 0.85, 0.3, LV, c(0, 0.55, -0.7))
	k.tri(body, "BrowPeak", 0.3, 0.4, 0.95, LV, c(0, 1.17, -0.7) * FACE)
	k.diamond(body, "Gem", 0.6, 0.4, 0.12, PU, c(0, 0.6, -0.87), MAT.Glass)
	for _, sd in ipairs(SIDES) do
		k.eye(body, sd * 0.27, -0.2, -0.94, 0.28, 0.12, EY, 0)
		k.w(body, "Cheek", 0.3, 0.72, 0.5, LV, c(sd * 0.95, -0.22, -0.55) * ANG(0, -sd * PI / 2, 0))
	end

	local top = k.opener(body, "ShellTop", c(0, 0.6, 0.6), V3(1, 0, 0), 0.25)
	k.b(top, "ShellTopBlock", 1.55, 0.9, 1.45, PU, c(0, 0.45, -0.45) * ANG(0.25, 0, 0))
	for _, sd in ipairs(SIDES) do
		local sp = k.opener(body, "ShellSide", c(sd * 0.6, 0.3, 0), V3(0, 0, 1), sd * 0.3)
		k.b(sp, "ShellSideBlock", 0.95, 1.3, 1.45, PUL, c(sd * 0.35, 0.05, 0.1) * ANG(0, 0, -sd * 0.3))
		k.b(sp, "ShellSideLow", 0.7, 0.6, 1.2, PU, c(sd * 0.45, -0.55, 0.15) * ANG(0, 0, sd * 0.2))
	end
	k.b(body, "ShellBack", 1.4, 1.1, 0.6, PU, c(0, 0.3, 0.75) * ANG(-0.3, 0, 0))

	local lg = { up = { 0.45, 0.25, 0.45 }, col = LV, w2 = 0.42, d2 = 0.45, col2 = DP, paw = { 0.6, 0.25, 0.65 }, pawCol = DP }
	k.leg(body, "LegFL", BY, -0.55, -0.5, -0.4, lg)
	k.leg(body, "LegFR", BY, 0.55, -0.5, -0.4, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.55, -0.5, 0.45, lg)
	k.leg(body, "LegBR", BY, 0.55, -0.5, 0.45, lg)
	rig.legKind = "quad"
end

---------------------------------------------------------------- QUARTZ BEETLE (Uncommon)
-- White-grey stone beetle: wing cases with cyan crystal inlays that swing open on the power move,
-- navy centre ridge topped with a cluster of glowing quartz, navy face band with cyan eyes and
-- mandibles, two jointed antennae with flat navy tips, six splayed legs with navy feet.
function M.QuartzBeetle(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local G, GD, GL, N, CY, EY = C("#E3E6EB"), C("#C7CCD4"), C("#F2F4F7"), C("#394257"), C("#8EDBFF"), C("#6FE4FF")
	local BY = 1.25
	local body = k.body(1.6, 0.75, 2.3, N, BY)
	for _, sd in ipairs(SIDES) do
		local half = k.opener(body, "CaseHinge", c(sd * 0.15, 0.35, 0.2), V3(0, 0, 1), sd * 0.9)
		k.b(half, "Case", 0.95, 0.75, 2.35, G, c(sd * 0.55, 0.3, 0.05))
		k.w(half, "CaseEdge", 2.35, 0.55, 0.4, GD, c(sd * 1.22, 0.0, 0.05) * ANG(0, -sd * PI / 2, 0))
		k.w(half, "CaseFront", 0.95, 0.5, 0.55, GL, c(sd * 0.55, 0.35, -1.45))
		k.b(half, "CaseTop", 0.7, 0.2, 1.4, GL, c(sd * 0.55, 0.75, 0.2))
		k.diamond(half, "Inlay", 0.9, 0.5, 0.1, CY, c(sd * 1.04, 0.3, 0.2) * ANG(0, -sd * PI / 2, 0) * ANG(0, 0, 0.9), MAT.Glass)
	end
	k.b(body, "Ridge", 0.32, 0.9, 1.3, N, c(0, 0.55, -0.35))
	for i, d in ipairs({ { 0, 1.1, 0.42 }, { -0.25, 0.75, 0.3 }, { 0.25, 0.8, 0.3 }, { 0.1, 0.6, 0.25 } }) do
		k.crystal(body, "Quartz", d[2], d[3], CY, c(d[1], 0.95, -0.3 + i * 0.12) * ANG(0, 0, -d[1]), MAT.Glass, 0.1)
	end

	local head = k.head(body, 1.0, 0.7, 0.75, G, c(0, -0.05, -1.45), V3(0, 0, 0.3))
	k.b(head, "FaceBand", 1.02, 0.28, 0.1, N, c(0, 0.0, -0.4))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.25, 0.0, -0.46, 0.22, 0.12, EY, 0)
		k.b(head, "Mandible", 0.22, 0.22, 0.35, N, c(sd * 0.32, -0.35, -0.38))
		local ant = k.ear(head, sd, c(sd * 0.3, 0.3, -0.1), "antenna")
		local p1, p2, p3 = V3(0, 0, 0), V3(sd * 0.35, 0.75, -0.15), V3(sd * 0.55, 1.45, -0.05)
		k.bar(ant, "AntennaSeg", p1, p2, 0.2, G, nil, nil, V3(1, 0, 0))
		k.b(ant, "AntennaJoint", 0.25, 0.25, 0.25, N, c(p2.X, p2.Y, p2.Z))
		k.bar(ant, "AntennaSeg", p2, p3, 0.18, G, nil, nil, V3(1, 0, 0))
		k.b(ant, "AntennaTip", 0.5, 0.2, 0.3, N, c(p3.X + sd * 0.15, p3.Y, p3.Z - 0.1) * ANG(0, 0, sd * 0.3))
	end

	local lg = { up = { 0.32, 0.45, 0.4 }, col = G, w2 = 0.3, d2 = 0.36, col2 = GD, paw = { 0.42, 0.25, 0.5 }, pawCol = N, splay = 0.55 }
	for _, z in ipairs({ -0.75, 0.05, 0.8 }) do
		k.leg(body, "LegL", BY, -0.7, -0.3, z, lg)
		k.leg(body, "LegR", BY, 0.7, -0.3, z, lg)
	end
	rig.legKind = "bug6"
end

---------------------------------------------------------------- GLIMMER BAT (Rare)
-- Dark-purple bat: lavender chest chevron, big head with lavender crest stripe, pig snout, glowing
-- pink eyes, huge pointed ears with pink insides, small hanging feet with pink claws, wide wings with
-- purple bones, lavender leading edge and pink membranes.
function M.GlimmerBat(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PU, PUD, LV, PK, EY = C("#5E2E8A"), C("#4A2270"), C("#A57BEA"), C("#F4ACE2"), C("#FFB8F2")
	local BY = 2.3
	local body = k.body(1.0, 1.15, 0.9, PU, BY)
	for _, sd in ipairs(SIDES) do
		k.b(body, "Chevron", 0.5, 0.16, 0.1, LV, c(sd * 0.2, -0.05, -0.47) * ANG(0, 0, sd * 0.5))
	end
	local head = k.head(body, 1.05, 0.9, 0.9, PU, c(0, 1.0, -0.05), V3(0, -0.4, 0.1))
	k.b(head, "Crest", 0.3, 0.3, 0.95, LV, c(0, 0.5, 0.0))
	k.b(head, "Snout", 0.55, 0.35, 0.3, PUD, c(0, -0.2, -0.55))
	for _, sd in ipairs(SIDES) do
		k.b(head, "Nostril", 0.1, 0.1, 0.04, C("#2A1240"), c(sd * 0.12, -0.18, -0.71))
		k.b(head, "Brow", 0.38, 0.14, 0.15, PUD, c(sd * 0.24, 0.17, -0.47) * ANG(0, 0, sd * 0.35))
		k.eye(head, sd * 0.24, 0.05, -0.47, 0.24, 0.12, EY, sd * 0.35)
		local ear = k.ear(head, sd, c(sd * 0.35, 0.45, 0.05) * ANG(0, 0, -sd * 0.2))
		k.tri(ear, "Ear", 0.16, 1.3, 0.75, PU, c(0, 0.65, 0) * FACE)
		k.tri(ear, "EarInner", 0.06, 0.95, 0.45, PK, c(0, 0.55, -0.1) * FACE)
	end

	local lg = { up = { 0.3, 0.3, 0.32 }, col = PU, w2 = 0.24, d2 = 0.26, paw = { 0.35, 0.18, 0.35 }, pawCol = PU, toes = 2, toeCol = PK, lh = 0.3 }
	k.leg(body, "LegL", BY, -0.25, -0.55, 0.05, lg)
	k.leg(body, "LegR", BY, 0.25, -0.55, 0.05, lg)
	rig.legKind = "biped"

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.45, 0.35, 0.05))
		k.batWing(w, sd, { wrist = Vector2.new(1.4, 1.1), bone = PU, mem = PK, boneW = 0.28, cap = LV,
			tips = { Vector2.new(3.4, 0.5), Vector2.new(3.0, -0.7), Vector2.new(2.0, -1.2), Vector2.new(0.9, -1.0) } })
	end
end

---------------------------------------------------------------- AMETHYST EEL (Epic)
-- Purple crystal eel: blocky head with a lavender brow stripe, gaping lavender jaw, glowing pink
-- slit eyes, eight-segment undulating body with a lavender belly and glowing pink side lines,
-- translucent pink crystal fins along the back, lavender pectoral fins, crystal fan tail fin.
function M.AmethystEel(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PU, PUD, LV, PK, GL = C("#9B4DFF"), C("#7E36DE"), C("#F0D6FF"), C("#FF7AE6"), C("#FF5FD6")
	local BY = 1.5
	local body = k.body(1.15, 1.0, 1.3, PU, BY)
	rig.legKind = "none"
	k.b(body, "Throat", 1.0, 0.3, 1.25, LV, c(0, -0.45, 0))

	local head = k.head(body, 1.3, 0.75, 1.5, PU, c(0, 0.15, -1.25), V3(0, -0.1, 0.55))
	k.b(head, "Brow", 0.5, 0.12, 1.2, LV, c(0, 0.42, -0.05))
	k.b(head, "Mouth", 1.0, 0.15, 1.0, C("#3A1060"), c(0, -0.38, -0.35))
	local jaw = k.jb(head, "Jaw", 1.1, 0.35, 1.3, LV, c(0, -0.62, -0.25), V3(0, 0.1, 0.55))
	H.group(rig, "jaws", jaw)
	k.tri(head, "HeadFin", 0.14, 0.9, 0.6, PK, c(0, 0.75, 0.3) * ANG(0.5, 0, 0), MAT.Glass, 0.2)
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.4, 0.12, -0.76, 0.32, 0.12, GL, sd * 0.3)
		k.b(head, "Cheek", 0.15, 0.5, 0.8, PUD, c(sd * 0.65, -0.05, 0.1))
	end

	local pitches = { 0.12, 0.2, -0.05, -0.3, -0.3, 0.05, 0.25, 0.2 }
	local segs = {}
	for j = 1, 8 do
		local w = 1.05 - j * 0.075
		table.insert(segs, { w, w * 0.9, 0.7, (j % 2 == 0) and PUD or PU, pitches[j] })
	end
	local spine = k.chain(body, c(0, 0, 0.55), segs, { name = "Spine", kind = "spine", i = 1, amp = 0.3, freq = 2.0, lag = 0.65 })
	for j, p in ipairs(spine.parts) do
		local w = 1.05 - j * 0.075
		k.b(p, "Belly", w * 0.85, w * 0.35, 0.72, LV, c(0, -w * 0.35, 0))
		for _, sd in ipairs(SIDES) do
			local _, g = k.b(p, "GlowLine", 0.05, 0.1, 0.45, GL, c(sd * w * 0.5, w * 0.05, 0), MAT.Neon)
			k.glow(g, GL)
		end
		if j <= 6 then
			local fh = 1.2 - j * 0.13
			k.tri(p, "CrystalFin", 0.14, fh, 0.65, PK, c(0, w * 0.45 + fh * 0.45, 0.05) * ANG(0.45, 0, 0), MAT.Glass, 0.2)
		end
	end
	local last = spine.parts[#spine.parts]
	for _, a in ipairs({ -0.75, -0.25, 0.25, 0.75 }) do
		local L = 1.3 - math.abs(a) * 0.4
		k.tri(last, "TailFin", 0.12, L, 0.5, PK, c(0, math.sin(a) * L * 0.5, 0.3 + math.cos(a) * L * 0.5) * ANG(PI / 2 - a, 0, 0), MAT.Glass, 0.25)
	end

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.55, -0.25, 0.1) * ANG(0, -sd * 0.6, 0))
		k.featherWing(w, sd, { root = 0.05, thick = 0.1, feathers = {
			{ -0.3, 1.3, 0.32, LV, PK }, { -0.6, 1.1, 0.3, LV, PK }, { -0.9, 0.9, 0.28, LV, PK } } })
	end
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">SpeciesModelsDivine</string><ProtectedString name="Source"><![CDATA[-- SpeciesModelsDivine: hand-authored, reference-faithful models for the Divine portal creatures
-- (Solaris, Aetherion, Eternity Owl, Genesis, Infinity Fox).
-- Location: ReplicatedStorage > Shared > SpeciesModelsDivine (ModuleScript), merged into SpeciesModels.

local K = require(script.Parent.ModelKit)
local V3, CF, ANG, PI, MAT, C = K.V3, K.CF, K.ANG, K.PI, K.MAT, K.C
local FACE, DOWN = ANG(0, PI / 2, 0), ANG(0, 0, PI)
local FLAT = ANG(PI / 2, 0, 0) -- turns an XY-plane ring into a horizontal (XZ) ring
local SIDES = { -1, 1 }

local M = {}

-- horizontal halo that floats and turns above `parent` (rig.halos)
local function halo(k, parent, cf, radius, count, col, col2)
	local e, p = k.pv(parent, "HaloPivot", cf)
	table.insert(k.rig.halos, e)
	k.ring(p, "Halo", FLAT, radius, count, 0.16, radius * 6.3 / count + 0.02, 0.16, col)
	if col2 then
		for i = 0, 3 do
			local a = i * PI / 2
			k.b(p, "HaloInset", 0.2, 0.18, 0.4, col2, k.c(math.cos(a) * radius, 0, math.sin(a) * radius) * ANG(0, -a, 0))
		end
	end
	return p, e
end

---------------------------------------------------------------- SOLARIS (Divine)
-- Floating sun knight: gold helmet with a white crown and an orange crystal, glowing visor eyes,
-- white-and-gold chest plate with an orange diamond, a long white shield-skirt with an orange stripe
-- tapering to a point, gold shoulder blocks, layered white/gold/orange wings, a ring of gold and orange
-- sun shards turning behind it, and a gold halo.
function M.Solaris(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local Y, YD, W, O, EY = C("#FFD02E"), C("#F2B81E"), C("#FAF7EC"), C("#FF9A1E"), C("#FFE45C")
	local BY = 2.3
	local body = k.body(1.3, 1.0, 0.9, Y, BY)
	rig.legKind = "none"
	k.tri(body, "ChestV", 0.14, 0.9, 1.3, W, c(0, 0.05, -0.47) * DOWN * FACE)
	k.b(body, "GemFrame", 0.55, 0.55, 0.1, W, c(0, 0.0, -0.55) * ANG(0, 0, PI / 4))
	k.diamond(body, "ChestGem", 0.6, 0.4, 0.14, O, c(0, 0.0, -0.6), MAT.Glass)
	-- shield skirt
	for i = 0, 2 do
		k.b(body, "Skirt", 0.95 - i * 0.18, 0.5, 0.6, W, c(0, -0.75 - i * 0.48, 0))
		k.b(body, "SkirtStripe", 0.3 - i * 0.04, 0.5, 0.62, O, c(0, -0.75 - i * 0.48, 0))
	end
	k.tri(body, "SkirtTip", 0.5, 0.7, 0.45, Y, c(0, -2.25, 0) * DOWN * FACE)
	for _, sd in ipairs(SIDES) do
		k.b(body, "Shoulder", 0.55, 0.6, 0.7, YD, c(sd * 0.8, 0.25, 0))
	end

	local head = k.head(body, 0.8, 0.75, 0.75, Y, c(0, 0.95, 0), V3(0, -0.35, 0.1))
	k.b(head, "Visor", 0.6, 0.25, 0.06, YD, c(0, 0.0, -0.39))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.15, 0.0, -0.42, 0.16, 0.08, EY, sd * 0.3)
		k.tri(head, "CrownSpike", 0.12, 0.45, 0.25, W, c(sd * 0.28, 0.55, -0.15) * FACE)
	end
	k.b(head, "CrownBand", 0.85, 0.2, 0.8, W, c(0, 0.38, 0))
	k.crystal(head, "CrownCrystal", 0.6, 0.22, O, c(0, 0.45, -0.3), MAT.Glass, 0.05)
	halo(k, head, c(0, 1.25, 0), 0.9, 14, Y, W)

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.8, 0.3, 0.2))
		k.featherWing(w, sd, { root = 0.2, z = 0.05, thick = 0.16, feathers = {
			{ 0.45, 2.8, 0.5, W, Y }, { 0.25, 3.0, 0.5, Y, O }, { 0.05, 2.9, 0.5, W, Y }, { -0.15, 2.6, 0.48, Y, O }, { -0.35, 2.2, 0.45, W, W } } })
		k.featherWing(w, sd, { root = 0.1, z = -0.06, thick = 0.18, feathers = {
			{ 0.35, 1.6, 0.42, O, O }, { 0.1, 1.7, 0.42, O, Y }, { -0.15, 1.5, 0.4, O, O } } })
	end
	local re, rp = k.pv(body, "SunRays", c(0, -0.2, 0.35))
	H.group(rig, "rays", re)
	for i = 0, 9 do
		local a = (i + 0.5) / 10 * PI * 2
		local L = (i % 2 == 0) and 1.3 or 0.9
		k.tri(rp, "SunShard", 0.14, L, 0.35, (i % 2 == 0) and Y or O, CF(math.cos(a) * 1.9 * s, math.sin(a) * 1.9 * s, 0) * ANG(0, 0, a - PI / 2) * FACE)
	end
end

---------------------------------------------------------------- AETHERION (Divine)
-- Celestial dragon: white armoured body with gold trim and a big cyan crystal in a gold chest frame,
-- legs with cyan bands and gold claws, long white neck with a cyan line, white head with swept gold
-- horns and a cyan crest, a spiked gold halo, enormous feathered wings (gold arm, white and cyan
-- blades), a long white tail with gold bands and cyan crystal spines ending in a gold-and-crystal arrow.
function M.Aetherion(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local W, WD, GO, CY, EY = C("#F7F8FA"), C("#E2E6EC"), C("#F2C230"), C("#8FE8F2"), C("#FFE45C")
	local BY = 2.3
	local body = k.body(1.7, 1.45, 2.4, W, BY)
	k.b(body, "ChestFrame", 1.05, 1.05, 0.12, GO, c(0, 0.05, -1.24) * ANG(0, 0, PI / 4))
	k.diamond(body, "ChestCrystal", 1.0, 0.6, 0.16, CY, c(0, 0.05, -1.3), MAT.Glass)
	for _, sd in ipairs(SIDES) do
		k.b(body, "GoldTrim", 0.1, 0.16, 2.0, GO, c(sd * 0.86, 0.45, 0.1))
	end

	local lf = { up = { 0.8, 0.75, 0.9 }, col = W, w2 = 0.66, d2 = 0.72, band = CY, paw = { 0.92, 0.35, 1.05 }, pawCol = W, toes = 3, toeCol = GO }
	k.leg(body, "LegFL", BY, -0.72, -0.5, -0.8, lf)
	k.leg(body, "LegFR", BY, 0.72, -0.5, -0.8, lf)
	lf.hind = true
	k.leg(body, "LegBL", BY, -0.74, -0.45, 0.85, lf)
	k.leg(body, "LegBR", BY, 0.74, -0.45, 0.85, lf)
	rig.legKind = "quad"

	for i = 0, 2 do
		local _, n = k.b(body, "Neck", 0.75 - i * 0.05, 0.75, 0.7, W, c(0, 0.8 + i * 0.6, -1.3 - i * 0.18) * ANG(-0.3, 0, 0))
		k.b(n, "NeckLine", 0.12, 0.76, 0.72, CY, c(0, 0, -0.02))
		k.tri(n, "NeckSpine", 0.1, 0.4, 0.35, GO, c(0, 0.1, 0.45) * ANG(0.9, 0, 0))
	end
	local head = k.head(body, 0.9, 0.7, 1.1, W, c(0, 2.45, -1.95), V3(0, -0.25, 0.4))
	k.w(head, "Snout", 0.62, 0.42, 0.6, W, c(0, -0.1, -0.8))
	k.b(head, "Brow", 0.95, 0.16, 0.5, GO, c(0, 0.35, -0.3))
	k.crystal(head, "Crest", 0.6, 0.2, CY, c(0, 0.4, 0.15) * ANG(0.7, 0, 0), MAT.Glass, 0.1)
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.26, 0.1, -0.56, 0.22, 0.09, EY, sd * 0.3)
		k.spike(head, "Horn", 1.1, 0.26, GO, c(sd * 0.3, 0.35, 0.25) * ANG(1.1, 0, -sd * 0.35))
		k.spike(head, "HornSmall", 0.6, 0.2, GO, c(sd * 0.45, 0.05, 0.35) * ANG(1.3, 0, -sd * 0.8))
	end
	local hp = halo(k, head, c(0, 1.35, 0.2), 0.75, 12, GO)
	for i = 0, 3 do
		local a = i * PI / 2
		k.spike(hp, "HaloSpike", 0.45, 0.14, GO, k.c(math.cos(a) * 0.75, 0.05, math.sin(a) * 0.75))
	end

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.75, 0.6, -0.2))
		k.bar(w, "WingArm", V3(0, 0, 0), V3(sd * 1.4, 2.0, 0), 0.4, GO)
		k.bar(w, "WingArm", V3(sd * 1.4, 2.0, 0), V3(sd * 3.6, 2.6, 0), 0.34, GO)
		local fe, fp = k.pv(w, "FeatherRoot", c(sd * 1.4, 2.0, 0.05))
		local fw = {}
		for i = 0, 7 do
			table.insert(fw, { 0.55 - i * 0.24, 3.0 - math.abs(i - 2) * 0.18, 0.4, (i % 2 == 0) and W or CY })
		end
		k.featherWing(fp, sd, { root = 0.1, z = 0.04, feathers = fw })
	end

	local segs = {}
	for j = 1, 9 do
		local w = 0.75 - j * 0.05
		table.insert(segs, { w, w * 0.85, 0.6, W, j == 1 and 0.3 or -0.04 })
	end
	local rec = k.chain(body, c(0, 0.1, 1.15), segs, { name = "Tail", kind = "spine", i = 1, amp = 0.14, freq = 1.2, lag = 0.55 })
	for j, p in ipairs(rec.parts) do
		local w = 0.75 - j * 0.05
		if j % 2 == 0 then k.b(p, "TailBand", w + 0.06, w * 0.9, 0.16, GO, c(0, 0, 0)) end
		if j % 2 == 1 and j < 9 then k.crystal(p, "TailCrystal", 0.55, 0.15, CY, c(0, w * 0.42, 0) * ANG(0.4, 0, 0), MAT.Glass, 0.15) end
	end
	local last = rec.parts[#rec.parts]
	local tipRot = ANG(0, PI / 2, 0) * ANG(0, 0, PI / 2)
	k.tri(last, "Arrow", 0.14, 0.7, 0.9, GO, c(0, 0, 0.6) * tipRot)
	k.crystal(last, "ArrowCrystal", 0.8, 0.28, CY, c(0, 0, 0.7) * ANG(PI / 2, 0, 0), MAT.Glass, 0.1)
end

---------------------------------------------------------------- ETERNITY OWL (Divine)
-- Cosmic guardian owl: deep-purple body with pale-gold V armour, glowing cyan lines and a cyan chest
-- gem, gold talons, purple head with a gold face mask and beak, glowing cyan eyes, ear tufts, an
-- octagonal gold time-ring with four cyan gems (plus an inner ring) turning behind the head, raised
-- wings with purple arm panels, cyan glow stripes, gold wrist gems and a fan of pale-gold feathers.
function M.EternityOwl(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PU, PUL, GO, GOD, CY, EY = C("#3E1F6E"), C("#55308E"), C("#F0D890"), C("#D8BE72"), C("#6FF2E8"), C("#6FF2E8")
	local BY = 2.1
	local body = k.body(1.5, 1.6, 1.3, PU, BY)
	k.tri(body, "ArmorV", 0.14, 1.2, 1.4, GO, c(0, 0.0, -0.68) * DOWN * FACE)
	k.diamond(body, "ChestGem", 0.45, 0.32, 0.1, CY, c(0, 0.15, -0.77), MAT.Glass)
	local _, ln = k.b(body, "GlowLine", 0.08, 0.6, 0.06, CY, c(0, -0.35, -0.76), MAT.Neon)
	k.glow(ln, CY)
	for _, sd in ipairs(SIDES) do
		local _, l2 = k.bar(body, "GlowLine", V3(sd * 0.76, 0.4, -0.2), V3(sd * 0.76, -0.4, 0.3), 0.07, CY, MAT.Neon, nil, V3(1, 0, 0))
		k.glow(l2, CY)
	end
	local lg = { up = { 0.5, 0.4, 0.55 }, col = PU, w2 = 0.4, d2 = 0.45, paw = { 0.65, 0.25, 0.7 }, pawCol = GO, toes = 3, toeCol = GO }
	k.leg(body, "LegL", BY, -0.4, -0.8, 0, lg)
	k.leg(body, "LegR", BY, 0.4, -0.8, 0, lg)
	rig.legKind = "biped"

	local head = k.head(body, 1.1, 1.0, 1.0, PU, c(0, 1.25, -0.1), V3(0, -0.45, 0.2))
	k.tri(head, "FaceMask", 0.12, 0.8, 1.0, GO, c(0, 0.0, -0.53) * DOWN * FACE)
	k.w(head, "Beak", 0.26, 0.4, 0.3, GOD, c(0, -0.2, -0.68) * DOWN)
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.24, 0.12, -0.6, 0.24, 0.1, EY, sd * 0.35)
		local ear = k.ear(head, sd, c(sd * 0.4, 0.45, 0) * ANG(0, 0, -sd * 0.25))
		k.tri(ear, "Tuft", 0.2, 0.55, 0.5, PU, c(0, 0.27, 0) * FACE)
		k.tri(ear, "TuftGold", 0.07, 0.38, 0.28, GO, c(0, 0.22, -0.1) * FACE)
	end
	local re, rp = k.pv(head, "TimeRing", c(0, 0.45, 0.65))
	H.group(rig, "rays", re)
	k.ring(rp, "Ring", CF(), 1.5, 8, 0.16, 1.18, 0.14, GO)
	k.ring(rp, "InnerRing", CF(), 1.05, 10, 0.1, 0.6, 0.1, GOD)
	for i = 0, 3 do
		local a = i * PI / 2 + PI / 2
		k.b(rp, "RingGemFrame", 0.4, 0.4, 0.16, GO, k.c(math.cos(a) * 1.5, math.sin(a) * 1.5, 0))
		local _, g = k.b(rp, "RingGem", 0.24, 0.24, 0.18, CY, k.c(math.cos(a) * 1.5, math.sin(a) * 1.5, -0.02), MAT.Neon)
		k.glow(g, CY)
	end

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.7, 0.4, 0.1))
		k.bar(w, "WingArm", V3(0, 0, 0), V3(sd * 1.0, 1.6, 0), 0.55, PU)
		k.bar(w, "WingArm", V3(sd * 1.0, 1.6, 0), V3(sd * 2.0, 2.4, 0), 0.45, PUL)
		local _, st = k.bar(w, "WingGlow", V3(sd * 0.3, 0.6, -0.3), V3(sd * 1.5, 1.95, -0.25), 0.08, CY, MAT.Neon)
		k.glow(st, CY)
		k.b(w, "WristGemFrame", 0.45, 0.45, 0.2, GO, c(sd * 0.3, 0.35, -0.2))
		local _, wg = k.b(w, "WristGem", 0.24, 0.24, 0.22, CY, c(sd * 0.3, 0.35, -0.22), MAT.Neon)
		k.glow(wg, CY)
		local fw = {}
		for i = 0, 7 do table.insert(fw, { 1.1 - i * 0.26, 2.3 - math.abs(i - 2) * 0.14, 0.38, (i % 3 == 2) and GOD or GO }) end
		k.featherWing(w, sd, { root = 0.4, z = 0.05, feathers = fw })
	end
	local te, tp = k.pv(body, "TailRoot", c(0, -0.5, 0.6) * ANG(1.1, 0, 0))
	table.insert(rig.tail, te)
	for i, a in ipairs({ -0.4, -0.13, 0.13, 0.4 }) do
		k.tri(tp, "TailFeather", 0.1, 1.4, 0.4, (i % 2 == 0) and GO or PU, ANG(0, 0, a) * c(0, 0.65, 0) * FACE)
	end
end

---------------------------------------------------------------- GENESIS (Divine)
-- Creator dragon: white armoured body with gold trim and a cyan chest gem, gold-clawed legs, spiky
-- white mane, white head with a long gold unicorn horn and swept gold horns, a horizontal gold halo,
-- a gold arc behind with crystal shards and a crystal floating above, a crystal orb in a broken gold
-- ring floating at its claw, angular wings (white bones, gold edges, translucent cyan panels), a
-- spiked white tail with a gold ring and a cyan crystal tip.
function M.Genesis(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local W, WD, GO, CY, EY = C("#F5F3F6"), C("#E2DEE6"), C("#F0C43A"), C("#9FEFF5"), C("#3FD8E8")
	local BY = 2.3
	local body = k.body(1.7, 1.5, 2.3, W, BY)
	k.b(body, "ChestFrame", 0.75, 0.75, 0.12, GO, c(0, 0.15, -1.2) * ANG(0, 0, PI / 4))
	k.diamond(body, "ChestGem", 0.8, 0.5, 0.16, CY, c(0, 0.15, -1.26), MAT.Glass)
	for _, sd in ipairs(SIDES) do
		k.b(body, "ShoulderFrame", 0.12, 0.8, 0.8, GO, c(sd * 0.86, 0.15, -0.6))
		k.b(body, "ShoulderPlate", 0.1, 0.6, 0.6, W, c(sd * 0.92, 0.15, -0.6))
	end
	for i = 0, 4 do
		k.tri(body, "BackSpike", 0.12, 0.55, 0.45, GO, c(0, 0.85, -0.8 + i * 0.45) * ANG(0.5, 0, 0))
	end

	local lf = { up = { 0.8, 0.75, 0.9 }, col = W, w2 = 0.66, d2 = 0.72, band = GO, paw = { 0.92, 0.35, 1.05 }, pawCol = W, toes = 3, toeCol = GO }
	k.leg(body, "LegFL", BY, -0.72, -0.5, -0.8, lf)
	k.leg(body, "LegFR", BY, 0.72, -0.5, -0.8, lf)
	lf.hind = true
	k.leg(body, "LegBL", BY, -0.74, -0.45, 0.85, lf)
	k.leg(body, "LegBR", BY, 0.74, -0.45, 0.85, lf)
	rig.legKind = "quad"

	-- crystal orb in a broken gold ring, floating at the front claw
	local oe, op = k.pv(body, "Orb", c(0.95, 0.6, -1.7))
	H.group(rig, "palmCrystal", oe)
	k.crystal(op, "OrbCrystal", 0.6, 0.28, CY, k.c(0, -0.3, 0), MAT.Glass, 0.1)
	k.ring(op, "OrbRing", CF(), 0.5, 8, 0.1, 0.25, 0.1, GO)

	k.b(body, "Neck", 0.75, 1.2, 0.75, W, c(0, 0.95, -1.3) * ANG(-0.35, 0, 0))
	for i = 0, 3 do
		local sd = (i % 2 == 0) and -1 or 1
		k.tri(body, "Mane", 0.12, 0.8, 0.45, (i < 2) and W or WD, c(sd * 0.4, 1.3 - i * 0.2, -1.2) * ANG(0.4, 0, -sd * 1.0))
	end
	local head = k.head(body, 0.9, 0.75, 1.1, W, c(0, 1.85, -1.75), V3(0, -0.3, 0.4))
	k.w(head, "Snout", 0.62, 0.42, 0.6, W, c(0, -0.12, -0.8))
	k.spike(head, "UnicornHorn", 1.8, 0.3, GO, c(0, 0.35, -0.35) * ANG(-0.55, 0, 0))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.26, 0.1, -0.56, 0.22, 0.09, EY, sd * 0.3)
		k.spike(head, "Horn", 1.0, 0.24, GO, c(sd * 0.32, 0.35, 0.25) * ANG(1.1, 0, -sd * 0.4))
		k.tri(head, "Frill", 0.1, 0.6, 0.4, W, c(sd * 0.5, 0.0, 0.25) * ANG(0.6, 0, -sd * 1.2))
	end
	halo(k, head, c(0, 1.0, 0.1), 0.8, 12, GO)
	local ae, ap = k.pv(head, "Arc", c(0, 0.6, 0.8))
	H.group(rig, "rays", ae)
	for i = 0, 6 do
		local a = PI * 0.15 + i / 6 * PI * 0.7
		k.b(ap, "ArcSeg", 0.18, 0.5, 0.16, GO, k.c(math.cos(a) * 1.5, math.sin(a) * 1.5, 0) * ANG(0, 0, a))
		if i % 3 == 0 then k.crystal(ap, "ArcShard", 0.45, 0.16, CY, k.c(math.cos(a) * 1.75, math.sin(a) * 1.75, 0) * ANG(0, 0, a - PI / 2), MAT.Glass, 0.1) end
	end
	k.crystal(head, "FloatingCrystal", 0.7, 0.24, CY, c(0, 1.5, 0.1), MAT.Glass, 0.1)

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.75, 0.6, -0.2))
		k.batWing(w, sd, { wrist = Vector2.new(1.6, 2.2), bone = W, mem = CY, memMat = MAT.Glass, memTr = 0.3, boneW = 0.36, cap = GO,
			tips = { Vector2.new(4.2, 1.6), Vector2.new(3.8, 0.2), Vector2.new(2.8, -0.7), Vector2.new(1.4, -0.8) } })
		k.bar(w, "WingEdge", V3(sd * 1.6, 2.2, -0.08), V3(sd * 4.2, 1.6, -0.08), 0.18, GO)
	end

	local segs = {}
	for j = 1, 9 do
		local w = 0.7 - j * 0.045
		table.insert(segs, { w, w * 0.85, 0.55, (j % 2 == 0) and WD or W, j == 1 and 0.35 or -0.06 })
	end
	local rec = k.chain(body, c(0, 0.1, 1.1), segs, { name = "Tail", kind = "spine", i = 1, amp = 0.15, freq = 1.2, lag = 0.55 })
	for j, p in ipairs(rec.parts) do
		local w = 0.7 - j * 0.045
		k.tri(p, "TailSpike", 0.1, 0.35, 0.3, GO, c(0, w * 0.42 + 0.14, 0) * ANG(0.4, 0, 0))
	end
	local last = rec.parts[#rec.parts]
	k.ring(last, "TailRing", k.c(0, 0, 0.1), 0.45, 8, 0.1, 0.36, 0.1, GO)
	k.crystal(last, "TailCrystal", 0.9, 0.3, CY, c(0, 0, 0.3) * ANG(PI / 2, 0, 0), MAT.Glass, 0.1)
end

---------------------------------------------------------------- INFINITY FOX (Divine)
-- Void fox spirit: dark-purple body with pink stripe plates and cyan diamond gems, slim legs with pink
-- bands, fox head with tall pink-lined ears, a cyan forehead gem and glowing cyan eyes, angular wings
-- (purple blades with pink and cyan glow stripes), a double pink halo with a floating diamond, and nine
-- segmented tails fanning out behind it (purple/pink links ending in diamond tips with cyan cores).
function M.Infinity(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PU, PUL, PK, PKL, CY, EY = C("#3A1F5E"), C("#5A3290"), C("#F27AC8"), C("#F5A8DC"), C("#7FF0F5"), C("#7FF0F5")
	local BY = 2.1
	local body = k.body(1.0, 1.0, 1.8, PU, BY)
	for _, sd in ipairs(SIDES) do
		k.b(body, "Stripe", 0.06, 0.2, 1.5, PK, c(sd * 0.51, 0.25, 0))
		k.diamond(body, "HipGem", 0.55, 0.32, 0.08, CY, c(sd * 0.54, -0.05, 0.5) * ANG(0, -sd * PI / 2, 0), MAT.Glass)
		k.diamond(body, "ShoulderGem", 0.45, 0.28, 0.08, CY, c(sd * 0.54, -0.05, -0.5) * ANG(0, -sd * PI / 2, 0), MAT.Glass)
	end
	k.b(body, "Collar", 1.05, 0.3, 0.3, PK, c(0, 0.4, -0.85))

	local lg = { up = { 0.4, 0.8, 0.48 }, col = PU, w2 = 0.32, d2 = 0.4, band = PK, paw = { 0.4, 0.34, 0.48 }, pawCol = PUL }
	k.leg(body, "LegFL", BY, -0.3, -0.4, -0.7, lg)
	k.leg(body, "LegFR", BY, 0.3, -0.4, -0.7, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.3, -0.4, 0.7, lg)
	k.leg(body, "LegBR", BY, 0.3, -0.4, 0.7, lg)
	rig.legKind = "quad"

	k.b(body, "Neck", 0.55, 0.9, 0.6, PU, c(0, 0.7, -0.9) * ANG(-0.35, 0, 0))
	local head = k.head(body, 0.75, 0.7, 0.85, PU, c(0, 1.3, -1.25), V3(0, -0.3, 0.3))
	k.w(head, "Snout", 0.45, 0.34, 0.6, PUL, c(0, -0.15, -0.7))
	k.b(head, "Nose", 0.14, 0.1, 0.08, C("#1A0E2A"), c(0, -0.27, -0.97))
	k.diamond(head, "ForeheadGem", 0.28, 0.18, 0.06, CY, c(0, 0.2, -0.44), MAT.Glass)
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.2, 0.08, -0.44, 0.2, 0.09, EY, sd * 0.35)
		k.tri(head, "Cheek", 0.1, 0.5, 0.35, PKL, c(sd * 0.45, -0.15, 0.05) * ANG(0, 0, -sd * 1.4))
		local ear = k.ear(head, sd, c(sd * 0.24, 0.32, 0.1) * ANG(0, 0, -sd * 0.15))
		k.tri(ear, "Ear", 0.16, 0.9, 0.5, PU, c(0, 0.45, 0) * FACE)
		k.tri(ear, "EarInner", 0.06, 0.6, 0.28, PK, c(0, 0.36, -0.09) * FACE)
	end
	local hp = halo(k, head, c(0, 0.95, 0.2), 0.75, 10, PK)
	k.ring(hp, "HaloOuter", FLAT * CF(0, 0, -0.25 * s), 1.05, 12, 0.1, 0.5, 0.1, PKL)
	k.diamond(hp, "HaloDiamond", 0.55, 0.32, 0.1, CY, k.c(0, 0.55, -1.05), MAT.Glass)

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.45, 0.45, -0.2))
		k.featherWing(w, sd, { root = 0.1, z = 0.06, thick = 0.16, feathers = {
			{ 1.25, 2.6, 0.55, PU, PUL }, { 1.0, 2.3, 0.5, PK, PK }, { 0.75, 1.9, 0.45, PU, PUL } } })
		local _, gl = k.bar(w, "WingGlow", V3(sd * 0.3, 0.9, -0.12), V3(sd * 0.75, 2.2, -0.12), 0.1, CY, MAT.Neon)
		k.glow(gl, CY)
	end

	-- nine fan tails radiating in a lower semicircle behind the body (fan chains, roster check: exactly 9)
	local hub = c(0, -0.05, 0.95)
	k.b(body, "TailHub", 0.7, 0.7, 0.3, PUL, hub)
	for i = 1, 9 do
		local th = (i - 5) * 0.55
		local radial = V3(math.sin(th), -math.cos(th), 0)
		local dir = (radial * 0.75 + V3(0, 0, 1)).Unit
		local pos = V3(0, -0.05, 1.05) + radial * 0.3
		local segs = {}
		for j = 1, 5 do
			table.insert(segs, { 0.2, 0.2, 0.42, (j % 2 == 0) and PK or PU, 0 })
		end
		local rec = k.chain(body, CFrame.lookAt(pos * s, (pos - dir) * s), segs,
			{ name = "FanTail", kind = "fan", i = i, n9 = 9, baseYaw = (i - 5) * 0.04, amp = 0.18, freq = 1.6, lag = 0.55 })
		local last = rec.parts[#rec.parts]
		local tip = k.c(0, 0, 0.55) * ANG(PI / 2, 0, 0)
		k.diamond(last, "TailTip", 0.75, 0.42, 0.12, PU, tip)
		k.diamond(last, "TailCore", 0.45, 0.24, 0.14, CY, tip, MAT.Glass)
	end
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">SpeciesModelsForest</string><ProtectedString name="Source"><![CDATA[-- SpeciesModelsForest: hand-authored, reference-faithful models for the Green Forest world
-- (Mossbun, Acornip, Petalfly, Thornhog, Elderstag Sprite, Oak Titan, Bloomwyrm, Sylph Queen).
-- Location: ReplicatedStorage > Shared > SpeciesModelsForest (ModuleScript), merged into SpeciesModels.

local K = require(script.Parent.ModelKit)
local V3, CF, ANG, PI, MAT, C = K.V3, K.CF, K.ANG, K.PI, K.MAT, K.C
local FACE, DOWN = ANG(0, PI / 2, 0), ANG(0, 0, PI)
local SIDES = { -1, 1 }

local M = {}

-- flat kite panel in a wing pivot's XY plane (outward = side * X): O root, L upper corner, T tip, R lower corner
local function kite(k, pv, side, O, L, T, R, col, z, mat, tr)
	local function P(v) return V3(v.X * side, v.Y, z) end
	k.mem(pv, "WingPanel", P(O), P(L), P(R), 0.08, col, mat, tr)
	k.mem(pv, "WingPanel", P(T), P(L), P(R), 0.08, col, mat, tr)
end

---------------------------------------------------------------- MOSSBUN (Common)
-- Green block bunny: big hind haunches, cream paws and muzzle, glowing green slit eyes, very tall ears
-- with cream insides and pointed tips, a two-leaf sprout between the ears, chunky cream tail.
function M.Mossbun(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local G, GD, CR, CRD, DG, EY = C("#8CCB5A"), C("#6FB043"), C("#F2F0D6"), C("#DEDBBE"), C("#3F8F2F"), C("#3DDC3D")
	local BY = 1.4
	local body = k.body(1.5, 1.2, 1.9, G, BY)
	for _, sd in ipairs(SIDES) do
		k.b(body, "Haunch", 0.5, 1.0, 1.1, G, c(sd * 0.72, -0.05, 0.45))
	end
	k.b(body, "Chest", 1.3, 1.1, 0.4, G, c(0, 0.05, -0.95))
	local lf = { up = { 0.45, 0.4, 0.5 }, col = G, w2 = 0.4, d2 = 0.45, paw = { 0.55, 0.25, 0.75 }, pawCol = CR, toes = 2, toeCol = CRD }
	k.leg(body, "LegFL", BY, -0.42, -0.45, -0.7, lf)
	k.leg(body, "LegFR", BY, 0.42, -0.45, -0.7, lf)
	local lh = { up = { 0.5, 0.4, 0.7 }, col = G, w2 = 0.45, d2 = 0.6, paw = { 0.65, 0.3, 1.1 }, pawCol = CR, toes = 2, toeCol = CRD, hind = true }
	k.leg(body, "LegBL", BY, -0.62, -0.45, 0.55, lh)
	k.leg(body, "LegBR", BY, 0.62, -0.45, 0.55, lh)
	rig.legKind = "quad"

	local head = k.head(body, 1.3, 1.15, 1.2, G, c(0, 0.95, -1.15), V3(0, -0.45, 0.35))
	k.b(head, "Muzzle", 1.0, 0.45, 0.3, CR, c(0, -0.35, -0.62))
	k.w(head, "Nose", 0.3, 0.14, 0.12, CRD, c(0, -0.16, -0.8))
	for _, sd in ipairs(SIDES) do
		k.b(head, "Brow", 0.5, 0.16, 0.2, GD, c(sd * 0.33, 0.26, -0.6) * ANG(0, 0, sd * 0.25))
		k.eye(head, sd * 0.33, 0.1, -0.61, 0.32, 0.15, EY, sd * 0.25)
		local ear = k.ear(head, sd, c(sd * 0.35, 0.55, 0.1) * ANG(-0.25, 0, -sd * 0.15), "bunny")
		k.b(ear, "Ear", 0.38, 1.5, 0.3, G, c(0, 0.75, 0))
		k.b(ear, "EarInner", 0.22, 1.2, 0.06, CR, c(0, 0.7, -0.16))
		k.tri(ear, "EarTip", 0.38, 0.35, 0.3, G, c(0, 1.67, 0))
	end
	local se = k.pv(head, "Sprout", c(0, 0.58, 0))
	table.insert(rig.bobbers, se)
	for _, sd in ipairs(SIDES) do
		k.tri(se.part, "Leaf", 0.08, 0.45, 0.3, DG, c(sd * 0.12, 0.2, 0) * ANG(0, 0, -sd * 0.5) * FACE)
	end
	k.tail(body, c(0, 0.35, 0.95), { { 0.8, 0.75, 0.6, -0.4, CR } })
end

---------------------------------------------------------------- ACORNIP (Uncommon)
-- Squirrel in an acorn-cap helmet (stem + leaf), dark eye mask with glowing eyes, tan muzzle and bib,
-- leather strap with an acorn pendant, leaf shoulder pads, dark paws, huge curling tail with a tan inside.
function M.Acornip(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local B, BD, T, CAP, CAPD, LF, EY = C("#C07A45"), C("#8E5530"), C("#EBC895"), C("#7A4A2A"), C("#5E3820"), C("#7FA53A"), C("#FFE9A8")
	local BY = 1.6
	local body = k.body(1.4, 1.3, 1.7, B, BY)
	k.b(body, "Bib", 0.85, 0.95, 0.12, T, c(0, -0.05, -0.86))
	k.bar(body, "Strap", V3(-0.6, 0.55, -0.88), V3(0.35, -0.3, -0.88), 0.14, BD, nil, nil, nil, 0.06)
	k.b(body, "Acorn", 0.3, 0.3, 0.14, T, c(0, 0.0, -0.94))
	k.b(body, "AcornCap", 0.36, 0.14, 0.16, BD, c(0, 0.17, -0.94))
	-- leaf shoulder pads: three broad leaves fanned over each shoulder, tips pointing out and down
	for _, sd in ipairs(SIDES) do
		for _, d in ipairs({ { -0.75, -0.3 }, { -0.35, 0.0 }, { 0.05, 0.3 } }) do
			-- flat leaf lying out from the shoulder (thin in Y), tilted down at the outer end
			local _, pp = k.pv(body, "LeafPad", c(sd * 0.5, 0.5, d[1]) * ANG(0, d[2] * sd, -sd * 0.95))
			k.b(pp, "Leaf", 0.75, 0.1, 0.55, LF, c(sd * 0.38, 0, 0))
			k.tri(pp, "LeafTip", 0.1, 0.4, 0.55, LF, c(sd * 0.95, 0, 0) * ANG(0, 0, -sd * PI / 2))
		end
	end
	local lg = { up = { 0.6, 0.55, 0.7 }, col = B, w2 = 0.52, d2 = 0.6, paw = { 0.66, 0.3, 0.8 }, pawCol = BD, toes = 2, toeCol = BD }
	k.leg(body, "LegFL", BY, -0.45, -0.5, -0.55, lg)
	k.leg(body, "LegFR", BY, 0.45, -0.5, -0.55, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.45, -0.5, 0.55, lg)
	k.leg(body, "LegBR", BY, 0.45, -0.5, 0.55, lg)
	rig.legKind = "quad"

	local head = k.head(body, 1.3, 1.1, 1.15, B, c(0, 1.05, -0.95), V3(0, -0.4, 0.3))
	k.b(head, "Muzzle", 0.75, 0.45, 0.45, T, c(0, -0.3, -0.7))
	k.b(head, "Nose", 0.28, 0.16, 0.12, CAPD, c(0, -0.14, -0.95))
	k.b(head, "Mask", 1.34, 0.3, 1.19, BD, c(0, 0.08, 0))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.3, 0.08, -0.6, 0.3, 0.15, EY, sd * 0.15)
		k.b(head, "Cheek", 0.3, 0.45, 0.5, T, c(sd * 0.55, -0.3, -0.45))
		-- ears poke out of the cap beside the top block
		local ear = k.ear(head, sd, c(sd * 0.62, 0.8, 0.1) * ANG(0, 0, -sd * 0.15))
		k.tri(ear, "Ear", 0.22, 0.65, 0.45, B, c(0, 0.3, 0) * FACE)
		k.tri(ear, "EarInner", 0.07, 0.42, 0.26, T, c(0, 0.24, -0.12) * FACE)
	end
	k.b(head, "Cap", 1.55, 0.45, 1.4, CAP, c(0, 0.62, 0.02))
	k.b(head, "CapBrim", 1.6, 0.14, 0.25, CAPD, c(0, 0.42, -0.7))
	k.b(head, "CapTop", 1.05, 0.3, 0.95, CAPD, c(0, 0.95, 0.02))
	k.b(head, "Stem", 0.16, 0.5, 0.16, CAPD, c(0, 1.3, 0) * ANG(0, 0, 0.2))
	k.tri(head, "CapLeaf", 0.08, 0.6, 0.35, LF, c(0.32, 1.4, 0) * ANG(0, 0, -1.2) * FACE)

	-- big S tail: rises straight up behind, then curls back and down at the top (tan on the inside of the curl)
	local tw = { 0.9, 1.0, 1.0, 0.85 }
	k.tail(body, c(0, 0.3, 0.75), {
		{ tw[1], tw[1], 0.9, -1.35, B }, { tw[2], tw[2], 0.85, 0.15, B }, { tw[3], tw[3], 0.8, 0.75, B }, { tw[4], tw[4], 0.7, 0.75, B } })
	for i, e in ipairs(rig.tail) do
		k.b(e.part, "TailInner", tw[i] * 0.75, 0.1, 0.7, T, c(0, -tw[i] * 0.48, 0))
	end
end

---------------------------------------------------------------- PETALFLY (Rare)
-- Pink petal moth on six legs: pink thorax, pale-yellow belly and tapered abdomen, angular head with a
-- purple mask and glowing eyes, purple-and-yellow crest, four kite wings (pink with yellow centres and
-- purple tips), pink legs with purple bands and feet.
function M.Petalfly(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local P, PD, Y, PU, EY = C("#F48CC4"), C("#E070AE"), C("#F6E7A0"), C("#8A3CC8"), C("#FFF6A0")
	local BY = 1.6
	local body = k.body(0.9, 0.85, 1.0, P, BY)
	k.b(body, "Belly", 0.75, 0.3, 0.85, Y, c(0, -0.38, 0))
	local ae, ap = k.pv(body, "AbdomenPivot", c(0, -0.05, 0.45) * ANG(0.35, 0, 0))
	H.group(rig, "abdomen", ae)
	k.b(ap, "Abdomen", 0.8, 0.7, 0.8, Y, c(0, 0, 0.4))
	k.b(ap, "Abdomen", 0.55, 0.5, 0.7, Y, c(0, -0.02, 1.05))
	k.w(ap, "AbdomenTip", 0.4, 0.35, 0.5, Y, c(0, -0.04, 1.6) * ANG(0, PI, 0))

	local head = k.head(body, 0.85, 0.7, 0.8, P, c(0, 0.45, -0.75), V3(0, -0.2, 0.3))
	k.w(head, "Snout", 0.6, 0.4, 0.4, PD, c(0, -0.1, -0.55))
	k.b(head, "Mask", 0.9, 0.24, 0.1, PU, c(0, 0.04, -0.41))
	for _, sd in ipairs(SIDES) do k.eye(head, sd * 0.22, 0.04, -0.47, 0.2, 0.13, EY, sd * 0.3) end
	k.tri(head, "Crest", 0.14, 0.75, 0.45, PU, c(0, 0.65, 0) * FACE)
	k.tri(head, "CrestInner", 0.15, 0.45, 0.22, Y, c(0, 0.58, -0.02) * FACE)

	local lg = { up = { 0.18, 0.55, 0.18 }, col = P, w2 = 0.16, d2 = 0.16, band = PU, paw = { 0.26, 0.24, 0.3 }, pawCol = PU, splay = 0.6 }
	for _, z in ipairs({ -0.35, 0, 0.35 }) do
		k.leg(body, "LegL", BY, -0.38, -0.35, z, lg)
		k.leg(body, "LegR", BY, 0.38, -0.35, z, lg)
	end
	rig.legKind = "bug6"

	local V2 = Vector2.new
	for _, sd in ipairs(SIDES) do
		for tier, w in ipairs({
			{ V2(0, 0), V2(0.55, 1.9), V2(3.0, 2.8), V2(2.1, 0.35), V2(0.55, 0.5), V2(0.9, 1.6), V2(2.35, 2.2), V2(1.85, 0.75) },
			{ V2(0, 0), V2(1.2, 0.35), V2(2.6, -0.55), V2(1.0, -0.95), V2(0.5, -0.1), V2(1.2, 0.05), V2(2.0, -0.45), V2(1.0, -0.65) },
		}) do
			local pv = k.wing(body, sd, c(sd * 0.4, 0.3, 0.05 + (tier - 1) * 0.15) * ANG(0, -sd * (0.35 + tier * 0.1), 0), tier)
			kite(k, pv, sd, w[1], w[2], w[3], w[4], P, 0)
			kite(k, pv, sd, w[5], w[6], w[7], w[8], Y, -0.06)
			local Tt = V3(w[3].X * sd, w[3].Y, -0.04)
			local Lt = V3(w[2].X * sd, w[2].Y, -0.04)
			local Rt = V3(w[4].X * sd, w[4].Y, -0.04)
			k.bar(pv, "WingTip", Tt, Tt + (Lt - Tt) * 0.35, 0.16, PU)
			k.bar(pv, "WingTip", Tt, Tt + (Rt - Tt) * 0.35, 0.16, PU)
		end
	end
end

---------------------------------------------------------------- THORNHOG (Epic)
-- Armoured boar: tan-brown body with shoulder plates carrying a cream flower badge, glowing green
-- seam lines, a back covered in rows of big green leaf spines (they bristle on the power move), cream
-- pig snout with nostrils, angry brows over glowing green eyes, small ears, cream toes.
function M.Thornhog(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local BR, BRD, T, G, GD, GN = C("#B88A5E"), C("#9A6E46"), C("#F0D4A8"), C("#43AE40"), C("#2F8F30"), C("#5EE04A")
	local BY = 1.55
	local body = k.body(2.1, 1.35, 2.6, BR, BY)
	for _, sd in ipairs(SIDES) do
		local _, plate = k.b(body, "ShoulderPlate", 0.3, 1.1, 1.3, BRD, c(sd * 1.1, 0.1, -0.6))
		for i = 0, 3 do
			local a = i * PI / 2
			k.b(plate, "Petal", 0.06, 0.26, 0.26, T, c(sd * 0.17, math.cos(a) * 0.22, math.sin(a) * 0.22))
		end
		k.b(plate, "FlowerMid", 0.07, 0.26, 0.26, T, c(sd * 0.17, 0, 0))
		k.b(plate, "FlowerCore", 0.08, 0.14, 0.14, G, c(sd * 0.18, 0, 0))
		local _, seam = k.bar(body, "Seam", V3(sd * 1.07, -0.25, -0.1), V3(sd * 1.07, -0.05, 0.8), 0.08, GN, MAT.Neon, nil, V3(1, 0, 0))
		k.glow(seam, GN)
		k.b(body, "HipPlate", 0.25, 0.9, 1.0, BR, c(sd * 1.08, 0.0, 0.85))
	end
	local n = 0
	for row = 0, 2 do
		for col = 0, 3 do
			n += 1
			-- broad leaf blades layered over the back and down the flanks, all sweeping backward
			local x = (col - 1.5) * 0.62
			local z = -0.75 + row * 0.75 + (col % 2) * 0.25
			local pe, pp = k.pv(body, "SpineRoot", c(x, 0.55 - math.abs(x) * 0.15, z) * ANG(1.0, 0, -x * 0.75))
			pe.openAxis, pe.openAmt = V3(1, 0, 0), -0.35
			H.group(rig, "open", pe)
			H.group(rig, "spines", pe)
			k.spike(pp, "LeafSpine", 1.6 - row * 0.1 - math.abs(col - 1.5) * 0.15, 1.05, (n % 3 == 0) and GD or G, CF())
		end
	end

	local lg = { up = { 0.8, 0.5, 0.85 }, col = BR, w2 = 0.72, d2 = 0.78, paw = { 0.9, 0.32, 0.95 }, pawCol = T, toes = 3, toeCol = T }
	k.leg(body, "LegFL", BY, -0.72, -0.5, -0.85, lg)
	k.leg(body, "LegFR", BY, 0.72, -0.5, -0.85, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.72, -0.5, 0.9, lg)
	k.leg(body, "LegBR", BY, 0.72, -0.5, 0.9, lg)
	rig.legKind = "quad"

	local head = k.head(body, 1.3, 1.0, 1.1, BR, c(0, 0.15, -1.65), V3(0, -0.3, 0.4))
	k.b(head, "Snout", 0.7, 0.5, 0.35, T, c(0, -0.2, -0.68))
	for _, sd in ipairs(SIDES) do
		k.b(head, "Nostril", 0.1, 0.2, 0.04, C("#5A3A22"), c(sd * 0.13, -0.2, -0.86))
		k.b(head, "Brow", 0.55, 0.2, 0.3, BRD, c(sd * 0.36, 0.25, -0.5) * ANG(0, 0, sd * 0.3))
		k.eye(head, sd * 0.36, 0.08, -0.56, 0.3, 0.13, GN, sd * 0.3)
		local ear = k.ear(head, sd, c(sd * 0.5, 0.48, 0.2) * ANG(0, 0, -sd * 0.3))
		k.b(ear, "Ear", 0.35, 0.4, 0.2, BR, c(0, 0.18, 0))
		k.b(ear, "EarInner", 0.2, 0.25, 0.06, T, c(0, 0.16, -0.11))
	end
	k.spike(head, "HeadSpine", 0.8, 0.5, G, c(0, 0.45, 0.1) * ANG(0.5, 0, 0))
end

---------------------------------------------------------------- ELDERSTAG SPRITE (Legendary)
-- Ancient forest stag: beige body under a mantle of green and white leaves with gold edging, white
-- leaf bib with a green chest gem, long legs with white greaves carrying green gems and gold bands,
-- split white hooves, long head with a forehead gem, branching antlers tipped with glowing green
-- crystals, a leaf-plume tail.
function M.Elderstag(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local T, W, G, GO, CR, EY = C("#EDE3C8"), C("#FBFAF5"), C("#5FCB78"), C("#D4A743"), C("#7CFFB0"), C("#7CFFB0")
	local BY = 2.75
	local body = k.body(1.3, 1.3, 2.6, T, BY)
	k.b(body, "ChestFrame", 0.62, 0.62, 0.1, GO, c(0, 0.15, -1.33) * ANG(0, 0, PI / 4))
	k.diamond(body, "ChestGem", 0.75, 0.5, 0.14, CR, c(0, 0.15, -1.37), MAT.Glass)
	-- leaf blade lying along its frame's +X (flat in Y): blade + pointed tip
	local function leaf(cf, L, wd, col)
		k.b(body, "Leaf", L * 0.8, 0.1, wd, col, cf * c(L * 0.4, 0, 0))
		k.tri(body, "LeafTip", 0.1, L * 0.25, wd, col, cf * c(L * 0.92, 0, 0) * ANG(0, 0, -PI / 2))
	end
	-- mantle: leaves draping over both flanks, sweeping back
	for _, sd in ipairs(SIDES) do
		for i = 0, 3 do
			local col = ((i + (sd > 0 and 1 or 0)) % 2 == 0) and G or W
			leaf(c(sd * 0.5, 0.72, -1.0 + i * 0.55) * ANG(0, sd < 0 and PI or 0, 0) * ANG(0, -sd * 0.35, -0.7), 1.4 - i * 0.08, 0.7, col)
		end
	end
	-- along the spine, pointing back
	for i = 0, 2 do
		leaf(c(0, 0.7, -0.7 + i * 0.6) * ANG(0, -PI / 2, -0.25), 1.1, 0.6, (i % 2 == 0) and W or G)
	end
	-- white leaf bib down the chest (green at the outer edges)
	for i, x in ipairs({ -0.46, -0.23, 0, 0.23, 0.46 }) do
		leaf(c(x, 0.45, -1.36 - (0.5 - math.abs(x)) * 0.1) * ANG(0, 0, -PI / 2 - x * 0.5), 1.25 - math.abs(x) * 0.6, 0.32, (i == 1 or i == 5) and G or W)
	end

	local function greave(knee)
		k.b(knee, "Greave", 0.56, 0.55, 0.64, W, c(0, -0.35, 0))
		k.diamond(knee, "GreaveGem", 0.35, 0.22, 0.08, CR, c(0, -0.35, -0.35), MAT.Glass)
	end
	local lg = { up = { 0.6, 1.0, 0.75 }, col = T, w2 = 0.46, d2 = 0.56, band = GO, paw = { 0.58, 0.42, 0.72 }, pawCol = W, toes = 2, toeCol = W }
	local _, _, k1 = k.leg(body, "LegFL", BY, -0.42, -0.5, -1.0, lg); greave(k1)
	local _, _, k2 = k.leg(body, "LegFR", BY, 0.42, -0.5, -1.0, lg); greave(k2)
	lg.hind = true
	local _, _, k3 = k.leg(body, "LegBL", BY, -0.42, -0.5, 1.0, lg); greave(k3)
	local _, _, k4 = k.leg(body, "LegBR", BY, 0.42, -0.5, 1.0, lg); greave(k4)
	rig.legKind = "quad"

	k.b(body, "Neck", 0.6, 1.3, 0.7, T, c(0, 1.0, -1.3) * ANG(-0.35, 0, 0))
	for i = 0, 2 do k.tri(body, "NeckLeaf", 0.12, 0.8, 0.45, (i == 1) and W or G, c(0, 1.35 - i * 0.35, -1.05 + i * 0.12) * ANG(1.0, 0, 0)) end
	local head = k.head(body, 0.65, 0.65, 1.2, T, c(0, 1.85, -1.85), V3(0, -0.2, 0.4))
	k.w(head, "Snout", 0.55, 0.4, 0.5, T, c(0, -0.1, -0.8))
	k.diamond(head, "ForeheadGem", 0.35, 0.22, 0.08, CR, c(0, 0.2, -0.62), MAT.Glass)
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.25, 0.08, -0.61, 0.16, 0.09, EY, sd * 0.3)
		local ear = k.ear(head, sd, c(sd * 0.32, 0.28, 0.25) * ANG(0, 0, -sd * 0.9))
		k.tri(ear, "Ear", 0.12, 0.45, 0.3, T, c(0, 0.22, 0) * FACE)
		-- branching antler: main beam out and up, three tines, crystal tips
		local A = {
			V3(sd * 0.2, 0.3, 0.1), V3(sd * 0.7, 0.95, 0.15), V3(sd * 1.3, 1.25, 0.2),
		}
		k.bar(head, "Antler", A[1], A[2], 0.18, T)
		k.bar(head, "Antler", A[2], A[3], 0.16, T)
		local tines = { { A[2], V3(sd * 0.6, 1.55, 0.15) }, { (A[2] + A[3]) / 2, V3(sd * 1.05, 1.75, 0.18) }, { A[3], V3(sd * 1.6, 1.75, 0.2) } }
		for _, tn in ipairs(tines) do
			k.bar(head, "AntlerTine", tn[1], tn[2], 0.14, GO)
			k.crystal(head, "AntlerCrystal", 0.5, 0.18, CR, k.sc(CF(tn[2])), MAT.Glass, 0.1)
		end
	end

	local tip = k.tail(body, c(0, 0.45, 1.25), { { 0.4, 0.35, 0.5, -0.4, T } })
	for i, a in ipairs({ -0.5, 0, 0.5 }) do
		k.tri(tip, "TailLeaf", 0.12, 1.1, 0.5, (i == 2) and W or G, c(a * 0.3, 0, 0.6) * ANG(PI / 2 - 0.2, a, 0))
	end
end

---------------------------------------------------------------- OAK TITAN (Legendary)
-- Walking oak golem: bark torso with a glowing amber hex core, leaf V panels at the hips, leaf
-- shoulder pads, branches with leafy pads growing from shoulders and head, huge bark fists with
-- glowing amber seams, trunk legs that splay into roots, glowing amber eyes under a heavy brow.
function M.OakTitan(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local BK, BKD, BKL, LF, LFD, GL = C("#7A4E2C"), C("#5E3B20"), C("#8E5E36"), C("#7CCB3E"), C("#5FAE2E"), C("#FFC83A")
	local function branch(parent, a, b, leaf)
		k.bar(parent, "Branch", a, b, 0.22, BKD, nil, nil, V3(0, 0, 1))
		if leaf then k.b(parent, "Canopy", 1.0, 0.25, 0.8, LF, c(b.X, b.Y + 0.1, b.Z)) end
	end
	local BY = 3.4
	local body = k.body(2.2, 2.0, 1.5, BK, BY)
	k.b(body, "CoreFrame", 0.95, 0.95, 0.12, BKD, c(0, 0.2, -0.8) * ANG(0, 0, PI / 4))
	local _, core = k.b(body, "Core", 0.6, 0.6, 0.14, GL, c(0, 0.2, -0.83) * ANG(0, 0, PI / 4), MAT.Neon)
	k.glow(core, GL)
	k.b(body, "Plank", 0.5, 1.2, 0.1, BKL, c(0, -0.6, -0.78))
	for _, sd in ipairs(SIDES) do
		k.tri(body, "HipLeaf", 0.1, 0.8, 0.6, LF, c(sd * 0.6, -0.85, -0.8) * DOWN * FACE)
		local _, seam = k.bar(body, "Seam", V3(sd * 0.5, 0.75, -0.77), V3(sd * 0.85, 0.2, -0.77), 0.07, GL, MAT.Neon, nil, nil, 0.04)
		k.glow(seam, GL)
	end
	k.b(body, "Hips", 1.8, 0.6, 1.3, BKD, c(0, -1.2, 0))

	local lg = { up = { 1.05, 0.8, 1.05 }, col = BK, w2 = 1.0, d2 = 1.0, col2 = BKL, paw = { 1.5, 0.5, 1.5, 0 }, pawCol = BKD }
	for _, sd in ipairs(SIDES) do
		local _, _, knee, lh = k.leg(body, sd < 0 and "LegL" or "LegR", BY, sd * 0.6, -1.4, 0, lg)
		for i = 0, 3 do
			local a = i * PI / 2 + PI / 4
			k.w(knee, "Root", 0.4, 0.45, 0.6, BKD, c(math.sin(a) * 0.85, -lh - 0.27, math.cos(a) * 0.85) * ANG(0, a + PI, 0))
		end
	end
	rig.legKind = "biped"

	for _, sd in ipairs(SIDES) do
		local arm = k.arm(body, sd, c(sd * 1.4, 0.6, 0))
		k.b(arm, "ShoulderLeaf", 1.3, 0.3, 1.2, LF, c(sd * 0.2, 0.55, 0))
		k.b(arm, "Shoulder", 1.1, 0.7, 1.1, BKL, c(sd * 0.2, 0.15, 0))
		k.b(arm, "UpperArm", 0.85, 1.0, 0.85, BK, c(sd * 0.25, -0.65, 0))
		local _, fore = k.b(arm, "Forearm", 1.35, 1.2, 1.35, BK, c(sd * 0.3, -1.6, -0.05))
		local _, ln = k.b(fore, "ForearmGlow", 1.37, 0.08, 1.37, GL, c(0, 0.15, 0), MAT.Neon)
		k.glow(ln, GL)
		k.b(fore, "ForearmLeaf", 0.6, 0.3, 0.8, LF, c(sd * 0.5, 0.55, 0))
		local _, fist = k.b(arm, "Fist", 1.45, 1.15, 1.4, BKL, c(sd * 0.3, -2.75, -0.1))
		for f = 1, 3 do k.b(fist, "Finger", 0.4, 0.4, 0.22, BKD, c((f - 2) * 0.45, 0.15, -0.75)) end
		branch(body, V3(sd * 1.0, 0.95, 0.2), V3(sd * 1.7, 2.0, 0.3), true)
		branch(body, V3(sd * 1.2, 1.4, 0.25), V3(sd * 2.2, 1.7, 0.1), true)
	end

	local head = k.head(body, 0.95, 1.0, 0.9, BK, c(0, 1.4, -0.1), V3(0, -0.45, 0.1))
	k.b(head, "Brow", 1.05, 0.25, 0.3, BKD, c(0, 0.18, -0.4))
	k.b(head, "Jaw", 0.75, 0.25, 0.3, BKD, c(0, -0.35, -0.38))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.22, 0.02, -0.46, 0.24, 0.1, GL, sd * 0.25)
		branch(head, V3(sd * 0.3, 0.45, 0), V3(sd * 0.6, 1.3, 0.05), true)
	end
	branch(head, V3(0, 0.45, 0.1), V3(0, 1.45, 0.25), true)
	k.b(head, "CanopyTop", 0.8, 0.25, 0.7, LFD, c(0, 1.85, 0.25))
end

---------------------------------------------------------------- BLOOMWYRM (Mythical)
-- Flower dragon: green body clad in pink petal plates with a lotus on the chest, green legs with
-- pink claws, segmented pink/green neck, green head with curved pink horns, a lotus crown and pink
-- eyes, huge wings (green arm bones, pink membranes, hot-pink edges), a tail lined with leaf blades.
function M.Bloomwyrm(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local G, GD, PK, HP, EY = C("#5EC25A"), C("#3E9A3E"), C("#F7B0CC"), C("#EE3F8E"), C("#FF3F9E")
	-- upright fan of lotus petals (faces -Z); outer/inner colours
	local function lotus(parent, cf, size, outer, inner)
		for i, a in ipairs({ -0.9, -0.45, 0, 0.45, 0.9 }) do
			k.tri(parent, "Lotus", 0.1, size * (1 - math.abs(a) * 0.25), size * 0.5, (i == 3) and inner or outer, cf * ANG(0, 0, -a) * c(0, size * 0.45, 0) * FACE)
		end
	end
	local BY = 2.3
	local body = k.body(1.8, 1.5, 2.4, G, BY)
	k.b(body, "Chest", 1.6, 1.4, 0.8, PK, c(0, 0.05, -1.1))
	lotus(body, c(0, -0.35, -1.53), 1.1, HP, C("#FF7AB0"))
	for _, sd in ipairs(SIDES) do
		for i = 0, 2 do
			k.diamond(body, "Petal", 0.9, 0.5, 0.1, (i % 2 == 0) and PK or HP, c(sd * 0.92, 0.1, -0.6 + i * 0.6) * ANG(0, -sd * PI / 2, 0) * ANG(0, 0, 0.6))
		end
	end
	for i = 0, 4 do
		k.tri(body, "BackLeaf", 0.14, 0.6, 0.5, (i % 2 == 0) and PK or G, c(0, 0.95, -0.8 + i * 0.45) * ANG(0.5, 0, 0))
	end

	local lf = { up = { 0.8, 0.75, 0.9 }, col = G, w2 = 0.68, d2 = 0.75, col2 = GD, paw = { 0.95, 0.35, 1.1 }, pawCol = G, toes = 3, toeCol = PK, band = PK }
	k.leg(body, "LegFL", BY, -0.75, -0.5, -0.8, lf)
	k.leg(body, "LegFR", BY, 0.75, -0.5, -0.8, lf)
	lf.hind = true
	k.leg(body, "LegBL", BY, -0.78, -0.45, 0.85, lf)
	k.leg(body, "LegBR", BY, 0.78, -0.45, 0.85, lf)
	rig.legKind = "quad"

	k.b(body, "Neck1", 0.85, 0.9, 0.8, PK, c(0, 0.75, -1.35) * ANG(-0.5, 0, 0))
	k.b(body, "Neck2", 0.75, 0.85, 0.75, G, c(0, 1.35, -1.6) * ANG(-0.25, 0, 0))
	local head = k.head(body, 1.0, 0.8, 1.2, G, c(0, 2.0, -1.95), V3(0, -0.3, 0.4))
	k.b(head, "Snout", 0.7, 0.45, 0.7, G, c(0, -0.12, -0.85))
	local jaw = k.jb(head, "Jaw", 0.66, 0.2, 0.9, GD, c(0, -0.42, -0.55), V3(0, 0, 0.45))
	H.group(rig, "jaws", jaw)
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.3, 0.1, -0.61, 0.24, 0.1, EY, sd * 0.3)
		k.spike(head, "Horn", 1.1, 0.3, PK, c(sd * 0.35, 0.35, 0.25) * ANG(0.8, 0, -sd * 0.45))
		k.tri(head, "Frill", 0.1, 0.6, 0.45, PK, c(sd * 0.55, 0.0, 0.3) * ANG(0.6, 0, -sd * 1.2))
	end
	-- lotus crown: two crossed upright petal fans on top of the head
	lotus(head, c(0, 0.38, 0.05), 0.75, PK, HP)
	lotus(head, c(0, 0.38, 0.05) * ANG(0, PI / 2, 0), 0.6, HP, PK)

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.75, 0.6, -0.3))
		k.batWing(w, sd, { wrist = Vector2.new(1.5, 2.3), bone = G, mem = PK, boneW = 0.34, cap = GD,
			tips = { Vector2.new(4.0, 1.1), Vector2.new(3.5, -0.3), Vector2.new(2.5, -1.0), Vector2.new(1.2, -0.9) } })
		k.bar(w, "WingEdge", V3(sd * 4.0, 1.1, 0.1), V3(sd * 3.5, -0.3, 0.1), 0.16, HP)
		k.bar(w, "WingEdge", V3(sd * 3.5, -0.3, 0.1), V3(sd * 2.5, -1.0, 0.1), 0.16, HP)
	end

	local segs = {}
	for j = 1, 8 do
		local w = 0.8 - j * 0.065
		table.insert(segs, { w, w * 0.85, 0.6, (j % 2 == 0) and GD or G, j == 1 and 0.3 or -0.06 })
	end
	local rec = k.chain(body, c(0, 0.1, 1.15), segs, { name = "Tail", kind = "spine", i = 1, amp = 0.16, freq = 1.3, lag = 0.55 })
	for j, p in ipairs(rec.parts) do
		local w = 0.8 - j * 0.065
		for _, sd in ipairs(SIDES) do
			k.tri(p, "TailLeaf", 0.12, 1.0 - j * 0.05, 0.55, (j % 2 == 0) and PK or G, c(sd * (w * 0.5 + 0.25), 0.1, 0) * ANG(0.6, 0, -sd * 1.1))
		end
	end
	k.tri(rec.parts[#rec.parts], "TailTip", 0.12, 0.9, 0.5, PK, c(0, 0, 0.7) * ANG(PI / 2, 0, 0))
end

---------------------------------------------------------------- SYLPH QUEEN (Mythical)
-- Hovering fairy queen: slim mint torso with a pink chest gem and white collar spikes, a layered petal
-- skirt (mint, white, pink) hanging to a point, thin white arms and hands, mint head with a white mask,
-- glowing pink eyes, pink-and-white crown, segmented antennae with pink tips, four long angular mint
-- wings with white borders and pink stripes.
function M.SylphQueen(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local MG, MGD, W, P, PD, EY = C("#B8EBB0"), C("#98D890"), C("#F8F8F6"), C("#F282B8"), C("#E05FA0"), C("#FF4FA0")
	local BY = 3.0
	local body = k.body(0.8, 0.9, 0.55, MG, BY)
	rig.legKind = "none"
	k.diamond(body, "ChestGem", 0.4, 0.28, 0.08, P, c(0, 0.1, -0.3), MAT.Glass)
	k.b(body, "Waist", 0.6, 0.35, 0.45, W, c(0, -0.55, 0))
	for _, sd in ipairs(SIDES) do
		k.tri(body, "Collar", 0.12, 0.6, 0.45, W, c(sd * 0.45, 0.45, 0) * ANG(0, 0, -sd * 0.9) * FACE)
	end
	-- full petal skirt: a ring of petals facing outward, flaring a little, longest at the front
	local cols = { MG, W, P, MG, W, MG, P, W, MG, W }
	for i = 0, 9 do
		local a = i / 10 * PI * 2
		local x, z = math.sin(a) * 0.5, -math.cos(a) * 0.4
		local L = 1.9 - math.abs(math.sin(a / 2)) * 0.5
		local te, tp = k.pv(body, "SkirtPivot", c(x, -0.65, z) * ANG(0, math.atan2(x, z), 0) * ANG(-0.4, 0, 0))
		table.insert(rig.tail, te)
		k.tri(tp, "Skirt", 0.12, L, 0.7, cols[i + 1], c(0, -L / 2, 0) * DOWN * FACE)
	end

	for _, sd in ipairs(SIDES) do
		local a = k.arm(body, sd, c(sd * 0.48, 0.3, 0))
		k.b(a, "UpperArm", 0.22, 0.6, 0.22, W, c(sd * 0.05, -0.3, 0))
		k.b(a, "Forearm", 0.2, 0.55, 0.2, W, c(sd * 0.1, -0.85, -0.1) * ANG(-0.3, 0, 0))
		local _, hand = k.b(a, "Hand", 0.24, 0.26, 0.14, W, c(sd * 0.12, -1.22, -0.22))
		for f = 1, 3 do k.b(hand, "Finger", 0.06, 0.2, 0.06, W, c((f - 2) * 0.08, -0.2, 0)) end
	end

	local head = k.head(body, 0.55, 0.6, 0.55, MG, c(0, 0.85, 0), V3(0, -0.3, 0.05))
	k.b(head, "Mask", 0.5, 0.25, 0.08, W, c(0, -0.05, -0.29))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.12, 0.08, -0.31, 0.14, 0.07, EY, sd * 0.3)
		k.tri(head, "CrownLeaf", 0.08, 0.5, 0.25, W, c(sd * 0.22, 0.4, 0) * ANG(0, 0, -sd * 0.5) * FACE)
		local ant = k.ear(head, sd, c(sd * 0.15, 0.3, 0.05), "antenna")
		local p1, p2, p3 = V3(0, 0, 0), V3(sd * 0.35, 0.8, 0.1), V3(sd * 0.85, 1.05, 0.0)
		k.bar(ant, "Antenna", p1, p2, 0.08, MG, nil, nil, V3(0, 0, 1))
		k.bar(ant, "Antenna", p2, p3, 0.08, MG, nil, nil, V3(0, 0, 1))
		k.b(ant, "AntennaTip", 0.14, 0.32, 0.14, P, c(p3.X + sd * 0.05, p3.Y - 0.15, p3.Z))
	end
	k.tri(head, "Crown", 0.1, 0.7, 0.3, P, c(0, 0.6, 0) * FACE)
	k.tri(head, "CrownSide", 0.1, 0.45, 0.25, PD, c(0, 0.5, 0.05) * FACE)

	local V2 = Vector2.new
	for _, sd in ipairs(SIDES) do
		for tier, w in ipairs({
			{ V2(0, 0), V2(1.2, 2.0), V2(3.0, 2.6), V2(2.6, 1.0) },
			{ V2(0, 0), V2(1.5, -0.2), V2(2.9, -1.6), V2(1.2, -1.4) },
		}) do
			local pv = k.wing(body, sd, c(sd * 0.35, 0.2, 0.2 + (tier - 1) * 0.12) * ANG(0, -sd * (0.3 + tier * 0.1), 0), tier)
			kite(k, pv, sd, w[1], w[2], w[3], w[4], MG, 0)
			local function P3(v, z) return V3(v.X * sd, v.Y, z or -0.06) end
			k.bar(pv, "WingBorder", P3(w[2]), P3(w[3]), 0.16, W)
			k.bar(pv, "WingBorder", P3(w[3]), P3(w[4]), 0.16, W)
			k.bar(pv, "WingStripe", P3((w[1] + w[2]) / 2), P3((w[3] + w[4]) / 2), 0.14, P)
		end
	end
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">SpeciesModelsFrozen</string><ProtectedString name="Source"><![CDATA[-- SpeciesModelsFrozen: hand-authored, reference-faithful models for the Frozen world
-- (Frostpaw, Snowpuff, Icicle Owl, Glacier Yeti, Aurora Fox, Blizzard Bear, Crystalwing Dragon).
-- Location: ReplicatedStorage > Shared > SpeciesModelsFrozen (ModuleScript), merged into SpeciesModels.

local K = require(script.Parent.ModelKit)
local V3, CF, ANG, PI, MAT, C = K.V3, K.CF, K.ANG, K.PI, K.MAT, K.C
local FACE, DOWN = ANG(0, PI / 2, 0), ANG(0, 0, PI)
local SIDES = { -1, 1 }

local M = {}

---------------------------------------------------------------- FROSTPAW (Common)
-- Ice-blue kitten: white paws and muzzle, dark nose, cheek tufts, stern brows over glowing blue eyes,
-- pointed ears with white insides, a blue scarf with a knot and two hanging ends, a segmented tail
-- rising to a white tip.
function M.Frostpaw(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local IB, IBD, W, WD, SC, SCD, N, EY = C("#BFDDF2"), C("#A6CBE6"), C("#FFFFFF"), C("#E8EEF4"), C("#5AA8E8"), C("#4690D4"), C("#3A3A40"), C("#3FC8FF")
	local BY = 1.6
	local body = k.body(1.4, 1.2, 2.0, IB, BY)
	k.b(body, "Chest", 1.45, 1.25, 0.6, IB, c(0, 0.05, -0.9))
	local lg = { up = { 0.62, 0.55, 0.7 }, col = IB, w2 = 0.52, d2 = 0.6, paw = { 0.7, 0.32, 0.85 }, pawCol = W, toes = 2, toeCol = WD }
	k.leg(body, "LegFL", BY, -0.46, -0.45, -0.7, lg)
	k.leg(body, "LegFR", BY, 0.46, -0.45, -0.7, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.46, -0.45, 0.72, lg)
	k.leg(body, "LegBR", BY, 0.46, -0.45, 0.72, lg)
	rig.legKind = "quad"

	-- scarf: band, knot, two flapping ends
	k.b(body, "Scarf", 1.55, 0.32, 0.4, SC, c(0, 0.45, -1.05))
	k.b(body, "ScarfKnot", 0.4, 0.35, 0.2, SCD, c(0.15, 0.35, -1.3))
	for i, x in ipairs({ -0.05, 0.3 }) do
		local se, sp = k.pv(body, "ScarfEnd", c(x, 0.25, -1.3))
		H.group(rig, "scarfEnds", se)
		k.b(sp, "ScarfTail", 0.32, 0.9, 0.1, SC, c(0, -0.45, 0) * ANG(0, 0, (i == 1) and 0.1 or -0.1))
	end

	local head = k.head(body, 1.35, 1.15, 1.2, IB, c(0, 1.05, -1.2), V3(0, -0.45, 0.35))
	local fz = -0.6
	k.b(head, "Muzzle", 0.8, 0.42, 0.4, W, c(0, -0.3, fz - 0.15))
	k.b(head, "Nose", 0.24, 0.14, 0.1, N, c(0, -0.12, fz - 0.37))
	k.b(head, "Crown", 1.2, 0.2, 0.9, IBD, c(0, 0.6, 0.1))
	for _, sd in ipairs(SIDES) do
		k.b(head, "Brow", 0.55, 0.18, 0.25, IBD, c(sd * 0.35, 0.24, fz - 0.03) * ANG(0, 0, sd * 0.3))
		k.eye(head, sd * 0.35, 0.06, fz - 0.03, 0.32, 0.15, EY, sd * 0.3)
		k.b(head, "CheekTuft", 0.3, 0.45, 0.6, IB, c(sd * 0.75, -0.1, -0.2))
		local ear = k.ear(head, sd, c(sd * 0.42, 0.5, 0.15) * ANG(0, 0, -sd * 0.15))
		k.tri(ear, "Ear", 0.22, 0.75, 0.6, IB, c(0, 0.37, 0) * FACE)
		k.tri(ear, "EarInner", 0.07, 0.48, 0.34, W, c(0, 0.3, -0.12) * FACE)
	end
	local tip = k.tail(body, c(0, 0.4, 1.0), {
		{ 0.38, 0.38, 0.55, -1.0, IB }, { 0.36, 0.36, 0.55, -0.2, IB }, { 0.34, 0.34, 0.5, -0.2, IB }, { 0.34, 0.34, 0.45, 0.3, IB } })
	k.b(tip, "TailTip", 0.5, 0.45, 0.5, W, c(0, 0, 0.4))
end

---------------------------------------------------------------- SNOWPUFF (Uncommon)
-- Snowball cube creature: white block body with side nubs, glowing angled blue eyes, a hat of jagged
-- ice-blue snow with a blue band and a snowflake badge, stepped white snowcap on top, stubby ice feet.
function M.Snowpuff(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local W, WD, IB, BL, EY = C("#F4F6F8"), C("#E1E6EC"), C("#BFDDF2"), C("#7FB8EC"), C("#3FA8FF")
	local BY = 1.25
	local body = k.body(1.7, 1.5, 1.6, W, BY)
	k.b(body, "Cheeks", 1.85, 0.9, 1.3, WD, c(0, -0.1, 0.05))
	for _, sd in ipairs(SIDES) do
		k.eye(body, sd * 0.4, -0.05, -0.81, 0.4, 0.16, EY, -sd * 0.3)
		local a = k.arm(body, sd, c(sd * 0.95, 0.0, -0.1))
		k.b(a, "Nub", 0.35, 0.5, 0.55, W, c(sd * 0.12, -0.15, 0))
	end
	local he, hat = k.pv(body, "Hat", c(0, 0.75, 0))
	table.insert(rig.bobbers, he)
	k.b(hat, "Brim", 2.05, 0.38, 1.95, IB, c(0, 0.15, 0))
	for i = 0, 5 do
		local x = -0.85 + i * 0.34
		k.b(hat, "BrimTooth", 0.3, (i % 2 == 0) and 0.4 or 0.25, 0.25, IB, c(x, -0.12 - ((i % 2 == 0) and 0.08 or 0), -0.88))
	end
	k.b(hat, "Band", 1.6, 0.3, 1.5, BL, c(0, 0.45, 0))
	k.b(hat, "Cap", 1.3, 0.45, 1.2, W, c(0, 0.8, 0))
	k.b(hat, "CapTop", 0.6, 0.4, 0.55, W, c(0, 1.2, 0))
	-- big snowflake badge on the hat's front-right (viewer's right = creature -X)
	local flake = c(-0.6, 0.5, -0.82)
	for i = 0, 2 do
		local r = ANG(0, 0, i * PI / 3)
		k.b(hat, "Snowflake", 0.15, 1.0, 0.1, BL, flake * r)
		for _, e in ipairs({ -1, 1 }) do
			k.b(hat, "FlakeTip", 0.32, 0.12, 0.1, BL, flake * r * c(0, e * 0.36, 0))
		end
	end
	local lg = { up = { 0.45, 0.2, 0.5 }, col = IB, w2 = 0.42, d2 = 0.48, paw = { 0.6, 0.25, 0.75 }, pawCol = IB }
	k.leg(body, "LegL", BY, -0.45, -0.7, 0, lg)
	k.leg(body, "LegR", BY, 0.45, -0.7, 0, lg)
	rig.legKind = "biped"
end

---------------------------------------------------------------- ICICLE OWL (Rare)
-- Ice owl: pale-blue body with a white V breast plate, white facial disc with a V brow, glowing blue
-- eyes, dark-blue hooked beak, tall ear tufts, layered wings (ice-blue coverts, dark-blue bar, long
-- white flight feathers), white tail feathers, white legs with dark-blue talons.
function M.IcicleOwl(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local IB, IBD, W, B, EY = C("#BFDDF2"), C("#A6CBE6"), C("#FFFFFF"), C("#3F7FC8"), C("#3FC8FF")
	local BY = 1.85
	local body = k.body(1.2, 1.4, 1.1, IB, BY)
	k.tri(body, "Breast", 0.12, 0.9, 1.0, W, c(0, -0.05, -0.58) * DOWN * FACE)
	k.b(body, "BreastTop", 1.0, 0.35, 0.12, W, c(0, 0.5, -0.58))
	local lg = { up = { 0.42, 0.35, 0.45 }, col = W, w2 = 0.34, d2 = 0.38, paw = { 0.55, 0.22, 0.6 }, pawCol = B, toes = 2, toeCol = B }
	k.leg(body, "LegL", BY, -0.3, -0.7, 0, lg)
	k.leg(body, "LegR", BY, 0.3, -0.7, 0, lg)
	rig.legKind = "biped"

	local head = k.head(body, 1.1, 0.95, 1.0, IB, c(0, 1.15, -0.1), V3(0, -0.45, 0.2))
	k.b(head, "FaceDisc", 1.0, 0.72, 0.12, W, c(0, -0.05, -0.53))
	k.w(head, "Beak", 0.25, 0.4, 0.3, B, c(0, -0.2, -0.68) * DOWN)
	for _, sd in ipairs(SIDES) do
		k.b(head, "Brow", 0.5, 0.16, 0.14, W, c(sd * 0.25, 0.3, -0.58) * ANG(0, 0, sd * 0.35))
		k.b(head, "EyeSocket", 0.3, 0.2, 0.05, C("#20304A"), c(sd * 0.24, 0.05, -0.6))
		k.eye(head, sd * 0.24, 0.05, -0.62, 0.22, 0.13, EY, sd * 0.25)
		local ear = k.ear(head, sd, c(sd * 0.4, 0.45, 0) * ANG(0, 0, -sd * 0.2))
		k.tri(ear, "Tuft", 0.2, 0.75, 0.5, IB, c(0, 0.37, 0) * FACE)
		k.tri(ear, "TuftInner", 0.07, 0.5, 0.28, B, c(0, 0.3, -0.1) * FACE)
	end

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.62, 0.45, 0.05))
		-- half-spread wing sloping down and out: ice-blue covert, dark-blue bar, long white primaries below
		local _, wp = k.pv(w, "WingPlate", ANG(0, 0, -sd * 0.6))
		k.b(wp, "Covert", 1.7, 0.6, 0.85, IB, c(sd * 0.85, 0, 0.1))
		k.b(wp, "WingBar", 1.5, 0.2, 0.87, B, c(sd * 0.95, -0.38, 0.1))
		k.featherWing(wp, sd, { root = 0.5, z = 0.05, feathers = {
			{ -0.55, 1.5, 0.38, W }, { -0.8, 1.6, 0.38, W }, { -1.05, 1.55, 0.36, W }, { -1.3, 1.35, 0.34, W }, { -1.55, 1.1, 0.32, W } } })
	end
	local tp, te = nil, nil
	te, tp = k.pv(body, "TailRoot", c(0, -0.45, 0.5) * ANG(0.9, 0, 0))
	table.insert(rig.tail, te)
	for i, a in ipairs({ -0.35, 0, 0.35 }) do
		k.tri(tp, "TailFeather", 0.1, 1.1, 0.35, (i == 2) and IBD or W, ANG(0, 0, a) * c(0, 0.5, 0) * FACE)
	end
end

---------------------------------------------------------------- GLACIER YETI (Epic)
-- Ice yeti golem: white blocky body, ice-blue fur shards over shoulders and back, a stepped white
-- beard, dark-blue face plate with glowing eyes, curled dark-blue ram horns, ice-blue loin panel with
-- a dark-blue border, huge arms ending in dark-blue fists, white legs with dark-blue feet.
function M.GlacierYeti(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local W, WD, IB, B, BD, EY = C("#F2F5F8"), C("#DDE4EC"), C("#A9D4F2"), C("#3A66B0"), C("#2C5096"), C("#3FC8FF")
	local BY = 3.1
	local body = k.body(2.2, 2.0, 1.5, W, BY)
	k.b(body, "Belly", 1.6, 1.0, 0.2, WD, c(0, -0.3, -0.78))
	k.tri(body, "LoinBorder", 0.1, 1.0, 0.85, B, c(0, -1.2, -0.8) * DOWN * FACE)
	k.tri(body, "Loin", 0.12, 0.85, 0.65, IB, c(0, -1.15, -0.83) * DOWN * FACE)
	k.b(body, "Hips", 1.9, 0.6, 1.3, W, c(0, -1.2, 0))
	for i = 0, 5 do
		local x = (i - 2.5) * 0.4
		k.spike(body, "BackShard", 1.3 - math.abs(x) * 0.2, 0.7, IB, c(x, 0.9, 0.35) * ANG(0.8, 0, -x * 0.4))
	end

	local lg = { up = { 1.0, 0.7, 1.0 }, col = W, w2 = 0.92, d2 = 0.95, paw = { 1.25, 0.45, 1.4, -0.1 }, pawCol = B, toes = 2, toeCol = BD }
	k.leg(body, "LegL", BY, -0.6, -1.4, 0, lg)
	k.leg(body, "LegR", BY, 0.6, -1.4, 0, lg)
	rig.legKind = "biped"

	for _, sd in ipairs(SIDES) do
		local arm = k.arm(body, sd, c(sd * 1.4, 0.55, 0))
		k.b(arm, "Shoulder", 1.25, 0.8, 1.25, W, c(sd * 0.2, 0.2, 0))
		-- big ice-fur mane over the shoulder: crossed shards fanning up and out
		for i = 0, 4 do
			k.spike(arm, "FurShard", 1.3 - math.abs(i - 2) * 0.15, 0.75, (i % 2 == 0) and IB or C("#C4E2F6"),
				c(sd * (0.0 + i * 0.18), 0.55, -0.45 + i * 0.22) * ANG(0.25, 0, -sd * (0.3 + i * 0.22)))
		end
		k.b(arm, "UpperArm", 0.9, 0.9, 0.9, W, c(sd * 0.25, -0.6, 0))
		k.b(arm, "Forearm", 1.25, 1.0, 1.25, WD, c(sd * 0.3, -1.5, -0.05))
		local _, fist = k.b(arm, "Fist", 1.4, 1.1, 1.35, B, c(sd * 0.3, -2.45, -0.1))
		for f = 1, 3 do k.b(fist, "Knuckle", 0.38, 0.34, 0.2, BD, c((f - 2) * 0.42, 0.2, -0.72)) end
	end

	local head = k.head(body, 1.0, 1.0, 0.95, W, c(0, 1.3, -0.2), V3(0, -0.45, 0.1))
	k.b(head, "FacePlate", 0.7, 0.4, 0.08, B, c(0, 0.1, -0.5))
	for _, sd in ipairs(SIDES) do k.eye(head, sd * 0.17, 0.12, -0.55, 0.2, 0.1, EY, sd * 0.25) end
	for i = 0, 2 do
		k.b(head, "Beard", 0.95 - i * 0.22, 0.32, 0.25, (i % 2 == 0) and W or WD, c(0, -0.3 - i * 0.28, -0.5))
	end
	k.tri(head, "BeardTip", 0.2, 0.4, 0.4, W, c(0, -1.25, -0.5) * DOWN * FACE)
	for _, sd in ipairs(SIDES) do
		local pts = { V3(sd * 0.45, 0.3, 0), V3(sd * 0.85, 0.75, 0.05), V3(sd * 0.9, 1.25, 0.15), V3(sd * 0.6, 1.5, 0.05), V3(sd * 0.45, 1.25, -0.15) }
		for i = 1, #pts - 1 do
			k.bar(head, "Horn", pts[i], pts[i + 1], 0.38 - i * 0.05, (i % 2 == 0) and BD or B, nil, nil, V3(0, 0, 1))
		end
	end
end

---------------------------------------------------------------- AURORA FOX (Legendary)
-- Ice-crystal fox: pale-blue body with angular white plates traced by glowing aurora lines, a white
-- spiky ruff with a mint gem, slim legs with aurora bands and white paws, fox head with a long snout,
-- black nose, white cheek spikes, tall ears with mint insides, and three huge flowing aurora ribbon tails.
function M.AuroraFox(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local W, IB, IBD, AU, N, EY = C("#F6F8FB"), C("#D6E6F4"), C("#BFD4E8"), C("#7FF0C8"), C("#26282E"), C("#4FF0C0")
	local BY = 2.3
	local body = k.body(1.2, 1.15, 2.4, IB, BY)
	for i, x in ipairs({ -0.35, 0, 0.35 }) do
		k.tri(body, "Ruff", 0.12, 1.1 - math.abs(x) * 0.8, 0.5, W, c(x, -0.2, -1.22) * DOWN * FACE)
	end
	k.diamond(body, "RuffGem", 0.4, 0.26, 0.1, AU, c(0, 0.05, -1.3), MAT.Glass)
	for _, sd in ipairs(SIDES) do
		k.b(body, "ShoulderPlate", 0.14, 0.75, 0.9, W, c(sd * 0.62, 0.15, -0.75) * ANG(0.3, 0, 0))
		k.b(body, "HipPlate", 0.14, 0.7, 0.8, W, c(sd * 0.62, 0.15, 0.8) * ANG(-0.3, 0, 0))
		local _, ln = k.bar(body, "AuroraLine", V3(sd * 0.7, -0.15, -0.4), V3(sd * 0.7, 0.2, 0.4), 0.06, AU, MAT.Neon, nil, V3(1, 0, 0))
		k.glow(ln, AU)
		for i = 0, 2 do
			k.tri(body, "BackSpike", 0.1, 0.6, 0.45, W, c(sd * 0.35, 0.6, -0.6 + i * 0.6) * ANG(0.7, 0, -sd * 0.5))
		end
	end

	local lg = { up = { 0.48, 0.85, 0.58 }, col = IB, w2 = 0.38, d2 = 0.48, band = AU, paw = { 0.48, 0.36, 0.58 }, pawCol = W, toes = 2, toeCol = IBD }
	k.leg(body, "LegFL", BY, -0.36, -0.45, -0.92, lg)
	k.leg(body, "LegFR", BY, 0.36, -0.45, -0.92, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.36, -0.45, 0.92, lg)
	k.leg(body, "LegBR", BY, 0.36, -0.45, 0.92, lg)
	rig.legKind = "quad"

	k.b(body, "Neck", 0.65, 1.0, 0.7, W, c(0, 0.75, -1.15) * ANG(-0.35, 0, 0))
	local head = k.head(body, 0.8, 0.72, 0.85, W, c(0, 1.45, -1.5), V3(0, -0.3, 0.3))
	k.w(head, "Snout", 0.5, 0.36, 0.65, IB, c(0, -0.15, -0.72))
	k.b(head, "Nose", 0.16, 0.12, 0.1, N, c(0, -0.27, -1.02))
	k.diamond(head, "ForeheadGem", 0.25, 0.16, 0.06, AU, c(0, 0.22, -0.44), MAT.Glass)
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.22, 0.08, -0.44, 0.2, 0.09, EY, sd * 0.35)
		k.tri(head, "CheekSpike", 0.1, 0.55, 0.35, W, c(sd * 0.5, -0.15, 0.05) * ANG(0, 0, -sd * 1.4))
		local ear = k.ear(head, sd, c(sd * 0.25, 0.35, 0.1) * ANG(0, 0, -sd * 0.15))
		k.tri(ear, "Ear", 0.16, 0.95, 0.5, W, c(0, 0.47, 0) * FACE)
		k.tri(ear, "EarInner", 0.06, 0.62, 0.28, AU, c(0, 0.38, -0.09) * FACE)
	end

	-- three broad ribbons rising up and back, curling upward toward the ends
	for i, d in ipairs({ { -0.55, -0.25, W, 0 }, { -0.25, 0.0, AU, 0.25 }, { 0.05, 0.3, AU, 0.3 } }) do
		local segs = {}
		for j = 1, 4 do
			table.insert(segs, { 0.14, 1.05 - j * 0.05, 0.8, d[3], j == 1 and d[1] or -0.12, j == 1 and d[2] * 0.3 or 0, d[4] > 0 and MAT.Glass or nil, d[4] })
		end
		local rec = k.chain(body, c(d[2] * 0.4, 0.35, 1.15), segs, { name = "AuroraTail", kind = "trail", i = i, amp = 0.15, freq = 1.2, lag = 0.5 })
		k.tri(rec.parts[#rec.parts], "RibbonTip", 0.14, 0.6, 0.8, d[3], c(0, 0, 0.6) * ANG(PI / 2, 0, 0), d[4] > 0 and MAT.Glass or nil, d[4])
	end
end

---------------------------------------------------------------- BLIZZARD BEAR (Legendary)
-- Great white bear: shaggy white body with layered fur shards, ice-blue armour plates with blue
-- chevron stripes on shoulders and back, a blue shield pendant, thick legs with pale-blue bands and
-- clawed paws, heavy head with a white mane, dark nose, glowing blue eyes, round ears and an ice crown.
function M.BlizzardBear(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local W, WD, IB, B, N, EY = C("#F7F9FB"), C("#E3E9F0"), C("#A8D5F5"), C("#4FA8F0"), C("#4A4F58"), C("#3FC8FF")
	local BY = 2.2
	local body = k.body(2.0, 1.7, 2.6, W, BY)
	for _, sd in ipairs(SIDES) do
		local _, sp = k.b(body, "ShoulderArmor", 0.25, 1.0, 1.2, IB, c(sd * 1.05, 0.35, -0.6))
		k.b(sp, "Chevron", 0.06, 0.18, 0.9, B, c(sd * 0.14, 0.1, 0) * ANG(0.35, 0, 0))
		for i = 0, 3 do
			k.tri(body, "Fur", 0.14, 0.9, 0.6, (i % 2 == 0) and W or WD, c(sd * 1.0, -0.55, -0.9 + i * 0.6) * ANG(0, 0, sd * 0.25) * DOWN * FACE)
		end
	end
	local _, back = k.b(body, "BackArmor", 1.4, 0.25, 1.4, IB, c(0, 0.9, 0.3))
	k.b(back, "BackChevron", 1.2, 0.27, 0.18, B, c(0, 0, -0.2))
	for i = 0, 3 do
		k.tri(body, "BackFur", 0.14, 0.8, 0.6, W, c((i - 1.5) * 0.45, 0.95, 1.1) * ANG(0.9, 0, 0))
	end
	k.tri(body, "PendantBorder", 0.1, 1.0, 0.75, B, c(0, -0.35, -1.33) * DOWN * FACE)
	k.tri(body, "Pendant", 0.12, 0.8, 0.55, IB, c(0, -0.32, -1.36) * DOWN * FACE)
	k.diamond(body, "PendantGem", 0.32, 0.2, 0.08, B, c(0, -0.2, -1.42), MAT.Glass)

	local lg = { up = { 0.95, 0.7, 1.0 }, col = W, w2 = 0.85, d2 = 0.9, band = IB, paw = { 1.05, 0.4, 1.2 }, pawCol = W, toes = 3, toeCol = WD }
	k.leg(body, "LegFL", BY, -0.65, -0.6, -0.95, lg)
	k.leg(body, "LegFR", BY, 0.65, -0.6, -0.95, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.65, -0.6, 0.95, lg)
	k.leg(body, "LegBR", BY, 0.65, -0.6, 0.95, lg)
	rig.legKind = "quad"

	local head = k.head(body, 1.3, 1.1, 1.2, W, c(0, 0.6, -1.75), V3(0, -0.4, 0.4))
	k.b(head, "Muzzle", 0.8, 0.5, 0.55, W, c(0, -0.25, -0.8))
	k.b(head, "Nose", 0.36, 0.22, 0.12, N, c(0, -0.12, -1.1))
	local jaw = k.jb(head, "Jaw", 0.7, 0.22, 0.7, WD, c(0, -0.55, -0.6), V3(0, 0, 0.35))
	H.group(rig, "jaws", jaw)
	for _, sd in ipairs(SIDES) do
		k.b(head, "Brow", 0.55, 0.2, 0.25, WD, c(sd * 0.33, 0.25, -0.6) * ANG(0, 0, sd * 0.3))
		k.eye(head, sd * 0.33, 0.08, -0.61, 0.28, 0.12, EY, sd * 0.3)
		local ear = k.ear(head, sd, c(sd * 0.5, 0.5, 0.2), "round")
		k.b(ear, "Ear", 0.4, 0.38, 0.22, W, c(0, 0.17, 0))
		for i = 0, 2 do
			k.tri(head, "Mane", 0.14, 0.8, 0.5, (i % 2 == 0) and W or WD, c(sd * 0.7, 0.1 - i * 0.35, 0.3) * ANG(0.3, 0, -sd * (1.2 + i * 0.3)))
		end
	end
	k.b(head, "CrownBand", 1.1, 0.16, 1.0, B, c(0, 0.6, 0.05))
	for i = -2, 2 do
		k.tri(head, "CrownSpike", 0.12, (i == 0) and 0.7 or 0.45, 0.28, (i == 0) and B or IB, c(i * 0.22, (i == 0) and 0.98 or 0.86, -0.45) * FACE)
	end
	k.crystal(head, "CrownGem", 0.55, 0.2, B, c(0, 0.65, -0.5), MAT.Glass, 0.1)
end

---------------------------------------------------------------- CRYSTALWING DRAGON (Mythical)
-- Ice dragon: pale-blue body with white armour plates and a blue crystal on the chest, legs with white
-- greaves, blue bands and white claws, white-and-blue neck, horned head crowned with translucent ice
-- crystals, feathered wings (blue leading bar, white blades over translucent crystal blades), a long
-- white/blue tail lined with ice shards ending in a crystal fan.
function M.Crystalwing(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local IB, IBD, W, B, CR, EY = C("#9FD3F2"), C("#86C2E8"), C("#F6F9FC"), C("#4FA8E8"), C("#8FD8FF"), C("#3FC8FF")
	local BY = 2.3
	local body = k.body(1.8, 1.5, 2.4, IB, BY)
	k.b(body, "ChestPlate", 1.5, 1.4, 0.8, W, c(0, 0.05, -1.1))
	k.diamond(body, "ChestCrystal", 0.9, 0.5, 0.16, B, c(0, 0.05, -1.53), MAT.Glass)
	for _, sd in ipairs(SIDES) do
		k.b(body, "SidePlate", 0.14, 0.9, 1.0, W, c(sd * 0.92, 0.1, 0.2) * ANG(0.4, 0, 0))
	end
	for i = 0, 2 do
		k.crystal(body, "BackShard", 0.8 - i * 0.1, 0.2, CR, c(0, 0.75, -0.7 + i * 0.7) * ANG(0.5, 0, 0), MAT.Glass, 0.2)
	end

	local lf = { up = { 0.8, 0.75, 0.9 }, col = IB, w2 = 0.68, d2 = 0.75, band = B, paw = { 0.95, 0.35, 1.1 }, pawCol = W, toes = 3, toeCol = W }
	local function greave(knee) k.b(knee, "Greave", 0.74, 0.5, 0.82, W, c(0, -0.3, 0)) end
	local _, _, k1 = k.leg(body, "LegFL", BY, -0.75, -0.5, -0.8, lf); greave(k1)
	local _, _, k2 = k.leg(body, "LegFR", BY, 0.75, -0.5, -0.8, lf); greave(k2)
	lf.hind = true
	local _, _, k3 = k.leg(body, "LegBL", BY, -0.78, -0.45, 0.85, lf); greave(k3)
	local _, _, k4 = k.leg(body, "LegBR", BY, 0.78, -0.45, 0.85, lf); greave(k4)
	rig.legKind = "quad"

	k.b(body, "Neck1", 0.85, 0.9, 0.8, W, c(0, 0.75, -1.35) * ANG(-0.5, 0, 0))
	k.b(body, "Neck2", 0.75, 0.85, 0.75, IB, c(0, 1.35, -1.6) * ANG(-0.25, 0, 0))
	local head = k.head(body, 1.0, 0.8, 1.2, IB, c(0, 2.0, -1.95), V3(0, -0.3, 0.4))
	k.b(head, "Snout", 0.7, 0.45, 0.7, IB, c(0, -0.12, -0.85))
	k.b(head, "Crest", 1.05, 0.2, 0.7, W, c(0, 0.45, -0.1))
	local jaw = k.jb(head, "Jaw", 0.66, 0.2, 0.9, IBD, c(0, -0.42, -0.55), V3(0, 0, 0.45))
	H.group(rig, "jaws", jaw)
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.3, 0.1, -0.61, 0.24, 0.1, EY, sd * 0.3)
		for i, d in ipairs({ { 0.3, 1.0, 0.7 }, { 0.5, 0.75, 1.2 }, { 0.2, 0.8, 0.3 } }) do
			k.crystal(head, "IceHorn", d[2], 0.2, CR, c(sd * d[1], 0.45, 0.1 + i * 0.12) * ANG(0.6, 0, -sd * d[3]), MAT.Glass, 0.15)
		end
	end

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.75, 0.6, -0.3))
		-- raised wing: leading bar climbs high then runs out, long blades fan outward beneath it
		k.bar(w, "WingBar", V3(0, 0, 0), V3(sd * 1.3, 2.5, 0), 0.42, B)
		k.bar(w, "WingBar", V3(sd * 1.3, 2.5, 0), V3(sd * 4.0, 3.3, 0), 0.34, B)
		local fw = {}
		for i = 0, 6 do
			table.insert(fw, { 0.55 - i * 0.2, 3.1 - math.abs(i - 1) * 0.22, 0.5, (i % 2 == 0) and W or CR })
		end
		local _, ep = k.pv(w, "FeatherRoot", c(sd * 1.1, 2.0, 0.05))
		k.featherWing(ep, sd, { root = 0.1, z = 0.03, feathers = fw })
		k.featherWing(ep, sd, { root = 1.4, z = -0.03, mat = MAT.Glass, tr = 0.25, feathers = {
			{ 0.3, 2.4, 0.48, CR }, { -0.3, 2.1, 0.48, CR } } })
	end

	local segs = {}
	for j = 1, 9 do
		local w = 0.8 - j * 0.06
		table.insert(segs, { w, w * 0.85, 0.55, (j % 2 == 0) and W or IB, j == 1 and 0.3 or -0.05 })
	end
	local rec = k.chain(body, c(0, 0.1, 1.15), segs, { name = "Tail", kind = "spine", i = 1, amp = 0.15, freq = 1.3, lag = 0.55 })
	for j, p in ipairs(rec.parts) do
		if j % 2 == 1 then
			local w = 0.8 - j * 0.06
			k.crystal(p, "TailShard", 0.7 - j * 0.04, 0.16, CR, c(0, w * 0.42, 0) * ANG(0.6, 0, 0), MAT.Glass, 0.2)
		end
	end
	local last = rec.parts[#rec.parts]
	for _, a in ipairs({ -0.5, 0, 0.5 }) do
		k.crystal(last, "TailFan", 1.0 - math.abs(a) * 0.4, 0.22, CR, c(0, 0, 0.3) * ANG(PI / 2, 0, a), MAT.Glass, 0.2)
	end
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">SpeciesModelsHeaven</string><ProtectedString name="Source"><![CDATA[-- SpeciesModelsHeaven: hand-authored, reference-faithful models for the Heaven world
-- (Cloud Lamb, Halo Chick, Seraphling, Golden Griffin, Celestial Pegasus, Seraph Lion, Archangel Drake,
-- Throne Guardian).
-- Location: ReplicatedStorage > Shared > SpeciesModelsHeaven (ModuleScript), merged into SpeciesModels.

local K = require(script.Parent.ModelKit)
local V3, CF, ANG, PI, MAT, C = K.V3, K.CF, K.ANG, K.PI, K.MAT, K.C
local FACE, DOWN = ANG(0, PI / 2, 0), ANG(0, 0, PI)
local FLAT = ANG(PI / 2, 0, 0)
local SIDES = { -1, 1 }

local M = {}

-- horizontal halo floating and turning above `parent`
local function halo(k, parent, cf, radius, count, col, thick)
	local e, p = k.pv(parent, "HaloPivot", cf)
	table.insert(k.rig.halos, e)
	k.ring(p, "Halo", FLAT, radius, count, thick or 0.16, radius * 6.3 / count + 0.03, thick or 0.16, col)
	return p, e
end

-- inner feather row from the shoulder, filling the wing between body and wrist
local function innerFeathers(k, w, side, colA, colB)
	k.featherWing(w, side, { root = 0.25, z = 0.07, feathers = {
		{ 0.75, 1.5, 0.42, colA }, { 0.4, 1.7, 0.42, colB }, { 0.05, 1.7, 0.42, colA }, { -0.3, 1.5, 0.4, colB } } })
end

-- curled horn as a chain of bars through `pts` (head-local units)
local function curl(k, parent, pts, w0, col, col2)
	for i = 1, #pts - 1 do
		k.bar(parent, "Horn", pts[i], pts[i + 1], w0 - i * 0.03, (col2 and i % 2 == 0) and col2 or col, nil, nil, V3(0, 0, 1))
	end
end

---------------------------------------------------------------- CLOUD LAMB (Common)
-- Woolly lamb: white block body with stepped cream wool tufts on the flanks and chest, dark hooves,
-- white head with a wool cap, glowing pink eyes, floppy white ears with pink insides, big cream curled
-- ram horns, a wool tuft tail.
function M.CloudLamb(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local W, WD, CR, HN, DK, P, EY = C("#F2F0F2"), C("#E2DEE4"), C("#F0E2BE"), C("#EED9A8"), C("#4A4A50"), C("#F5A8C8"), C("#FF5A9A")
	local BY = 1.6
	local body = k.body(1.7, 1.3, 2.0, W, BY)
	for _, sd in ipairs(SIDES) do
		for i, d in ipairs({ { -0.6, -0.35 }, { 0.1, -0.5 }, { 0.75, -0.3 }, { -0.2, 0.25 }, { 0.5, 0.3 } }) do
			k.b(body, "Wool", 0.25, 0.45, 0.6, (i % 2 == 0) and CR or W, c(sd * 0.92, d[2], d[1]))
		end
	end
	for i = 0, 2 do k.b(body, "BackWool", 0.9 - i * 0.15, 0.3, 0.55, (i % 2 == 0) and CR or WD, c(0, 0.75, -0.5 + i * 0.55)) end
	k.b(body, "ChestWool", 1.3, 0.8, 0.3, CR, c(0, -0.1, -1.05))
	k.b(body, "ChestWool2", 0.8, 0.4, 0.3, CR, c(0, -0.6, -1.0))
	local lg = { up = { 0.6, 0.5, 0.65 }, col = W, w2 = 0.52, d2 = 0.58, paw = { 0.6, 0.35, 0.7 }, pawCol = DK }
	k.leg(body, "LegFL", BY, -0.5, -0.5, -0.65, lg)
	k.leg(body, "LegFR", BY, 0.5, -0.5, -0.65, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.5, -0.5, 0.65, lg)
	k.leg(body, "LegBR", BY, 0.5, -0.5, 0.65, lg)
	rig.legKind = "quad"

	local head = k.head(body, 1.0, 1.0, 1.1, W, c(0, 0.95, -1.2), V3(0, -0.4, 0.35))
	k.b(head, "Snout", 0.85, 0.5, 0.45, W, c(0, -0.25, -0.7))
	k.b(head, "WoolCap", 1.05, 0.3, 0.9, W, c(0, 0.6, 0.05))
	k.b(head, "WoolCapFront", 0.7, 0.25, 0.3, WD, c(0, 0.5, -0.5))
	k.b(head, "EyeBand", 0.8, 0.2, 0.06, C("#3A2A3A"), c(0, 0.1, -0.56))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.2, 0.1, -0.59, 0.2, 0.1, EY, sd * 0.2)
		-- floppy ear hanging out and down in front of the horn curl
		local ear = k.ear(head, sd, c(sd * 0.5, 0.05, -0.3) * ANG(0, 0, sd * 0.7), "floppy")
		k.b(ear, "Ear", 0.14, 0.85, 0.48, W, c(0, -0.38, 0))
		k.b(ear, "EarInner", 0.06, 0.6, 0.28, P, c(-sd * 0.06, -0.4, -0.04))
		-- ram horn: a spiral lying in the side plane (reads as a circle from the side)
		curl(k, head, { V3(sd * 0.42, 0.45, 0.05), V3(sd * 0.6, 0.85, 0.35), V3(sd * 0.68, 0.7, 0.8), V3(sd * 0.72, 0.2, 0.85),
			V3(sd * 0.75, -0.05, 0.45), V3(sd * 0.78, 0.15, 0.15), V3(sd * 0.8, 0.45, 0.35) }, 0.44, HN)
	end
	k.tail(body, c(0, 0.3, 1.0), { { 0.55, 0.5, 0.4, -0.4, CR } })
end

---------------------------------------------------------------- HALO CHICK (Uncommon)
-- Big-headed pale-yellow chick: white V bib, gold beak, glowing gold eyes, a gold crest, a gold halo on a
-- little stalk, small wings (white blades with gold edges), stubby gold legs with three-toed feet.
function M.HaloChick(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local Y, YD, GO, W, EY = C("#F7EFA8"), C("#EEDF86"), C("#F2C230"), C("#F6F4F0"), C("#FFC81E")
	local BY = 1.5
	local body = k.body(1.3, 1.25, 1.2, Y, BY)
	k.tri(body, "Bib", 0.12, 0.8, 1.0, W, c(0, -0.1, -0.62) * DOWN * FACE)
	local lg = { up = { 0.38, 0.35, 0.42 }, col = GO, w2 = 0.3, d2 = 0.34, paw = { 0.7, 0.2, 0.75, -0.12 }, pawCol = GO, toes = 3, toeCol = GO }
	k.leg(body, "LegL", BY, -0.33, -0.6, 0.05, lg)
	k.leg(body, "LegR", BY, 0.33, -0.6, 0.05, lg)
	rig.legKind = "biped"

	local head = k.head(body, 1.2, 1.1, 1.1, Y, c(0, 1.2, -0.15), V3(0, -0.45, 0.2))
	k.w(head, "Beak", 0.42, 0.35, 0.45, GO, c(0, -0.12, -0.75))
	k.b(head, "BeakLow", 0.3, 0.12, 0.25, YD, c(0, -0.32, -0.65))
	for _, sd in ipairs(SIDES) do
		k.b(head, "EyeSocket", 0.32, 0.18, 0.05, C("#5A4A20"), c(sd * 0.28, 0.12, -0.56))
		k.eye(head, sd * 0.28, 0.12, -0.58, 0.26, 0.12, EY, sd * 0.25)
	end
	k.b(head, "Crest", 0.3, 0.4, 0.5, GO, c(0.05, 0.7, -0.1) * ANG(0.3, 0, 0))
	k.b(head, "Crest2", 0.26, 0.3, 0.4, GO, c(0.05, 0.65, 0.25) * ANG(0.6, 0, 0))
	k.b(head, "HaloStalk", 0.12, 0.6, 0.12, GO, c(0, 0.9, 0))
	halo(k, head, c(0, 1.25, 0), 0.6, 8, GO, 0.18)

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.62, 0.25, 0.05))
		k.featherWing(w, sd, { root = 0.1, z = 0.04, thick = 0.14, feathers = { { 0.5, 1.2, 0.36, W }, { 0.2, 1.1, 0.36, W }, { -0.1, 0.9, 0.34, Y } } })
		k.bar(w, "WingEdge", V3(sd * 0.1, 0.05, -0.08), V3(sd * 1.2, 0.65, -0.08), 0.12, GO)
	end
	k.tail(body, c(0, 0.15, 0.55), { { 0.7, 0.35, 0.5, -0.4, Y } })
end

---------------------------------------------------------------- SERAPHLING (Rare)
-- Small armoured angel: cream torso with a gold triangle gem, white tabard with gold border, cream plated
-- skirt, legs with white boots and gold bands, arms with white cuffs and fists, cream helmet with white
-- fin crests and glowing gold eyes, gold halo, big layered white/cream wings with gold stripes.
function M.Seraphling(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local CR, CRD, W, GO, EY = C("#F2E6CC"), C("#E2D2B0"), C("#F7F7F5"), C("#F5C83A"), C("#FFD84A")
	local BY = 2.3
	local body = k.body(0.9, 0.9, 0.6, CR, BY)
	k.tri(body, "ChestGem", 0.1, 0.35, 0.45, GO, c(0, 0.15, -0.32) * DOWN * FACE)
	k.b(body, "Belt", 0.95, 0.15, 0.65, GO, c(0, -0.45, 0))
	local te, tp = k.pv(body, "Tabard", c(0, -0.5, -0.32))
	table.insert(rig.tail, te)
	k.b(tp, "TabardBorder", 0.42, 0.95, 0.06, GO, c(0, -0.45, 0))
	k.b(tp, "Tabard", 0.3, 0.85, 0.08, W, c(0, -0.42, -0.02))
	for _, sd in ipairs(SIDES) do
		k.b(body, "SkirtPlate", 0.35, 0.6, 0.55, CRD, c(sd * 0.32, -0.75, 0.02) * ANG(0, 0, sd * 0.15))
		k.b(body, "Shoulder", 0.4, 0.35, 0.5, CR, c(sd * 0.58, 0.32, 0))
	end
	local lg = { up = { 0.3, 0.45, 0.32 }, col = CR, w2 = 0.28, d2 = 0.3, band = GO, bandY = 0.25, paw = { 0.32, 0.25, 0.36 }, pawCol = W, lh = 0.45 }
	k.leg(body, "LegL", BY, -0.2, -0.5, 0, lg)
	k.leg(body, "LegR", BY, 0.2, -0.5, 0, lg)
	rig.legKind = "biped"
	for _, sd in ipairs(SIDES) do
		local a = k.arm(body, sd, c(sd * 0.6, 0.2, 0))
		k.b(a, "UpperArm", 0.28, 0.5, 0.28, CR, c(sd * 0.05, -0.25, 0))
		k.b(a, "Cuff", 0.32, 0.22, 0.32, W, c(sd * 0.08, -0.6, -0.05))
		k.b(a, "Fist", 0.3, 0.3, 0.3, CR, c(sd * 0.08, -0.85, -0.08))
	end

	local head = k.head(body, 0.6, 0.55, 0.55, CR, c(0, 0.75, 0), V3(0, -0.27, 0.05))
	k.b(head, "Visor", 0.5, 0.2, 0.05, C("#5A4A30"), c(0, 0.0, -0.29))
	k.w(head, "FaceGuard", 0.45, 0.25, 0.15, W, c(0, -0.2, -0.3) * DOWN)
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.12, 0.0, -0.31, 0.14, 0.07, EY, sd * 0.3)
		k.tri(head, "Fin", 0.08, 0.5, 0.3, W, c(sd * 0.28, 0.3, 0.05) * ANG(0, 0, -sd * 0.4) * FACE)
	end
	k.tri(head, "CrestFin", 0.08, 0.55, 0.35, W, c(0, 0.45, 0))
	halo(k, head, c(0, 0.7, 0), 0.5, 10, GO, 0.1)

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.4, 0.25, 0.25) * ANG(0, -sd * 0.3, 0))
		k.bar(w, "WingArm", V3(0, 0, 0), V3(sd * 1.2, 1.0, 0), 0.32, CR)
		k.bar(w, "WingStripe", V3(sd * 0.3, 0.35, -0.12), V3(sd * 1.1, 1.0, -0.12), 0.1, GO)
		local _, fp = k.pv(w, "FeatherRoot", c(sd * 0.9, 0.85, 0.03))
		k.featherWing(fp, sd, { root = 0.1, z = 0.04, feathers = {
			{ 0.4, 1.6, 0.38, W }, { 0.05, 1.8, 0.38, CR }, { -0.35, 1.7, 0.38, W }, { -0.75, 1.4, 0.36, CR }, { -1.1, 1.0, 0.34, W } } })
	end
end

---------------------------------------------------------------- GOLDEN GRIFFIN (Epic)
-- Eagle-lion: golden body, eagle front with a layered cream feather bib, eagle front legs with cream
-- cuffs and bronze talons, lion hind legs with cream paws, eagle head with cream face, hooked beak,
-- glowing eyes and a bronze crown with a gem, raised golden wings with cream feathers, lion tail ending
-- in a cream feather fan.
function M.GoldGriffin(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local Y, YD, YL, CR, BR, EY = C("#F5C42E"), C("#DFA21E"), C("#F7D35A"), C("#F2DDB0"), C("#B9741E"), C("#FFE45C")
	local BY = 2.2
	local body = k.body(1.7, 1.5, 2.4, Y, BY)
	k.b(body, "Chest", 1.6, 1.5, 0.8, YL, c(0, 0.05, -1.1))
	for i = 0, 2 do
		for _, x in ipairs({ -0.35, 0, 0.35 }) do
			k.tri(body, "Bib", 0.12, 0.75, 0.42, (i % 2 == 0) and CR or C("#FFF4DC"), c(x, 0.45 - i * 0.4, -1.52 - i * 0.03) * DOWN * FACE)
		end
	end
	local lf = { up = { 0.7, 0.75, 0.8 }, col = Y, w2 = 0.55, d2 = 0.6, band = CR, paw = { 0.85, 0.35, 0.95 }, pawCol = Y, toes = 3, toeCol = BR }
	k.leg(body, "LegFL", BY, -0.6, -0.5, -0.85, lf)
	k.leg(body, "LegFR", BY, 0.6, -0.5, -0.85, lf)
	local lh = { up = { 0.8, 0.8, 0.95 }, col = Y, w2 = 0.6, d2 = 0.7, paw = { 0.8, 0.35, 0.9 }, pawCol = CR, toes = 3, toeCol = CR, hind = true }
	k.leg(body, "LegBL", BY, -0.62, -0.45, 0.85, lh)
	k.leg(body, "LegBR", BY, 0.62, -0.45, 0.85, lh)
	rig.legKind = "quad"

	local head = k.head(body, 0.95, 0.9, 1.0, Y, c(0, 1.3, -1.45), V3(0, -0.4, 0.3))
	k.b(head, "Face", 0.97, 0.6, 0.6, CR, c(0, -0.1, -0.22))
	k.w(head, "Beak", 0.45, 0.4, 0.55, YD, c(0, -0.05, -0.75))
	k.b(head, "BeakHook", 0.3, 0.3, 0.15, BR, c(0, -0.25, -1.0))
	for _, sd in ipairs(SIDES) do
		k.b(head, "Brow", 0.4, 0.14, 0.2, YD, c(sd * 0.25, 0.22, -0.52) * ANG(0, 0, sd * 0.3))
		k.eye(head, sd * 0.25, 0.08, -0.53, 0.22, 0.1, EY, sd * 0.3)
	end
	k.b(head, "CrownBand", 0.9, 0.2, 0.85, BR, c(0, 0.52, 0))
	for i = -1, 1 do k.b(head, "Crenel", 0.18, 0.25, 0.18, BR, c(i * 0.33, 0.72, -0.35)) end
	k.diamond(head, "CrownGem", 0.35, 0.22, 0.08, YL, c(0, 0.55, -0.45), MAT.Glass)

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.75, 0.6, -0.3))
		k.bar(w, "WingArm", V3(0, 0, 0), V3(sd * 1.3, 2.3, 0), 0.42, Y)
		k.bar(w, "WingArm", V3(sd * 1.3, 2.3, 0), V3(sd * 3.4, 2.9, 0), 0.34, YD)
		local _, fp = k.pv(w, "FeatherRoot", c(sd * 1.2, 2.0, 0.04))
		local fw = {}
		for i = 0, 6 do table.insert(fw, { 0.5 - i * 0.22, 2.7 - math.abs(i - 1) * 0.2, 0.45, (i % 2 == 0) and CR or YL }) end
		k.featherWing(fp, sd, { root = 0.1, z = 0.04, feathers = fw })
		innerFeathers(k, w, sd, CR, YL)
	end

	local tip = k.tail(body, c(0, 0.2, 1.2), { { 0.3, 0.3, 0.7, 0.3, Y }, { 0.28, 0.28, 0.7, -0.4, Y }, { 0.26, 0.26, 0.6, -0.4, Y } })
	for _, a in ipairs({ -0.5, 0, 0.5 }) do
		k.tri(tip, "TailFeather", 0.1, 0.8, 0.3, CR, c(0, 0, 0.35) * ANG(PI / 2 - 0.3, a, 0) * c(0, 0.35, 0))
	end
end

---------------------------------------------------------------- CELESTIAL PEGASUS (Legendary)
-- Armoured white pegasus: gold trim and a gold star on the chest, long legs with gold bands and gold
-- hooves, pale-blue flowing mane with gold edging, a gold halo, huge wings (gold leading edge, white and
-- pale-blue feathers), long flowing blue and white tail ribbons.
function M.Pegasus(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local W, WD, BL, GO, EY = C("#F7F8FA"), C("#E4E8EE"), C("#B8D4F0"), C("#F2C230"), C("#FFE45C")
	local BY = 2.9
	local body = k.body(1.35, 1.3, 2.7, W, BY)
	k.b(body, "ChestPlate", 1.4, 1.2, 0.6, W, c(0, 0.05, -1.25))
	k.diamond(body, "ChestStar", 0.8, 0.5, 0.12, GO, c(0, 0.05, -1.57))
	k.diamond(body, "ChestStar2", 0.5, 0.8, 0.1, GO, c(0, 0.05, -1.56))
	for _, sd in ipairs(SIDES) do
		k.b(body, "Trim", 0.08, 0.14, 2.2, GO, c(sd * 0.69, 0.45, 0))
		k.b(body, "HipShield", 0.12, 0.8, 0.8, GO, c(sd * 0.7, 0.05, 0.9) * ANG(PI / 4, 0, 0))
		k.b(body, "HipShieldIn", 0.14, 0.6, 0.6, W, c(sd * 0.71, 0.05, 0.9) * ANG(PI / 4, 0, 0))
	end
	local lf = { up = { 0.55, 1.0, 0.65 }, col = W, w2 = 0.42, d2 = 0.5, band = GO, bandY = 0.3, paw = { 0.52, 0.4, 0.62 }, pawCol = GO, toes = 2, toeCol = GO }
	k.leg(body, "LegFL", BY, -0.42, -0.5, -1.0, lf)
	k.leg(body, "LegFR", BY, 0.42, -0.5, -1.0, lf)
	lf.hind = true
	k.leg(body, "LegBL", BY, -0.42, -0.45, 1.0, lf)
	k.leg(body, "LegBR", BY, 0.42, -0.45, 1.0, lf)
	rig.legKind = "quad"

	k.b(body, "Neck", 0.7, 1.45, 0.75, W, c(0, 1.05, -1.4) * ANG(-0.4, 0, 0))
	local head = k.head(body, 0.7, 0.7, 1.3, W, c(0, 1.95, -2.0), V3(0, -0.2, 0.5))
	k.w(head, "Snout", 0.6, 0.42, 0.6, W, c(0, -0.1, -0.85))
	k.b(head, "Faceplate", 0.72, 0.14, 0.8, GO, c(0, 0.36, -0.2))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.28, 0.12, -0.66, 0.18, 0.09, EY, sd * 0.3)
		local ear = k.ear(head, sd, c(sd * 0.24, 0.38, 0.2))
		k.tri(ear, "Ear", 0.12, 0.45, 0.28, W, c(0, 0.22, 0) * FACE)
	end
	halo(k, head, c(0, 0.9, 0.1), 0.6, 12, GO)
	local maneCols = { BL, W, BL, BL, W, BL, BL }
	for i = 1, 7 do
		local me, mp = k.pv(body, "ManeRoot", c(0, 1.8 - (i - 1) * 0.2, -1.55 + (i - 1) * 0.12) * ANG(0.9 + i * 0.07, 0, 0))
		if i % 2 == 0 then H.group(rig, "flutter", me) end
		k.tri(mp, "Mane", 0.25, 1.4 - i * 0.05, 0.6, maneCols[i], c(0, 0.65, 0))
		k.tri(mp, "ManeGold", 0.27, 0.6, 0.15, GO, c(0, 0.4, 0.22))
	end

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.65, 0.6, -0.5))
		k.bar(w, "WingArm", V3(0, 0, 0), V3(sd * 1.2, 2.3, 0), 0.38, GO)
		k.bar(w, "WingArm", V3(sd * 1.2, 2.3, 0), V3(sd * 3.4, 3.1, 0), 0.3, GO)
		local _, fp = k.pv(w, "FeatherRoot", c(sd * 1.1, 2.0, 0.04))
		local fw = {}
		for i = 0, 6 do table.insert(fw, { 0.55 - i * 0.22, 2.8 - math.abs(i - 1) * 0.2, 0.42, (i % 2 == 0) and W or BL }) end
		k.featherWing(fp, sd, { root = 0.1, z = 0.04, feathers = fw })
		innerFeathers(k, w, sd, W, BL)
	end

	for i, d in ipairs({ { -0.2, BL }, { 0.1, W }, { 0.4, BL } }) do
		local segs = {}
		for j = 1, 4 do table.insert(segs, { 0.14, 0.75 - j * 0.06, 0.75, d[2], j == 1 and (0.5 + d[1]) or 0.15 }) end
		local rec = k.chain(body, c(d[1] * 0.4, 0.4, 1.35), segs, { name = "TailRibbon", kind = "trail", i = i, amp = 0.14, freq = 1.2, lag = 0.5 })
		k.b(rec.parts[2], "RibbonGold", 0.16, 0.12, 0.7, GO, c(0, 0.3, 0))
	end
end

---------------------------------------------------------------- SERAPH LION (Legendary)
-- Celestial lion: cream body with gold-framed shields on the hips, legs with gold bands and big cream
-- paws, a huge mane of white and gold blades, cream head with muzzle, dark nose, glowing gold eyes and a
-- forehead gem, a gold halo, raised white wings with gold tips, a tail ending in a white-and-gold tuft.
function M.SeraphLion(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local CR, CRD, W, GO, N, EY = C("#F2E6C8"), C("#E2D2AE"), C("#F7F7F5"), C("#F2C02E"), C("#4A4A4A"), C("#FFD23A")
	local BY = 2.0
	local body = k.body(1.8, 1.5, 2.6, CR, BY)
	for _, sd in ipairs(SIDES) do
		k.b(body, "HipShield", 0.12, 0.9, 0.75, GO, c(sd * 0.91, 0.1, 0.8))
		k.b(body, "HipShieldIn", 0.14, 0.7, 0.55, W, c(sd * 0.92, 0.1, 0.8))
		k.diamond(body, "HipGem", 0.45, 0.25, 0.06, GO, c(sd * 0.96, 0.1, 0.8) * ANG(0, -sd * PI / 2, 0))
	end
	local lg = { up = { 0.85, 0.7, 0.95 }, col = CR, w2 = 0.75, d2 = 0.82, band = GO, paw = { 0.95, 0.38, 1.1 }, pawCol = CR, toes = 3, toeCol = CRD }
	k.leg(body, "LegFL", BY, -0.6, -0.5, -0.9, lg)
	k.leg(body, "LegFR", BY, 0.6, -0.5, -0.9, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.6, -0.5, 0.95, lg)
	k.leg(body, "LegBR", BY, 0.6, -0.5, 0.95, lg)
	rig.legKind = "quad"

	local head = k.head(body, 1.1, 1.0, 1.0, CR, c(0, 1.0, -1.65), V3(0, -0.4, 0.35))
	k.b(head, "Muzzle", 0.65, 0.42, 0.45, CR, c(0, -0.28, -0.62))
	k.b(head, "Nose", 0.25, 0.14, 0.1, N, c(0, -0.1, -0.86))
	k.b(head, "Jaw", 0.5, 0.18, 0.35, CRD, c(0, -0.5, -0.55))
	k.diamond(head, "ForeheadGem", 0.35, 0.22, 0.08, GO, c(0, 0.28, -0.52))
	for _, sd in ipairs(SIDES) do
		k.b(head, "Brow", 0.38, 0.12, 0.15, CRD, c(sd * 0.25, 0.14, -0.5) * ANG(0, 0, sd * 0.3))
		k.eye(head, sd * 0.25, 0.04, -0.51, 0.22, 0.09, EY, sd * 0.3)
	end
	-- mane: two rings of white/gold blades around the face
	local me, mp = k.pv(head, "Mane", c(0, 0.05, 0.1))
	for ring = 0, 1 do
		for i = 0, 9 do
			local a = (i + ring * 0.5) / 10 * PI * 2
			local col = ((i + ring) % 2 == 0) and GO or W
			-- broad blade facing forward, radiating out from the face and swept back
			k.tri(mp, "Mane", 0.14, 1.35 - ring * 0.3, 0.75, col, CF(math.sin(a) * 0.82 * s, math.cos(a) * 0.75 * s, (-0.1 + ring * 0.35) * s) * ANG(0, 0, -a) * ANG(0.3 + ring * 0.25, 0, 0) * c(0, 0.55, 0) * FACE)
		end
	end
	halo(k, head, c(0, 1.25, 0.2), 0.7, 14, GO, 0.12)

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.75, 0.6, -0.3))
		k.featherWing(w, sd, { root = 0.2, z = 0.05, thick = 0.18, feathers = {
			{ 1.0, 2.4, 0.5, W, GO }, { 0.75, 2.8, 0.52, W, GO }, { 0.5, 3.0, 0.52, W, GO }, { 0.25, 2.7, 0.5, W, GO }, { 0.0, 2.2, 0.48, W, GO } } })
	end

	local tip = k.tail(body, c(0, 0.3, 1.3), { { 0.32, 0.32, 0.7, 0.2, CR }, { 0.3, 0.3, 0.6, -0.3, CR }, { 0.28, 0.28, 0.55, -0.3, CRD } })
	k.spike(tip, "TailTuft", 0.8, 0.4, W, c(0, 0, 0.3) * ANG(PI / 2, 0, 0))
	k.spike(tip, "TailTuftGold", 0.6, 0.3, GO, c(0, 0.15, 0.3) * ANG(PI / 2 - 0.5, 0, 0))
end

---------------------------------------------------------------- ARCHANGEL DRAKE (Mythical)
-- Holy dragon: white and cream armoured body with a gold V chest plate, legs with gold bands and claws,
-- white neck with gold trim, head with a long gold unicorn horn, a gold crown and spiky white mane, a gold
-- halo with studs, enormous layered wings (gold arm, white/cream/gold blades), a spiked tail ending in a
-- gold arrowhead.
function M.ArchDrake(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local CR, W, GO, GOD, EY = C("#F2E8D0"), C("#F8F8F6"), C("#F2C230"), C("#D8A41E"), C("#FFD84A")
	local BY = 2.3
	local body = k.body(1.7, 1.45, 2.4, W, BY)
	k.tri(body, "ChestV", 0.16, 1.2, 1.5, GO, c(0, 0.1, -1.23) * DOWN * FACE)
	k.tri(body, "ChestVIn", 0.18, 0.8, 0.9, CR, c(0, 0.15, -1.25) * DOWN * FACE)
	for _, sd in ipairs(SIDES) do k.b(body, "SidePlate", 0.12, 0.8, 1.6, CR, c(sd * 0.86, 0.0, 0.3)) end
	local lf = { up = { 0.8, 0.75, 0.9 }, col = W, w2 = 0.66, d2 = 0.72, col2 = CR, band = GO, paw = { 0.92, 0.35, 1.05 }, pawCol = CR, toes = 3, toeCol = GO }
	k.leg(body, "LegFL", BY, -0.72, -0.5, -0.8, lf)
	k.leg(body, "LegFR", BY, 0.72, -0.5, -0.8, lf)
	lf.hind = true
	k.leg(body, "LegBL", BY, -0.74, -0.45, 0.85, lf)
	k.leg(body, "LegBR", BY, 0.74, -0.45, 0.85, lf)
	rig.legKind = "quad"

	for i = 0, 2 do
		local _, n = k.b(body, "Neck", 0.72 - i * 0.04, 0.75, 0.7, (i % 2 == 0) and W or CR, c(0, 0.8 + i * 0.6, -1.3 - i * 0.18) * ANG(-0.3, 0, 0))
		k.b(n, "NeckTrim", 0.74, 0.1, 0.72, GO, c(0, 0.3, 0))
	end
	local head = k.head(body, 0.85, 0.7, 1.1, W, c(0, 2.45, -1.95), V3(0, -0.25, 0.4))
	k.w(head, "Snout", 0.6, 0.4, 0.6, W, c(0, -0.1, -0.8))
	k.spike(head, "UnicornHorn", 1.6, 0.28, GO, c(0, 0.3, -0.3) * ANG(-0.5, 0, 0))
	k.b(head, "CrownBand", 0.8, 0.18, 0.7, GO, c(0, 0.4, 0.05))
	for i = -1, 1 do k.tri(head, "CrownSpike", 0.1, 0.35, 0.2, GO, c(i * 0.25, 0.62, 0.05) * FACE) end
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.25, 0.1, -0.56, 0.22, 0.09, EY, sd * 0.3)
		for i = 0, 2 do
			k.tri(head, "Mane", 0.12, 0.7 - i * 0.1, 0.4, (i == 1) and CR or W, c(sd * 0.45, 0.2 - i * 0.3, 0.3) * ANG(0.4, 0, -sd * (1.1 + i * 0.25)))
		end
	end
	local hp = halo(k, head, c(0, 1.25, 0.15), 0.75, 12, GO)
	for i = 0, 3 do
		local a = i * PI / 2 + PI / 4
		k.b(hp, "HaloStud", 0.2, 0.26, 0.2, GOD, k.c(math.cos(a) * 0.75, 0, math.sin(a) * 0.75))
	end

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.75, 0.6, -0.2))
		k.bar(w, "WingArm", V3(0, 0, 0), V3(sd * 1.3, 2.3, 0), 0.42, GO)
		k.bar(w, "WingArm", V3(sd * 1.3, 2.3, 0), V3(sd * 3.5, 2.8, 0), 0.34, GO)
		local _, fp = k.pv(w, "FeatherRoot", c(sd * 1.3, 2.1, 0.04))
		local cols = { W, CR, GO, W, CR, W, GO }
		local fw = {}
		for i = 0, 6 do table.insert(fw, { 0.55 - i * 0.24, 2.9 - math.abs(i - 1) * 0.2, 0.44, cols[i + 1] }) end
		k.featherWing(fp, sd, { root = 0.1, z = 0.04, feathers = fw })
		innerFeathers(k, w, sd, W, CR)
	end

	local segs = {}
	for j = 1, 9 do
		local w = 0.72 - j * 0.045
		table.insert(segs, { w, w * 0.85, 0.55, (j % 2 == 0) and CR or W, j == 1 and 0.3 or -0.04 })
	end
	local rec = k.chain(body, c(0, 0.1, 1.15), segs, { name = "Tail", kind = "spine", i = 1, amp = 0.14, freq = 1.2, lag = 0.55 })
	for j, p in ipairs(rec.parts) do
		if j % 2 == 1 then
			local w = 0.72 - j * 0.045
			k.tri(p, "TailSpike", 0.1, 0.45, 0.35, GO, c(0, w * 0.42 + 0.18, 0) * ANG(0.4, 0, 0))
		end
	end
	local tipRot = ANG(0, PI / 2, 0) * ANG(0, 0, PI / 2)
	k.tri(rec.parts[#rec.parts], "Arrow", 0.14, 0.8, 0.9, GO, c(0, 0, 0.65) * tipRot)
end

---------------------------------------------------------------- THRONE GUARDIAN (Mythical)
-- Hovering throne angel: white armoured torso with a glowing gold gem in a gold frame, long gold tabard
-- with a white border, layered white/pale-gold robe blades, big stepped shoulder pads with gold trim,
-- big arms ending in open palms, white helmet with a gold crown and glowing eyes, a gold halo carrying
-- three crystals, huge layered wings with stepped gold bars.
function M.ThroneAngel(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local W, WD, GO, YL, GEM = C("#F2F2F4"), C("#DCDCE2"), C("#F2C230"), C("#F7E08A"), C("#FFD23A")
	local BY = 3.0
	local body = k.body(2.0, 1.8, 1.3, W, BY)
	rig.legKind = "none"
	k.b(body, "GemFrame", 0.9, 0.9, 0.12, GO, c(0, 0.25, -0.7) * ANG(0, 0, PI / 4))
	local _, gem = k.b(body, "Gem", 0.55, 0.55, 0.14, GEM, c(0, 0.25, -0.73) * ANG(0, 0, PI / 4), MAT.Neon)
	k.glow(gem, GEM)
	k.b(body, "Waist", 1.6, 0.4, 1.1, WD, c(0, -1.05, 0))
	local te, tp = k.pv(body, "Tabard", c(0, -1.1, -0.6))
	table.insert(rig.tail, te)
	k.b(tp, "TabardBorder", 0.95, 1.6, 0.08, W, c(0, -0.8, 0))
	k.b(tp, "Tabard", 0.7, 1.45, 0.1, GO, c(0, -0.75, -0.02))
	k.tri(tp, "TabardTip", 0.1, 0.5, 0.95, GO, c(0, -1.85, 0) * DOWN * FACE)
	for i, x in ipairs({ -0.85, -0.55, 0.55, 0.85, -0.3, 0.3 }) do
		local re, rp = k.pv(body, "RobePivot", c(x, -1.1, (i > 4) and 0.4 or 0) * ANG(0, 0, x * 0.25))
		table.insert(rig.tail, re)
		k.tri(rp, "Robe", 0.14, 1.9 - math.abs(x) * 0.5, 0.55, (i % 2 == 0) and YL or W, c(0, -(1.9 - math.abs(x) * 0.5) / 2, 0) * DOWN * FACE)
	end

	for _, sd in ipairs(SIDES) do
		local a = k.arm(body, sd, c(sd * 1.25, 0.55, 0))
		k.b(a, "Shoulder", 1.1, 0.7, 1.1, W, c(sd * 0.25, 0.25, 0))
		k.b(a, "ShoulderTrim", 1.12, 0.14, 1.12, GO, c(sd * 0.25, 0.0, 0))
		k.b(a, "ShoulderStep", 0.7, 0.3, 0.9, WD, c(sd * 0.4, 0.62, 0))
		k.b(a, "UpperArm", 0.75, 0.9, 0.75, W, c(sd * 0.3, -0.5, 0))
		k.b(a, "Forearm", 0.95, 0.8, 0.95, WD, c(sd * 0.35, -1.3, -0.15) * ANG(-0.5, 0, 0))
		k.b(a, "Cuff", 1.0, 0.16, 1.0, GO, c(sd * 0.35, -1.05, -0.05) * ANG(-0.5, 0, 0))
		local _, hand = k.b(a, "Palm", 0.85, 0.25, 0.8, W, c(sd * 0.4, -1.75, -0.65))
		for f = 1, 4 do k.b(hand, "Finger", 0.16, 0.3, 0.16, W, c((f - 2.5) * 0.2, 0.2, -0.4)) end
	end

	local head = k.head(body, 0.8, 0.8, 0.8, W, c(0, 1.3, -0.05), V3(0, -0.38, 0.1))
	k.b(head, "Visor", 0.62, 0.2, 0.05, C("#5A5A68"), c(0, 0.02, -0.41))
	for _, sd in ipairs(SIDES) do k.eye(head, sd * 0.15, 0.02, -0.44, 0.16, 0.08, GEM, sd * 0.25) end
	k.b(head, "CrownBand", 0.85, 0.18, 0.85, GO, c(0, 0.42, 0))
	for i = -2, 2 do k.tri(head, "CrownSpike", 0.1, (i == 0) and 0.5 or 0.32, 0.18, GO, c(i * 0.17, (i == 0) and 0.72 or 0.62, -0.35) * FACE) end
	local hp = halo(k, head, c(0, 1.1, 0.15), 0.95, 14, GO)
	for _, a in ipairs({ PI / 2, PI / 2 + 2.1, PI / 2 - 2.1 }) do
		local _, cr = k.b(hp, "HaloCrystalBase", 0.18, 0.12, 0.18, GO, k.c(math.cos(a) * 0.95, 0.08, -math.sin(a) * 0.95))
		k.crystal(hp, "HaloCrystal", 0.5, 0.18, YL, k.c(math.cos(a) * 0.95, 0.12, -math.sin(a) * 0.95), MAT.Glass, 0.05)
	end

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.8, 0.55, 0.35))
		k.bar(w, "WingArm", V3(0, 0, 0), V3(sd * 1.2, 1.4, 0), 0.5, W)
		k.bar(w, "WingArm", V3(sd * 1.2, 1.4, 0), V3(sd * 2.6, 2.0, 0), 0.42, W)
		k.bar(w, "WingStep", V3(sd * 0.4, 0.55, -0.15), V3(sd * 1.3, 1.6, -0.15), 0.14, GO)
		k.bar(w, "WingStep", V3(sd * 1.3, 1.6, -0.15), V3(sd * 2.4, 2.05, -0.15), 0.14, GO)
		local _, fp = k.pv(w, "FeatherRoot", c(sd * 1.0, 1.2, 0.04))
		local fw = {}
		for i = 0, 6 do table.insert(fw, { 0.45 - i * 0.28, 2.7 - math.abs(i - 2) * 0.2, 0.45, (i % 2 == 0) and W or YL }) end
		k.featherWing(fp, sd, { root = 0.1, z = 0.04, feathers = fw })
	end
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">SpeciesModelsSecret</string><ProtectedString name="Source"><![CDATA[-- SpeciesModelsSecret: hand-authored, reference-faithful models for the Secret portal creatures
-- (Glitchling, Void Emperor, Error Cat, Null Bunny, The Watcher).
-- Location: ReplicatedStorage > Shared > SpeciesModelsSecret (ModuleScript), merged into SpeciesModels.

local K = require(script.Parent.ModelKit)
local V3, CF, ANG, PI, MAT, C = K.V3, K.CF, K.ANG, K.PI, K.MAT, K.C
local FACE, DOWN = ANG(0, PI / 2, 0), ANG(0, 0, PI)
local FLAT = ANG(PI / 2, 0, 0)
local SIDES = { -1, 1 }

local M = {}

-- glowing line between two points on a part (Neon bar registered as a glow)
local function line(k, parent, A, B, w, col, up)
	local _, p = k.bar(parent, "GlowLine", A, B, w, col, MAT.Neon, nil, up, w * 0.6)
	k.glow(p, col)
end

---------------------------------------------------------------- GLITCHLING (Secret)
-- Corrupted pup: black blocky body traced with magenta lines and turquoise plates, a turquoise visor
-- framing a dark screen with one big glowing magenta pixel eye, turquoise chin, tall black ears with
-- magenta edges, black legs with turquoise feet bands, a zigzag pixel tail and loose pixel cubes that
-- drift around it (they scatter on the power move).
function M.Glitchling(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local BK, BKL, TQ, MG = C("#1A1A1F"), C("#2A2A32"), C("#3FF0C0"), C("#FF2AA8")
	local BY = 1.55
	local body = k.body(1.4, 1.2, 1.7, BK, BY)
	k.b(body, "BackPlate", 1.2, 0.2, 1.0, TQ, c(0, 0.62, 0.2))
	for _, sd in ipairs(SIDES) do
		line(k, body, V3(sd * 0.71, 0.4, -0.7), V3(sd * 0.71, 0.4, 0.1), 0.1, MG, V3(1, 0, 0))
		line(k, body, V3(sd * 0.71, 0.4, 0.1), V3(sd * 0.71, -0.3, 0.1), 0.1, MG, V3(1, 0, 0))
		k.b(body, "SidePlate", 0.08, 0.35, 0.5, TQ, c(sd * 0.72, -0.35, 0.55))
	end
	local lg = { up = { 0.6, 0.5, 0.65 }, col = BK, w2 = 0.5, d2 = 0.6, band = TQ, bandY = 0.35, paw = { 0.7, 0.3, 0.8 }, pawCol = BK }
	k.leg(body, "LegFL", BY, -0.45, -0.45, -0.6, lg)
	k.leg(body, "LegFR", BY, 0.45, -0.45, -0.6, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.45, -0.45, 0.6, lg)
	k.leg(body, "LegBR", BY, 0.45, -0.45, 0.6, lg)
	rig.legKind = "quad"

	local head = k.head(body, 1.15, 1.0, 1.0, BK, c(0, 0.9, -0.95), V3(0, -0.4, 0.3))
	k.b(head, "VisorTop", 1.25, 0.28, 1.05, TQ, c(0, 0.4, -0.02))
	for _, sd in ipairs(SIDES) do k.b(head, "VisorSide", 0.22, 0.75, 1.05, TQ, c(sd * 0.55, 0.0, -0.02)) end
	k.b(head, "Screen", 0.8, 0.55, 0.06, BKL, c(0, 0.0, -0.52))
	local e, p = k.b(head, "PixelEye", 0.3, 0.3, 0.06, MG, c(0, 0.0, -0.56), MAT.Neon)
	table.insert(rig.eyes, e)
	k.glow(p, MG)
	k.w(head, "Chin", 0.9, 0.3, 0.4, TQ, c(0, -0.55, -0.4) * DOWN)
	for _, sd in ipairs(SIDES) do
		local ear = k.ear(head, sd, c(sd * 0.32, 0.5, 0.1) * ANG(0, 0, -sd * 0.12))
		k.tri(ear, "Ear", 0.25, 1.2, 0.6, BK, c(0, 0.6, 0) * FACE)
		k.tri(ear, "EarEdge", 0.06, 0.95, 0.12, MG, c(-sd * 0.0, 0.5, -0.14) * ANG(0, 0, sd * 0.25) * FACE, MAT.Neon)
	end

	local tip = k.tail(body, c(0, 0.3, 0.85), {
		{ 0.3, 0.3, 0.55, -0.9, BK }, { 0.3, 0.3, 0.5, 0.9, BK }, { 0.28, 0.28, 0.5, -1.2, TQ }, { 0.28, 0.28, 0.45, 0.6, BK } })
	k.b(tip, "TailPixel", 0.32, 0.32, 0.2, MG, c(0, 0, 0.3), MAT.Neon)

	-- drifting pixel cubes
	for i, d in ipairs({ { -1.2, 2.1, -0.6 }, { 1.3, 1.9, -0.8 }, { -1.4, 1.0, 0.4 }, { 1.4, 0.8, 0.2 }, { -0.9, 2.6, 0.8 }, { 1.0, 2.5, 0.6 } }) do
		local fe, fp = k.pv(body, "Fragment", c(d[1], d[2] - BY, d[3]))
		fe.fragIndex = i
		H.group(rig, "fragments", fe)
		k.b(fp, "Cube", 0.4, 0.22, 0.25, BK, CF())
		k.b(fp, "CubeFace", 0.42, 0.08, 0.27, (i % 2 == 0) and TQ or MG, c(0, 0.08, 0), MAT.Neon)
	end
end

---------------------------------------------------------------- VOID EMPEROR (Secret)
-- Dark armoured emperor: black torso with purple plates and a glowing turquoise Y on the chest, purple
-- tabard with crystal gems, a purple cape, huge shoulder pads with purple gems and turquoise trim, a
-- closed fist and an open clawed hand, black helmet with a spiked crown and purple crystal, glowing
-- turquoise eyes, curled black-purple horns, heavy feet with turquoise stripes.
function M.VoidEmperor(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local BK, BKL, PU, PUL, TQ, GEM = C("#24202C"), C("#34303E"), C("#6A2AA8"), C("#8A3ACF"), C("#3FF0D0"), C("#B060FF")
	local BY = 3.4
	local body = k.body(2.4, 2.2, 1.5, BK, BY)
	line(k, body, V3(0, -0.4, -0.78), V3(0, 0.2, -0.78), 0.14, TQ)
	line(k, body, V3(0, 0.2, -0.78), V3(-0.4, 0.65, -0.78), 0.14, TQ)
	line(k, body, V3(0, 0.2, -0.78), V3(0.4, 0.65, -0.78), 0.14, TQ)
	for _, sd in ipairs(SIDES) do
		k.b(body, "ChestPlate", 0.75, 1.0, 0.2, PU, c(sd * 0.75, 0.2, -0.78))
		line(k, body, V3(sd * 0.95, -0.2, -0.86), V3(sd * 0.75, -0.75, -0.86), 0.1, TQ)
	end
	local te, tp = k.pv(body, "Tabard", c(0, -0.6, -0.8))
	table.insert(rig.tail, te)
	k.b(tp, "Tabard", 0.7, 1.9, 0.1, PU, c(0, -0.9, 0))
	k.tri(tp, "TabardTip", 0.1, 0.5, 0.7, PU, c(0, -2.1, 0) * DOWN * FACE)
	k.diamond(tp, "TabardGem", 0.5, 0.3, 0.1, GEM, c(0, -1.3, -0.07), MAT.Glass)
	k.diamond(body, "BeltGem", 0.4, 0.3, 0.1, GEM, c(0, -0.55, -0.88), MAT.Glass)
	for _, x in ipairs({ -0.8, 0, 0.8 }) do
		local ce, cp = k.pv(body, "Cape", c(x, 0.7, 0.78) * ANG(0, 0, x * 0.15))
		table.insert(rig.tail, ce)
		k.tri(cp, "CapePanel", 0.12, 3.5, 1.0, PU, c(0, -1.75, 0) * DOWN * FACE)
	end
	k.b(body, "Hips", 2.0, 0.6, 1.3, BKL, c(0, -1.3, 0))

	local lg = { up = { 1.0, 0.7, 1.0 }, col = BK, w2 = 0.9, d2 = 0.95, paw = { 1.3, 0.5, 1.5, -0.1 }, pawCol = BK }
	for _, sd in ipairs(SIDES) do
		local _, _, knee, lh = k.leg(body, sd < 0 and "LegL" or "LegR", BY, sd * 0.6, -1.5, 0, lg)
		local _, st = k.b(knee, "FootStripe", 1.32, 0.1, 0.06, TQ, c(0, -lh - 0.25, -0.86), MAT.Neon)
		k.glow(st, TQ)
	end
	rig.legKind = "biped"

	for _, sd in ipairs(SIDES) do
		local a = k.arm(body, sd, c(sd * 1.55, 0.6, 0))
		k.b(a, "Shoulder", 1.5, 0.8, 1.4, PU, c(sd * 0.2, 0.3, 0))
		k.b(a, "ShoulderTop", 1.2, 0.3, 1.1, BKL, c(sd * 0.2, 0.8, 0))
		k.diamond(a, "ShoulderGem", 0.5, 0.3, 0.1, GEM, c(sd * 0.2, 0.35, -0.75), MAT.Glass)
		line(k, a, V3(sd * -0.5, -0.05, -0.72), V3(sd * 0.9, -0.05, -0.72), 0.1, TQ)
		k.b(a, "UpperArm", 0.95, 1.0, 0.95, BK, c(sd * 0.3, -0.6, 0))
		k.b(a, "Forearm", 1.3, 1.0, 1.3, PU, c(sd * 0.35, -1.5, -0.05))
		if sd > 0 then
			local _, fist = k.b(a, "Fist", 1.45, 1.15, 1.4, BK, c(sd * 0.35, -2.45, -0.1))
			for f = 1, 3 do k.b(fist, "Knuckle", 0.4, 0.34, 0.2, BKL, c((f - 2) * 0.44, 0.2, -0.75)) end
		else
			local _, hand = k.b(a, "Palm", 1.2, 0.4, 1.1, BK, c(sd * 0.35, -2.2, -0.2))
			for f = 1, 4 do k.b(hand, "Claw", 0.22, 0.65, 0.22, PU, c((f - 2.5) * 0.3, -0.45, -0.35) * ANG(-0.4, 0, 0)) end
		end
	end

	local head = k.head(body, 1.0, 1.05, 0.95, BK, c(0, 1.6, -0.1), V3(0, -0.5, 0.1))
	k.b(head, "FacePlate", 0.8, 0.5, 0.06, BKL, c(0, 0.05, -0.49))
	for _, sd in ipairs(SIDES) do k.eye(head, sd * 0.18, 0.1, -0.53, 0.2, 0.09, TQ, 0) end
	local _, band = k.b(head, "CrownBand", 1.05, 0.16, 1.0, TQ, c(0, 0.42, 0), MAT.Neon)
	k.glow(band, TQ)
	for i = -2, 2 do k.spike(head, "CrownSpike", (i == 0) and 0.6 or 0.4, 0.15, BK, c(i * 0.2, 0.52, -0.3)) end
	k.crystal(head, "CrownCrystal", 0.75, 0.24, GEM, c(0, 0.5, -0.35), MAT.Glass, 0.05)
	for _, sd in ipairs(SIDES) do
		-- ram horn: up and out, then curling down and back in
		local pts = { V3(sd * 0.4, 0.45, 0.1), V3(sd * 0.8, 0.95, 0.15), V3(sd * 1.25, 0.85, 0.2), V3(sd * 1.38, 0.35, 0.15), V3(sd * 1.12, 0.02, 0.0) }
		for i = 1, #pts - 1 do k.bar(head, "Horn", pts[i], pts[i + 1], 0.42 - i * 0.06, (i % 2 == 0) and PU or BKL, nil, nil, V3(0, 0, 1)) end
	end
end

---------------------------------------------------------------- ERROR CAT (Secret)
-- Glitched cat: black body with magenta armour plates and glowing green circuit lines, black legs with
-- magenta paws, black head under a magenta mask shifted off-centre with dead-pixel squares, glowing green
-- eyes, magenta ears with black insides, magenta whiskers, a segmented zigzag tail ending in a magenta blade.
function M.Errorcat(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local MG, MGD, BK, BKL, GN = C("#F21FC8"), C("#C8189E"), C("#1C1C22"), C("#2C2C34"), C("#2AF07A")
	local BY = 1.75
	local body = k.body(1.3, 1.1, 2.3, BK, BY)
	k.b(body, "BackPlate", 1.0, 0.18, 1.3, MG, c(0, 0.6, -0.2))
	k.tri(body, "ChestV", 0.12, 0.9, 1.0, MG, c(0, -0.05, -1.17) * DOWN * FACE)
	for _, sd in ipairs(SIDES) do
		k.b(body, "SidePlate", 0.1, 0.55, 1.0, MG, c(sd * 0.66, 0.15, 0.1) * ANG(-0.25, 0, 0))
		line(k, body, V3(sd * 0.67, -0.3, -0.9), V3(sd * 0.67, -0.3, 0.2), 0.07, GN, V3(1, 0, 0))
		line(k, body, V3(sd * 0.67, -0.3, 0.2), V3(sd * 0.67, 0.0, 0.6), 0.07, GN, V3(1, 0, 0))
	end
	local lg = { up = { 0.5, 0.65, 0.6 }, col = BK, w2 = 0.42, d2 = 0.5, paw = { 0.6, 0.3, 0.7 }, pawCol = MG, toes = 3, toeCol = MG }
	local function legLine(knee, lh) line(k, knee, V3(0.22, -0.1, -0.26), V3(0.22, -lh + 0.1, -0.26), 0.06, GN, V3(1, 0, 0)) end
	local _, _, k1, l1 = k.leg(body, "LegFL", BY, -0.42, -0.45, -0.85, lg); legLine(k1, l1)
	local _, _, k2, l2 = k.leg(body, "LegFR", BY, 0.42, -0.45, -0.85, lg); legLine(k2, l2)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.42, -0.45, 0.85, lg)
	k.leg(body, "LegBR", BY, 0.42, -0.45, 0.85, lg)
	rig.legKind = "quad"

	local head = k.head(body, 1.05, 0.95, 1.0, BK, c(0, 0.85, -1.4), V3(0, -0.4, 0.3))
	k.w(head, "Muzzle", 0.55, 0.35, 0.4, BKL, c(0, -0.28, -0.65))
	-- glitch mask: magenta block shifted toward the creature's left, with dead-pixel squares
	k.b(head, "GlitchMask", 0.7, 0.75, 0.12, MG, c(-0.2, 0.15, -0.53) * ANG(0, 0, 0.12))
	k.b(head, "DeadPixel", 0.1, 0.16, 0.04, BK, c(-0.42, 0.35, -0.6))
	k.b(head, "DeadPixel", 0.1, 0.24, 0.04, BK, c(-0.42, 0.05, -0.6))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.22, 0.05, (sd < 0) and -0.61 or -0.53, 0.2, 0.1, GN, sd * 0.3)
		local ear = k.ear(head, sd, c(sd * 0.35, 0.45, 0.1) * ANG(0, 0, -sd * 0.2))
		k.tri(ear, "Ear", 0.2, 0.75, 0.55, MG, c(0, 0.37, 0) * FACE)
		k.tri(ear, "EarInner", 0.07, 0.5, 0.3, BK, c(0, 0.3, -0.1) * FACE)
		for i = -1, 1 do
			k.b(head, "Whisker", 0.6, 0.04, 0.04, MG, c(sd * 0.65, -0.2 + i * 0.09, -0.5) * ANG(0, 0, sd * i * 0.15))
		end
	end

	local tip = k.tail(body, c(0, 0.35, 1.15), {
		{ 0.3, 0.3, 0.55, -1.1, BK }, { 0.3, 0.3, 0.5, 0.5, BK }, { 0.28, 0.28, 0.5, -0.8, BK }, { 0.28, 0.28, 0.45, 0.6, BK } })
	for _, e in ipairs(rig.tail) do k.b(e.part, "TailBand", 0.32, 0.06, 0.08, GN, c(0, 0.16, 0), MAT.Neon) end
	k.w(tip, "TailBlade", 0.3, 0.3, 0.9, MG, c(0, 0, 0.6) * ANG(0, PI, 0))
end

---------------------------------------------------------------- NULL BUNNY (Secret)
-- Void rabbit: black body traced with white edge lines and a white V on the chest, red glowing chevrons on
-- the haunches, white clawed paws, black head with a white muzzle and a glowing red visor slit, tall ears
-- framed in white, and segmented red/black arcs curling around the ears.
function M.NullBunny(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local BK, BKL, W, RD = C("#16161A"), C("#26262C"), C("#F2F2F2"), C("#FF2238")
	local BY = 1.55
	local body = k.body(1.4, 1.25, 1.9, BK, BY)
	for _, sd in ipairs(SIDES) do
		k.b(body, "Haunch", 0.45, 1.05, 1.1, BK, c(sd * 0.72, -0.05, 0.45))
		k.bar(body, "WhiteEdge", V3(sd * 0.95, 0.5, 0.0), V3(sd * 0.95, -0.55, 0.95), 0.1, W, nil, nil, V3(1, 0, 0))
		line(k, body, V3(sd * 0.96, 0.35, 0.35), V3(sd * 0.96, 0.0, 0.6), 0.14, RD, V3(1, 0, 0))
		line(k, body, V3(sd * 0.96, 0.0, 0.6), V3(sd * 0.96, -0.35, 0.35), 0.14, RD, V3(1, 0, 0))
		k.bar(body, "ChestV", V3(sd * 0.6, 0.5, -0.98), V3(0, -0.25, -0.98), 0.12, W)
	end
	local lf = { up = { 0.45, 0.4, 0.5 }, col = BK, w2 = 0.4, d2 = 0.45, paw = { 0.55, 0.25, 0.75 }, pawCol = W, toes = 3, toeCol = W }
	k.leg(body, "LegFL", BY, -0.42, -0.45, -0.7, lf)
	k.leg(body, "LegFR", BY, 0.42, -0.45, -0.7, lf)
	local lh = { up = { 0.5, 0.4, 0.7 }, col = BK, w2 = 0.45, d2 = 0.6, paw = { 0.65, 0.3, 1.1 }, pawCol = W, toes = 3, toeCol = W, hind = true }
	k.leg(body, "LegBL", BY, -0.65, -0.45, 0.55, lh)
	k.leg(body, "LegBR", BY, 0.65, -0.45, 0.55, lh)
	rig.legKind = "quad"

	local head = k.head(body, 1.05, 1.0, 1.1, BK, c(0, 0.95, -1.15), V3(0, -0.4, 0.35))
	k.b(head, "Muzzle", 0.8, 0.45, 0.35, W, c(0, -0.3, -0.62))
	local e, p = k.b(head, "Visor", 0.85, 0.2, 0.06, RD, c(0, 0.12, -0.57), MAT.Neon)
	table.insert(rig.eyes, e)
	k.glow(p, RD)
	for _, sd in ipairs(SIDES) do
		local ear = k.ear(head, sd, c(sd * 0.3, 0.5, 0.1) * ANG(-0.15, 0, -sd * 0.12), "bunny")
		k.b(ear, "EarFrame", 0.42, 1.7, 0.2, W, c(0, 0.85, 0))
		k.b(ear, "Ear", 0.3, 1.55, 0.24, BK, c(0, 0.85, -0.02))
		k.tri(ear, "EarTip", 0.42, 0.3, 0.2, W, c(0, 1.85, 0))
		-- red/black arc curling around the ear
		local pts = { V3(sd * 0.45, 0.3, 0.1), V3(sd * 1.0, 0.75, 0.15), V3(sd * 1.15, 1.35, 0.2), V3(sd * 0.85, 1.75, 0.2), V3(sd * 0.4, 1.85, 0.15) }
		for i = 1, #pts - 1 do
			k.bar(head, "Arc", pts[i] + (pts[i + 1] - pts[i]) * 0.08, pts[i + 1] - (pts[i + 1] - pts[i]) * 0.08, 0.2, (i % 2 == 0) and RD or BKL, (i % 2 == 0) and MAT.Neon or nil, nil, V3(0, 0, 1))
		end
	end
	k.tail(body, c(0, 0.3, 0.95), { { 0.7, 0.6, 0.5, -0.4, W } })
end

---------------------------------------------------------------- THE WATCHER (Secret)
-- Floating void eye: a black angular body around a big glowing turquoise eye with a slit pupil inside a
-- magenta diamond frame, a black hood with a turquoise stripe and spikes on top, black stalactite spikes
-- with magenta edges hanging below, and a tilted hexagonal ring (half magenta, half turquoise) turning around it.
function M.TheWatcher(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local BK, BKL, MG, TQ = C("#24182E"), C("#34263F"), C("#E0288A"), C("#3FF0C0")
	local BY = 1.8
	local body = k.body(1.9, 1.5, 1.4, BK, BY)
	rig.legKind = "none"
	k.diamond(body, "EyeFrame", 1.55, 1.9, 0.12, MG, c(0, 0, -0.72) * ANG(0, 0, PI / 2))
	k.diamond(body, "EyeRim", 1.35, 1.6, 0.13, BK, c(0, 0, -0.74) * ANG(0, 0, PI / 2))
	-- wide diamond eye (the neon core block carries the blink), slit pupil
	k.diamond(body, "EyeShape", 1.0, 1.35, 0.1, TQ, c(0, 0, -0.78) * ANG(0, 0, PI / 2), MAT.Neon)
	local e, p = k.b(body, "Eye", 0.55, 0.45, 0.06, TQ, c(0, 0, -0.84), MAT.Neon)
	table.insert(rig.eyes, e)
	k.glow(p, TQ)
	k.b(body, "Pupil", 0.1, 0.62, 0.04, BK, c(0, 0, -0.88))

	local he = k.head(body, 1.7, 0.6, 1.3, BK, c(0, 0.95, 0.05), V3(0, -0.3, 0.2))
	k.w(he, "HoodFront", 1.7, 0.5, 0.6, BKL, c(0, 0.0, -0.9))
	local _, st = k.b(he, "HoodStripe", 0.25, 0.64, 1.34, TQ, c(0, 0, 0), MAT.Neon)
	k.glow(st, TQ)
	for i, x in ipairs({ -0.65, -0.3, 0.3, 0.65 }) do
		k.spike(he, "HoodSpike", 0.9 - math.abs(x) * 0.4, 0.35, BK, c(x, 0.25, 0.1) * ANG(0, 0, -x * 0.4))
		if i == 1 or i == 4 then k.b(he, "SpikeMark", 0.08, 0.3, 0.08, TQ, c(x * 1.05, 0.5, -0.08), MAT.Neon) end
	end

	for i, x in ipairs({ -0.7, -0.35, 0, 0.35, 0.7 }) do
		local L = 1.6 - math.abs(x) * 1.0
		k.spike(body, "Stalactite", L, 0.45, BK, c(x, -0.7, 0.05) * DOWN)
		k.tri(body, "StalactiteEdge", 0.06, L * 0.7, 0.18, MG, c(x, -0.75 - L * 0.32, -0.2) * DOWN * FACE)
	end

	local re, rp = k.pv(body, "Ring", c(0, -0.15, 0) * ANG(0.4, 0, 0.2))
	H.group(rig, "rings", re)
	for i = 0, 5 do
		local a0, a1 = i / 6 * PI * 2, (i + 1) / 6 * PI * 2
		local A = V3(math.cos(a0) * 1.95, 0, math.sin(a0) * 1.55)
		local B = V3(math.cos(a1) * 1.95, 0, math.sin(a1) * 1.55)
		k.bar(rp, "RingSeg", A, B, 0.2, (i < 3) and TQ or MG, nil, nil, V3(0, 1, 0))
	end
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">SpeciesModelsShadow</string><ProtectedString name="Source"><![CDATA[-- SpeciesModelsShadow: hand-authored, reference-faithful models for the Shadow world
-- (Gloomling, Shade Cat, Night Moth, Void Wisp, Umbra Wolf, Wraith Lord, Nightmare Wyvern).
-- Location: ReplicatedStorage > Shared > SpeciesModelsShadow (ModuleScript), merged into SpeciesModels.

local K = require(script.Parent.ModelKit)
local V3, CF, ANG, PI, MAT, C = K.V3, K.CF, K.ANG, K.PI, K.MAT, K.C
local FACE, DOWN = ANG(0, PI / 2, 0), ANG(0, 0, PI)
local SIDES = { -1, 1 }

local M = {}

local function line(k, parent, A, B, w, col, up)
	local _, p = k.bar(parent, "GlowLine", A, B, w, col, MAT.Neon, nil, up, w * 0.6)
	k.glow(p, col)
end

-- flat kite panel in a wing pivot's XY plane (outward = side * X)
local function kite(k, pv, side, O, L, T, R, col, z)
	local function P(v) return V3(v.X * side, v.Y, z) end
	k.mem(pv, "WingPanel", P(O), P(L), P(R), 0.08, col)
	k.mem(pv, "WingPanel", P(T), P(L), P(R), 0.08, col)
end

---------------------------------------------------------------- GLOOMLING (Common)
-- Little hooded shade: big purple hood with a lavender rim around a dark face and glowing slit eyes,
-- a pointed purple cloak with a darker front panel, stubby arms with lavender cuffs.
function M.Gloomling(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PU, PUD, PUL, LV, DK, EY = C("#5A3A8A"), C("#45286E"), C("#7A52B0"), C("#A880F0"), C("#22163A"), C("#D8B8FF")
	local BY = 1.5
	local body = k.body(1.1, 1.0, 0.9, PU, BY)
	rig.legKind = "none"
	k.b(body, "FrontPanel", 0.45, 1.0, 0.1, PUD, c(0, -0.1, -0.48))
	k.tri(body, "FrontTip", 0.1, 0.5, 0.45, PUD, c(0, -0.85, -0.48) * DOWN * FACE)
	for i, d in ipairs({ { -0.4, -0.15, 1.1 }, { 0.4, -0.15, 1.1 }, { 0, 0.3, 1.3 }, { -0.35, 0.3, 0.9 }, { 0.35, 0.3, 0.9 } }) do
		local te, tp = k.pv(body, "CloakPivot", c(d[1], -0.45, d[2]) * ANG(0, 0, d[1] * 0.3))
		table.insert(rig.tail, te)
		k.tri(tp, "Cloak", 0.12, d[3], 0.6, (i % 2 == 0) and PUL or PU, c(0, -d[3] / 2, 0) * DOWN * FACE)
	end
	local head = k.head(body, 1.15, 1.05, 1.15, PU, c(0, 0.95, 0.05), V3(0, -0.45, 0.1))
	k.b(head, "HoodBack", 1.0, 0.7, 0.5, PUD, c(0, 0.25, 0.55) * ANG(-0.3, 0, 0))
	k.b(head, "Face", 0.8, 0.6, 0.1, DK, c(0, -0.05, -0.55))
	k.b(head, "RimTop", 1.0, 0.16, 0.14, LV, c(0, 0.33, -0.58))
	for _, sd in ipairs(SIDES) do
		k.b(head, "RimSide", 0.16, 0.75, 0.14, LV, c(sd * 0.47, -0.05, -0.58))
		k.eye(head, sd * 0.18, 0.0, -0.61, 0.2, 0.08, EY, sd * 0.3)
		local a = k.arm(body, sd, c(sd * 0.55, 0.1, -0.15))
		k.b(a, "Arm", 0.4, 0.4, 0.55, PUD, c(sd * 0.1, -0.25, -0.2))
		k.b(a, "Cuff", 0.42, 0.42, 0.14, LV, c(sd * 0.1, -0.25, -0.5))
	end
end

---------------------------------------------------------------- SHADE CAT (Uncommon)
-- Shadow cat: very dark purple angular body with lighter purple shoulder and hip plates, a lime collar
-- with a diamond pendant and a grey tag, spiky chin ruff, angular head with purple ear insides and
-- glowing lime eyes, dark clawed paws, a segmented tail rising to a purple blade tip.
function M.ShadeCat(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PU, PUD, PUL, LM, TG, EY = C("#3A2846"), C("#2C1E36"), C("#6A3E8A"), C("#C8F03A"), C("#8A7090"), C("#D8FF4A")
	local BY = 1.75
	local body = k.body(1.25, 1.1, 2.3, PU, BY)
	for _, sd in ipairs(SIDES) do
		k.b(body, "ShoulderPlate", 0.12, 0.55, 0.8, PUL, c(sd * 0.64, 0.15, -0.65) * ANG(0.3, 0, 0))
		k.b(body, "HipPlate", 0.12, 0.5, 0.75, PUL, c(sd * 0.64, 0.2, 0.75) * ANG(-0.3, 0, 0))
	end
	local _, collar = k.b(body, "Collar", 1.15, 0.18, 0.25, LM, c(0, 0.45, -1.15), MAT.Neon)
	k.glow(collar, LM)
	k.diamond(body, "Pendant", 0.55, 0.42, 0.08, LM, c(0, 0.05, -1.2))
	k.diamond(body, "PendantIn", 0.35, 0.24, 0.1, PU, c(0, 0.05, -1.22))
	k.b(body, "Tag", 0.25, 0.25, 0.1, TG, c(0.42, 0.25, -1.2))
	local lg = { up = { 0.5, 0.65, 0.6 }, col = PU, w2 = 0.42, d2 = 0.5, col2 = PUD, paw = { 0.6, 0.3, 0.7 }, pawCol = PUD, toes = 3, toeCol = PUL }
	k.leg(body, "LegFL", BY, -0.42, -0.45, -0.85, lg)
	k.leg(body, "LegFR", BY, 0.42, -0.45, -0.85, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.42, -0.45, 0.85, lg)
	k.leg(body, "LegBR", BY, 0.42, -0.45, 0.85, lg)
	rig.legKind = "quad"

	local head = k.head(body, 1.0, 0.85, 0.95, PU, c(0, 0.8, -1.4), V3(0, -0.35, 0.3))
	k.w(head, "Muzzle", 0.55, 0.35, 0.45, PUL, c(0, -0.22, -0.62))
	for _, sd in ipairs(SIDES) do
		k.b(head, "Brow", 0.4, 0.12, 0.2, PUD, c(sd * 0.24, 0.16, -0.48) * ANG(0, 0, sd * 0.35))
		k.eye(head, sd * 0.24, 0.05, -0.49, 0.24, 0.1, EY, sd * 0.35)
		k.tri(head, "Ruff", 0.1, 0.5, 0.35, PUD, c(sd * 0.45, -0.3, -0.1) * ANG(0, 0, -sd * 1.6))
		local ear = k.ear(head, sd, c(sd * 0.32, 0.4, 0.1) * ANG(0, 0, -sd * 0.15))
		k.tri(ear, "Ear", 0.2, 0.8, 0.55, PU, c(0, 0.4, 0) * FACE)
		k.tri(ear, "EarInner", 0.07, 0.55, 0.32, PUL, c(0, 0.32, -0.1) * FACE)
	end
	local tip = k.tail(body, c(0, 0.35, 1.15), {
		{ 0.3, 0.3, 0.55, -0.7, PU }, { 0.28, 0.28, 0.55, -0.3, PU }, { 0.28, 0.28, 0.5, -0.3, PU }, { 0.26, 0.26, 0.45, 0.4, PU } })
	k.w(tip, "TailBlade", 0.3, 0.3, 0.75, PUL, c(0, 0, 0.55) * ANG(0, PI, 0))
end

---------------------------------------------------------------- NIGHT MOTH (Rare)
-- Night moth on six legs: purple body with a fluffy lavender collar ruff, a striped abdomen with glowing
-- cyan bands, angular head with glowing cyan eyes and feathery lavender antennae, four big kite wings
-- (purple frame, lavender panels, glowing cyan stripes).
function M.NightMoth(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PU, PUD, LV, CY, EY = C("#5A3A8A"), C("#45286E"), C("#BFA4F0"), C("#5FE8F0"), C("#7FF0FF")
	local BY = 1.6
	local body = k.body(0.95, 0.85, 1.0, PU, BY)
	for i = 0, 5 do
		local a = (i - 2.5) / 5 * 2.6
		k.b(body, "Ruff", 0.45, 0.4, 0.4, LV, c(math.sin(a) * 0.55, 0.35, -math.cos(a) * 0.45) * ANG(0.4, a, 0))
	end
	local ae, ap = k.pv(body, "AbdomenPivot", c(0, -0.05, 0.45) * ANG(0.3, 0, 0))
	H.group(rig, "abdomen", ae)
	for i = 0, 2 do
		local w = 0.85 - i * 0.18
		local _, seg = k.b(ap, "Abdomen", w, w * 0.85, 0.5, (i % 2 == 0) and PU or PUD, c(0, 0, 0.3 + i * 0.48))
		local _, band = k.b(seg, "AbdomenBand", w + 0.04, 0.1, 0.12, CY, c(0, 0.1, 0.15), MAT.Neon)
		k.glow(band, CY)
	end
	k.w(ap, "AbdomenTip", 0.4, 0.35, 0.5, LV, c(0, 0, 1.75) * ANG(0, PI, 0))

	local head = k.head(body, 0.8, 0.65, 0.7, PU, c(0, 0.45, -0.7), V3(0, -0.2, 0.25))
	k.w(head, "Snout", 0.55, 0.3, 0.3, PUD, c(0, -0.12, -0.45))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.2, 0.05, -0.36, 0.22, 0.12, EY, sd * 0.35)
		local ant = k.ear(head, sd, c(sd * 0.18, 0.3, 0.0) * ANG(0, 0, -sd * 0.3), "antenna")
		k.b(ant, "AntennaStem", 0.1, 0.9, 0.1, LV, c(0, 0.45, 0))
		for j = 1, 3 do
			k.b(ant, "AntennaBarb", 0.4, 0.08, 0.08, LV, c(sd * 0.18, 0.25 + j * 0.2, 0) * ANG(0, 0, sd * 0.6))
		end
	end

	local lg = { up = { 0.18, 0.55, 0.18 }, col = PU, w2 = 0.16, d2 = 0.16, col2 = PUD, paw = { 0.24, 0.24, 0.28 }, pawCol = LV, splay = 0.6 }
	for _, z in ipairs({ -0.35, 0, 0.35 }) do
		k.leg(body, "LegL", BY, -0.4, -0.35, z, lg)
		k.leg(body, "LegR", BY, 0.4, -0.35, z, lg)
	end
	rig.legKind = "bug6"

	local V2 = Vector2.new
	for _, sd in ipairs(SIDES) do
		for tier, w in ipairs({
			{ V2(0, 0), V2(0.5, 1.8), V2(3.0, 2.7), V2(2.2, 0.4), V2(0.6, 0.55), V2(0.85, 1.55), V2(2.4, 2.15), V2(1.9, 0.75) },
			{ V2(0, 0), V2(1.2, 0.3), V2(2.5, -0.6), V2(1.0, -0.95), V2(0.5, -0.1), V2(1.15, 0.05), V2(1.95, -0.45), V2(1.0, -0.65) },
		}) do
			local pv = k.wing(body, sd, c(sd * 0.42, 0.3, 0.05 + (tier - 1) * 0.15) * ANG(0, -sd * (0.35 + tier * 0.1), 0), tier)
			kite(k, pv, sd, w[1], w[2], w[3], w[4], PU, 0)
			kite(k, pv, sd, w[5], w[6], w[7], w[8], LV, -0.06)
			line(k, pv, V3(w[7].X * sd, w[7].Y, -0.1), V3((w[6].X * 0.6 + w[7].X * 0.4) * sd, w[6].Y * 0.6 + w[7].Y * 0.4, -0.1), 0.12, CY)
			line(k, pv, V3(w[7].X * sd, w[7].Y, -0.1), V3((w[8].X * 0.6 + w[7].X * 0.4) * sd, w[8].Y * 0.6 + w[7].Y * 0.4, -0.1), 0.12, CY)
		end
	end
end

---------------------------------------------------------------- VOID WISP (Epic)
-- Floating void sentinel: angular black core with purple framing around a glowing magenta slit eye, a
-- spiked black crown, a drill-shaped lower body with a magenta band, two black blade wings with magenta
-- glow stripes, and a broken ring of purple/magenta arcs turning around it.
function M.VoidWisp(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local BK, BKL, PU, MG = C("#2A1E36"), C("#3A2A4A"), C("#8A3ADF"), C("#FF4AD8")
	local BY = 2.0
	local body = k.body(1.4, 1.3, 1.2, BK, BY)
	rig.legKind = "none"
	k.b(body, "EyeFrame", 1.0, 0.9, 0.1, PU, c(0, 0, -0.62) * ANG(0, 0, PI / 4))
	k.b(body, "EyeSocket", 0.75, 0.68, 0.11, BKL, c(0, 0, -0.64) * ANG(0, 0, PI / 4))
	local e, p = k.b(body, "Eye", 0.45, 0.45, 0.08, C("#B8208E"), c(0, 0, -0.69), MAT.Neon)
	table.insert(rig.eyes, e)
	k.glow(p, MG)
	k.b(body, "Slit", 0.1, 0.4, 0.04, MG, c(0, 0, -0.74), MAT.Neon)
	for _, sd in ipairs(SIDES) do k.b(body, "SideFrame", 0.2, 1.0, 0.9, PU, c(sd * 0.72, 0, -0.1)) end

	local head = k.head(body, 1.1, 0.5, 1.0, BK, c(0, 0.85, 0), V3(0, -0.25, 0.1))
	k.spike(head, "CrownSpike", 1.1, 0.5, BK, c(0, 0.2, 0))
	for _, sd in ipairs(SIDES) do k.spike(head, "CrownSpike", 0.6, 0.35, BKL, c(sd * 0.4, 0.2, 0) * ANG(0, 0, -sd * 0.3)) end
	for i = 0, 2 do
		k.b(body, "Drill", 0.9 - i * 0.25, 0.4, 0.8 - i * 0.22, (i == 1) and BKL or BK, c(0, -0.85 - i * 0.38, 0))
	end
	local _, band = k.b(body, "DrillBand", 0.7, 0.08, 0.62, MG, c(0, -1.12, 0), MAT.Neon)
	k.glow(band, MG)
	k.spike(body, "DrillTip", 0.8, 0.35, PU, c(0, -1.75, 0) * DOWN)

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.8, 0.2, 0.1))
		k.b(w, "WingBlade", 1.6, 0.7, 0.4, BK, c(sd * 0.85, 0.1, 0) * ANG(0, 0, -sd * 0.15))
		k.w(w, "WingTip", 0.4, 0.7, 0.6, BK, c(sd * 1.95, 0.0, 0) * ANG(0, -sd * PI / 2, 0) * ANG(0, 0, 0))
		line(k, w, V3(sd * 0.4, 0.05, -0.22), V3(sd * 1.5, -0.12, -0.22), 0.14, MG)
	end
	local re, rp = k.pv(body, "ArcRing", c(0, 0, 0.1))
	H.group(rig, "rays", re)
	for i = 0, 5 do
		local a0 = i / 6 * PI * 2 + 0.25
		for j = 0, 1 do
			local a = a0 + j * 0.35
			k.b(rp, "Arc", 0.2, 0.6, 0.18, (j == 0) and PU or MG, k.c(math.cos(a) * 2.0, math.sin(a) * 2.0, 0) * ANG(0, 0, a))
		end
	end
end

---------------------------------------------------------------- UMBRA WOLF (Legendary)
-- Shadow wolf: dark purple body with angular armour plates traced by glowing violet lines, a big spiky
-- purple mane over neck, shoulders and spine, long legs with glowing bands and clawed paws, a long-snouted
-- head with tall ears and glowing violet eyes, a huge spiky bushy tail.
function M.UmbraWolf(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PU, PUD, PUL, NE = C("#4A2A6E"), C("#2E1C44"), C("#7A3ACF"), C("#C060FF")
	local BY = 2.1
	local body = k.body(1.3, 1.2, 2.6, PUD, BY)
	for _, sd in ipairs(SIDES) do
		k.b(body, "ShoulderPlate", 0.14, 0.8, 0.9, PU, c(sd * 0.68, 0.0, -0.7))
		line(k, body, V3(sd * 0.76, 0.3, -1.05), V3(sd * 0.76, -0.3, -0.75), 0.08, NE, V3(1, 0, 0))
		line(k, body, V3(sd * 0.76, -0.3, -0.75), V3(sd * 0.76, 0.3, -0.45), 0.08, NE, V3(1, 0, 0))
		k.b(body, "HipPlate", 0.14, 0.75, 0.8, PU, c(sd * 0.68, 0.05, 0.8))
		line(k, body, V3(sd * 0.76, 0.3, 0.5), V3(sd * 0.76, -0.25, 0.95), 0.08, NE, V3(1, 0, 0))
	end
	for i = 0, 6 do
		local z = -1.2 + i * 0.4
		k.spike(body, "SpineSpike", 0.9 - i * 0.05, 0.6, (i % 2 == 0) and PUL or PU, c(0, 0.55, z) * ANG(0.9, 0, (i % 2 == 0) and 0.25 or -0.25))
	end
	local lg = { up = { 0.55, 0.85, 0.65 }, col = PUD, w2 = 0.45, d2 = 0.55, band = NE, bandY = 0.25, paw = { 0.6, 0.35, 0.75 }, pawCol = PU, toes = 3, toeCol = PUL }
	k.leg(body, "LegFL", BY, -0.42, -0.45, -0.95, lg)
	k.leg(body, "LegFR", BY, 0.42, -0.45, -0.95, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.42, -0.45, 0.95, lg)
	k.leg(body, "LegBR", BY, 0.42, -0.45, 0.95, lg)
	rig.legKind = "quad"

	k.b(body, "Neck", 0.8, 1.0, 0.8, PUD, c(0, 0.65, -1.3) * ANG(-0.4, 0, 0))
	-- mane: spikes fanning around the neck
	for i = 0, 7 do
		local a = (i - 3.5) / 3.5 * 1.6
		k.spike(body, "Mane", 1.45 - math.abs(a) * 0.15, 0.85, (i % 2 == 0) and PUL or PU, c(math.sin(a) * 0.55, 0.9 + math.cos(a) * 0.2, -1.2) * ANG(0.75, 0, -a * 0.85))
	end
	local head = k.head(body, 0.85, 0.75, 1.0, PUD, c(0, 1.25, -1.75), V3(0, -0.3, 0.3))
	k.w(head, "Snout", 0.5, 0.4, 0.75, PUD, c(0, -0.15, -0.8))
	k.b(head, "Nose", 0.18, 0.14, 0.1, C("#120A1C"), c(0, -0.3, -1.12))
	for _, sd in ipairs(SIDES) do
		k.b(head, "Brow", 0.35, 0.12, 0.2, PU, c(sd * 0.23, 0.2, -0.48) * ANG(0, 0, sd * 0.35))
		k.eye(head, sd * 0.23, 0.08, -0.51, 0.22, 0.09, NE, sd * 0.35)
		local ear = k.ear(head, sd, c(sd * 0.28, 0.35, 0.15) * ANG(0, 0, -sd * 0.12))
		k.tri(ear, "Ear", 0.18, 0.85, 0.45, PU, c(0, 0.42, 0) * FACE)
		k.tri(head, "CheekSpike", 0.12, 0.6, 0.4, PU, c(sd * 0.45, -0.15, 0.1) * ANG(0.3, 0, -sd * 1.3))
	end

	local tp = k.tail(body, c(0, 0.25, 1.25), { { 0.5, 0.5, 0.7, -0.3, PU }, { 0.55, 0.55, 0.7, 0.05, PU }, { 0.45, 0.45, 0.6, 0.1, PUL } })
	for i, e in ipairs(rig.tail) do
		for j, a in ipairs({ -0.7, 0, 0.7 }) do
			k.spike(e.part, "TailSpike", 1.25 - i * 0.08, 0.8, ((i + j) % 2 == 0) and PUL or PU, c(math.sin(a) * 0.22, math.cos(a) * 0.22, 0) * ANG(1.1, 0, -a * 1.2))
		end
	end
	k.spike(tp, "TailTip", 0.9, 0.45, PUL, c(0, 0, 0.3) * ANG(PI / 2, 0, 0))
end

---------------------------------------------------------------- WRAITH LORD (Legendary)
-- Floating wraith king: a tall layered cloak of dark and bright purple blades with glowing pink stripes,
-- a purple tabard with a pink diamond and chevron, huge angular shoulder pads with pink trim, arms ending in
-- clawed hands, a dark hood with glowing pink eyes and a spiked crown with a pink gem.
function M.Wraithlord(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PU, PUL, DK, DKL, PK = C("#7A2ADF"), C("#9A4AF0"), C("#2A1A3A"), C("#3A2A4C"), C("#FF3A7A")
	local BY = 2.6
	local body = k.body(1.6, 1.6, 1.1, DK, BY)
	rig.legKind = "none"
	local te, tp = k.pv(body, "Tabard", c(0, 0.3, -0.58))
	table.insert(rig.tail, te)
	k.b(tp, "Tabard", 0.6, 2.4, 0.1, PU, c(0, -1.0, 0))
	k.tri(tp, "TabardTip", 0.1, 0.45, 0.6, PU, c(0, -2.42, 0) * DOWN * FACE)
	k.diamond(tp, "TabardGem", 0.4, 0.28, 0.08, PK, c(0, -0.1, -0.06))
	k.tri(tp, "Chevron", 0.08, 0.25, 0.4, PK, c(0, -1.6, -0.06) * DOWN * FACE)
	for i = 0, 9 do
		local a = (i / 9 - 0.5) * 3.6
		local x, z = math.sin(a) * 0.95, math.cos(a) * 0.6 - 0.05
		local L = 2.4 - math.abs(math.sin(a)) * 0.5
		local ce, cp = k.pv(body, "CloakPivot", c(x, -0.4, z) * ANG(0, math.atan2(x, z), 0) * ANG(-0.45, 0, 0))
		table.insert(rig.tail, ce)
		local col = (i % 2 == 0) and PU or DKL
		k.tri(cp, "Cloak", 0.12, L, 0.9, col, c(0, -L / 2, 0) * DOWN * FACE)
		if i % 3 == 1 then k.tri(cp, "CloakStripe", 0.13, L * 0.7, 0.12, PK, c(0.15, -L * 0.42, -0.02) * DOWN * FACE) end
	end

	for _, sd in ipairs(SIDES) do
		local a = k.arm(body, sd, c(sd * 1.0, 0.5, 0))
		k.b(a, "Shoulder", 1.0, 0.5, 1.0, PU, c(sd * 0.2, 0.25, 0))
		k.w(a, "ShoulderPeak", 1.0, 0.5, 0.6, DKL, c(sd * 0.55, 0.5, 0) * ANG(0, -sd * PI / 2, 0))
		k.b(a, "ShoulderTrim", 1.02, 0.1, 1.02, PK, c(sd * 0.2, 0.0, 0))
		k.b(a, "Sleeve", 0.7, 1.1, 0.7, DK, c(sd * 0.3, -0.7, 0))
		k.b(a, "SleeveTrim", 0.74, 0.12, 0.74, PK, c(sd * 0.3, -1.1, 0))
		local _, hand = k.b(a, "Hand", 0.55, 0.45, 0.5, DKL, c(sd * 0.35, -1.5, -0.1))
		for f = 1, 3 do k.b(hand, "Claw", 0.12, 0.45, 0.12, DK, c((f - 2) * 0.17, -0.35, -0.1) * ANG(-0.3, 0, 0)) end
	end

	local head = k.head(body, 0.85, 0.9, 0.85, DK, c(0, 1.25, 0), V3(0, -0.4, 0.1))
	k.b(head, "Face", 0.6, 0.5, 0.05, C("#120A1A"), c(0, -0.05, -0.43))
	for _, sd in ipairs(SIDES) do k.eye(head, sd * 0.14, 0.02, -0.46, 0.14, 0.07, PK, sd * 0.25) end
	k.b(head, "CrownBand", 0.9, 0.16, 0.9, PU, c(0, 0.5, 0))
	for i = -2, 2 do k.spike(head, "CrownSpike", (i == 0) and 0.7 or 0.45, 0.16, DKL, c(i * 0.19, 0.58, -0.25)) end
	k.diamond(head, "CrownGem", 0.35, 0.24, 0.08, PK, c(0, 0.55, -0.46))
end

---------------------------------------------------------------- NIGHTMARE WYVERN (Mythical)
-- Shadow wyvern: two clawed hind legs and huge bat wings that reach down to the ground like front
-- legs (dark bones, purple membranes with red slashes), dark body with purple back spikes edged in red,
-- an S-curved neck, a dragon head with a hinged jaw, glowing red eyes and big curled purple horns,
-- a segmented tail curling up into a red stinger.
function M.NightmareWyvern(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local BK, BKL, PU, PUL, RD = C("#2A1C36"), C("#3A2A4A"), C("#7A2ACF"), C("#8E3AE0"), C("#FF2A4A")
	local BY = 2.4
	local body = k.body(1.7, 1.5, 2.4, BK, BY)
	for i = 0, 5 do
		local z = -0.9 + i * 0.4
		k.tri(body, "BackSpike", 0.16, 0.8 - i * 0.06, 0.55, PU, c(0, 0.95, z) * ANG(0.5, 0, 0))
		k.tri(body, "BackSpikeEdge", 0.17, 0.45, 0.2, RD, c(0, 0.95, z + 0.18) * ANG(0.5, 0, 0))
	end
	for i = 0, 2 do k.b(body, "BellyPlate", 0.9, 0.3, 0.14, (i % 2 == 0) and RD or PU, c(0, 0.3 - i * 0.38, -1.25)) end

	local lg = { up = { 0.9, 0.85, 1.0 }, col = BK, w2 = 0.7, d2 = 0.8, col2 = BKL, paw = { 1.0, 0.38, 1.15, -0.1 }, pawCol = BK, toes = 3, toeCol = PUL, hind = true }
	k.leg(body, "LegL", BY, -0.7, -0.5, 0.55, lg)
	k.leg(body, "LegR", BY, 0.7, -0.5, 0.55, lg)
	rig.legKind = "biped"

	-- S neck: three blocks leaning forward then back
	k.b(body, "Neck1", 0.85, 0.9, 0.8, BK, c(0, 0.8, -1.35) * ANG(-0.6, 0, 0))
	k.b(body, "Neck2", 0.75, 0.85, 0.75, PU, c(0, 1.45, -1.75) * ANG(-0.1, 0, 0))
	k.b(body, "Neck3", 0.7, 0.8, 0.7, BK, c(0, 2.1, -1.8) * ANG(0.25, 0, 0))
	k.b(body, "NeckStripe", 0.4, 1.4, 0.1, RD, c(0, 1.45, -2.13) * ANG(-0.1, 0, 0))
	local head = k.head(body, 0.95, 0.75, 1.3, BK, c(0, 2.65, -2.15), V3(0, -0.3, 0.45))
	k.b(head, "Snout", 0.75, 0.42, 0.7, BKL, c(0, -0.12, -0.9))
	local jaw = k.jb(head, "Jaw", 0.7, 0.2, 0.95, PU, c(0, -0.42, -0.6), V3(0, 0, 0.45))
	H.group(rig, "jaws", jaw)
	k.b(head, "Mouth", 0.6, 0.08, 0.6, RD, c(0, -0.33, -0.75))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.28, 0.12, -0.66, 0.24, 0.1, RD, sd * 0.35)
		local pts = { V3(sd * 0.35, 0.3, 0.25), V3(sd * 0.7, 0.8, 0.4), V3(sd * 0.8, 1.3, 0.75), V3(sd * 0.75, 1.1, 1.2), V3(sd * 0.7, 0.65, 1.1), V3(sd * 0.7, 0.75, 0.8) }
		for i = 1, #pts - 1 do k.bar(head, "Horn", pts[i], pts[i + 1], 0.4 - i * 0.05, (i % 2 == 0) and PUL or PU, nil, nil, V3(1, 0, 0)) end
	end

	-- wings: wrist reaches down and forward to the ground (wyvern stance), membrane spreads up and back
	for _, sd in ipairs(SIDES) do
		-- arm rises to a high elbow, the forearm comes down to a clawed wrist on the ground,
		-- two fingers fan back from the elbow and the membrane fills between them
		local w = k.wing(body, sd, c(sd * 0.8, 0.5, -0.5) * ANG(0, -sd * 0.6, 0))
		local function P(x, y, z) return V3(x * sd, y, z or 0) end
		local O, E, Wr, F1, F2 = P(0, 0), P(1.1, 1.5), P(1.7, -2.45), P(3.4, 0.5), P(3.1, -1.4)
		k.bar(w, "WingArm", O, E, 0.42, BK)
		k.bar(w, "WingForearm", E, Wr, 0.36, BK)
		k.bar(w, "WingFinger", E, F1, 0.26, BK)
		k.bar(w, "WingFinger", E, F2, 0.24, BK)
		k.b(w, "ElbowKnob", 0.5, 0.5, 0.5, BKL, k.sc(CF(E)))
		k.b(w, "WristClaw", 0.55, 0.4, 0.65, BKL, k.sc(CF(Wr)))
		k.mem(w, "Membrane", E + P(0, 0, 0.06), F1 + P(0, 0, 0.06), F2 + P(0, 0, 0.06), 0.06, PU)
		k.mem(w, "Membrane", E + P(0, 0, 0.06), F2 + P(0, 0, 0.06), Wr + P(0, 0, 0.06), 0.06, PU)
		k.mem(w, "Membrane", E + P(0, 0, 0.06), Wr + P(0, 0, 0.06), P(0.1, -0.9, 0.06), 0.06, PUL)
		k.bar(w, "WingSlash", P(1.9, 0.4, -0.05), P(2.8, 0.1, -0.05), 0.16, RD)
		k.bar(w, "WingSlash", P(1.9, -0.9, -0.05), P(2.6, -1.3, -0.05), 0.14, RD)
	end

	local segs = {}
	for j = 1, 9 do
		local w = 0.65 - j * 0.035
		table.insert(segs, { w, w * 0.9, 0.5, (j % 2 == 0) and PU or BK, j == 1 and 0.2 or ((j <= 4) and -0.05 or -0.45) })
	end
	local rec = k.chain(body, c(0, 0.15, 1.15), segs, { name = "Tail", kind = "spine", i = 1, amp = 0.12, freq = 1.2, lag = 0.55 })
	for j, p in ipairs(rec.parts) do
		if j % 2 == 0 then k.b(p, "TailMark", 0.1, 0.3, 0.3, RD, c(0, 0.3, 0)) end
	end
	k.spike(rec.parts[#rec.parts], "Stinger", 0.9, 0.35, RD, c(0, 0, 0.25) * ANG(PI / 2, 0, 0))
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">SpeciesModelsSpace</string><ProtectedString name="Source"><![CDATA[-- SpeciesModelsSpace: hand-authored, reference-faithful models for the Space world
-- (Astro Blob, Moon Mouse, Comet Fish, Nebula Jelly, Star Whale, Nova Phoenix, Cosmic Dragon, Singularity Cat).
-- Location: ReplicatedStorage > Shared > SpeciesModelsSpace (ModuleScript), merged into SpeciesModels.

local K = require(script.Parent.ModelKit)
local V3, CF, ANG, PI, MAT, C = K.V3, K.CF, K.ANG, K.PI, K.MAT, K.C
local FACE, DOWN = ANG(0, PI / 2, 0), ANG(0, 0, PI)
local FLAT = ANG(PI / 2, 0, 0)
local SIDES = { -1, 1 }

local M = {}

local function line(k, parent, A, B, w, col, up)
	local _, p = k.bar(parent, "GlowLine", A, B, w, col, MAT.Neon, nil, up, w * 0.6)
	k.glow(p, col)
end

-- small four-point star facing -Z on `parent`: two thin crossed bars and a turned square centre (3 parts)
local function star(k, parent, cf, size, col, mat)
	k.b(parent, "Star", size * 0.16, size, 0.06, col, cf, mat)
	k.b(parent, "Star", size, size * 0.16, 0.06, col, cf, mat)
	k.b(parent, "StarCore", size * 0.32, size * 0.32, 0.07, col, cf * ANG(0, 0, PI / 4), mat)
end

---------------------------------------------------------------- ASTRO BLOB (Common)
-- Little TV-head robot pup: mint block body on four stubby legs with dark-green feet, a dark collar
-- with a pale square button, a pale CRT head with a dark screen showing two glowing mint eyes, pale
-- side knobs, and two segmented antennae ending in mint cubes.
function M.AstroBlob(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local M1, MD, W, WD, DK, EY = C("#7FE3B8"), C("#64CDA0"), C("#DFF3EA"), C("#C8E6D8"), C("#2F6E52"), C("#5FF0D0")
	local BY = 1.45
	local body = k.body(1.5, 1.15, 1.7, M1, BY)
	k.b(body, "BackPanel", 1.1, 0.12, 1.1, MD, c(0, 0.6, 0.25))
	for _, sd in ipairs(SIDES) do k.b(body, "SidePanel", 0.08, 0.6, 1.0, MD, c(sd * 0.76, 0.0, 0.2)) end
	local lg = { up = { 0.55, 0.45, 0.6 }, col = M1, w2 = 0.5, d2 = 0.56, col2 = MD, paw = { 0.62, 0.3, 0.7 }, pawCol = DK }
	k.leg(body, "LegFL", BY, -0.45, -0.45, -0.55, lg)
	k.leg(body, "LegFR", BY, 0.45, -0.45, -0.55, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.45, -0.45, 0.55, lg)
	k.leg(body, "LegBR", BY, 0.45, -0.45, 0.55, lg)
	rig.legKind = "quad"
	k.b(body, "Collar", 1.4, 0.3, 0.6, DK, c(0, 0.5, -0.65))
	k.b(body, "CollarButton", 0.3, 0.28, 0.08, W, c(0, 0.45, -0.98))

	local head = k.head(body, 1.45, 1.15, 1.0, W, c(0, 1.2, -0.7), V3(0, -0.45, 0.25))
	k.b(head, "Bezel", 1.25, 0.95, 0.06, WD, c(0, 0, -0.52))
	k.b(head, "Screen", 1.05, 0.75, 0.08, DK, c(0, 0, -0.55))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.25, 0.02, -0.6, 0.3, 0.16, EY, 0)
		k.b(head, "EarKnob", 0.2, 0.5, 0.5, W, c(sd * 0.82, 0.05, 0))
		local ant = k.ear(head, sd, c(sd * 0.3, 0.58, 0.1), "antenna")
		k.b(ant, "AntennaBase", 0.22, 0.2, 0.22, DK, c(0, 0.1, 0))
		local p1, p2, p3 = V3(0, 0.15, 0), V3(sd * 0.25, 0.65, 0), V3(sd * 0.45, 1.05, -0.05)
		k.bar(ant, "Antenna", p1, p2, 0.16, M1, nil, nil, V3(0, 0, 1))
		k.b(ant, "AntennaJoint", 0.2, 0.2, 0.2, DK, c(p2.X, p2.Y, p2.Z))
		k.bar(ant, "Antenna", p2, p3, 0.15, M1, nil, nil, V3(0, 0, 1))
		k.b(ant, "AntennaTip", 0.3, 0.3, 0.3, M1, c(p3.X, p3.Y + 0.1, p3.Z) * ANG(0.3, 0.4, 0))
	end
end

---------------------------------------------------------------- MOON MOUSE (Uncommon)
-- Astronaut mouse: grey body in a white harness with pink straps and a belt buckle carrying a pink
-- crescent moon, a white backpack, grey legs with white boots, a grey head with white muzzle, pink nose
-- and pink eyes inside a faceted glass helmet, huge round ears (pink and white insides), and a thin
-- segmented tail curling up to a pink-and-white tip.
function M.MoonMouse(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local G, GD, W, WD, P, GL, EY = C("#B8B4C8"), C("#9E9AB2"), C("#F2F2F6"), C("#DCDCE4"), C("#F282B8"), C("#DDE8F5"), C("#FF6FB0")
	local BY = 1.45
	local body = k.body(1.35, 1.1, 1.6, G, BY)
	k.b(body, "Collar", 1.45, 0.3, 0.5, W, c(0, 0.45, -0.6))
	k.b(body, "Belt", 1.0, 0.4, 0.12, W, c(0, -0.05, -0.83))
	k.b(body, "Buckle", 0.5, 0.32, 0.06, GD, c(0, -0.05, -0.9))
	k.b(body, "Moon", 0.12, 0.22, 0.04, P, c(-0.04, -0.05, -0.94))
	k.b(body, "MoonTip", 0.08, 0.08, 0.04, P, c(0.04, 0.06, -0.94))
	k.b(body, "MoonTip", 0.08, 0.08, 0.04, P, c(0.04, -0.16, -0.94))
	for _, sd in ipairs(SIDES) do
		k.b(body, "Strap", 0.08, 1.15, 0.25, P, c(sd * 0.69, 0, -0.1) * ANG(0.35, 0, 0))
		k.b(body, "StrapBuckle", 0.1, 0.25, 0.32, W, c(sd * 0.71, -0.15, -0.05))
	end
	local _, pack = k.b(body, "Backpack", 1.0, 0.45, 0.9, W, c(0, 0.75, 0.25))
	k.b(pack, "PackStripe", 1.02, 0.08, 0.2, P, c(0, 0.24, 0.2))
	local lg = { up = { 0.5, 0.45, 0.55 }, col = G, w2 = 0.44, d2 = 0.5, paw = { 0.58, 0.32, 0.7 }, pawCol = W }
	k.leg(body, "LegFL", BY, -0.42, -0.45, -0.5, lg)
	k.leg(body, "LegFR", BY, 0.42, -0.45, -0.5, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.42, -0.45, 0.5, lg)
	k.leg(body, "LegBR", BY, 0.42, -0.45, 0.5, lg)
	rig.legKind = "quad"

	local head = k.head(body, 0.95, 0.85, 0.85, G, c(0, 1.15, -0.75), V3(0, -0.4, 0.25))
	k.b(head, "Muzzle", 0.55, 0.32, 0.25, W, c(0, -0.25, -0.5))
	k.b(head, "Nose", 0.18, 0.12, 0.08, P, c(0, -0.15, -0.66))
	for _, sd in ipairs(SIDES) do k.eye(head, sd * 0.22, 0.08, -0.44, 0.16, 0.18, EY, 0) end
	-- faceted glass helmet (two crossed boxes read as an octagon)
	k.b(head, "Helmet", 1.3, 1.2, 1.25, GL, c(0, 0.05, -0.05), MAT.Glass, 0.65)
	k.b(head, "Helmet", 1.1, 1.3, 1.1, GL, c(0, 0.05, -0.05) * ANG(0, PI / 4, 0), MAT.Glass, 0.7)
	for _, sd in ipairs(SIDES) do
		local ear = k.ear(head, sd, c(sd * 0.55, 0.55, 0.15) * ANG(0, 0, -sd * 0.25), "round")
		-- round-ish octagonal ear: two crossed rectangles
		k.b(ear, "Ear", 1.0, 0.7, 0.18, G, c(0, 0.5, 0))
		k.b(ear, "Ear", 0.7, 1.0, 0.18, G, c(0, 0.5, 0))
		k.b(ear, "EarPink", 0.6, 0.35, 0.06, P, c(0, 0.68, -0.1))
		k.b(ear, "EarWhite", 0.6, 0.3, 0.06, W, c(0, 0.36, -0.1))
	end

	local tip = k.tail(body, c(0, 0.2, 0.85), {
		{ 0.16, 0.16, 0.35, -0.5, G }, { 0.16, 0.16, 0.35, -0.35, G }, { 0.15, 0.15, 0.35, -0.4, G }, { 0.15, 0.15, 0.32, 0.2, G }, { 0.14, 0.14, 0.3, -0.3, G } })
	k.b(tip, "TailTip", 0.4, 0.28, 0.4, W, c(0, 0, 0.3))
	k.b(tip, "TailTipPink", 0.42, 0.12, 0.42, P, c(0, 0.18, 0.3))
end

---------------------------------------------------------------- COMET FISH (Rare)
-- Space shark: blue angular body with a white underside, a pointed snout with glowing yellow eyes,
-- white gill slits, a tall dorsal fin with white and yellow insets, white pectoral fins with yellow
-- stripes, a small ventral fin, and a segmented tail ending in a forked yellow lightning-bolt fin.
function M.CometFish(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local B, BD, W, Y, EY = C("#4AA8E8"), C("#3A8AD0"), C("#F2F4F6"), C("#FFD83A"), C("#FFD83A")
	local BY = 1.5
	local body = k.body(1.15, 1.0, 1.7, B, BY)
	rig.legKind = "none"
	k.b(body, "Belly", 1.0, 0.35, 1.6, W, c(0, -0.4, 0))
	k.b(body, "BackRidge", 0.7, 0.2, 1.4, BD, c(0, 0.55, 0.1))
	for _, sd in ipairs(SIDES) do
		for g = 0, 2 do k.b(body, "Gill", 0.06, 0.4, 0.08, W, c(sd * 0.58, -0.02, -0.35 + g * 0.16)) end
	end
	local head = k.head(body, 1.05, 0.85, 0.9, B, c(0, 0.05, -1.2), V3(0, 0, 0.4))
	k.w(head, "Snout", 0.95, 0.55, 0.65, B, c(0, 0.08, -0.75))
	k.w(head, "Jaw", 0.9, 0.35, 0.9, W, c(0, -0.32, -0.55) * DOWN)
	k.b(head, "Brow", 1.0, 0.18, 0.5, BD, c(0, 0.38, -0.2))
	for _, sd in ipairs(SIDES) do k.eye(head, sd * 0.38, 0.1, -0.46, 0.26, 0.1, EY, sd * 0.3) end
	local _, fin = k.pv(body, "Dorsal", c(0, 0.6, 0.0))
	k.tri(fin, "DorsalFin", 0.18, 1.2, 1.1, B, c(0, 0.55, 0.15) * ANG(0.45, 0, 0))
	k.tri(fin, "DorsalInset", 0.2, 0.8, 0.45, W, c(0, 0.45, 0.42) * ANG(0.45, 0, 0))
	k.tri(fin, "DorsalStripe", 0.21, 0.6, 0.18, Y, c(0, 0.4, 0.5) * ANG(0.45, 0, 0))
	k.tri(body, "VentralFin", 0.14, 0.5, 0.45, B, c(0, -0.7, -0.35) * DOWN * ANG(0.5, 0, 0))
	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.5, -0.3, -0.35) * ANG(0, -sd * 0.5, 0))
		k.bar(w, "Pectoral", V3(0, 0, 0), V3(sd * 1.3, -0.7, 0), 0.5, W, nil, nil, nil, 0.12)
		k.bar(w, "PectoralStripe", V3(sd * 0.2, -0.05, -0.08), V3(sd * 1.1, -0.55, -0.08), 0.14, Y, nil, nil, nil, 0.06)
	end
	local segs = {}
	for j = 1, 4 do
		local w = 0.75 - j * 0.1
		table.insert(segs, { w, w * 0.9, 0.55, (j % 2 == 0) and BD or B, (j == 1) and -0.05 or 0.02 })
	end
	local rec = k.chain(body, c(0, 0.05, 0.8), segs, { name = "Tail", kind = "spine", i = 1, amp = 0.3, freq = 2.0, lag = 0.6 })
	for j, p in ipairs(rec.parts) do
		local w = 0.75 - j * 0.1
		k.b(p, "TailBelly", w * 0.8, 0.12, 0.5, Y, c(0, -w * 0.42, 0))
		if j == 2 then k.tri(p, "TailFinlet", 0.12, 0.45, 0.35, B, c(0, w * 0.45 + 0.2, 0) * ANG(0.5, 0, 0)) end
	end
	-- forked lightning fin: two zigzag prongs
	local last = rec.parts[#rec.parts]
	for _, sd in ipairs({ -1, 1 }) do
		local _, pr = k.pv(last, "Prong", c(0, 0, 0.25) * ANG(-sd * 0.55, 0, 0))
		k.b(pr, "Bolt", 0.14, 0.3, 0.7, Y, c(0, 0, 0.35))
		k.b(pr, "Bolt", 0.14, 0.3, 0.6, Y, c(0, sd * 0.25, 0.75) * ANG(sd * 0.6, 0, 0))
		k.w(pr, "BoltTip", 0.14, 0.3, 0.55, Y, c(0, sd * 0.2, 1.25) * ANG(0, PI, 0))
	end
	k.w(last, "BoltCenter", 0.14, 0.3, 0.9, Y, c(0, 0, 0.75) * ANG(0, PI, 0))
end

---------------------------------------------------------------- NEBULA JELLY (Epic)
-- Space jellyfish: a stepped purple bell with angled purple fins traced by glowing cyan slots, a dark
-- visor with glowing cyan eyes, a skirt of eight pink plates with cyan slots, a glowing pink core below,
-- and eight segmented purple tentacles with cyan lights and pink spike tips.
function M.NebulaJelly(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PU, PUD, PUL, PK, CY, CORE = C("#9A4AE0"), C("#7A34C0"), C("#B068F0"), C("#F07AC8"), C("#5FE8F5"), C("#FF5AD0")
	local BY = 2.6
	local body = k.body(2.2, 0.9, 2.0, PU, BY)
	rig.legKind = "none"
	k.b(body, "BellMid", 1.7, 0.5, 1.6, PUL, c(0, 0.6, 0))
	k.b(body, "BellTop", 1.0, 0.4, 1.0, PU, c(0, 1.0, 0.05))
	local _, slot = k.b(body, "TopSlot", 0.3, 0.42, 0.6, CY, c(0, 1.02, -0.1), MAT.Neon)
	k.glow(slot, CY)
	k.b(body, "Visor", 1.3, 0.32, 0.06, C("#2A1240"), c(0, 0.15, -1.02))
	for _, sd in ipairs(SIDES) do
		k.eye(body, sd * 0.3, 0.15, -1.06, 0.3, 0.1, CY, -sd * 0.25)
		local _, f = k.pv(body, "Fin", c(sd * 0.95, 0.65, 0.0) * ANG(0, 0, -sd * 0.6))
		k.tri(f, "FinBlade", 0.2, 1.2, 0.9, PU, c(0, 0.55, 0) * FACE)
		line(k, f, V3(-sd * 0.0, 0.25, -0.12), V3(-sd * 0.0, 0.85, -0.12), 0.12, CY)
		k.tri(body, "Horn", 0.16, 0.6, 0.4, PK, c(sd * 0.45, 1.15, -0.2) * ANG(0, 0, -sd * 0.4) * FACE)
	end
	-- pink skirt plates with cyan slots (open on the power move)
	for i = 0, 7 do
		local a = (i + 0.5) / 8 * PI * 2
		local d = V3(math.sin(a), 0, -math.cos(a))
		local pos = V3(0, -0.35, 0) + d * 0.95
		local pl = k.opener(body, "Plate", CFrame.lookAt(pos * s, (pos + d) * s), V3(1, 0, 0), -0.4)
		-- hanging panel facing outward, bottom edge flared out
		local _, plate = k.b(pl, "SkirtPlate", 0.85, 0.65, 0.16, PK, ANG(0.4, 0, 0) * c(0, -0.28, 0))
		local _, sl = k.b(plate, "PlateSlot", 0.5, 0.1, 0.06, CY, c(0, -0.1, -0.1), MAT.Neon)
		k.glow(sl, CY)
	end
	local _, core = k.b(body, "Core", 0.85, 0.55, 0.85, CORE, c(0, -0.7, -0.1), MAT.Neon)
	k.glow(core, CORE)
	k.b(body, "CoreTip", 0.45, 0.35, 0.45, CORE, c(0, -1.1, -0.1), MAT.Neon)
	-- eight tentacles (trail chains)
	for i = 0, 7 do
		local a = (i + 0.5) / 8 * PI * 2
		local d = V3(math.sin(a), 0, -math.cos(a))
		local pos = V3(0, -0.5, 0) + d * 0.6
		local base = CFrame.lookAt(pos * s, (pos - d) * s) * ANG(1.25, 0, 0)
		local segs = {}
		for j = 1, 5 do table.insert(segs, { 0.24, 0.24, 0.42, (j % 2 == 0) and PUD or PU, (j == 1) and 0 or -0.06 }) end
		local rec = k.chain(body, base, segs, { name = "Tentacle", kind = "trail", i = i + 1, amp = 0.15, freq = 1.4, lag = 0.5 })
		for j, p in ipairs(rec.parts) do
			if j % 2 == 1 then
				local _, l = k.b(p, "TentacleLight", 0.08, 0.1, 0.22, CY, c(0, 0, 0) * CF(0.13 * s, 0, 0), MAT.Neon)
				k.glow(l, CY)
			end
		end
		k.spike(rec.parts[#rec.parts], "TentacleTip", 0.5, 0.28, PK, c(0, 0, 0.2) * ANG(PI / 2, 0, 0))
	end
end

---------------------------------------------------------------- STAR WHALE (Legendary)
-- Cosmic whale: navy body with a ridged light-blue belly, a gold stripe along each side, gold four-point
-- stars, a glowing yellow eye, big navy pectoral fins with light-blue edges and gold stars, a small dorsal
-- fin, a tail with horizontal flukes, and a tilted gold ring with square star gems orbiting the body.
function M.StarWhale(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local DB, DBL, LB, LBD, GO, EY = C("#2A3A9A"), C("#34479F"), C("#A8C8F0"), C("#8FB4E4"), C("#F2C230"), C("#FFE45C")
	local BY = 2.0
	local body = k.body(2.0, 1.6, 3.0, DB, BY)
	rig.legKind = "none"
	for i = 0, 5 do
		-- ridged light-blue belly filling the lower half and bulging below the navy back
		k.b(body, "BellyRidge", 2.1 - math.abs(i - 2.5) * 0.12, 0.85, 0.44, (i % 2 == 0) and LB or LBD, c(0, -0.62, -1.2 + i * 0.48))
		k.b(body, "BellyKeel", 1.5 - math.abs(i - 2.5) * 0.15, 0.25, 0.4, (i % 2 == 0) and LBD or LB, c(0, -1.1, -1.2 + i * 0.48))
	end
	k.b(body, "Head", 2.05, 1.2, 1.0, DBL, c(0, 0.15, -1.6))
	k.w(body, "Brow", 2.05, 0.35, 0.7, DB, c(0, 0.85, -1.55))
	for _, sd in ipairs(SIDES) do
		k.b(body, "GoldStripe", 0.06, 0.1, 3.2, GO, c(sd * 1.03, 0.0, -0.2))
		k.eye(body, sd * 1.04, 0.25, -1.4, 0.06, 0.12, EY, 0)
		local _, e = k.b(body, "EyeSide", 0.08, 0.14, 0.28, EY, c(sd * 1.04, 0.25, -1.4), MAT.Neon)
		k.glow(e, EY)
		for i, d in ipairs({ { 0.35, -0.3, 0.45 }, { 0.3, 0.6, 0.35 }, { 0.45, 1.1, 0.3 } }) do
			star(k, body, c(sd * 1.03, d[1], d[2]) * ANG(0, -sd * PI / 2, 0), d[3], GO)
		end
	end
	k.tri(body, "Dorsal", 0.16, 0.5, 0.6, DB, c(0, 0.95, 0.6) * ANG(0.5, 0, 0))

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.95, -0.35, -0.5) * ANG(0, -sd * 0.55, 0))
		k.bar(w, "Flipper", V3(0, 0, 0), V3(sd * 2.2, -0.9, 0), 0.9, DB, nil, nil, nil, 0.16)
		k.bar(w, "FlipperEdge", V3(sd * 0.2, -0.4, 0.02), V3(sd * 2.2, -1.25, 0.02), 0.3, LB, nil, nil, nil, 0.14)
		k.bar(w, "FlipperGold", V3(sd * 0.2, 0.3, -0.02), V3(sd * 2.0, -0.55, -0.02), 0.08, GO, nil, nil, nil, 0.18)
		star(k, w, c(sd * 1.3, -0.5, -0.1), 0.4, GO)
	end

	local segs = {}
	for j = 1, 4 do
		local w = 1.5 - j * 0.25
		table.insert(segs, { w, w * 0.8, 0.75, (j % 2 == 0) and DBL or DB, (j == 1) and -0.1 or -0.12 })
	end
	local rec = k.chain(body, c(0, 0.15, 1.45), segs, { name = "Tail", kind = "fluke", i = 1, amp = 0.15, freq = 1.0, lag = 0.6 })
	for j, p in ipairs(rec.parts) do
		local w = 1.5 - j * 0.25
		k.b(p, "TailBelly", w * 0.85, 0.12, 0.7, LB, c(0, -w * 0.38, 0))
	end
	local last = rec.parts[#rec.parts]
	for _, sd in ipairs(SIDES) do
		local _, fl = k.pv(last, "Fluke", c(sd * 0.2, 0, 0.3) * ANG(0, -sd * 0.5, 0))
		k.b(fl, "FlukePlate", 1.6, 0.14, 0.75, DB, c(sd * 0.75, 0, 0.2))
		k.b(fl, "FlukeEdge", 1.5, 0.15, 0.2, LB, c(sd * 0.75, 0, 0.6))
		k.b(fl, "FlukeGold", 1.3, 0.16, 0.06, GO, c(sd * 0.7, 0, 0.0))
	end

	local re, rp = k.pv(body, "Ring", c(0, 0.1, 0.2) * ANG(0.35, 0, 0.5))
	H.group(rig, "rings", re)
	k.ring(rp, "GoldRing", FLAT, 2.0, 18, 0.18, 0.75, 0.16, GO)
	for i = 0, 2 do
		local a = i / 3 * PI * 2
		local _, g = k.b(rp, "RingGem", 0.45, 0.45, 0.45, DB, k.c(math.cos(a) * 2.0, 0, math.sin(a) * 2.0))
		k.b(g, "RingGemFrame", 0.5, 0.5, 0.2, GO, CF())
		star(k, g, c(0, 0, -0.26), 0.3, GO)
	end
end

---------------------------------------------------------------- NOVA PHOENIX (Legendary)
-- Cosmic phoenix: dark-purple armoured body with pink plates and a cyan diamond, legs with cyan lines
-- and pink talons, a purple head with a pink hooked beak and a crest of pink spikes, glowing cyan eyes,
-- a cyan-and-pink halo over the head and another around the neck, huge layered wings (purple, pink and
-- cyan blades), and zigzag pink and cyan lightning tail streamers.
function M.NovaPhoenix(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PU, PUD, PK, PKL, CY, EY = C("#3A1F6E"), C("#2A1550"), C("#F07AC8"), C("#F5A0DC"), C("#7FE8F5"), C("#7FF0FF")
	local BY = 2.85
	local body = k.body(1.15, 1.5, 1.15, PU, BY)
	k.tri(body, "ChestPlate", 0.14, 1.1, 1.1, PK, c(0, 0.15, -0.6) * DOWN * FACE)
	k.diamond(body, "ChestGem", 0.6, 0.38, 0.1, CY, c(0, 0.1, -0.68), MAT.Glass)
	for _, sd in ipairs(SIDES) do k.b(body, "SidePlate", 0.1, 0.8, 0.8, PK, c(sd * 0.6, 0.1, 0.05) * ANG(0.3, 0, 0)) end
	local lg = { up = { 0.55, 0.6, 0.65 }, col = PU, w2 = 0.32, d2 = 0.34, col2 = PUD, band = CY, paw = { 0.75, 0.22, 0.8, -0.12 }, pawCol = PK, toes = 3, toeCol = PK }
	k.leg(body, "LegL", BY, -0.33, -0.7, 0.05, lg)
	k.leg(body, "LegR", BY, 0.33, -0.7, 0.05, lg)
	rig.legKind = "biped"

	k.b(body, "Neck", 0.5, 0.8, 0.5, PU, c(0, 0.95, -0.25) * ANG(-0.25, 0, 0))
	local ne, np = k.pv(body, "NeckHalo", c(0, 0.9, -0.2) * ANG(0.35, 0, 0))
	table.insert(rig.halos, ne)
	k.ring(np, "NeckHalo", FLAT, 0.8, 12, 0.12, 0.45, 0.12, CY)
	local head = k.head(body, 0.72, 0.68, 0.85, PU, c(0, 1.6, -0.45), V3(0, -0.3, 0.2))
	k.w(head, "Beak", 0.36, 0.3, 0.5, PK, c(0, -0.08, -0.65))
	k.b(head, "BeakTip", 0.22, 0.25, 0.14, PK, c(0, -0.22, -0.86))
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.22, 0.08, -0.43, 0.2, 0.1, EY, sd * 0.35)
		k.tri(head, "CheekSpike", 0.1, 0.5, 0.3, PK, c(sd * 0.38, -0.05, 0.1) * ANG(0.9, 0, -sd * 0.6))
	end
	for _, d in ipairs({ { 0, 1.0, PK }, { -0.18, 0.75, PKL }, { 0.18, 0.75, PKL }, { -0.32, 0.55, CY }, { 0.32, 0.55, CY } }) do
		k.tri(head, "Crest", 0.12, d[2], 0.4, d[3], c(d[1], 0.3 + d[2] * 0.4, 0.15) * ANG(0.6, 0, -d[1] * 1.2))
	end
	local he, hp = k.pv(head, "Halo", c(0, 0.95, 0.1))
	table.insert(rig.halos, he)
	k.ring(hp, "Halo", FLAT, 0.75, 14, 0.12, 0.38, 0.12, CY)
	for i = 0, 3 do k.b(hp, "HaloPink", 0.14, 0.14, 0.45, PK, k.c(math.cos(i * PI / 2) * 0.75, 0, math.sin(i * PI / 2) * 0.75) * ANG(0, -i * PI / 2, 0)) end

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.5, 0.5, 0.2))
		k.featherWing(w, sd, { root = 0.15, z = 0.05, thick = 0.12, feathers = {
			{ 1.25, 2.5, 0.42, PU, PK }, { 1.0, 2.9, 0.45, PK, PKL }, { 0.75, 3.1, 0.45, PU, PK }, { 0.5, 2.9, 0.45, PK, PKL },
			{ 0.25, 2.5, 0.42, PU, PK }, { 0.0, 2.0, 0.4, PK, PK } } })
		k.featherWing(w, sd, { root = 0.1, z = -0.05, thick = 0.13, feathers = {
			{ 1.05, 1.6, 0.36, CY }, { 0.75, 1.7, 0.36, PUD }, { 0.45, 1.5, 0.34, CY }, { 0.15, 1.2, 0.32, PUD } } })
	end

	for i, x in ipairs({ -0.35, -0.12, 0.12, 0.35 }) do
		local segs = {}
		for j = 1, 6 do
			local col = (i % 2 == 0) and ((j % 2 == 0) and CY or PK) or ((j % 2 == 0) and PK or PKL)
			table.insert(segs, { 0.22, 0.12, 0.55, col, (j == 1) and 0.9 or -0.12, (j == 1) and x * 0.6 or ((j % 2 == 0) and 0.45 or -0.45) })
		end
		local rec = k.chain(body, c(x, -0.5, 0.45), segs, { name = "Streamer", kind = "trail", i = i, amp = 0.12, freq = 1.6, lag = 0.5 })
		k.w(rec.parts[#rec.parts], "StreamerTip", 0.22, 0.12, 0.5, (i % 2 == 0) and CY or PK, c(0, 0, 0.5) * ANG(0, PI, 0))
	end
end

---------------------------------------------------------------- COSMIC DRAGON (Mythical)
-- Constellation dragon: purple armoured body with dark plates traced by glowing star constellations,
-- a pink chevron and star on the chest, clawed legs with pink claws, a horned head with glowing eyes,
-- a pink ring with square star nodes around the neck, huge bat wings with dark bones and magenta
-- membranes carrying glowing constellations, a spiked tail with a pink ring and a star spear tip.
function M.CosmicDragon(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local PU, PUD, PUL, MG, PK, NE = C("#5A2A9A"), C("#3A1A6E"), C("#7A40C0"), C("#E070E0"), C("#F07AD0"), C("#FF9AF5")
	local function constellation(parent, pts, z, side)
		for i = 1, #pts - 1 do line(k, parent, V3(pts[i][1] * (side or 1), pts[i][2], z), V3(pts[i + 1][1] * (side or 1), pts[i + 1][2], z), 0.05, NE) end
		for _, p in ipairs(pts) do
			local _, d = k.b(parent, "StarDot", 0.14, 0.14, 0.08, NE, c(p[1] * (side or 1), p[2], z), MAT.Neon)
			k.glow(d, NE)
		end
	end
	local BY = 2.4
	local body = k.body(1.9, 1.6, 2.5, PU, BY)
	k.b(body, "Chest", 1.7, 1.5, 0.85, PUD, c(0, 0.05, -1.15))
	k.tri(body, "Chevron", 0.12, 0.6, 1.1, PK, c(0, -0.35, -1.6) * DOWN * FACE)
	star(k, body, c(0, 0.25, -1.62), 0.6, NE, MAT.Neon)
	for _, sd in ipairs(SIDES) do
		k.b(body, "ConstellationPlate", 0.14, 1.0, 1.0, PUD, c(sd * 0.98, 0.1, 0.1) * ANG(PI / 4, 0, 0))
		for _, seg in ipairs({ { V3(sd * 1.06, 0.45, -0.3), V3(sd * 1.06, 0.1, 0.05) }, { V3(sd * 1.06, 0.1, 0.05), V3(sd * 1.06, -0.25, -0.15) }, { V3(sd * 1.06, 0.1, 0.05), V3(sd * 1.06, 0.3, 0.45) } }) do line(k, body, seg[1], seg[2], 0.05, NE, V3(1, 0, 0)) end
		for _, p in ipairs({ V3(sd * 1.07, 0.45, -0.3), V3(sd * 1.07, 0.1, 0.05), V3(sd * 1.07, -0.25, -0.15), V3(sd * 1.07, 0.3, 0.45) }) do local _, d = k.b(body, "StarDot", 0.08, 0.14, 0.14, NE, k.sc(CF(p)), MAT.Neon); k.glow(d, NE) end
	end
	for i = 0, 5 do k.tri(body, "BackSpike", 0.16, 0.6 - i * 0.04, 0.5, PK, c(0, 0.95, -0.9 + i * 0.42) * ANG(0.5, 0, 0)) end

	local lf = { up = { 0.85, 0.75, 0.95 }, col = PU, w2 = 0.72, d2 = 0.8, col2 = PUL, paw = { 1.05, 0.38, 1.2, -0.1 }, pawCol = PUD, toes = 3, toeCol = PK }
	k.leg(body, "LegFL", BY, -0.8, -0.55, -0.85, lf)
	k.leg(body, "LegFR", BY, 0.8, -0.55, -0.85, lf)
	lf.hind = true
	k.leg(body, "LegBL", BY, -0.85, -0.5, 0.9, lf)
	k.leg(body, "LegBR", BY, 0.85, -0.5, 0.9, lf)
	rig.legKind = "quad"

	k.b(body, "Neck1", 1.0, 1.0, 0.9, PU, c(0, 0.75, -1.45) * ANG(-0.5, 0, 0))
	k.b(body, "Neck2", 0.9, 0.9, 0.85, PUL, c(0, 1.35, -1.75) * ANG(-0.3, 0, 0))
	local re, rp = k.pv(body, "NeckRing", c(0, 1.3, -1.7) * ANG(0.5, 0, 0))
	H.group(rig, "rings", re)
	k.ring(rp, "PinkRing", FLAT, 1.1, 14, 0.14, 0.5, 0.14, PK)
	for i = 0, 2 do
		local a = i / 3 * PI * 2
		local _, n = k.b(rp, "RingNode", 0.35, 0.35, 0.35, PUD, k.c(math.cos(a) * 1.1, 0, math.sin(a) * 1.1))
		star(k, n, c(0, 0, -0.19), 0.24, NE, MAT.Neon)
	end
	local head = k.head(body, 1.1, 0.85, 1.3, PU, c(0, 2.05, -2.15), V3(0, -0.35, 0.4))
	k.b(head, "Snout", 0.8, 0.48, 0.75, PU, c(0, -0.15, -0.95))
	k.b(head, "Brow", 1.15, 0.22, 0.5, PUD, c(0, 0.35, -0.45))
	local jaw = k.jb(head, "Jaw", 0.75, 0.22, 1.05, PUD, c(0, -0.48, -0.65), V3(0, 0, 0.5))
	H.group(rig, "jaws", jaw)
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.32, 0.12, -0.66, 0.28, 0.1, NE, sd * 0.3)
		k.spike(head, "Horn", 1.2, 0.34, PUL, c(sd * 0.4, 0.4, 0.3) * ANG(1.0, 0, -sd * 0.35))
		k.spike(head, "HornSmall", 0.6, 0.24, PK, c(sd * 0.52, 0.0, 0.45) * ANG(1.3, 0, -sd * 0.8))
	end

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.8, 0.65, -0.35))
		k.batWing(w, sd, { wrist = Vector2.new(1.5, 2.3), bone = PUD, mem = MG, boneW = 0.34, cap = PU,
			tips = { Vector2.new(4.0, 1.1), Vector2.new(3.4, -0.4), Vector2.new(2.3, -1.0), Vector2.new(1.1, -0.9) } })
		local _, node = k.b(w, "WristNode", 0.45, 0.6, 0.35, PUD, c(sd * 1.5, 2.3, -0.05))
		star(k, node, c(0, 0, -0.19), 0.35, NE, MAT.Neon)
		constellation(w, { { 2.0, 1.2 }, { 2.6, 0.7 }, { 3.0, 0.9 }, { 2.7, 0.2 } }, -0.12, sd)
		constellation(w, { { 1.6, 0.2 }, { 2.0, -0.3 }, { 2.4, -0.2 } }, -0.12, sd)
	end

	local segs = {}
	for j = 1, 8 do
		local w = 0.8 - j * 0.06
		table.insert(segs, { w, w * 0.85, 0.6, (j % 2 == 0) and PUD or PU, (j == 1) and 0.3 or -0.06 })
	end
	local rec = k.chain(body, c(0, 0.1, 1.2), segs, { name = "Tail", kind = "spine", i = 1, amp = 0.15, freq = 1.3, lag = 0.55 })
	for j, p in ipairs(rec.parts) do
		local w = 0.8 - j * 0.06
		k.tri(p, "TailSpike", 0.12, 0.42 - j * 0.02, 0.35, PK, c(0, w * 0.42 + 0.17, 0) * ANG(0.4, 0, 0))
		if j == 6 then k.ring(p, "TailRing", CF(), w * 0.6, 8, 0.12, w * 0.5, 0.25, PK) end
	end
	local last = rec.parts[#rec.parts]
	local tipRot = ANG(0, PI / 2, 0) * ANG(0, 0, PI / 2)
	k.tri(last, "Spear", 0.14, 0.9, 0.8, PU, c(0, 0, 0.7) * tipRot)
	star(k, last, c(0, 0.09, 0.6) * ANG(-PI / 2, 0, 0), 0.4, NE, MAT.Neon)
end

---------------------------------------------------------------- SINGULARITY CAT (Mythical)
-- Void cat: black body with a white V on the chest and glowing purple lines, black legs with purple
-- bands and white paws, a black head with tall ears (purple and white insides) and a single vertical
-- glowing purple eye slit, a segmented tail curling up to three purple claw blades, and two big white
-- and purple orbit rings circling it (one flat, one upright).
function M.Singularity(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local BK, BKL, W, PU, EY = C("#1A1820"), C("#2A2832"), C("#F2F0F8"), C("#7A4AF0"), C("#B08AFF")
	local BY = 2.0
	local body = k.body(1.1, 1.0, 2.0, BK, BY)
	k.tri(body, "ChestV", 0.12, 0.9, 1.0, W, c(0, -0.05, -1.02) * DOWN * FACE)
	for _, sd in ipairs(SIDES) do
		line(k, body, V3(sd * 0.56, 0.2, -0.8), V3(sd * 0.56, 0.2, 0.6), 0.08, PU, V3(1, 0, 0))
		k.b(body, "HipPlate", 0.1, 0.5, 0.6, BKL, c(sd * 0.56, 0.0, 0.65))
	end
	local lg = { up = { 0.45, 0.75, 0.55 }, col = BK, w2 = 0.36, d2 = 0.45, band = PU, bandY = 0.2, paw = { 0.45, 0.35, 0.55 }, pawCol = W, toes = 2, toeCol = W }
	k.leg(body, "LegFL", BY, -0.33, -0.45, -0.75, lg)
	k.leg(body, "LegFR", BY, 0.33, -0.45, -0.75, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.33, -0.45, 0.75, lg)
	k.leg(body, "LegBR", BY, 0.33, -0.45, 0.75, lg)
	rig.legKind = "quad"

	local head = k.head(body, 0.8, 0.75, 0.8, BK, c(0, 0.85, -1.15), V3(0, -0.3, 0.25))
	k.w(head, "Muzzle", 0.5, 0.32, 0.4, BKL, c(0, -0.22, -0.55))
	k.b(head, "EyeSocket", 0.18, 0.5, 0.05, W, c(0, 0.08, -0.41))
	k.eye(head, 0, 0.08, -0.44, 0.1, 0.4, EY, 0)
	for _, sd in ipairs(SIDES) do
		local ear = k.ear(head, sd, c(sd * 0.25, 0.35, 0.05) * ANG(0, 0, -sd * 0.15))
		k.tri(ear, "Ear", 0.18, 0.95, 0.5, BK, c(0, 0.47, 0) * FACE)
		k.tri(ear, "EarPurple", 0.06, 0.65, 0.3, PU, c(0, 0.38, -0.1) * FACE, MAT.Neon)
		k.tri(ear, "EarWhite", 0.07, 0.35, 0.3, W, c(0, 0.15, -0.11) * FACE)
	end

	local tip = k.tail(body, c(0, 0.3, 1.05), {
		{ 0.24, 0.24, 0.5, 0.3, BK }, { 0.24, 0.24, 0.5, -0.4, BK }, { 0.22, 0.22, 0.45, -0.6, BKL }, { 0.22, 0.22, 0.45, -0.7, BK }, { 0.2, 0.2, 0.4, -0.6, BK } })
	for _, e in ipairs(rig.tail) do
		local _, l = k.b(e.part, "TailLight", 0.26, 0.05, 0.08, PU, c(0, 0.13, 0), MAT.Neon)
		k.glow(l, PU)
	end
	for i, a in ipairs({ -0.5, 0, 0.5 }) do
		k.tri(tip, "Claw", 0.1, 0.8 - math.abs(a) * 0.3, 0.25, (i == 2) and W or PU, c(0, 0, 0.25) * ANG(PI / 2 - 0.4, 0, a) * c(0, 0.35, 0))
	end

	local r1, rp1 = k.pv(body, "OrbitFlat", c(0, 0.05, 0) * ANG(0.15, 0, 0))
	H.group(rig, "rings", r1)
	k.ring(rp1, "OrbitRing", FLAT, 1.9, 16, 0.3, 0.8, 0.12, W)
	k.ring(rp1, "OrbitInner", FLAT, 1.6, 14, 0.12, 0.72, 0.13, PU, MAT.Neon)
	local r2, rp2 = k.pv(body, "OrbitUp", c(0, 0.2, 0.3))
	H.group(rig, "orbit", r2)
	k.ring(rp2, "OrbitRing", ANG(0, PI / 2, 0), 1.6, 14, 0.25, 0.75, 0.12, W)
	k.ring(rp2, "OrbitInner", ANG(0, PI / 2, 0), 1.35, 12, 0.1, 0.7, 0.13, PU, MAT.Neon)
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">SpeciesModelsVolcano</string><ProtectedString name="Source"><![CDATA[-- SpeciesModelsVolcano: hand-authored, reference-faithful models for the Volcano world
-- (Emberpup, Magmite, Cinderchick, Obsidian Golem, Phoenix Lumen, Magma Kraken, Infernadrake, Solar Serpent).
-- Location: ReplicatedStorage > Shared > SpeciesModelsVolcano (ModuleScript), merged into SpeciesModels.
-- Built from the owner's character sheets (hero / front / side + idle, anticipate, power move, recover).

local K = require(script.Parent.ModelKit)
local V3, CF, ANG, PI, MAT, C = K.V3, K.CF, K.ANG, K.PI, K.MAT, K.C
local FACE, DOWN = ANG(0, PI / 2, 0), ANG(0, 0, PI) -- triangle plate facing front / pointing down
local SIDES = { -1, 1 }

local M = {}

---------------------------------------------------------------- EMBERPUP (Common)
-- Chunky orange fox-pup: deep chest with cream bib, four thick legs with cream three-toed paws,
-- boxy head with cream muzzle, dark nose, heavy brows over glowing yellow slit eyes, tall pointed ears
-- with yellow insides, three-segment tail curling up to a glowing ember tip.
function M.Emberpup(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local O, OD, CR, CRD = C("#F27A2E"), C("#D9621F"), C("#F7D8AE"), C("#E6C092")
	local Y, N, EY = C("#FFC62E"), C("#3B2418"), C("#FFE14A")
	local BY = 1.75
	local body = k.body(1.6, 1.3, 2.3, O, BY)
	k.b(body, "Chest", 1.7, 1.45, 0.95, O, c(0, 0.08, -1.0))
	k.b(body, "Bib", 0.9, 0.75, 0.1, CR, c(0, 0.15, -1.5))
	k.tri(body, "BibTip", 0.1, 0.55, 0.9, CR, c(0, -0.5, -1.5) * DOWN * FACE)
	k.b(body, "Belly", 1.1, 0.2, 1.7, CR, c(0, -0.62, 0.1))
	k.b(body, "BackRidge", 1.1, 0.16, 1.6, OD, c(0, 0.68, 0.3))
	for _, sd in ipairs(SIDES) do
		k.b(body, "Shoulder", 0.3, 0.95, 0.95, OD, c(sd * 0.82, 0.05, -0.85))
		k.b(body, "Haunch", 0.3, 0.9, 0.95, OD, c(sd * 0.82, 0.05, 0.8))
	end

	local legF = { up = { 0.75, 0.6, 0.85 }, w2 = 0.6, d2 = 0.7, paw = { 0.85, 0.32, 1.0 }, col = O, pawCol = CR, toes = 3, toeCol = CRD }
	local legH = { up = { 0.82, 0.7, 1.0 }, w2 = 0.62, d2 = 0.72, paw = { 0.85, 0.32, 1.0 }, col = O, pawCol = CR, toes = 3, toeCol = CRD, hind = true }
	k.leg(body, "LegFL", BY, -0.55, -0.45, -0.9, legF)
	k.leg(body, "LegFR", BY, 0.55, -0.45, -0.9, legF)
	k.leg(body, "LegBL", BY, -0.55, -0.45, 0.85, legH)
	k.leg(body, "LegBR", BY, 0.55, -0.45, 0.85, legH)
	rig.legKind = "quad"

	local head = k.head(body, 1.45, 1.15, 1.25, O, c(0, 1.2, -1.5), V3(0, -0.45, 0.4))
	local fz = -0.625
	k.b(head, "Crown", 1.2, 0.22, 0.8, OD, c(0, 0.62, 0.15))
	k.b(head, "Muzzle", 0.8, 0.5, 0.6, CR, c(0, -0.3, fz - 0.25))
	k.b(head, "Jowl", 1.25, 0.32, 0.5, CR, c(0, -0.45, fz + 0.1))
	for _, sd in ipairs(SIDES) do k.w(head, "CheekTuft", 0.35, 0.45, 0.5, O, c(sd * 0.82, -0.2, -0.05) * ANG(0, -sd * PI / 2, 0)) end
	k.w(head, "Bridge", 0.7, 0.25, 0.45, O, c(0, 0.07, fz - 0.22))
	k.b(head, "Nose", 0.34, 0.2, 0.16, N, c(0, -0.12, fz - 0.58))
	k.b(head, "Mouth", 0.5, 0.05, 0.05, N, c(0, -0.47, fz - 0.56))
	for _, sd in ipairs(SIDES) do
		k.b(head, "Brow", 0.62, 0.2, 0.32, OD, c(sd * 0.36, 0.25, fz - 0.05) * ANG(0, 0, sd * 0.28))
		k.eye(head, sd * 0.36, 0.06, fz - 0.03, 0.36, 0.14, EY, sd * 0.28)
		local ear = k.ear(head, sd, c(sd * 0.45, 0.5, 0.1) * ANG(0, 0, -sd * 0.15))
		k.tri(ear, "Ear", 0.24, 1.0, 0.72, O, c(0, 0.5, 0) * FACE)
		k.tri(ear, "EarInner", 0.08, 0.66, 0.42, Y, c(0, 0.4, -0.13) * FACE)
	end

	local tip = k.tail(body, c(0, 0.45, 1.1), {
		{ 0.5, 0.5, 0.6, -0.7, O }, { 0.46, 0.46, 0.55, -0.35, O }, { 0.42, 0.42, 0.5, -0.25, OD } })
	local _, flame = k.b(tip, "TailEmber", 0.55, 0.45, 0.8, Y, c(0, 0.05, 0.6) * ANG(-0.3, 0, 0), MAT.Neon)
	k.glow(flame, Y)
end

---------------------------------------------------------------- MAGMITE (Uncommon)
-- Lava turtle: dark rock body over a glowing yellow core, two orange shell halves split by a glowing
-- seam (they lift apart on the power move), a rock knob with a yellow zigzag on top, low brown head
-- under an orange visor helmet with cheek guards, four stubby splayed legs with orange feet.
function M.Magmite(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local O, OD, BR, BRD = C("#F2661E"), C("#D4521A"), C("#5A2A18"), C("#44200F")
	local Y, EY = C("#FFBC1E"), C("#FFD84A")
	local BY = 1.15
	local body = k.body(2.0, 1.0, 2.2, BR, BY)
	local _, core = k.b(body, "Core", 2.1, 0.55, 1.9, Y, c(0, 0.05, 0), MAT.Neon)
	k.glow(core, Y)
	local _, seam = k.b(body, "Seam", 0.34, 0.5, 2.25, Y, c(0, 0.72, 0.05), MAT.Neon)
	k.glow(seam, Y)
	for _, sd in ipairs(SIDES) do
		local half = k.opener(body, "ShellHinge", c(sd * 0.2, 0.5, 0), V3(0, 0, 1), sd * 0.35)
		k.b(half, "Shell", 0.9, 0.62, 2.4, O, c(sd * 0.42, 0.25, 0.05))
		k.w(half, "ShellEdge", 2.4, 0.55, 0.5, OD, c(sd * 1.12, 0.05, 0.05) * ANG(0, -sd * PI / 2, 0))
		k.w(half, "ShellFront", 0.9, 0.45, 0.45, O, c(sd * 0.42, 0.25, -1.45))
		k.b(half, "ShellBack", 0.9, 0.5, 0.4, OD, c(sd * 0.42, 0.15, 1.38))
	end
	local _, knob = k.b(body, "Rock", 1.0, 0.6, 0.85, BR, c(0, 1.25, 0.3))
	k.b(knob, "RockTop", 0.8, 0.2, 0.7, BRD, c(0, 0.38, 0.05))
	for i, x in ipairs({ -0.33, -0.11, 0.11, 0.33 }) do
		local _, z = k.b(knob, "Zigzag", 0.3, 0.08, 0.05, Y, c(x, 0.02, -0.44) * ANG(0, 0, (i % 2 == 1) and 0.75 or -0.75), MAT.Neon)
		k.glow(z, Y)
	end

	local head = k.head(body, 1.2, 0.7, 0.8, BR, c(0, -0.05, -1.35), V3(0, -0.2, 0.35))
	k.b(head, "Helmet", 1.45, 0.3, 1.0, O, c(0, 0.45, -0.05))
	k.w(head, "Visor", 1.4, 0.24, 0.3, O, c(0, 0.42, -0.68))
	for _, sd in ipairs(SIDES) do
		k.b(head, "Guard", 0.22, 0.85, 0.85, O, c(sd * 0.72, 0.05, -0.1) * ANG(0, 0, sd * 0.12))
		k.eye(head, sd * 0.28, -0.02, -0.42, 0.3, 0.16, EY, 0)
	end

	local lg = { up = { 0.8, 0.45, 0.85 }, w2 = 0.72, d2 = 0.78, paw = { 1.0, 0.32, 1.0 }, col = BR, col2 = BRD, pawCol = O, splay = 0.45 }
	k.leg(body, "LegFL", BY, -0.85, -0.25, -0.75, lg)
	k.leg(body, "LegFR", BY, 0.85, -0.25, -0.75, lg)
	lg.hind = true
	k.leg(body, "LegBL", BY, -0.85, -0.25, 0.75, lg)
	k.leg(body, "LegBR", BY, 0.85, -0.25, 0.75, lg)
	rig.legKind = "quad"
end

---------------------------------------------------------------- CINDERCHICK (Rare)
-- Amber chick-bird on two legs: cream breast, short neck, boxy head with cream beak and red-orange
-- glowing eyes, five-spike flame crest, folded wings with a red bar and cream flight feathers,
-- flame-feather tail fan, cream three-toed feet.
function M.Cinderchick(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local A, AD, CR = C("#F5A623"), C("#E08A12"), C("#F8DFA8")
	local R, Y, EY = C("#F0521E"), C("#FFB52E"), C("#FF5A1A")
	local BY = 2.05
	local body = k.body(1.35, 1.45, 1.5, A, BY)
	k.b(body, "Breast", 0.95, 1.1, 0.14, CR, c(0, -0.05, -0.78))
	k.b(body, "Belly", 1.0, 0.25, 1.1, CR, c(0, -0.75, 0))
	local lg = { up = { 0.5, 0.5, 0.55 }, col = A, w2 = 0.3, d2 = 0.32, col2 = AD, paw = { 0.75, 0.2, 0.8, -0.12 }, pawCol = CR, toes = 3, toeCol = CR }
	k.leg(body, "LegL", BY, -0.38, -0.7, 0.1, lg)
	k.leg(body, "LegR", BY, 0.38, -0.7, 0.1, lg)
	rig.legKind = "biped"

	k.b(body, "Neck", 0.62, 0.8, 0.55, A, c(0, 0.95, -0.3))
	k.b(body, "NeckBand", 0.66, 0.2, 0.59, CR, c(0, 0.75, -0.3))
	local head = k.head(body, 1.0, 0.85, 1.0, A, c(0, 1.65, -0.45), V3(0, -0.4, 0.2))
	k.w(head, "Beak", 0.55, 0.42, 0.6, CR, c(0, -0.1, -0.8))
	k.b(head, "BeakLow", 0.4, 0.15, 0.35, CR, c(0, -0.33, -0.65))
	for _, sd in ipairs(SIDES) do
		k.b(head, "Brow", 0.45, 0.16, 0.2, AD, c(sd * 0.28, 0.24, -0.5) * ANG(0, 0, sd * 0.3))
		k.eye(head, sd * 0.28, 0.08, -0.52, 0.26, 0.16, EY, sd * 0.3)
	end
	for _, d in ipairs({ { 0, 1.0, R }, { -0.22, 0.8, Y }, { 0.22, 0.8, Y }, { -0.4, 0.6, R }, { 0.4, 0.6, R } }) do
		k.tri(head, "Crest", 0.14, d[2], 0.45, d[3], c(d[1], 0.4 + d[2] * 0.4, 0.05 + math.abs(d[1]) * 0.3) * ANG(0.5, 0, -d[1] * 0.8))
	end

	for _, sd in ipairs(SIDES) do
		-- folded wing held slightly out: amber covert with a red bar, a fan of long cream flight feathers below
		local w = k.wing(body, sd, c(sd * 0.68, 0.4, 0.0) * ANG(0, -sd * 0.5, 0))
		local _, wp = k.pv(w, "WingPlate", ANG(0, 0, -sd * 0.45))
		k.b(wp, "WingCovert", 1.1, 0.7, 0.28, A, c(sd * 0.5, -0.1, 0))
		k.b(wp, "WingBar", 1.0, 0.18, 0.3, R, c(sd * 0.55, 0.15, -0.02))
		k.featherWing(wp, sd, { root = 0.35, z = 0.05, thick = 0.12, feathers = {
			{ -0.5, 1.2, 0.34, CR }, { -0.8, 1.3, 0.34, CR }, { -1.1, 1.25, 0.32, CR }, { -1.4, 1.05, 0.3, CR } } })
	end

	local te, tp = k.pv(body, "TailFan", c(0, 0.15, 0.72) * ANG(0.75, 0, 0))
	table.insert(rig.tail, te)
	for i, a in ipairs({ -0.85, -0.45, 0, 0.45, 0.85 }) do
		local L = 1.35 - math.abs(a) * 0.35
		local col = (i == 3) and Y or ((i % 2 == 0) and A or R)
		k.tri(tp, "TailFlame", 0.12, L, 0.5, col, c(math.sin(a) * L * 0.5, math.cos(a) * L * 0.5, 0) * ANG(0, 0, -a) * FACE)
		k.tri(tp, "TailFlameCore", 0.13, L * 0.55, 0.28, Y, c(math.sin(a) * L * 0.32, math.cos(a) * L * 0.32, -0.02) * ANG(0, 0, -a) * FACE)
	end
end

---------------------------------------------------------------- OBSIDIAN GOLEM (Epic)
-- Hulking obsidian brute: broad torso with V chest plates and glowing lava cracks, small crested
-- helmet head with orange slit eyes, huge shoulder pads crowned by amber crystal spikes, orange arm
-- and fist bands, giant fists, column legs with orange stripes on the feet.
function M.Obsidigolem(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local D, DD, DL = C("#3A2A3E"), C("#2A1E2E"), C("#4A3850")
	local O, Y, LAVA = C("#F08A2A"), C("#FFB43A"), C("#FF8A1E")
	local function crack(parent, pts, z)
		for i = 1, #pts - 1 do
			local _, p = k.bar(parent, "Crack", V3(pts[i][1], pts[i][2], z), V3(pts[i + 1][1], pts[i + 1][2], z), 0.09, LAVA, MAT.Neon, nil, nil, 0.05)
			k.glow(p, LAVA)
		end
	end
	local BY = 3.3
	local body = k.body(2.3, 1.9, 1.6, D, BY)
	for _, sd in ipairs(SIDES) do
		k.b(body, "Pec", 1.2, 0.9, 0.3, DL, c(sd * 0.52, 0.3, -0.85) * ANG(0, 0, -sd * 0.22))
		k.spike(body, "BackSpike", 0.9, 0.5, Y, c(sd * 0.7, 0.95, 0.4) * ANG(0.3, 0, -sd * 0.3))
	end
	crack(body, { { -0.85, 0.55 }, { -0.45, 0.1 }, { 0, -0.3 }, { 0.45, 0.1 }, { 0.85, 0.55 } }, -1.02)
	crack(body, { { -0.95, -0.05 }, { -0.75, -0.4 }, { -0.9, -0.7 } }, -0.82)
	crack(body, { { 0.7, -0.35 }, { 0.9, -0.65 } }, -0.82)
	k.b(body, "Waist", 1.6, 0.6, 1.2, DD, c(0, -1.2, 0))
	k.b(body, "Hips", 1.9, 0.55, 1.3, D, c(0, -1.5, 0))

	local lg = { up = { 1.0, 0.6, 1.0 }, w2 = 0.9, d2 = 0.95, col = D, col2 = DD, paw = { 1.3, 0.5, 1.55, -0.12 }, pawCol = D }
	for _, sd in ipairs(SIDES) do
		local _, _, knee, lh = k.leg(body, sd < 0 and "LegL" or "LegR", BY, sd * 0.6, -1.6, 0, lg)
		for t = -1, 1 do
			k.b(knee, "FootStripe", 0.18, 0.42, 0.06, O, c(t * 0.35, -lh - 0.25, -0.9))
		end
	end
	rig.legKind = "biped"

	for _, sd in ipairs(SIDES) do
		local arm = k.arm(body, sd, c(sd * 1.45, 0.6, 0))
		k.b(arm, "Shoulder", 1.25, 0.75, 1.25, DL, c(sd * 0.2, 0.25, 0))
		for _, d in ipairs({ { 0.0, 0.85 }, { 0.32, 0.65 }, { -0.32, 0.65 } }) do
			k.spike(arm, "ShoulderSpike", d[2] + 0.3, 0.5, Y, c(sd * (0.25 + math.abs(d[1]) * 0.3), 0.55, d[1]) * ANG(0, 0, -sd * 0.35))
		end
		k.b(arm, "UpperArm", 0.85, 0.9, 0.85, D, c(sd * 0.25, -0.5, 0))
		k.b(arm, "ArmBand", 0.95, 0.22, 0.95, O, c(sd * 0.25, -1.0, 0))
		k.b(arm, "Forearm", 1.2, 0.9, 1.2, DL, c(sd * 0.3, -1.5, -0.05))
		local _, fist = k.b(arm, "Fist", 1.4, 1.1, 1.35, D, c(sd * 0.3, -2.4, -0.1))
		for f = 1, 3 do k.b(fist, "Knuckle", 0.38, 0.34, 0.2, DD, c((f - 2) * 0.42, 0.25, -0.72)) end
		k.b(fist, "FistBand", 1.45, 0.2, 1.4, O, c(0, 0.5, 0))
		crack(arm, { { sd * 0.05, -1.3 }, { sd * 0.3, -1.6 }, { sd * 0.12, -1.85 } }, -0.67)
	end

	local head = k.head(body, 1.0, 0.9, 1.0, D, c(0, 1.35, -0.2), V3(0, -0.45, 0.1))
	k.b(head, "Brow", 1.05, 0.25, 0.35, DL, c(0, 0.15, -0.4))
	k.b(head, "Visor", 0.8, 0.22, 0.08, DD, c(0, -0.02, -0.52))
	k.b(head, "Jaw", 0.8, 0.25, 0.6, DD, c(0, -0.45, -0.15))
	for _, sd in ipairs(SIDES) do k.eye(head, sd * 0.2, -0.02, -0.56, 0.26, 0.1, LAVA, sd * 0.2) end
	k.tri(head, "Crest", 0.35, 0.6, 1.0, DL, c(0, 0.75, 0))
	k.tri(head, "CrestGlow", 0.37, 0.35, 0.5, O, c(0, 0.7, -0.12))
end

---------------------------------------------------------------- PHOENIX LUMEN (Legendary)
-- Upright armoured phoenix: orange body with a yellow breastplate and crimson chest gem, slim neck,
-- hooked yellow beak, yellow/crimson crest, two huge raised wings (orange primaries with yellow tips
-- over crimson coverts), yellow talons, three long crimson tail streamers ending in yellow spearheads.
function M.PhoenixLumen(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local O, OD, Y = C("#F26A1E"), C("#D9541A"), C("#FFC52E")
	local R, RD, EY = C("#E8285A"), C("#C21E4A"), C("#FFE45C")
	local BY = 2.85
	local body = k.body(1.1, 1.5, 1.15, O, BY)
	k.b(body, "Breast", 0.9, 0.9, 0.14, Y, c(0, 0.15, -0.6))
	k.diamond(body, "ChestGem", 0.75, 0.5, 0.12, R, c(0, 0.15, -0.69), MAT.Glass)
	k.b(body, "Belly", 0.85, 0.5, 0.9, OD, c(0, -0.65, 0.05))
	local lg = { up = { 0.55, 0.6, 0.65 }, col = O, w2 = 0.3, d2 = 0.32, col2 = Y, paw = { 0.75, 0.22, 0.8, -0.12 }, pawCol = Y, toes = 3, toeCol = Y, band = R }
	k.leg(body, "LegL", BY, -0.33, -0.7, 0.05, lg)
	k.leg(body, "LegR", BY, 0.33, -0.7, 0.05, lg)
	rig.legKind = "biped"

	k.b(body, "Neck", 0.5, 0.75, 0.5, O, c(0, 0.95, -0.25) * ANG(-0.25, 0, 0))
	k.b(body, "NeckRuff", 0.62, 0.3, 0.6, Y, c(0, 0.7, -0.3))
	local head = k.head(body, 0.72, 0.68, 0.85, O, c(0, 1.55, -0.45), V3(0, -0.3, 0.2))
	k.w(head, "Beak", 0.36, 0.3, 0.5, Y, c(0, -0.08, -0.65))
	k.b(head, "BeakTip", 0.22, 0.25, 0.14, Y, c(0, -0.22, -0.86))
	for _, sd in ipairs(SIDES) do
		k.b(head, "Brow", 0.3, 0.1, 0.15, R, c(sd * 0.22, 0.2, -0.42) * ANG(0, 0, sd * 0.35))
		k.eye(head, sd * 0.22, 0.08, -0.43, 0.2, 0.1, EY, sd * 0.35)
		k.tri(head, "CheekSpike", 0.1, 0.45, 0.3, Y, c(sd * 0.38, -0.05, 0.1) * ANG(0.9, 0, -sd * 0.6))
	end
	for _, d in ipairs({ { 0, 0.9, Y }, { -0.18, 0.7, R }, { 0.18, 0.7, R }, { -0.3, 0.5, Y }, { 0.3, 0.5, Y } }) do
		k.tri(head, "Crest", 0.12, d[2], 0.4, d[3], c(d[1], 0.3 + d[2] * 0.4, 0.15) * ANG(0.6, 0, -d[1] * 1.2))
	end

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.5, 0.5, 0.2))
		k.featherWing(w, sd, { root = 0.15, z = 0.05, thick = 0.12, feathers = {
			{ 1.25, 2.5, 0.42, O, Y }, { 1.0, 2.9, 0.45, O, Y }, { 0.75, 3.1, 0.45, OD, Y }, { 0.5, 2.9, 0.45, O, Y },
			{ 0.25, 2.5, 0.42, O, Y }, { 0.0, 2.0, 0.4, OD, Y } } })
		k.featherWing(w, sd, { root = 0.1, z = -0.05, thick = 0.13, feathers = {
			{ 1.05, 1.6, 0.36, R, R }, { 0.75, 1.7, 0.36, R, RD }, { 0.45, 1.5, 0.34, R, R }, { 0.15, 1.2, 0.32, R, RD } } })
		k.bar(w, "WingEdge", V3(0, 0.1, -0.2), V3(sd * 0.9, 1.7, -0.2), 0.3, Y)
	end

	local tipRot = ANG(0, PI / 2, 0) * ANG(0, 0, PI / 2) -- flat triangle, apex along +Z
	local backRot = ANG(0, -PI / 2, 0) * ANG(0, 0, PI / 2) -- flat triangle, apex along -Z
	for i, x in ipairs({ -0.3, 0, 0.3 }) do
		local segs = {}
		for j = 1, 7 do
			table.insert(segs, { 0.3 - j * 0.015, 0.24, 0.55, (j % 2 == 0) and R or RD, j == 1 and 1.1 or -0.15, j == 1 and x * 0.5 or 0 })
		end
		local rec = k.chain(body, c(x, -0.5, 0.45), segs, { name = "Streamer", kind = "trail", i = i, amp = 0.12, freq = 1.6, lag = 0.5 })
		local last = rec.parts[#rec.parts]
		k.tri(last, "SpearTip", 0.08, 0.75, 0.55, Y, c(0, 0, 0.62) * tipRot)
		k.tri(last, "SpearBack", 0.08, 0.3, 0.55, Y, c(0, 0, 0.12) * backRot)
		k.tri(last, "SpearCore", 0.1, 0.45, 0.25, R, c(0, 0.01, 0.5) * tipRot)
	end
end

---------------------------------------------------------------- MAGMA KRAKEN (Legendary)
-- Dark maroon mantle with glowing yellow eyes, a crown of eight orange/red petal plates (yellow
-- stripes, a gem on the front plate) around a glowing lava core that flare open on the power move,
-- eight segmented tentacles banded red/orange/maroon with yellow suckers and yellow tips.
function M.MagmaKraken(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local R, O, BR, BRD = C("#E8401E"), C("#F2662A"), C("#5A1E14"), C("#401510")
	local Y, CORE, EY = C("#FFC233"), C("#FFB01E"), C("#FFD84A")
	local BY = 1.55
	local body = k.body(2.0, 1.3, 2.0, BR, BY)
	rig.legKind = "none"
	k.b(body, "Brow", 2.05, 0.3, 0.4, BRD, c(0, 0.15, -0.85))
	for _, sd in ipairs(SIDES) do k.eye(body, sd * 0.42, -0.12, -1.02, 0.36, 0.18, EY, -sd * 0.2) end
	local _, core = k.b(body, "Core", 1.15, 0.5, 1.15, CORE, c(0, 0.75, 0), MAT.Neon)
	k.glow(core, CORE)
	k.b(body, "CoreRim", 1.5, 0.3, 1.5, BRD, c(0, 0.6, 0))

	for i = 0, 7 do
		local a = i / 8 * PI * 2
		local d = V3(math.sin(a), 0, -math.cos(a))
		local pos = V3(0, 0.45, 0) + d * 0.85
		local front = i == 0
		local pet = k.opener(body, "Petal", CFrame.lookAt(pos * s, (pos + d) * s), V3(1, 0, 0), -0.35)
		local h = front and 2.1 or 1.85
		local _, plate = k.b(pet, "PetalPlate", front and 1.25 or 1.15, h, 0.26, (i % 2 == 0) and O or R, ANG(-0.75, 0, 0) * c(0, h * 0.45, 0))
		k.b(plate, "PetalStripe", 0.18, h * 0.75, 0.26, Y, c(-0.25, 0, 0))
		if front then k.diamond(plate, "PetalGem", 1.0, 0.55, 0.1, Y, c(0, -0.05, -0.14)) end
	end

	for i = 0, 7 do
		local a = (i + 0.5) / 8 * PI * 2
		local d = V3(math.sin(a), 0, -math.cos(a))
		local pos = V3(0, -0.5, 0) + d * 0.7
		local segs = {}
		for j = 1, 6 do
			local w = 0.55 - j * 0.045
			local col = (j % 3 == 1) and R or ((j % 3 == 2) and O or BR)
			table.insert(segs, { w, w * 0.85, 0.5, col, j == 1 and 0.65 or -0.18 })
		end
		local rec = k.chain(body, CFrame.lookAt(pos * s, (pos - d) * s), segs, { name = "Tentacle", kind = "tentacle", i = i + 1, amp = 0.18, freq = 1.4, lag = 0.55 })
		for j, p in ipairs(rec.parts) do
			if j == 2 or j == 4 then
				local w = 0.55 - j * 0.045
				local _, cup = k.b(p, "Sucker", 0.26, 0.08, 0.26, Y, c(0, w * 0.43 + 0.03, 0))
				k.b(cup, "SuckerHole", 0.12, 0.09, 0.12, BRD, c(0, 0.01, 0))
			end
		end
		k.w(rec.parts[#rec.parts], "TentacleTip", 0.3, 0.26, 0.55, Y, c(0, 0, 0.5) * ANG(0, PI, 0))
	end
end

---------------------------------------------------------------- INFERNADRAKE (Mythical)
-- Red armoured dragon on four legs: maroon chest with an orange belly-plate ladder and glowing seams,
-- yellow back spikes, two-block neck, horned head with a hinged jaw and yellow teeth, huge bat wings
-- (red bones, orange membranes), long spiked tail ending in a glowing flame fan.
function M.Infernadrake(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local RD, RK, MR = C("#B3221C"), C("#7E1814"), C("#4A1A1C")
	local O, OL, Y, LAVA = C("#F2962E"), C("#FFB54A"), C("#FFC233"), C("#FFB01E")
	local BY = 2.35
	local body = k.body(1.9, 1.6, 2.5, RD, BY)
	k.b(body, "Chest", 1.7, 1.5, 0.9, MR, c(0, 0.05, -1.15))
	for i = 0, 3 do
		k.b(body, "BellyPlate", 1.0 - i * 0.08, 0.32, 0.16, (i % 2 == 0) and O or OL, c(0, 0.35 - i * 0.38, -1.62 + i * 0.12) * ANG(-0.2, 0, 0))
	end
	for _, sd in ipairs(SIDES) do
		local _, seam = k.bar(body, "Seam", V3(sd * 0.72, 0.6, -1.62), V3(sd * 0.4, -0.5, -1.62), 0.09, LAVA, MAT.Neon, nil, nil, 0.05)
		k.glow(seam, LAVA)
	end
	for i = 0, 4 do
		k.tri(body, "BackSpike", 0.16, 0.7 - i * 0.08, 0.6, Y, c(0, 1.05, -0.9 + i * 0.5) * ANG(0.45, 0, 0))
	end

	local lf = { up = { 0.85, 0.75, 0.95 }, col = RD, w2 = 0.72, d2 = 0.8, col2 = MR, paw = { 1.05, 0.38, 1.2, -0.1 }, pawCol = RD, toes = 3, toeCol = Y, band = LAVA }
	local lh = { up = { 1.0, 0.85, 1.15 }, col = RD, w2 = 0.78, d2 = 0.85, col2 = MR, paw = { 1.1, 0.4, 1.25, -0.1 }, pawCol = RD, toes = 3, toeCol = Y, band = LAVA, hind = true }
	k.leg(body, "LegFL", BY, -0.8, -0.55, -0.85, lf)
	k.leg(body, "LegFR", BY, 0.8, -0.55, -0.85, lf)
	k.leg(body, "LegBL", BY, -0.85, -0.5, 0.9, lh)
	k.leg(body, "LegBR", BY, 0.85, -0.5, 0.9, lh)
	rig.legKind = "quad"

	k.b(body, "Neck1", 1.0, 1.0, 0.9, RD, c(0, 0.75, -1.45) * ANG(-0.5, 0, 0))
	k.b(body, "Neck2", 0.9, 0.9, 0.85, RK, c(0, 1.35, -1.75) * ANG(-0.3, 0, 0))
	k.b(body, "Throat", 0.6, 1.2, 0.3, O, c(0, 1.0, -2.0) * ANG(-0.4, 0, 0))
	local head = k.head(body, 1.15, 0.9, 1.3, RD, c(0, 2.05, -2.15), V3(0, -0.35, 0.4))
	k.b(head, "Snout", 0.85, 0.5, 0.75, RD, c(0, -0.15, -0.95))
	k.b(head, "Brow", 1.2, 0.25, 0.5, RK, c(0, 0.35, -0.45))
	local jaw = k.jb(head, "Jaw", 0.8, 0.25, 1.1, MR, c(0, -0.5, -0.65), V3(0, 0, 0.5))
	H.group(rig, "jaws", jaw)
	for _, sd in ipairs(SIDES) do
		k.eye(head, sd * 0.34, 0.12, -0.66, 0.3, 0.11, Y, sd * 0.3)
		k.spike(head, "Horn", 1.3, 0.38, Y, c(sd * 0.42, 0.4, 0.3) * ANG(1.0, 0, -sd * 0.35))
		k.spike(head, "HornSmall", 0.7, 0.26, Y, c(sd * 0.55, 0.0, 0.45) * ANG(1.3, 0, -sd * 0.8))
		k.b(head, "Tooth", 0.12, 0.18, 0.12, Y, c(sd * 0.3, -0.45, -1.25))
	end

	for _, sd in ipairs(SIDES) do
		local w = k.wing(body, sd, c(sd * 0.8, 0.65, -0.35))
		k.batWing(w, sd, { wrist = Vector2.new(1.5, 2.3), bone = RD, mem = O, boneW = 0.32, cap = RK,
			tips = { Vector2.new(4.0, 1.1), Vector2.new(3.4, -0.4), Vector2.new(2.3, -1.0), Vector2.new(1.1, -0.9) } })
		k.spike(w, "WingClaw", 0.5, 0.22, Y, c(sd * 1.5, 2.3, 0) * ANG(0, 0, -sd * 0.3))
	end

	local segs = {}
	for j = 1, 8 do
		local w = 0.85 - j * 0.07
		table.insert(segs, { w, w * 0.85, 0.6, (j % 2 == 0) and MR or RD, j == 1 and 0.35 or -0.08 })
	end
	local rec = k.chain(body, c(0, 0.1, 1.2), segs, { name = "Tail", kind = "spine", i = 1, amp = 0.16, freq = 1.4, lag = 0.55 })
	for j, p in ipairs(rec.parts) do
		local w = 0.85 - j * 0.07
		k.tri(p, "TailSpike", 0.12, 0.45 - j * 0.02, 0.4, Y, c(0, w * 0.42 + 0.18, 0) * ANG(0.4, 0, 0))
	end
	local last = rec.parts[#rec.parts]
	for i, a in ipairs({ -0.7, -0.25, 0.25, 0.7 }) do
		k.spike(last, "TailFlame", 1.0 - math.abs(a) * 0.4, 0.4, (i == 2 or i == 3) and Y or O, c(0, 0, 0.3) * ANG(PI / 2 - 0.5, 0, a), MAT.Neon)
	end
end

---------------------------------------------------------------- SOLAR SERPENT (Mythical)
-- Upright white serpent resting on its coils: yellow/orange side bands, gems along the body, a chest
-- gem, feathered wings (white/yellow/orange blades) at the shoulders, horned head with a yellow visor,
-- a sun-ring halo with three gems turning behind the head, flame fin at the tail tip.
function M.SolarSerpent(H, rig, vd, s)
	local k = K.new(H, rig, s)
	local c = k.c
	local W, Y, O = C("#F7F3EA"), C("#FFC52E"), C("#F2822A")
	local GEM, EY = C("#F4FAFF"), C("#FF9A2A")
	local BY = 0.55
	local body = k.body(1.1, 1.0, 1.1, W, BY)
	rig.legKind = "none"
	k.b(body, "BodyBand", 1.16, 0.6, 0.7, Y, c(0, 0.05, 0))
	k.b(body, "BodyBelly", 1.0, 0.18, 1.0, O, c(0, -0.42, 0))

	-- neck rises from the coil; on neck segments +Z runs up the neck and +Y faces the creature's front
	local nseg = { -1.35, -0.15, -0.2, -0.25 }
	local segs = {}
	for j, p in ipairs(nseg) do
		local w = 1.0 - j * 0.06
		table.insert(segs, { w, w, 0.85, W, p })
	end
	local neck = k.chain(body, c(0, 0.3, -0.25), segs, { name = "Neck", kind = "neck", i = 1, amp = 0.06, freq = 0.9 })
	local acc = 0
	for j, p in ipairs(neck.parts) do
		acc += nseg[j]
		local w = 1.0 - j * 0.06
		k.b(p, "Belly", w * 0.75, 0.1, 0.8, W, c(0, w * 0.5, 0))
		k.b(p, "BackPlate", w * 0.85, 0.12, 0.55, Y, c(0, -w * 0.5, 0))
		for _, sd in ipairs(SIDES) do
			k.b(p, "SideBand", 0.1, w * 0.8, 0.5, (j % 2 == 0) and O or Y, c(sd * w * 0.5, 0, 0))
		end
		if j == 2 then k.diamond(p, "ChestGem", 0.7, 0.45, 0.14, GEM, c(0, w * 0.56, 0) * ANG(PI / 2, 0, 0), MAT.Glass) end
	end

	local last = neck.parts[#neck.parts]
	local head = k.head(last, 0.95, 0.75, 1.15, W, c(0, 0, 0.55) * ANG(-acc, 0, 0) * c(0, 0.15, -0.3), V3(0, -0.3, 0.35))
	k.b(head, "Snout", 0.7, 0.4, 0.55, W, c(0, -0.12, -0.75))
	k.b(head, "SnoutBand", 0.74, 0.14, 0.4, O, c(0, 0.0, -0.65))
	k.b(head, "Visor", 0.98, 0.22, 0.6, Y, c(0, 0.3, -0.2))
	for _, sd in ipairs(SIDES) do
		k.b(head, "EyeShade", 0.32, 0.18, 0.06, O, c(sd * 0.27, 0.12, -0.6))
		k.eye(head, sd * 0.27, 0.12, -0.62, 0.24, 0.1, EY, sd * 0.25)
		k.tri(head, "Fin", 0.1, 0.7, 0.8, Y, c(sd * 0.5, 0.25, 0.25) * ANG(0.4, 0, -sd * 0.5))
		k.b(head, "Fang", 0.08, 0.16, 0.08, W, c(sd * 0.2, -0.38, -0.95))
	end
	k.spike(head, "Horn", 1.6, 0.3, Y, c(0, 0.45, -0.3) * ANG(1.2, 0, 0))
	local he, hp = k.pv(head, "HaloPivot", c(0, 0.45, 0.8))
	H.group(rig, "rays", he)
	k.ring(hp, "Halo", CF(), 1.35, 14, 0.2, 0.62, 0.16, Y)
	for _, a in ipairs({ PI / 2, PI / 2 + 2.1, PI / 2 - 2.1 }) do
		k.b(hp, "GemFrame", 0.55, 0.55, 0.12, Y, c(math.cos(a) * 1.35, math.sin(a) * 1.35, 0.02) * ANG(0, 0, PI / 4))
		k.diamond(hp, "HaloGem", 0.7, 0.45, 0.14, GEM, c(math.cos(a) * 1.35, math.sin(a) * 1.35, -0.06), MAT.Glass)
	end

	local p2, acc2 = neck.parts[2], nseg[1] + nseg[2]
	for _, sd in ipairs(SIDES) do
		local w = k.wing(p2, sd, c(sd * 0.45, -0.1, 0) * ANG(-acc2, 0, 0))
		k.b(w, "WingMount", 0.6, 0.6, 0.6, Y, c(sd * 0.2, 0.1, 0))
		k.featherWing(w, sd, { root = 0.2, z = 0.05, feathers = {
			{ 1.1, 2.4, 0.42, W, W }, { 0.8, 2.7, 0.44, Y, Y }, { 0.5, 2.6, 0.44, W, O }, { 0.2, 2.2, 0.42, O, O }, { -0.1, 1.7, 0.4, W, W } } })
	end

	-- compact S on the ground: swings out to one side, back across, and curls again
	local yaws = { 0.9, 0.55, -0.6, -0.9, -0.7, 0.5, 0.9, 0.6 }
	local tsegs = {}
	for j = 1, 8 do
		local w = 1.0 - j * 0.055
		table.insert(tsegs, { w, w * 0.92, 0.62, W, 0, yaws[j] })
	end
	local tail = k.chain(body, c(0, -0.04, 0.4), tsegs, { name = "Coil", kind = "spine", i = 2, amp = 0.08, freq = 1.0, lag = 0.6 })
	for j, p in ipairs(tail.parts) do
		local w = 1.0 - j * 0.055
		k.b(p, "CoilBand", w + 0.06, w * 0.5, 0.32, Y, c(0, 0.05, 0))
		k.b(p, "CoilBelly", w * 0.9, 0.1, 0.7, O, c(0, -w * 0.46, 0))
		if j % 2 == 1 then
			for _, sd in ipairs(SIDES) do
				k.diamond(p, "CoilGem", 0.4, 0.26, 0.08, GEM, c(sd * (w * 0.5 + 0.06), 0.05, 0) * ANG(0, -sd * PI / 2, 0), MAT.Glass)
			end
		end
	end
	local tl = tail.parts[#tail.parts]
	for i, a in ipairs({ -0.6, -0.2, 0.2, 0.6 }) do
		k.spike(tl, "TailFlame", 1.4 - math.abs(a) * 0.6, 0.45, (i == 2 or i == 3) and Y or O, c(0, 0.1, 0.35) * ANG(0.6, 0, a), MAT.Neon)
	end
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">SpeciesProfiles</string><ProtectedString name="Source"><![CDATA[-- SpeciesProfiles: per-species VISUAL + MOTION metadata for all 74 creatures.
-- Location: ReplicatedStorage > Shared > SpeciesProfiles (ModuleScript)
--
-- Identity (id, name, rarity, world, palette, economy) stays in CreatureData and is never
-- changed here. This table only adds presentation:
--   plan     : body plan used by CreatureBuilder (defaults to CreatureData.body)
--   over     : visual overrides applied to a proxy of the definition (e.g. hide generic tail)
--   q        : body-plan parameters (proportions, muzzle, paws, hooves, ...)
--   build    : SpeciesAnatomy builder key (species anatomy + rig channels)
--   gait     : hop | quad | biped | bug6 | fly | float | swim | slither | heavy | hover
--   breath   : { period seconds, scale amplitude }        blink : { min, max } seconds
--   sig      : signature idle  { dur, keys = { {t, pose}, ... }, fx = { {t, kind}, ... } }
--   react    : pet / attention reaction (same keyframe format)
--   enter    : { kind = root-motion style, keys, fx }  (plays inside the rarity entrance window)
--   capture  : { keys, fx }  accent held immediately before the shared rarity capture lift
-- Pose channels (additive, neutral = 0): bob tiltX tiltZ yaw roll spin crouch lean sqY
--   headYaw headPitch headRoll armL armR armIn legFL legFR legBL legBR earL earR
--   wingFold wingL wingR wingFlap tailCurl tailWag mouth jaw lid glow open chainCurl chainWave
--   spread hide
-- Keyframe times are 0..1 of `dur`; poses ease between keys; start and end are neutral unless
-- `hold = true` (capture accents hold their last pose into the lift).

local P = {}

local function C(h) return Color3.fromHex(h) end
local BROWN = C("#6B4A2E")
local HOOF = C("#3A2A22")

---------------------------------------------------------------- FOREST
P.Mossbun = {
	plan = "quad", build = "mossbun", gait = "hop", breath = { 3.4, 0.01 },
	q = { body = Vector3.new(0.9, 0.8, 1.05), leg = 0.6, legW = 1.0, frontLeg = 0.75, paws = 1.35, head = 1.1, muzzle = "snout", tailY = 0.45, pawCol = C("#F4FFE6") },
	sig = { dur = 2.4, keys = { { 0.08, { headPitch = 0.14, mouth = 0.35 } }, { 0.16, { headPitch = 0.02 } }, { 0.24, { headPitch = 0.14, mouth = 0.35 } },
		{ 0.4, { earL = 1.2 } }, { 0.85, { earL = 1.2, lid = 0.55, sqY = -0.03 } } } },
	react = { dur = 1.4, keys = { { 0.15, { tiltX = -0.05 } }, { 0.45, { tiltX = 0.16, lean = 0.2, lid = 0.95, legFR = 0.9 } }, { 0.75, { tiltX = 0.12, lid = 0.9, legFR = 0.7 } } } },
	enter = { kind = "hops", fx = { { 0.92, "leaves2" } } },
	capture = { hold = true, keys = { { 0.5, { earL = 1.1, earR = 1.1 } }, { 1, { earL = 1.3, earR = 1.3, headPitch = -0.3 } } } },
}
P.Acornip = {
	build = "acornip", gait = "quad", breath = { 2.8, 0.02 }, over = { tail = "none" },
	q = { body = Vector3.new(0.85, 0.85, 1.0), leg = 0.65, legW = 0.85, paws = 0.8, head = 1.05, muzzle = "snout", tailY = 0.5 },
	sig = { dur = 2.6, keys = { { 0.2, { headYaw = 0.7, headRoll = 0.15 } }, { 0.45, { headYaw = -0.7, headRoll = -0.15 } }, { 0.62, { headYaw = 0 } },
		{ 0.75, { legFR = 1.2, headPitch = 0.1, open = 1 } }, { 0.9, { legFR = 1.1, open = 1 } } } },
	react = { dur = 1.5, keys = { { 0.2, { headPitch = -0.25, tiltX = -0.1 } }, { 0.5, { headPitch = -0.3, tiltX = -0.12 } }, { 0.75, { headPitch = 0.25, headRoll = 0.2, lid = 0.4 } } } },
	enter = { kind = "walk", keys = { { 0.0, { headPitch = 0.3 } }, { 0.3, { headPitch = 0.1 } }, { 0.85, { spin = 0.6 } } } },
	capture = { hold = true, keys = { { 1, { legFR = 1.3, open = 1, headPitch = 0.1 } } } },
}
P.Petalfly = {
