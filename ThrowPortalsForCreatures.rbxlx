		{ role = "right wing", pos = { 1.561,3.148,-0.240 }, size = { 2.532,2.527,0.791 }, mesh = "rbxassetid://104295439910578", tex = "rbxassetid://122513330771872" },
		{ role = "tail", pos = { -1.925,0.989,1.015 }, size = { 1.164,1.977,1.103 }, mesh = "rbxassetid://92442034232550", tex = "rbxassetid://108770630498155" },
		{ role = "halo", pos = { -0.000,4.852,-0.009 }, size = { 1.157,0.295,1.190 }, mesh = "rbxassetid://87029526997727", tex = "rbxassetid://133675389898302" },
	} },
	Frostpaw = { asset = "generated", parts = {
		{ role = "body", pos = { 0.095,0.900,-0.075 }, size = { 2.067,1.592,2.037 }, mesh = "rbxassetid://82248851327129", tex = "rbxassetid://96737779382321" },
		{ role = "head", pos = { 0.108,2.374,-0.183 }, size = { 2.537,1.943,2.303 }, mesh = "rbxassetid://90621904405989", tex = "rbxassetid://114184914634664" },
		{ role = "left ear", pos = { -0.678,3.023,-0.217 }, size = { 0.820,1.153,0.771 }, mesh = "rbxassetid://89395892917063", tex = "rbxassetid://74746219834653" },
		{ role = "right ear", pos = { 0.866,3.013,-0.217 }, size = { 0.826,1.169,0.738 }, mesh = "rbxassetid://138973211413127", tex = "rbxassetid://78520318299909" },
		{ role = "scarf", pos = { 0.092,1.267,-0.124 }, size = { 2.070,0.956,2.054 }, mesh = "rbxassetid://109250323699631", tex = "rbxassetid://133956524751144" },
		{ role = "front legs", pos = { 0.089,0.751,-0.393 }, size = { 2.350,1.372,0.724 }, mesh = "rbxassetid://140331752123987", tex = "rbxassetid://116941062401324" },
		{ role = "hind legs", pos = { 0.101,0.169,0.238 }, size = { 1.627,0.339,0.707 }, mesh = "rbxassetid://84659469992045", tex = "rbxassetid://120163628713321" },
		{ role = "tail", pos = { -0.765,1.117,0.920 }, size = { 1.224,1.261,0.829 }, mesh = "rbxassetid://93032320817191", tex = "rbxassetid://118557765528588" },
	} },
	Infernadrake = { asset = "generated", parts = {
		{ role = "body", pos = { -0.000,1.841,-1.206 }, size = { 1.741,3.001,2.393 }, mesh = "rbxassetid://78902230265103", tex = "rbxassetid://74281153322412" },
		{ role = "head", pos = { 0.002,3.213,-1.506 }, size = { 1.479,1.282,1.660 }, mesh = "rbxassetid://119276161314047", tex = "rbxassetid://93800515268741" },
		{ role = "horns", pos = { -0.001,3.716,-1.763 }, size = { 1.426,0.691,0.435 }, mesh = "rbxassetid://117969725748548", tex = "rbxassetid://85364424190207" },
		{ role = "left wing", pos = { -1.854,2.912,-0.774 }, size = { 3.291,2.414,1.750 }, mesh = "rbxassetid://97696842359653", tex = "rbxassetid://124985398872430" },
		{ role = "right wing", pos = { 1.866,2.918,-0.771 }, size = { 3.267,2.392,1.757 }, mesh = "rbxassetid://93639783734814", tex = "rbxassetid://129879686304351" },
		{ role = "front legs", pos = { -0.006,1.111,-1.283 }, size = { 3.151,2.202,1.071 }, mesh = "rbxassetid://116676507330646", tex = "rbxassetid://134967483657456" },
		{ role = "hind legs", pos = { 0.009,0.829,-1.083 }, size = { 2.739,1.657,1.365 }, mesh = "rbxassetid://95037015557272", tex = "rbxassetid://84018533451316" },
		{ role = "tail", pos = { -0.865,1.218,0.762 }, size = { 3.152,2.254,3.280 }, mesh = "rbxassetid://79725448287862", tex = "rbxassetid://76140877651493" },
