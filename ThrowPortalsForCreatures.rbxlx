	react = { dur = 2.2, keys = { { 0.2, { tiltX = 0.05 } }, { 0.5, { tiltX = 0.2, armL = 0.6, armR = 0.6, headPitch = 0.3 } }, { 0.8, { tiltX = 0.15, armL = 0.5, armR = 0.5 } } } },
