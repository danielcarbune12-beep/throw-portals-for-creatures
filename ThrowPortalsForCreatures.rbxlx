	c={"#FFFFFF","#FFD86B","#B8F3FF"}, horns="unicorn", tail="aurora", wings="angel", eyes="glow", extra={"halo","crown","rings","crystal"}, mat="Neon", fx="holy",
	desc="The creature that dreamed up all the other creatures." }
add{ id="Infinity", name="Infinity Fox", rarity="Divine", world="Any", body="quad", move="float", idle="spin",
	c={"#1A0F4A","#FF8AE2","#7DF9FF"}, ears="pointy", tail="aurora", eyes="glow", wings="angel", extra={"halo","rings","mane"}, mat="Glass", fx="stars",
	desc="It has nine tails, and each one holds a whole universe." }

---------------------------------------------------------------- index
local CreatureData = { List = L, ById = {}, ByWorld = {} }
for _, c in ipairs(L) do
	c.extra = c.extra or {}
	c.ears = c.ears or "none"; c.horns = c.horns or "none"; c.tail = c.tail or "none"; c.wings = c.wings or "none"
	c.eyes = c.eyes or "big"; c.scale = c.scale or 1
	CreatureData.ById[c.id] = c
	CreatureData.ByWorld[c.world] = CreatureData.ByWorld[c.world] or {}
	table.insert(CreatureData.ByWorld[c.world], c)
end

local Config = require(script.Parent.Config)

-- Income per second for one creature (before training multiplier)
function CreatureData.Income(id: string): number
	local c = CreatureData.ById[id]
	if not c then return 0 end
	local r = Config.Rarities[c.rarity].income
	local w = c.world == "Any" and 1 or Config.Worlds[c.world].incomeMult
	if c.world == "Any" then w = 120 end
	return r * w
end

return CreatureData
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[-- Format: number formatting helpers.
-- Location: ReplicatedStorage > Shared > Format (ModuleScript)
local Format = {}
local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Format.Short(n: number): string
	n = tonumber(n) or 0
	if n < 1000 then
		return tostring(math.floor(n))
	end
	local i = math.min(math.floor(math.log10(n) / 3), #SUFFIX - 1)
	local v = n / 10 ^ (i * 3)
	local s = v >= 100 and string.format("%d", math.floor(v)) or (v >= 10 and string.format("%.1f", math.floor(v * 10) / 10) or string.format("%.2f", math.floor(v * 100) / 100))
	if s:find("%.") then
		s = s:gsub("0+$", ""):gsub("%.$", "")
	end
	return s .. SUFFIX[i + 1]
end

function Format.Money(n: number): string
	return "$" .. Format.Short(n)
end

return Format
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Odds</string><ProtectedString name="Source"><![CDATA[-- Odds: the single source of truth for creature chances ("1 in X").
-- Used by the server to roll and by the client to display odds.
-- Location: ReplicatedStorage > Shared > Odds (ModuleScript)

local Config = require(script.Parent.Config)
local CreatureData = require(script.Parent.CreatureData)
local Format = require(script.Parent.Format)

local Odds = {}

-- Returns { [creatureId] = probability } for a throw with this portal into this zone at this distance.
function Odds.Table(portalId: string, worldId: string, dist: number)
	local portal = Config.Portals[portalId]
	local luck = Config.LuckFromDistance(dist)
	local pool = {}
	for _, c in ipairs(CreatureData.ByWorld[worldId] or {}) do table.insert(pool, c) end
	for _, c in ipairs(CreatureData.ByWorld.Any or {}) do table.insert(pool, c) end

	local byRarity = {}
	for _, c in ipairs(pool) do
		byRarity[c.rarity] = byRarity[c.rarity] or {}
		table.insert(byRarity[c.rarity], c)
	end
	local total, weights = 0, {}
	for rarity, w in pairs(portal.weights) do
		if byRarity[rarity] then
			local order = Config.Rarities[rarity].order
			local weight = w * luck ^ (math.max(0, order - 2) * 0.5)
			weights[rarity] = weight
			total += weight
		end
	end
	local result = {}
	for rarity, weight in pairs(weights) do
		local list = byRarity[rarity]
		for _, c in ipairs(list) do
			result[c.id] = (weight / total) / #list
		end
	end
	return result
end

-- Rolls one creature. Returns creatureId, probability.
function Odds.Roll(portalId: string, worldId: string, dist: number)
	local t = Odds.Table(portalId, worldId, dist)
	local ids = {}
	for id in pairs(t) do table.insert(ids, id) end
	table.sort(ids) -- deterministic order
	local r = math.random()
	local acc, last = 0, ids[1]
	for _, id in ipairs(ids) do
		acc += t[id]
		last = id
		if r <= acc then return id, t[id] end
	end
	return last, t[last]
end

-- Best chance of getting this creature with the given portal (thrown into the creature's zone).
function Odds.ChanceFor(creatureId: string, portalId: string, maxDist: number)
	local def = CreatureData.ById[creatureId]
	if not def then return 0 end
	if def.world == "Any" then
		-- portal-exclusive: best zone you can reach
		local best = 0
		for _, w in ipairs(Config.WorldOrder) do
			local b = Config.ZoneBounds[w]
			if b[1] <= maxDist then
				local d = math.min(maxDist, b[2] - 1)
				best = math.max(best, Odds.Table(portalId, w, d)[creatureId] or 0)
			end
		end
		return best
	end
	local b = Config.ZoneBounds[def.world]
	local d = math.clamp(maxDist, b[1] + 1, b[2] - 1)
	return Odds.Table(portalId, def.world, d)[creatureId] or 0
end

function Odds.OneIn(p: number): string
	if not p or p <= 0 then return "1 in ∞" end
	local n = 1 / p
	if n < 10 then return string.format("1 in %.1f", n) end
	return "1 in " .. Format.Short(math.floor(n + 0.5))
end

return Odds
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">PortalBuilder</string><ProtectedString name="Source"><![CDATA[-- PortalBuilder: builds the throwable portal orb and the opened portal gate.
-- Location: ReplicatedStorage > Shared > PortalBuilder (ModuleScript)

local Config = require(script.Parent.Config)

local PortalBuilder = {}
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)), ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 170, 40)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 240, 70)), ColorSequenceKeypoint.new(0.6, Color3.fromRGB(70, 230, 110)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(70, 150, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 90, 255)) })

local function part(model, name, size, color, mat, meshType, transp)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = mat or Enum.Material.Neon
	p.Transparency = transp or 0
	p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, true
	p.CastShadow = false
	local m = Instance.new("SpecialMesh")
	m.MeshType = meshType or Enum.MeshType.Sphere
	m.Parent = p
	p.Parent = model
	return p, m
end

local function weld(a, b, c0)
	local w = Instance.new("Weld")
	w.Part0, w.Part1, w.C0 = a, b, c0
	w.Parent = b
	return w
end

function PortalBuilder.ColorSeq(portalId)
	local P = Config.Portals[portalId]
	if P.fx == "Rainbow" then return RAINBOW end
	return ColorSequence.new(P.color, P.color2)
end

function PortalBuilder.Emitter(parent, portalId, rate, size, speed)
	local P = Config.Portals[portalId]
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = (P.fx == "Smoke" or P.fx == "Glitch") and SMOKE or (P.fx == "Fire" and FIRE or SPARKLE)
	pe.Color = PortalBuilder.ColorSeq(portalId)
	pe.LightEmission = (P.fx == "Smoke") and 0.3 or 1
	pe.Rate = rate
	pe.Lifetime = NumberRange.new(0.5, 1.2)
	pe.Speed = NumberRange.new(speed * 0.5, speed)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new(0, 1)
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-180, 180)
	pe.Parent = parent
	return pe
end

-- Small glowing orb that gets thrown. Returns model, refs.
function PortalBuilder.BuildOrb(portalId: string, scale: number?)
	local P = Config.Portals[portalId]
	local s = scale or 1
	local model = Instance.new("Model")
	model.Name = "PortalOrb"
	local core = part(model, "Core", Vector3.new(1.6, 1.6, 1.6) * s, P.color2, Enum.Material.Neon)
	core.Anchored = true
	model.PrimaryPart = core
	local shell = part(model, "Shell", Vector3.new(2.2, 2.2, 2.2) * s, P.color, Enum.Material.Glass, nil, 0.35)
	weld(core, shell, CFrame.identity)
	-- two orbiting rings of beads
	local rings = {}
	for r = 1, 2 do
		local hub = part(model, "RingHub", Vector3.new(0.1, 0.1, 0.1), P.color, Enum.Material.Neon, nil, 1)
		local w = weld(core, hub, CFrame.Angles(r == 1 and 0.5 or -0.9, 0, r == 1 and 0.3 or -0.4))
		for i = 1, 10 do
			local a = i / 10 * math.pi * 2
			local b = part(model, "Bead", Vector3.new(0.28, 0.28, 0.28) * s, i % 2 == 0 and P.color or P.color2, Enum.Material.Neon)
			weld(hub, b, CFrame.new(math.cos(a) * 1.6 * s, 0, math.sin(a) * 1.6 * s))
		end
		table.insert(rings, { w = w, base = w.C0, dir = r == 1 and 1 or -1 })
	end
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = P.color, 12, 2
	light.Parent = core
	local a0 = Instance.new("Attachment"); a0.Position = Vector3.new(0, 0.7, 0) * s; a0.Parent = core
	local a1 = Instance.new("Attachment"); a1.Position = Vector3.new(0, -0.7, 0) * s; a1.Parent = core
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1 = a0, a1
	trail.Color = PortalBuilder.ColorSeq(portalId)
	trail.LightEmission = 1
	trail.Lifetime = 0.45
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.FaceCamera = true
	trail.Enabled = false
	trail.Parent = core
	local pe = PortalBuilder.Emitter(core, portalId, 18, 0.6 * s, 2)
	return model, { core = core, rings = rings, trail = trail, emitter = pe, light = light }
end

-- Vertical portal gate (opens on landing; also used in shop previews). Faces -Z.
function PortalBuilder.BuildGate(portalId: string, radius: number?)
	local P = Config.Portals[portalId]
	local R = radius or 4
	local model = Instance.new("Model")
	model.Name = "PortalGate"
	local root = part(model, "Root", Vector3.new(0.2, 0.2, 0.2), P.color, Enum.Material.Neon, nil, 1)
	root.Anchored = true
	model.PrimaryPart = root
	local frameHub = part(model, "FrameHub", Vector3.new(0.1, 0.1, 0.1), P.color, Enum.Material.Neon, nil, 1)
	local frameW = weld(root, frameHub, CFrame.identity)
	local n = 28
	for i = 1, n do
		local a = i / n * math.pi * 2
		local col = P.fx == "Rainbow" and Color3.fromHSV(i / n, 0.75, 1) or (i % 2 == 0 and P.color or P.color:Lerp(P.color2, 0.4))
		local seg = part(model, "Frame", Vector3.new(R * 0.36, R * 0.36, R * 0.42), col, Enum.Material.Neon)
		weld(frameHub, seg, CFrame.new(math.cos(a) * R, math.sin(a) * R, 0) * CFrame.Angles(0, 0, a))
	end
	-- outer glass rim for depth
	for i = 1, 14 do
		local a = i / 14 * math.pi * 2
		local rim = part(model, "Rim", Vector3.new(R * 0.5, R * 0.5, R * 0.3), P.color2, Enum.Material.Glass, nil, 0.4)
		weld(frameHub, rim, CFrame.new(math.cos(a) * R * 1.12, math.sin(a) * R * 1.12, 0.1))
	end
	-- swirling inner discs
	local discs = {}
	for i = 1, 3 do
		local d = part(model, "Swirl", Vector3.new(R * 2 * (1 - i * 0.22), 0.1 + i * 0.02, R * 2 * (1 - i * 0.22)),
			i % 2 == 1 and P.color or P.color2, Enum.Material.Neon, Enum.MeshType.Cylinder, 0.15 + i * 0.12)
		local w = weld(root, d, CFrame.new(0, 0, -0.05 * i) * CFrame.Angles(math.pi / 2, 0, 0))
		table.insert(discs, { w = w, base = w.C0, dir = i % 2 == 1 and 1 or -1, speed = 1 + i * 0.7 })
		-- spiral arms on each disc
		for k = 1, 3 do
			local arm = part(model, "SwirlArm", Vector3.new(R * 0.9 * (1 - i * 0.2), 0.2, R * 0.18), P.color2:Lerp(Color3.new(1, 1, 1), 0.3), Enum.Material.Neon, nil, 0.3)
			weld(d, arm, CFrame.Angles(0, k / 3 * math.pi * 2, 0) * CFrame.new(R * 0.35 * (1 - i * 0.2), 0.12, 0) * CFrame.Angles(0, 0.6, 0))
		end
	end
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = P.color, R * 5, 3
	light.Parent = root
	local pe = PortalBuilder.Emitter(root, portalId, 40, 0.9, 6)
	pe.Shape = Enum.ParticleEmitterShape.Disc
	pe.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	pe.EmissionDirection = Enum.NormalId.Front
	return model, { root = root, frame = { w = frameW, base = frameW.C0 }, discs = discs, emitter = pe, light = light, radius = R }
end

-- Rotates the gate's swirl each frame
function PortalBuilder.Spin(refs, t: number)
	if refs.discs then
		for _, d in ipairs(refs.discs) do
			d.w.C0 = d.base * CFrame.Angles(0, t * d.speed * d.dir * 2, 0)
		end
		refs.frame.w.C0 = refs.frame.base * CFrame.Angles(0, 0, t * 0.6)
	end
	if refs.rings then
		for _, r in ipairs(refs.rings) do
			r.w.C0 = r.base * CFrame.Angles(0, t * 4 * r.dir, 0)
		end
	end
end

return PortalBuilder
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX17"><Properties><string name="Name">ServerScriptService</string></Properties>
<Item class="Folder" referent="RBX12"><Properties><string name="Name">Server</string></Properties>
<Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">BaseBuilder</string><ProtectedString name="Source"><![CDATA[-- BaseBuilder: builds the 8 player bases (with a personal gym each) and their decorations.
-- Location: ServerScriptService > Server > BaseBuilder (ModuleScript)
--
-- Layout of one base (local space, -Z = entrance facing the street):
--   entrance gateway + stone path -> central fountain with a ring of glowing pet slots
--   front-left: money collect pad      front-right: personal GYM
--   back-left:  pet cottage            back-right:  pond
--   string lights between the four corner lamps; pets roam the whole plot

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local BaseBuilder = {}
BaseBuilder.Bases = {}

local HALF = 34
local SLOT_RADIUS = 14
local MAX_SLOTS = 24
local COLLECT_POS = Vector3.new(-19, 0, -21)
local DECOR_SPOTS = {
	Vector3.new(-30, 0, -4), Vector3.new(30, 0, -4), Vector3.new(-30, 0, 9), Vector3.new(30, 0, 9),
	Vector3.new(-7, 0, 29), Vector3.new(7, 0, 29), Vector3.new(0, 0, 22), Vector3.new(0, 22, 4),
}
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

---------------------------------------------------------------- helpers
local function part(parent, size, cf, color, mat, collide, shape, transp)
	local p = Instance.new("Part")
	p.Shape = shape or Enum.PartType.Block
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = collide ~= false
	p.Transparency = transp or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
local function sphereMesh(p) local m = Instance.new("SpecialMesh"); m.MeshType = Enum.MeshType.Sphere; m.Parent = p; return p end
local function ball(parent, d, cf, color, mat, collide) return sphereMesh(part(parent, Vector3.new(d, d, d), cf, color, mat, collide)) end
local function vcylCF(cf, h, d) return cf * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(h, d, d) end
local function cyl(parent, cf, h, d, color, mat, collide, transp)
	local c, s = vcylCF(cf, h, d)
	return part(parent, s, c, color, mat, collide, Enum.PartType.Cylinder, transp)
end
local function light(p, color, range, b) local l = Instance.new("PointLight"); l.Color = color; l.Range = range; l.Brightness = b or 1.4; l.Parent = p; return l end

local function billboard(adornee, text, size, offset, color, maxDist)
	local bb = Instance.new("BillboardGui")
	bb.Size = size or UDim2.fromScale(8, 2)
	bb.StudsOffset = offset or Vector3.new(0, 4, 0)
	bb.MaxDistance = maxDist or 140
	bb.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.Name = "Label"
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.RichText = true
	t.Text = text
	t.TextColor3 = color or Color3.new(1, 1, 1)
	local st = Instance.new("UIStroke"); st.Thickness = 3; st.Color = Color3.fromRGB(30, 20, 40); st.Parent = t
	t.Parent = bb
	bb.Parent = adornee
	return t
end

---------------------------------------------------------------- one base
local function buildBase(index)
	local side = (index <= 4) and -1 or 1
	local row = (index - 1) % 4
	local pos = Vector3.new(side * 63, 0, -84 - row * 76)
	local cf = CFrame.lookAt(pos, Vector3.new(0, 0, pos.Z)) -- -Z faces the street (entrance)
	local L = function(x, y, z) return cf * CFrame.new(x, y, z) end

	local model = Instance.new("Model")
	model.Name = "Base" .. index

	-- foundation + grass floor
	local stone = Color3.fromRGB(210, 205, 198)
	part(model, Vector3.new(HALF * 2 + 3, 1.2, HALF * 2 + 3), L(0, 0.3, 0), stone, Enum.Material.Cobblestone)
	local floor = part(model, Vector3.new(HALF * 2, 1, HALF * 2), L(0, 0.5, 0), Color3.fromRGB(120, 200, 95), Enum.Material.Grass)
	floor.Name = "Floor"
	model.PrimaryPart = floor

	-- flowering hedges (gap at the entrance)
	local hedgeCol = Color3.fromRGB(70, 155, 75)
	local function hedge(hcf, len)
		ball(model, 1, hcf * CFrame.new(0, 3, 0), hedgeCol, Enum.Material.Grass).Size = Vector3.new(len, 5, 4)
		for k = 1, math.floor(len / 4) do
			ball(model, 1, hcf * CFrame.new(-len / 2 + k * 4 - 2, 5.4, (k % 2 == 0) and 1.2 or -1.2), Color3.fromHSV((k * 0.17) % 1, 0.5, 1), nil, false)
		end
	end
	hedge(L(0, 0.5, HALF), HALF * 2)
	hedge(L(-HALF, 0.5, 0) * CFrame.Angles(0, math.rad(90), 0), HALF * 2)
	hedge(L(HALF, 0.5, 0) * CFrame.Angles(0, math.rad(90), 0), HALF * 2)
	for _, s in ipairs({ -1, 1 }) do hedge(L(s * (HALF / 2 + 5), 0.5, -HALF), HALF - 10) end

	-- ENTRANCE GATEWAY: crystal pillars + rainbow arch + name sign
	for _, s in ipairs({ -1, 1 }) do
		part(model, Vector3.new(3.4, 14, 3.4), L(s * 8, 7.5, -HALF), stone, Enum.Material.Marble)
		local crystal = part(model, Vector3.new(2, 4, 2), L(s * 8, 16.5, -HALF) * CFrame.Angles(0, math.rad(45), 0), Color3.fromRGB(170, 120, 255), Enum.Material.Neon, false)
		light(crystal, Color3.fromRGB(180, 140, 255), 24, 2)
	end
	for i = 0, 16 do
		local a = i / 16 * math.pi
		ball(model, 1.8, L(math.cos(a) * 8, 18 + math.sin(a) * 5, -HALF), Color3.fromHSV(i / 16, 0.55, 1), Enum.Material.Neon, false)
	end
	local signBoard = part(model, Vector3.new(14, 3.4, 0.6), L(0, 12.5, -HALF), Color3.fromRGB(255, 248, 230), Enum.Material.SmoothPlastic)
	signBoard.Name = "Sign"
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(480, 110)
	sg.LightInfluence = 0
	local sl = Instance.new("TextLabel")
	sl.Name = "Owner"
	sl.Size = UDim2.fromScale(1, 1)
	sl.BackgroundTransparency = 1
	sl.Font = Enum.Font.FredokaOne
	sl.TextScaled = true
	sl.TextColor3 = Color3.fromRGB(110, 60, 170)
	sl.Text = "Empty Base"
	sl.Parent = sg
	sg.Parent = signBoard
	local sg2 = sg:Clone(); sg2.Face = Enum.NormalId.Back; sg2.Parent = signBoard
	local incomeLabel = billboard(signBoard, "+$0/s", UDim2.fromScale(12, 2.4), Vector3.new(0, 9, 0), Color3.fromRGB(130, 255, 150))

	-- stone path from the entrance to the fountain
	part(model, Vector3.new(6, 0.2, HALF - 6), L(0, 1.05, -HALF / 2 - 3), Color3.fromRGB(205, 195, 180), Enum.Material.Cobblestone, false)
	for z = -HALF + 4, -10, 6 do
		for _, s in ipairs({ -1, 1 }) do
			ball(model, 0.9, L(s * 3.6, 1.4, z), Color3.fromRGB(255, 220, 140), Enum.Material.Neon, false)
		end
	end

	-- CENTRAL FOUNTAIN with a floating income crystal
	cyl(model, L(0, 1, 0), 1.4, 12, stone, Enum.Material.Marble, true)
	cyl(model, L(0, 2.3, 0), 0.2, 10.6, Color3.fromRGB(90, 200, 255), Enum.Material.Glass, false, 0.25)
	cyl(model, L(0, 1, 0), 5, 1.8, stone, Enum.Material.Marble, true)
	local crystal = part(model, Vector3.new(2.6, 4.6, 2.6), L(0, 10, 0) * CFrame.Angles(0, math.rad(45), math.rad(10)), Color3.fromRGB(120, 255, 170), Enum.Material.Neon, false)
	crystal.Name = "IncomeCrystal"
	light(crystal, Color3.fromRGB(120, 255, 170), 26, 2)
	local spray = Instance.new("ParticleEmitter")
	spray.Texture = SPARKLE
	spray.Color = ColorSequence.new(Color3.fromRGB(150, 220, 255))
	spray.Rate = 25; spray.Speed = NumberRange.new(6, 9); spray.SpreadAngle = Vector2.new(20, 20)
	spray.Acceleration = Vector3.new(0, -18, 0); spray.Lifetime = NumberRange.new(0.8, 1.2); spray.LightEmission = 1
	spray.Size = NumberSequence.new(0.5, 0.1)
	local sprayAnchor = part(model, Vector3.new(0.2, 0.2, 0.2), L(0, 6.2, 0), Color3.new(1, 1, 1), nil, false, nil, 1)
	spray.Parent = sprayAnchor
	local crystalLabel = billboard(crystal, "", UDim2.fromScale(14, 3.2), Vector3.new(0, 4.5, 0), Color3.fromRGB(200, 255, 210), 90)

	-- glowing pet slots in a ring around the fountain
	local slots = {}
	local slotFolder = Instance.new("Folder"); slotFolder.Name = "Slots"; slotFolder.Parent = model
	for i = 1, MAX_SLOTS do
		local a = (i - 1) / MAX_SLOTS * math.pi * 2 + math.pi / 2
		local x, z = math.cos(a) * SLOT_RADIUS, math.sin(a) * SLOT_RADIUS
		local pad = cyl(slotFolder, L(x, 0.98, z), 0.12, 3.2, Color3.fromRGB(245, 242, 250), Enum.Material.Marble, false)
		pad.Name = "Slot" .. i
		pad:SetAttribute("Index", i)
		local ring = cyl(slotFolder, L(x, 0.96, z), 0.12, 3.7, Color3.fromRGB(150, 120, 255), Enum.Material.Neon, false)
		ring.Name = "SlotRing" .. i
		slots[i] = L(x, 1.1, z)
	end

	-- money collect pad (front-left)
	local collect = cyl(model, L(COLLECT_POS.X, 1, COLLECT_POS.Z), 0.4, 9, Color3.fromRGB(80, 230, 120), Enum.Material.Neon, false)
	collect.Name = "CollectPad"
	local collectLabel = billboard(collect, "$0", UDim2.fromScale(10, 2.4), Vector3.new(0, 5, 0), Color3.fromRGB(120, 255, 140))
	billboard(collect, "STEP TO COLLECT", UDim2.fromScale(8, 1), Vector3.new(0, 3, 0), Color3.new(1, 1, 1))
	for k = 1, 7 do
		local a = k * 0.9
		local coin = cyl(model, L(COLLECT_POS.X + math.cos(a) * 2, 1.2 + k * 0.08, COLLECT_POS.Z + math.sin(a) * 2), 0.3, 1.4, Color3.fromRGB(255, 205, 50), Enum.Material.Metal, false)
		coin.CFrame *= CFrame.Angles(0.3, 0, 0)
	end

	-- PERSONAL GYM floor (front-right); the equipment itself is built in Refresh by level
	local g = Config.GymOffset
	local gymPad = part(model, Vector3.new(15, 0.3, 15), L(g.X, 1.1, g.Z), Color3.fromRGB(45, 40, 55), Enum.Material.Rubber, false)
	gymPad.Name = "GymPad"
	for _, e in ipairs({ { 0, 7.5, 15, 0.4 }, { 0, -7.5, 15, 0.4 }, { 7.5, 0, 0.4, 15 }, { -7.5, 0, 0.4, 15 } }) do
		part(model, Vector3.new(e[3], 0.35, e[4]), L(g.X + e[1], 1.3, g.Z + e[2]), Color3.fromRGB(255, 120, 60), Enum.Material.Neon, false)
	end
	local gymSign = part(model, Vector3.new(0.2, 0.2, 0.2), L(g.X, 9, g.Z), Color3.new(1, 1, 1), nil, false, nil, 1)
	local gymLabel = billboard(gymSign, "💪 GYM", UDim2.fromScale(12, 3), Vector3.new(0, 0, 0), Color3.fromRGB(255, 200, 140), 80)

	-- PET COTTAGE (back-left)
	local hc = L(-20, 1, 24)
	part(model, Vector3.new(13, 8, 9), hc * CFrame.new(0, 4, 0), Color3.fromRGB(255, 236, 205), Enum.Material.WoodPlanks)
	for _, s in ipairs({ -1, 1 }) do
		part(model, Vector3.new(14.5, 0.8, 6.5), hc * CFrame.new(0, 10, s * 2.4) * CFrame.Angles(math.rad(s * 38), 0, 0), Color3.fromRGB(220, 90, 110), Enum.Material.Slate)
	end
	part(model, Vector3.new(3, 5, 0.4), hc * CFrame.new(0, 2.5, -4.6), Color3.fromRGB(120, 80, 50), Enum.Material.Wood)
	for _, s in ipairs({ -1, 1 }) do
		local win = part(model, Vector3.new(2.4, 2.4, 0.3), hc * CFrame.new(s * 4, 4.6, -4.6), Color3.fromRGB(255, 220, 120), Enum.Material.Neon, false)
		light(win, Color3.fromRGB(255, 210, 140), 10, 1)
	end
	part(model, Vector3.new(1.6, 4, 1.6), hc * CFrame.new(4, 12, 1.5), Color3.fromRGB(160, 110, 90), Enum.Material.Brick)
	billboard(part(model, Vector3.new(0.2, 0.2, 0.2), hc * CFrame.new(0, 15, 0), Color3.new(1, 1, 1), nil, false, nil, 1), "🏠 Pet Cottage", UDim2.fromScale(9, 1.8), Vector3.zero, Color3.fromRGB(255, 220, 240), 70)

	-- POND (back-right)
	local pc = L(21, 1, 23)
	cyl(model, pc, 0.8, 14, stone, Enum.Material.Cobblestone, false)
	cyl(model, pc * CFrame.new(0, 0.1, 0), 0.75, 12.4, Color3.fromRGB(60, 180, 230), Enum.Material.Glass, false, 0.2)
	for k = 1, 4 do
		local a = k * 1.4
		cyl(model, pc * CFrame.new(math.cos(a) * 3.5, 0.85, math.sin(a) * 3.5), 0.1, 1.8, Color3.fromRGB(90, 190, 90), Enum.Material.Grass, false)
		ball(model, 0.6, pc * CFrame.new(math.cos(a) * 3.5, 1.1, math.sin(a) * 3.5), Color3.fromRGB(255, 160, 210), Enum.Material.Neon, false)
	end
	for k = 1, 5 do
		ball(model, 2.4, pc * CFrame.new(5 + (k % 2), 1.2 + k * 0.3, -2 + k), Color3.fromRGB(140, 140, 150), Enum.Material.Slate, false)
	end

	-- corner lamps + string lights along the hedges
	local corners = {}
	for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		local p = L(c[1] * (HALF - 2.5), 1, c[2] * (HALF - 2.5))
		part(model, Vector3.new(0.7, 11, 0.7), p * CFrame.new(0, 5.5, 0), Color3.fromRGB(50, 45, 60), Enum.Material.Metal)
		local orb = ball(model, 2, p * CFrame.new(0, 11.4, 0), Color3.fromRGB(255, 215, 150), Enum.Material.Neon, false)
		light(orb, Color3.fromRGB(255, 210, 150), 22, 1.5)
		table.insert(corners, (p * CFrame.new(0, 11, 0)).Position)
	end
	for i = 1, 4 do
		local a, b = corners[i], corners[i % 4 + 1]
		if i ~= 1 then -- leave the entrance side (corner1 -> corner2) open for the gateway
			for k = 1, 13 do
				local t = k / 14
				local p = a:Lerp(b, t) - Vector3.new(0, math.sin(t * math.pi) * 2.5, 0)
				ball(model, 0.7, CFrame.new(p), Color3.fromHSV((k * 0.13 + i * 0.2) % 1, 0.45, 1), Enum.Material.Neon, false)
			end
		end
	end

	local center = Instance.new("Part")
	center.Name = "Center"
	center.Size = Vector3.new(1, 1, 1)
	center.CFrame = L(0, 1, 0)
	center.Transparency = 1
	center.Anchored = true
	center.CanCollide = false
	center.CanQuery = false
	center.Parent = model

	local decor = Instance.new("Folder"); decor.Name = "Decor"; decor.Parent = model
	local gym = Instance.new("Folder"); gym.Name = "Gym"; gym.Parent = model

	model:SetAttribute("Index", index)
	model.Parent = workspace:FindFirstChild("Bases")
	return {
		index = index, model = model, cf = cf, floor = floor, slots = slots, slotFolder = slotFolder,
		collect = collect, collectLabel = collectLabel, incomeLabel = incomeLabel, crystalLabel = crystalLabel,
		signLabels = { sl, sg2.Owner }, decor = decor, gym = gym, gymLabel = gymLabel, owner = nil,
		training = gym, -- (old name, kept so nothing else breaks)
		spawnCF = cf * CFrame.new(0, 4, -HALF + 6) * CFrame.Angles(0, math.pi, 0),
	}
end

---------------------------------------------------------------- gym equipment (by level)
local function buildGymEquipment(base, level)
	local f = base.gym
	f:ClearAllChildren()
	local st = Config.TrainingStations[level]
	local g = base.cf * CFrame.new(Config.GymOffset) * CFrame.new(0, 1.25, 3)
	-- weight bench
	part(f, Vector3.new(2.4, 0.6, 6), g * CFrame.new(0, 1.6, -2), Color3.fromRGB(200, 50, 60), Enum.Material.Fabric)
	for _, s in ipairs({ -1, 1 }) do part(f, Vector3.new(0.4, 1.6, 0.4), g * CFrame.new(0, 0.8, -2 + s * 2.4), Color3.fromRGB(60, 60, 70), Enum.Material.Metal) end
	-- rack + the equipment
	for _, s in ipairs({ -1, 1 }) do part(f, Vector3.new(0.5, 5, 0.5), g * CFrame.new(s * 3.4, 2.5, 1.5), Color3.fromRGB(70, 70, 80), Enum.Material.Metal) end
	local mat = level >= 4 and Enum.Material.Neon or Enum.Material.Metal
	if level == 3 then
		for k = -1, 1 do
			ball(f, 2.2, g * CFrame.new(k * 2.2, 1.2, 1.5), st.color, Enum.Material.Metal)
			cyl(f, g * CFrame.new(k * 2.2, 2.2, 1.5) * CFrame.Angles(math.pi / 2, 0, 0), 0.4, 1.2, st.color, Enum.Material.Metal, false)
		end
	elseif level == 5 then
		for k = 1, 3 do
			part(f, Vector3.new(0.4, 7 + k * 1.5, 7 + k * 1.5), g * CFrame.new(0, 6, 1.5) * CFrame.Angles(k * 0.9, k * 0.5, 0), st.color, Enum.Material.Neon, false, Enum.PartType.Cylinder, 0.2)
		end
		local core = ball(f, 2.6, g * CFrame.new(0, 6, 1.5), Color3.new(1, 1, 1), Enum.Material.Neon, false)
		light(core, st.color, 24, 3)
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = SPARKLE; pe.Color = ColorSequence.new(st.color); pe.Rate = 10; pe.LightEmission = 1
		pe.Speed = NumberRange.new(1, 3); pe.Size = NumberSequence.new(0.5, 0); pe.Parent = core
	else
		part(f, Vector3.new(8, 0.5, 0.5), g * CFrame.new(0, 4.4, 1.5), Color3.fromRGB(80, 80, 90), Enum.Material.Metal, false, Enum.PartType.Cylinder)
		for _, s in ipairs({ -1, 1 }) do
			part(f, Vector3.new(0.8, 2.6 + level * 0.3, 2.6 + level * 0.3), g * CFrame.new(s * 3, 4.4, 1.5), st.color, mat, false, Enum.PartType.Cylinder)
		end
	end
	local nextSt = Config.TrainingStations[level + 1]
	base.gymLabel.Text = string.format("💪 GYM: %s\n<font color='#9CFFA8'>+%d Strength/lift</font>%s", st.name, st.gain,
		nextSt and ("\n<font color='#FFD36B'>Next: " .. nextSt.name .. "</font>") or "\n<font color='#FFD36B'>MAXED!</font>")
end

---------------------------------------------------------------- decorations
local DecorBuild = {}
local function D(base, spot) return base.cf * CFrame.new(spot) end

function DecorBuild.FlowerBed(f, cf)
	part(f, Vector3.new(8, 1, 4), cf * CFrame.new(0, 1.5, 0), Color3.fromRGB(120, 80, 50), Enum.Material.Wood)
	for i = 1, 10 do
		ball(f, 1, cf * CFrame.new(-3.2 + (i - 1) % 5 * 1.6, 2.4, i > 5 and 0.9 or -0.9), Color3.fromHSV((i * 0.13) % 1, 0.55, 1), nil, false).Size = Vector3.new(1.1, 0.7, 1.1)
	end
end
function DecorBuild.Lanterns(f, cf)
	for s = -1, 1, 2 do
		part(f, Vector3.new(0.5, 7, 0.5), cf * CFrame.new(s * 2.5, 4, 0), Color3.fromRGB(60, 50, 70), Enum.Material.Metal)
		local l = ball(f, 2, cf * CFrame.new(s * 2.5, 8, 0), Color3.fromRGB(255, 180, 90), Enum.Material.Neon, false)
		light(l, Color3.fromRGB(255, 190, 110), 16)
	end
end
function DecorBuild.MushroomRing(f, cf)
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		local p = cf * CFrame.new(math.cos(a) * 2.6, 1, math.sin(a) * 2.6)
		part(f, Vector3.new(0.6, 1.6, 0.6), p * CFrame.new(0, 0.8, 0), Color3.fromRGB(245, 235, 220), nil, false)
		ball(f, 1, p * CFrame.new(0, 1.8, 0), Color3.fromHSV(0.8 + i * 0.03, 0.7, 1), Enum.Material.Neon, false).Size = Vector3.new(1.8, 1, 1.8)
	end
end
function DecorBuild.Fountain(f, cf)
	cyl(f, cf * CFrame.new(0, 1, 0), 1.6, 7, Color3.fromRGB(220, 220, 235), Enum.Material.Marble, true)
	cyl(f, cf * CFrame.new(0, 2.5, 0), 0.2, 6, Color3.fromRGB(90, 190, 255), Enum.Material.Glass, false, 0.3)
	local orb = ball(f, 2.4, cf * CFrame.new(0, 5.5, 0), Color3.fromRGB(150, 110, 255), Enum.Material.Neon, false)
	light(orb, Color3.fromRGB(150, 110, 255), 16)
end
function DecorBuild.CrystalTree(f, cf)
	part(f, Vector3.new(1.4, 8, 1.4), cf * CFrame.new(0, 5, 0), Color3.fromRGB(230, 230, 255), Enum.Material.Glass)
	local last
	for i = 1, 7 do
		local a = i * 0.9
		last = part(f, Vector3.new(1, 3.5, 1), cf * CFrame.new(math.cos(a) * 2, 8 + (i % 3), math.sin(a) * 2) * CFrame.Angles(math.cos(a) * 0.6, 0, math.sin(a) * 0.6),
			Color3.fromHSV(0.55 + i * 0.05, 0.6, 1), Enum.Material.Neon, false)
	end
	light(last, Color3.fromRGB(150, 200, 255), 20)
end
function DecorBuild.Statue(f, cf)
	part(f, Vector3.new(4, 2, 4), cf * CFrame.new(0, 2, 0), Color3.fromRGB(230, 230, 235), Enum.Material.Marble)
	ball(f, 3, cf * CFrame.new(0, 4.8, 0), Color3.fromRGB(255, 200, 60), Enum.Material.Metal)
	for s = -1, 1, 2 do ball(f, 1, cf * CFrame.new(s * 0.8, 6.8, 0), Color3.fromRGB(255, 200, 60), Enum.Material.Metal).Size = Vector3.new(0.8, 2, 0.4) end
end
function DecorBuild.Rainbow(f, cf)
	for i = 0, 14 do
		local a = i / 14 * math.pi
		ball(f, 1.6, cf * CFrame.new(math.cos(a) * 5, 1 + math.sin(a) * 6, 0), Color3.fromHSV(i / 14, 0.65, 1), Enum.Material.Neon, false)
	end
end
function DecorBuild.FloatingIsland(f, cf)
	ball(f, 1, cf, Color3.fromRGB(120, 90, 70), Enum.Material.Slate, false).Size = Vector3.new(12, 5, 10)
	ball(f, 1, cf * CFrame.new(0, 2, 0), Color3.fromRGB(110, 210, 90), Enum.Material.Grass, false).Size = Vector3.new(12, 1.5, 10)
	part(f, Vector3.new(0.8, 4, 0.8), cf * CFrame.new(0, 4.5, 0), Color3.fromRGB(120, 80, 50), Enum.Material.Wood, false)
	ball(f, 1, cf * CFrame.new(0, 7, 0), Color3.fromRGB(255, 160, 210), Enum.Material.Grass, false).Size = Vector3.new(4.5, 4, 4.5)
end

---------------------------------------------------------------- public API
function BaseBuilder.BuildAll()
	local f = Instance.new("Folder"); f.Name = "Bases"; f.Parent = workspace
	for i = 1, Config.MaxBases do
		BaseBuilder.Bases[i] = buildBase(i)
	end
end

function BaseBuilder.Claim(player)
	for _, b in ipairs(BaseBuilder.Bases) do
		if not b.owner then
			b.owner = player
			for _, l in ipairs(b.signLabels) do l.Text = player.DisplayName .. "'s Base" end
			b.model:SetAttribute("OwnerId", player.UserId)
			return b
		end
	end
	return nil
end

function BaseBuilder.Release(base)
	base.owner = nil
	for _, l in ipairs(base.signLabels) do l.Text = "Empty Base" end
	base.model:SetAttribute("OwnerId", nil)
	base.decor:ClearAllChildren()
	base.gym:ClearAllChildren()
	base.gymLabel.Text = "💪 GYM"
	base.crystalLabel.Text = ""
	base.collectLabel.Text = "$0"
end

-- Rebuild decorations, floor theme, gym equipment and slot colours from player data
function BaseBuilder.Refresh(base, data)
	base.decor:ClearAllChildren()
	for i, id in ipairs(Config.DecorOrder) do
		if data.Decor[id] and DecorBuild[id] then
			local holder = Instance.new("Folder"); holder.Name = id; holder.Parent = base.decor
			DecorBuild[id](holder, D(base, DECOR_SPOTS[i]))
		end
	end
	for _, theme in ipairs(Config.FloorThemes) do
		if theme.id == data.FloorTheme then
			base.floor.Color = theme.color
			base.floor.Material = theme.material
		end
	end
	buildGymEquipment(base, math.clamp(data.EquipLevel or 1, 1, #Config.TrainingStations))
	local lvl = data.Upgrades.Training
	base.crystalLabel.Text = lvl > 0 and ("🐾 Pet Trainer Lv." .. lvl .. "  (+" .. math.floor(lvl * Config.TrainingBonus * 100) .. "% income)") or ""
	local slotsOpen = Config.StartSlots + data.Upgrades.BaseSlots
	for i = 1, #base.slots do
		local ring = base.slotFolder:FindFirstChild("SlotRing" .. i)
		local pad = base.slotFolder:FindFirstChild("Slot" .. i)
		local open = i <= slotsOpen
		if ring then
			ring.Color = open and Color3.fromRGB(150, 120, 255) or Color3.fromRGB(90, 90, 100)
			ring.Material = open and Enum.Material.Neon or Enum.Material.SmoothPlastic
			ring.Transparency = open and 0 or 0.5
		end
		if pad then pad.Transparency = open and 0 or 0.6 end
	end
end

return BaseBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- DataService: DataStore saving with session locking, retries, autosave and BindToClose.
-- Location: ServerScriptService > Server > DataService (ModuleScript)

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local DataService = {}
DataService.Profiles = {} -- [player] = data table

local STORE_NAME = "TPFC_PlayerData_v1"
local LOCK_TIMEOUT = 300
local store
local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)
if not storeOk then
	warn("[DataService] DataStores unavailable (enable Studio API access). Using temporary data.")
end

local function defaultData()
	return {
		Money = 50,
		Strength = 0,
		OwnedEquipment = { ["1"] = true },  -- (old system, kept for save compatibility)
		EquipLevel = 1,                     -- your personal gym's equipment level (1-5)
		TotalEarned = 0,
		Upgrades = { ThrowPower = 1, BaseSlots = 0, Storage = 0, Training = 0 },
		OwnedPortals = { Basic = true },
		EquippedPortal = "Basic",
		Creatures = {},        -- array of { u = uid, c = creatureId }
		Placed = {},           -- array of uids placed in base
		Discovered = {},       -- [creatureId] = true
		UnlockedWorlds = { Forest = true },
		Decor = {},            -- [decorId] = true
		FloorTheme = "Meadow",
		OwnedFloors = { Meadow = true },
		Uncollected = 0,
		NextUid = 1,
		LastOnline = 0,
		Throws = 0,
	}
end

local function reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			data[k] = (type(v) == "table") and table.clone(v) or v
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil and #v == 0 then
			reconcile(data[k], v)
		end
	end
	return data
end

local function retry(fn, tries)
	local lastErr
	for i = 1, tries or 4 do
		local ok, res = pcall(fn)
		if ok then return true, res end
		lastErr = res
		task.wait(1.5 * i)
	end
	return false, lastErr
end

function DataService.Load(player: Player)
	local key = "u_" .. player.UserId
	local data
	if store then
		local loaded
		for attempt = 1, 4 do
			local ok, err = retry(function()
				store:UpdateAsync(key, function(old)
					old = old or {}
					local lock = old._lock
					if lock and lock.job ~= game.JobId and os.time() - lock.t < LOCK_TIMEOUT and attempt < 4 then
						loaded = "locked"
						return nil -- abort write, someone else holds the session
					end
					old._lock = { job = game.JobId, t = os.time() }
					loaded = old
					return old
				end)
			end)
			if not ok then warn("[DataService] load failed:", err); break end
			if loaded ~= "locked" then break end
			task.wait(4) -- previous server still saving; wait and retry (steals lock on last attempt)
		end
		if type(loaded) == "table" then data = loaded end
	end
	if not player.Parent then return nil end
	data = reconcile(data or {}, defaultData())
	data._lock = nil
	DataService.Profiles[player] = data
	return data
end

function DataService.Save(player: Player, release: boolean?)
	local data = DataService.Profiles[player]
	if not data or not store then return end
	data.LastOnline = os.time()
	local key = "u_" .. player.UserId
	local ok, err = retry(function()
		store:UpdateAsync(key, function(old)
			local copy = table.clone(data)
			copy._lock = (not release) and { job = game.JobId, t = os.time() } or nil
			return copy
		end)
	end, 3)
	if not ok then warn("[DataService] save failed for", player.Name, err) end
end

DataService.Default = defaultData

function DataService.Get(player: Player)
	return DataService.Profiles[player]
end

function DataService.Release(player: Player)
	DataService.Save(player, true)
	DataService.Profiles[player] = nil
end

function DataService.NewUid(data)
	local u = data.NextUid
	data.NextUid += 1
	return u
end

-- autosave loop
task.spawn(function()
	while true do
		task.wait(60)
		for _, p in ipairs(Players:GetPlayers()) do
			task.spawn(DataService.Save, p, false)
		end
	end
end)

game:BindToClose(function()
	local threads = 0
	for _, p in ipairs(Players:GetPlayers()) do
		threads += 1
		task.spawn(function()
			DataService.Save(p, true)
			threads -= 1
		end)
	end
	local start = os.clock()
	while threads > 0 and os.clock() - start < 25 do task.wait(0.2) end
end)

return DataService
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX15"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- GameServer: authoritative game logic (throwing, rolling, collecting, income, shop, upgrades).
-- Location: ServerScriptService > Server > GameServer (Script)
-- The client only sends *requests*; every price, cooldown, distance and roll is decided here.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CreatureData = require(Shared.CreatureData)
local Format = require(Shared.Format)
local Odds = require(Shared.Odds)
local DataService = require(script.Parent.DataService)
local WorldBuilder = require(script.Parent.WorldBuilder)
local BaseBuilder = require(script.Parent.BaseBuilder)

---------------------------------------------------------------- remotes
local Remotes = Instance.new("Folder")
Remotes.Name = "Remotes"
local function RE(name) local r = Instance.new("RemoteEvent"); r.Name = name; r.Parent = Remotes; return r end
local ThrowRE = RE("Throw")
local SyncRE = RE("Sync")
local PortalThrownRE = RE("PortalThrown")
local PortalOpenedRE = RE("PortalOpened")
local CreatureGoneRE = RE("CreatureGone")
local NotifyRE = RE("Notify")
local MoneyFxRE = RE("MoneyFx")
local DepositRE = RE("Deposit")
local RequestRF = Instance.new("RemoteFunction"); RequestRF.Name = "Request"; RequestRF.Parent = Remotes
Remotes.Parent = ReplicatedStorage

---------------------------------------------------------------- world
BaseBuilder.BuildAll()
WorldBuilder.BuildAll()

---------------------------------------------------------------- state
local State = {}      -- [player] = { base, carry = {ids}, lastThrow, tokens, lastTokenT, dirty }
local Pending = {}    -- [throwId] = { owner, creature, pos, opened, world }
local nextThrowId = 0
local Actions = {}    -- request handlers (filled in below)

local function slotsOpen(data) return Config.StartSlots + data.Upgrades.BaseSlots end
local function storageCap(data) return Config.StartStorage + data.Upgrades.Storage * Config.StoragePerLevel end
local function trainingMult(data) return 1 + data.Upgrades.Training * Config.TrainingBonus end

local function findCreature(data, uid)
	for i, c in ipairs(data.Creatures) do
		if c.u == uid then return c, i end
	end
end
local function isPlaced(data, uid) return table.find(data.Placed, uid) ~= nil end

local function incomePerSec(data)
	local total = 0
	for _, uid in ipairs(data.Placed) do
		local c = findCreature(data, uid)
		if c then total += CreatureData.Income(c.c) end
	end
	return total * trainingMult(data)
end

local function storedCount(data) return #data.Creatures - #data.Placed end

local function freeSpace(player, data)
	local st = State[player]
	return (slotsOpen(data) - #data.Placed) + (storageCap(data) - storedCount(data)) - (st and #st.carry or 0)
end

local function updateAttributes(player, data)
	local ids = {}
	for _, uid in ipairs(data.Placed) do
		local c = findCreature(data, uid)
		if c then table.insert(ids, c.c) end
	end
	player:SetAttribute("BaseCreatures", HttpService:JSONEncode(ids))
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		ls.Money.Value = Format.Money(data.Money)
		ls.Creatures.Value = #data.Creatures
	end
end

local function sync(player, partial)
	local data = DataService.Get(player)
	if not data then return end
	local maxDist = Config.ThrowDistance(data.Upgrades.ThrowPower, data.Strength)
	if partial then
		SyncRE:FireClient(player, { Money = data.Money, Uncollected = data.Uncollected, Strength = data.Strength, MaxDistance = maxDist })
		return
	end
	local st = State[player]
	SyncRE:FireClient(player, {
		Money = data.Money, Uncollected = data.Uncollected, Upgrades = data.Upgrades,
		OwnedPortals = data.OwnedPortals, EquippedPortal = data.EquippedPortal,
		Creatures = data.Creatures, Placed = data.Placed, Discovered = data.Discovered,
		UnlockedWorlds = data.UnlockedWorlds, Decor = data.Decor, FloorTheme = data.FloorTheme, OwnedFloors = data.OwnedFloors,
		Income = incomePerSec(data), SlotsOpen = slotsOpen(data), StorageCap = storageCap(data),
		MaxDistance = maxDist, Strength = data.Strength, EquipLevel = data.EquipLevel,
		Carry = st and st.carry or {}, BaseIndex = st and st.base and st.base.index or 0,
	})
	updateAttributes(player, data)
end

local function notify(player, text, kind)
	NotifyRE:FireClient(player, text, kind or "info")
end

local function setCarry(player)
	local st = State[player]
	player:SetAttribute("Carry", table.concat(st.carry, ","))
end

---------------------------------------------------------------- rolling
local function rollCreature(portalId, worldId, dist)
	local portal = Config.Portals[portalId]
	local luck = Config.LuckFromDistance(dist)
	local pool = {}
	for _, c in ipairs(CreatureData.ByWorld[worldId] or {}) do table.insert(pool, c) end
	for _, c in ipairs(CreatureData.ByWorld.Any or {}) do table.insert(pool, c) end

	local total, entries = 0, {}
	for rarity, w in pairs(portal.weights) do
		local order = Config.Rarities[rarity].order
		local has = false
		for _, c in ipairs(pool) do if c.rarity == rarity then has = true break end end
		if has then
			local weight = w * luck ^ (math.max(0, order - 2) * 0.5)
			total += weight
			table.insert(entries, { rarity = rarity, w = weight })
		end
	end
	table.sort(entries, function(a, b) return Config.Rarities[a.rarity].order < Config.Rarities[b.rarity].order end)
	local r = math.random() * total
	local chosen = entries[1].rarity
	for _, e in ipairs(entries) do
		r -= e.w
		if r <= 0 then chosen = e.rarity break end
	end
	local candidates = {}
	for _, c in ipairs(pool) do if c.rarity == chosen then table.insert(candidates, c) end end
	return candidates[math.random(1, #candidates)].id
end

---------------------------------------------------------------- throwing
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundAt(pos)
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(list, p.Character) end end
	rayParams.FilterDescendantsInstances = list
	local hit = workspace:Raycast(pos + Vector3.new(0, 150, 0), Vector3.new(0, -300, 0), rayParams)
	return hit and hit.Position or Vector3.new(pos.X, 0, pos.Z)
end

local function pendingCount(player)
	local n = 0
	for _, p in pairs(Pending) do if p.owner == player then n += 1 end end
	return n
end

ThrowRE.OnServerEvent:Connect(function(player, power, dir)
	local data, st = DataService.Get(player), State[player]
	if not data or not st then return end
	if typeof(power) ~= "number" or power ~= power or typeof(dir) ~= "Vector3" then return end
	if dir.X ~= dir.X or dir.Z ~= dir.Z then return end
	local now = os.clock()
	if now - st.lastThrow < Config.ThrowCooldown then return end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end
	if pendingCount(player) >= Config.MaxPendingPerPlayer then
		notify(player, "One portal at a time! Wait for your creature.", "error")
		return
	end
	if freeSpace(player, data) - pendingCount(player) <= 0 then
		notify(player, "Storage full! Upgrade storage or sell creatures.", "error")
		return
	end
	local origin = hrp.Position
	-- you throw from the start area, always down the lane (+Z)
	if not Config.InThrowZone(origin) then
		notify(player, "Stand on the THROW LINE to throw!", "throwzone")
		return
	end
	st.lastThrow = now
	data.Throws += 1

	power = math.clamp(power, 0.05, 1)
	local flat = Vector3.new(dir.X, 0, dir.Z)
	local side = 0
	if flat.Magnitude > 0.1 and flat.Unit.Z > 0.2 then side = flat.Unit.X / flat.Unit.Z end
	local perfect = power >= 0.92
	local dist = Config.ThrowDistance(data.Upgrades.ThrowPower, data.Strength) * power * (perfect and 1.15 or 1)
	dist = math.clamp(dist, 8, Config.LaneLength - 15)
	local lx = math.clamp(origin.X * 0.35 + side * dist * 0.35, -Config.LaneHalfWidth, Config.LaneHalfWidth)
	local landing = groundAt(Vector3.new(lx, 0, dist))
	local realDist = dist
	local worldId = Config.WorldAt(landing)
	local flight = math.clamp(0.7 + math.sqrt(realDist) * 0.07, 0.9, 4.5)

	nextThrowId += 1
	local id = nextThrowId
	local creatureId, chance = Odds.Roll(data.EquippedPortal, worldId, realDist)
	if st.forceNext and CreatureData.ById[st.forceNext] then -- admin: force the next creature
		creatureId = st.forceNext
		chance = Odds.Table(data.EquippedPortal, worldId, realDist)[creatureId] or 0.0001
		st.forceNext = nil
	end
	Pending[id] = { owner = player, creature = creatureId, pos = landing, opened = false, world = worldId }

	PortalThrownRE:FireAllClients({
		id = id, owner = player.UserId, portal = data.EquippedPortal,
		from = origin + Vector3.new(0, 1.5, 2), to = landing, t = flight, perfect = perfect, dist = realDist, zone = worldId,
	})
	task.delay(flight + 0.9, function()
		local p = Pending[id]
		if not p then return end
		p.opened = true
		local def = CreatureData.ById[creatureId]
		PortalOpenedRE:FireAllClients({ id = id, owner = player.UserId, creature = creatureId, pos = landing, portal = data.EquippedPortal, chance = chance })
		if Config.Rarities[def.rarity].order >= 5 then
			for _, other in ipairs(Players:GetPlayers()) do
				notify(other, player.DisplayName .. " found a " .. def.rarity:upper() .. " " .. def.name .. " (" .. Odds.OneIn(chance) .. ")!", def.rarity)
			end
		end
		-- caught automatically once its entrance animation has played
		task.delay(Config.CatchDelay[def.rarity] or 3, function()
			if Pending[id] and player.Parent and State[player] then
				local ok, msg = Actions.Collect(player, DataService.Get(player), State[player], id)
				if not ok and msg then notify(player, msg, "error") end
			end
		end)
	end)
	task.delay(flight + Config.PendingLifetime, function()
		if Pending[id] then
			Pending[id] = nil
			CreatureGoneRE:FireAllClients(id, "expired")
		end
	end)
end)

---------------------------------------------------------------- deposit + income loops
local function depositCarry(player, data, st, silent)
	if #st.carry == 0 then return end
	local newOnes = {}
	for _, cid in ipairs(st.carry) do
		local uid = DataService.NewUid(data)
		table.insert(data.Creatures, { u = uid, c = cid })
		if #data.Placed < slotsOpen(data) then table.insert(data.Placed, uid) end
		if not data.Discovered[cid] then
			data.Discovered[cid] = true
			local bonus = math.floor(CreatureData.Income(cid) * Config.DiscoveryBonus)
			data.Money += bonus
			if not silent then notify(player, "NEW to your index: " .. CreatureData.ById[cid].name .. "!  +" .. Format.Money(bonus), "discover") end
		end
		table.insert(newOnes, cid)
	end
	st.carry = {}
	setCarry(player)
	if not silent then DepositRE:FireClient(player, newOnes) end
	sync(player)
end

task.spawn(function()
	while true do
		task.wait(0.25)
		for player, st in pairs(State) do
			local data = DataService.Get(player)
			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			-- put the weight away when you stop lifting
			if st.prop and os.clock() - (st.lastTrain or 0) > 1.2 then
				st.prop:Destroy()
				st.prop = nil
			end
			if data and hrp and st.base then
				local bpos = st.base.cf.Position
				local flatD = ((hrp.Position - bpos) * Vector3.new(1, 0, 1)).Magnitude
				if #st.carry > 0 and flatD < Config.BaseRadius then
					depositCarry(player, data, st)
				end
				local pad = st.base.collect.Position
				if data.Uncollected >= 1 and ((hrp.Position - pad) * Vector3.new(1, 0, 1)).Magnitude < 5.5 and math.abs(hrp.Position.Y - pad.Y) < 8 then
					local amt = math.floor(data.Uncollected)
					data.Money += amt
					data.TotalEarned += amt
					data.Uncollected -= amt
					st.base.collectLabel.Text = "$0"
					MoneyFxRE:FireClient(player, amt, pad)
					sync(player, true)
					updateAttributes(player, data)
				end
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(1)
		for player, st in pairs(State) do
			local data = DataService.Get(player)
			if data then
				data.Uncollected += incomePerSec(data)
				if st.base then
					st.base.collectLabel.Text = Format.Money(data.Uncollected)
					st.base.incomeLabel.Text = "+" .. Format.Money(incomePerSec(data)) .. "/s  •  " .. #data.Placed .. "/" .. slotsOpen(data) .. " pets"
				end
				sync(player, true)
			end
		end
	end
end)

---------------------------------------------------------------- requests
-- (Actions table is declared near the top so the throw handler can use it)

function Actions.Collect(player, data, st, throwId)
	local p = Pending[throwId]
	if not p or p.owner ~= player or not p.opened then return false, "Nothing to collect" end
	-- caught! it goes straight into your inventory (and into a free base slot, where it roams)
	if freeSpace(player, data) <= 0 then return false, "Storage full! Sell creatures or upgrade storage." end
	Pending[throwId] = nil
	CreatureGoneRE:FireAllClients(throwId, "collected", player.UserId)
	table.insert(st.carry, p.creature)
	depositCarry(player, data, st)
	return true
end

function Actions.BuyPortal(player, data, st, id)
	local P = Config.Portals[id]
	if not P then return false, "Unknown portal" end
	if data.OwnedPortals[id] then return false, "Already owned" end
	if data.Money < P.price then return false, "Not enough money" end
	data.Money -= P.price
	data.OwnedPortals[id] = true
	data.EquippedPortal = id
	return true
end

function Actions.EquipPortal(player, data, st, id)
	if not data.OwnedPortals[id] then return false, "Not owned" end
	data.EquippedPortal = id
	return true
end

function Actions.Upgrade(player, data, st, kind)
	local U = Config.Upgrades[kind]
	if not U then return false, "Unknown upgrade" end
	local lvl = data.Upgrades[kind]
	local idx = (kind == "ThrowPower") and lvl - 1 or lvl
	if idx >= U.max then return false, "Max level!" end
	local cost = Config.UpgradeCost(kind, idx)
	if data.Money < cost then return false, "Not enough money" end
	data.Money -= cost
	data.Upgrades[kind] = lvl + 1
	if (kind == "Training" or kind == "BaseSlots") and st.base then BaseBuilder.Refresh(st.base, data) end
	if kind == "BaseSlots" then
		-- auto-fill the new slot from storage
		for _, c in ipairs(data.Creatures) do
			if #data.Placed >= slotsOpen(data) then break end
			if not isPlaced(data, c.u) then table.insert(data.Placed, c.u) end
		end
	end
	return true
end

function Actions.UnlockWorld(player, data, st, id)
	local W = Config.Worlds[id]
	if not W then return false, "Unknown world" end
	if data.UnlockedWorlds[id] then return false, "Already unlocked" end
	local prev = Config.WorldOrder[W.index - 1]
	if prev and not data.UnlockedWorlds[prev] then return false, "Unlock " .. Config.Worlds[prev].name .. " first" end
	if data.Upgrades.ThrowPower < W.throwLevel then return false, "Need Throw Power Lv." .. W.throwLevel end
	if data.Money < W.cost then return false, "Not enough money" end
	data.Money -= W.cost
	data.UnlockedWorlds[id] = true
	return true
end

function Actions.Teleport(player, data, st, id)
	local char = player.Character
	if not char then return false, "No character" end
	if id == "Home" then
		if st.base then char:PivotTo(st.base.spawnCF) end
		return true
	end
	return false, "Walk down the lane to explore!"
end

---------------------------------------------------------------- training
-- the weight appears in your hand while you lift (made on the server so everyone sees it)
local function liftProp(player, st, index)
	local char = player.Character
	local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"))
	if not hand then return end
	if st.prop and st.prop.Parent and st.propIndex == index then return end
	if st.prop then st.prop:Destroy() end
	local station = Config.TrainingStations[index]
	local model = Instance.new("Model")
	model.Name = "LiftProp"
	local s = 0.8 + index * 0.18
	local function p(shape, size, color, mat)
		local part = Instance.new("Part")
		part.Shape = shape
		part.Size = size
		part.Color = color
		part.Material = mat or Enum.Material.Metal
		part.CanCollide, part.CanQuery, part.CanTouch, part.Massless = false, false, false, true
		part.Parent = model
		return part
	end
	local bar = p(Enum.PartType.Cylinder, Vector3.new(2.6 * s, 0.3, 0.3), Color3.fromRGB(70, 70, 80))
	local plateMat = index >= 4 and Enum.Material.Neon or Enum.Material.Metal
	for side = -1, 1, 2 do
		local plate = p(Enum.PartType.Cylinder, Vector3.new(0.45 * s, 1.3 * s, 1.3 * s), station.color, plateMat)
		local w = Instance.new("Weld"); w.Part0 = bar; w.Part1 = plate; w.C0 = CFrame.new(side * 1.1 * s, 0, 0); w.Parent = plate
	end
	if index == 5 then
		local fx = Instance.new("ParticleEmitter")
		fx.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		fx.Color = ColorSequence.new(station.color); fx.Rate = 20; fx.LightEmission = 1
		fx.Size = NumberSequence.new(0.4, 0); fx.Speed = NumberRange.new(1, 2); fx.Parent = bar
	end
	local w = Instance.new("Weld")
	w.Part0 = hand
	w.Part1 = bar
	w.C0 = CFrame.new(0, -hand.Size.Y / 2, 0) * CFrame.Angles(0, math.rad(90), 0)
	w.Parent = bar
	model.Parent = char
	st.prop, st.propIndex = model, index
end

-- PERSONAL GYM: lift in your own base's gym
function Actions.Train(player, data, st)
	if not st.base then return false, "You don't have a base" end
	local level = math.clamp(data.EquipLevel or 1, 1, #Config.TrainingStations)
	local station = Config.TrainingStations[level]
	local gymPos = (st.base.cf * CFrame.new(Config.GymOffset)).Position
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp or ((hrp.Position - gymPos) * Vector3.new(1, 0, 1)).Magnitude > Config.TrainRange + 2 then return false, "Stand in your gym" end
	local now = os.clock()
	if now - (st.lastTrain or 0) < Config.TrainCooldown * 0.9 then return false, nil end
	st.lastTrain = now
	data.Strength += station.gain
	liftProp(player, st, level)
	return true, nil, "partial"
end

-- buy the next piece of equipment for your gym
function Actions.UpgradeEquipment(player, data, st)
	local level = data.EquipLevel or 1
	local nextStation = Config.TrainingStations[level + 1]
	if not nextStation then return false, "Your gym is maxed out!" end
	if data.Money < nextStation.price then return false, "Not enough money (" .. Format.Money(nextStation.price) .. ")" end
	data.Money -= nextStation.price
	data.EquipLevel = level + 1
	if st.base then BaseBuilder.Refresh(st.base, data) end
	return true, "Gym upgraded: " .. nextStation.name .. "! +" .. nextStation.gain .. " Strength per lift"
end

---------------------------------------------------------------- admin
local RunService = game:GetService("RunService")
local function isAdmin(player)
	if RunService:IsStudio() then return true end
	if table.find(Config.AdminIds, player.UserId) then return true end
	if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then return true end
	if game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
		if ok and rank >= 254 then return true end
	end
	return false
end

local AdminCmds = {}
function AdminCmds.money(player, data, st, v) data.Money = math.max(0, data.Money + (tonumber(v) or 0)); return true, "Money changed" end
function AdminCmds.strength(player, data, st, v) data.Strength = math.max(0, data.Strength + (tonumber(v) or 0)); return true, "Strength changed" end
function AdminCmds.throwlevel(player, data, st, v)
	data.Upgrades.ThrowPower = math.clamp(math.floor(tonumber(v) or 1), 1, Config.Upgrades.ThrowPower.max + 1)
	return true, "Throw Power set"
end
function AdminCmds.maxupgrades(player, data, st)
	data.Upgrades.ThrowPower = Config.Upgrades.ThrowPower.max + 1
	for _, k in ipairs({ "BaseSlots", "Storage", "Training" }) do data.Upgrades[k] = Config.Upgrades[k].max end
	if st.base then BaseBuilder.Refresh(st.base, data) end
	return true, "All upgrades maxed"
end
function AdminCmds.allportals(player, data, st)
	for id in pairs(Config.Portals) do data.OwnedPortals[id] = true end
	return true, "All portals unlocked"
end
function AdminCmds.give(player, data, st, id)
	if not CreatureData.ById[id] then return false, "Unknown creature" end
	local uid = DataService.NewUid(data)
	table.insert(data.Creatures, { u = uid, c = id })
	data.Discovered[id] = true
	if #data.Placed < slotsOpen(data) then table.insert(data.Placed, uid) end
	return true, "Gave " .. CreatureData.ById[id].name
end
function AdminCmds.forcenext(player, data, st, id)
	if not CreatureData.ById[id] then return false, "Unknown creature id" end
	st.forceNext = id
	return true, "Your next throw will be " .. CreatureData.ById[id].name
end
function AdminCmds.discoverall(player, data, st)
	for _, c in ipairs(CreatureData.List) do data.Discovered[c.id] = true end
	return true, "Index completed"
end
function AdminCmds.zone(player, data, st, id)
	if id ~= "Start" and not Config.ZoneBounds[id] then return false, "Unknown zone" end
	local char = player.Character
	if not char then return false, "No character" end
	local pos = id == "Start" and Vector3.new(0, 5, -60) or (Config.WorldCenter(id) + Vector3.new(0, 5, 0))
	char:PivotTo(CFrame.new(pos))
	return true, "Teleported"
end
function AdminCmds.speed(player, data, st, v)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then hum.WalkSpeed = math.clamp(tonumber(v) or 16, 8, 300) end
	return true, "WalkSpeed set"
end
function AdminCmds.reset(player, data, st)
	local keep = data.NextUid
	for k in pairs(data) do data[k] = nil end
	local fresh = DataService.Default()
	for k, v in pairs(fresh) do data[k] = v end
	data.NextUid = keep
	st.carry = {}
	setCarry(player)
	if st.base then BaseBuilder.Refresh(st.base, data) end
	return true, "Your data was reset"
end

function Actions.Admin(player, data, st, json)
	if not isAdmin(player) then return false, "Not an admin" end
	local ok, req = pcall(HttpService.JSONDecode, HttpService, tostring(json))
	if not ok or type(req) ~= "table" or type(req.cmd) ~= "string" then return false, "Bad admin request" end
	local fn = AdminCmds[req.cmd]
	if not fn then return false, "Unknown command" end
	return fn(player, data, st, req.value)
end

function Actions.Place(player, data, st, uid)
	if not findCreature(data, uid) or isPlaced(data, uid) then return false, "Can't place" end
	if #data.Placed >= slotsOpen(data) then return false, "Base is full! Buy more slots." end
	table.insert(data.Placed, uid)
	return true
end

function Actions.Unplace(player, data, st, uid)
	local i = table.find(data.Placed, uid)
	if not i then return false, "Not placed" end
	if storedCount(data) >= storageCap(data) then return false, "Storage full" end
	table.remove(data.Placed, i)
	return true
end

function Actions.Sell(player, data, st, uid)
	local c, i = findCreature(data, uid)
	if not c then return false, "Not found" end
	local price = math.floor(CreatureData.Income(c.c) * Config.SellMultiplier)
	table.remove(data.Creatures, i)
	local pi = table.find(data.Placed, uid)
	if pi then table.remove(data.Placed, pi) end
	data.Money += price
	return true, "Sold for " .. Format.Money(price)
end

function Actions.EquipBest(player, data, st)
	local list = table.clone(data.Creatures)
	table.sort(list, function(a, b) return CreatureData.Income(a.c) > CreatureData.Income(b.c) end)
	local n = math.min(#list, slotsOpen(data))
	if #list - n > storageCap(data) then return false, "Storage full" end
	data.Placed = {}
	for i = 1, n do table.insert(data.Placed, list[i].u) end
	return true
end

function Actions.BuyDecor(player, data, st, id)
	local D = Config.Decor[id]
	if not D then return false, "Unknown" end
	if data.Decor[id] then return false, "Owned" end
	if data.Money < D.price then return false, "Not enough money" end
	data.Money -= D.price
	data.Decor[id] = true
	if st.base then BaseBuilder.Refresh(st.base, data) end
	return true
end

function Actions.Floor(player, data, st, id)
	local theme
	for _, t in ipairs(Config.FloorThemes) do if t.id == id then theme = t end end
	if not theme then return false, "Unknown" end
	if not data.OwnedFloors[id] then
		if data.Money < theme.price then return false, "Not enough money" end
		data.Money -= theme.price
		data.OwnedFloors[id] = true
	end
	data.FloorTheme = id
	if st.base then BaseBuilder.Refresh(st.base, data) end
	return true
end

RequestRF.OnServerInvoke = function(player, action, arg)
	local data, st = DataService.Get(player), State[player]
	if not data or not st then return false, "Loading..." end
	-- token bucket rate limit: 8 requests / second
	local now = os.clock()
	st.tokens = math.min(8, st.tokens + (now - st.lastTokenT) * 8)
	st.lastTokenT = now
	if st.tokens < 1 then return false, "Slow down!" end
	st.tokens -= 1
	local fn = typeof(action) == "string" and Actions[action]
	if not fn then return false, "Bad request" end
	if arg ~= nil and typeof(arg) ~= "string" and typeof(arg) ~= "number" then return false, "Bad argument" end
	local ok, res, msg, mode = pcall(fn, player, data, st, arg)
	if not ok then warn("[GameServer] action error", action, res); return false, "Error" end
	if res then sync(player, mode == "partial") end
	return res, msg
end

---------------------------------------------------------------- players
local function onCharacter(player, char)
	local st = State[player]
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	if hrp and st and st.base then
		task.wait(0.1)
		char:PivotTo(st.base.spawnCF)
	end
end

local function onPlayerAdded(player)
	local ls = Instance.new("Folder"); ls.Name = "leaderstats"
	local m = Instance.new("StringValue"); m.Name = "Money"; m.Value = "$0"; m.Parent = ls
	local c = Instance.new("IntValue"); c.Name = "Creatures"; c.Parent = ls
	ls.Parent = player

	local data = DataService.Load(player)
	if not data or not player.Parent then return end
	-- carry over equipment bought under the old shared-station system
	for i = #Config.TrainingStations, 1, -1 do
		if data.OwnedEquipment and data.OwnedEquipment[tostring(i)] then
			data.EquipLevel = math.max(data.EquipLevel or 1, i)
			break
		end
	end
	local base = BaseBuilder.Claim(player)
	State[player] = { base = base, carry = {}, lastThrow = 0, tokens = 8, lastTokenT = os.clock() }
	player:SetAttribute("BaseIndex", base and base.index or 0)
	player:SetAttribute("IsAdmin", isAdmin(player))
	setCarry(player)
	if base then BaseBuilder.Refresh(base, data) end

	-- offline earnings
	if data.LastOnline > 0 then
		local away = math.clamp(os.time() - data.LastOnline, 0, Config.OfflineCapSeconds)
		local earned = math.floor(incomePerSec(data) * away * Config.OfflineRate)
		if earned > 0 then
			data.Uncollected += earned
			task.delay(4, notify, player, "Welcome back! Your creatures earned " .. Format.Money(earned) .. " while you were away. Collect it at your base!", "money")
		end
	end
	player.CharacterAdded:Connect(function(ch) onCharacter(player, ch) end)
	if player.Character then task.spawn(onCharacter, player, player.Character) end
	sync(player)
	player:SetAttribute("Loaded", true)
end
Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onPlayerAdded, p) end

Players.PlayerRemoving:Connect(function(player)
	local st = State[player]
	local data = DataService.Get(player)
	if st and data then
		depositCarry(player, data, st, true) -- never lose carried creatures
		if st.base then BaseBuilder.Release(st.base) end
	end
	for id, p in pairs(Pending) do
		if p.owner == player then Pending[id] = nil; CreatureGoneRE:FireAllClients(id, "expired") end
	end
	State[player] = nil
	DataService.Release(player)
end)

-- Client asks for a full sync once its UI is ready
RequestRF:SetAttribute("Ready", true)
Actions.Sync = function(player) return true end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[-- WorldBuilder: builds ONE long map — the start area (bases + training) and a 3200-stud
-- throwing lane split into 8 themed zones, with zone gates and distance markers.
-- Location: ServerScriptService > Server > WorldBuilder (ModuleScript)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local WorldBuilder = {}
local Terrain = workspace.Terrain
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local W = Config.MapHalfWidth

local folder
local rng = Random.new(1234)

---------------------------------------------------------------- primitives
local function mk(shape, size, cf, color, mat, collide, transp)
	local p = Instance.new("Part")
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = collide == true
	p.CanQuery = collide == true
	p.CanTouch = false
	p.Transparency = transp or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = folder
	return p
end
local function ball(pos, d, color, mat, collide, transp)
	return mk(Enum.PartType.Ball, Vector3.new(d, d, d), CFrame.new(pos), color, mat, collide, transp)
end
local function ellipse(cf, size, color, mat, collide, transp)
	local p = mk(Enum.PartType.Block, size, cf, color, mat, collide, transp)
	local m = Instance.new("SpecialMesh"); m.MeshType = Enum.MeshType.Sphere; m.Parent = p
	return p
end
local function vcyl(pos, height, d, color, mat, collide, transp)
	return mk(Enum.PartType.Cylinder, Vector3.new(height, d, d), CFrame.new(pos + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), color, mat, collide, transp)
end
local function block(cf, size, color, mat, collide, transp)
	return mk(Enum.PartType.Block, size, cf, color, mat, collide, transp)
end
local function light(p, color, range, brightness)
	local l = Instance.new("PointLight"); l.Color = color; l.Range = range; l.Brightness = brightness or 1.5; l.Parent = p
end
local function sparkles(p, color, rate, tex)
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = tex or SPARKLE
	pe.Color = ColorSequence.new(color)
	pe.LightEmission = 1
	pe.Rate = rate or 3
	pe.Lifetime = NumberRange.new(1.5, 3)
	pe.Speed = NumberRange.new(0.5, 1.5)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.4, 0.5), NumberSequenceKeypoint.new(1, 0) })
	pe.Parent = p
end
local function textLabel(parent, text, color, face)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face or Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(600, 120)
	sg.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = color or Color3.new(1, 1, 1)
	local st = Instance.new("UIStroke"); st.Thickness = 4; st.Color = Color3.fromRGB(30, 20, 40); st.Parent = t
	t.Parent = sg
	sg.Parent = parent
	return t
end

-- random spot inside a zone. sides=true keeps it off the landing lane.
local function spot(b, sides)
	local z = rng:NextNumber(b[1] + 8, b[2] - 8)
	local x
	if sides then
		x = rng:NextNumber(Config.LaneHalfWidth + 22, W - 4) * (rng:NextNumber() < 0.5 and -1 or 1)
	else
		x = rng:NextNumber(-W + 6, W - 6)
	end
	return Vector3.new(x, 0, z)
end
local function count(b, per100) return math.max(2, math.floor((b[2] - b[1]) / 100 * per100)) end

---------------------------------------------------------------- props
local Props = {}
function Props.tree(pos, s, leafCols)
	vcyl(pos, 7 * s, 1.6 * s, Color3.fromRGB(120, 80, 50), Enum.Material.Wood, true)
	for _ = 1, 4 do
		local off = Vector3.new(rng:NextNumber(-2, 2) * s, 7 * s + rng:NextNumber(0, 3) * s, rng:NextNumber(-2, 2) * s)
		ball(pos + off, rng:NextNumber(5, 7.5) * s, leafCols[rng:NextInteger(1, #leafCols)], Enum.Material.Grass)
	end
end
function Props.pine(pos, s, snowy)
	vcyl(pos, 3 * s, 1.2 * s, Color3.fromRGB(100, 70, 45), Enum.Material.Wood, true)
	for i = 0, 3 do
		local d = (8 - i * 1.8) * s
		local y = (3 + i * 2.6) * s
		ellipse(CFrame.new(pos + Vector3.new(0, y, 0)), Vector3.new(d, 3.6 * s, d), Color3.fromRGB(40, 110, 70), Enum.Material.Grass)
		if snowy then ellipse(CFrame.new(pos + Vector3.new(0, y + 0.9 * s, 0)), Vector3.new(d * 0.8, 1.6 * s, d * 0.8), Color3.new(1, 1, 1), Enum.Material.Snow) end
	end
end
function Props.flowers(pos, cols)
	for _ = 1, 6 do
		local p = pos + Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
		vcyl(p, 0.9, 0.15, Color3.fromRGB(70, 160, 60))
		ellipse(CFrame.new(p + Vector3.new(0, 1, 0)), Vector3.new(0.8, 0.35, 0.8), cols[rng:NextInteger(1, #cols)])
	end
end
function Props.mushroom(pos, s, cap, glow)
	vcyl(pos, 2 * s, 0.9 * s, Color3.fromRGB(245, 235, 220))
	local c = ellipse(CFrame.new(pos + Vector3.new(0, 2.1 * s, 0)), Vector3.new(3.2, 1.8, 3.2) * s, cap, glow and Enum.Material.Neon or Enum.Material.SmoothPlastic)
	if glow then light(c, cap, 12, 1) end
end
function Props.rock(pos, s, col, mat)
	ellipse(CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)),
		Vector3.new(rng:NextNumber(3, 6), rng:NextNumber(2, 4), rng:NextNumber(3, 6)) * s, col, mat or Enum.Material.Slate, true)
end
function Props.crystal(pos, s, col)
	for i = 1, rng:NextInteger(3, 5) do
		local h = rng:NextNumber(3, 8) * s
		local p = block(CFrame.new(pos + Vector3.new(rng:NextNumber(-1.5, 1.5), h / 2 - 0.5, rng:NextNumber(-1.5, 1.5)))
			* CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6), rng:NextNumber(-0.4, 0.4)),
			Vector3.new(1.2 * s, h, 1.2 * s), col, i % 2 == 0 and Enum.Material.Neon or Enum.Material.Glass, true, i % 2 == 0 and 0 or 0.2)
		if i == 1 then light(p, col, 14, 1.2) end
	end
end
function Props.lollipop(pos, s)
	vcyl(pos, 7 * s, 0.5 * s, Color3.new(1, 1, 1), nil, true)
	local col = Color3.fromHSV(rng:NextNumber(), 0.6, 1)
	local cf = CFrame.new(pos + Vector3.new(0, 8.5 * s, 0))
	mk(Enum.PartType.Cylinder, Vector3.new(0.8 * s, 5 * s, 5 * s), cf, col, nil, true)
	mk(Enum.PartType.Cylinder, Vector3.new(0.9 * s, 3.3 * s, 3.3 * s), cf, Color3.new(1, 1, 1))
	mk(Enum.PartType.Cylinder, Vector3.new(1 * s, 1.6 * s, 1.6 * s), cf, col)
end
function Props.gumdrop(pos, s)
	ellipse(CFrame.new(pos + Vector3.new(0, 1 * s, 0)), Vector3.new(3.5, 3.5, 3.5) * s, Color3.fromHSV(rng:NextNumber(), 0.55, 1), Enum.Material.Glass, true, 0.15)
end
function Props.candycane(pos, s)
	for i = 0, 5 do
		vcyl(pos + Vector3.new(0, i * 1.2 * s, 0), 1.2 * s, 0.8 * s, i % 2 == 0 and Color3.fromRGB(230, 40, 50) or Color3.new(1, 1, 1), nil, true)
	end
end
function Props.deadtree(pos, s, col)
	vcyl(pos, 8 * s, 1.2 * s, col, Enum.Material.Wood, true)
	for _ = 1, 4 do
		local y = rng:NextNumber(4, 8) * s
		block(CFrame.new(pos + Vector3.new(0, y, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0.8) * CFrame.new(0, 1.5 * s, 0), Vector3.new(0.5, 3.5, 0.5) * s, col, Enum.Material.Wood)
	end
end
function Props.cloud(pos, s, glow)
	for _ = 1, 5 do
		ball(pos + Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(0, 1.5), rng:NextNumber(-2, 2)) * s, rng:NextNumber(3, 5) * s,
			Color3.new(1, 1, 1), glow and Enum.Material.Neon or Enum.Material.SmoothPlastic, false, glow and 0.3 or 0)
	end
end
function Props.pillar(pos, s, col, mat)
	vcyl(pos, 14 * s, 2.4 * s, col, mat or Enum.Material.Marble, true)
	vcyl(pos + Vector3.new(0, 14 * s, 0), 1 * s, 3.4 * s, col, mat)
end
function Props.planet(pos, s)
	local col = Color3.fromHSV(rng:NextNumber(), 0.5, 0.9)
	ball(pos, 14 * s, col)
	mk(Enum.PartType.Cylinder, Vector3.new(0.3, 24 * s, 24 * s), CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2 + 0.4), col:Lerp(Color3.new(1, 1, 1), 0.5), Enum.Material.Neon, false, 0.5)
end
function Props.lamp(pos, col)
	vcyl(pos, 7, 0.4, Color3.fromRGB(40, 35, 50), Enum.Material.Metal, true)
	local b = ball(pos + Vector3.new(0, 7.3, 0), 1.4, col, Enum.Material.Neon)
	light(b, col, 18, 1.5)
end
function Props.snowman(pos)
	ball(pos + Vector3.new(0, 1.8, 0), 4, Color3.new(1, 1, 1), Enum.Material.Snow, true)
	ball(pos + Vector3.new(0, 4.6, 0), 3, Color3.new(1, 1, 1), Enum.Material.Snow, true)
	ball(pos + Vector3.new(0, 6.6, 0), 2.2, Color3.new(1, 1, 1), Enum.Material.Snow, true)
end
function Props.tower(pos, s, col, roof)
	vcyl(pos, 18 * s, 8 * s, col, Enum.Material.Ice, true, 0.1)
	for i = 0, 3 do
		ellipse(CFrame.new(pos + Vector3.new(0, 18 * s + i * 2.2 * s, 0)), Vector3.new(9 - i * 2.2, 3, 9 - i * 2.2) * s, roof, Enum.Material.Glass, false, 0.1)
	end
end
function Props.volcano(pos)
	for i = 0, 7 do
		vcyl(pos + Vector3.new(0, i * 7, 0), 7.2, 90 - i * 10, Color3.fromRGB(70 - i * 3, 45, 40), Enum.Material.Basalt, true)
	end
	local lava = vcyl(pos + Vector3.new(0, 56, 0), 1, 18, Color3.fromRGB(255, 110, 20), Enum.Material.Neon)
	light(lava, Color3.fromRGB(255, 120, 40), 60, 4)
	local f = Instance.new("Fire"); f.Size = 25; f.Heat = 25; f.Parent = lava
	sparkles(lava, Color3.fromRGB(80, 60, 60), 6, SMOKE)
end
function Props.lavapool(pos, s)
	local p = vcyl(pos - Vector3.new(0, 0.4, 0), 0.6, rng:NextNumber(10, 20) * s, Color3.fromRGB(255, 100, 20), Enum.Material.Neon)
	light(p, Color3.fromRGB(255, 120, 30), 20, 2)
end

---------------------------------------------------------------- zone themes (b = {fromZ, toZ}, m = zone middle)
local Themes = {}
Themes.Forest = function(b, m)
	local leaves = { Color3.fromRGB(80, 170, 70), Color3.fromRGB(110, 200, 80), Color3.fromRGB(60, 150, 75), Color3.fromRGB(150, 210, 90) }
	for _ = 1, count(b, 14) do Props.tree(spot(b, true), rng:NextNumber(0.9, 1.6), leaves) end
	for _ = 1, count(b, 12) do Props.flowers(spot(b), { Color3.fromRGB(255, 120, 170), Color3.fromRGB(255, 240, 120), Color3.fromRGB(170, 140, 255), Color3.new(1, 1, 1) }) end
	for _ = 1, count(b, 5) do Props.mushroom(spot(b, true), rng:NextNumber(0.8, 1.6), Color3.fromRGB(230, 60, 60)) end
end
Themes.Volcano = function(b, m)
	Props.volcano(Vector3.new(-150, 0, m.Z))
	for _ = 1, count(b, 5) do Props.lavapool(spot(b), 1) end
	for _ = 1, count(b, 12) do Props.rock(spot(b, true), rng:NextNumber(0.8, 2), Color3.fromRGB(45, 35, 35), Enum.Material.Basalt) end
	for _ = 1, count(b, 5) do Props.deadtree(spot(b, true), rng:NextNumber(0.8, 1.3), Color3.fromRGB(40, 30, 30)) end
	for _ = 1, count(b, 4) do Props.crystal(spot(b, true), 0.8, Color3.fromRGB(255, 120, 40)) end
end
Themes.Frozen = function(b, m)
	for _ = 1, count(b, 12) do Props.pine(spot(b, true), rng:NextNumber(0.9, 1.6), true) end
	for _ = 1, count(b, 6) do Props.crystal(spot(b, true), 1.2, Color3.fromRGB(170, 230, 255)) end
	for _ = 1, count(b, 2) do Props.snowman(spot(b)) end
	for i = -1, 1 do Props.tower(Vector3.new(58, 0, m.Z + i * 40), i == 0 and 1.3 or 0.9, Color3.fromRGB(190, 230, 255), Color3.fromRGB(120, 190, 255)) end
end
Themes.Crystal = function(b, m)
	local cols = { Color3.fromRGB(190, 90, 255), Color3.fromRGB(80, 230, 255), Color3.fromRGB(255, 100, 210), Color3.fromRGB(120, 255, 180) }
	for _ = 1, count(b, 16) do Props.crystal(spot(b, true), rng:NextNumber(0.8, 2.2), cols[rng:NextInteger(1, #cols)]) end
	for _ = 1, count(b, 5) do Props.mushroom(spot(b), rng:NextNumber(0.8, 1.4), cols[rng:NextInteger(1, #cols)], true) end
end
Themes.Candy = function(b, m)
	for _ = 1, count(b, 8) do Props.lollipop(spot(b, true), rng:NextNumber(0.8, 1.5)) end
	for _ = 1, count(b, 8) do Props.gumdrop(spot(b), rng:NextNumber(0.7, 1.6)) end
	for _ = 1, count(b, 6) do Props.candycane(spot(b, true), rng:NextNumber(0.8, 1.4)) end
	block(CFrame.new(52, -0.3, m.Z), Vector3.new(12, 0.8, b[2] - b[1]), Color3.fromRGB(110, 60, 35), Enum.Material.Sand)
	for _ = 1, count(b, 4) do Props.cloud(spot(b) + Vector3.new(0, 45, 0), 1.6) end
end
Themes.Space = function(b, m)
	for _ = 1, count(b, 3) do Props.planet(spot(b) + Vector3.new(0, rng:NextNumber(60, 120), 0), rng:NextNumber(1, 2.5)) end
	for _ = 1, count(b, 25) do ball(spot(b) + Vector3.new(0, rng:NextNumber(30, 160), 0), rng:NextNumber(0.4, 1.2), Color3.new(1, 1, 0.9), Enum.Material.Neon) end
	for _ = 1, count(b, 6) do Props.crystal(spot(b, true), 1, Color3.fromRGB(120, 255, 200)) end
	for _ = 1, count(b, 8) do Props.rock(spot(b, true), rng:NextNumber(1, 2), Color3.fromRGB(90, 95, 130), Enum.Material.Limestone) end
end
Themes.Shadow = function(b, m)
	for _ = 1, count(b, 8) do Props.deadtree(spot(b, true), rng:NextNumber(1, 1.8), Color3.fromRGB(35, 25, 45)) end
	for _ = 1, count(b, 5) do Props.crystal(spot(b, true) + Vector3.new(0, rng:NextNumber(0, 18), 0), 1.2, Color3.fromRGB(150, 40, 255)) end
	for _ = 1, count(b, 5) do Props.lamp(spot(b, true), Color3.fromRGB(190, 80, 255)) end
	for _ = 1, count(b, 3) do Props.pillar(spot(b, true), rng:NextNumber(0.6, 1.2), Color3.fromRGB(50, 40, 60), Enum.Material.Slate) end
end
Themes.Heaven = function(b, m)
	for _ = 1, count(b, 8) do Props.cloud(spot(b) + Vector3.new(0, rng:NextNumber(0, 3), 0), rng:NextNumber(1, 2)) end
	for _ = 1, count(b, 4) do Props.cloud(spot(b) + Vector3.new(0, rng:NextNumber(30, 80), 0), rng:NextNumber(2, 4), true) end
	for _ = 1, count(b, 4) do Props.pillar(spot(b, true), rng:NextNumber(0.8, 1.6), Color3.fromRGB(255, 225, 140), Enum.Material.Marble) end
	-- giant rainbow arch over the lane
	for i = 0, 24 do
		local a = i / 24 * math.pi
		ball(Vector3.new(math.cos(a) * (W + 10), math.sin(a) * 70, m.Z), 10, Color3.fromHSV(i / 24, 0.6, 1), Enum.Material.Neon, false, 0.2)
	end
end

---------------------------------------------------------------- scenery: mountains, rivers, islands, lane edges
local ROCK_COLORS = {
	Forest = Color3.fromRGB(120, 125, 115), Volcano = Color3.fromRGB(55, 40, 40), Frozen = Color3.fromRGB(170, 200, 230), Crystal = Color3.fromRGB(70, 55, 110),
	Candy = Color3.fromRGB(255, 200, 225), Space = Color3.fromRGB(80, 80, 130), Shadow = Color3.fromRGB(35, 25, 50), Heaven = Color3.fromRGB(255, 245, 225),
}
-- big hills on both sides of the map turn it into a valley/canyon
local function mountains(z1, z2, zoneId, halfWidth)
	local Wd = Config.Worlds[zoneId]
	local hw = halfWidth or W
	local z = z1
	while z < z2 do
		for s = -1, 1, 2 do
			-- inner edge of every hill stays at the wall, so the valley floor stays clear
			local r = rng:NextNumber(32, 58)
			local c = Vector3.new(s * (hw + r * 0.85 + rng:NextNumber(0, 18)), rng:NextNumber(-18, 6), z + rng:NextNumber(-10, 10))
			Terrain:FillBall(c, r, zoneId == "Forest" and Enum.Material.Rock or Wd.material)
			Terrain:FillBall(c + Vector3.new(0, r * 0.45, 0), r * 0.7, Wd.material)
		end
		z += rng:NextNumber(35, 55)
	end
end

local function river(z1, z2, mat)
	for s = -1, 1, 2 do
		local x = s * (Config.LaneHalfWidth + 14)
		Terrain:FillBlock(CFrame.new(x, -2, (z1 + z2) / 2), Vector3.new(10, 6, z2 - z1), Enum.Material.Air)
		Terrain:FillBlock(CFrame.new(x, -3, (z1 + z2) / 2), Vector3.new(10, 4, z2 - z1), mat or Enum.Material.Water)
	end
end

local function floatingIsland(pos, s, topCol, topMat, waterfall)
	ellipse(CFrame.new(pos), Vector3.new(26, 14, 22) * s, Color3.fromRGB(110, 85, 70), Enum.Material.Slate)
	ellipse(CFrame.new(pos + Vector3.new(0, -9, 0) * s), Vector3.new(14, 12, 12) * s, Color3.fromRGB(95, 75, 60), Enum.Material.Slate)
	ellipse(CFrame.new(pos + Vector3.new(0, 6, 0) * s), Vector3.new(27, 3, 23) * s, topCol, topMat or Enum.Material.Grass)
	Props.tree(pos + Vector3.new(-3, 7, 2) * s, 0.9 * s, { topCol:Lerp(Color3.new(0, 0, 0), 0.15), topCol })
	if waterfall then
		local fall = block(CFrame.new(pos + Vector3.new(11, -20, 0) * s), Vector3.new(4, 52, 2) * s, Color3.fromRGB(150, 220, 255), Enum.Material.Neon, false, 0.45)
		sparkles(fall, Color3.fromRGB(220, 245, 255), 12)
	end
end

local function laneEdges(z1, z2, col)
	for s = -1, 1, 2 do
		local strip = block(CFrame.new(s * Config.LaneHalfWidth, 0.25, (z1 + z2) / 2), Vector3.new(1.2, 0.5, z2 - z1), col, Enum.Material.Neon, false, 0.1)
		strip.Name = "LaneEdge"
	end
	-- glowing lanterns every 100 studs
	for z = z1 + 25, z2 - 10, 100 do
		for s = -1, 1, 2 do
			local x = s * (Config.LaneHalfWidth + 4)
			vcyl(Vector3.new(x, 0, z), 9, 0.6, Color3.fromRGB(50, 45, 60), Enum.Material.Metal)
			local orb = ball(Vector3.new(x, 9.6, z), 2.2, col, Enum.Material.Neon)
			light(orb, col, 26, 1.6)
		end
	end
end

-- THE PORTAL LAUNCH HALL: a building you walk into. Its front is open onto the lane
-- (sealed by a force field), and its floor is the only place you can throw from.
local function launchHall()
	local hw, back, front = Config.HallHalfWidth, Config.HallBackZ, Config.BarrierZ
	local depth = front - back
	local midZ = (front + back) / 2
	local H = 26
	local wallCol, trim = Color3.fromRGB(90, 60, 160), Color3.fromRGB(255, 120, 220)
	-- floor
	block(CFrame.new(0, 0.6, midZ), Vector3.new(hw * 2, 1.2, depth), Color3.fromRGB(235, 235, 245), Enum.Material.Marble, true)
	local pad = block(CFrame.new(0, 1.25, (Config.ThrowZone.minZ + Config.ThrowZone.maxZ) / 2), Vector3.new(hw * 2 - 4, 0.15, Config.ThrowZone.maxZ - Config.ThrowZone.minZ - 2),
		Color3.fromRGB(255, 120, 200), Enum.Material.Neon, false, 0.8)
	pad.Name = "ThrowZonePad"
	-- arrow on the floor pointing at the lane
	for i = 0, 2 do
		local a = block(CFrame.new(0, 1.35, -22 + i * 7) * CFrame.Angles(0, math.rad(45), 0), Vector3.new(5, 0.2, 5), Color3.fromRGB(255, 230, 100), Enum.Material.Neon, false, 0.2)
		a.Name = "Arrow"
	end
	-- side walls with neon trims and windows
	for s = -1, 1, 2 do
		block(CFrame.new(s * (hw + 1), H / 2, midZ), Vector3.new(2, H, depth), wallCol, Enum.Material.Brick, true)
		block(CFrame.new(s * hw, 2.4, midZ), Vector3.new(0.4, 0.6, depth), trim, Enum.Material.Neon, false)
		block(CFrame.new(s * hw, H - 2, midZ), Vector3.new(0.4, 0.6, depth), trim, Enum.Material.Neon, false)
		local screen = block(CFrame.new(s * (hw - 0.2), 13, midZ - 4), Vector3.new(0.3, 7, 22), Color3.fromRGB(20, 15, 40), Enum.Material.SmoothPlastic, false)
		textLabel(screen, "HOLD TO CHARGE  •  RELEASE TO THROW", Color3.fromRGB(255, 230, 120), s < 0 and Enum.NormalId.Right or Enum.NormalId.Left)
		for k = 0, 2 do
			local lamp = ball(Vector3.new(s * (hw - 1.5), 19, back + 8 + k * 12), 2.2, Color3.fromRGB(255, 200, 120), Enum.Material.Neon)
			light(lamp, Color3.fromRGB(255, 200, 140), 22, 1.4)
		end
	end
	-- back wall with a big doorway (you enter from the street)
	local door = 18
	for s = -1, 1, 2 do
		local wseg = (hw * 2 + 4 - door) / 2
		block(CFrame.new(s * (door / 2 + wseg / 2), H / 2, back - 1), Vector3.new(wseg, H, 2), wallCol, Enum.Material.Brick, true)
	end
	block(CFrame.new(0, H - 4, back - 1), Vector3.new(door, 8, 2), wallCol, Enum.Material.Brick, true)
	for s = -1, 1, 2 do
		vcyl(Vector3.new(s * (door / 2 + 1), 0, back - 2), H - 7, 2.2, trim, Enum.Material.Neon, true)
	end
	local sign = block(CFrame.new(0, H + 3, back - 2.2), Vector3.new(hw * 2 + 4, 6, 1), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, false)
	textLabel(sign, "🌀 PORTAL LAUNCH HALL 🌀", Color3.fromRGB(140, 60, 220), Enum.NormalId.Back)
	textLabel(sign, "🌀 PORTAL LAUNCH HALL 🌀", Color3.fromRGB(140, 60, 220), Enum.NormalId.Front)
	-- roof (no collision so the camera passes through it), covering the back half
	local roof = block(CFrame.new(0, H + 0.5, back + 10), Vector3.new(hw * 2 + 6, 1, 22), Color3.fromRGB(60, 40, 110), Enum.Material.SmoothPlastic, false)
	roof.CanQuery = false
	-- front arch framing the lane
	for i = 0, 20 do
		local a = i / 20 * math.pi
		ball(Vector3.new(math.cos(a) * (hw + 1), 4 + math.sin(a) * (H - 4), front + 1), 3, Color3.fromHSV(i / 20, 0.5, 1), Enum.Material.Neon, false)
	end
	-- the force field you can't walk through
	local wall = block(CFrame.new(0, 60, front), Vector3.new(Config.StartHalfWidth * 2 + 40, 140, 2), Color3.fromRGB(150, 110, 255), Enum.Material.ForceField, true, 0.35)
	wall.Name = "Barrier"
	wall.CanQuery = false
	local glow = block(CFrame.new(0, 1.4, front), Vector3.new(hw * 2, 0.4, 2.4), Color3.fromRGB(190, 140, 255), Enum.Material.Neon, false)
	glow.Name = "BarrierGlow"
	-- low hedge walls closing the rest of the start area's front edge
	for s = -1, 1, 2 do
		local len = Config.StartHalfWidth - hw - 2
		ellipse(CFrame.new(s * (hw + 2 + len / 2), 3, front - 1), Vector3.new(len, 6, 5), Color3.fromRGB(70, 150, 70), Enum.Material.Grass, true)
	end
end

local function fountain(pos, s)
	s = s or 1
	vcyl(pos, 2, 20 * s, Color3.fromRGB(230, 230, 240), Enum.Material.Marble, true)
	vcyl(pos + Vector3.new(0, 1.9, 0), 0.3, 18 * s, Color3.fromRGB(90, 200, 255), Enum.Material.Glass, false, 0.25)
	vcyl(pos, 7 * s, 3 * s, Color3.fromRGB(230, 230, 240), Enum.Material.Marble, true)
	vcyl(pos + Vector3.new(0, 7 * s, 0), 1, 9 * s, Color3.fromRGB(230, 230, 240), Enum.Material.Marble, true)
	local orb = ball(pos + Vector3.new(0, 11 * s, 0), 4.5 * s, Color3.fromRGB(170, 120, 255), Enum.Material.Neon)
	light(orb, Color3.fromRGB(170, 120, 255), 35, 2.5)
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = SPARKLE
	pe.Color = ColorSequence.new(Color3.fromRGB(150, 220, 255), Color3.fromRGB(220, 170, 255))
	pe.Rate = 50; pe.Speed = NumberRange.new(10, 15); pe.SpreadAngle = Vector2.new(25, 25)
	pe.Acceleration = Vector3.new(0, -25, 0); pe.Lifetime = NumberRange.new(1, 1.5); pe.LightEmission = 1
	pe.Size = NumberSequence.new(0.7, 0.2)
	pe.Parent = orb
end

---------------------------------------------------------------- gates + markers
local function zoneGate(id, z)
	local Wd = Config.Worlds[id]
	local col = Wd.atmo
	for s = -1, 1, 2 do
		vcyl(Vector3.new(s * (Config.LaneHalfWidth + 12), 0, z), 34, 6, col:Lerp(Color3.new(1, 1, 1), 0.3), Enum.Material.Marble, true)
		local orb = ball(Vector3.new(s * (Config.LaneHalfWidth + 12), 37, z), 7, col, Enum.Material.Neon)
		light(orb, col, 30, 2)
	end
	-- giant glowing ring framing the lane
	for i = 1, 36 do
		local a = i / 36 * math.pi * 2
		local p = Vector3.new(math.cos(a) * (Config.LaneHalfWidth + 12), 38 + math.sin(a) * 30, z)
		if p.Y > 1 then ball(p, 5, i % 2 == 0 and col or col:Lerp(Color3.new(1, 1, 1), 0.5), Enum.Material.Neon, false, 0.1) end
	end
	local beam = block(CFrame.new(0, 32, z), Vector3.new(Config.LaneHalfWidth * 2 + 30, 7, 2), col:Lerp(Color3.new(0, 0, 0), 0.2), Enum.Material.SmoothPlastic, false)
	local b = Config.ZoneBounds[id]
	local txt = Wd.name:upper() .. "  •  " .. b[1] .. "m"
	textLabel(beam, txt, Color3.new(1, 1, 1), Enum.NormalId.Front)
	textLabel(beam, txt, Color3.new(1, 1, 1), Enum.NormalId.Back)
end

local function distanceMarker(z)
	local line = block(CFrame.new(0, 0.12, z), Vector3.new(Config.LaneHalfWidth * 2, 0.2, 0.8), Color3.new(1, 1, 1), Enum.Material.Neon, false, 0.55)
	line.Name = "Marker"
	for s = -1, 1, 2 do
		local post = block(CFrame.new(s * (Config.LaneHalfWidth + 4), 3, z), Vector3.new(0.6, 6, 0.6), Color3.fromRGB(250, 250, 250), Enum.Material.SmoothPlastic, false)
		local sign = block(CFrame.new(s * (Config.LaneHalfWidth + 4), 7, z), Vector3.new(7, 2.6, 0.4), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, false)
		textLabel(sign, z .. "m", Color3.fromRGB(80, 60, 140), Enum.NormalId.Back)
		textLabel(sign, z .. "m", Color3.fromRGB(80, 60, 140), Enum.NormalId.Front)
	end
end

---------------------------------------------------------------- start area + training
local function buildStart()
	local depth = Config.StartDepth
	local SW = Config.StartHalfWidth
	Terrain:FillBlock(CFrame.new(0, -6, -depth / 2 - 10), Vector3.new(SW * 2 + 80, 12, depth + 30), Enum.Material.Grass)
	launchHall()
	mountains(-depth - 30, 0, "Forest", SW)
	-- main street from the hall back to the training area, bases on both sides
	local streetLen = depth - 40
	block(CFrame.new(0, 0.15, Config.HallBackZ - streetLen / 2), Vector3.new(50, 0.3, streetLen), Color3.fromRGB(190, 180, 165), Enum.Material.Cobblestone, true)
	for s = -1, 1, 2 do
		block(CFrame.new(s * 25.5, 0.35, Config.HallBackZ - streetLen / 2), Vector3.new(1, 0.4, streetLen), Color3.fromRGB(255, 220, 120), Enum.Material.Neon, false, 0.3)
	end
	for z = -60, -350, -38 do
		for s = -1, 1, 2 do Props.lamp(Vector3.new(s * 24.5, 0, z), Color3.fromRGB(255, 210, 140)) end
	end
	fountain(Vector3.new(0, 0, -330), 1)
	for i = 1, 4 do
		floatingIsland(Vector3.new((i % 2 == 0 and 1 or -1) * rng:NextNumber(70, 120), rng:NextNumber(65, 95), -depth + i * 100), rng:NextNumber(0.8, 1.2),
			Color3.fromRGB(120, 210, 90), Enum.Material.Grass, i % 2 == 1)
	end
	-- trees around the back of the start area
	local leaves = { Color3.fromRGB(80, 170, 70), Color3.fromRGB(110, 200, 80), Color3.fromRGB(150, 210, 90) }
	for _ = 1, 22 do
		local x = rng:NextNumber(-SW + 6, SW - 6)
		local z = rng:NextNumber(-depth + 8, -depth + 35)
		Props.tree(Vector3.new(x, 0, z), rng:NextNumber(1, 1.5), leaves)
	end
	-- spawn on the street, just behind the hall
	local spawn = Instance.new("SpawnLocation")
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.6, -60)
	spawn.Anchored = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = workspace
end

local function buildTraining()
	local tf = Instance.new("Folder")
	tf.Name = "Training"
	tf.Parent = workspace
	local prev = folder
	for i, st in ipairs(Config.TrainingStations) do
		local m = Instance.new("Model")
		m.Name = "Station" .. i
		m.Parent = tf
		folder = m
		local p = st.pos
		local pad = vcyl(p, 0.8, 14, st.color:Lerp(Color3.new(1, 1, 1), 0.6), Enum.Material.SmoothPlastic, true)
		pad.Name = "Pad"
		local ring = mk(Enum.PartType.Cylinder, Vector3.new(0.3, 15, 15), CFrame.new(p + Vector3.new(0, 0.7, 0)) * CFrame.Angles(0, 0, math.pi / 2), st.color, Enum.Material.Neon)
		-- the equipment
		local barY = 3.2
		if i == 3 then
			ellipse(CFrame.new(p + Vector3.new(0, 2.6, 0)), Vector3.new(4, 4, 4), st.color, Enum.Material.Metal, true)
			mk(Enum.PartType.Cylinder, Vector3.new(0.6, 3, 3), CFrame.new(p + Vector3.new(0, 5, 0)), st.color, Enum.Material.Metal)
		elseif i == 5 then
			for k = 1, 3 do
				mk(Enum.PartType.Cylinder, Vector3.new(0.5, 8 + k * 2, 8 + k * 2), CFrame.new(p + Vector3.new(0, 6, 0)) * CFrame.Angles(k * 0.9, k * 0.5, 0), st.color, Enum.Material.Neon, false, 0.2)
			end
			local core = ball(p + Vector3.new(0, 6, 0), 3, Color3.new(1, 1, 1), Enum.Material.Neon)
			light(core, st.color, 25, 3)
			sparkles(core, st.color, 8)
		else
			mk(Enum.PartType.Cylinder, Vector3.new(9, 0.6, 0.6), CFrame.new(p + Vector3.new(0, barY, 0)), Color3.fromRGB(80, 80, 90), Enum.Material.Metal)
			for s = -1, 1, 2 do
				mk(Enum.PartType.Cylinder, Vector3.new(0.9, 3.4, 3.4), CFrame.new(p + Vector3.new(s * 3.6, barY, 0)), st.color, i == 4 and Enum.Material.Neon or Enum.Material.Metal)
				block(CFrame.new(p + Vector3.new(s * 2.6, barY / 2 + 0.5, 0)), Vector3.new(0.5, barY, 0.5), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
			end
		end
		-- sign
		local anchor = block(CFrame.new(p + Vector3.new(0, 10, 0)), Vector3.new(0.2, 0.2, 0.2), Color3.new(1, 1, 1), nil, false, 1)
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromScale(14, 4)
		bb.MaxDistance = 120
		bb.LightInfluence = 0
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Font = Enum.Font.FredokaOne
		t.TextScaled = true
		t.RichText = true
		t.TextColor3 = Color3.new(1, 1, 1)
		local price = st.price > 0 and ("\n<font color='#FFD36B'>Buy for $" .. (st.price >= 1000000 and (st.price / 1000000 .. "M") or (st.price >= 1000 and (st.price / 1000 .. "K") or tostring(st.price))) .. "</font>") or "\n<font color='#FFD36B'>FREE</font>"
		t.Text = string.format("%s\n<font color='#9CFFA8'>+%d Strength/lift</font>%s", st.name, st.gain, price)
		local stroke = Instance.new("UIStroke"); stroke.Thickness = 3; stroke.Parent = t
		t.Parent = bb
		bb.Parent = anchor
		m:SetAttribute("Index", i)
	end
	folder = prev
	-- training area sign
	local sign = block(CFrame.new(0, 17, -86), Vector3.new(44, 7, 1.5), Color3.fromRGB(255, 140, 60), Enum.Material.SmoothPlastic, false)
	textLabel(sign, "💪 TRAINING AREA 💪", Color3.new(1, 1, 1), Enum.NormalId.Front)
	textLabel(sign, "💪 TRAINING AREA 💪", Color3.new(1, 1, 1), Enum.NormalId.Back)
end

---------------------------------------------------------------- build
function WorldBuilder.BuildAll()
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace
	-- animated grass blades, prettier water
	pcall(function() Terrain.Decoration = true end)
	Terrain.WaterColor = Color3.fromRGB(40, 190, 230)
	Terrain.WaterTransparency = 0.6
	Terrain.WaterWaveSize = 0.25
	Terrain.WaterWaveSpeed = 12
	Terrain.WaterReflectance = 0.6
	Terrain:SetMaterialColor(Enum.Material.Glacier, Color3.fromRGB(150, 220, 255))
	Terrain:SetMaterialColor(Enum.Material.CrackedLava, Color3.fromRGB(255, 110, 30))
	Terrain:SetMaterialColor(Enum.Material.Rock, ROCK_COLORS.Forest)
	folder = Instance.new("Folder"); folder.Name = "Start"; folder.Parent = map
	buildStart()
	-- (training now happens in each player's personal gym inside their base)
	for _, id in ipairs(Config.WorldOrder) do
		local Wd = Config.Worlds[id]
		local b = Config.ZoneBounds[id]
		local m = Config.WorldCenter(id)
		folder = Instance.new("Folder"); folder.Name = id; folder.Parent = map
		Terrain:SetMaterialColor(Wd.material, Wd.groundColor)
		Terrain:FillBlock(CFrame.new(0, -6, m.Z), Vector3.new(W * 2 + 120, 12, b[2] - b[1] + 4), Wd.material)
		zoneGate(id, b[1] + 2)
		mountains(b[1], b[2], id)
		laneEdges(b[1], b[2], Wd.atmo)
		if id == "Forest" or id == "Crystal" or id == "Heaven" then river(b[1], b[2], Enum.Material.Water)
		elseif id == "Frozen" then river(b[1], b[2], Enum.Material.Glacier)
		elseif id == "Volcano" then river(b[1], b[2], Enum.Material.CrackedLava) end
		for _ = 1, math.max(2, math.floor((b[2] - b[1]) / 150)) do
			local isl = Vector3.new(rng:NextNumber(-95, 95), rng:NextNumber(60, 110), rng:NextNumber(b[1], b[2]))
			floatingIsland(isl, rng:NextNumber(0.8, 1.6), Wd.groundColor, Wd.material == Enum.Material.Grass and Enum.Material.Grass or Enum.Material.SmoothPlastic, rng:NextNumber() < 0.6)
		end
		local ok, err = pcall(Themes[id], b, m)
		if not ok then warn("[WorldBuilder] theme failed", id, err) end
		task.wait()
	end
	folder = Instance.new("Folder"); folder.Name = "Markers"; folder.Parent = map
	for z = 50, Config.LaneLength - 50, 50 do distanceMarker(z) end
	-- invisible walls around the whole map
	local SW = Config.StartHalfWidth
	for s = -1, 1, 2 do
		-- lane walls
		block(CFrame.new(s * (W + 4), 80, Config.LaneLength / 2), Vector3.new(4, 200, Config.LaneLength + 20), Color3.new(1, 1, 1), nil, true, 1).Name = "Boundary"
		-- start-area walls
		block(CFrame.new(s * (SW + 4), 80, -Config.StartDepth / 2), Vector3.new(4, 200, Config.StartDepth + 20), Color3.new(1, 1, 1), nil, true, 1).Name = "Boundary"
	end
	block(CFrame.new(0, 80, Config.LaneLength + 10), Vector3.new(W * 2 + 20, 200, 4), Color3.new(1, 1, 1), nil, true, 1).Name = "Boundary"
	block(CFrame.new(0, 80, -Config.StartDepth - 6), Vector3.new(SW * 2 + 20, 200, 4), Color3.new(1, 1, 1), nil, true, 1).Name = "Boundary"
end

return WorldBuilder
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX30"><Properties><string name="Name">StarterPlayer</string></Properties>
<Item class="StarterPlayerScripts" referent="RBX18"><Properties><string name="Name">StarterPlayerScripts</string></Properties>
<Item class="Folder" referent="RBX19"><Properties><string name="Name">Client</string></Properties>
<Item class="LocalScript" referent="RBX20"><Properties><string name="Name">ClientMain</string><ProtectedString name="Source"><![CDATA[-- ClientMain: wires all client modules together.
-- Location: StarterPlayer > StarterPlayerScripts > Client > ClientMain (LocalScript)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CreatureData = require(Shared.CreatureData)
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Client = script.Parent
local State = require(Client.ClientState)
local Effects = require(Client.Effects)
local Sounds = require(Client.Sounds)
local Renderer = require(Client.CreatureRenderer)
local TC = require(Client.ThrowController)
local HUD = require(Client.HUD)
local Panels = require(Client.Panels)

local player = Players.LocalPlayer
local Remotes = State.Remotes

Effects.SetupLighting()
Renderer.Start()
Panels.Init()
HUD.TC = TC
TC.OnThrowResult = HUD.ThrowFeedback
HUD.Refresh()

-- ask the server for a full data sync (retries until our save has loaded)
task.spawn(function()
	while not State.Loaded do
		State.Request("Sync")
		task.wait(1.5)
	end
end)

---------------------------------------------------------------- collecting wild creatures
local collecting = {}
Renderer.OnCollectRequest = function(throwId)
	if collecting[throwId] then return end
	collecting[throwId] = true
	local ok, msg = State.Request("Collect", throwId)
	collecting[throwId] = nil
	if not ok then HUD.Notify(msg or "Can't collect", "error") end
end

HUD.OnCollect = Renderer.OnCollectRequest

---------------------------------------------------------------- the limit: barrier + "throw from here"
local function barrierPulse(pos)
	local map = workspace:FindFirstChild("Map")
	local wall = map and map:FindFirstChild("Start") and map.Start:FindFirstChild("Barrier")
	if wall then
		wall.Transparency = 0.02
		Effects.Tween(wall, 0.8, { Transparency = 0.35 })
	end
	if pos then
		Effects.Shockwave(Vector3.new(pos.X, 1, Config.BarrierZ - 1), Color3.fromRGB(190, 140, 255), 10, 0.5)
		Effects.Burst(Vector3.new(pos.X, pos.Y, Config.BarrierZ - 1), Color3.fromRGB(200, 160, 255), 20, 10, 0.7)
	end
end
TC.OnNotInZone = function()
	HUD.ShowThrowHere("🎯 GO TO THE THROW LINE!", nil)
end
local lastBarrierFx = 0

TC.OnBusy = function()
	HUD.ShowThrowHere("⏳ ONE PORTAL AT A TIME", "Wait until your creature is caught!")
end

---------------------------------------------------------------- training: buy equipment + lifting animation
HUD.OnUpgradeGym = function()
	local ok, msg = State.Request("UpgradeEquipment")
	if ok then
		local st = Config.TrainingStations[math.clamp(State.Data.EquipLevel or 1, 1, #Config.TrainingStations)]
		Sounds.Play("Upgrade")
		task.delay(0.15, Sounds.Play, "Rare", 1.3)
		HUD.Notify(msg or "Gym upgraded!", "success")
		Effects.Coins(nil, 12)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			Effects.Burst(root.Position + Vector3.new(0, 2, 0), st.color, 50, 18, 1)
			Effects.Shockwave(root.Position - Vector3.new(0, 2.5, 0), st.color, 12, 0.5)
		end
		HUD._shownGym = nil -- refresh the buttons
	else
		HUD.Notify(msg or "Can't upgrade", "error")
	end
end

-- Lifting uses Roblox's built-in "cheer" animation (both arms raise the weight overhead).
-- It plays on your own character, so other players see it too.
local LIFT_ANIM = { [Enum.HumanoidRigType.R15] = "rbxassetid://507770677", [Enum.HumanoidRigType.R6] = "rbxassetid://129423030" }
local liftTrack, liftHum, lastLift = nil, nil, 0
local function playLift()
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	if hum ~= liftHum then
		liftHum = hum
		liftTrack = nil
		local animator = hum:FindFirstChildOfClass("Animator") or hum
		local anim = Instance.new("Animation")
		anim.AnimationId = LIFT_ANIM[hum.RigType] or LIFT_ANIM[Enum.HumanoidRigType.R15]
		local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
		if ok and track then
			track.Priority = Enum.AnimationPriority.Action
			track.Looped = true
			liftTrack = track
		end
	end
	lastLift = os.clock()
	if liftTrack and not liftTrack.IsPlaying then liftTrack:Play(0.15, 1, 1.7) end
end
RunService.Heartbeat:Connect(function()
	if liftTrack and liftTrack.IsPlaying and os.clock() - lastLift > 0.7 then liftTrack:Stop(0.25) end
end)

local lastRep = 0
local function doRep()
	local idx = HUD.TrainStation
	if not idx or os.clock() - lastRep < Config.TrainCooldown then return end
	lastRep = os.clock()
	local st = Config.TrainingStations[idx]
	playLift()
	HUD.TrainPulse()
	task.spawn(function()
		local ok, msg = State.Request("Train", idx)
		if ok then
			Sounds.Play("Collect", 1.4 + math.random() * 0.2)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root then
				Effects.FloatingText(root.Position + Vector3.new(math.random(-2, 2), 4, 0), "+" .. Format.Short(st.gain) .. " 💪", Color3.fromRGB(255, 150, 120), 0.8)
			end
		elseif msg then
			HUD.Notify(msg, "error")
		end
	end)
end
RunService.Heartbeat:Connect(function()
	if HUD.TrainStation and (HUD.TrainHeld or HUD.AutoTrain) then doRep() end
end)
game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.E and HUD.TrainStation then doRep() end
end)

---------------------------------------------------------------- server messages
Remotes.Notify.OnClientEvent:Connect(function(text, kind)
	if kind == "throwzone" then
		HUD.ShowThrowHere("🎯 GO TO THE THROW LINE!", nil)
		return
	end
	HUD.Notify(text, kind)
	if kind == "discover" then Sounds.Play("Rare", 1.3) end
end)

Remotes.MoneyFx.OnClientEvent:Connect(function(amount, padPos)
	Sounds.Play("Money")
	task.delay(0.15, Sounds.Play, "Money", 1.25)
	Effects.Coins(padPos, math.clamp(math.floor(math.log10(amount + 1) * 4), 6, 22))
	Effects.FloatingText(padPos + Vector3.new(0, 4, 0), "+" .. Format.Money(amount), Color3.fromRGB(130, 255, 130), 1.3)
	Effects.Burst(padPos + Vector3.new(0, 1, 0), Color3.fromRGB(255, 215, 70), 30, 14, 0.8)
end)

-- "CAUGHT!" card: pops up with the spinning creature, then flies into the Pets button
local K = require(Client.UIKit)
local function caughtCard(id)
	local def = CreatureData.ById[id]
	if not def then return end
	local rc = Config.Rarities[def.rarity]
	local cfg = Renderer.CatchConfig[def.rarity] or Renderer.CatchConfig.Common
	local bad = rc.order <= 1
	local W, H = 300, 340
	local cardCol = bad and Color3.fromRGB(170, 170, 180) or rc.color:Lerp(Color3.new(1, 1, 1), 0.25)
	local card = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.58), Size = UDim2.fromOffset(W, H),
		BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 30, Parent = HUD.Root },
		{ K.corner(26), K.stroke(rc.order >= 5 and 7 or 5, rc.order >= 5 and Color3.fromRGB(255, 220, 90) or nil), K.grad(Color3.new(1, 1, 1), cardCol, 90) })
	local sc = K.new("UIScale", { Scale = 0, Parent = card })
	local targetScale = 0.7 + cfg.size * 0.28 -- tiny for bad pets, big for great ones
	-- spinning glow behind the creature (two layers for Legendary+)
	local glow = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 150), Size = UDim2.fromOffset(190, 190),
		BackgroundColor3 = bad and Color3.fromRGB(140, 140, 150) or rc.color, BackgroundTransparency = 0.35, ZIndex = 30, Parent = card }, { K.corner(30) })
	local glow2 = rc.order >= 5 and K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 150), Size = UDim2.fromOffset(230, 230),
		BackgroundColor3 = Color3.fromRGB(255, 230, 120), BackgroundTransparency = 0.6, ZIndex = 30, Parent = card }, { K.corner(40) }) or nil
	K.label(cfg.text, UDim2.new(1, -20, 0, 46), bad and Color3.fromRGB(220, 220, 220) or Color3.fromRGB(255, 230, 90), { Position = UDim2.fromOffset(10, 8), ZIndex = 32, Parent = card })
	-- confetti for Epic and better
	if rc.order >= 4 then
		for c = 1, 24 + rc.order * 4 do
			local bit = K.new("Frame", { Size = UDim2.fromOffset(math.random(6, 12), math.random(10, 18)), Position = UDim2.new(math.random(), 0, 0, -20),
				BackgroundColor3 = Color3.fromHSV(math.random(), 0.7, 1), BorderSizePixel = 0, Rotation = math.random(0, 360), ZIndex = 29, Parent = HUD.Root })
			K.tween(bit, 1.6 + math.random() * 1.2, { Position = UDim2.new(bit.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1, 20), Rotation = math.random(-720, 720) },
				Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(3, function() bit:Destroy() end)
		end
	end
	local model = Renderer.BuildPreview(id)
	local vp = K.viewport(model, UDim2.fromOffset(220, 200), true)
	vp.Position = UDim2.new(0.5, -110, 0, 50)
	vp.ZIndex = 31
	vp.Parent = card
	K.label(def.name, UDim2.new(1, -20, 0, 34), Color3.new(1, 1, 1), { Position = UDim2.fromOffset(10, 252), ZIndex = 32, Parent = card })
	K.label(def.rarity .. "  •  +" .. Format.Money(CreatureData.Income(id)) .. "/s", UDim2.new(1, -20, 0, 26), rc.color:Lerp(Color3.new(1, 1, 1), 0.2),
		{ Position = UDim2.fromOffset(10, 286), ZIndex = 32, Parent = card })
	K.label("Added to your pets!", UDim2.new(1, -20, 0, 20), Color3.fromRGB(200, 255, 200), { Position = UDim2.fromOffset(10, 314), ZIndex = 32, Parent = card })
	K.tween(sc, 0.45, { Scale = targetScale }, Enum.EasingStyle.Back)
	if bad then Sounds.Play("Click", 0.8) else Sounds.Play("Rare", 1.4 - rc.order * 0.06) end
	local spin = RunService.RenderStepped:Connect(function()
		glow.Rotation = (os.clock() * 60) % 360
		if glow2 then glow2.Rotation = -(os.clock() * 40) % 360 end
		card.Rotation = math.sin(os.clock() * 3) * (1 + rc.order * 0.3)
	end)
	task.delay(1.9, function()
		local pets = HUD.SideButtons["Pets"]
		if pets and card.Parent then
			local s = math.max(card.AbsoluteSize.X / (W * math.max(sc.Scale, 0.01)), 0.01)
			local target = (pets.AbsolutePosition + pets.AbsoluteSize / 2 - HUD.Root.AbsolutePosition) / s
			K.tween(card, 0.5, { Position = UDim2.fromOffset(target.X, target.Y), Rotation = -20 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			K.tween(sc, 0.5, { Scale = 0.08 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.5, function()
				spin:Disconnect()
				card:Destroy()
				K.pop(pets, 1.35)
				Sounds.Play("Collect", 1.3)
			end)
		else
			spin:Disconnect()
			card:Destroy()
		end
	end)
end

Remotes.Deposit.OnClientEvent:Connect(function(ids)
	for i, id in ipairs(ids) do
		-- wait for the capture animation to finish, then show the card
		local def = CreatureData.ById[id]
		local cfg = def and Renderer.CatchConfig[def.rarity] or Renderer.CatchConfig.Common
		task.delay(cfg.dur + 0.15 + (i - 1) * 2.6, caughtCard, id)
	end
end)

---------------------------------------------------------------- per-world lighting + guide beam to base
local guideBeam, guideA0, guideA1
local function ensureGuide()
	if guideBeam then return end
	guideA1 = Instance.new("Attachment")
	guideA1.Parent = workspace.Terrain
	guideBeam = Instance.new("Beam")
	guideBeam.Attachment1 = guideA1
	guideBeam.Color = ColorSequence.new(Color3.fromRGB(150, 255, 160), Color3.fromRGB(120, 200, 255))
	guideBeam.LightEmission = 1
	guideBeam.Width0, guideBeam.Width1 = 1.2, 3
	guideBeam.FaceCamera = true
	guideBeam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	guideBeam.TextureMode = Enum.TextureMode.Static
	guideBeam.TextureLength = 4
	guideBeam.TextureSpeed = 2
	guideBeam.Transparency = NumberSequence.new(0.2, 0.6)
	guideBeam.CurveSize0 = 20
	guideBeam.Parent = workspace.Terrain
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.2 then return end
	acc = 0
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	-- lighting/ambience follow the CAMERA, so the follow-cam shows each zone's mood
	Effects.UpdateWorld(workspace.CurrentCamera.CFrame.Position)
	HUD.SetInZone(Config.InThrowZone(root.Position))
	-- touching the limit: wall flashes and the "throw from here" animation plays
	if root.Position.Z > Config.BarrierZ - 2.6 and root.Position.Z < Config.BarrierZ + 3 and os.clock() - lastBarrierFx > 1.5 then
		lastBarrierFx = os.clock()
		barrierPulse(root.Position)
		HUD.ShowThrowHere()
	end
	-- standing in YOUR OWN gym?
	local inGym = false
	local idx = player:GetAttribute("BaseIndex")
	local myBase = idx and workspace:FindFirstChild("Bases") and workspace.Bases:FindFirstChild("Base" .. idx)
	local gymPad = myBase and myBase:FindFirstChild("GymPad")
	if gymPad then
		inGym = ((root.Position - gymPad.Position) * Vector3.new(1, 0, 1)).Magnitude < Config.TrainRange
	end
	local level = inGym and math.clamp(State.Data.EquipLevel or 1, 1, #Config.TrainingStations) or nil
	local nextSt = level and Config.TrainingStations[level + 1]
	local canBuy = nextSt and (State.Data.Money or 0) >= nextSt.price
	if level ~= HUD._shownGym or canBuy ~= HUD._shownCanBuy then
		HUD._shownGym, HUD._shownCanBuy = level, canBuy
		HUD.SetGym(level)
	end
	-- creatures are caught automatically now, so the manual collect button stays hidden
	HUD.SetCollectable(nil)
	-- show a sparkly guide beam to your base while carrying creatures
	local carrying = #(State.Data.Carry or {}) > 0
	local idx = player:GetAttribute("BaseIndex")
	local base = idx and workspace:FindFirstChild("Bases") and workspace.Bases:FindFirstChild("Base" .. idx)
	if carrying and base then
		ensureGuide()
		if not guideA0 or guideA0.Parent ~= root then
			guideA0 = Instance.new("Attachment")
			guideA0.Position = Vector3.new(0, -2, 0)
			guideA0.Parent = root
			guideBeam.Attachment0 = guideA0
		end
		guideA1.WorldPosition = base.Center.Position + Vector3.new(0, 2, 0)
		guideBeam.Enabled = true
	elseif guideBeam then
		guideBeam.Enabled = false
	end
end)

-- cinematic intro fly-over, then the welcome message
task.spawn(function()
	local ok, err = pcall(function() require(Client.Intro).Play(HUD.Gui) end)
	if not ok then
		warn("[Intro] " .. tostring(err))
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
		HUD.Gui.Enabled = true
		Effects.Letterbox(false)
	end
	HUD.Notify("Welcome to Throw Portals For Creatures! Go to the Launch Hall to throw!", "info")
end)
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">ClientState</string><ProtectedString name="Source"><![CDATA[-- ClientState: local mirror of the player's data + change signal + request helper.
-- Location: StarterPlayer > StarterPlayerScripts > Client > ClientState (ModuleScript)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local State = {
	Data = { Money = 0, Uncollected = 0, Upgrades = { ThrowPower = 1, BaseSlots = 0, Storage = 0, Training = 0 },
		OwnedPortals = { Basic = true }, EquippedPortal = "Basic", Creatures = {}, Placed = {}, Discovered = {},
		UnlockedWorlds = { Forest = true }, Decor = {}, FloorTheme = "Meadow", OwnedFloors = { Meadow = true },
		OwnedEquipment = { ["1"] = true }, Strength = 0,
		Income = 0, SlotsOpen = 4, StorageCap = 10, MaxDistance = 45, Carry = {}, BaseIndex = 0 },
	Loaded = false,
}
local changed = Instance.new("BindableEvent")
State.Changed = changed.Event

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
State.Remotes = Remotes

Remotes:WaitForChild("Sync").OnClientEvent:Connect(function(payload)
	local full = payload.Creatures ~= nil
	for k, v in pairs(payload) do State.Data[k] = v end
	if full then State.Loaded = true end
	changed:Fire(full)
end)

-- returns ok, message
function State.Request(action: string, arg)
	local ok, res, msg = pcall(function()
		return Remotes.Request:InvokeServer(action, arg)
	end)
	if not ok then return false, "Connection error" end
	return res, msg
end

function State.IsPlaced(uid)
	return table.find(State.Data.Placed, uid) ~= nil
end

return State
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">CreatureRenderer</string><ProtectedString name="Source"><![CDATA[-- CreatureRenderer: renders every creature on this client — base pets of all players,
-- creatures being carried, and freshly revealed wild creatures. Handles reactions,
-- click-to-pet, LOD (far creatures update less often) and pop-in animations.
-- Location: StarterPlayer > StarterPlayerScripts > Client > CreatureRenderer (ModuleScript)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CreatureData = require(Shared.CreatureData)
local Builder = require(Shared.CreatureBuilder)
local Animator = require(Shared.CreatureAnimator)
local Format = require(Shared.Format)
local Effects = require(script.Parent.Effects)
local Sounds = require(script.Parent.Sounds)

local Renderer = {}
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local folder = Instance.new("Folder")
folder.Name = "Creatures"
folder.Parent = workspace

local active = {}       -- set of entries { model, anim, kind, ... }
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
local basePets = {}     -- [userId] = array of entries
local carried = {}      -- [userId] = array of entries
local wild = {}         -- [throwId] = entry
Renderer.Wild = wild
Renderer.OnCollectRequest = nil -- set by ClientMain

---------------------------------------------------------------- helpers
local function tag(entry, text, color, maxDist, offsetY)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(200, 50)
	bb.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	bb.MaxDistance = maxDist
	bb.LightInfluence = 0
	bb.AlwaysOnTop = false
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.RichText = true
	t.Text = text
	t.TextColor3 = color
	local st = Instance.new("UIStroke"); st.Thickness = 2.5; st.Color = Color3.fromRGB(25, 15, 35); st.Parent = t
	t.Parent = bb
	bb.Parent = entry.model.PrimaryPart
	return bb
end

local function spawnEntry(creatureId, cf, kind, popTime)
	local model, rig = Builder.Build(creatureId)
	model:PivotTo(cf)
	model.Parent = folder
	local anim = Animator.new(rig, cf)
	local entry = { id = creatureId, model = model, rig = rig, anim = anim, kind = kind, acc = 0, reactCd = 0, frame = math.random(1, 3) }
	if popTime and popTime > 0 then
		entry.popT, entry.popDur = 0, popTime
		anim:SetScale(0.01)
	end
	active[entry] = true
	return entry
end

local function destroyEntry(entry)
	active[entry] = nil
	if entry.anim then entry.anim:Destroy() end
	if entry.model then entry.model:Destroy() end
end

-- elastic overshoot 0..1
local function elastic(k)
	if k >= 1 then return 1 end
	return 1 - math.exp(-6 * k) * math.cos(k * 12)
end

local function heightFor(def)
	local s = Config.Rarities[def.rarity].size * def.scale
	if def.body == "golem" then return 5.2 * s end
	if def.body == "ghost" or def.body == "fish" then return 4.8 * s end
	return 3.8 * s
end

---------------------------------------------------------------- base pets
local function baseModel(index)
	local bases = workspace:FindFirstChild("Bases")
	return bases and bases:FindFirstChild("Base" .. index)
end

local function slotCF(base, i)
	local slot = base.Slots:FindFirstChild("Slot" .. i)
	if not slot then return base.Center.CFrame end
	local center = base.Center.Position
	local pos = slot.Position + Vector3.new(0, slot.Size.X / 2, 0) -- top of the pedestal (cylinder height runs along X)
	return CFrame.lookAt(pos, Vector3.new(center.X, pos.Y, center.Z) + (base.Center.CFrame.LookVector * 30))
end

local function refreshBase(plr)
	local idx = plr:GetAttribute("BaseIndex")
	local raw = plr:GetAttribute("BaseCreatures")
	local list = {}
	if raw then
		local ok, res = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok then list = res end
	end
	local base = idx and idx > 0 and baseModel(idx)
	local existing = basePets[plr.UserId] or {}
	if not base then
		for _, e in ipairs(existing) do destroyEntry(e) end
		basePets[plr.UserId] = {}
		return
	end
	-- multiset diff: keep creatures that are still placed, add new ones, remove the rest
	local keep, pool = {}, {}
	for _, e in ipairs(existing) do pool[e.id] = pool[e.id] or {}; table.insert(pool[e.id], e) end
	local result = {}
	for i, cid in ipairs(list) do
		local cand = pool[cid] and table.remove(pool[cid])
		if not cand and CreatureData.ById[cid] then
			local cf = slotCF(base, i)
			cand = spawnEntry(cid, cf, "base", 0.7)
			local def = CreatureData.ById[cid]
			local rc = Config.Rarities[def.rarity].color
			tag(cand, def.name .. "\n<font size='18' color='#9CFFA8'>" .. Format.Money(CreatureData.Income(cid)) .. "/s</font>", rc, 40, heightFor(def))
			-- click / tap to pet
			cand.rig.body.CanQuery = true
			local cd = Instance.new("ClickDetector")
			cd.MaxActivationDistance = 40
			cd.Parent = cand.rig.body
			cd.MouseClick:Connect(function()
				cand.anim:React(math.random() < 0.5 and "happy" or "spin")
				Sounds.PlayAt("Spawn", cand.model.PrimaryPart.Position, 1.4)
				Effects.FloatingText(cand.model.PrimaryPart.Position + Vector3.new(0, heightFor(def) + 1, 0), "♥", Color3.fromRGB(255, 120, 170), 0.8)
			end)
			if plr == player then Effects.Burst(cf.Position + Vector3.new(0, 2, 0), rc, 25, 14, 0.8) end
		end
		-- roam freely all over THEIR OWN base (they start on their slot)
		cand.anim:SetHome(base.Center.Position, 30)
		cand.baseCF = base.Center.CFrame
		cand.slot = i
		table.insert(result, cand)
	end
	for _, arr in pairs(pool) do for _, e in ipairs(arr) do destroyEntry(e) end end
	basePets[plr.UserId] = result
end

---------------------------------------------------------------- carried followers
local function refreshCarry(plr)
	local raw = plr:GetAttribute("Carry") or ""
	local ids = {}
	for id in string.gmatch(raw, "[^,]+") do table.insert(ids, id) end
	local existing = carried[plr.UserId] or {}
	-- remove extras
	while #existing > #ids do destroyEntry(table.remove(existing)) end
	for i, cid in ipairs(ids) do
		local e = existing[i]
		if e and e.id ~= cid then destroyEntry(e); e = nil end
		if not e then
			local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			local cf = hrp and (hrp.CFrame * CFrame.new(0, -2.5, 4 + i * 3)) or CFrame.new()
			e = spawnEntry(cid, cf, "carry", 0.45)
			local def = CreatureData.ById[cid]
			tag(e, def.name, Config.Rarities[def.rarity].color, 60, heightFor(def))
			existing[i] = e
		end
		e.follow = plr
		e.followIndex = i
	end
	carried[plr.UserId] = existing
end

---------------------------------------------------------------- wild creatures (portal reveals)
---------------------------------------------------------------- portal entrance animations (by rarity)
local ENTRANCE = { Rare = "spin", Epic = "leap", Legendary = "rise", Mythical = "giant", Secret = "glitch", Divine = "descend" }
-- Common / Uncommon creatures get an entrance that matches how they move
local MOVE_ENTRANCE = { hop = "bounce", walk = "twirl", fly = "swoop", float = "drift", slither = "wiggle" }
local ENTRANCE_TIME = { bounce = 1.5, twirl = 1.3, swoop = 1.5, drift = 1.6, wiggle = 1.4,
	spin = 1.3, leap = 1.2, rise = 2.4, giant = 2.6, glitch = 2.0, descend = 2.8 }
local GLITCH = ColorSequence.new(Color3.fromRGB(0, 255, 200), Color3.fromRGB(255, 0, 170))
local function easeOut(k) return 1 - (1 - k) ^ 3 end
local function easeIn(k) return k * k * k end
local function backOut(k) local c = 1.9; return 1 + (c + 1) * (k - 1) ^ 3 + c * (k - 1) ^ 2 end

-- CATCH animations: the better the pet, the bigger the celebration
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 230, 80)),
	ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 220, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 100, 255)) })
local CATCH = {
	Common    = { dur = 0.9, spins = 3,  rise = 4,  burst = 12,  wave = 0,  text = "Caught... meh",      size = 0.9, happy = false, puff = true },
	Uncommon  = { dur = 1.0, spins = 4,  rise = 5,  burst = 22,  wave = 7,  text = "Nice catch!",        size = 1.0, happy = true },
	Rare      = { dur = 1.2, spins = 6,  rise = 6,  burst = 40,  wave = 10, text = "Great catch!",       size = 1.15, happy = true },
	Epic      = { dur = 1.3, spins = 7,  rise = 7,  burst = 60,  wave = 14, text = "AMAZING CATCH!",     size = 1.3, happy = true, shake = 0.6, flash = 0.25 },
	Legendary = { dur = 1.6, spins = 8,  rise = 8,  burst = 90,  wave = 20, text = "LEGENDARY CATCH!!",  size = 1.5, happy = true, shake = 1.2, flash = 0.4, beam = true, confetti = true },
	Mythical  = { dur = 1.8, spins = 10, rise = 9,  burst = 110, wave = 24, text = "MYTHICAL!!!",        size = 1.6, happy = true, shake = 1.6, flash = 0.45, bolts = true, confetti = true },
	Secret    = { dur = 1.6, spins = 6,  rise = 7,  burst = 100, wave = 22, text = "??? SECRET ???",     size = 1.6, happy = true, shake = 1.4, glitch = true },
	Divine    = { dur = 2.0, spins = 12, rise = 10, burst = 140, wave = 30, text = "✨ DIVINE ✨",       size = 1.8, happy = true, shake = 2.0, flash = 0.6, beam = true, confetti = true },
}
Renderer.CatchConfig = CATCH

local function finishEntrance(e)
	local en, a = e.entrance, e.anim
	e.entrance = nil
	a:SetScale(1)
	a.pos = en.to
	a.groundY = en.y0
	a.yaw = en.yaw0
	a.targetYaw = en.yaw0
	a:SetHome(en.to, 3)
	a.idleTimer = 1.5
	a:React("happy")
end

local function stepEntrance(e, dt)
	local en, a = e.entrance, e.anim
	en.t += dt
	local k = math.clamp(en.t / en.dur, 0, 1)
	local col = en.color
	local mine = e.owner == player.UserId
	en.fx = (en.fx or 0) - dt
	local pop = math.max(0.02, backOut(math.min(1, k * 2.5)))
	if en.kind == "bounce" then
		-- three bouncy hops out of the portal, each smaller than the last
		local q = k * 3
		local hop = math.floor(q)
		a.pos = en.from:Lerp(en.to, easeOut(k))
		a.groundY = en.y0 + math.abs(math.sin(q * math.pi)) * (3.5 - hop) * 1.3
		if hop ~= en.lastHop then en.lastHop = hop; if hop > 0 then a.landSquash = 1; Effects.Burst(a.pos, col, 6, 6, 0.4) end end
		a:SetScale(pop)
	elseif en.kind == "twirl" then
		a.pos = en.from:Lerp(en.to, easeOut(k))
		a.groundY = en.y0 + math.sin(k * math.pi) * 3
		a.yaw = en.yaw0 + easeOut(k) * math.pi * 2
		a:SetScale(pop)
		if en.fx <= 0 then en.fx = 0.15; Effects.Burst(a.pos + Vector3.new(0, 1.5, 0), col, 4, 5, 0.4) end
	elseif en.kind == "swoop" then
		a.pos = en.from:Lerp(en.to, k)
		a.groundY = en.y0 + math.sin(k * math.pi) * 9 + math.sin(k * math.pi * 2) * 2
		a.yaw = en.yaw0 + math.sin(k * math.pi * 2) * 0.8
		a:SetScale(pop)
		if en.fx <= 0 then en.fx = 0.08; Effects.Burst(a.pos + Vector3.new(0, a.groundY - en.y0 + 2, 0), Color3.new(1, 1, 1), 3, 3, 0.35) end
	elseif en.kind == "drift" then
		a.pos = en.from:Lerp(en.to, easeOut(k))
		a.groundY = en.y0 + math.sin(k * math.pi) * 3
		a.yaw = en.yaw0 + k * math.pi
		a:SetScale(math.max(0.02, easeOut(k)))
		if en.fx <= 0 then en.fx = 0.1; Effects.Burst(a.pos + Vector3.new(0, 2, 0), col, 4, 3, 0.5) end
	elseif en.kind == "wiggle" then
		a.pos = en.from:Lerp(en.to, k)
		a.yaw = en.yaw0 + math.sin(k * math.pi * 6) * 0.7
		a:SetScale(pop)
	elseif en.kind == "spin" then
		a.pos = en.from:Lerp(en.to, easeOut(k))
		a.yaw = en.yaw0 + easeOut(k) * math.pi * 4
		if en.fx <= 0 then en.fx = 0.12; Effects.Burst(a.pos + Vector3.new(0, 2, 0), col, 6, 6, 0.5) end
	elseif en.kind == "leap" then
		a.pos = en.from:Lerp(en.to, k)
		a.groundY = en.y0 + math.sin(k * math.pi) * 9
		a.yaw = en.yaw0 + easeOut(k) * math.pi * 2
		a:SetScale(1 + math.sin(k * math.pi) * 0.25)
		if k >= 1 then
			a.landSquash = 1
			Effects.Shockwave(en.to, col, 12, 0.5)
			Effects.Burst(en.to + Vector3.new(0, 1, 0), col, 25, 14, 0.8)
		end
	elseif en.kind == "rise" then
		if k < 0.45 then
			local q = k / 0.45
			a.pos = en.from
			a.groundY = en.y0 + easeOut(q) * 6
			a:SetScale(0.2 + easeOut(q) * 1.1)
			a.yaw = en.yaw0 + q * math.pi
		elseif k < 0.75 then
			if not en.roared then en.roared = true; a:React("happy"); Effects.Burst(a.pos + Vector3.new(0, 7, 0), col, 40, 16, 1) end
			a.groundY = en.y0 + 6 + math.sin(en.t * 6) * 0.5
			a:SetScale(1.3)
			a.yaw = en.yaw0 + math.pi + (k - 0.45) * 8
		else
			local q = (k - 0.75) / 0.25
			a.pos = en.from:Lerp(en.to, q)
			a.groundY = en.y0 + 6 * (1 - easeIn(q))
			a:SetScale(1.3 - 0.3 * q)
		end
		if en.fx <= 0 then en.fx = 0.15; Effects.Burst(a.pos + Vector3.new(0, a.groundY - en.y0 + 2, 0), Color3.fromRGB(255, 220, 120), 5, 4, 0.6) end
		if k >= 1 then
			Effects.Shockwave(en.to, Color3.fromRGB(255, 210, 80), 20, 0.7)
			Effects.Burst(en.to + Vector3.new(0, 1, 0), Color3.fromRGB(255, 220, 120), 50, 20, 1)
			if mine then Effects.Shake(1.2, 0.35) end
		end
	elseif en.kind == "giant" then
		if k < 0.35 then
			local q = k / 0.35
			a.pos = en.from
			a:SetScale(math.max(0.02, backOut(q) * 2.6))
		elseif k < 0.65 then
			if not en.roared then en.roared = true; a:React("happy"); if mine then Effects.Shake(2, 0.6) end end
			a:SetScale(2.6 + math.sin(en.t * 30) * 0.05)
			if en.fx <= 0 then
				en.fx = 0.18
				local off = Vector3.new(math.random(-6, 6), math.random(2, 10), math.random(-6, 6))
				Effects.Burst(a.pos + off, col, 18, 24, 0.7)
			end
		else
			local q = (k - 0.65) / 0.35
			a.pos = en.from:Lerp(en.to, q)
			a:SetScale(2.6 - 1.6 * easeOut(q))
			a.yaw = en.yaw0 + easeOut(q) * math.pi * 2
		end
		if k >= 1 then Effects.Shockwave(en.to, col, 24, 0.8) end
	elseif en.kind == "glitch" then
		if en.fx <= 0 then
			en.fx = 0.09
			if k < 0.9 then
				a.pos = en.to + Vector3.new(math.random() * 6 - 3, 0, math.random() * 6 - 3)
				a.groundY = en.y0 + math.random() * 2
				a:SetScale(0.4 + math.random() * 1.2)
				a.yaw = math.random() * math.pi * 2
				Effects.Burst(a.pos + Vector3.new(0, 2, 0), GLITCH, 8, 10, 0.5)
			end
		end
		if k >= 1 then
			Effects.Flash(Color3.fromRGB(0, 0, 0), 0.25, mine and 0.6 or 0)
			Effects.Burst(en.to + Vector3.new(0, 2, 0), GLITCH, 60, 25, 1)
		end
	elseif en.kind == "descend" then
		if not en.beam then en.beam = true; Effects.LightBeam(en.to, Color3.fromRGB(255, 245, 190), 160, 2.6) end
		a.pos = en.to
		a.groundY = en.y0 + (1 - easeOut(k)) * 45
		a:SetScale(1.4 - 0.4 * k)
		a.yaw = en.yaw0 + k * math.pi * 2
		if en.fx <= 0 then en.fx = 0.1; Effects.Burst(a.pos + Vector3.new(0, a.groundY - en.y0, 0), Color3.fromRGB(255, 240, 180), 8, 6, 0.7) end
		if k >= 1 then
			Effects.Shockwave(en.to, Color3.fromRGB(255, 245, 200), 30, 1)
			Effects.Burst(en.to + Vector3.new(0, 2, 0), ColorSequence.new(Color3.fromRGB(255, 245, 190), Color3.new(1, 1, 1)), 90, 28, 1.3)
			if mine then Effects.Shake(1.6, 0.5); Effects.Flash(Color3.new(1, 1, 1), 0.6, 0.5) end
		end
	end
	a.targetYaw = a.yaw -- keep the animator's smooth-turning from fighting the spin
	if k >= 1 then finishEntrance(e) end
end

-- The creature appears inside the open portal (at `pos`) and comes out toward the thrower (-Z),
-- with a fancier entrance the rarer it is.
function Renderer.SpawnWild(throwId, creatureId, pos, ownerId, chanceText)
	local def = CreatureData.ById[creatureId]
	local cf = CFrame.lookAt(pos + Vector3.new(0, 0, 1.5), pos + Vector3.new(0, 0, -10))
	local kind = ENTRANCE[def.rarity] or MOVE_ENTRANCE[def.move] or "twirl"
	local e = spawnEntry(creatureId, cf, "wild", kind == "spin" and 0.9 or 0)
	if kind ~= "walk" then
		local _, yaw0 = cf:ToEulerAnglesYXZ()
		e.entrance = { kind = kind, t = 0, dur = ENTRANCE_TIME[kind], from = pos + Vector3.new(0, 0, 1.5), to = pos + Vector3.new(0, 0, -9),
			y0 = pos.Y, yaw0 = yaw0, color = Config.Rarities[def.rarity].color }
		if kind == "descend" then e.anim:SetScale(1.4) elseif kind ~= "spin" then e.anim:SetScale(0.02) end
	end
	e.throwId = throwId
	e.owner = ownerId
	local rc = Config.Rarities[def.rarity].color
	local owner = Players:GetPlayerByUserId(ownerId)
	local mine = ownerId == player.UserId
	tag(e, string.format("%s\n<font size='16'>%s  •  %s%s</font>", def.name, def.rarity, chanceText or "", mine and "" or (" • " .. (owner and owner.DisplayName or "?"))),
		rc, 160, heightFor(def) + 0.5)
	local walkOut = pos + Vector3.new(0, 0, -9)
	if kind == "walk" then
		e.anim:MoveTo(walkOut, def.move == "fly" and 7 or 4.5)
		e.anim.idleTimer = 99
		task.delay(2.2, function()
			if e.anim and e.anim.rig and not e.entrance then e.anim:SetHome(walkOut, 3); e.anim.idleTimer = 2 end
		end)
	end
	pos = walkOut
	if mine then
		-- ground marker so you can find it from afar
		local ring = Effects.Part(Vector3.new(0.2, 7, 7), CFrame.new(pos + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.pi / 2), rc, Enum.Material.Neon, 0.3)
		ring.Shape = Enum.PartType.Cylinder
		ring.Parent = e.model
		local beacon = Effects.Part(Vector3.new(60, 0.6, 0.6), CFrame.new(pos + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.pi / 2), rc, Enum.Material.Neon, 0.55)
		beacon.Shape = Enum.PartType.Cylinder
		beacon.Parent = e.model
	end
	wild[throwId] = e
	return e
end

function Renderer.RemoveWild(throwId, reason, collectorId)
	local e = wild[throwId]
	if not e then return end
	wild[throwId] = nil
	if reason == "collected" then
		-- CAPTURE: happy jump, then it spirals up into a swirling ring of light and vanishes in a flash
		if e.entrance then finishEntrance(e) end
		local rarity = CreatureData.ById[e.id].rarity
		local cfg = CATCH[rarity] or CATCH.Common
		local col = Config.Rarities[rarity].color
		local base = e.anim.pos
		e.anim.home = nil       -- stop wandering
		e.anim.moveTarget = nil
		e.catchCfg = cfg
		if cfg.happy then e.anim:React("happy") else e.anim:React("spin") end
		if cfg.beam then Effects.LightBeam(base, rarity == "Divine" and Color3.fromRGB(255, 250, 220) or col, 140, cfg.dur + 0.6) end
		e.collectT = 0
		e.catchBase = base
		e.catchY = e.anim.groundY
		e.catchYaw = e.anim.yaw
		-- the swirling capture ring above the creature
		local ringSize = 5 + Config.Rarities[rarity].order * 1.2
		local ring = Effects.Part(Vector3.new(0.3, 1, 1), CFrame.new(base + Vector3.new(0, cfg.rise, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			cfg.puff and Color3.fromRGB(180, 180, 185) or col, Enum.Material.Neon, 0.1)
		ring.Shape = Enum.PartType.Cylinder
		Effects.Tween(ring, 0.35, { Size = Vector3.new(0.3, ringSize, ringSize) }, Enum.EasingStyle.Back)
		e.catchRing = ring
		Effects.Burst(base + Vector3.new(0, 2, 0), col, 30, 16, 0.9)
	else
		e.fadeT = 0
	end
end

---------------------------------------------------------------- per-frame update
local function myRoot()
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

RunService.RenderStepped:Connect(function(dt)
	local camPos = camera.CFrame.Position
	local root = myRoot()
	local myPos = root and root.Position
	local head = player.Character and player.Character:FindFirstChild("Head")
	for e in pairs(active) do
		local anim = e.anim
		-- pop-in
		if e.popT then
			e.popT += dt
			local k = math.clamp(e.popT / e.popDur, 0, 1)
			anim:SetScale(math.max(0.01, elastic(k)))
			if k >= 1 then e.popT = nil; anim:SetScale(1) end
		end
		-- special rarity entrance out of the portal
		if e.entrance and not e.collectT and not e.fadeT then
			stepEntrance(e, dt)
		end
		-- collected: shrink + fly to the collector
		if e.collectT then
			e.collectT += dt
			local cfg = e.catchCfg or CATCH.Common
			local k = math.clamp(e.collectT / cfg.dur, 0, 1)
			local col = Config.Rarities[CreatureData.ById[e.id].rarity].color
			local top = e.catchBase + Vector3.new(0, cfg.rise, 0)
			if k > 0.3 then
				-- spiral upward into the ring, spinning faster and shrinking
				local q = (k - 0.3) / 0.7
				anim.pos = e.catchBase + Vector3.new(math.cos(q * 12) * (1 - q) * 2, 0, math.sin(q * 12) * (1 - q) * 2)
				anim.groundY = e.catchY + easeIn(q) * cfg.rise
				anim.yaw = e.catchYaw + easeIn(q) * math.pi * cfg.spins
				anim.targetYaw = anim.yaw
				local s = math.max(0.01, 1 - easeIn(q))
				if cfg.glitch and math.random() < 0.4 then s *= 0.4 + math.random() * 1.2 end
				anim:SetScale(s)
				e.catchFx = (e.catchFx or 0) - dt
				if e.catchFx <= 0 then
					e.catchFx = 0.12
					if cfg.bolts then
						Effects.Burst(top + Vector3.new(math.random(-5, 5), math.random(-3, 3), math.random(-5, 5)), col, 16, 26, 0.6)
					elseif cfg.glitch then
						Effects.Burst(anim.pos + Vector3.new(0, anim.groundY - e.catchY + 1, 0), ColorSequence.new(Color3.fromRGB(0, 255, 200), Color3.fromRGB(255, 0, 170)), 8, 10, 0.5)
					end
				end
			end
			if e.catchRing then e.catchRing.CFrame = CFrame.new(top) * CFrame.Angles(0, os.clock() * 8, math.pi / 2) end
			if k >= 1 then
				local mine = e.owner == player.UserId
				if cfg.puff then
					Effects.Burst(top, ColorSequence.new(Color3.fromRGB(200, 200, 200), Color3.fromRGB(150, 150, 150)), cfg.burst, 8, 1.2, "rbxasset://textures/particles/smoke_main.dds")
				else
					Effects.Burst(top, col, cfg.burst, 22, 1)
				end
				if cfg.wave > 0 then Effects.Shockwave(top, col, cfg.wave, 0.5) end
				if cfg.confetti then Effects.Burst(top, RAINBOW, cfg.burst, 30, 0.8) end
				if mine then
					Effects.FloatingText(top + Vector3.new(0, 2, 0), cfg.text, cfg.puff and Color3.fromRGB(190, 190, 190) or col, cfg.size)
					if cfg.shake then Effects.Shake(cfg.shake, 0.5) end
					if cfg.flash then Effects.Flash(col, 0.5, cfg.flash) end
					if cfg.glitch then Effects.Flash(Color3.new(0, 0, 0), 0.35, 0.7) end
				end
				if e.catchRing then
					local r = e.catchRing
					Effects.Tween(r, 0.3, { Size = Vector3.new(0.3, 0.1, 0.1), Transparency = 1 })
					task.delay(0.35, function() r:Destroy() end)
				end
				destroyEntry(e)
				continue
			end
		elseif e.fadeT then
			e.fadeT += dt
			anim:SetScale(math.max(0.01, 1 - e.fadeT / 0.6))
			if e.fadeT > 0.6 then destroyEntry(e); continue end
		end
		-- free-roaming base pets: anywhere inside their own base (kept inside the hedges), on the real ground
		if e.kind == "base" then
			if anim.moveTarget and e.baseCF then
				local lp = e.baseCF:PointToObjectSpace(anim.moveTarget)
				local clamped = Vector3.new(math.clamp(lp.X, -29, 29), lp.Y, math.clamp(lp.Z, -29, 29))
				if clamped ~= lp then anim.moveTarget = e.baseCF:PointToWorldSpace(clamped) end
			end
			e.groundT = (e.groundT or math.random() * 0.4) - dt
			if e.groundT <= 0 then
				e.groundT = 0.35
				groundParams.FilterDescendantsInstances = { folder, Effects.Folder, player.Character }
				local hit = workspace:Raycast(anim.pos + Vector3.new(0, 12, 0), Vector3.new(0, -30, 0), groundParams)
				-- ignore tall things (hedges, lamp posts): pets just walk through those at floor level
				if hit and hit.Position.Y < 2.5 then e.targetGround = hit.Position.Y end
			end
			if e.targetGround then anim.groundY += (e.targetGround - anim.groundY) * math.min(1, dt * 10) end
		end
		-- followers trail behind their carrier
		if e.kind == "carry" and e.follow then
			local hrp = e.follow.Character and e.follow.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local back = hrp.CFrame * CFrame.new((e.followIndex % 2 == 0 and 2.5 or -2.5), 0, 3.5 + e.followIndex * 2.6)
				local dist = (anim.pos - back.Position).Magnitude
				anim.groundY = hrp.Position.Y - 3
				if dist > 60 then anim:Teleport(back * CFrame.new(0, -3, 0)) end
				if dist > 1.5 then anim:MoveTo(back.Position, math.clamp(dist * 2.2, 6, 40)) end
			end
		end
		-- LOD
		local d = (anim.pos - camPos).Magnitude
		e.acc += dt
		e.frame += 1
		local every = d > 160 and 6 or (d > 80 and 3 or 1)
		if d < 260 and e.frame % every == 0 then
			-- reactions to the local player
			if myPos and e.kind ~= "carry" then
				local pd = (anim.pos - myPos).Magnitude
				e.reactCd -= e.acc
				if pd < 12 then
					anim:LookAt(head and head.Position or myPos)
					if pd < 7 and e.reactCd <= 0 then
						e.reactCd = 8
						anim:React("happy")
					end
				else
					anim:LookAt(nil)
				end
			end
			anim:Step(e.acc)
			e.acc = 0
		end
	end
end)

---------------------------------------------------------------- wiring
local function watchPlayer(plr)
	plr:GetAttributeChangedSignal("BaseCreatures"):Connect(function() refreshBase(plr) end)
	plr:GetAttributeChangedSignal("BaseIndex"):Connect(function() refreshBase(plr) end)
	plr:GetAttributeChangedSignal("Carry"):Connect(function() refreshCarry(plr) end)
	task.spawn(function()
		workspace:WaitForChild("Bases", 30)
		refreshBase(plr)
		refreshCarry(plr)
	end)
end

function Renderer.Start()
	for _, plr in ipairs(Players:GetPlayers()) do watchPlayer(plr) end
	Players.PlayerAdded:Connect(watchPlayer)
	Players.PlayerRemoving:Connect(function(plr)
		for _, e in ipairs(basePets[plr.UserId] or {}) do destroyEntry(e) end
		for _, e in ipairs(carried[plr.UserId] or {}) do destroyEntry(e) end
		basePets[plr.UserId], carried[plr.UserId] = nil, nil
	end)
end

-- Builds a static (non-animated) creature for UI ViewportFrames
function Renderer.BuildPreview(creatureId)
	local model, rig = Builder.Build(creatureId)
	for _, e in ipairs(rig.emitters) do e.Enabled = false end
	return model, rig
end

return Renderer
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- Effects: camera shake, flashes, shockwaves, particle bursts, light beams, floating text,
-- flying-coin money effect, rarity banners and per-world lighting.
-- Location: StarterPlayer > StarterPlayerScripts > Client > Effects (ModuleScript)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local Effects = {}
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

local fxFolder = Instance.new("Folder")
fxFolder.Name = "ClientFX"
fxFolder.Parent = workspace
Effects.Folder = fxFolder

local gui = Instance.new("ScreenGui")
gui.Name = "FX"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 20
gui.Parent = player:WaitForChild("PlayerGui")
Effects.Gui = gui

local function tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
Effects.Tween = tween

---------------------------------------------------------------- camera shake
local shakeAmt, shakeEnd = 0, 0
RunService:BindToRenderStep("TPFC_Shake", Enum.RenderPriority.Camera.Value + 1, function()
	local now = os.clock()
	if now < shakeEnd then
		local k = (shakeEnd - now)
		local a = shakeAmt * math.min(1, k * 3)
		camera.CFrame = camera.CFrame * CFrame.Angles(math.noise(now * 25, 0) * a * 0.03, math.noise(0, now * 25) * a * 0.03, 0)
	end
end)
function Effects.Shake(intensity: number, duration: number)
	local active = os.clock() < shakeEnd
	shakeAmt = active and math.max(shakeAmt, intensity) or intensity
	shakeEnd = math.max(shakeEnd, os.clock() + duration)
end

---------------------------------------------------------------- screen flash
function Effects.Flash(color: Color3, duration: number?, strength: number?)
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = 1 - (strength or 0.6)
	f.BorderSizePixel = 0
	f.ZIndex = 50
	f.Parent = gui
	tween(f, duration or 0.5, { BackgroundTransparency = 1 }).Completed:Once(function() f:Destroy() end)
end

---------------------------------------------------------------- world-space effects
local function fxPart(size, cf, color, mat, transp, meshType)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.Neon
	p.Transparency = transp or 0
	if meshType then
		local m = Instance.new("SpecialMesh"); m.MeshType = meshType; m.Parent = p
	end
	p.Parent = fxFolder
	return p
end
Effects.Part = fxPart

function Effects.Shockwave(pos: Vector3, color: Color3, radius: number?, time: number?)
	local r = radius or 14
	local ring = fxPart(Vector3.new(0.3, 1, 1), CFrame.new(pos + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon, 0.1)
	ring.Shape = Enum.PartType.Cylinder
	tween(ring, time or 0.6, { Size = Vector3.new(0.1, r * 2, r * 2), Transparency = 1 }, Enum.EasingStyle.Quart)
	task.delay((time or 0.6) + 0.05, function() ring:Destroy() end)
	-- inner dome pulse
	local dome = fxPart(Vector3.new(1, 1, 1), CFrame.new(pos), color, Enum.Material.ForceField, 0, Enum.MeshType.Sphere)
	tween(dome, (time or 0.6) * 0.8, { Size = Vector3.new(r, r * 0.6, r), Transparency = 1 }, Enum.EasingStyle.Quart)
	task.delay(time or 0.6, function() dome:Destroy() end)
end

function Effects.Burst(pos: Vector3, colorSeq, count: number?, speed: number?, size: number?, tex: string?)
	local p = fxPart(Vector3.new(0.2, 0.2, 0.2), CFrame.new(pos), Color3.new(1, 1, 1), nil, 1)
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = tex or SPARKLE
	pe.Color = typeof(colorSeq) == "Color3" and ColorSequence.new(colorSeq) or colorSeq
	pe.LightEmission = 1
	pe.Rate = 0
	pe.Lifetime = NumberRange.new(0.6, 1.4)
	pe.Speed = NumberRange.new((speed or 20) * 0.4, speed or 20)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Drag = 3
	pe.Acceleration = Vector3.new(0, -8, 0)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size or 1), NumberSequenceKeypoint.new(1, 0) })
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-200, 200)
	pe.Parent = p
	pe:Emit(count or 40)
	task.delay(2, function() p:Destroy() end)
end

function Effects.LightBeam(pos: Vector3, color: Color3, height: number?, duration: number?)
	local h = height or 120
	local beam = fxPart(Vector3.new(h, 0.5, 0.5), CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon, 0.1)
	beam.Shape = Enum.PartType.Cylinder
	local l = Instance.new("PointLight"); l.Color = color; l.Range = 40; l.Brightness = 5; l.Parent = beam
	tween(beam, 0.35, { Size = Vector3.new(h, 9, 9) }, Enum.EasingStyle.Back)
	task.delay(0.35, function()
		tween(beam, duration or 1.6, { Size = Vector3.new(h, 0.2, 0.2), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(l, duration or 1.6, { Brightness = 0 })
	end)
	task.delay((duration or 1.6) + 0.5, function() beam:Destroy() end)
end

function Effects.FloatingText(pos: Vector3, text: string, color: Color3?, size: number?)
	local anchor = fxPart(Vector3.new(0.1, 0.1, 0.1), CFrame.new(pos), Color3.new(1, 1, 1), nil, 1)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(240, 60)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Parent = anchor
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = color or Color3.new(1, 1, 1)
	local st = Instance.new("UIStroke"); st.Thickness = 3; st.Color = Color3.fromRGB(30, 20, 40); st.Parent = t
	local sc = Instance.new("UIScale"); sc.Scale = 0.2; sc.Parent = t
	t.Parent = bb
	tween(sc, 0.35, { Scale = size or 1 }, Enum.EasingStyle.Back)
	tween(anchor, 1.6, { CFrame = CFrame.new(pos + Vector3.new(0, 6, 0)) }, Enum.EasingStyle.Quad)
	task.delay(1.1, function()
		tween(t, 0.5, { TextTransparency = 1 })
		tween(st, 0.5, { Transparency = 1 })
	end)
	task.delay(1.7, function() anchor:Destroy() end)
end

---------------------------------------------------------------- money: coins fly to the counter
Effects.MoneyTarget = nil -- set by UI to the money counter GuiObject
function Effects.Coins(worldPos: Vector3?, count: number?)
	local target = Effects.MoneyTarget
	if not target then return end
	local start
	if worldPos then
		local sp, onScreen = camera:WorldToViewportPoint(worldPos)
		start = onScreen and Vector2.new(sp.X, sp.Y) or camera.ViewportSize / 2
	else
		start = camera.ViewportSize / 2
	end
	local goal = target.AbsolutePosition + target.AbsoluteSize / 2 + Vector2.new(0, game:GetService("GuiService"):GetGuiInset().Y)
	for i = 1, count or 12 do
		task.delay(i * 0.03, function()
			local c = Instance.new("TextLabel")
			c.Size = UDim2.fromOffset(30, 30)
			c.AnchorPoint = Vector2.new(0.5, 0.5)
			c.Position = UDim2.fromOffset(start.X, start.Y)
			c.BackgroundColor3 = Color3.fromRGB(255, 205, 50)
			c.Text = "$"
			c.Font = Enum.Font.FredokaOne
			c.TextScaled = true
			c.TextColor3 = Color3.fromRGB(160, 100, 0)
			c.ZIndex = 40
			local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(1, 0); corner.Parent = c
			local st = Instance.new("UIStroke"); st.Color = Color3.fromRGB(255, 240, 160); st.Thickness = 2; st.Parent = c
			c.Parent = gui
			local mid = start + Vector2.new(math.random(-120, 120), math.random(-120, 40))
			tween(c, 0.25, { Position = UDim2.fromOffset(mid.X, mid.Y), Rotation = math.random(-40, 40) }, Enum.EasingStyle.Quad)
			task.delay(0.25, function()
				tween(c, 0.45, { Position = UDim2.fromOffset(goal.X, goal.Y), Size = UDim2.fromOffset(18, 18) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(0.45, function()
					c:Destroy()
					if Effects.OnCoinArrive then Effects.OnCoinArrive() end
				end)
			end)
		end)
	end
end

---------------------------------------------------------------- rarity banner
function Effects.RarityBanner(def, chanceText)
	local rc = Config.Rarities[def.rarity]
	local holder = Instance.new("Frame")
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.3)
	holder.Size = UDim2.fromScale(0.6, 0.16)
	holder.BackgroundTransparency = 1
	holder.ZIndex = 45
	holder.Parent = gui
	local sc = Instance.new("UIScale"); sc.Scale = 0; sc.Parent = holder
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.62)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.Text = def.rarity:upper() .. "!"
	title.TextColor3 = Color3.new(1, 1, 1)
	title.ZIndex = 46
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(rc.color:Lerp(Color3.new(1, 1, 1), 0.5), rc.color)
	grad.Rotation = 90
	grad.Parent = title
	local st = Instance.new("UIStroke"); st.Thickness = 4; st.Color = Color3.fromRGB(25, 15, 35); st.Parent = title
	title.Parent = holder
	local name = title:Clone()
	name.Size = UDim2.fromScale(1, 0.38)
	name.Position = UDim2.fromScale(0, 0.62)
	name.Text = def.name .. (chanceText and ("  •  " .. chanceText) or "")
	name:FindFirstChildOfClass("UIGradient"):Destroy()
	name.Parent = holder
	tween(sc, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
	local spin = RunService.RenderStepped:Connect(function()
		grad.Offset = Vector2.new(0, math.sin(os.clock() * 4) * 0.2)
		holder.Rotation = math.sin(os.clock() * 3) * 2
	end)
	task.delay(2.6, function()
		tween(sc, 0.3, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.delay(0.35, function() spin:Disconnect(); holder:Destroy() end)
	end)
end

---------------------------------------------------------------- lighting per world
local bloom, cc, atmo, rays
function Effects.SetupLighting()
	-- (Lighting.Technology can't be set by scripts; it's set to Future in the place file)
	pcall(function()
		Lighting.GlobalShadows = true
		Lighting.Brightness = 3
		Lighting.ShadowSoftness = 0.25
		Lighting.EnvironmentDiffuseScale = 1
		Lighting.EnvironmentSpecularScale = 1
		Lighting.GeographicLatitude = 35
	end)
	bloom = Lighting:FindFirstChild("TPFC_Bloom") or Instance.new("BloomEffect")
	bloom.Name = "TPFC_Bloom"; bloom.Intensity = 0.9; bloom.Size = 32; bloom.Threshold = 1.4; bloom.Parent = Lighting
	cc = Lighting:FindFirstChild("TPFC_CC") or Instance.new("ColorCorrectionEffect")
	cc.Name = "TPFC_CC"; cc.Saturation = 0.25; cc.Contrast = 0.12; cc.Brightness = 0.02; cc.Parent = Lighting
	rays = Lighting:FindFirstChild("TPFC_Rays") or Instance.new("SunRaysEffect")
	rays.Name = "TPFC_Rays"; rays.Intensity = 0.12; rays.Spread = 0.75; rays.Parent = Lighting
	atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = 0.32; atmo.Offset = 0.15; atmo.Haze = 1.6; atmo.Glare = 0.6; atmo.Parent = Lighting
	local dof = Lighting:FindFirstChild("TPFC_DOF") or Instance.new("DepthOfFieldEffect")
	dof.Name = "TPFC_DOF"; dof.FarIntensity = 0.18; dof.FocusDistance = 50; dof.InFocusRadius = 70; dof.NearIntensity = 0; dof.Parent = Lighting
	Effects.DOF = dof
	Effects.SetupExtras()
	Effects.SetupVignette()
end

---------------------------------------------------------------- cinematic vignette + letterbox bars
function Effects.SetupVignette()
	-- soft dark edges (four gradient frames), always on, drawn BELOW the HUD
	local vgui = Instance.new("ScreenGui")
	vgui.Name = "Vignette"
	vgui.IgnoreGuiInset = true
	vgui.ResetOnSpawn = false
	vgui.DisplayOrder = -5
	vgui.Parent = gui.Parent
	local edges = {
		{ UDim2.new(1, 0, 0.22, 0), UDim2.fromScale(0, 0), 90 },
		{ UDim2.new(1, 0, 0.22, 0), UDim2.fromScale(0, 0.78), -90 },
		{ UDim2.new(0.16, 0, 1, 0), UDim2.fromScale(0, 0), 0 },
		{ UDim2.new(0.16, 0, 1, 0), UDim2.fromScale(0.84, 0), 180 },
	}
	for _, e in ipairs(edges) do
		local f = Instance.new("Frame")
		f.Size, f.Position = e[1], e[2]
		f.BackgroundColor3 = Color3.new(0, 0, 0)
		f.BorderSizePixel = 0
		f.ZIndex = 1
		local g = Instance.new("UIGradient")
		g.Rotation = e[3]
		g.Transparency = NumberSequence.new(0.55, 1)
		g.Parent = f
		f.Parent = vgui
	end
end

local bars
function Effects.Letterbox(on: boolean)
	if not bars then
		bars = {}
		for i, pos in ipairs({ UDim2.fromScale(0, -0.12), UDim2.fromScale(0, 1) }) do
			local b = Instance.new("Frame")
			b.Size = UDim2.fromScale(1, 0.12)
			b.Position = pos
			b.BackgroundColor3 = Color3.new(0, 0, 0)
			b.BorderSizePixel = 0
			b.ZIndex = 45
			b.Parent = gui
			bars[i] = b
		end
	end
	tween(bars[1], 0.45, { Position = on and UDim2.fromScale(0, 0) or UDim2.fromScale(0, -0.12) }, Enum.EasingStyle.Quad)
	tween(bars[2], 0.45, { Position = on and UDim2.fromScale(0, 0.88) or UDim2.fromScale(0, 1) }, Enum.EasingStyle.Quad)
end

-- ambient particles that follow the camera, themed per zone
local AMBIENT = {
	Forest  = { col = { Color3.fromRGB(220, 255, 140), Color3.fromRGB(255, 240, 160) }, rate = 18, speed = 0.6, size = 0.35, accel = Vector3.new(0, 0.3, 0) },   -- fireflies
	Volcano = { col = { Color3.fromRGB(255, 140, 40), Color3.fromRGB(255, 60, 20) },    rate = 40, speed = 1.5, size = 0.3,  accel = Vector3.new(0, 4, 0) },      -- embers
	Frozen  = { col = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 235, 255) }, rate = 70, speed = 1,   size = 0.35, accel = Vector3.new(1, -4, 0) },     -- snow
	Crystal = { col = { Color3.fromRGB(200, 120, 255), Color3.fromRGB(100, 240, 255) }, rate = 30, speed = 0.5, size = 0.4,  accel = Vector3.new(0, 0.5, 0) },
	Candy   = { col = { Color3.fromRGB(255, 130, 200), Color3.fromRGB(140, 220, 255) }, rate = 30, speed = 0.8, size = 0.45, accel = Vector3.new(0, -1, 0) },
	Space   = { col = { Color3.fromRGB(255, 255, 220), Color3.fromRGB(160, 140, 255) }, rate = 50, speed = 0.2, size = 0.3,  accel = Vector3.zero },             -- stardust
	Shadow  = { col = { Color3.fromRGB(150, 60, 255), Color3.fromRGB(60, 0, 90) },      rate = 30, speed = 0.4, size = 0.6,  accel = Vector3.new(0, 0.6, 0) },
	Heaven  = { col = { Color3.fromRGB(255, 245, 190), Color3.fromRGB(255, 255, 255) }, rate = 40, speed = 0.6, size = 0.45, accel = Vector3.new(0, 1, 0) },     -- light motes
}
local ambientPart, ambientPE
local function setupAmbient()
	ambientPart = Instance.new("Part")
	ambientPart.Name = "Ambient"
	ambientPart.Anchored, ambientPart.CanCollide, ambientPart.CanQuery, ambientPart.CanTouch = true, false, false, false
	ambientPart.Transparency = 1
	ambientPart.Size = Vector3.new(80, 30, 80)
	ambientPart.Parent = fxFolder
	ambientPE = Instance.new("ParticleEmitter")
	ambientPE.Texture = SPARKLE
	ambientPE.Shape = Enum.ParticleEmitterShape.Box
	ambientPE.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
	ambientPE.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	ambientPE.LightEmission = 1
	ambientPE.Lifetime = NumberRange.new(3, 6)
	ambientPE.SpreadAngle = Vector2.new(180, 180)
	ambientPE.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.1), NumberSequenceKeypoint.new(0.8, 0.2), NumberSequenceKeypoint.new(1, 1) })
	ambientPE.Parent = ambientPart
	RunService.RenderStepped:Connect(function()
		ambientPart.CFrame = CFrame.new(camera.CFrame.Position + camera.CFrame.LookVector * 25)
	end)
end
local function applyAmbient(id)
	local a = AMBIENT[id]
	if not a or not ambientPE then return end
	ambientPE.Color = ColorSequence.new(a.col[1], a.col[2])
	ambientPE.Rate = a.rate
	ambientPE.Speed = NumberRange.new(a.speed * 0.5, a.speed)
	ambientPE.Acceleration = a.accel
	ambientPE.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, a.size), NumberSequenceKeypoint.new(1, 0) })
end

local clouds, sky
local function setupSky()
	pcall(function()
		clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.6
		clouds.Color = Color3.new(1, 1, 1)
		clouds.Parent = workspace.Terrain
	end)
	sky = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky")
	sky.StarCount = 3000
	sky.SunAngularSize = 14
	sky.MoonAngularSize = 9
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting
end

function Effects.SetupExtras()
	-- (the floating ambient particles were removed on request)
	setupSky()
end

local LOOK = {
	Forest  = { clock = 16.4, exposure = 0.15, sat = 0.28, contrast = 0.12, bloom = 0.8, rays = 0.16, density = 0.3,  haze = 1.6 }, -- golden afternoon
	Volcano = { clock = 18.4, exposure = 0.1,  sat = 0.35, contrast = 0.2,  bloom = 1.2, rays = 0.2,  density = 0.42, haze = 2.4 },
	Frozen  = { clock = 9.5,  exposure = 0.25, sat = 0.1,  contrast = 0.1,  bloom = 0.9, rays = 0.18, density = 0.35, haze = 2.0 },
	Crystal = { clock = 0,    exposure = 0.3,  sat = 0.45, contrast = 0.18, bloom = 1.6, rays = 0.05, density = 0.38, haze = 1.4 },
	Candy   = { clock = 13,   exposure = 0.25, sat = 0.5,  contrast = 0.08, bloom = 1.0, rays = 0.12, density = 0.28, haze = 1.2 },
	Space   = { clock = 0,    exposure = 0.2,  sat = 0.4,  contrast = 0.2,  bloom = 1.8, rays = 0.0,  density = 0.12, haze = 0.4 },
	Shadow  = { clock = 21.5, exposure = 0.0,  sat = 0.3,  contrast = 0.28, bloom = 1.4, rays = 0.0,  density = 0.5,  haze = 2.6 },
	Heaven  = { clock = 12,   exposure = 0.35, sat = 0.15, contrast = 0.06, bloom = 1.3, rays = 0.3,  density = 0.25, haze = 2.2 },
}

local currentWorld
function Effects.UpdateWorld(pos: Vector3)
	local id = Config.WorldAt(pos)
	if not id or id == currentWorld then return currentWorld end
	currentWorld = id
	local W = Config.Worlds[id]
	applyAmbient(id)
	if clouds then
		local cover = ({ Forest = 0.55, Volcano = 0.75, Frozen = 0.8, Crystal = 0.3, Candy = 0.6, Space = 0, Shadow = 0.7, Heaven = 0.9 })[id] or 0.5
		local ccol = ({ Volcano = Color3.fromRGB(90, 60, 60), Shadow = Color3.fromRGB(70, 40, 90), Candy = Color3.fromRGB(255, 210, 235) })[id] or Color3.new(1, 1, 1)
		tween(clouds, 2, { Cover = cover, Color = ccol })
	end
	-- each zone has its own "look": time of day, exposure, colour grading, bloom and sun rays
	local look = LOOK[id] or LOOK.Forest
	tween(Lighting, 1.5, { Ambient = W.ambient, OutdoorAmbient = W.ambient, ClockTime = look.clock or W.clock, FogColor = W.fog, ExposureCompensation = look.exposure })
	if cc then tween(cc, 1.5, { TintColor = W.tint, Saturation = look.sat, Contrast = look.contrast }) end
	if bloom then tween(bloom, 1.5, { Intensity = look.bloom }) end
	if rays then tween(rays, 1.5, { Intensity = look.rays }) end
	if atmo then tween(atmo, 1.5, { Color = W.atmo, Decay = W.fog, Density = look.density, Haze = look.haze }) end
	return id
end

return Effects
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[-- HUD: money / throw-power counters, side menu buttons, throw meter, mobile throw button,
-- carry hint, toasts and the animated panel framework used by Panels.
-- Location: StarterPlayer > StarterPlayerScripts > Client > HUD (ModuleScript)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local K = require(script.Parent.UIKit)
local State = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)
local Sounds = require(script.Parent.Sounds)

local HUD = {}
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local isTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local gui = K.new("ScreenGui", { Name = "HUD", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })
local root = K.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
local uiScale = K.new("UIScale", { Parent = root })
HUD.Gui, HUD.Root = gui, root

-- scale whole UI to the screen (phones get a slightly larger relative size)
local function rescale()
	local v = camera.ViewportSize
	local s = math.min(v.X / 1280, v.Y / 720)
	if isTouch then s *= 1.15 end
	uiScale.Scale = math.clamp(s, 0.55, 1.25)
	root.Size = UDim2.fromScale(1 / uiScale.Scale, 1 / uiScale.Scale)
end
camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

---------------------------------------------------------------- top counters
local top = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(900, 64),
	BackgroundTransparency = 1, Parent = root }, { K.list(Enum.FillDirection.Horizontal, 14) })

local function pill(iconText, c1, c2, width)
	local f = K.new("Frame", { Size = UDim2.fromOffset(width, 58), BackgroundColor3 = Color3.new(1, 1, 1), Parent = top },
		{ K.corner(29), K.stroke(3), K.grad(c1, c2, 90) })
	local icon = K.new("Frame", { Size = UDim2.fromOffset(62, 62), Position = UDim2.fromOffset(-10, -2), BackgroundColor3 = Color3.new(1, 1, 1), Parent = f },
		{ K.round(), K.stroke(3), K.grad(c1:Lerp(Color3.new(1, 1, 1), 0.4), c1, 90) })
	K.label(iconText, UDim2.fromScale(0.7, 0.7), Color3.new(1, 1, 1), { Position = UDim2.fromScale(0.15, 0.15), Parent = icon })
	local main = K.label("0", UDim2.new(1, -66, 0.62, 0), Color3.new(1, 1, 1), { Position = UDim2.fromOffset(58, 3), TextXAlignment = Enum.TextXAlignment.Left, Parent = f })
	local sub = K.label("", UDim2.new(1, -66, 0.32, 0), Color3.fromRGB(255, 255, 220), { Position = UDim2.new(0, 58, 0.62, -2), TextXAlignment = Enum.TextXAlignment.Left, Parent = f })
	return f, main, sub, icon
end

local moneyPill, moneyLabel, incomeLabel, moneyIcon = pill("$", Color3.fromRGB(120, 230, 90), Color3.fromRGB(40, 160, 60), 260)
local powerPill, powerLabel, distLabel = pill("⚡", Color3.fromRGB(255, 200, 60), Color3.fromRGB(240, 120, 30), 220)
local strengthPill, strengthLabel, strengthSub = pill("💪", Color3.fromRGB(255, 110, 110), Color3.fromRGB(200, 40, 70), 200)
local carryPill, carryLabel, carrySub = pill("🐾", Color3.fromRGB(150, 120, 255), Color3.fromRGB(90, 60, 200), 170)
Effects.MoneyTarget = moneyIcon
Effects.OnCoinArrive = function() K.pop(moneyIcon, 1.25) end

local shownMoney = 0
RunService.RenderStepped:Connect(function(dt)
	local target = State.Data.Money or 0
	if math.abs(target - shownMoney) < 1 then shownMoney = target
	else shownMoney += (target - shownMoney) * math.min(1, dt * 8) end
	moneyLabel.Text = Format.Money(shownMoney)
end)

function HUD.Refresh()
	local d = State.Data
	incomeLabel.Text = "+" .. Format.Money(d.Income or 0) .. "/s"
	powerLabel.Text = math.floor(d.MaxDistance or 0) .. "m"
	distLabel.Text = "Throw Lv." .. (d.Upgrades and d.Upgrades.ThrowPower or 1)
	local newStr = Format.Short(d.Strength or 0)
	if strengthLabel.Text ~= newStr then
		strengthLabel.Text = newStr
		K.pop(strengthPill, 1.08)
	end
	strengthSub.Text = "Strength"
	if HUD._lastMax ~= d.MaxDistance and HUD.DrawTicks then
		HUD._lastMax = d.MaxDistance
		HUD.DrawTicks()
	end
	local carry = d.Carry and #d.Carry or 0
	local stored = #d.Creatures - #d.Placed
	carryLabel.Text = (#d.Placed) .. "/" .. (d.SlotsOpen or 0)
	carrySub.Text = "Bag " .. stored .. "/" .. (d.StorageCap or 0)
	HUD.SetCarry(carry)
end

---------------------------------------------------------------- side buttons
local side = K.new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(96, 560),
	BackgroundTransparency = 1, Parent = root }, { K.list(Enum.FillDirection.Vertical, 10) })
HUD.SideButtons = {}
function HUD.AddSideButton(name, icon, c1, c2, callback)
	local b = K.button("", c1, c2, UDim2.fromOffset(84, 70), { Parent = side, LayoutOrder = #HUD.SideButtons + 1 })
	b.Label.Text = icon
	b.Label.Size = UDim2.new(1, -12, 0.62, 0)
	K.label(name, UDim2.new(1, -4, 0.32, 0), Color3.new(1, 1, 1), { Position = UDim2.new(0, 2, 0.64, -2), Parent = b, ZIndex = 2 })
	b.Activated:Connect(callback)
	HUD.SideButtons[name] = b
	return b
end

---------------------------------------------------------------- POWER BOX (right side of the screen)
local powerBox = K.new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.45, 0), Size = UDim2.fromOffset(150, 430),
	BackgroundColor3 = Color3.new(1, 1, 1), Parent = root }, { K.corner(22), K.stroke(4), K.grad(Color3.fromRGB(120, 80, 220), Color3.fromRGB(60, 30, 130), 90) })
local meterScale = K.new("UIScale", { Scale = 1, Parent = powerBox })
K.label("⚡ POWER", UDim2.new(1, -16, 0, 34), Color3.fromRGB(255, 235, 120), { Position = UDim2.fromOffset(8, 6), Parent = powerBox })
-- the vertical bar
local meter = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 10, 0, 46), Size = UDim2.new(0, 46, 0, 280),
	BackgroundColor3 = Color3.fromRGB(30, 20, 50), Parent = powerBox }, { K.corner(14), K.stroke(3) })
-- zone ticks: where each zone starts at your current max distance
local ticks = K.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 3, Parent = meter })
local function drawTicks()
	ticks:ClearAllChildren()
	local maxD = (State.Data.MaxDistance or 45) * 1.15
	for _, id in ipairs(Config.WorldOrder) do
		local from = Config.ZoneBounds[id][1]
		if from > 0 and from < maxD then
			local y = 1 - from / maxD
			K.new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, y), Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = Config.Worlds[id].atmo, BorderSizePixel = 0, ZIndex = 4, Parent = ticks })
			K.label(Config.Worlds[id].name:match("%S+$"), UDim2.fromOffset(58, 16), Config.Worlds[id].atmo:Lerp(Color3.new(1, 1, 1), 0.4),
				{ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0, -4, y, 0), ZIndex = 4, Parent = ticks })
		end
	end
end
HUD.DrawTicks = drawTicks
local perfect = K.new("Frame", { Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(1, 0.08), BackgroundColor3 = Color3.fromRGB(255, 220, 80),
	BorderSizePixel = 0, ZIndex = 2, Parent = meter }, { K.corner(14) })
local fill = K.new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0), BackgroundColor3 = Color3.new(1, 1, 1),
	BorderSizePixel = 0, ZIndex = 2, Parent = meter },
	{ K.corner(14), K.new("UIGradient", { Rotation = -90, Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(90, 200, 255)), ColorSequenceKeypoint.new(0.6, Color3.fromRGB(170, 100, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 90, 160)) }) }) })
local marker = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 1), Size = UDim2.new(1, 18, 0, 9),
	BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 5, Parent = meter }, { K.corner(4), K.stroke(3) })
local meterText = K.label(isTouch and "Hold THROW" or "Hold Click / F", UDim2.new(1, -14, 0, 86), Color3.new(1, 1, 1),
	{ Position = UDim2.new(0, 7, 0, 334), Parent = powerBox, TextWrapped = true })
local perfectText = K.label("PERFECT!", UDim2.fromOffset(240, 56), Color3.fromRGB(255, 225, 90),
	{ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0, -10, 0, 70), Parent = powerBox, TextTransparency = 1 })
perfectText:FindFirstChildOfClass("UIStroke").Transparency = 1

HUD.TC = nil
local wasCharging = false
RunService.RenderStepped:Connect(function()
	local tc = HUD.TC
	if not tc then return end
	local p = tc.Power
	fill.Size = UDim2.fromScale(1, p)
	marker.Position = UDim2.fromScale(0.5, 1 - p)
	if tc.Charging then
		local dist = (State.Data.MaxDistance or 45) * p * (p >= 0.92 and 1.15 or 1)
		local luck = Config.LuckFromDistance(dist)
		meterText.Text = string.format("%d%%\n%dm\n%s\nLuck x%.2f", math.floor(p * 100), math.floor(dist),
			Config.Worlds[Config.WorldAt(Vector3.new(0, 0, dist))].name, luck)
		perfect.BackgroundColor3 = p >= 0.92 and Color3.fromRGB(255, 255, 160) or Color3.fromRGB(255, 220, 80)
		if not wasCharging then K.tween(meterScale, 0.25, { Scale = 1.06 }, Enum.EasingStyle.Back) end
	elseif wasCharging then
		K.tween(meterScale, 0.3, { Scale = 1 })
		meterText.Text = HUD.InZone and (isTouch and "Hold THROW" or "Hold Click / F") or "Go to the Launch Hall"
	end
	wasCharging = tc.Charging
end)

function HUD.ThrowFeedback(power, isPerfect)
	if isPerfect then
		perfectText.TextTransparency = 0
		local st = perfectText:FindFirstChildOfClass("UIStroke"); st.Transparency = 0
		K.pop(perfectText, 1.6)
		task.delay(0.8, function()
			K.tween(perfectText, 0.3, { TextTransparency = 1 })
			K.tween(st, 0.3, { Transparency = 1 })
		end)
	end
end

-- power bar floating over your head while charging
local headBB = K.new("BillboardGui", { Size = UDim2.fromOffset(170, 26), StudsOffset = Vector3.new(0, 3.6, 0), AlwaysOnTop = true, Enabled = false, ResetOnSpawn = false, Parent = gui })
local headBar = K.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(40, 30, 60), Parent = headBB }, { K.corner(13), K.stroke(3) })
K.new("Frame", { Position = UDim2.fromScale(0.92, 0), Size = UDim2.fromScale(0.08, 1), BackgroundColor3 = Color3.fromRGB(255, 220, 80), BorderSizePixel = 0, Parent = headBar }, { K.corner(13) })
local headFill = K.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = headBar },
	{ K.corner(13), K.grad(Color3.fromRGB(90, 220, 255), Color3.fromRGB(255, 90, 170), 0) })
RunService.RenderStepped:Connect(function()
	local tc = HUD.TC
	local head = player.Character and player.Character:FindFirstChild("Head")
	headBB.Adornee = head
	headBB.Enabled = tc ~= nil and tc.Charging and head ~= nil
	if headBB.Enabled then headFill.Size = UDim2.fromScale(tc.Power, 1) end
end)

---------------------------------------------------------------- training button
local trainBtn = K.button("💪 LIFT", Color3.fromRGB(255, 120, 90), Color3.fromRGB(210, 50, 60), UDim2.fromOffset(260, 74),
	{ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -150), Parent = root, Visible = false })
local autoBtn = K.button("AUTO: OFF", Color3.fromRGB(150, 150, 170), Color3.fromRGB(100, 100, 120), UDim2.fromOffset(140, 50),
	{ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0.5, 140, 1, -162), Parent = root, Visible = false })
HUD.TrainHeld, HUD.AutoTrain, HUD.TrainStation = false, false, nil
trainBtn.InputBegan:Connect(function(i)
	if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and HUD.TrainStation then HUD.TrainHeld = true end
end)
trainBtn.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then HUD.TrainHeld = false end
end)
autoBtn.Activated:Connect(function()
	HUD.AutoTrain = not HUD.AutoTrain
	K.setButton(autoBtn, HUD.AutoTrain and "AUTO: ON" or "AUTO: OFF", HUD.AutoTrain and Color3.fromRGB(110, 220, 90) or Color3.fromRGB(150, 150, 170),
		HUD.AutoTrain and Color3.fromRGB(40, 150, 60) or Color3.fromRGB(100, 100, 120))
end)
-- PERSONAL GYM: LIFT (hold) + AUTO + UPGRADE (buy the next equipment with money)
local upgradeBtn = K.button("⬆ UPGRADE", Color3.fromRGB(110, 220, 90), Color3.fromRGB(40, 150, 60), UDim2.fromOffset(300, 50),
	{ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -232), Parent = root, Visible = false })
HUD.OnUpgradeGym = nil
upgradeBtn.Activated:Connect(function() if HUD.OnUpgradeGym then HUD.OnUpgradeGym() end end)
-- level = your gym level when standing in your gym, or nil
function HUD.SetGym(level)
	HUD.TrainStation = level
	trainBtn.Visible = level ~= nil
	autoBtn.Visible = level ~= nil
	upgradeBtn.Visible = false
	if not level then HUD.TrainHeld = false return end
	local st = Config.TrainingStations[level]
	K.setButton(trainBtn, "💪 LIFT  +" .. Format.Short(st.gain), Color3.fromRGB(255, 120, 90), Color3.fromRGB(210, 50, 60))
	local nextSt = Config.TrainingStations[level + 1]
	if nextSt then
		local can = (State.Data.Money or 0) >= nextSt.price
		upgradeBtn.Visible = true
		K.setButton(upgradeBtn, "⬆ " .. nextSt.name .. "  " .. Format.Money(nextSt.price), can and Color3.fromRGB(110, 220, 90) or Color3.fromRGB(150, 150, 170),
			can and Color3.fromRGB(40, 150, 60) or Color3.fromRGB(100, 100, 120))
	end
end
function HUD.TrainPulse() K.pop(trainBtn, 1.12) end

---------------------------------------------------------------- collect popup (collect from anywhere)
local collectBtn = K.button("✨ COLLECT", Color3.fromRGB(120, 230, 255), Color3.fromRGB(60, 120, 255), UDim2.fromOffset(330, 64),
	{ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 124), Parent = root, Visible = false })
HUD.OnCollect = nil
local collectTarget = nil
collectBtn.Activated:Connect(function()
	if collectTarget and HUD.OnCollect then HUD.OnCollect(collectTarget) end
end)
function HUD.SetCollectable(throwId, name, color)
	local was = collectBtn.Visible
	collectTarget = throwId
	collectBtn.Visible = throwId ~= nil
	if throwId then
		K.setButton(collectBtn, "✨ COLLECT " .. name .. " ✨", color, color:Lerp(Color3.new(0, 0, 0), 0.35))
		if not was then K.pop(collectBtn, 1.25) end
	end
end
RunService.RenderStepped:Connect(function()
	if collectBtn.Visible then collectBtn.Rotation = math.sin(os.clock() * 5) * 2 end
end)

---------------------------------------------------------------- "throw from here" animation (limit reached / not on the throw line)
local throwHere = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(760, 210),
	BackgroundTransparency = 1, Visible = false, Parent = root })
local thScale = K.new("UIScale", { Scale = 0, Parent = throwHere })
local thTitle = K.label("🛑 YOU CAN'T GO FURTHER!", UDim2.new(1, 0, 0.42, 0), Color3.fromRGB(255, 90, 110), { Parent = throwHere })
local thSub = K.label("THROW YOUR PORTAL FROM HERE!", UDim2.new(1, 0, 0.32, 0), Color3.fromRGB(255, 230, 120), { Position = UDim2.fromScale(0, 0.42), Parent = throwHere })
local thArrow = K.label("⬇ ⬇ ⬇", UDim2.new(1, 0, 0.26, 0), Color3.new(1, 1, 1), { Position = UDim2.fromScale(0, 0.74), Parent = throwHere })
local thUntil = 0
function HUD.ShowThrowHere(title, sub)
	thTitle.Text = title or "🛑 YOU CAN'T GO FURTHER!"
	thSub.Text = sub or (isTouch and "Throw your portal from the Launch Hall — hold THROW!" or "Throw your portal from the Launch Hall — hold CLICK!")
	local wasVisible = throwHere.Visible and os.clock() < thUntil
	thUntil = os.clock() + 2.6
	throwHere.Visible = true
	if not wasVisible then
		thScale.Scale = 0
		K.tween(thScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		Sounds.Play("Error")
	end
	if HUD.ThrowButton then K.pop(HUD.ThrowButton, 1.2) end
end
RunService.RenderStepped:Connect(function()
	if not throwHere.Visible then return end
	local t = os.clock()
	throwHere.Rotation = math.sin(t * 6) * 2.5
	thArrow.Position = UDim2.fromScale(0, 0.74 + math.abs(math.sin(t * 5)) * 0.08)
	thTitle.TextColor3 = Color3.fromRGB(255, 90, 110):Lerp(Color3.fromRGB(255, 200, 90), (math.sin(t * 8) + 1) / 2)
	if t > thUntil and thScale.Scale > 0.99 then
		K.tween(thScale, 0.3, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.delay(0.3, function() if os.clock() > thUntil then throwHere.Visible = false end end)
	end
end)

-- meter/throw button react to whether you're standing on the throw line
HUD.InZone = true
function HUD.SetInZone(inZone)
	if HUD.InZone == inZone then return end
	HUD.InZone = inZone
	if not (HUD.TC and HUD.TC.Charging) then
		meterText.Text = inZone and (isTouch and "Hold THROW" or "Hold Click / F") or "Go to the Launch Hall"
		if inZone then
			HUD.ShowThrowHere("🌀 PORTAL LAUNCH HALL", isTouch and "Hold THROW, release to launch your portal!" or "Hold CLICK, release to launch your portal!")
		end
	end
end

-- big throw button (always shown on touch; smaller on PC)
local throwBtn = K.button("THROW", Color3.fromRGB(255, 120, 200), Color3.fromRGB(170, 60, 255),
	isTouch and UDim2.fromOffset(150, 150) or UDim2.fromOffset(120, 120),
	{ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -24), Parent = root })
throwBtn:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0)
throwBtn.Label.Size = UDim2.new(0.8, 0, 0.3, 0)
throwBtn.Label.Position = UDim2.fromScale(0.1, 0.35)
throwBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		if HUD.TC then HUD.TC.BeginCharge() end
	end
end)
throwBtn.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		if HUD.TC then HUD.TC.EndCharge() end
	end
end)
HUD.ThrowButton = throwBtn
RunService.RenderStepped:Connect(function()
	local r = throwBtn:FindFirstChild("UIStroke")
	if r then r.Color = (HUD.TC and HUD.TC.Charging) and Color3.fromRGB(255, 240, 120) or K.Dark end
	throwBtn.Label.TextTransparency = HUD.InZone and 0 or 0.55
end)

---------------------------------------------------------------- carry hint
local carryHint = K.label("", UDim2.fromOffset(520, 34), Color3.fromRGB(200, 255, 200),
	{ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 84), Parent = root, Visible = false })
function HUD.SetCarry(n)
	carryHint.Visible = n > 0
	carryHint.Text = "Carrying " .. n .. "/" .. Config.CarryLimit .. " creatures — bring them to your base! ➜"
end
RunService.RenderStepped:Connect(function()
	if carryHint.Visible then carryHint.Rotation = math.sin(os.clock() * 3) * 1.5 end
end)

---------------------------------------------------------------- toasts
local toastHolder = K.new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -184, 0, 90), Size = UDim2.fromOffset(380, 400),
	BackgroundTransparency = 1, Parent = root }, { K.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right) })
local KIND_COLORS = { info = Color3.fromRGB(110, 140, 255), error = Color3.fromRGB(255, 80, 90), money = Color3.fromRGB(80, 210, 90),
	discover = Color3.fromRGB(255, 170, 60), success = Color3.fromRGB(80, 210, 120) }
function HUD.Notify(text, kind)
	local col = KIND_COLORS[kind] or (Config.Rarities[kind] and Config.Rarities[kind].color) or KIND_COLORS.info
	if kind == "error" then Sounds.Play("Error") end
	local f = K.new("Frame", { Size = UDim2.fromOffset(380, 56), BackgroundColor3 = Color3.new(1, 1, 1), Parent = toastHolder },
		{ K.corner(14), K.stroke(3), K.grad(col:Lerp(Color3.new(1, 1, 1), 0.25), col:Lerp(Color3.new(0, 0, 0), 0.25), 90) })
	K.label(text, UDim2.new(1, -20, 1, -12), Color3.new(1, 1, 1), { Position = UDim2.fromOffset(10, 6), Parent = f })
	local s = K.new("UIScale", { Scale = 0, Parent = f })
	K.tween(s, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(4, function()
		K.tween(s, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.delay(0.3, function() f:Destroy() end)
	end)
	local kids = {}
	for _, c in ipairs(toastHolder:GetChildren()) do if c:IsA("Frame") then table.insert(kids, c) end end
	if #kids > 5 then kids[1]:Destroy() end
end

---------------------------------------------------------------- panel framework
local blur = Instance.new("BlurEffect"); blur.Size = 0; blur.Parent = game:GetService("Lighting")
local openPanel = nil
HUD.Panels = {}

function HUD.MakePanel(name, title, c1, c2)
	local frame = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.53), Size = UDim2.fromOffset(820, 540),
		BackgroundColor3 = K.Panel, Visible = false, Parent = root }, { K.corner(24), K.stroke(5) })
	local scale = K.new("UIScale", { Scale = 0, Parent = frame })
	local header = K.new("Frame", { Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = Color3.new(1, 1, 1), Parent = frame },
		{ K.corner(24), K.grad(c1, c2, 90) })
	K.new("Frame", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -20), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = header }, { K.grad(c2, c2, 90) })
	K.label(title, UDim2.new(1, -140, 0, 52), Color3.new(1, 1, 1), { Position = UDim2.fromOffset(24, 9), TextXAlignment = Enum.TextXAlignment.Left, Parent = header })
	local close = K.button("X", Color3.fromRGB(255, 90, 90), Color3.fromRGB(200, 40, 60), UDim2.fromOffset(54, 54),
		{ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Parent = header, ZIndex = 3 })
	local subbar = K.new("Frame", { Size = UDim2.new(1, -40, 0, 46), Position = UDim2.fromOffset(20, 80), BackgroundTransparency = 1, Parent = frame })
	local content = K.new("ScrollingFrame", { Size = UDim2.new(1, -32, 1, -146), Position = UDim2.fromOffset(16, 132), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = c2, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
		Parent = frame }, { K.pad(6) })
	local panel = { name = name, frame = frame, scale = scale, content = content, subbar = subbar, refresh = nil }
	close.Activated:Connect(function() HUD.Close() end)
	HUD.Panels[name] = panel
	return panel
end

function HUD.Open(name)
	local p = HUD.Panels[name]
	if not p then return end
	if openPanel == p then HUD.Close() return end
	if openPanel then
		local old = openPanel
		old.frame.Visible = false
		old.scale.Scale = 0
	end
	openPanel = p
	p.frame.Visible = true
	p.scale.Scale = 0.6
	p.frame.Position = UDim2.fromScale(0.5, 0.6)
	K.tween(p.scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	K.tween(p.frame, 0.35, { Position = UDim2.fromScale(0.5, 0.53) }, Enum.EasingStyle.Back)
	K.tween(blur, 0.3, { Size = 12 })
	if p.refresh then p.refresh() end
end

function HUD.Close()
	local p = openPanel
	if not p then return end
	openPanel = nil
	K.tween(p.scale, 0.2, { Scale = 0.6 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	K.tween(blur, 0.25, { Size = 0 })
	task.delay(0.2, function() if openPanel ~= p then p.frame.Visible = false end end)
end

function HUD.IsOpen(name) return openPanel ~= nil and openPanel.name == name end

State.Changed:Connect(function(full)
	HUD.Refresh()
	if full and openPanel and openPanel.refresh then openPanel.refresh() end
end)

return HUD
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">Intro</string><ProtectedString name="Source"><![CDATA[-- Intro: cinematic fly-over when you join. The camera sweeps down the whole lane (every zone),
-- past the Portal Launch Hall, and lands at your base while the title animates in.
-- Click / tap / any key to skip.
-- Location: StarterPlayer > StarterPlayerScripts > Client > Intro (ModuleScript)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local K = require(script.Parent.UIKit)
local Effects = require(script.Parent.Effects)
local Sounds = require(script.Parent.Sounds)

local Intro = {}
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local function catmull(p0, p1, p2, p3, t)
	local t2, t3 = t * t, t * t * t
	return 0.5 * ((2 * p1) + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 + (-p0 + 3 * p1 - 3 * p2 + p3) * t3)
end
local function smooth(k) return k * k * (3 - 2 * k) end

function Intro.Play(hud)
	-- wait for the world and our base to exist
	local t0 = os.clock()
	while not workspace:FindFirstChild("Map") and os.clock() - t0 < 30 do task.wait(0.2) end
	local idx
	repeat idx = player:GetAttribute("BaseIndex"); task.wait(0.2) until (idx and idx > 0) or os.clock() - t0 > 30
	local base = workspace:FindFirstChild("Bases") and workspace.Bases:FindFirstChild("Base" .. tostring(idx))
	local char = player.Character or player.CharacterAdded:Wait()
	char:WaitForChild("HumanoidRootPart", 10)
	task.wait(0.5)

	-- camera path: positions + where it looks
	local pts, looks = {}, {}
	local function key(pos, look) table.insert(pts, pos); table.insert(looks, look) end
	key(Vector3.new(0, 170, 3050), Vector3.new(0, 20, 2500))   -- high above Heaven
	key(Vector3.new(50, 110, 2050), Vector3.new(0, 10, 1500))  -- Shadow / Space
	key(Vector3.new(-40, 70, 1150), Vector3.new(0, 5, 700))    -- Candy / Crystal
	key(Vector3.new(30, 40, 380), Vector3.new(0, 5, 60))       -- Frozen / Volcano
	key(Vector3.new(0, 22, 45), Vector3.new(0, 10, -30))       -- the Launch Hall's open front
	if base then
		local c = base.Center.CFrame
		key((c * CFrame.new(0, 26, -55)).Position, c.Position + Vector3.new(0, 4, 0)) -- swing over to your base
	end
	-- end just behind your character, where the normal camera will take over
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then
		key(hrp.Position - hrp.CFrame.LookVector * 14 + Vector3.new(0, 7, 0), hrp.Position + Vector3.new(0, 2, 0))
	end

	-- UI: black fade, title, skip hint
	local gui = K.new("ScreenGui", { Name = "Intro", IgnoreGuiInset = true, ResetOnSpawn = false, DisplayOrder = 50, Parent = player.PlayerGui })
	local black = K.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = gui })
	local title = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.fromScale(0.8, 0.22), BackgroundTransparency = 1, Parent = gui })
	local titleScale = K.new("UIScale", { Scale = 0, Parent = title })
	local line1 = K.label("THROW PORTALS", UDim2.fromScale(1, 0.55), Color3.new(1, 1, 1), { Parent = title })
	K.new("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 140, 220)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(170, 120, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(110, 220, 255)) }), Parent = line1 })
	line1:FindFirstChildOfClass("UIStroke").Thickness = 5
	local line2 = K.label("FOR CREATURES", UDim2.fromScale(1, 0.4), Color3.fromRGB(255, 230, 120), { Position = UDim2.fromScale(0, 0.58), Parent = title })
	local sub = K.label("Throw  •  Catch  •  Collect", UDim2.fromScale(0.5, 0.05), Color3.new(1, 1, 1),
		{ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.5), Parent = gui, TextTransparency = 1 })
	local skip = K.label("Click to skip ⏭", UDim2.fromOffset(240, 34), Color3.fromRGB(230, 230, 230),
		{ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -20, 1, -20), Parent = gui })

	if hud then hud.Enabled = false end
	Effects.Letterbox(true)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(pts[1], looks[1])
	K.tween(black, 1.2, { BackgroundTransparency = 1 })
	task.delay(0.6, function()
		K.tween(titleScale, 0.8, { Scale = 1 }, Enum.EasingStyle.Back)
		Sounds.Play("Rare", 0.9)
	end)
	task.delay(1.6, function() K.tween(sub, 0.6, { TextTransparency = 0 }) end)

	local skipped = false
	local conn = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.Keyboard then
			skipped = true
		end
	end)

	local DURATION = 11
	local start = os.clock()
	local segs = #pts - 1
	while not skipped do
		local k = (os.clock() - start) / DURATION
		if k >= 1 then break end
		local e = smooth(k) * segs
		local i = math.min(math.floor(e) + 1, segs)
		local f = e - (i - 1)
		local function at(list, j) return list[math.clamp(j, 1, #list)] end
		local pos = catmull(at(pts, i - 1), at(pts, i), at(pts, i + 1), at(pts, i + 2), f)
		local look = catmull(at(looks, i - 1), at(looks, i), at(looks, i + 1), at(looks, i + 2), f)
		camera.CFrame = CFrame.lookAt(pos, look)
		if k > 0.62 and titleScale.Scale > 0.99 then
			K.tween(titleScale, 0.6, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			K.tween(sub, 0.4, { TextTransparency = 1 })
		end
		RunService.RenderStepped:Wait()
	end
	conn:Disconnect()

	-- hand the camera back to the player
	Effects.Letterbox(false)
	camera.CameraType = Enum.CameraType.Custom
	if hud then hud.Enabled = true end
	K.tween(titleScale, 0.3, { Scale = 0 })
	K.tween(sub, 0.3, { TextTransparency = 1 })
	K.tween(skip, 0.3, { TextTransparency = 1 })
	Effects.Flash(Color3.new(1, 1, 1), 0.6, 0.35)
	Sounds.Play("Whoosh", 1.2)
	task.delay(0.6, function() gui:Destroy() end)
end

return Intro
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">Panels</string><ProtectedString name="Source"><![CDATA[-- Panels: Portal Shop, Upgrades, Creatures (inventory), Index, Worlds and Base customization.
-- Location: StarterPlayer > StarterPlayerScripts > Client > Panels (ModuleScript)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CreatureData = require(Shared.CreatureData)
local PortalBuilder = require(Shared.PortalBuilder)
local Format = require(Shared.Format)
local Odds = require(Shared.Odds)
local K = require(script.Parent.UIKit)
local HUD = require(script.Parent.HUD)
local State = require(script.Parent.ClientState)
local Sounds = require(script.Parent.Sounds)
local Effects = require(script.Parent.Effects)
local Renderer = require(script.Parent.CreatureRenderer)

local Panels = {}
local GREEN, GREEN2 = Color3.fromRGB(110, 220, 90), Color3.fromRGB(40, 150, 60)
local GREY, GREY2 = Color3.fromRGB(170, 170, 185), Color3.fromRGB(110, 110, 125)
local BLUE, BLUE2 = Color3.fromRGB(90, 170, 255), Color3.fromRGB(50, 90, 220)
local GOLD, GOLD2 = Color3.fromRGB(255, 210, 70), Color3.fromRGB(235, 140, 30)

local function request(action, arg, successText)
	local ok, msg = State.Request(action, arg)
	if ok then
		Sounds.Play("Upgrade")
		if successText or msg then HUD.Notify(msg or successText, "success") end
	else
		HUD.Notify(msg or "Can't do that", "error")
	end
	return ok
end

local function grid(content, cell, pad)
	content:ClearAllChildren()
	K.pad(6).Parent = content
	K.new("UIGridLayout", { CellSize = cell, CellPadding = pad or UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = content })
end
local function vlist(content)
	content:ClearAllChildren()
	K.pad(6).Parent = content
	K.list(Enum.FillDirection.Vertical, 10).Parent = content
end

local function card(parent, order, accent)
	return K.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = order, Parent = parent },
		{ K.corner(16), K.stroke(3), K.grad(Color3.new(1, 1, 1), accent:Lerp(Color3.new(1, 1, 1), 0.6), 90) })
end

-- creature preview cache (cloning is far cheaper than rebuilding)
local previewCache = {}
local function creatureViewport(id, size, silhouette)
	if not previewCache[id] then previewCache[id] = (Renderer.BuildPreview(id)) end
	return K.viewport(previewCache[id]:Clone(), size, false, silhouette)
end

---------------------------------------------------------------- PORTAL SHOP
local shop = HUD.MakePanel("Portals", "🌀 Portal Shop", Color3.fromRGB(170, 110, 255), Color3.fromRGB(100, 50, 220))
local function oddsText(P)
	local parts, total = {}, 0
	for _, w in pairs(P.weights) do total += w end
	for _, r in ipairs(Config.RarityOrder) do
		local w = P.weights[r]
		if w then
			local pct = w / total * 100
			local hexc = Config.Rarities[r].color:ToHex()
			table.insert(parts, string.format("<font color='#%s'>%s %s%%</font>", hexc, r, pct >= 1 and string.format("%d", math.floor(pct + 0.5)) or string.format("%.1f", pct)))
		end
	end
	return table.concat(parts, "  ")
end
shop.refresh = function()
	local d = State.Data
	grid(shop.content, UDim2.fromOffset(240, 300))
	for i, id in ipairs(Config.PortalOrder) do
		local P = Config.Portals[id]
		local c = card(shop.content, i, P.color)
		local gate = PortalBuilder.BuildGate(id, 3)
		local vp = K.viewport(gate, UDim2.new(1, -20, 0, 130), true)
		vp.Position = UDim2.fromOffset(10, 6)
		vp.Parent = c
		K.label(P.name, UDim2.new(1, -16, 0, 30), Color3.new(1, 1, 1), { Position = UDim2.fromOffset(8, 138), Parent = c })
		local odds = K.label(oddsText(P), UDim2.new(1, -16, 0, 56), Color3.new(1, 1, 1), { Position = UDim2.fromOffset(8, 170), Parent = c, TextWrapped = true })
		odds.TextScaled = true
		local owned, equipped = d.OwnedPortals[id], d.EquippedPortal == id
		local text = equipped and "EQUIPPED" or (owned and "EQUIP" or Format.Money(P.price))
		local c1, c2 = GREEN, GREEN2
		if equipped then c1, c2 = GREY, GREY2 elseif owned then c1, c2 = BLUE, BLUE2 elseif d.Money < P.price then c1, c2 = Color3.fromRGB(255, 110, 110), Color3.fromRGB(200, 50, 70) end
		local b = K.button(text, c1, c2, UDim2.new(1, -24, 0, 48), { Position = UDim2.new(0, 12, 1, -58), Parent = c })
		b.Activated:Connect(function()
			if equipped then return end
			if owned then request("EquipPortal", id) else
				if request("BuyPortal", id, "Bought " .. P.name .. "!") then
					Effects.Flash(P.color, 0.4, 0.35)
					Effects.Coins(nil, 8)
				end
			end
		end)
	end
end

---------------------------------------------------------------- UPGRADES
local upg = HUD.MakePanel("Upgrades", "⬆ Upgrades", Color3.fromRGB(255, 190, 60), Color3.fromRGB(235, 110, 30))
local UPG_ORDER = { "ThrowPower", "BaseSlots", "Storage", "Training" }
local UPG_ICON = { ThrowPower = "⚡", BaseSlots = "🏠", Storage = "🎒", Training = "💪" }
local function upgradeEffect(kind, lvl)
	if kind == "ThrowPower" then return math.floor(Config.ThrowDistance(lvl, State.Data.Strength or 0)) .. "m throw" end
	if kind == "BaseSlots" then return (Config.StartSlots + lvl) .. " slots" end
	if kind == "Storage" then return (Config.StartStorage + lvl * Config.StoragePerLevel) .. " storage" end
	if kind == "Training" then return "+" .. math.floor(lvl * Config.TrainingBonus * 100) .. "% income" end
	return ""
end
upg.refresh = function()
	local d = State.Data
	vlist(upg.content)
	for i, kind in ipairs(UPG_ORDER) do
		local U = Config.Upgrades[kind]
		local lvl = d.Upgrades[kind]
		local idx = kind == "ThrowPower" and lvl - 1 or lvl
		local maxed = idx >= U.max
		local cost = Config.UpgradeCost(kind, idx)
		local row = card(upg.content, i, GOLD)
		row.Size = UDim2.new(1, -12, 0, 100)
		local icon = K.new("Frame", { Size = UDim2.fromOffset(76, 76), Position = UDim2.fromOffset(12, 12), BackgroundColor3 = Color3.new(1, 1, 1), Parent = row },
			{ K.corner(16), K.stroke(3), K.grad(GOLD, GOLD2, 90) })
		K.label(UPG_ICON[kind], UDim2.fromScale(0.7, 0.7), nil, { Position = UDim2.fromScale(0.15, 0.15), Parent = icon })
		K.label(U.name .. "  <font color='#FFE38A'>Lv." .. idx .. "/" .. U.max .. "</font>", UDim2.new(0.55, 0, 0, 34), nil,
			{ Position = UDim2.fromOffset(104, 10), TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		K.label(U.desc, UDim2.new(0.55, 0, 0, 22), Color3.fromRGB(90, 70, 120),
			{ Position = UDim2.fromOffset(104, 44), TextXAlignment = Enum.TextXAlignment.Left, Parent = row }):FindFirstChildOfClass("UIStroke"):Destroy()
		K.label(upgradeEffect(kind, lvl) .. (maxed and "" or ("  ➜  <font color='#7CFF8A'>" .. upgradeEffect(kind, lvl + 1) .. "</font>")), UDim2.new(0.55, 0, 0, 24), nil,
			{ Position = UDim2.fromOffset(104, 68), TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		local affordable = d.Money >= cost
		local b = K.button(maxed and "MAX" or Format.Money(cost), maxed and GREY or (affordable and GREEN or Color3.fromRGB(255, 110, 110)),
			maxed and GREY2 or (affordable and GREEN2 or Color3.fromRGB(200, 50, 70)), UDim2.fromOffset(170, 60),
			{ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0), Parent = row })
		b.Activated:Connect(function()
			if maxed then return end
			if request("Upgrade", kind) then
				K.pop(row, 1.05)
				Effects.Burst((workspace.CurrentCamera.CFrame * CFrame.new(0, 0, -10)).Position, GOLD, 25, 10, 0.6)
			end
		end)
	end
end

---------------------------------------------------------------- CREATURES (inventory)
local inv = HUD.MakePanel("Creatures", "🐾 My Creatures", Color3.fromRGB(110, 200, 255), Color3.fromRGB(50, 120, 230))
local selectedUid = nil
local invInfo = K.label("", UDim2.new(0.5, 0, 1, 0), Color3.fromRGB(70, 50, 110), { TextXAlignment = Enum.TextXAlignment.Left, Parent = inv.subbar })
invInfo:FindFirstChildOfClass("UIStroke"):Destroy()
local bestBtn = K.button("⭐ Equip Best", GOLD, GOLD2, UDim2.fromOffset(170, 44), { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Parent = inv.subbar })
bestBtn.Activated:Connect(function() request("EquipBest", nil, "Placed your best creatures!") end)

local actionBar = K.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 70), Size = UDim2.fromOffset(560, 64),
	BackgroundColor3 = K.Panel, Visible = false, Parent = inv.frame }, { K.corner(18), K.stroke(4) })
local actionName = K.label("", UDim2.new(0.4, 0, 1, -16), Color3.new(1, 1, 1), { Position = UDim2.fromOffset(12, 8), TextXAlignment = Enum.TextXAlignment.Left, Parent = actionBar })
local placeBtn = K.button("Place", GREEN, GREEN2, UDim2.fromOffset(150, 48), { Position = UDim2.new(0.42, 0, 0, 8), Parent = actionBar })
local sellBtn = K.button("Sell", Color3.fromRGB(255, 110, 110), Color3.fromRGB(200, 50, 70), UDim2.fromOffset(150, 48), { Position = UDim2.new(0.42, 160, 0, 8), Parent = actionBar })
local sellArmed = false
placeBtn.Activated:Connect(function()
	if not selectedUid then return end
	if State.IsPlaced(selectedUid) then request("Unplace", selectedUid) else request("Place", selectedUid) end
end)
sellBtn.Activated:Connect(function()
	if not selectedUid then return end
	if not sellArmed then
		sellArmed = true
		K.setButton(sellBtn, "Confirm?")
		task.delay(2.5, function() sellArmed = false; K.setButton(sellBtn, "Sell") end)
		return
	end
	sellArmed = false
	K.setButton(sellBtn, "Sell")
	if request("Sell", selectedUid) then
		selectedUid = nil
		actionBar.Visible = false
		Effects.Coins(nil, 10)
	end
end)

local function selectCreature(entry)
	selectedUid = entry.u
	local def = CreatureData.ById[entry.c]
	actionBar.Visible = true
	actionName.Text = def.name
	actionName.TextColor3 = Config.Rarities[def.rarity].color
	K.setButton(placeBtn, State.IsPlaced(entry.u) and "Remove" or "Place", State.IsPlaced(entry.u) and BLUE or GREEN, State.IsPlaced(entry.u) and BLUE2 or GREEN2)
	K.pop(actionBar, 1.06)
end

inv.refresh = function()
	local d = State.Data
	invInfo.Text = string.format("In base: %d/%d   •   Storage: %d/%d   •   +%s/s", #d.Placed, d.SlotsOpen, #d.Creatures - #d.Placed, d.StorageCap, Format.Money(d.Income))
	grid(inv.content, UDim2.fromOffset(140, 170))
	local list = table.clone(d.Creatures)
	table.sort(list, function(a, b)
		local pa, pb = State.IsPlaced(a.u), State.IsPlaced(b.u)
		if pa ~= pb then return pa end
		return CreatureData.Income(a.c) > CreatureData.Income(b.c)
	end)
	if #list == 0 then
		K.label("No creatures yet! Throw a portal to find one.", UDim2.fromOffset(500, 40), Color3.fromRGB(90, 70, 120), { Parent = inv.content })
	end
	for i, entry in ipairs(list) do
		local def = CreatureData.ById[entry.c]
		if def then
			local rc = Config.Rarities[def.rarity]
			local c = K.new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = i, Parent = inv.content },
				{ K.corner(16), K.stroke(selectedUid == entry.u and 5 or 3, selectedUid == entry.u and Color3.fromRGB(255, 220, 60) or K.Dark),
					K.grad(Color3.new(1, 1, 1), rc.color:Lerp(Color3.new(1, 1, 1), 0.35), 90) })
			local vp = creatureViewport(entry.c, UDim2.new(1, -10, 0, 100))
			vp.Position = UDim2.fromOffset(5, 4)
			vp.Parent = c
			K.label(def.name, UDim2.new(1, -8, 0, 24), Color3.new(1, 1, 1), { Position = UDim2.fromOffset(4, 104), Parent = c })
			K.label(Format.Money(CreatureData.Income(entry.c)) .. "/s", UDim2.new(1, -8, 0, 20), Color3.fromRGB(150, 255, 150), { Position = UDim2.fromOffset(4, 128), Parent = c })
			K.label(def.rarity, UDim2.new(1, -8, 0, 16), rc.color, { Position = UDim2.fromOffset(4, 149), Parent = c })
			if State.IsPlaced(entry.u) then
				local badge = K.new("Frame", { Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(-6, -6), BackgroundColor3 = GREEN, Parent = c, ZIndex = 3 }, { K.round(), K.stroke(2) })
				K.label("✓", UDim2.fromScale(0.8, 0.8), nil, { Position = UDim2.fromScale(0.1, 0.1), Parent = badge, ZIndex = 4 })
			end
			c.Activated:Connect(function()
				Sounds.Play("Click")
				selectCreature(entry)
				inv.refresh()
			end)
		end
	end
	if selectedUid then
		local still = false
		for _, e in ipairs(d.Creatures) do if e.u == selectedUid then still = true; selectCreature(e) end end
		if not still then selectedUid = nil; actionBar.Visible = false end
	end
end

---------------------------------------------------------------- INDEX
local idx = HUD.MakePanel("Index", "📖 Creature Index", Color3.fromRGB(255, 130, 190), Color3.fromRGB(210, 60, 140))
local idxFilter = "Forest"
local tabs = K.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = idx.subbar }, { K.list(Enum.FillDirection.Horizontal, 6) })
local idxCount = nil
local filters = table.clone(Config.WorldOrder)
table.insert(filters, "Any")
for i, w in ipairs(filters) do
	local name = w == "Any" and "Special" or Config.Worlds[w].name:gsub(" World", ""):gsub("Green ", ""):gsub(" Kingdom", ""):gsub(" Dimension", ""):gsub(" Galaxy", ""):gsub(" Caves", "")
	local b = K.button(name, Color3.fromRGB(255, 160, 210), Color3.fromRGB(220, 90, 160), UDim2.fromOffset(82, 40), { LayoutOrder = i, Parent = tabs })
	b.Activated:Connect(function() idxFilter = w; idx.refresh() end)
end
idx.refresh = function()
	local d = State.Data
	grid(idx.content, UDim2.fromOffset(140, 180))
	local total, found = #CreatureData.List, 0
	for _ in pairs(d.Discovered) do found += 1 end
	K.label(string.format("Discovered %d / %d\n\nOdds use your equipped portal", found, total), UDim2.new(1, -20, 0, 34), Color3.fromRGB(90, 60, 130),
		{ LayoutOrder = 0, Parent = idx.content, Size = UDim2.fromOffset(140, 180), TextWrapped = true })
	for i, def in ipairs(CreatureData.ByWorld[idxFilter] or {}) do
		local known = d.Discovered[def.id]
		local rc = Config.Rarities[def.rarity]
		local c = card(idx.content, i, known and rc.color or GREY)
		local vp = creatureViewport(def.id, UDim2.new(1, -10, 0, 104), not known)
		vp.Position = UDim2.fromOffset(5, 4)
		vp.Parent = c
		K.label(known and def.name or "???", UDim2.new(1, -8, 0, 24), Color3.new(1, 1, 1), { Position = UDim2.fromOffset(4, 108), Parent = c })
		K.label(def.rarity, UDim2.new(1, -8, 0, 20), rc.color, { Position = UDim2.fromOffset(4, 132), Parent = c })
		-- "1 in X" with your equipped portal and your best throw
		local p = Odds.ChanceFor(def.id, d.EquippedPortal, (d.MaxDistance or 45) * 1.15)
		K.label(p > 0 and Odds.OneIn(p) or "Better portal needed", UDim2.new(1, -8, 0, 20), Color3.fromRGB(255, 240, 160), { Position = UDim2.fromOffset(4, 154), Parent = c })
		if known then
			c.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					HUD.Notify(def.name .. ": " .. def.desc, def.rarity)
				end
			end)
		end
	end
end

---------------------------------------------------------------- WORLDS
local worlds = HUD.MakePanel("Worlds", "📏 Zones", Color3.fromRGB(100, 220, 200), Color3.fromRGB(30, 150, 160))
worlds.refresh = function()
	local d = State.Data
	vlist(worlds.content)
	local maxD = (d.MaxDistance or 45) * 1.15
	local tip = card(worlds.content, 0, GOLD)
	tip.Size = UDim2.new(1, -12, 0, 60)
	K.label(string.format("Your best throw reaches <font color='#FFE38A'>%dm</font>. Train and upgrade Throw Power to reach new zones!", math.floor(maxD)),
		UDim2.new(1, -24, 1, -12), nil, { Position = UDim2.fromOffset(12, 6), Parent = tip })
	for i, id in ipairs(Config.WorldOrder) do
		local W = Config.Worlds[id]
		local b = Config.ZoneBounds[id]
		local reach = maxD >= b[1]
		local row = card(worlds.content, i, W.groundColor)
		row.Size = UDim2.new(1, -12, 0, 92)
		local sw = K.new("Frame", { Size = UDim2.fromOffset(70, 70), Position = UDim2.fromOffset(12, 11), BackgroundColor3 = Color3.new(1, 1, 1), Parent = row },
			{ K.corner(16), K.stroke(3), K.grad(W.groundColor:Lerp(Color3.new(1, 1, 1), 0.3), W.atmo, 90) })
		K.label(reach and tostring(i) or "🔒", UDim2.fromScale(0.6, 0.6), nil, { Position = UDim2.fromScale(0.2, 0.2), Parent = sw })
		K.label(W.name .. "  <font color='#FFE38A'>" .. b[1] .. "m – " .. b[2] .. "m</font>", UDim2.new(0.62, 0, 0, 36), nil,
			{ Position = UDim2.fromOffset(96, 10), TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		local found, total = 0, 0
		for _, c in ipairs(CreatureData.ByWorld[id] or {}) do
			total += 1
			if d.Discovered[c.id] then found += 1 end
		end
		K.label(string.format("%s  •  Creatures found: %d/%d  •  x%s income", reach and "In range!" or ("Need a " .. b[1] .. "m throw"), found, total, Format.Short(W.incomeMult)),
			UDim2.new(0.8, 0, 0, 26), reach and Color3.fromRGB(180, 255, 180) or Color3.fromRGB(255, 200, 200),
			{ Position = UDim2.fromOffset(96, 50), TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
	end
end

---------------------------------------------------------------- ADMIN
local admin = HUD.MakePanel("Admin", "🛠 Admin Panel", Color3.fromRGB(255, 90, 90), Color3.fromRGB(160, 30, 60))
local function adminCmd(cmd, value)
	local json = game:GetService("HttpService"):JSONEncode({ cmd = cmd, value = value })
	request("Admin", json)
end
admin.refresh = function()
	vlist(admin.content)
	local amountRow = card(admin.content, 1, Color3.fromRGB(255, 120, 120))
	amountRow.Size = UDim2.new(1, -12, 0, 70)
	K.label("Amount:", UDim2.fromOffset(120, 40), nil, { Position = UDim2.fromOffset(14, 15), Parent = amountRow })
	local box = K.new("TextBox", { Text = "1000000", PlaceholderText = "number / creature id", Font = K.Font, TextScaled = true, ClearTextOnFocus = false,
		Size = UDim2.new(1, -160, 0, 46), Position = UDim2.fromOffset(140, 12), BackgroundColor3 = Color3.new(1, 1, 1), TextColor3 = K.Dark, Parent = amountRow },
		{ K.corner(12), K.stroke(3) })
	local function val() return tonumber(box.Text) or box.Text end

	local btns = K.new("Frame", { Size = UDim2.new(1, -12, 0, 240), BackgroundTransparency = 1, LayoutOrder = 2, Parent = admin.content },
		{ K.new("UIGridLayout", { CellSize = UDim2.fromOffset(180, 52), CellPadding = UDim2.fromOffset(10, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center }) })
	local function add(text, c1, c2, fn)
		local b = K.button(text, c1, c2, nil, { Parent = btns })
		b.Activated:Connect(fn)
	end
	add("+ Money", GREEN, GREEN2, function() adminCmd("money", val()) end)
	add("- Money", Color3.fromRGB(255, 110, 110), Color3.fromRGB(200, 50, 70), function() adminCmd("money", -(tonumber(box.Text) or 0)) end)
	add("+ Strength", Color3.fromRGB(255, 120, 90), Color3.fromRGB(210, 50, 60), function() adminCmd("strength", val()) end)
	add("Set Throw Lv", GOLD, GOLD2, function() adminCmd("throwlevel", val()) end)
	add("Max Upgrades", GOLD, GOLD2, function() adminCmd("maxupgrades") end)
	add("All Portals", Color3.fromRGB(180, 120, 255), Color3.fromRGB(110, 60, 220), function() adminCmd("allportals") end)
	add("Complete Index", Color3.fromRGB(255, 140, 200), Color3.fromRGB(210, 60, 140), function() adminCmd("discoverall") end)
	add("WalkSpeed", BLUE, BLUE2, function() adminCmd("speed", val()) end)
	add("Give Creature (id)", BLUE, BLUE2, function() adminCmd("give", box.Text) end)
	add("Force Next Throw (id)", Color3.fromRGB(255, 160, 60), Color3.fromRGB(210, 90, 30), function() adminCmd("forcenext", box.Text) end)
	local resetArmed = false
	add("RESET MY DATA", Color3.fromRGB(90, 90, 100), Color3.fromRGB(40, 40, 50), function()
		if not resetArmed then
			resetArmed = true
			HUD.Notify("Click RESET again within 3s to wipe your data", "error")
			task.delay(3, function() resetArmed = false end)
			return
		end
		resetArmed = false
		adminCmd("reset")
	end)

	K.label("Teleport to zone", UDim2.new(1, -12, 0, 30), Color3.fromRGB(160, 40, 70), { LayoutOrder = 3, Parent = admin.content })
	local tp = K.new("Frame", { Size = UDim2.new(1, -12, 0, 130), BackgroundTransparency = 1, LayoutOrder = 4, Parent = admin.content },
		{ K.new("UIGridLayout", { CellSize = UDim2.fromOffset(170, 50), CellPadding = UDim2.fromOffset(10, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center }) })
	local zoneIds = { "Start" }
	for _, id in ipairs(Config.WorldOrder) do table.insert(zoneIds, id) end
	for _, id in ipairs(zoneIds) do
		local W = Config.Worlds[id]
		local c = W and W.atmo or GREEN
		local b = K.button(W and W.name or "Start", c, c:Lerp(Color3.new(0, 0, 0), 0.35), nil, { Parent = tp })
		b.Activated:Connect(function() adminCmd("zone", id); HUD.Close() end)
	end

	K.label("Give creature (click one)", UDim2.new(1, -12, 0, 30), Color3.fromRGB(160, 40, 70), { LayoutOrder = 5, Parent = admin.content })
	local list = K.new("Frame", { Size = UDim2.new(1, -12, 0, math.ceil(#CreatureData.List / 4) * 46), BackgroundTransparency = 1, LayoutOrder = 6, Parent = admin.content },
		{ K.new("UIGridLayout", { CellSize = UDim2.fromOffset(180, 38), CellPadding = UDim2.fromOffset(8, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center }) })
	for _, def in ipairs(CreatureData.List) do
		local rc = Config.Rarities[def.rarity].color
		local b = K.button(def.name, rc, rc:Lerp(Color3.new(0, 0, 0), 0.35), nil, { Parent = list })
		b.Activated:Connect(function() adminCmd("give", def.id) end)
	end
end

---------------------------------------------------------------- BASE CUSTOMIZATION
local basePanel = HUD.MakePanel("Base", "🏡 Decorate Base", Color3.fromRGB(150, 220, 110), Color3.fromRGB(70, 160, 70))
basePanel.refresh = function()
	local d = State.Data
	vlist(basePanel.content)
	K.label("Decorations", UDim2.new(1, -12, 0, 34), Color3.fromRGB(70, 130, 60), { LayoutOrder = 0, Parent = basePanel.content })
	for i, id in ipairs(Config.DecorOrder) do
		local D = Config.Decor[id]
		local row = card(basePanel.content, i, GREEN)
		row.Size = UDim2.new(1, -12, 0, 64)
		K.label(D.name, UDim2.new(0.6, 0, 0, 40), nil, { Position = UDim2.fromOffset(16, 12), TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		local owned = d.Decor[id]
		local b = K.button(owned and "OWNED" or Format.Money(D.price), owned and GREY or GREEN, owned and GREY2 or GREEN2, UDim2.fromOffset(160, 48),
			{ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Parent = row })
		b.Activated:Connect(function() if not owned then request("BuyDecor", id, D.name .. " added to your base!") end end)
	end
	K.label("Floor Themes", UDim2.new(1, -12, 0, 34), Color3.fromRGB(70, 130, 60), { LayoutOrder = 50, Parent = basePanel.content })
	for i, t in ipairs(Config.FloorThemes) do
		local row = card(basePanel.content, 50 + i, t.color)
		row.Size = UDim2.new(1, -12, 0, 64)
		K.label(t.name, UDim2.new(0.6, 0, 0, 40), nil, { Position = UDim2.fromOffset(16, 12), TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		local active, owned = d.FloorTheme == t.id, d.OwnedFloors[t.id]
		local b = K.button(active and "ACTIVE" or (owned and "USE" or Format.Money(t.price)), active and GREY or (owned and BLUE or GREEN),
			active and GREY2 or (owned and BLUE2 or GREEN2), UDim2.fromOffset(160, 48), { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Parent = row })
		b.Activated:Connect(function() if not active then request("Floor", t.id) end end)
	end
end

---------------------------------------------------------------- side buttons
function Panels.Init()
	HUD.AddSideButton("Shop", "🌀", Color3.fromRGB(180, 120, 255), Color3.fromRGB(110, 60, 220), function() HUD.Open("Portals") end)
	HUD.AddSideButton("Upgrade", "⬆", Color3.fromRGB(255, 200, 70), Color3.fromRGB(235, 120, 30), function() HUD.Open("Upgrades") end)
	HUD.AddSideButton("Pets", "🐾", Color3.fromRGB(110, 200, 255), Color3.fromRGB(50, 120, 230), function() HUD.Open("Creatures") end)
	HUD.AddSideButton("Index", "📖", Color3.fromRGB(255, 140, 200), Color3.fromRGB(210, 60, 140), function() HUD.Open("Index") end)
	HUD.AddSideButton("Zones", "📏", Color3.fromRGB(100, 220, 200), Color3.fromRGB(30, 150, 160), function() HUD.Open("Worlds") end)
	HUD.AddSideButton("Base", "🏡", Color3.fromRGB(150, 220, 110), Color3.fromRGB(70, 160, 70), function() HUD.Open("Base") end)
	HUD.AddSideButton("Home", "🏠", Color3.fromRGB(255, 150, 110), Color3.fromRGB(220, 80, 60), function()
		if request("Teleport", "Home") then Effects.Flash(Color3.new(1, 1, 1), 0.4, 0.4) end
	end)
	-- admin button only for admins (server decides via the IsAdmin attribute)
	local player = game:GetService("Players").LocalPlayer
	local function checkAdmin()
		if player:GetAttribute("IsAdmin") and not HUD.SideButtons["Admin"] then
			HUD.AddSideButton("Admin", "🛠", Color3.fromRGB(255, 90, 90), Color3.fromRGB(160, 30, 60), function() HUD.Open("Admin") end)
		end
	end
	player:GetAttributeChangedSignal("IsAdmin"):Connect(checkAdmin)
	checkAdmin()
end

return Panels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">Sounds</string><ProtectedString name="Source"><![CDATA[-- Sounds: every sound effect in the game. Built-in engine sounds are used by default so
-- the game works out of the box. To upgrade, paste Creator Store sound IDs into `id`
-- (e.g. id = "rbxassetid://1234567890"); see README for suggested searches.
-- Location: StarterPlayer > StarterPlayerScripts > Client > Sounds (ModuleScript)
local SoundService = game:GetService("SoundService")

local Sounds = {}
local DEF = {
	Charge   = { id = "rbxasset://sounds/electronicpingshort.wav", vol = 0.25, speed = 0.6, looped = true },
	Throw    = { id = "rbxasset://sounds/swordlunge.wav",          vol = 0.6,  speed = 1.1 },
	Land     = { id = "rbxasset://sounds/collide.wav",             vol = 0.5,  speed = 0.8 },
	Open     = { id = "rbxasset://sounds/electronicpingshort.wav", vol = 0.6,  speed = 0.45 },
	Spawn    = { id = "rbxasset://sounds/action_jump.mp3",         vol = 0.7,  speed = 1.3 },
	Rare     = { id = "rbxasset://sounds/victory.wav",             vol = 0.8,  speed = 1 },
	Money    = { id = "rbxasset://sounds/electronicpingshort.wav", vol = 0.45, speed = 1.8 },
	Upgrade  = { id = "rbxasset://sounds/electronicpingshort.wav", vol = 0.6,  speed = 1.2 },
	Click    = { id = "rbxasset://sounds/button.wav",              vol = 0.5,  speed = 1 },
	Error    = { id = "rbxasset://sounds/button.wav",              vol = 0.5,  speed = 0.6 },
	Collect  = { id = "rbxasset://sounds/action_jump.mp3",         vol = 0.6,  speed = 1.7 },
	Whoosh   = { id = "rbxasset://sounds/swordlunge.wav",          vol = 0.4,  speed = 0.7 },
}

local group = Instance.new("SoundGroup")
group.Name = "SFX"
group.Volume = 0.8
group.Parent = SoundService

local cache = {}
local function get(name)
	if cache[name] then return cache[name] end
	local d = DEF[name]
	if not d then return nil end
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = d.id
	s.Volume = d.vol
	s.PlaybackSpeed = d.speed
	s.Looped = d.looped or false
	s.SoundGroup = group
	s.Parent = SoundService
	cache[name] = s
	return s
end

-- Play a 2D UI/feedback sound. pitch multiplies the default speed.
function Sounds.Play(name: string, pitch: number?)
	local base = get(name)
	if not base then return end
	if base.Looped then base:Play(); return base end
	local s = base:Clone()
	s.PlaybackSpeed = base.PlaybackSpeed * (pitch or 1) * (0.96 + math.random() * 0.08)
	s.Parent = SoundService
	s:Play()
	s.Ended:Once(function() s:Destroy() end)
	task.delay(6, function() if s.Parent then s:Destroy() end end)
	return s
end

-- Play a positional sound in the world
function Sounds.PlayAt(name: string, position: Vector3, pitch: number?)
	local d = DEF[name]
	if not d then return end
	local att = Instance.new("Attachment")
	att.WorldPosition = position
	att.Parent = workspace.Terrain
	local s = Instance.new("Sound")
	s.SoundId = d.id
	s.Volume = d.vol * 1.4
	s.PlaybackSpeed = d.speed * (pitch or 1)
	s.RollOffMaxDistance = 250
	s.SoundGroup = group
	s.Parent = att
	s:Play()
	task.delay(6, function() att:Destroy() end)
end

function Sounds.Get(name) return get(name) end

return Sounds
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">ThrowController</string><ProtectedString name="Source"><![CDATA[-- ThrowController: charge meter input, held-portal + arm wind-up, the portal flight arc,
-- landing bounce, portal gate opening and creature reveal choreography (for ALL players' throws).
-- Location: StarterPlayer > StarterPlayerScripts > Client > ThrowController (ModuleScript)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CreatureData = require(Shared.CreatureData)
local PortalBuilder = require(Shared.PortalBuilder)
local Odds = require(Shared.Odds)
local State = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)
local Sounds = require(script.Parent.Sounds)
local Renderer = require(script.Parent.CreatureRenderer)

local TC = {}
TC.Charging = false
TC.Power = 0
TC.OnThrowResult = nil   -- callback(power, perfect) for UI feedback
TC.MyThrow, TC.MyThrowT = nil, 0  -- your portal currently in play (one at a time)
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local Remotes = State.Remotes

local chargeStart = 0
local lastThrow = 0
local heldOrb, heldRefs
local chargeSound
local throws = {} -- [id] = { gate, gateRefs, pos, portal }

---------------------------------------------------------------- arm pose (local)
local shoulder, shoulderC0, armBlend, armTarget = nil, nil, 0, 0
local armDisabled = false
local function findShoulder()
	local char = player.Character
	if not char then return end
	local m = (char:FindFirstChild("RightUpperArm") and char.RightUpperArm:FindFirstChild("RightShoulder"))
		or (char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Right Shoulder"))
	if m and not m:IsA("Motor6D") then m = nil end
	if m ~= shoulder then
		shoulder = m
		shoulderC0 = m and m.C0
	end
end

local function handCFrame()
	local char = player.Character
	if not char then return nil end
	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	return hand and hand.CFrame
end

---------------------------------------------------------------- charging
function TC.BeginCharge()
	if TC.Charging or not State.Loaded then return end
	if os.clock() - lastThrow < Config.ThrowCooldown then return end
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	if not Config.InThrowZone(char.HumanoidRootPart.Position) then
		if TC.OnNotInZone then TC.OnNotInZone() end
		return
	end
	-- one portal at a time: wait until your last creature has been caught
	if TC.MyThrow and os.clock() - TC.MyThrowT < 20 then
		if TC.OnBusy then TC.OnBusy() end
		return
	end
	TC.Charging = true
	chargeStart = os.clock()
	findShoulder()
	armTarget = 1
	heldOrb, heldRefs = PortalBuilder.BuildOrb(State.Data.EquippedPortal, 0.5)
	heldOrb.Parent = Effects.Folder
	chargeSound = Sounds.Play("Charge")
end

function TC.EndCharge()
	if not TC.Charging then return end
	TC.Charging = false
	if chargeSound then chargeSound:Stop() end
	local power = TC.Power
	lastThrow = os.clock()
	local look = camera.CFrame.LookVector
	local dir = Vector3.new(look.X, 0, look.Z)
	if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, -1) end
	dir = dir.Unit
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if hrp then hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir) end
	Remotes.Throw:FireServer(power, dir)
	-- swing the arm forward
	armTarget = -0.6
	task.delay(0.18, function() armTarget = 0 end)
	if heldOrb then heldOrb:Destroy(); heldOrb = nil end
	Sounds.Play("Throw", 0.9 + power * 0.3)
	local perfect = power >= 0.92
	if TC.OnThrowResult then TC.OnThrowResult(power, perfect) end
	if perfect then Effects.Shake(0.8, 0.2) end
end

-- Power ping-pongs so timing matters; the top 8% is the PERFECT zone
local PERIOD = 1.5
RunService.RenderStepped:Connect(function(dt)
	if TC.Charging then
		local t = (os.clock() - chargeStart) / (PERIOD / 2)
		local k = t % 2
		local p = k <= 1 and k or 2 - k
		TC.Power = 1 - (1 - p) ^ 1.6 -- eases toward the top so the perfect zone is catchable
		if chargeSound then chargeSound.PlaybackSpeed = 0.5 + TC.Power * 1.2 end
		local hcf = handCFrame()
		if heldOrb and hcf then
			local s = 0.6 + TC.Power * 0.6
			heldOrb:PivotTo(hcf * CFrame.new(0, -1.2, 0))
			heldRefs.core.Size = Vector3.new(0.8, 0.8, 0.8) * s
			heldRefs.light.Range = 6 + TC.Power * 10
			PortalBuilder.Spin(heldRefs, os.clock() * (1 + TC.Power * 3))
		end
	else
		TC.Power = math.max(0, TC.Power - dt * 3)
	end
	-- arm wind-up spring (skipped on avatars whose shoulder joint can't be edited)
	if shoulder and shoulder.Parent and not armDisabled then
		armBlend += (armTarget - armBlend) * (1 - math.exp(-18 * dt))
		if math.abs(armBlend) > 0.002 or math.abs(armTarget) > 0 then
			local isR15 = shoulder.Name == "RightShoulder"
			local rot = isR15 and CFrame.Angles(armBlend * 2.6, 0, armBlend * -0.3) or CFrame.Angles(0, 0, armBlend * 2.6)
			local ok = pcall(function() shoulder.C0 = shoulderC0 * rot end)
			if not ok then armDisabled = true end
		end
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonR2 then
		TC.BeginCharge()
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonR2 then
		TC.EndCharge()
	end
end)
player.CharacterAdded:Connect(function()
	shoulder = nil
	TC.Charging = false
	if heldOrb then heldOrb:Destroy(); heldOrb = nil end
end)

-- quick arm curl used by the training stations
function TC.Curl()
	findShoulder()
	armTarget = 0.9
	task.delay(0.15, function() if not TC.Charging then armTarget = 0 end end)
end

---------------------------------------------------------------- camera follows your long throws
local camFollow = nil -- { pos = Vector3, untilT = number, cf = CFrame }
RunService:BindToRenderStep("TPFC_FollowCam", Enum.RenderPriority.Camera.Value, function(dt)
	if not camFollow then return end
	if os.clock() > camFollow.untilT then
		if camFollow.closeup then TC.EndCloseup() end
		camFollow = nil
		camera.CameraType = Enum.CameraType.Custom
		return
	end
	local target = camFollow.pos
	local desired = CFrame.lookAt(target + Vector3.new(14, 12, -34), target + Vector3.new(0, 2, 0))
	if camFollow.closeup then
		-- CINEMATIC CLOSE-UP: slow orbit around the creature, pushing in
		local e = Renderer.Wild[camFollow.id]
		local p
		if e and e.anim and e.model and e.model.Parent then
			p = Vector3.new(e.anim.pos.X, e.anim.groundY, e.anim.pos.Z)
			camFollow.lastP = p
		else
			p = camFollow.lastP or camFollow.pos
		end
		local t = os.clock() - camFollow.closeT
		local h = camFollow.height
		local look = p + Vector3.new(0, h * 0.55, 0)
		local a = -0.7 + t * 0.32
		local R = camFollow.radius * (1.35 - 0.35 * math.min(1, t / 1.5))
		desired = CFrame.lookAt(look + Vector3.new(math.sin(a) * R, h * 0.25 + 1.5, -math.cos(a) * R), look)
		if Effects.DOF then Effects.DOF.FocusDistance = R end
	end
	camFollow.cf = camFollow.cf and camFollow.cf:Lerp(desired, 1 - math.exp(-5 * dt)) or camera.CFrame:Lerp(desired, 0.2)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = camFollow.cf
end)
function TC.StopFollow()
	if camFollow then camFollow.untilT = 0 end
end

-- start a cinematic zoom on a good creature you just found
function TC.StartCloseup(id, def, pos, duration)
	local rc = Config.Rarities[def.rarity]
	local size = rc.size * (def.scale or 1)
	camFollow = camFollow or { pos = pos, untilT = 0 }
	camFollow.id = id
	camFollow.pos = pos
	camFollow.closeup = true
	camFollow.closeT = os.clock()
	camFollow.height = 4 * size
	camFollow.radius = (7 + rc.order * 0.8) * size
	camFollow.untilT = os.clock() + duration
	Effects.Letterbox(true)
	Effects.Tween(camera, 0.7, { FieldOfView = 48 }, Enum.EasingStyle.Quad)
	if Effects.DOF then
		Effects.DOF.InFocusRadius = 12
		Effects.Tween(Effects.DOF, 0.6, { FarIntensity = 0.45 })
	end
end

function TC.EndCloseup()
	Effects.Letterbox(false)
	Effects.Tween(camera, 0.6, { FieldOfView = 70 }, Enum.EasingStyle.Quad)
	if Effects.DOF then
		Effects.Tween(Effects.DOF, 0.6, { FarIntensity = 0.18 })
		Effects.DOF.InFocusRadius = 70
		Effects.DOF.FocusDistance = 50
	end
end

---------------------------------------------------------------- flight + landing + gate
local function bezier(a, b, c, t)
	local u = 1 - t
	return a * u * u + b * 2 * u * t + c * t * t
end

local function openGate(id, info)
	local pos = info.to
	local camPos = camera.CFrame.Position
	local R = 5
	local gate, refs = PortalBuilder.BuildGate(info.portal, R)
	local center = pos + Vector3.new(0, R + 0.6, 0)
	-- the portal always faces back toward the throw line, so the creature walks out toward you
	local baseCF = CFrame.lookAt(center, center + Vector3.new(0, 0, -1))
	gate:PivotTo(baseCF)
	gate:ScaleTo(0.05)
	gate.Parent = Effects.Folder
	throws[id] = { gate = gate, refs = refs, pos = pos, portal = info.portal, t0 = os.clock() }
	local P = Config.Portals[info.portal]
	Effects.Shockwave(pos, P.color, 10, 0.5)
	Effects.Burst(center, PortalBuilder.ColorSeq(info.portal), 45, 22, 1.1)
	Sounds.PlayAt("Open", center, 1)
	local start = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not gate.Parent then conn:Disconnect() return end
		local t = os.clock() - start
		local k = math.clamp(t / 0.45, 0, 1)
		-- back-out ease for a punchy open
		local c1 = 2.2
		local e = 1 + (c1 + 1) * (k - 1) ^ 3 + c1 * (k - 1) ^ 2
		local closing = throws[id] and throws[id].closeT
		if closing then
			local ck = math.clamp((os.clock() - closing) / 0.35, 0, 1)
			e = (1 - ck * ck)
			if ck >= 1 then gate:Destroy(); conn:Disconnect(); return end
		end
		gate:ScaleTo(math.max(0.05, e))
		gate:PivotTo(baseCF * CFrame.new(0, math.sin(t * 2) * 0.15, 0))
		PortalBuilder.Spin(refs, t)
	end)
end

local function closeGate(id)
	local g = throws[id]
	if not g or g.closeT then return end
	g.closeT = os.clock()
	Effects.Burst(g.pos + Vector3.new(0, 3.5, 0), PortalBuilder.ColorSeq(g.portal), 20, 10, 0.6)
	task.delay(0.5, function() throws[id] = nil end)
end

Remotes.PortalThrown.OnClientEvent:Connect(function(info)
	local orb, refs = PortalBuilder.BuildOrb(info.portal, 0.75)
	local a, c = info.from, info.to + Vector3.new(0, 0.9, 0)
	local mid = (a + c) / 2 + Vector3.new(0, math.min(10 + info.dist * 0.3, 220), 0)
	orb:PivotTo(CFrame.new(a))
	orb.Parent = Effects.Folder
	refs.trail.Enabled = true
	local mine = info.owner == player.UserId
	if mine then TC.MyThrow, TC.MyThrowT = info.id, os.clock() end
	local follow = mine and info.dist > 70
	if follow then
		camFollow = { pos = a, untilT = os.clock() + info.t + 8, id = info.id }
	end
	if not mine then Sounds.PlayAt("Whoosh", a) end
	local start = os.clock()
	local landed = false
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		if t < info.t then
			local k = t / info.t
			local ek = k < 0.5 and k * 1.1 or 0.55 + (k - 0.5) * 0.9 -- slight hang time at the apex
			local p = bezier(a, mid, c, math.clamp(ek, 0, 1))
			orb:PivotTo(CFrame.new(p) * CFrame.Angles(t * 9, t * 6, 0))
			if follow and camFollow and camFollow.id == info.id then camFollow.pos = p end
			PortalBuilder.Spin(refs, t * 2)
		else
			if not landed then
				landed = true
				Sounds.PlayAt("Land", c)
				Effects.Burst(c - Vector3.new(0, 0.6, 0), ColorSequence.new(Color3.fromRGB(230, 220, 200)), 18, 10, 1.2, "rbxasset://textures/particles/smoke_main.dds")
				Effects.Shockwave(c - Vector3.new(0, 0.8, 0), Config.Portals[info.portal].color, 6, 0.4)
				if mine then Effects.Shake(0.5, 0.15) end
				refs.trail.Enabled = false
			end
			-- two decaying bounces, then a charged-up wobble before it bursts open
			local bt = t - info.t
			local bounce = 0
			if bt < 0.22 then bounce = math.sin(bt / 0.22 * math.pi) * 1.6
			elseif bt < 0.36 then bounce = math.sin((bt - 0.22) / 0.14 * math.pi) * 0.5 end
			local wobble = bt > 0.36 and math.sin(bt * 40) * (bt - 0.36) * 0.6 or 0
			orb:PivotTo(CFrame.new(c + Vector3.new(0, bounce, 0)) * CFrame.Angles(wobble, bt * 12, wobble * 0.5))
			refs.light.Brightness = 2 + bt * 8
			if bt > 0.5 then
				conn:Disconnect()
				orb:Destroy()
				openGate(info.id, info)
			end
		end
	end)
end)

Remotes.PortalOpened.OnClientEvent:Connect(function(info)
	local def = CreatureData.ById[info.creature]
	local rc = Config.Rarities[def.rarity]
	local mine = info.owner == player.UserId
	local chanceText = Odds.OneIn(info.chance)
	local center = info.pos + Vector3.new(0, 3.8, 0)
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local near = myRoot and (myRoot.Position - info.pos).Magnitude < 250
	local camNear = (camera.CFrame.Position - info.pos).Magnitude < 300
	if not near and not mine and not camNear then return end

	-- special entrances for Legendary and above
	if rc.order >= 5 then
		Effects.LightBeam(info.pos, rc.color, rc.order >= 7 and 200 or 120, 1.8)
		Effects.Shockwave(info.pos, rc.color, 22 + rc.order * 2, 0.9)
		if mine then
			Effects.Shake(rc.order >= 7 and 2.2 or 1.4, 0.6)
			Effects.Flash(def.rarity == "Secret" and Color3.fromRGB(20, 0, 40) or rc.color, 0.8, 0.55)
			Sounds.Play("Rare")
			Effects.RarityBanner(def, chanceText)
		end
		if def.rarity == "Secret" then
			Effects.Burst(center, ColorSequence.new(Color3.fromRGB(0, 255, 200), Color3.fromRGB(255, 0, 170)), 90, 30, 1.4)
		elseif def.rarity == "Divine" then
			Effects.Burst(center, ColorSequence.new(Color3.fromRGB(255, 245, 190), Color3.new(1, 1, 1)), 120, 35, 1.6)
		end
	elseif mine then
		Effects.RarityBanner(def, chanceText)
	end
	Effects.Burst(center, rc.color, 30 + rc.order * 8, 16 + rc.order * 2, 1)
	Sounds.PlayAt("Spawn", center, 1.2 - rc.order * 0.05)
	local e = Renderer.SpawnWild(info.id, info.creature, info.pos, info.owner, chanceText)
	if e then
		-- after stepping out of the portal: a happy hop
		task.delay(1.9, function() if e.anim and e.anim.rig then e.anim:React("happy") end end)
	end
	if mine then
		Effects.FloatingText(center + Vector3.new(0, 5, 0), chanceText, rc.color, 1.3)
		if rc.order >= 3 then
			-- a GOOD pet: zoom in on it and keep watching through its entrance and capture
			local catchDur = (Renderer.CatchConfig[def.rarity] or Renderer.CatchConfig.Common).dur
			TC.StartCloseup(info.id, def, info.pos, (Config.CatchDelay[def.rarity] or 3) + catchDur + 0.5)
		elseif camFollow and camFollow.id == info.id then
			camFollow.pos = info.pos
			camFollow.untilT = os.clock() + 2.5
		end
	end
	task.delay(rc.order >= 5 and 3 or 2.3, function() closeGate(info.id) end)
end)

Remotes.CreatureGone.OnClientEvent:Connect(function(id, reason, collectorId)
	if TC.MyThrow == id then TC.MyThrow = nil end
	Renderer.RemoveWild(id, reason, collectorId)
	if reason == "collected" and collectorId == player.UserId then
		Sounds.Play("Collect")
		task.delay(0.3, Sounds.Play, "Rare", 1.5)
	end
	closeGate(id)
end)

return TC
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[-- UIKit: small helper library for building the polished, animated simulator UI.
-- Location: StarterPlayer > StarterPlayerScripts > Client > UIKit (ModuleScript)
local TweenService = game:GetService("TweenService")
local Sounds = require(script.Parent.Sounds)

local K = {}
K.Font = Enum.Font.FredokaOne
K.Dark = Color3.fromRGB(28, 18, 45)
K.Panel = Color3.fromRGB(250, 246, 255)

function K.new(class, props, children)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then o[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = o end
	if props and props.Parent then o.Parent = props.Parent end
	return o
end

function K.corner(r) return K.new("UICorner", { CornerRadius = UDim.new(0, r or 12) }) end
function K.round() return K.new("UICorner", { CornerRadius = UDim.new(1, 0) }) end
function K.stroke(t, c) return K.new("UIStroke", { Thickness = t or 3, Color = c or K.Dark, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) end
function K.textStroke(t, c) return K.new("UIStroke", { Thickness = t or 2.5, Color = c or K.Dark }) end
function K.grad(c1, c2, rot) return K.new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rot or 90 }) end
function K.pad(n) return K.new("UIPadding", { PaddingTop = UDim.new(0, n), PaddingBottom = UDim.new(0, n), PaddingLeft = UDim.new(0, n), PaddingRight = UDim.new(0, n) }) end
function K.list(dir, padding, align)
	return K.new("UIListLayout", { FillDirection = dir or Enum.FillDirection.Vertical, Padding = UDim.new(0, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = align or Enum.HorizontalAlignment.Center })
end

function K.tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

function K.label(text, size, color, props)
	local l = K.new("TextLabel", {
		Text = text, Font = K.Font, TextScaled = true, BackgroundTransparency = 1, TextColor3 = color or Color3.new(1, 1, 1),
		Size = size or UDim2.fromScale(1, 1), RichText = true,
	}, { K.textStroke() })
	for k, v in pairs(props or {}) do l[k] = v end
	return l
end

-- Animated button: hover grow, press squash, springy release, click sound.
function K.button(text, c1, c2, size, props)
	local b = K.new("TextButton", {
		Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.new(1, 1, 1), Size = size or UDim2.fromOffset(160, 50),
	}, { K.corner(14), K.stroke(3), K.grad(c1, c2 or c1:Lerp(Color3.new(0, 0, 0), 0.25), 90) })
	local scale = K.new("UIScale", { Parent = b })
	local shine = K.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.75, Size = UDim2.new(1, -8, 0.42, 0),
		Position = UDim2.fromOffset(4, 3), BorderSizePixel = 0, Parent = b }, { K.corner(10) })
	local l = K.label(text, UDim2.new(1, -12, 1, -8), Color3.new(1, 1, 1), { Position = UDim2.fromOffset(6, 4), Parent = b, Name = "Label", ZIndex = 2 })
	for k, v in pairs(props or {}) do b[k] = v end
	b.MouseEnter:Connect(function() K.tween(scale, 0.15, { Scale = 1.06 }, Enum.EasingStyle.Back) end)
	b.MouseLeave:Connect(function() K.tween(scale, 0.15, { Scale = 1 }) end)
	b.MouseButton1Down:Connect(function() K.tween(scale, 0.08, { Scale = 0.9 }) end)
	b.MouseButton1Up:Connect(function() K.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Elastic) end)
	b.Activated:Connect(function() Sounds.Play("Click") end)
	return b, l
end

function K.setButton(b, text, c1, c2)
	if text then b.Label.Text = text end
	if c1 then b:FindFirstChildOfClass("UIGradient").Color = ColorSequence.new(c1, c2 or c1:Lerp(Color3.new(0, 0, 0), 0.25)) end
end

-- Bouncy "pop" used for counters when values change
function K.pop(o, amount)
	local s = o:FindFirstChildOfClass("UIScale") or K.new("UIScale", { Parent = o })
	s.Scale = amount or 1.18
	K.tween(s, 0.4, { Scale = 1 }, Enum.EasingStyle.Elastic)
end

-- Welds don't simulate inside ViewportFrames, so compute every welded part's CFrame
-- from its weld chain (Part1 = Part0 * C0 * C1:Inverse()) before showing it.
function K.bakeWelds(model)
	local welds = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Weld") and d.Part0 and d.Part1 then table.insert(welds, d) end
	end
	local done = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Anchored then done[d] = true end
	end
	local progress = true
	while progress do
		progress = false
		for _, w in ipairs(welds) do
			if done[w.Part0] and not done[w.Part1] then
				w.Part1.CFrame = w.Part0.CFrame * w.C0 * w.C1:Inverse()
				done[w.Part1] = true
				progress = true
			end
		end
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then d.Anchored = true end
	end
end

-- ViewportFrame showing a model, auto-framed, optional slow spin
function K.viewport(model, size, spin, silhouette)
	K.bakeWelds(model)
	local vp = K.new("ViewportFrame", { Size = size or UDim2.fromScale(1, 1), BackgroundTransparency = 1, Ambient = Color3.fromRGB(200, 200, 210),
		LightColor = Color3.new(1, 1, 1), LightDirection = Vector3.new(-1, -1, -1) })
	if silhouette then vp.ImageColor3 = Color3.new(0, 0, 0); vp.ImageTransparency = 0.15 end
	local cam = K.new("Camera", { FieldOfView = 35, Parent = vp })
	vp.CurrentCamera = cam
	model.Parent = vp
	local cf, ext = model:GetBoundingBox()
	local r = ext.Magnitude * 0.62
	local dist = r / math.tan(math.rad(cam.FieldOfView / 2))
	local target = cf.Position
	local function place(a)
		local offset = CFrame.Angles(0, a, 0) * Vector3.new(0, r * 0.35, -dist)
		cam.CFrame = CFrame.lookAt(target + offset, target)
	end
	place(0.45)
	if spin then
		vp:SetAttribute("Spin", true)
		task.spawn(function()
			local a, seen = 0.45, false
			while true do
				task.wait(1 / 30)
				local inGame = vp:IsDescendantOf(game)
				if inGame then seen = true elseif seen or a > 60 then break end
				a += 0.03
				if inGame and vp.Visible then place(math.sin(a) * 0.6 + 0.2) end
			end
		end)
	end
	return vp
end

return K
]]></ProtectedString></Properties></Item>
